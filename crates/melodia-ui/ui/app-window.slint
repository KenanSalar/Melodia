// Built rather than upstream's, by `scripts/patch_vazirmatn.py`, which argues the merge.
import "assets/fonts/vazirmatn/Vazirmatn-Regular.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-Medium.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-SemiBold.ttf";

import { Theme } from "theme.slint";
import { Settings } from "settings.slint";
import { Albums, AlbumDetail } from "globals/albums.slint";
import { Artists, ArtistDetail } from "globals/artists.slint";
import { Equalizer, ReplayGain, Visualizer } from "globals/audio.slint";
import { Favorites, RecentlyPlayed } from "globals/curated.slint";
import { SmartEditor, TagEditor, ScrobbleUi, RadioForm } from "globals/dialog-forms.slint";
import { Dialog, DialogKind } from "globals/dialog.slint";
import { Genres, GenreDetail } from "globals/genres.slint";
import { HeroBackdrop } from "globals/hero-backdrop.slint";
import { HeroChips } from "globals/hero-chips.slint";
import { LibrarySettings, ScanPhase } from "globals/library-settings.slint";
import { MyLibrary } from "globals/my-library.slint";
import { Lyrics, LyricsState } from "globals/lyrics.slint";
import { Nav, NavEnterFrom } from "globals/nav.slint";
import { Onboarding } from "globals/onboarding.slint";
import { Player } from "globals/player.slint";
import { Playlists, PlaylistDetail } from "globals/playlists.slint";
import { CardSelection } from "globals/card-selection.slint";
import { Selection } from "globals/selection.slint";
import { CardActions } from "globals/card-actions.slint";
import { CopyActions } from "globals/copy-actions.slint";
import { Queue, NowPlaying } from "globals/queue.slint";
import { Drag, DragOrigin, FileDrag, FileDropTarget, WindowRect } from "globals/drag.slint";
import { Radio } from "globals/radio.slint";
import { Search } from "globals/search.slint";
import { SettingsPage } from "globals/settings-page.slint";
import { DragRegion, WindowChrome, MiniPlayer, CompositeScroll } from "globals/shell.slint";
import { SignalPathUi } from "globals/signal-path.slint";
import { Tracks, Browse, RowCovers } from "globals/tracks.slint";
import { TrackColumnSizing } from "globals/track-columns.slint";
import { MelodiaUpdater } from "globals/updater.slint";
import { Notifications } from "globals/notifications.slint";
import { TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
         BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
         AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
         GenreRow, GenreGridRow,
         PlaylistRow, PlaylistGridRow, SmartRuleRow, LyricRow, LiftedRun,
         TrackColumns, TrackColumnLayout, TrackColumn } from "models.slint";
import { Sidebar } from "layout/sidebar.slint";
import { NowPlayingBar } from "layout/now-playing-bar.slint";
import { ResizeRing } from "layout/resize-ring.slint";
import { ShortcutScope } from "layout/shortcut-scope.slint";
import { PlaceholderView } from "views/placeholder-view.slint";
import { MyLibraryView } from "views/my-library-view.slint";
import { FavoritesView } from "views/favorites-view.slint";
import { RecentlyPlayedView } from "views/recently-played-view.slint";
import { RadioView } from "views/radio-view.slint";
import { BrowseView } from "views/browse-view.slint";
import { SearchView } from "views/search-view.slint";
import { SettingsView } from "views/settings-view.slint";
import { NowPlayingView } from "views/now-playing-view.slint";
import { MiniPlayerView } from "views/mini-player.slint";
import { QueuePanel } from "views/queue-panel/queue-panel.slint";
import { QueueScrim } from "views/queue-panel/queue-scrim.slint";
import { DialogOverlay } from "components/dialog/dialog.slint";
import { OnboardingOverlay } from "components/onboarding/onboarding-overlay.slint";
import { CustomTitleBar } from "components/custom-titlebar.slint";
import { EdgeOutline } from "components/edge-outline.slint";
import { RoundedFrame } from "components/rounded-frame.slint";
import { NotificationStack } from "components/dialog/notification-stack.slint";
import { DragGhost } from "components/drag-ghost.slint";
import { WindowRectReport } from "components/window-rect-report.slint";
import { MiniPlayerSwitch } from "components/mini-player-switch.slint";
import { SectionActiveGate } from "components/section-active-gate.slint";
import { Tooltip, TooltipSide } from "components/tooltip.slint";
import { ViewTransition } from "components/view-transition.slint";

// Re-export so Rust can mention these from `slint::include_modules!`, a global reaching Rust only
// through the main file. The only place the full list appears: `globals/` has no barrel, every
// consumer importing the file it needs, so an import above that only feeds this block is not dead.
export {
    Theme, Settings, SettingsPage, Player, HeroBackdrop, HeroChips, Equalizer, ReplayGain, Visualizer, SignalPathUi, ScrobbleUi, SmartEditor, TagEditor, Nav, CompositeScroll, MiniPlayer, MyLibrary, Tracks, Browse, LibrarySettings, Dialog, WindowChrome, Queue, Notifications, NowPlaying, Favorites, RecentlyPlayed, Albums, AlbumDetail, Artists, ArtistDetail, Genres, GenreDetail, Playlists, PlaylistDetail, Search, MelodiaUpdater, RowCovers, Radio, RadioForm, Onboarding, Lyrics, TrackColumnSizing, CardSelection, CardActions, CopyActions, Selection, Drag, DragOrigin, FileDrag, FileDropTarget, WindowRect,
    TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow, LyricRow, LiftedRun,
    TrackColumns, TrackColumnLayout, TrackColumn,
    BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
    AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
    GenreRow, GenreGridRow,
    PlaylistRow, PlaylistGridRow, SmartRuleRow,
}

export component AppWindow inherits Window {
    title: "Melodia";
    // No preferred size: `geometry::restore`'s `set_size` sets winit's `has_explicit_size`, the one
    // thing stopping Slint snapping to a preferred size on first show. The floor is the
    // miniplayer's, so a drag goes straight into it.
    //
    // **Under an OS frame it gives the frame back**: Win32 reads the minimum once per drag and adds
    // the frame, which the miniplayer drops mid-drag, holding the window above the floor until
    // release.
    min-width: MiniPlayer.window-min-width - (root.frameless ? 0px : WindowChrome.frame-allowance-w);
    min-height: MiniPlayer.window-min-height - (root.frameless ? 0px : WindowChrome.frame-allowance-h);
    // On `render-active`, so the frame changes on the tick the branches swap, under the opaque
    // crossfade. Any earlier and one layout fades out under the wrong frame, the window stepping by
    // Win32's invisible borders on screen.
    property <bool> frameless: !Theme.use-native-titlebar || mini-switch.render-active;
    // The only warning Rust gets that the OS is about to move the client by a frame, one
    // change-handler pass ahead of `no-frame`.
    changed frameless => {
        WindowChrome.frame-changed();
    }
    // Maximized, the corners would clip against the screen and resizing is a no-op.
    property <bool> rounded-shell: root.frameless && !WindowChrome.is-maximized;

    background: root.rounded-shell ? Colors.transparent : Theme.mantle;

    // The invisible borders the native miniplayer's dropped frame kept outside its visible edges,
    // which the client inherits. Painted, the window would grow and shrink by them on every swap.
    // Zero off Win32.
    property <bool> keeps-frame-margins: Theme.use-native-titlebar && root.rounded-shell;
    property <length> margin-left: root.keeps-frame-margins ? WindowChrome.frame-margin-left : 0px;
    property <length> margin-right: root.keeps-frame-margins ? WindowChrome.frame-margin-right : 0px;
    property <length> margin-bottom: root.keeps-frame-margins ? WindowChrome.frame-margin-bottom : 0px;
    // The rect the shell and everything over it occupies inside the client.
    property <length> content-width: root.width - root.margin-left - root.margin-right;
    property <length> content-height: root.height - root.margin-bottom;

    // What every tooltip keeps its pill inside.
    function publish-shell-rect() {
        WindowChrome.shell-x = root.margin-left;
        WindowChrome.shell-width = root.content-width;
        WindowChrome.shell-height = root.content-height;
    }
    changed margin-left => { root.publish-shell-rect(); }
    changed content-width => { root.publish-shell-rect(); }
    changed content-height => { root.publish-shell-rect(); }
    // `changed` doesn't fire when the first layout settles directly on the final size.
    Timer {
        interval: 1ms;
        triggered => {
            root.publish-shell-rect();
            self.running = false;
        }
    }

    // `ResizeRing`'s band, as wide as the margins it covers so they resize as the frame's borders
    // did. No `resize-border-width`: Slint's handler for it hit-tests square corners.
    property <length> resize-band: max(Theme.resize-border, root.margin-left, root.margin-right,
        root.margin-bottom);
    no-frame: root.frameless;

    default-font-family: "Vazirmatn";
    default-font-size: Theme.font-size-md;

    function view-title(idx: int) -> string {
        if (idx == 0) { return @tr("Search"); }
        if (idx == 1) { return @tr("Browse"); }
        if (idx == 2) { return @tr("Favorites"); }
        if (idx == 3) { return @tr("My Library"); }
        if (idx == 8) { return @tr("Recently Played"); }
        if (idx == 9) { return @tr("Settings"); }
        if (idx == 10) { return @tr("Radio"); }
        // A proper noun, never translated.
        return "Melodia";
    }

    // Up here because `SettingsView` is unmounted before a handler inside it could see the leaving
    // transition, and on a mirror because `changed` rejects path expressions on globals.
    property <int> watched-nav-idx: Nav.selected-index;
    changed watched-nav-idx => {
        CompositeScroll.reset();
        if (self.watched-nav-idx != 9) {
            SettingsPage.clear-search();
        }
        // No gate can see this edge: Now Playing already made the predicate false, and the
        // sidebar moves both in one handler, so the page's own leave goes false to false.
        MyLibrary.page-active-changed(self.watched-nav-idx == 3);
        // Synchronous, so SearchView's autofocus wins.
        shortcut-scope.grab-focus();
    }

    // A tab pick swaps the body without moving the nav index, and Artist Detail is composite.
    property <int> watched-my-library-tab: MyLibrary.tab-idx;
    changed watched-my-library-tab => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // Lets Rust gate the Up Next rebuild, `NowPlayingView` being unmounted while closed.
    property <bool> watched-now-playing-open: Nav.now-playing-open;
    changed watched-now-playing-open => {
        CompositeScroll.reset();
        Nav.now-playing-open-changed(self.watched-now-playing-open);
        shortcut-scope.grab-focus();
    }

    // Arms the visualizer's sample tap only while something draws it. A mirror of its own,
    // `now-playing-open-changed`'s one slot being `wire_now_playing_open`'s.
    property <bool> watched-viz-active: Nav.now-playing-open && Visualizer.enabled;
    changed watched-viz-active => {
        Visualizer.set-active(self.watched-viz-active);
    }

    // Composite, and opens and closes with no nav change.
    property <int> watched-artist-detail-id: ArtistDetail.artist-id;
    changed watched-artist-detail-id => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // The other three unmount a grid whose filter may hold focus; none is composite.
    property <int> watched-album-detail-id: AlbumDetail.album-id;
    changed watched-album-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-genre-detail-id: GenreDetail.genre-id;
    changed watched-genre-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-playlist-detail-id: PlaylistDetail.playlist-id;
    changed watched-playlist-detail-id => {
        shortcut-scope.grab-focus();
    }

    // The swap unmounts the whole full UI with no nav change.
    property <bool> watched-mini-render: mini-switch.render-active;
    changed watched-mini-render => {
        CompositeScroll.reset();
        // The rail dies with no leave event, so its last row would read as hovered on return.
        Nav.sidebar-tip-idx = -1;
        // So do both drag regions, and one unmounted under a still pointer never reports it gone,
        // leaving every press a window drag.
        WindowChrome.drag-region-changed(DragRegion.none);
        shortcut-scope.grab-focus();
    }

    // A dialog body dies with its kind. Ungated, the bodies never autofocusing, so an open takes
    // the keys off a SearchBar too. Safe where `focus()` from `init` isn't, a `changed` handler
    // running outside the evaluator's recursion guard.
    property <DialogKind> watched-dialog-kind: Dialog.kind;
    changed watched-dialog-kind => {
        shortcut-scope.grab-focus();
    }

    // The row the sidebar, content and queue panel share, less its gutter. Narrowing takes room
    // back in order so the content keeps `Theme.content-min-w`: the sidebar folds to its rail, the
    // panel narrows to its minimum, then steps aside and opens as an overlay from then on.
    property <length> row-w: root.content-width - Theme.pad-xs;
    // 0 means the default, spelled once in `Theme`.
    property <length> queue-chosen-w: clamp(
        Queue.panel-width > 0px ? Queue.panel-width : Theme.queue-panel-default-w,
        Theme.queue-panel-min-w,
        Theme.queue-panel-max-w);
    // What the row leaves an expanded sidebar beside the content's floor, alone and beside the
    // panel at its chosen width.
    property <length> bare-sidebar-room: root.row-w - Theme.content-min-w;
    property <length> sidebar-room: root.bare-sidebar-room - root.queue-chosen-w;
    property <bool> sidebar-would-yield: Nav.sidebar-expanded-w > root.sidebar-room;
    // Shown or not, so the panel keeps its width while it eases out from under Now Playing.
    property <length> queue-room: root.row-w - Theme.content-min-w
        - (Nav.sidebar-collapsed || root.sidebar-would-yield
            ? Theme.sidebar-collapsed-w
            : Nav.sidebar-expanded-w);
    property <bool> queue-fits: !mini-switch.render-active
        && root.queue-room >= Theme.queue-panel-min-w;
    // Gaining the room docks an open overlay, `shown` holding through it.
    changed queue-fits => {
        Queue.fits = self.queue-fits;
        if (self.queue-fits && Queue.overlay-open) {
            Queue.open = true;
            Queue.overlay-open = false;
        }
    }

    // Here because the miniplayer unmounts the panel, which a mirror there would miss. Only the
    // overlay's own `open` floats it, so narrowing hides a docked panel rather than floating it.
    property <bool> queue-shown: !mini-switch.render-active && !Nav.now-playing-open
        && (Queue.overlay-open || (Queue.open && root.queue-fits));
    property <bool> queue-docked: root.queue-shown && root.queue-fits;
    property <bool> queue-floating: root.queue-shown && !root.queue-fits;
    // `floating` with `shown`, and `shown` ahead of `shown-changed`, which the panel's seat needs.
    changed queue-shown => {
        Queue.floating = root.queue-floating;
        Queue.shown = self.queue-shown;
        Queue.shown-changed(self.queue-shown);
    }
    // The dock hand-off, which changes the mode under a `shown` that holds.
    changed queue-floating => {
        Queue.floating = self.queue-floating;
    }

    // Forced where an expanded sidebar would put the content under its floor, by the window alone
    // or beside the docked panel. Keyed on the docked panel, not `open`: with both fold controls
    // standing down, a panel too wide to show would hold the sidebar folded with nothing to press.
    // The window's half waits for a row, none existing at construction, where the tracker takes its
    // baseline and a narrow reading would leave a narrow launch no edge to write.
    property <bool> sidebar-yields:
        (root.row-w > 0px && Nav.sidebar-expanded-w > root.bare-sidebar-room)
        || (root.queue-docked && root.sidebar-would-yield);
    changed sidebar-yields => {
        Nav.sidebar-yields = self.sidebar-yields;
    }

    // Nothing moves focus onto the scope when the queue's keys go live, so a filter would swallow
    // the `a`. **Rising edge only**: the press taking the keys away is one Slint is about to hand a
    // field.
    property <bool> watched-queue-keys: Queue.keys-owned || Queue.floating;
    changed watched-queue-keys => {
        if (self.watched-queue-keys) {
            shortcut-scope.grab-focus();
        }
    }

    // The card's buttons can hold focus as it closes. No composite view, so no reset.
    property <bool> watched-onboarding-mounted: Onboarding.mounted;
    changed watched-onboarding-mounted => {
        shortcut-scope.grab-focus();
    }

    // Fed the live size, a component root having no `parent`.
    mini-switch := MiniPlayerSwitch {
        host-width: root.width;
        host-height: root.height;
        view-width: root.content-width;
        view-height: root.content-height;
        exit-allowance-w: WindowChrome.frame-allowance-w;
        exit-allowance-h: WindowChrome.frame-allowance-h;
    }

    // Here because Rust reaches only the root's functions. `geometry::restore` calls it once the
    // restored size is in, before the window maps.
    public function adopt-restored-size() {
        mini-switch.adopt-restored-size();
    }

    // Read back by `geometry::restore`, here for the same reason.
    public pure function miniplayer-mounted() -> bool {
        return mini-switch.render-active;
    }

    // The winit filter's word on where a resize begins and ends, which only it can tell.
    public function resize-began() {
        mini-switch.resize-began();
    }
    public function resize-released() {
        mini-switch.resize-released();
    }

    // A `TextInput` reaches the clipboard Slint's backend owns, which on Wayland is our own
    // connection where a clipboard crate would land on XWayland. Disabled so a Tab walk can't focus
    // it, and pinned, a child with no `x`/`y` here being centred.
    clipboard-sink := TextInput {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        enabled: false;
    }

    // Emptied once copied, so a stream URL's session token doesn't sit in the tree.
    public function copy-to-clipboard(text: string) {
        clipboard-sink.text = text;
        clipboard-sink.select-all();
        clipboard-sink.copy();
        clipboard-sink.text = "";
    }

    // One gate per section in nav-index order, plus one per tab where a tab leave has to be a
    // section leave. On the root because a view can't observe its own leave.
    SectionActiveGate {
        index: 0;
        mini-active: mini-switch.active;
        active-changed(active) => { Search.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 1;
        mini-active: mini-switch.active;
        active-changed(active) => { Browse.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 2;
        mini-active: mini-switch.active;
        active-changed(active) => { Favorites.section-active-changed(active); }
    }

    // My Library: one gate per tab, each tab having been a section with its own hook.
    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-songs;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Tracks.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-albums;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Albums.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-artists;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Artists.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-genres;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Genres.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 3;
        tab-index: MyLibrary.tab-playlists;
        current-tab: MyLibrary.tab-idx;
        mini-active: mini-switch.active;
        active-changed(active) => { Playlists.section-active-changed(active); }
    }

    SectionActiveGate {
        index: 8;
        mini-active: mini-switch.active;
        active-changed(active) => { RecentlyPlayed.section-active-changed(active); }
    }

    // **One gate for all three tabs**: a per-tab gate makes a tab flip a section leave, handing
    // back a directory answer paid for in a network round trip.
    SectionActiveGate {
        index: 10;
        mini-active: mini-switch.active;
        active-changed(active) => { Radio.section-active-changed(active); }
    }

    // The window outline. Its clip is the corner's only antialiased pass, since a second stacks
    // into a harder arc: no `background` here, and whatever reaches the edge mounts inside.
    Rectangle {
        x: root.margin-left;
        y: 0px;
        width: root.content-width;
        height: root.content-height;
        border-radius: root.rounded-shell ? Theme.window-radius : 0px;
        clip: true;

        Rectangle {
            width: 100%;
            height: 100%;
            background: WindowChrome.mantle;
        }

        // **Behind everything**, hearing the moves no target took. In front it would take their
        // drops, a drop going to whatever `DropArea` is under the pointer.
        DropArea {
            width: 100%;
            height: 100%;
            can-drop(event) => {
                Drag.follow(self.absolute-position.x + event.position.x,
                    self.absolute-position.y + event.position.y, true);
                return DragAction.none;
            }
        }

        // The only FocusScope in the tree, round the whole layout.
        shortcut-scope := ShortcutScope {
            width: 100%;
            height: 100%;

        // On `render-active`, the fade-delayed `active`, so only one branch is ever mounted.
        if !mini-switch.render-active: Rectangle {
            width: 100%;
            height: 100%;

            VerticalLayout {
            // Over the sidebar and the panel, which a caption's tooltip hangs down onto.
            if !Theme.use-native-titlebar: CustomTitleBar { z: 1; }

            // A right gutter only, the titlebar, sidebar and bar framing the panel's other sides.
            // Native mode keeps it, the panel rounding all four corners.
            HorizontalLayout {
                vertical-stretch: 1;
                padding-right: Theme.pad-xs;

                sidebar := Sidebar {
                    room: root.queue-docked ? root.sidebar-room : root.bare-sidebar-room;
                }

                // Rounded by `RoundedFrame`, not a rounded clip, which would hold the view as a
                // texture redrawn on every scroll. This clip only keeps a sliding view off its
                // neighbours.
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        background: Theme.base;
                    }

                    // On the panel rather than a detail's list, which unmounts inside the band's
                    // morph and can't carry the report's tracker. The width also sizes the grid
                    // cover tier, so it is announced only when it changes.
                    WindowRectReport {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        moved(rect) => {
                            FileDrag.content-rect = rect;
                            if (rect.width != WindowChrome.content-panel-width) {
                                WindowChrome.content-panel-width = rect.width;
                                WindowChrome.content-panel-resized();
                            }
                        }
                    }

                    // One branch per nav index, each gated on `!now-playing-open` too. Unrouted
                    // indices fall through to the placeholder.
                    if !Nav.now-playing-open && Nav.selected-index == 0: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        SearchView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 1: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        BrowseView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 2: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        FavoritesView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 3: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        MyLibraryView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 8: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        RecentlyPlayedView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open && Nav.selected-index == 9: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        SettingsView { width: 100%; height: 100%; }
                    }
                    // Gated with the sidebar row, so the switch mounts the section with no restart.
                    // The fall-through keeps a plain `!= 10`: `ui::radio::disable` folds the live
                    // index, so nothing selects 10 with the switch off.
                    if !Nav.now-playing-open && Settings.radio-enabled
                        && Nav.selected-index == 10: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        RadioView { width: 100%; height: 100%; }
                    }
                    if !Nav.now-playing-open
                        && Nav.selected-index != 0
                        && Nav.selected-index != 1
                        && Nav.selected-index != 2
                        && Nav.selected-index != 3
                        && Nav.selected-index != 8
                        && Nav.selected-index != 9
                        && Nav.selected-index != 10: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: Nav.pending-enter-from;
                        PlaceholderView {
                            width: 100%;
                            height: 100%;
                            title: root.view-title(Nav.selected-index);
                        }
                    }
                    // `above` fixed: only the open animates.
                    if Nav.now-playing-open: ViewTransition {
                        width: parent.width;
                        height: parent.height;
                        enter-from: NavEnterFrom.above;
                        NowPlayingView { width: 100%; height: 100%; }
                    }

                    // Under the floating queue, which the row draws over the content panel, and
                    // ahead of the frame, so the corners and the border stay drawn over the dim.
                    QueueScrim {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                    }

                    // Last, over every view, masking in the shell's ground, which is all that shows
                    // round the panel. The shell's radius, so the arcs are concentric.
                    RoundedFrame {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        radius: Theme.window-radius;
                        stroke-width: 1px;
                        stroke-color: Theme.border;
                        ground: WindowChrome.mantle;
                    }
                }

                // Mounted whether shown or not, so it can ease out. Floating, it draws over the
                // content panel, whose width is the row's less a sidebar an overlay never folds.
                QueuePanel {
                    open-w: clamp(root.queue-room, Theme.queue-panel-min-w, root.queue-chosen-w);
                    room: root.queue-room;
                    float-w: min(
                        root.queue-chosen-w,
                        root.row-w - 2 * self.float-inset
                            - (Nav.sidebar-rail
                                ? Theme.sidebar-collapsed-w
                                : Nav.sidebar-expanded-w));
                }
            }

            NowPlayingBar {}
            }

            // The collapsed rail's tooltip, after the layout because paint order is declaration
            // order and the sidebar is the row's first child. `x` rides the live rail, and the
            // 500 ms reveal outlasts the collapse, so no pill surfaces beside readable labels.
            sidebar-tip := Rectangle {
                x: sidebar.absolute-position.x - parent.absolute-position.x;
                y: Nav.sidebar-tip-y - parent.absolute-position.y;
                width: sidebar.width;
                height: Nav.sidebar-tip-h;

                // Rail rows sit 4 px apart, so a pointer travelling the rail is over nothing for a
                // frame and would restart the reveal per row. `held` only extends: it is written
                // from `changed`, which skips a first evaluation, so `row-hovered` is what arms.
                property <bool> row-hovered: Nav.sidebar-tip-idx != -1;
                property <bool> held;
                changed row-hovered => {
                    if (self.row-hovered) { self.held = true; }
                }
                // Crosses the widest gap, a Divider, at a deliberate pace; leaving still dismisses.
                Timer {
                    interval: 150ms;
                    running: !sidebar-tip.row-hovered && sidebar-tip.held;
                    triggered => { sidebar-tip.held = false; }
                }

                Tooltip {
                    text: Nav.sidebar-tip-label;
                    hovered: (sidebar-tip.row-hovered || sidebar-tip.held)
                        && Nav.sidebar-rail;
                    host-width: sidebar-tip.width;
                    host-height: sidebar-tip.height;
                    side: TooltipSide.right;
                    // Clears the rail, so the pill reads as part of the panel it floats over.
                    gap: Theme.pad-md;
                }
            }
        }

        if mini-switch.render-active: MiniPlayerView {
            width: 100%;
            height: 100%;
        }

        // The swap's crossfade, painted over the mounted branch rather than spent as `opacity` on
        // it. Over the opaque `mantle` the two are one pixel, without a layer every frame or glyph
        // ink cropped to its box.
        Rectangle {
            width: 100%;
            height: 100%;
            background: WindowChrome.mantle.transparentize(mini-switch.fade-opacity);
            visible: mini-switch.fade-opacity < 1.0;
        }
        }

        // The overlays share the shell's clip, so a dialog's backdrop takes the window's corners
        // and nothing paints into the margins the native miniplayer leaves transparent.

        // **Below `DialogOverlay`**: the folder picker can raise a real `Dialog`, which has to
        // paint over the card and take Esc first. Rust holds the unmount past `Onboarding.open`
        // for the fade.
        if Onboarding.mounted: OnboardingOverlay {
            width: 100%;
            height: 100%;
        }

        // Always rendered so it can animate; its TouchArea is `enabled` only while `Dialog.open`.
        DialogOverlay {
            width: 100%;
            height: 100%;
        }

        // Above the dialog's backdrop. No root TouchArea, so its empty area blocks no clicks.
        NotificationStack {
            width: 100%;
            height: 100%;
        }

        // `Drag` keeps the pointer in window coordinates, which the shell sits inside its margins
        // from.
        if Drag.live && Drag.ghost-shown && Drag.payload.items.kind != "": DragGhost {
            x: Drag.x - parent.absolute-position.x;
            y: Drag.y - parent.absolute-position.y;
        }

        // Last, so nothing paints over the edge, a scrim included. One physical pixel at every
        // scale, as the OS draws it.
        if root.rounded-shell && Settings.window-border-shown: EdgeOutline {
            width: 100%;
            height: 100%;
            radius: Theme.window-radius;
            stroke-width: 1phx;
            stroke-color: Theme.window-focused
                ? WindowChrome.border-color
                : WindowChrome.border-color-unfocused;
        }
    }

    // Above the overlays, so a dialog or the first-run card can't take resizing away, and full
    // size, the band being the client's edge, margins and all.
    ResizeRing {
        width: 100%;
        height: 100%;
        active: root.rounded-shell;
        band: root.resize-band;
        radius: Theme.window-radius;
    }
}
