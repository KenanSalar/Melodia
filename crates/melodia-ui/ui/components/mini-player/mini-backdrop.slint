import { MiniPlayer } from "../../globals/shell.slint";
import { NpBackdropStack } from "../now-playing/np-backdrop-stack.slint";

// The miniplayer's artwork backdrop, unmounted once drained rather than left transparent: a
// gradient is never `is_transparent()`, so a hidden stack still fills the surface every frame, and
// this one is hidden on every install leaving the button off.
export component MiniBackdrop inherits Rectangle {
    in property <duration> fade-duration;

    // Two flags, a fade needing both ends on screen: a press on mounts the stack unpainted and
    // paints it a tick later, a press off unpaints it and unmounts it once drained. `init` takes
    // both off the switch's binding, so only `set-shown` moves them.
    private property <bool> mounted: MiniPlayer.backdrop-shown;
    private property <bool> painting: MiniPlayer.backdrop-shown;
    init => {
        root.mounted = MiniPlayer.backdrop-shown;
        root.painting = MiniPlayer.backdrop-shown;
    }

    // Imperative rather than a `changed` on the switch: the miniplayer sits behind an `if`, and a
    // tracker on a global outlives its branch, so the next miniplayer's press would panic.
    public function set-shown(on: bool) {
        drain.running = false;
        if (on) {
            // Still mounted means mid-drain, with painted frames to ease back from.
            root.painting = root.mounted;
            root.mounted = true;
        } else {
            root.painting = false;
            drain.running = true;
        }
        MiniPlayer.backdrop-shown = on;
        MiniPlayer.set-backdrop-shown(on);
    }

    // Reads the switch rather than clearing the flag, for a press back on as it fires.
    drain := Timer {
        interval: root.fade-duration;
        running: false;
        triggered => {
            self.running = false;
            root.mounted = MiniPlayer.backdrop-shown;
        }
    }

    if root.mounted: NpBackdropStack {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        shown: root.painting;

        // A tick after the mount, so it eases from the values its layers read in `init`. Reads the
        // switch, for a press back off inside that tick.
        Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                root.painting = MiniPlayer.backdrop-shown;
            }
        }
    }
}
