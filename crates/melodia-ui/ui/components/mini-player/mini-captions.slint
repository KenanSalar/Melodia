import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Lyrics } from "../../globals/lyrics.slint";
import { MiniPlayer, WindowChrome } from "../../globals/shell.slint";
import { TooltipSide } from "../tooltip.slint";
import { CaptionButton, CaptionGlyph, CaptionStyle, MinimizeCaption, CloseCaption } from "../caption-buttons.slint";
import { MacOsTitleBarCluster } from "../macos-titlebar-cluster.slint";
import { MiniIconButton, MiniGlyphs } from "mini-icon-button.slint";

// Minimize, full player and close in the style the Settings card picked. The middle one restores
// rather than maximizes: a miniplayer is a window size, so growing it hands back the full player.
//
// A layout, so the `if`-mounted captions size it. Each takes the titlebar's cell, this row being
// the window's top edge as the titlebar is.
export component MiniCaptions inherits HorizontalLayout {
    // Eased by the host; the caption steps hover and its fill itself.
    in property <brush> ink;
    // The glyph a KDE caption punches out of its lit disc.
    in property <brush> ink-on-lit;
    in property <float> fade: 1.0;

    // A constraint only to the macOS arm, whose `GridLayout` would otherwise top-align its lights.
    private property <length> cell-height: MiniPlayer.captions-height;

    out property <CaptionStyle> style: MiniPlayer.button-style == 2
        ? CaptionStyle.kde
        : CaptionStyle.standard;
    private property <brush> caption-hover-fg:
        root.style == CaptionStyle.kde ? root.ink-on-lit : MiniGlyphs.lit;
    // A caption has no `hover-lift` and fills its whole cell, so on the backdrop it takes the disc
    // buttons' tier where `MiniGlyphs.hover-bg` goes transparent.
    private property <brush> caption-hover-bg: root.style == CaptionStyle.kde
        ? MiniGlyphs.lit
        : MiniPlayer.backdrop-shown ? Player.np-accent-disc-hover : MiniGlyphs.hover-bg;

    horizontal-stretch: 0;
    spacing: 0;

    // The corner is fixed, so the cluster's side is too.
    if MiniPlayer.button-style == 1: MacOsTitleBarCluster {
        captions-left: false;
        cell-height: root.cell-height;
        maximize-tooltip: @tr("Full Player");
        fade: root.fade;
        maximize => { WindowChrome.restore-full-player(); }
    }
    if MiniPlayer.button-style != 1: MinimizeCaption {
        style: root.style;
        cell-height: root.cell-height;
        fade: root.fade;
        idle-fg: root.ink;
        hover-fg: root.caption-hover-fg;
        hover-bg: root.caption-hover-bg;
    }
    if MiniPlayer.button-style != 1: CaptionButton {
        glyph: CaptionGlyph.maximize;
        style: root.style;
        tooltip-text: @tr("Full Player");
        cell-height: root.cell-height;
        fade: root.fade;
        idle-fg: root.ink;
        hover-fg: root.caption-hover-fg;
        hover-bg: root.caption-hover-bg;
        clicked => { WindowChrome.restore-full-player(); }
    }
    // Keeps its danger hover on either surface, the warning being the point.
    if MiniPlayer.button-style != 1: CloseCaption {
        style: root.style;
        cell-height: root.cell-height;
        fade: root.fade;
        idle-fg: root.ink;
    }
}

// The captions in the corner and the lyrics switch opposite, the row fading and shrinking its
// buttons as the host closes it.
export component MiniCaptionsRow inherits Rectangle {
    // Up to `MiniPlayer.captions-height`.
    in property <length> open-height;
    // The host's inset from the window edge, which the captions reach back over.
    in property <length> edge-pad;
    in property <brush> ink;
    in property <brush> ink-on-lit;

    // Enough to read as leaving, not as a second size.
    private property <float> exit-scale: 0.8;
    // Any lower and the row closes through a button still showing, cutting the lyrics glyph.
    private property <float> fade-end: 0.5;

    private property <float> open-t: root.open-height / MiniPlayer.captions-height;
    private property <float> row-fade: clamp((root.open-t - root.fade-end) / (1 - root.fade-end), 0, 1);
    private property <float> button-scale: root.exit-scale + (1 - root.exit-scale) * root.row-fade;

    min-height: root.open-height;
    max-height: root.open-height;

    // Unmounted once faded, so a closed row draws and catches nothing.
    if root.row-fade > 0: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        // Only while moving: open, a caption's tooltip hangs below the row.
        clip: root.open-t < 1;

        HorizontalLayout {
            x: 0;
            // Reaches back over the host's inset once open, so the cells land on the window's top
            // edge as the titlebar's do.
            y: (parent.height - self.height) / 2 - root.edge-pad * root.open-t;
            width: parent.width;
            height: MiniPlayer.captions-height;
            spacing: 2px;
            padding-left: 4px;
            // The titlebar's inset for the style, flush for all but KDE, where Breeze keeps a gap.
            padding-right: (captions.style == CaptionStyle.kde
                ? Theme.kde-caption-edge-pad
                : 0px) - root.edge-pad;
            cross-axis-alignment: center;

            // A station has no track to look a sheet up for.
            if !Player.vm.has_station: MiniIconButton {
                icon: "lyrics";
                // Sized rather than `transform-scale`d: FemtoVG draws a scaled glyph as a path, and
                // this one comes out filled.
                icon-size: round(18px * root.button-scale / Theme.text-size-step)
                    * Theme.text-size-step;
                active: Lyrics.enabled;
                filled: Lyrics.enabled;
                fade: root.row-fade;
                tooltip-text: Lyrics.enabled
                    ? @tr("Show Up Next") : @tr("Show lyrics");
                tooltip-side: TooltipSide.right;
                // The property swaps the panel on the press, the callback persists it.
                clicked => {
                    Lyrics.enabled = !Lyrics.enabled;
                    Lyrics.set-enabled(Lyrics.enabled);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            captions := MiniCaptions {
                transform-scale: root.button-scale;
                ink: root.ink;
                ink-on-lit: root.ink-on-lit;
                fade: root.row-fade;
            }
        }
    }
}
