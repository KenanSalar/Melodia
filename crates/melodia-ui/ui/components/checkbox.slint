import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// Purely visual: the host wraps it in whatever `TouchArea` its click needs, a track row's carrying
// shift and ctrl range picks.
export component Checkbox inherits Rectangle {
    in property <bool> checked;
    // A knob because hosts disagree: the Settings overflow grid and the track row want the empty box
    // as present as the text beside it, where the popup and queue boxes stay quiet.
    in property <brush> unchecked-border: Theme.surface1;
    // A dimmed host's fade, handed down so the host needs no `opacity`.
    in property <float> fade: 1.0;

    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: (root.checked ? Theme.accent : transparent).transparentize(1.0 - root.fade);
    border-color: (root.checked ? Theme.accent : root.unchecked-border).transparentize(1.0 - root.fade);
    border-width: 1px;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    if root.checked: MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "check";
        icon-size: 14px;
        icon-color: Theme.crust;
        fade: root.fade;
    }
}
