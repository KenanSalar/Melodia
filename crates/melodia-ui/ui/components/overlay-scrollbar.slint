import { Theme } from "../theme.slint";

// **The only scrollbar in the tree**, for either axis; the root `CLAUDE.md` has why and the mount
// rules. The thumb keeps one size, only its colour shifting on hover. **The host owns the offset**:
// it binds `offset` from its scroller and writes the negated value back on every `scroll-to`.
//
// The drag works in **absolute** coordinates snapshotted on press, so the thumb tracks the cursor
// 1:1 even if the host resizes mid-drag. A click on the bare track jumps the thumb's centre there.
export component OverlayScrollbar inherits Rectangle {
    in property <bool> horizontal: false;
    in property <length> visible-size;
    in property <length> content-size;
    in property <length> offset;

    // Overridden by tighter contexts, the collapsed rail and the miniplayer.
    in property <length> bar-thickness: 8px;
    in property <length> bar-radius: 4px;
    in property <length> min-thumb: 28px;

    // Tuned for a bar on the **page**. Up Next tints all three with the per-artwork accent, and a
    // bar on a card passes `Theme.scrollbar-track-on-card`, which argues why. The same brush for
    // both thumb states drops the thumb's hover shift; the track's ramp still reports it.
    in property <brush> track-color: Theme.surface0;
    in property <brush> thumb-color: Theme.surface2;
    in property <brush> thumb-active-color: Theme.accent;
    // A knob rather than alpha baked into `track-color`, because it eases between the two. The thumb
    // has no ramp, so a translucent one bakes its alpha into its brushes.
    in property <float> track-opacity: 0.5;
    in property <float> track-opacity-active: 0.85;
    // `IconButton`'s knob, for its reason: every value above is eased here.
    in property <duration> recolor-duration: Theme.dur-fast;
    // `IconButton`'s, for a host handing over a tier Rust writes once.
    in property <bool> on-backdrop: false;

    out property <bool> dragging: touch.pressed;

    callback scroll-to(length);

    visible: root.content-size > root.visible-size;
    background: transparent;
    private property <length> max-extent: max(1px, root.content-size - root.visible-size);
    private property <length> track-len: root.horizontal ? root.width : root.height;
    private property <length> thumb-len: max(
        root.min-thumb,
        root.track-len * root.visible-size / max(1px, root.content-size)
    );
    private property <length> thumb-travel: max(0px, root.track-len - root.thumb-len);
    private property <length> thumb-pos: root.thumb-travel * (root.offset / root.max-extent);

    private property <bool> active: touch.has-hover || root.dragging;

    // Drag snapshot taken on press.
    private property <length> press-offset;
    private property <length> press-abs;

    Rectangle {
        x: root.horizontal ? 0px : (root.width - root.bar-thickness) / 2;
        y: root.horizontal ? (root.height - root.bar-thickness) / 2 : 0px;
        width: root.horizontal ? root.width : root.bar-thickness;
        height: root.horizontal ? root.bar-thickness : root.height;
        border-radius: root.bar-radius;
        background: root.track-color;
        opacity: root.active ? root.track-opacity-active : root.track-opacity;
        // The colour eases with the thumb's, so a host repainting the bar sees both halves cross
        // together.
        animate background, opacity { duration: root.recolor-duration; easing: ease-in-out; enabled: root.on-backdrop || !Theme.recoloring; }
    }

    // **The position is deliberately un-animated**: derived from `offset`, it would phase-lag the
    // cursor through a drag.
    Rectangle {
        x: root.horizontal ? root.thumb-pos : (root.width - root.bar-thickness) / 2;
        y: root.horizontal ? (root.height - root.bar-thickness) / 2 : root.thumb-pos;
        width: root.horizontal ? root.thumb-len : root.bar-thickness;
        height: root.horizontal ? root.bar-thickness : root.thumb-len;
        border-radius: root.bar-radius;
        background: root.active ? root.thumb-active-color : root.thumb-color;
        animate background { duration: root.recolor-duration; easing: ease-in-out; enabled: root.on-backdrop || !Theme.recoloring; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                // Inside the thumb, it drags from where it was grabbed; on the bare track, its
                // centre jumps to the cursor first.
                if ((root.horizontal ? self.pressed-x : self.pressed-y) >= root.thumb-pos
                    && (root.horizontal ? self.pressed-x : self.pressed-y) <= root.thumb-pos + root.thumb-len) {
                    root.press-offset = root.offset;
                } else {
                    root.press-offset = clamp(
                        (((root.horizontal ? self.pressed-x : self.pressed-y)
                            - root.thumb-len / 2)
                         / max(1px, root.thumb-travel)) * root.max-extent,
                        0px, root.max-extent
                    );
                    root.scroll-to(root.press-offset);
                }
                root.press-abs = root.horizontal
                    ? (self.absolute-position.x + self.pressed-x)
                    : (self.absolute-position.y + self.pressed-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.scroll-to(clamp(
                    root.press-offset
                        + (((root.horizontal
                                ? (self.absolute-position.x + self.mouse-x)
                                : (self.absolute-position.y + self.mouse-y))
                            - root.press-abs)
                           / max(1px, root.thumb-travel)) * root.max-extent,
                    0px, root.max-extent
                ));
            }
        }
    }
}
