import { Theme } from "../theme.slint";

// Fires `close()` each time the OS window goes unfocused. **Mounted inside the popup's own
// `PopupWindow`**, whose body exists only while it is open, however many hosts instantiate one.
export component FocusLossWatcher {
    callback close();
    property <bool> watched-focused: Theme.window-focused;
    changed watched-focused => {
        if (!self.watched-focused) {
            root.close();
        }
    }
}
