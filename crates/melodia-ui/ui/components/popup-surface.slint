import { Theme } from "../theme.slint";

// Every popup's chrome, the immediate child of its `PopupWindow`. `pill` takes the half-short-axis
// radius the volume slider's vertical chrome wants. No entry animation: a popup appears at once.
export component PopupSurface inherits Rectangle {
    in property <bool> pill: false;

    background: Theme.crust;
    border-color: Theme.surface2;
    border-width: 1px;
    border-radius: root.pill ? min(self.width, self.height) / 2 : Theme.radius-md;
}
