import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { LiftedRun, TrackListRow, TrackColumns, TrackColumnLayout } from "../../models.slint";
import { TrackColumnSizing } from "../../globals/track-columns.slint";
import { ListTravel } from "../../globals/list-travel.slint";
import { Selection } from "../../globals/selection.slint";
import { DragOrigin } from "../../globals/drag.slint";
import { TrackListHeader } from "track-list-header.slint";
import { TrackListRowItem } from "track-list-row.slint";
import { DragSource } from "../drag-source.slint";
import { ListDropTarget } from "../list-drop-target.slint";

// The track table every list view embeds, each owning its column state. The columns always fit
// the width, shrinking rather than dropping out, so nothing pans sideways.
//
// A list that takes its own rows back names itself in `origin` (Playlist Detail), and reorders
// only while `reorder-enabled`, a reorder being ambiguous in any sort but the insertion one.
//
// The host mounts the scrollbar, so it sits flush with the panel's edge rather than inside this
// padding (`TrackListScrollbars`).
export component TrackList inherits Rectangle {
    in property <[TrackListRow]> rows;

    // `in-out`, so a divider drag or the column popup writes host state synchronously.
    in-out property <TrackColumns> columns;

    // From this element's edges, which on every page but Search's column are the content panel's.
    in property <length> inset-left: Theme.track-list-inset;
    in property <length> inset-right: Theme.scrollbar-slot;

    // Resolved once for the header and every row, so none can disagree about where a column is.
    property <TrackColumnLayout> layout: TrackColumnSizing.resolve(root.columns,
        root.width - root.inset-left - root.inset-right, Theme.pad-sm);

    in property <string> number-mode: "index";

    // Drives the header's chevron; the host owns the sort.
    in property <string> sort-field;
    in property <string> sort-dir;

    // `false` makes the headers plain labels while resizing and the column popup keep working.
    in property <bool> sortable: true;

    in property <int> playing-track-id;

    in property <DragOrigin> origin: DragOrigin.none;
    in property <bool> reorder-enabled: false;
    // Only a list with an origin of its own dims what its drag lifted.
    property <bool> reorderable: root.origin != DragOrigin.none;
    // `none` is also what a disarmed drag carries, so a list without an origin would take that
    // payload as its own row.
    property <bool> moves-rows: root.reorderable && root.reorder-enabled;

    pure function in-travel(y: length) -> length {
        return ListTravel.pin(y, inner-list.visible-height, inner-list.content-height);
    }

    callback request-sort(string /*field*/);
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int]);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();
    callback request-blur-search();
    callback reorder(int /*from*/, int /*to*/);
    callback move-picks(int /*slot*/);
    // Only the host's Rust can say where the picks sit in a list it pages.
    callback picked-run() -> LiftedRun;
    callback remove-from-playlist([int] /*track_ids*/);

    in property <string> view-context;
    in property <int> current-playlist-id: 0;
    in property <[int]> view-selected-ids;

    // A property and a setter rather than `<=>`, which can't bind through the sign flip: positive
    // here is N px scrolled. `body-y` skips the header band, relative to this root.
    out property <length> v-visible-height: inner-list.visible-height;
    out property <length> v-viewport-height: inner-list.content-height;
    out property <length> v-offset: -inner-list.content-y;
    out property <length> body-y: inner-list.absolute-position.y - root.absolute-position.y;
    out property <length> body-height: inner-list.height;

    // For a host sizing the list to what it holds, floored at one row. Reads no geometry, so the
    // list's own `height` may bind to it.
    out property <length> content-height: Theme.track-header-h + Theme.pad-xs
        + max(1, root.rows.length) * Theme.track-row-pitch(root.columns.show_artwork);

    callback set-v-offset(length);

    set-v-offset(o) => { inner-list.content-y = -o; }

    VerticalLayout {
        padding-left: root.inset-left;
        padding-right: root.inset-right;
        spacing: Theme.pad-xs;

        TrackListHeader {
            columns <=> root.columns;
            layout: root.layout;
            sort-field: root.sort-field;
            sort-dir: root.sort-dir;
            sortable: root.sortable;
            sort-clicked(f) => { root.request-sort(f); }
        }

        src := DragSource {
            vertical-stretch: 1;
            origin: root.origin;
            allow-copy: true;
            allow-move: root.moves-rows;
            background-clicked => { root.request-blur-search(); }

            inner-list := ListView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                // A drag and a drag-pan are one gesture (`slint-pitfalls.md`).
                mouse-drag-pan-enabled: false;
                for r[idx] in root.rows: TrackListRowItem {
                    row-data: r;
                    row-index: idx;
                    prev-selected: idx > 0 && root.rows[idx - 1].selected;
                    next-selected: idx < root.rows.length - 1 && root.rows[idx + 1].selected;
                    columns: root.columns;
                    layout: root.layout;
                    number-mode: root.number-mode;
                    sort-field: root.sort-field;
                    sort-dir: root.sort-dir;
                    row-count: root.rows.length;
                    playing-track-id: root.playing-track-id;
                    view-context: root.view-context;
                    current-playlist-id: root.current-playlist-id;
                    view-selected-ids: root.view-selected-ids;
                    lifted: root.reorderable
                        && (src.lifts(idx) || (r.selected && src.lifting-picks));
                    // Lifted under a copy-only sort too, so every row the chip counts dims.
                    pressed => {
                        src.arm-items(idx, self.drag-items());
                        if (root.reorderable
                            && Selection.acts-on-set(r.selected, root.view-selected-ids.length)) {
                            src.lift-picks(root.picked-run());
                        }
                    }
                    double-clicked-row => { root.play-row(r.id, idx); }
                    toggle-favorite => { root.toggle-row-favorite([r.id], !r.is_favorite); }
                    play-row(id, i) => { root.play-row(id, i); }
                    play-next(ids) => { root.play-next(ids); }
                    add-to-queue(ids) => { root.add-to-queue(ids); }
                    toggle-row-favorite(ids, on) => { root.toggle-row-favorite(ids, on); }
                    set-row-rating(ids, n) => { root.set-row-rating(ids, n); }
                    select-row(i, id, sh, ct) => { root.select-row(i, id, sh, ct); }
                    select-all => { root.select-all(); }
                    clear-selection => { root.clear-selection(); }
                    request-remove-from-playlist(ids) => { root.remove-from-playlist(ids); }
                    request-blur-search => { root.request-blur-search(); }
                }
            }
        }
    }

    ListDropTarget {
        x: inner-list.absolute-position.x - root.absolute-position.x;
        y: inner-list.absolute-position.y - root.absolute-position.y;
        width: inner-list.width;
        height: inner-list.height;
        enabled: root.moves-rows;
        origin: root.origin;
        row-height: Theme.track-row-pitch(root.columns.show_artwork);
        row-count: root.rows.length;
        content-y: inner-list.content-y;
        reorder(from, to) => { root.reorder(from, to); }
        move-picks(slot) => { root.move-picks(slot); }
        scroll-by(dy) => {
            inner-list.content-y = root.in-travel(inner-list.content-y - dy);
        }
    }
}
