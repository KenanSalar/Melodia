import { Theme } from "../../theme.slint";
import { TrackColumns, TrackColumnLayout, TrackColumn } from "../../models.slint";
import { TrackColumnSizing } from "../../globals/track-columns.slint";
import { MaterialIcon } from "../material-icon.slint";

// The column divider, as wide as the gap between two cells, with a hairline in its middle that
// brightens on hover and again while dragging. It reports how far the pointer has travelled since
// the press and leaves what that means to the header. Works in **absolute** coordinates, so the
// handle doesn't trail the cursor as the cells around it resize.
component ResizeHandle inherits Rectangle {
    callback grabbed();
    callback dragged(length /*delta*/);

    property <length> press-abs-x: 0px;

    width: Theme.pad-sm;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: touch.pressed
            ? Theme.accent
            : (touch.has-hover ? Theme.surface1 : Theme.border);
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
    }

    touch := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-abs-x = self.absolute-position.x + self.pressed-x;
                root.grabbed();
            }
        }
        moved => {
            if (self.pressed) {
                root.dragged(self.absolute-position.x + self.mouse-x - root.press-abs-x);
            }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> field;
    in property <bool> right-aligned;
    in property <string> active-field;
    in property <string> active-dir;
    in property <bool> sortable: true;

    callback clicked();

    // Radius-less, so a scissor rather than a texture.
    clip: true;

    // Its `x` and `y` keep it out of the cell's layout info.
    Rectangle {
        x: 0;
        y: Theme.pad-xs;
        width: 100%;
        height: parent.height - 2 * Theme.pad-xs;
        background: touch.has-hover ? Theme.surface0 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
        border-radius: Theme.radius-md;
    }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: 2px;
        alignment: root.right-aligned ? end : start;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            // The rows' size and rung: weight alone reads as a header, so it gives up no contrast.
            color: root.active-field == root.field ? Theme.accent : Theme.text;
            font-size: Theme.font-size-row;
            font-weight: 600;
            overflow: elide;
        }
        if root.active-field == root.field: MaterialIcon {
            name: root.active-dir == "asc" ? "arrow_drop_up" : "arrow_drop_down";
            icon-size: 16px;
            icon-color: Theme.accent;
        }
    }

    // `enabled: false` is the whole gate: hover, cursor and click go, and the resize grab isn't
    // intercepted.
    touch := TouchArea {
        enabled: root.sortable;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One column's cell and the divider in the gap after it, placed for the header's reason below. The
// divider is the cell's sibling, so `sortable: false` leaves it grabbable.
component HeaderColumn inherits Rectangle {
    in property <string> label;
    in property <string> field;
    in property <string> active-field;
    in property <string> active-dir;
    in property <bool> sortable: true;
    // Off for the last column, which has no gap after it.
    in property <bool> resizable: true;

    callback sort-clicked(string /*field*/);
    callback grabbed();
    callback dragged(length /*delta*/);

    private property <length> cell-w: root.resizable ? root.width - Theme.pad-sm : root.width;

    HeaderCell {
        x: 0;
        y: 0;
        width: root.cell-w;
        height: root.height;
        label: root.label;
        field: root.field;
        active-field: root.active-field;
        active-dir: root.active-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.resizable: ResizeHandle {
        x: root.cell-w;
        y: 0;
        height: root.height;
        grabbed => { root.grabbed(); }
        dragged(delta) => { root.dragged(delta); }
    }
}

// The header row: a cell per visible column and a divider after every column but the last.
//
// Cells are placed, never laid out. `layout` comes off the list's own width, and a size derived
// from it inside a layout folds into the `layout_info` the host sizes the list from: a loop. A
// child that binds `x` contributes nothing to it. The rows place their cells for the same reason.
export component TrackListHeader inherits Rectangle {
    // A drag writes the caller's bound `columns` through `<=>`.
    in-out property <TrackColumns> columns;
    in property <TrackColumnLayout> layout;

    in property <string> sort-field;
    in property <string> sort-dir;

    // Off for a list whose order is the page rather than the user's pick (Recently Played).
    in property <bool> sortable: true;

    callback sort-clicked(string /*field*/);

    // What `columns` held when the current drag began.
    property <TrackColumns> pressed-columns;

    function drag(column: TrackColumn, delta: length) {
        root.columns = TrackColumnSizing.drag(root.pressed-columns, root.width, Theme.pad-sm,
            column, delta);
    }

    // A bound `height` is one the solver may treat as merely preferred; the min/max pair
    // pins it in a way the column solver respects, as Slint's own `ListItem` does.
    min-height: Theme.track-header-h;
    max-height: Theme.track-header-h;
    vertical-stretch: 0;

    // Reaches back over the leading gap, which holds no divider, so its label starts where the
    // numbers do.
    if root.columns.show_number: HeaderColumn {
        x: root.layout.number_x - Theme.pad-sm;
        y: 0;
        width: root.layout.number_w + 2 * Theme.pad-sm;
        height: root.height;
        label: "#";
        field: "track_number";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.number, delta); }
    }

    HeaderColumn {
        x: root.layout.title_x;
        y: 0;
        width: root.layout.title_w + Theme.pad-sm;
        height: root.height;
        label: @tr("Title");
        field: "title";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.title, delta); }
    }

    if root.columns.show_artist: HeaderColumn {
        x: root.layout.artist_x;
        y: 0;
        width: root.layout.artist_w + Theme.pad-sm;
        height: root.height;
        label: @tr("Artist");
        field: "artist";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.artist, delta); }
    }

    if root.columns.show_album: HeaderColumn {
        x: root.layout.album_x;
        y: 0;
        width: root.layout.album_w + Theme.pad-sm;
        height: root.height;
        label: @tr("Album");
        field: "album";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.album, delta); }
    }

    if root.columns.show_genre: HeaderColumn {
        x: root.layout.genre_x;
        y: 0;
        width: root.layout.genre_w + Theme.pad-sm;
        height: root.height;
        label: @tr("Genre");
        field: "genre";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.genre, delta); }
    }

    if root.columns.show_year: HeaderColumn {
        x: root.layout.year_x;
        y: 0;
        width: root.layout.year_w + Theme.pad-sm;
        height: root.height;
        label: @tr("Year");
        field: "year";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        sort-clicked(f) => { root.sort-clicked(f); }
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.year, delta); }
    }

    // Always last, so it is resized from the divider on its left.
    HeaderColumn {
        x: root.layout.length_x;
        y: 0;
        width: root.layout.length_w;
        height: root.height;
        label: @tr("Length");
        field: "length";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        resizable: false;
        sort-clicked(f) => { root.sort-clicked(f); }
    }

    // Slint borders are all-or-nothing, so the one edge kept is its own element; last, so no
    // cell's hover fill covers it.
    Rectangle {
        x: 0;
        y: root.height - self.height;
        width: root.width;
        height: 1px;
        background: Theme.border;
    }
}
