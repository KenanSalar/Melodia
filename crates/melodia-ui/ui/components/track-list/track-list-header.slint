import { Theme } from "../../theme.slint";
import { TrackColumns, TrackColumnLayout, TrackColumn } from "../../models.slint";
import { TrackColumnSizing } from "../../globals/track-columns.slint";
import { MaterialIcon } from "../material-icon.slint";

// The column divider, as wide as the gap between two cells, with a hairline in its middle that
// brightens on hover and again while dragging. It reports how far the pointer has travelled since
// the press and leaves what that means to the header. Works in **absolute** coordinates, so the
// handle doesn't trail the cursor as the cells around it resize.
component ResizeHandle inherits Rectangle {
    callback grabbed();
    callback dragged(length /*delta*/);

    property <length> press-abs-x: 0px;

    width: Theme.pad-sm;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: touch.pressed
            ? Theme.accent
            : (touch.has-hover ? Theme.surface1 : Theme.border);
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    }

    touch := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-abs-x = self.absolute-position.x + self.pressed-x;
                root.grabbed();
            }
        }
        moved => {
            if (self.pressed) {
                root.dragged(self.absolute-position.x + self.mouse-x - root.press-abs-x);
            }
        }
    }
}

// One header cell. `field` is what the click carries up, and the active column shows a
// chevron driven by the two sort inputs. `sortable: false` makes it a plain label — see
// the note on the row's own flag.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> field;
    in property <bool> right-aligned;
    in property <string> active-field;
    in property <string> active-dir;
    in property <bool> sortable: true;

    callback clicked();

    // Radius-less, as in the rows: a rounded clip would render the cell into a texture to cut
    // corners nothing reaches.
    clip: true;

    // The hover fill, in the track rows' hover colour. Binding `x` and `y` keeps it out of the
    // cell's layout info.
    Rectangle {
        x: 0;
        y: Theme.pad-xs;
        width: 100%;
        height: parent.height - 2 * Theme.pad-xs;
        background: touch.has-hover ? Theme.surface0 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
        border-radius: Theme.radius-md;
    }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: 2px;
        alignment: root.right-aligned ? end : start;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                // The same size and rung as the rows beneath it: weight alone reads as a
                // header, so it needn't give up contrast to separate itself, and on
                // `subtext0` it was the dimmest text on the app's densest screen.
                color: root.active-field == root.field ? Theme.accent : Theme.text;
                font-size: Theme.font-size-row;
                font-weight: 600;
                overflow: elide;
            }
        }
        if root.active-field == root.field: VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.active-dir == "asc" ? "arrow_drop_up" : "arrow_drop_down";
                icon-size: 16px;
                icon-color: Theme.accent;
            }
        }
    }

    // **`enabled: false` is the whole gate**: the item forces `has-hover` off, skips the
    // cursor write and forwards the event, so the hover fill and the pointer cursor go
    // with it and nothing intercepts the resize grab.
    touch := TouchArea {
        enabled: root.sortable;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The header row: a cell per visible column where `layout` puts it, and a divider in the gap after
// every column but the last.
//
// **Cells are placed, never laid out.** `layout` comes off the list's own width, and a size derived
// from that width inside a layout folds into the list's `layout_info`, which is what the host sizes
// the list from: a loop. A child that binds `x` contributes nothing to it. The rows place their
// cells for the same reason.
//
// A drag resolves against this element's width, the header spanning the list. Globals-free apart
// from the sizing arithmetic: the result writes the caller's bound `columns` through `<=>`, and a
// click emits the field.
export component TrackListHeader inherits Rectangle {
    in-out property <TrackColumns> columns;
    in property <TrackColumnLayout> layout;

    // Active sort indicator state.
    in property <string> sort-field;
    in property <string> sort-dir;

    // `false` makes every cell a plain label — no click, no hover fill, no cursor — for
    // a list whose order isn't the user's to pick: Recently Played is read in recency
    // order, so a column sort fights the point of the page. **Resizing is unaffected**,
    // the handles being siblings of the cells rather than children.
    in property <bool> sortable: true;

    callback sort-clicked(string /*field*/);

    // What `columns` held when the current drag began.
    property <TrackColumns> pressed-columns;

    function drag(column: TrackColumn, delta: length) {
        root.columns = TrackColumnSizing.drag(root.pressed-columns, root.width, Theme.pad-sm,
            column, delta);
    }

    // A bound `height` is one the solver may treat as merely preferred; the min/max pair
    // pins it in a way the column solver respects, as Slint's own `ListItem` does.
    min-height: Theme.track-header-h;
    max-height: Theme.track-header-h;
    vertical-stretch: 0;

    if root.columns.show_number: HeaderCell {
        x: root.layout.number_x;
        y: 0;
        width: root.layout.number_w;
        height: root.height;
        label: "#";
        field: "track_number";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.columns.show_number: ResizeHandle {
        x: root.layout.number_x + root.layout.number_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.number, delta); }
    }

    HeaderCell {
        x: root.layout.title_x;
        y: 0;
        width: root.layout.title_w;
        height: root.height;
        label: @tr("Title");
        field: "title";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    ResizeHandle {
        x: root.layout.title_x + root.layout.title_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.title, delta); }
    }

    if root.columns.show_artist: HeaderCell {
        x: root.layout.artist_x;
        y: 0;
        width: root.layout.artist_w;
        height: root.height;
        label: @tr("Artist");
        field: "artist";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.columns.show_artist: ResizeHandle {
        x: root.layout.artist_x + root.layout.artist_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.artist, delta); }
    }

    if root.columns.show_album: HeaderCell {
        x: root.layout.album_x;
        y: 0;
        width: root.layout.album_w;
        height: root.height;
        label: @tr("Album");
        field: "album";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.columns.show_album: ResizeHandle {
        x: root.layout.album_x + root.layout.album_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.album, delta); }
    }

    if root.columns.show_genre: HeaderCell {
        x: root.layout.genre_x;
        y: 0;
        width: root.layout.genre_w;
        height: root.height;
        label: @tr("Genre");
        field: "genre";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.columns.show_genre: ResizeHandle {
        x: root.layout.genre_x + root.layout.genre_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.genre, delta); }
    }

    if root.columns.show_year: HeaderCell {
        x: root.layout.year_x;
        y: 0;
        width: root.layout.year_w;
        height: root.height;
        label: @tr("Year");
        field: "year";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }
    if root.columns.show_year: ResizeHandle {
        x: root.layout.year_x + root.layout.year_w;
        y: 0;
        height: root.height;
        grabbed => { root.pressed-columns = root.columns; }
        dragged(delta) => { root.drag(TrackColumn.year, delta); }
    }

    // Always last, so it is resized from the divider on its left.
    HeaderCell {
        x: root.layout.length_x;
        y: 0;
        width: root.layout.length_w;
        height: root.height;
        label: @tr("Length");
        field: "length";
        active-field: root.sort-field;
        active-dir: root.sort-dir;
        sortable: root.sortable;
        clicked => { root.sort-clicked(self.field); }
    }

    // Slint borders are all-or-nothing, so the one edge kept is its own element; last, so no
    // cell's hover fill covers it.
    Rectangle {
        x: 0;
        y: root.height - self.height;
        width: root.width;
        height: 1px;
        background: Theme.border;
    }
}
