import { Theme } from "../../theme.slint";

// The artist, album and genre cells. The leading U+200E keeps the ellipsis at the right edge
// whatever the script's direction. The host places it, `x` and `width` both: sized by itself, the
// cell takes its text's full width and paints over the next column.
export component DataCell inherits Rectangle {
    in property <string> text-content;
    in property <brush> ink;

    clip: true;
    VerticalLayout {
        alignment: center;
        Text {
            text: "‎" + root.text-content;
            color: root.ink;
            font-size: Theme.font-size-row;
            overflow: elide;
        }
    }
}
