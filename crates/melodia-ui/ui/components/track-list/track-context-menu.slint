import { CopyActions } from "../../globals/copy-actions.slint";
import { TagEditor } from "../../globals/dialog-forms.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Nav } from "../../globals/nav.slint";
import { Playlists } from "../../globals/playlists.slint";
import { Selection } from "../../globals/selection.slint";
import { Theme } from "../../theme.slint";
import { ContextMenuMetrics, ContextMenuPopup, FavoriteMenuItem, MenuItem,
         MenuSeparator } from "../context-menu.slint";
import { RatingMenuRow } from "../rating-menu-row.slint";
import { TrackCopyFields } from "../track-copy-items.slint";

// The right-click menu every track row raises, and the only place its entries are mounted. The
// host says where through `show-at`, which stores it: an open popup follows its `x`/`y`, so an
// anchor bound to the pointer would drag the menu along.
//
// Anything a host reads back sits on this root, a host being unable to read into a `PopupWindow`.
export component TrackContextMenu inherits Rectangle {
    in property <int> row-id;
    in property <bool> row-is-favorite;
    in property <int> row-rating;
    in property <bool> row-selected;
    // 0 means no linkage and hides the entry.
    in property <int> album-id;
    in property <int> artist-id;
    in property <int> genre-id;
    // Suppresses the entry naming the surface you're on and picks the remove arm. One of
    // "tracks", "album-detail", "artist-detail", "genre-detail", "playlist-detail",
    // "smart-playlist-detail", "browse", "favorites", "recently_played", "search", "queue",
    // "up-next", "now-playing"; empty suppresses nothing.
    in property <string> view-context;
    // Playlist Detail's own, kept out of the Add-to-Playlist list. 0 = none.
    in property <int> current-playlist-id: 0;
    // The host's: a track list passes its `selected-ids`, the queue a deduped copy.
    in property <[int]> effective-selection;
    // Not `effective-selection.length`: the queue selects rows and acts on ids, and a track queued
    // twice makes those two numbers differ.
    in property <int> selection-count;

    out property <bool> multi-active: Selection.acts-on-set(root.row-selected, root.selection-count);
    out property <bool> is-open: pop.is-open;

    property <int> multi-count: root.selection-count;
    // The playing track, out of a queue holding it, with no set to select from.
    property <bool> on-now-playing: root.view-context == "now-playing";
    // Up Next picks nothing.
    property <bool> on-up-next: root.view-context == "up-next";
    property <bool> on-queue: root.view-context == "queue" || root.on-up-next;
    property <bool> show-play: !root.multi-active && !root.on-now-playing;
    // The queue is what both name.
    property <bool> show-queue-actions: !root.on-queue && !root.on-now-playing;
    property <bool> show-selection-actions: !root.on-now-playing && !root.on-up-next;

    // Shared with the separator above them, so it tracks any entry rather than the album's.
    property <bool> show-go-to-album:
        !root.multi-active && root.album-id != 0 && root.view-context != "album-detail";
    property <bool> show-go-to-artist:
        !root.multi-active && root.artist-id != 0 && root.view-context != "artist-detail";
    property <bool> show-go-to-genre:
        !root.multi-active && root.genre-id != 0 && root.view-context != "genre-detail";
    property <bool> any-cross-tab-visible:
        show-go-to-album || show-go-to-artist || show-go-to-genre;
    property <bool> show-remove: root.view-context == "playlist-detail" || root.on-queue;

    property <bool> copy-open;
    property <length> at-x;
    property <length> at-y;

    public function show-at(x: length, y: length) {
        root.copy-open = false;
        root.at-x = x;
        root.at-y = y;
        pop.show();
    }

    // Called by every entry but the rating row, after it acts, `effective-ids` going with the
    // popup. A star leaves the menu up so a pick can be corrected.
    function dismiss() {
        root.copy-open = false;
        pop.close();
    }

    // Hidden over a selection, so the host needs nothing back.
    callback play-single();
    // Batch-shaped, a single row being a one-element array.
    callback play-next([int]);
    callback add-to-queue([int]);
    callback toggle-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback rate([int] /*track_ids*/, int /*rating*/);
    callback request-remove([int] /*track_ids*/);
    // No payload: the host owns the set, the queue's being a different shape.
    callback select-all();
    callback clear-selection();

    // Zero-size, so it claims nothing in a row the virtualizer measures, and pinned here because a
    // zero-size wrapper is otherwise centred. The host reports in the row chrome's frame, and no
    // mount would know the offset is its problem.
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    // One per instantiated row, so a screenful whatever the library size.
    pop := ContextMenuPopup {
        anchor-x: root.at-x;
        anchor-y: root.at-y;
        // Off the root, which sits outside the popup and so still means the window.
        anchor-window-x: root.absolute-position.x + root.at-x;
        anchor-window-y: root.absolute-position.y + root.at-y;
        copy-open: root.copy-open;
        copy-fields: TrackCopyFields.list;
        copy-row-y: copy-row.y;
        dismiss-requested => { root.dismiss(); }
        copy-picked(token) => {
            CopyActions.copy-tracks(token, pop.effective-ids);
            root.dismiss();
        }

        property <[int]> effective-ids: Selection.effective-ids(
            root.row-id, root.row-selected, root.selection-count, root.effective-selection);
        property <int> visible-playlist-count:
            root.current-playlist-id > 0
                ? max(0, Playlists.count - 1)
                : Playlists.count;

        // Over a selection "Play" is ambiguous (queue it, or replace the queue with it), so only
        // a single row keeps it.
        if root.show-play: MenuItem {
            label: @tr("Play");
            icon: "play_arrow";
            clicked => {
                root.play-single();
                root.dismiss();
            }
        }
        if root.show-queue-actions: MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Play {} Next", root.multi-count)
                : @tr("Play Next");
            icon: "queue_play_next";
            clicked => {
                root.play-next(pop.effective-ids);
                root.dismiss();
            }
        }
        if root.show-queue-actions: MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Add {} to Queue", root.multi-count)
                : @tr("Add to Queue");
            icon: "queue_music";
            clicked => {
                root.add-to-queue(pop.effective-ids);
                root.dismiss();
            }
        }
        if root.show-queue-actions || root.show-play: MenuSeparator {}

        MenuItem {
            label: @tr("New Playlist…");
            icon: "add";
            clicked => {
                Dialog.open-create-playlist(pop.effective-ids);
                root.dismiss();
            }
        }
        // Only the heading is ours, the rest of the chrome being the opener's.
        if pop.visible-playlist-count > 0: MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Add {} to Playlist", root.multi-count)
                : @tr("Add to Playlist");
            icon: "playlist_add";
            clicked => {
                Dialog.prepare-add-to-playlist(root.multi-active
                    ? @tr("Add {} to Playlist", root.multi-count)
                    : @tr("Add to Playlist"));
                Dialog.pending-track-ids = pop.effective-ids;
                Dialog.pick-total-tracks = pop.effective-ids.length;
                Playlists.request-add-to-playlist(
                    pop.effective-ids,
                    root.current-playlist-id,
                );
                root.dismiss();
            }
        }

        MenuSeparator {}
        FavoriteMenuItem {
            is-favorite: root.row-is-favorite;
            multi-active: root.multi-active;
            multi-count: root.multi-count;
            clicked => {
                root.toggle-favorite(pop.effective-ids, !root.row-is-favorite);
                root.dismiss();
            }
        }
        // A Browse row outside the library has nothing to rate; a selection's host drops the ids
        // it can't.
        RatingMenuRow {
            row-height: ContextMenuMetrics.item-h;
            icon-size: 16px;
            star-size: 16px;
            idle-icon-color: Theme.subtext1;
            rating: root.row-rating;
            enabled: root.multi-active || root.row-id != 0;
            multi-active: root.multi-active;
            multi-count: root.multi-count;
            rated(n) => { root.rate(pop.effective-ids, n); }
        }

        // Don't set `Dialog.open` here: the opener raises it once Rust has filled `TagEditor`.
        MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Edit Tags for {}", root.multi-count)
                : @tr("Edit Tags…");
            icon: "edit";
            clicked => {
                Dialog.open-tag-editor(
                    root.multi-active
                        ? @tr("Edit {} Tracks", root.multi-count)
                        : @tr("Edit Track Information"),
                    pop.effective-ids,
                    TagEditor.tab-tags);
                root.dismiss();
            }
        }

        // Not behind an `if`, the flyout lining up against its `y`.
        MenuSeparator {}
        copy-row := MenuItem {
            label: @tr("Copy");
            icon: "content_copy";
            submenu: true;
            submenu-open: root.copy-open;
            submenu-left: pop.flyout-left;
            clicked => { root.copy-open = !root.copy-open; }
        }
        if !root.multi-active: MenuItem {
            label: @tr("Open Containing Folder");
            icon: "folder_open";
            clicked => {
                Nav.reveal-in-folder(root.row-id);
                root.dismiss();
            }
        }

        if root.any-cross-tab-visible: MenuSeparator {}
        if root.show-go-to-album: MenuItem {
            label: @tr("Go to Album");
            icon: "album";
            clicked => {
                Nav.go-to-album(root.album-id);
                root.dismiss();
            }
        }
        if root.show-go-to-artist: MenuItem {
            label: @tr("Go to Artist");
            icon: "person";
            clicked => {
                Nav.go-to-artist(root.artist-id);
                root.dismiss();
            }
        }
        if root.show-go-to-genre: MenuItem {
            label: @tr("Go to Genre");
            icon: "music_note";
            clicked => {
                Nav.go-to-genre(root.genre-id);
                root.dismiss();
            }
        }

        // Clear is offered wherever the host holds a set, this row in it or not: the picks can
        // sit far out of view on a long list. Both go through the host, ten globals keeping their
        // own sets.
        if root.show-selection-actions: MenuSeparator {}
        if root.show-selection-actions: MenuItem {
            label: @tr("Select all");
            icon: "select_all";
            clicked => {
                root.select-all();
                root.dismiss();
            }
        }
        if root.show-selection-actions && root.selection-count > 0: MenuItem {
            label: @tr("Clear selection");
            icon: "close";
            clicked => {
                root.clear-selection();
                root.dismiss();
            }
        }

        // Two arms rather than a host-supplied label, which would ship untranslated.
        if root.show-remove: MenuSeparator {}
        if root.view-context == "playlist-detail": MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Remove {} from Playlist", root.multi-count)
                : @tr("Remove from Playlist");
            icon: "playlist_remove";
            clicked => {
                root.request-remove(pop.effective-ids);
                root.dismiss();
            }
        }
        if root.on-queue: MenuItem {
            label: root.multi-active
                // Translators: `{}` is how many items are selected
                ? @tr("Remove {} from Queue", root.multi-count)
                : @tr("Remove from Queue");
            icon: "playlist_remove";
            clicked => {
                root.request-remove(pop.effective-ids);
                root.dismiss();
            }
        }
    }
}
