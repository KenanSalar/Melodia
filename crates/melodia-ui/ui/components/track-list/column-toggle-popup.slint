import { Theme } from "../../theme.slint";
import { TrackColumns } from "../../models.slint";
import { PillButton } from "../action-pill.slint";
import { Checkbox } from "../checkbox.slint";
import { PopupColumn } from "../popup-column.slint";
import { PopupFit } from "../popup-fit.slint";
import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// One row inside the column-toggle popup. Locked entries (Title, Length) render
// dimmed and never fire `toggled()`.
component ColumnToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> locked;

    callback toggled();

    // Dimmed through the brushes rather than `opacity`, which would hold a texture per locked row
    // for as long as the popup is open. A locked row takes no hover, so the fill needs none.
    private property <float> fade: root.locked ? 0.5 : 1.0;

    height: 32px;
    border-radius: Theme.radius-sm;
    background: !root.locked && touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: start;
        cross-axis-alignment: center;

        Checkbox {
            checked: root.checked;
            fade: root.fade;
        }

        Text {
            text: root.label;
            color: Theme.text.transparentize(1.0 - root.fade);
            font-size: Theme.font-size-md;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.locked ? default : pointer;
        clicked => {
            if (!root.locked) { root.toggled(); }
        }
    }
}

// A labelled pill opening a PopupWindow of per-column toggles, on the
// volume-popup pattern — right-aligned, close-on-click-outside, fade-in.
//
// Globals-free: the columns come in as `in-out` so the host's bound state
// flips synchronously, and `toggled` lets it persist the list under its own
// per-view key. Title and Length are listed but locked, so it's visible *why*
// they can't be hidden.
export component ColumnTogglePopup inherits Rectangle {
    in-out property <TrackColumns> columns;

    // Each drops its row outright on the detail view where every track shares
    // that field, and the column says nothing.
    in property <bool> hide-album: false;
    in property <bool> hide-artist: false;
    in property <bool> hide-genre: false;
    // `PillButton.compact-t`, for a host whose row is short of room.
    in property <float> compact-t: 0.0;

    callback toggled(string /*column_id*/);

    // Fixed to the pill row's height so the popup anchors below the chip's
    // bottom edge whatever the inner button's alignment.
    width: btn.width;
    height: 32px;

    // The label carries the meaning, so there's no tooltip repeating it; a compact pill moves it
    // to the tooltip instead.
    btn := PillButton {
        icon: "tune";
        text: @tr("Columns");
        compact-t: root.compact-t;
        force-bg: pop.is-open;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        // Below the pill, or above it where below is short and above has more room, so the list
        // never opens over the pill (`PopupFit`). Both off the outer box rather than the button,
        // so the gap holds whatever the button's own alignment does.
        property <length> above-y: root.absolute-position.y - Theme.popup-gap;
        property <length> below-y: root.absolute-position.y + root.height + Theme.popup-gap;
        property <bool> opens-above: PopupFit.opens-above(self.above-y, self.below-y, col.rows-h);

        // The trigger sits at the page's edge, where Slint clamps a popup's box flush to the
        // window: a negative-x offset just claims room the clamp takes back. The `pad-lg` margin
        // is held *inside* the popup instead, so the chrome stops short of the edge either way.
        x: btn.width - self.width;
        y: self.opens-above ? -Theme.popup-gap - self.height : root.height + Theme.popup-gap;
        width: col.rows-w + col.gutter + Theme.pad-lg;
        height: PopupFit.side-h(self.above-y, self.below-y, col.rows-h);
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { pop.close(); }
        }

        PopupSurface {
            x: 0px;
            y: 0px;
            width: parent.width - Theme.pad-lg;
            height: parent.height;

            col := PopupColumn {
                width: 100%;
                height: 100%;

                ColumnToggleRow {
                    // `#` is a numeric column glyph, not a word — left as-is.
                    label: "#";
                    checked: root.columns.show_number;
                    toggled => {
                        root.columns.show_number = !root.columns.show_number;
                        root.toggled("number");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Artwork");
                    checked: root.columns.show_artwork;
                    toggled => {
                        root.columns.show_artwork = !root.columns.show_artwork;
                        root.toggled("artwork");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Title");
                    checked: true;
                    locked: true;
                }
                if !root.hide-artist: ColumnToggleRow {
                    label: @tr("Artist");
                    checked: root.columns.show_artist;
                    toggled => {
                        root.columns.show_artist = !root.columns.show_artist;
                        root.toggled("artist");
                    }
                }
                if !root.hide-album: ColumnToggleRow {
                    label: @tr("Album");
                    checked: root.columns.show_album;
                    toggled => {
                        root.columns.show_album = !root.columns.show_album;
                        root.toggled("album");
                    }
                }
                if !root.hide-genre: ColumnToggleRow {
                    label: @tr("Genre");
                    checked: root.columns.show_genre;
                    toggled => {
                        root.columns.show_genre = !root.columns.show_genre;
                        root.toggled("genre");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Year");
                    checked: root.columns.show_year;
                    toggled => {
                        root.columns.show_year = !root.columns.show_year;
                        root.toggled("year");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Length");
                    checked: true;
                    locked: true;
                }
            }
        }
    }
}
