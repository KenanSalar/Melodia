import { Theme } from "../../theme.slint";
import { TrackListRow, TrackColumns, TrackColumnLayout } from "../../models.slint";
import { RowCovers } from "../../globals/tracks.slint";
import { Selection } from "../../globals/selection.slint";
import { DragItems } from "../../globals/drag.slint";
import { MaterialIcon } from "../material-icon.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { TrackTitle } from "track-title.slint";
import { TrackContextMenu } from "track-context-menu.slint";
import { ContextClick } from "../context-menu.slint";
import { DataCell } from "track-list-cell.slint";
import { Checkbox } from "../checkbox.slint";
import { SelectionPill } from "selection-pill.slint";

// One body row in a track table. The outer slot is what the ListView measures, `row-gap` of
// transparent space under the visible `chrome` pill; anything deriving a row pitch reads
// `Theme.track-row-pitch`.
export component TrackListRowItem inherits Rectangle {
    in property <TrackListRow> row-data;
    in property <int> row-index;

    // The `layout` the header places its cells by too.
    in property <TrackColumns> columns;
    in property <TrackColumnLayout> layout;

    // `"track_number"` is the album's own; `"index"` counts down N..1 under a descending `#` sort
    // so the column reads as sorted, which is why the row takes the sort and the list length.
    in property <string> number-mode: "index";
    in property <string> sort-field;
    in property <string> sort-dir;

    // Handed down rather than read off `Player`, so the row stays reusable.
    in property <int> playing-track-id;

    // Squares the pill's corners onto a selected neighbour; `TrackList` answers both.
    in property <bool> prev-selected;
    in property <bool> next-selected;

    property <bool> playing: root.row-data.id == root.playing-track-id;
    property <bool> selected: root.row-data.selected;
    // Every hover binding reads this, so the row stays lit under its own menu.
    property <bool> hovered: touch.has-hover || ctx-menu.is-open;
    property <bool> favorite-button-shown: root.hovered && root.columns.show_favorite_button;
    // The body picks only once the view holds a selection: the first pick is the box's, which
    // keeps an idle list from selecting by accident.
    property <bool> selecting: root.view-selected-ids.length > 0;
    property <bool> press-shift;
    // Disk-only Browse rows: dimmed, and every interaction swallowed.
    property <bool> enabled: root.row-data.enabled;
    // Through each brush rather than `opacity`, which holds a texture per dimmed row, and a drag
    // of picks lifts a screenful.
    property <float> fade: (root.enabled ? 1.0 : Theme.fade-disk-only)
        * (root.lifted ? Theme.fade-lifted : 1.0);
    // The body-copy rung for every cell, header included: the muted one fell under 4.5:1 on light
    // variants. Hierarchy comes from size and weight.
    property <brush> unfaded-ink: root.playing ? Theme.accent : Theme.text;
    property <brush> ink: root.unfaded-ink.transparentize(1.0 - root.fade);

    // `TrackContextMenu.view-context` lists the values.
    in property <string> view-context;
    // Playlist Detail's own, kept out of its Add-to-Playlist list. 0 = none.
    in property <int> current-playlist-id: 0;
    in property <[int]> view-selected-ids;
    in property <int> row-count: 0;
    in property <bool> lifted: false;
    property <length> pitch: Theme.track-row-pitch(root.columns.show_artwork);

    callback double-clicked-row();
    callback toggle-favorite();
    callback play-row(int /*track_id*/, int /*index*/);
    // Batch-shaped, a single row being a one-element array, so Rust has no single/batch branch.
    callback play-next([int]);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();
    // Ctrl is forced on unless shift is held, so a pick on a selected row always removes it.
    function pick(shift: bool) {
        root.select-row(root.row-index, root.row-data.id, shift, !shift);
    }
    callback request-remove-from-playlist([int] /*track_ids*/);
    // Slint doesn't blur a `TextInput` on an outside click, so the host clears focus on this.
    callback request-blur-search();
    callback pressed();

    // The set this row's menu acts on, under its own title and cover.
    public pure function drag-items() -> DragItems {
        return {
            kind: "track",
            ids: Selection.effective-ids(root.row-data.id, root.selected,
                root.view-selected-ids.length, root.view-selected-ids),
            title: root.row-data.title,
            cover: RowCovers.request(root.row-data.artwork_path, RowCovers.generation),
        };
    }

    // Pinned so the virtualizer can measure rows. The pitch drops to the compact height when the
    // artwork column is off.
    min-height: root.pitch;
    max-height: root.pitch;
    vertical-stretch: 0;

    // A free `width: 100%` chrome under a free Rectangle is the height-100% cycle that hands every
    // row ~0 height.
    VerticalLayout {
        padding-bottom: Theme.row-gap;

        chrome := Rectangle {
            // Pinned, or the pill grows under the cursor as the checkbox and heart swap in.
            min-height: Theme.track-row-h(root.columns.show_artwork);
            max-height: Theme.track-row-h(root.columns.show_artwork);
        // Radius-less, so a scissor rather than a texture.
        clip: true;

        if root.selected || root.hovered: SelectionPill {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            selected: root.selected;
            hovered: root.hovered;
            fade: root.fade;
            prev-selected: root.prev-selected;
            next-selected: root.next-selected;
        }

        // Wraps the cells so `cb-touch` and `fav-touch` are descendants: `has-hover` propagates
        // to ancestors but not cousins, and the checkbox unmounted under a pointer moving onto it.
        touch := TouchArea {
            enabled: root.enabled;
            // On `clicked`, which a release from the unmounting heart or stars never fires. A
            // drag sends a cancel, so it lands no pick.
            clicked => {
                if (root.enabled && root.selecting) {
                    root.pick(root.press-shift);
                }
            }
            // Still plays mid-selection: its two clicks pick and unpick, leaving the set as it was.
            double-clicked => { root.double-clicked-row(); }
            pointer-event(ev) => {
                // `clicked` carries no modifiers, so a range-pick's shift comes off the press.
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.press-shift = ev.modifiers.shift;
                    root.pressed();
                }
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                    root.request-blur-search();
                }
                if (root.enabled
                    && ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    ctx-menu.show-at(self.mouse-x, self.mouse-y);
                    root.request-blur-search();
                }
            }

            // Every cell is placed where `layout` says, never laid out, for the header's reason.
            if root.columns.show_number: Rectangle {
                x: root.layout.number_x;
                y: 0;
                width: root.layout.number_w;
                height: parent.height;
                clip: true;
                VerticalLayout {
                    alignment: center;
                    if !root.hovered && !root.selected: Text {
                        // An untagged track number falls back to the row position.
                        text: root.number-mode == "track_number"
                            ? (root.row-data.track_number > 0
                                ? root.row-data.track_number
                                : root.row-index + 1)
                            : ((root.sort-field == "track_number" && root.sort-dir == "desc")
                                ? root.row-count - root.row-index
                                : root.row-index + 1);
                        color: root.ink;
                        font-size: Theme.font-size-row;
                        horizontal-alignment: left;
                    }
                    if root.hovered || root.selected: Checkbox {
                        checked: root.selected;
                        // The number's ink, unfaded: the box applies `fade` to its rim itself.
                        unchecked-border: root.unfaded-ink;
                        fade: root.fade;

                        cb-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left && root.enabled) {
                                    root.pick(ev.modifiers.shift);
                                    root.request-blur-search();
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: root.layout.title_x;
                y: 0;
                width: root.layout.title_w;
                height: parent.height;
                clip: true;
                HorizontalLayout {
                    spacing: Theme.pad-sm;
                    alignment: start;
                    cross-axis-alignment: center;
                    if root.columns.show_artwork: ArtworkImage {
                        artwork-path: root.row-data.artwork_path;
                        // Per instantiated row, so only visible rows reach the tier; `generation`
                        // repaints a scheduled miss.
                        cover: RowCovers.request(root.row-data.artwork_path,
                            RowCovers.generation);
                        tile-size: 36px;
                        tile-radius: Theme.radius-sm;
                        fade: root.fade;
                    }
                    TrackTitle {
                        title: root.row-data.title;
                        ink: root.ink;
                        favorite-shown: root.columns.show_favorite_mark
                            && root.row-data.is_favorite;
                        rating: root.row-data.rating;
                        rating-shown: root.columns.show_rating_strip
                            && root.hovered && root.enabled;
                        fade: root.fade;
                        rated(n) => { root.set-row-rating([root.row-data.id], n); }
                    }
                }
            }

            if root.columns.show_artist: DataCell {
                x: root.layout.artist_x;
                y: 0;
                width: root.layout.artist_w;
                height: parent.height;
                // Sentence case, sharing the msgid the grid card and now-playing line use.
                text-content: root.row-data.artist != ""
                    ? root.row-data.artist
                    : @tr("Unknown artist");
                ink: root.ink;
            }
            if root.columns.show_album: DataCell {
                x: root.layout.album_x;
                y: 0;
                width: root.layout.album_w;
                height: parent.height;
                text-content: root.row-data.album != ""
                    ? root.row-data.album
                    : @tr("Unknown album");
                ink: root.ink;
            }
            if root.columns.show_genre: DataCell {
                x: root.layout.genre_x;
                y: 0;
                width: root.layout.genre_w;
                height: parent.height;
                text-content: root.row-data.genre;
                ink: root.ink;
            }

            if root.columns.show_year: Rectangle {
                x: root.layout.year_x;
                y: 0;
                width: root.layout.year_w;
                height: parent.height;
                clip: true;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.row-data.year > 0 ? root.row-data.year : "";
                        color: root.ink;
                        font-size: Theme.font-size-row;
                    }
                }
            }

            // The duration gives way to the favourite toggle on hover; the kept mark is the title's.
            Rectangle {
                x: root.layout.length_x;
                y: 0;
                width: root.layout.length_w;
                height: parent.height;
                clip: true;
                HorizontalLayout {
                    spacing: Theme.pad-xs;
                    alignment: start;
                    cross-axis-alignment: center;
                    if !root.favorite-button-shown: Text {
                        // Formatted in Rust, not by a pure function re-run on every invalidation.
                        text: root.row-data.display_duration;
                        color: root.ink;
                        font-size: Theme.font-size-row;
                        horizontal-alignment: left;
                    }
                    if root.favorite-button-shown: Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: self.height / 2;
                        background: fav-touch.has-hover ? Theme.surface1 : transparent;
                        MaterialIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: root.row-data.is_favorite ? "favorite" : "favorite_border";
                            icon-size: 18px;
                            icon-color: root.row-data.is_favorite ? Theme.red : Theme.subtext0;
                            filled: root.row-data.is_favorite;
                        }
                        fav-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if (root.enabled) { root.toggle-favorite(); } }
                        }
                    }
                }
            }
        }

        ctx-menu := TrackContextMenu {
            row-id: root.row-data.id;
            row-is-favorite: root.row-data.is_favorite;
            row-rating: root.row-data.rating;
            row-selected: root.row-data.selected;
            album-id: root.row-data.album_id;
            artist-id: root.row-data.artist_id;
            genre-id: root.row-data.genre_id;
            view-context: root.view-context;
            current-playlist-id: root.current-playlist-id;
            effective-selection: root.view-selected-ids;
            selection-count: root.view-selected-ids.length;

            play-single => { root.play-row(root.row-data.id, root.row-index); }
            play-next(ids) => { root.play-next(ids); }
            add-to-queue(ids) => { root.add-to-queue(ids); }
            toggle-favorite(ids, on) => { root.toggle-row-favorite(ids, on); }
            rate(ids, n) => { root.set-row-rating(ids, n); }
            request-remove(ids) => { root.request-remove-from-playlist(ids); }
            select-all => { root.select-all(); }
            clear-selection => { root.clear-selection(); }
        }
    }
    }

}
