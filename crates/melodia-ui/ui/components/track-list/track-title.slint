import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { StarRating } from "../star-rating.slint";

// A track row's title and its marks, the heart and the hover star strip, each switched by the host
// (`ui-patterns.md`).
//
// The stretch on the title and on this layout is what makes elide fire: without it the `Text`
// takes the full string's width and RTL titles overflow into the cell before.
export component TrackTitle inherits HorizontalLayout {
    in property <string> title;
    in property <brush> ink;
    in property <bool> favorite-shown;
    in property <int> rating;
    // Under the row's own `TouchArea`, so hovering a star keeps the strip up (`StarRating`).
    in property <bool> rating-shown;
    in property <float> fade: 1.0;

    callback rated(int /*new_rating*/);

    horizontal-stretch: 1;
    spacing: Theme.pad-sm;
    alignment: start;
    cross-axis-alignment: center;

    Text {
        horizontal-stretch: 1;
        // The leading U+200E makes the base direction LTR. An Arabic or Hebrew title otherwise
        // takes an RTL base and Slint's elide drops its `…`; the script itself still renders RTL.
        text: "‎" + root.title;
        color: root.ink;
        font-size: Theme.font-size-row;
        overflow: elide;
    }
    if root.favorite-shown: MaterialIcon {
        name: "favorite";
        icon-size: 18px;
        icon-color: Theme.red;
        filled: true;
        fade: root.fade;
    }
    // Beside the title, which elides to make room.
    if root.rating-shown: StarRating {
        rating: root.rating;
        star-size: 16px;
        rated(n) => { root.rated(n); }
    }
}
