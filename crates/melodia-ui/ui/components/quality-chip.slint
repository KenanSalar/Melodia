import { Theme } from "../theme.slint";
import { SettingsPage } from "../globals/settings-page.slint";
import { SignalPathUi } from "../globals/signal-path.slint";
import { GradeDot } from "grade-dot.slint";
import { Tooltip } from "tooltip.slint";

// The signal path's verdict in the player bar, opening the Output card that explains it, and
// outlined so the dot is the only colour it carries: an accent fill would read as a toggle left on
// beside repeat and shuffle. The host gates the mount on `SignalPathUi.chip-shown`, so the `if`
// there vacates the slot.
export component QualityChip inherits Rectangle {
    property <float> hover-t: touch.has-hover ? 1.0 : 0.0;
    animate hover-t { duration: Theme.dur-fast; easing: ease-in-out; }

    height: 26px;
    border-radius: self.height / 2;
    // On this element rather than a child, so the renderer tucks it under the opaque stroke
    // instead of stacking a second curve on the edge.
    background: Theme.surface0.transparentize(1.0 - root.hover-t);
    border-width: 1px;
    border-color: Theme.surface2;

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-sm;
        cross-axis-alignment: center;

        GradeDot { grade: SignalPathUi.verdict; }
        Text {
            text: SignalPathUi.verdict-label + " · " + SignalPathUi.device-rate;
            color: Theme.text;
            font-size: Theme.font-size-sm;
            // The bar can squeeze it, and a clipped line box would cut a translation's marks.
            overflow: elide;
        }
    }

    Tooltip {
        text: SignalPathUi.verdict-text;
        hovered: touch.has-hover;
        host-width: root.width;
        host-height: root.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { SettingsPage.open-category(SettingsPage.category-output); }
    }
}
