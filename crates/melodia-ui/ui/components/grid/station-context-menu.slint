import { RadioStationRow } from "../../models.slint";
import { Radio } from "../../globals/radio.slint";
import { Selection } from "../../globals/selection.slint";
import { ContextMenuPopup, CopyField, FavoriteMenuItem, MenuItem, MenuSeparator } from "../context-menu.slint";

// The right-click menu a station card raises on all three Radio tabs. Its own component rather
// than a kind of `CardContextMenu`, nothing here resolving to tracks: a station goes through
// `Radio`, and none of `CardActions` applies.
//
// Every entry is gated on what its operation needs, never on the tab: the heart needs a uuid,
// removal a kept list, Browse's stations having no row.
export component StationContextMenu inherits Rectangle {
    in property <RadioStationRow> station;
    // `Radio.tab-*`: the list the card is on, which decides what removal means there.
    in property <int> list;
    in property <bool> card-selected;
    in property <[int]> effective-selection;
    in property <int> selection-count;

    out property <bool> multi-active: Selection.acts-on-set(root.card-selected, root.selection-count);
    out property <bool> is-open: pop.is-open;

    property <int> multi-count: root.selection-count;
    property <bool> kept: root.list != Radio.tab-browse;
    property <bool> on-favorites: root.list == Radio.tab-favorites;
    property <bool> on-recent: root.list == Radio.tab-recent;
    // A hand-typed station has no directory entry to favorite against, so its card has no heart.
    property <bool> can-favorite: root.station.uuid != "";
    // **No favorite entry on Favorites**: there un-favoriting is removing, which the remove entry
    // below offers for every station, a hand-typed one included.
    property <bool> has-favorite: root.can-favorite && !root.on-favorites;
    property <bool> can-edit: !root.multi-active && root.kept && root.station.editable;
    property <bool> has-play-group: !root.multi-active;
    property <bool> has-keep-group: root.has-favorite || root.can-edit;
    // A selection may mix stations with and without a site, so it is offered whatever this one has.
    property <bool> copy-website: root.multi-active || root.station.homepage != "";
    property <[CopyField]> copy-fields: root.copy-website
        ? [
            { token: "name", label: @tr("Name"), icon: "title" },
            { token: "stream-url", label: @tr("Stream URL"), icon: "radio" },
            { token: "website", label: @tr("Website"), icon: "link" },
        ]
        : [
            { token: "name", label: @tr("Name"), icon: "title" },
            { token: "stream-url", label: @tr("Stream URL"), icon: "radio" },
        ];

    property <bool> copy-open;
    // Stored by `show-at`, not bound by the host: `TrackContextMenu`'s header says why.
    property <length> at-x;
    property <length> at-y;

    callback select-all();
    callback clear-selection();

    public function show-at(x: length, y: length) {
        root.copy-open = false;
        root.at-x = x;
        root.at-y = y;
        pop.show();
    }

    function dismiss() {
        root.copy-open = false;
        pop.close();
    }

    // `TrackContextMenu`'s reason for the pinned, zero-size root, measured here from the card.
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    pop := ContextMenuPopup {
        anchor-x: root.at-x;
        anchor-y: root.at-y;
        // Off the root's position, which sits outside the popup and so still means the window.
        anchor-window-x: root.absolute-position.x + root.at-x;
        anchor-window-y: root.absolute-position.y + root.at-y;
        copy-open: root.copy-open;
        copy-fields: root.copy-fields;
        copy-row-y: copy-row.y;
        dismiss-requested => { root.dismiss(); }
        copy-picked(token) => {
            Radio.copy-stations(root.list, token, pop.effective-ids);
            root.dismiss();
        }

        property <[int]> effective-ids: Selection.effective-ids(
            root.station.select_key, root.card-selected, root.selection-count,
            root.effective-selection);

        // What the card's own hover controls do, single-target as they are.
        if root.has-play-group: MenuItem {
            label: @tr("Play");
            icon: "play_arrow";
            clicked => {
                Radio.play-station(root.station);
                root.dismiss();
            }
        }
        if root.has-play-group && root.station.homepage != "": MenuItem {
            label: @tr("Open Website");
            icon: "link";
            clicked => {
                Radio.open-homepage(root.station.homepage);
                root.dismiss();
            }
        }

        if root.has-play-group && root.has-keep-group: MenuSeparator {}
        if root.has-favorite: FavoriteMenuItem {
            is-favorite: root.station.is_favorite;
            multi-active: root.multi-active;
            multi-count: root.multi-count;
            clicked => {
                if (root.multi-active) {
                    Radio.set-favorites(
                        root.list, pop.effective-ids, !root.station.is_favorite);
                } else {
                    Radio.toggle-favorite(root.station);
                }
                root.dismiss();
            }
        }
        if root.can-edit: MenuItem {
            label: @tr("Edit…");
            icon: "edit";
            clicked => {
                Radio.edit-station(root.station);
                root.dismiss();
            }
        }

        // Not behind an `if`, the flyout lining up against its `y`.
        if root.has-play-group || root.has-keep-group: MenuSeparator {}
        copy-row := MenuItem {
            label: @tr("Copy");
            icon: "content_copy";
            submenu: true;
            submenu-open: root.copy-open;
            submenu-left: pop.flyout-left;
            clicked => { root.copy-open = !root.copy-open; }
        }

        // The selection group, the card menu's: Clear is gated on the scope holding a set,
        // a card having no second activation to reach one it can no longer see.
        MenuSeparator {}
        MenuItem {
            label: @tr("Select all");
            icon: "select_all";
            clicked => {
                root.select-all();
                root.dismiss();
            }
        }
        if root.selection-count > 0: MenuItem {
            label: @tr("Clear selection");
            icon: "close";
            clicked => {
                root.clear-selection();
                root.dismiss();
            }
        }

        // The trash's removal, over one card or the whole selection. Two labels rather than one
        // taking the tab's name, `@tr` resolving literals at codegen.
        if root.kept: MenuSeparator {}
        if root.kept: MenuItem {
            label: root.on-recent
                ? (root.multi-active
                    // Translators: `{}` is how many stations are selected
                    ? @tr("Remove {} from Recently Played", root.multi-count)
                    : @tr("Remove from Recently Played"))
                : (root.multi-active
                    ? @tr("Remove {} from Favorites", root.multi-count)
                    : @tr("Remove from Favorites"));
            icon: "delete";
            destructive: true;
            clicked => {
                Radio.remove-stations(
                    root.list, root.multi-active ? pop.effective-ids : [root.station.id]);
                root.dismiss();
            }
        }
    }
}
