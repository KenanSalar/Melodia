import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";

// One tile, over `ArtworkImage` so a missing cover takes the app's placeholder. The guarded index
// lets no layout below need a second call site for it.
component MosaicSlot inherits Rectangle {
    in property <int>      idx;
    in property <[string]> artwork-paths;
    in property <length>   tile-radius;
    in property <string>   fallback-icon;
    in property <brush>    tile-bg;
    in property <brush>    tile-icon-color;
    pure callback request-cover(string) -> image;

    // No clip of its own: the tile clips itself, and a second would be another texture and pass.
    if root.artwork-paths.length > root.idx: ArtworkImage {
        width: parent.width;
        height: parent.height;
        tile-radius: root.tile-radius;
        artwork-path: root.artwork-paths[root.idx];
        cover: root.request-cover(root.artwork-paths[root.idx]);
        fallback-icon: root.fallback-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
    }
    if root.artwork-paths.length <= root.idx: ArtworkImage {
        width: parent.width;
        height: parent.height;
        tile-radius: root.tile-radius;
        fallback-icon: root.fallback-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
    }
}

// The Edit Artwork picker's live preview of what `media::image::artwork::compose_artwork` will
// bake, sharing its 1/2/3/4 layouts. That function rather than the lenient `compose_cover` is what
// makes the preview a promise. No paths draws nothing, leaving the caller's empty state.
export component CoverMosaic inherits Rectangle {
    in property <[string]> artwork-paths;
    in property <length>   gutter-size: 3px;
    // `0px` with no gutter for a flush mosaic, where the chrome around supplies the only curve.
    in property <length>   tile-radius: Theme.radius-sm;
    // An `ArtworkImage` placeholder key.
    in property <string>   placeholder-icon: "music-note";
    in property <brush>    tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush>    tile-icon-color: Theme.accent;
    pure callback request-cover(string) -> image;

    private property <int> effective-count: root.artwork-paths.length;

    if root.effective-count == 1: MosaicSlot {
        idx: 0;
        artwork-paths: root.artwork-paths;
        tile-radius: root.tile-radius;
        fallback-icon: root.placeholder-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
        request-cover(p) => { return root.request-cover(p); }
    }

    if root.effective-count == 2: HorizontalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        MosaicSlot {
            idx: 0;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
        MosaicSlot {
            idx: 1;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
    }

    if root.effective-count == 3: HorizontalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        MosaicSlot {
            idx: 0;
            horizontal-stretch: 1;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 1;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 2;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
    }

    if root.effective-count >= 4: VerticalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        HorizontalLayout {
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 0;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 1;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
        HorizontalLayout {
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 2;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 3;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
    }
}
