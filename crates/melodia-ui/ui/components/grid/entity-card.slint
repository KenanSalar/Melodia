import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { Checkbox } from "../checkbox.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PlayCountBadge } from "play-count-badge.slint";
import { ContextClick } from "../context-menu.slint";

// The card every grid and strip draws. Its slot is a fixed size the host derives from the
// available width, so the grid stays stable.
export component EntityCard inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <string> subtitle2;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    in property <bool> circular: false;
    in property <string> fallback-icon: "music-note";
    // Drawn in place of the glyph when set; `ArtworkImage` prefers it.
    in property <string> fallback-text;
    // The source's 1:1 size, for one too small to fill the tile. `0px` assumes it fills.
    in property <length> native-size: 0px;

    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;

    in property <float> cover-scale-hover: 1.04;

    // Opens the `@children` overlay slot and gates nothing else: the card draws no controls of
    // its own (`ui-patterns.md`).
    in property <bool> show-overlay-actions: false;

    // Hover on any control the host owns, in the slot or beside the card. A component can't read
    // `has-hover` off its `@children`, so only the host can answer.
    in property <bool> overlay-hovered: false;
    // An open popup takes the card's hover, so the host says when its menu is up.
    in property <bool> menu-open: false;

    // False for Browse's disk-only files: dimmed and inert, as a disabled `TrackListRowItem` is.
    in property <bool> enabled: true;

    in property <string> badge-icon: "";

    in property <int> play-count: 0;

    in property <bool> selectable: false;
    in property <bool> selected: false;
    // The host's scope already holds a pick, which makes a body click a pick too.
    in property <bool> selection-live: false;

    callback clicked();
    callback select-clicked(bool /*shift*/, bool /*ctrl*/);
    // In the card's own frame.
    callback context-requested(length /*x*/, length /*y*/);
    // A left press on the body, which arms a drag. The box and hover controls never reach it.
    callback pressed();

    // Every hover binding here reads this, not `touch.has-hover`, which goes false under any
    // nested button. `out` so a control beside the card (a station's star) can ride it too.
    out property <bool> card-hovered:
        touch.has-hover || box-touch.has-hover || root.overlay-hovered || root.menu-open;

    // The box takes the badge's corner while up, as a track row swaps its number for a checkbox.
    private property <bool> box-shown: root.selectable && (root.card-hovered || root.selected);

    // One click can't both pick and open, so a live selection costs the detail until cleared.
    // The first pick is still the box's, which keeps an idle grid navigable.
    private property <bool> picking: root.selectable && root.selection-live;
    private property <bool> press-shift;
    // Ctrl is forced on unless shift is held: a pick toggles one card, and a plain click sent
    // down the replace-selection arm could never untick a box.
    function pick(shift: bool) { root.select-clicked(shift, !shift); }

    // One eased float for the corner's cross-fade, on the overlay's curve. Each corner spends it
    // its own way, argued there.
    private property <float> box-t: root.box-shown ? 1.0 : 0.0;
    animate box-t { duration: Theme.dur-fast; easing: ease-in-out; }

    // Published so a host framing against the square never re-derives it (`slint-pitfalls.md`'s
    // `@children` entry).
    out property <length> tile-size: root.card-width - 2 * Theme.pad-sm;
    // In the overlay slot's frame, for a control stacked under the box.
    out property <length> select-box-bottom: box.y + box.height - overlay.y;

    // Through the brushes, not `opacity`, which would hold a texture per dimmed card. The badges
    // skip it: Browse, the one host disabling cards, sets neither.
    private property <float> fade: root.enabled ? 1.0 : Theme.fade-disk-only;

    width: card-width;
    height: card-height;

    inner := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-md;
        // Hover fill and selection ring on one element, so the renderer tucks the fill under the
        // stroke (`slint-pitfalls.md`).
        background: root.card-hovered ? Theme.surface0 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
        border-width: root.selected ? 2px : 0px;
        border-color: Theme.accent;

        // No `animate`, so the tint lands on the ring's frame (`slint-pitfalls.md`).
        if root.selected: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-md;
            background: Theme.accent.with-alpha(0.14);
        }

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-sm;

            ArtworkImage {
                artwork-path: root.artwork-path;
                cover: root.cover;
                tile-size: root.tile-size;
                tile-radius: root.circular ? root.tile-size / 2 : Theme.radius-md;
                cover-scale: root.card-hovered ? root.cover-scale-hover : 1.0;
                fallback-icon: root.fallback-icon;
                fallback-text: root.fallback-text;
                native-size: root.native-size;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                fade: root.fade;
            }

            VerticalLayout {
                spacing: 2px;
                // The LRM keeps mixed-script titles from drifting, as in the rows.
                Text {
                    text: "‎" + root.title;
                    color: Theme.text.transparentize(1.0 - root.fade);
                    font-size: Theme.font-size-md;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "‎" + root.subtitle;
                    color: Theme.subtext0.transparentize(1.0 - root.fade);
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    visible: root.subtitle != "";
                }
                Text {
                    text: "‎" + root.subtitle2;
                    color: Theme.overlay1.transparentize(1.0 - root.fade);
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    visible: root.subtitle2 != "";
                }
            }

            // Top-pins the block whatever height the host computes.
            Rectangle { vertical-stretch: 1; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // Both arms on `clicked` (`slint-pitfalls.md`), reading `picking` once, so unpicking the
        // last card can't open its detail on the way out.
        clicked => {
            if (root.picking) {
                root.pick(root.press-shift);
            } else {
                root.clicked();
            }
        }
        pointer-event(ev) => {
            // `clicked` carries no modifiers, so a range-pick's shift comes off the press.
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.press-shift = ev.modifiers.shift;
                root.pressed();
            }
            if (ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                root.context-requested(self.mouse-x, self.mouse-y);
            }
        }
    }

    // The host's hover controls over the artwork square, sharing one `opacity`: one per button
    // would layer each, an `IconButton` root not being childless (`need_layer`). A control that
    // stays up while the card is idle goes beside it instead. After `touch`, so a nested button
    // takes its own click.
    overlay := Rectangle {
        visible: root.show-overlay-actions;
        x: Theme.pad-sm;
        y: Theme.pad-sm;
        width: root.tile-size;
        height: root.tile-size;

        opacity: root.card-hovered ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }

        @children
    }

    badge := Rectangle {
        // On the eased float, so the badge and the box dissolve into each other.
        visible: root.badge-icon != "" && root.box-t < 1.0;
        x: 2 * Theme.pad-sm;
        y: 2 * Theme.pad-sm;
        width: 28px;
        height: 28px;
        border-radius: self.height / 2;
        background: Theme.floating-chrome-bg.transparentize(root.box-t);
        MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.badge-icon;
            icon-size: 18px;
            icon-color: Theme.accent;
            filled: true;
            fade: 1.0 - root.box-t;
        }
    }

    // Bottom right on every host: a count sharing the top left with the badge and the box would
    // vanish under the pointer, just when cards are being compared. `visible` is the badge's own
    // zero-count rule.
    PlayCountBadge {
        x: root.tile-size - self.width;
        y: root.tile-size - self.height;
        count: root.play-count;
    }

    // The card's own rather than the slot's, whose idle fade a ticked box has to outlive. After
    // `touch`, so it takes its own click.
    //
    // This half takes input and paints nothing, gated on `selectable` rather than the fade:
    // `visible` lowers to a `Clip` made after default geometry, so a box gated on its fade sat at
    // zero size and missed the first hover after it appeared.
    box := Rectangle {
        visible: root.selectable;
        x: 2 * Theme.pad-sm;
        y: 2 * Theme.pad-sm;
        width: 28px;
        height: 28px;

        // On the eased float, so an idle card builds no path and the fade-out still plays.
        if root.box-t > 0: Rectangle {
            width: 100%;
            height: 100%;
            border-radius: self.height / 2;
            // `IconButton`'s two brushes and curve, so the corner answers like its neighbours.
            background: box-touch.has-hover ? Theme.surface0 : Theme.floating-chrome-bg;
            animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

            // `opacity` rather than brush alpha: `Checkbox` eases its own fill and rim off `fade`,
            // and an eased `fade` stalls them. The layer lasts only the transition, `need_layer`
            // bailing at 1.0.
            opacity: root.box-t;

            Checkbox {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                checked: root.selected;
                // Loudest rim, to hold against artwork.
                unchecked-border: Theme.subtext0;
            }
        }

        box-touch := TouchArea {
            // Above `touch`, so the gate is restated or a dimmed card keeps one live corner.
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                    root.pick(ev.modifiers.shift);
                }
                // `touch` never sees a release here, so the box raises the menu itself.
                if (ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    root.context-requested(box.x + self.mouse-x, box.y + self.mouse-y);
                }
            }
        }
    }
}
