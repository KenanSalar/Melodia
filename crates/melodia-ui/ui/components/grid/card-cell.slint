import { RadioStationRow } from "../../models.slint";
import { CardSelection } from "../../globals/card-selection.slint";
import { Selection } from "../../globals/selection.slint";
import { DragItems } from "../../globals/drag.slint";
import { CardContextMenu } from "card-context-menu.slint";
import { StationContextMenu } from "station-context-menu.slint";

// The wrapper per card that owns what a card owes its selection, so a mount states its scope and
// nothing else. The menu has to be the card's sibling in its frame, and the card
// arrives through `@children`, Slint having no generics over each grid's row struct.
//
// Both menus are mounted and one opens by kind; a `PopupWindow`'s body is built by its `show()`.
export component CardCell inherits Rectangle {
    in property <length> card-width;
    in property <length> card-height;
    // No default: an empty scope picks nothing, which reads as a dead grid rather than a missing
    // property.
    in property <string> scope;
    // `EntityKind::from_token`'s token; "station" raises the station menu.
    in property <string> card-kind;
    in property <int> card-id;
    // 0 hides the entry.
    in property <int> card-artist-id: 0;
    in property <bool> card-is-smart: false;
    // A grid drawing the heart knows the state the menu's entry reads.
    in property <bool> favorite-known: false;
    in property <bool> card-is-favorite: false;
    // The station the menu acts on, and the `Radio.tab-*` list it is on.
    in property <RadioStationRow> station;
    in property <int> station-list;

    out property <bool> selected:
        CardSelection.selected(root.scope, root.card-id, CardSelection.generation);
    out property <bool> selection-live: CardSelection.any-in(root.scope);
    out property <bool> menu-open: ctx-menu.is-open || station-menu.is-open;

    // Nothing when another scope holds the live set.
    private property <[int]> scope-selection:
        CardSelection.scope == root.scope ? CardSelection.selected-ids : [];
    private property <int> scope-count: CardSelection.count-in(root.scope);

    // The grid's, already wired for its hover controls or its click; inert on a kind that never
    // raises them.
    callback rename();
    callback edit-artwork();
    callback edit-rules();
    callback delete-cards([int] /*card_ids*/);
    callback play-single();

    public function pick(shift: bool, ctrl: bool) {
        CardSelection.pick(root.scope, root.card-id, shift, ctrl);
    }

    public function open-menu(x: length, y: length) {
        if (root.card-kind == "station") {
            station-menu.show-at(x, y);
        } else {
            ctx-menu.show-at(x, y);
        }
    }

    // The set the menu acts on, under the title and cover only the mount knows.
    public pure function drag-items(title: string, cover: image) -> DragItems {
        return {
            kind: root.card-kind,
            ids: Selection.effective-ids(root.card-id, root.selected, root.scope-count,
                root.scope-selection),
            title: title,
            cover: cover,
        };
    }

    width: root.card-width;
    height: root.card-height;

    // Ahead of the menus, which paint over the card.
    @children

    ctx-menu := CardContextMenu {
        card-kind: root.card-kind;
        card-id: root.card-id;
        card-artist-id: root.card-artist-id;
        card-is-smart: root.card-is-smart;
        favorite-known: root.favorite-known;
        card-is-favorite: root.card-is-favorite;
        select-all => { CardSelection.select-all(root.scope); }
        clear-selection => { CardSelection.clear(); }
        card-selected: root.selected;
        effective-selection: root.scope-selection;
        selection-count: root.scope-count;

        rename => { root.rename(); }
        edit-artwork => { root.edit-artwork(); }
        edit-rules => { root.edit-rules(); }
        delete-cards(ids) => { root.delete-cards(ids); }
        play-single => { root.play-single(); }
    }

    station-menu := StationContextMenu {
        station: root.station;
        list: root.station-list;
        select-all => { CardSelection.select-all(root.scope); }
        clear-selection => { CardSelection.clear(); }
        card-selected: root.selected;
        effective-selection: root.scope-selection;
        selection-count: root.scope-count;
    }
}
