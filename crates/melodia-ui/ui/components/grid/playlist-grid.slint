import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { PlaylistGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";
import { CardCell } from "card-cell.slint";
import { DragSource } from "../drag-source.slint";
import { IconButton } from "../icon-button.slint";

// The virtualized playlist grid, `AlbumGrid`'s shape.
export component PlaylistGrid inherits Rectangle {
    in property <[PlaylistGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-playlist(int /*playlist_id*/);
    callback request-blur-search();
    // Raised by the card's hover trio and its menu alike, both landing on one handler.
    callback delete-playlist(int /*playlist_id*/);
    callback edit-playlist-artwork(int /*playlist_id*/);
    callback rename-playlist(int /*playlist_id*/);
    // Menu-only, having no room on the card.
    callback delete-playlists([int] /*playlist_ids*/);
    callback edit-playlist-rules(int /*playlist_id*/);
    // The repaint token: bumped as decodes land, so the `pure` cover lookup re-runs.
    in property <int> covers-generation: 0;
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.content-height;
    out property <length> v-offset: -list.content-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.content-y = -o; }

    src := DragSource {
        width: 100%;
        height: 100%;
        allow-copy: true;
        background-clicked => { root.request-blur-search(); }

        list := ListView {
            width: 100%;
            height: 100%;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            // A pin, not an override (`slint-pitfalls.md`'s drag-pan entry).
            mouse-drag-pan-enabled: false;

            for grid-row in root.rows: Rectangle {
                min-height: root.row-height;
                max-height: root.row-height;

                HorizontalLayout {
                    padding-left: root.gap;
                    padding-right: root.gap;
                    spacing: root.gap;
                    alignment: start;

                    for playlist in grid-row.playlists: cell := CardCell {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        scope: "playlists";
                        card-kind: "playlist";
                        card-id: playlist.id;
                        card-is-smart: playlist.is_smart;

                        rename => { root.rename-playlist(playlist.id); }
                        edit-artwork => { root.edit-playlist-artwork(playlist.id); }
                        edit-rules => { root.edit-playlist-rules(playlist.id); }
                        delete-cards(ids) => {
                            if (ids.length > 1) {
                                root.delete-playlists(ids);
                            } else {
                                root.delete-playlist(playlist.id);
                            }
                        }

                        card := EntityCard {
                            card-width: root.card-width;
                            card-height: root.card-height;
                            artwork-path: playlist.artwork_path;
                            cover: root.request-cover(playlist.artwork_path,
                                root.covers-generation);
                            fallback-icon: "playlist";
                            // Real artwork stays gentle so a cover doesn't jitter in the clip.
                            cover-scale-hover: playlist.artwork_path == "" ? 1.15 : 1.04;
                            title: playlist.name;
                            // An empty playlist drops the duration rather than trailing a zero.
                            subtitle: playlist.track_count > 0
                                ? @tr("{n} track" | "{n} tracks" % playlist.track_count)
                                    + " · " + Theme.format-duration(playlist.total_duration_ms)
                                : @tr("0 tracks");
                            badge-icon: playlist.is_smart ? "auto_awesome" : "";
                            clicked => { root.open-playlist(playlist.id); }

                            selectable: true;
                            selected: cell.selected;
                            selection-live: cell.selection-live;
                            select-clicked(shift, ctrl) => { cell.pick(shift, ctrl); }
                            // By id: `entity_card_overlay.rs` bans `parent` inside this mount.
                            context-requested(x, y) => { cell.open-menu(x, y); }
                            menu-open: cell.menu-open;
                            pressed => {
                                src.arm-items(-1, cell.drag-items(playlist.name, self.cover));
                            }

                            // The hover trio, in the card's slot and framed off `tile-size`, never
                            // `parent` (`slint-pitfalls.md`'s `@children` entry).
                            show-overlay-actions: true;
                            overlay-hovered: delete_btn.has-hover
                                || artwork_btn.has-hover
                                || name_btn.has-hover;

                            delete_btn := IconButton {
                                x: Theme.pad-sm;
                                y: card.tile-size - self.height - Theme.pad-sm;
                                icon: "delete";
                                icon-size: 18px;
                                diameter: 30px;
                                idle-bg: Theme.floating-chrome-bg;
                                hover-fg: Theme.danger;
                                clicked => { root.delete-playlist(playlist.id); }
                            }

                            artwork_btn := IconButton {
                                x: card.tile-size - self.width - Theme.pad-sm;
                                y: Theme.pad-sm;
                                icon: "image";
                                icon-size: 18px;
                                diameter: 30px;
                                idle-bg: Theme.floating-chrome-bg;
                                clicked => { root.edit-playlist-artwork(playlist.id); }
                            }

                            name_btn := IconButton {
                                x: card.tile-size - self.width - Theme.pad-sm;
                                y: card.tile-size - self.height - Theme.pad-sm;
                                icon: "edit";
                                icon-size: 18px;
                                diameter: 30px;
                                idle-bg: Theme.floating-chrome-bg;
                                clicked => { root.rename-playlist(playlist.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
