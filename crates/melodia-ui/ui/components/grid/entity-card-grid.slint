import { ListView } from "std-widgets.slint";
import { EntityGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";
import { CardCell } from "card-cell.slint";
import { CardFavoriteButton } from "card-favorite-button.slint";
import { DragSource } from "../drag-source.slint";

// The virtualized counterpart to `HorizontalCardStrip` over the same row struct, a strip's plain
// `for` building every card of an uncapped page.
export component EntityCardGrid inherits Rectangle {
    in property <[EntityGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is in the slot height, a `ListView` having no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;
    in property <bool> circular: false;
    // An `ArtworkImage` placeholder key, not a Material ligature.
    in property <string> fallback-icon: "music-note";
    in property <bool> show-play-count: false;
    // The heart, and whether a favorite card keeps it up while idle: off on Favorites, where every
    // card is one. The menu's favorite entry reads the same flag.
    in property <bool> show-favorite: false;
    in property <bool> favorite-marks-kept: true;

    // No defaults: the mounts draw artists and tracks, and a plausible `"track"` would send a new
    // mount's album ids down the track arm. Empty reaches `EntityKind::from_token`'s warn.
    in property <string> card-kind;
    in property <string> selection-scope;

    // The repaint token: bumped as decodes land, so the `pure` cover lookup re-runs.
    in property <int> covers-generation: 0;

    callback row-clicked(int /*entity_id*/);
    // The page's, which alone knows whether a click takes the card off it and so is a removal.
    callback favorite-clicked(int /*entity_id*/, bool /*favorite*/);
    callback request-blur-search();
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    // `TrackList`'s sign convention: a positive `v-offset` is N px scrolled.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.content-height;
    out property <length> v-offset: -list.content-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.content-y = -o; }

    src := DragSource {
        width: 100%;
        height: 100%;
        allow-copy: true;
        background-clicked => { root.request-blur-search(); }

        list := ListView {
            width: 100%;
            height: 100%;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            // The style's default too, pinned: a drag-pan takes any press that drifts.
            mouse-drag-pan-enabled: false;

            for grid-row in root.rows: Rectangle {
                min-height: root.row-height;
                max-height: root.row-height;

                HorizontalLayout {
                    padding-left: root.gap;
                    padding-right: root.gap;
                    spacing: root.gap;
                    alignment: start;

                    for entity in grid-row.entities: cell := CardCell {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        scope: root.selection-scope;
                        card-kind: root.card-kind;
                        card-id: entity.id;
                        favorite-known: root.show-favorite;
                        card-is-favorite: entity.is_favorite;
                        // Play on one track card means what clicking it means.
                        play-single => { root.row-clicked(entity.id); }

                        card := EntityCard {
                            card-width: root.card-width;
                            card-height: root.card-height;
                            artwork-path: entity.artwork_path;
                            cover: root.request-cover(entity.artwork_path, root.covers-generation);
                            circular: root.circular;
                            fallback-icon: root.fallback-icon;
                            // Real artwork stays gentle so a cover doesn't jitter in the clip.
                            cover-scale-hover: entity.artwork_path == "" ? 1.15 : 1.04;
                            title: entity.title;
                            subtitle: entity.subtitle;
                            play-count: root.show-play-count ? entity.play_count : 0;
                            clicked => { root.row-clicked(entity.id); }

                            selectable: true;
                            selected: cell.selected;
                            selection-live: cell.selection-live;
                            select-clicked(shift, ctrl) => { cell.pick(shift, ctrl); }
                            context-requested(x, y) => { cell.open-menu(x, y); }
                            menu-open: cell.menu-open;
                            overlay-hovered: fav.has-hover;
                            pressed => {
                                src.arm-items(-1, cell.drag-items(entity.title, self.cover));
                            }
                        }

                        // Hidden rather than `if`-mounted, the card reading its hover above. The
                        // page's `library_changed` refetch repaints it.
                        fav := CardFavoriteButton {
                            visible: root.show-favorite;
                            card-width: root.card-width;
                            is-favorite: entity.is_favorite;
                            marks-kept: root.favorite-marks-kept;
                            card-hovered: card.card-hovered;
                            clicked => { root.favorite-clicked(entity.id, !entity.is_favorite); }
                        }
                    }
                }
            }
        }
    }
}
