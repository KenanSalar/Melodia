import { CardActions } from "../../globals/card-actions.slint";
import { CopyActions } from "../../globals/copy-actions.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Nav } from "../../globals/nav.slint";
import { Selection } from "../../globals/selection.slint";
import { ContextMenuPopup, CopyField, FavoriteMenuItem, MenuItem, MenuSeparator } from "../context-menu.slint";
import { TrackCopyFields } from "../track-copy-items.slint";

// The right-click menu every entity card raises, and the only place its entries are mounted.
// `TrackContextMenu`'s contract one layer over, a card being a set of tracks: the actions go
// through `CardActions` with a kind and ids, and Rust resolves the set once.
export component CardContextMenu inherits Rectangle {
    // "album" | "artist" | "genre" | "playlist" | "track" | "folder", the last not an
    // `EntityKind`: a folder is a path, routed through Browse's own callbacks.
    in property <string> card-kind;
    in property <int> card-id;
    in property <string> card-path;
    // Gates Edit Rules alone (`ui-patterns.md`: gate on the operation, not the kind).
    in property <bool> card-is-smart: false;
    // 0 hides the entry.
    in property <int> card-artist-id: 0;
    // Known for a track card on a grid drawing its heart; a set of tracks has no single answer.
    in property <bool> favorite-known: false;
    in property <bool> card-is-favorite: false;

    in property <bool> card-selected;
    in property <[int]> effective-selection;
    in property <int> selection-count;

    out property <bool> multi-active: Selection.acts-on-set(root.card-selected, root.selection-count);
    out property <bool> is-open: pop.is-open;

    property <int> multi-count: root.selection-count;
    property <bool> is-playlist: root.card-kind == "playlist";
    property <bool> is-folder: root.card-kind == "folder";
    property <bool> is-track: root.card-kind == "track";
    // A folder never joins a selection.
    property <bool> folder-single: root.is-folder && !root.multi-active;
    property <bool> playlist-edits: root.is-playlist && !root.multi-active;

    // Only a kind with more than one field opens a flyout, so the rest reserve no room for one.
    property <bool> has-flyout: root.is-track || root.card-kind == "album";
    property <[CopyField]> album-copy-fields: [
        { token: "name", label: @tr("Album"), icon: "album" },
        { token: "artist", label: @tr("Artist"), icon: "person" },
        { token: "artist-name", label: @tr("Artist - Album"), icon: "music_note" },
    ];
    property <bool> copy-open;
    // Stored by `show-at`, not bound (`TrackContextMenu`).
    property <length> at-x;
    property <length> at-y;

    public function show-at(x: length, y: length) {
        root.copy-open = false;
        root.at-x = x;
        root.at-y = y;
        pop.show();
    }

    function dismiss() {
        root.copy-open = false;
        pop.close();
    }

    // The grid's, already wired for its hover controls or navigation.
    callback rename();
    callback edit-artwork();
    callback edit-rules();
    callback delete-cards([int] /*playlist_ids*/);
    callback select-all();
    callback clear-selection();
    // A track card's grid plays on activation, so Play over one means what clicking it means.
    callback play-single();
    callback open-folder(string /*path*/);
    callback play-folder(string /*path*/);
    callback play-folder-next(string /*path*/);
    callback queue-folder(string /*path*/);
    callback reveal-folder(string /*path*/);

    // `TrackContextMenu`'s pinned, zero-size root, measured from the card.
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    pop := ContextMenuPopup {
        anchor-x: root.at-x;
        anchor-y: root.at-y;
        // Off the root, which sits outside the popup and so still means the window.
        anchor-window-x: root.absolute-position.x + root.at-x;
        anchor-window-y: root.absolute-position.y + root.at-y;
        has-copy-flyout: root.has-flyout;
        copy-open: root.copy-open;
        copy-fields: root.is-track ? TrackCopyFields.list : root.album-copy-fields;
        copy-row-y: copy-row.y;
        dismiss-requested => { root.dismiss(); }
        copy-picked(token) => {
            if (root.is-track) {
                CopyActions.copy-tracks(token, pop.effective-ids);
            } else {
                CopyActions.copy-entities("album", token, pop.effective-ids);
            }
            root.dismiss();
        }

        property <[int]> effective-ids: Selection.effective-ids(
            root.card-id, root.card-selected, root.selection-count, root.effective-selection);

        // Kept over a selection, unlike the row menu's: a card click opens the detail, so nothing
        // else on a grid plays.
        MenuItem {
            label: @tr("Play");
            icon: "play_arrow";
            clicked => {
                if (root.is-folder) {
                    root.play-folder(root.card-path);
                } else if (root.is-track && !root.multi-active) {
                    root.play-single();
                } else {
                    CardActions.play(root.card-kind, pop.effective-ids);
                }
                root.dismiss();
            }
        }
        if !root.is-folder: MenuItem {
            label: @tr("Shuffle");
            icon: "shuffle";
            clicked => {
                CardActions.shuffle(root.card-kind, pop.effective-ids);
                root.dismiss();
            }
        }
        MenuItem {
            label: root.multi-active
                ? @tr("Play {} Next", root.multi-count)
                : @tr("Play Next");
            icon: "queue_play_next";
            clicked => {
                if (root.is-folder) {
                    root.play-folder-next(root.card-path);
                } else {
                    CardActions.play-next(root.card-kind, pop.effective-ids);
                }
                root.dismiss();
            }
        }
        MenuItem {
            label: root.multi-active
                ? @tr("Add {} to Queue", root.multi-count)
                : @tr("Add to Queue");
            icon: "queue_music";
            clicked => {
                if (root.is-folder) {
                    root.queue-folder(root.card-path);
                } else {
                    CardActions.add-to-queue(root.card-kind, pop.effective-ids);
                }
                root.dismiss();
            }
        }

        // A folder has no track list for these to take.
        if !root.is-folder: MenuSeparator {}
        if !root.is-folder: MenuItem {
            label: @tr("New Playlist…");
            icon: "add";
            clicked => {
                // Not inline like the row menu's: only Rust knows the track ids.
                CardActions.create-playlist-from(root.card-kind, pop.effective-ids);
                root.dismiss();
            }
        }
        if !root.is-folder: MenuItem {
            label: @tr("Add to Playlist");
            icon: "playlist_add";
            clicked => {
                // A plain heading: the count here is cards, the track total Rust's to resolve.
                Dialog.prepare-add-to-playlist(@tr("Add to Playlist"));
                CardActions.add-to-playlist(root.card-kind, pop.effective-ids);
                root.dismiss();
            }
        }

        if !root.is-folder: MenuSeparator {}
        // A toggle where the card's state is known, both directions where it isn't
        // (`ui-patterns.md`).
        if root.favorite-known: FavoriteMenuItem {
            is-favorite: root.card-is-favorite;
            multi-active: root.multi-active;
            multi-count: root.multi-count;
            clicked => {
                CardActions.set-favorites(
                    root.card-kind, pop.effective-ids, !root.card-is-favorite);
                root.dismiss();
            }
        }
        if !root.is-folder && !root.favorite-known: MenuItem {
            label: @tr("Add to Favorites");
            icon: "favorite";
            clicked => {
                CardActions.set-favorites(root.card-kind, pop.effective-ids, true);
                root.dismiss();
            }
        }
        if !root.is-folder && !root.favorite-known: MenuItem {
            label: @tr("Remove from Favorites");
            icon: "heart_minus";
            clicked => {
                CardActions.set-favorites(root.card-kind, pop.effective-ids, false);
                root.dismiss();
            }
        }
        if !root.is-folder: MenuItem {
            label: root.multi-active
                ? @tr("Edit Tags for {}", root.multi-count)
                : @tr("Edit Tags…");
            icon: "edit";
            clicked => {
                CardActions.edit-tags(
                    root.card-kind,
                    pop.effective-ids,
                    root.multi-active
                        ? @tr("Edit {} Tracks", root.multi-count)
                        : @tr("Edit Track Information"));
                root.dismiss();
            }
        }

        // Every kind has Copy, so the separator needs no gate. Not behind an `if`, the flyout
        // lining up against its `y`.
        MenuSeparator {}
        copy-row := MenuItem {
            label: root.has-flyout
                ? @tr("Copy")
                : (root.is-folder ? @tr("Copy Path") : @tr("Copy Name"));
            icon: "content_copy";
            submenu: root.has-flyout;
            submenu-open: root.copy-open;
            submenu-left: pop.flyout-left;
            clicked => {
                if (root.has-flyout) {
                    root.copy-open = !root.copy-open;
                } else {
                    if (root.is-folder) {
                        CopyActions.copy-text(root.card-path);
                    } else {
                        CopyActions.copy-entities(root.card-kind, "name", pop.effective-ids);
                    }
                    root.dismiss();
                }
            }
        }
        if root.folder-single: MenuItem {
            label: @tr("Open Folder");
            icon: "folder_open";
            clicked => {
                root.open-folder(root.card-path);
                root.dismiss();
            }
        }
        if root.folder-single: MenuItem {
            label: @tr("Show in File Manager");
            icon: "drive_file_move";
            clicked => {
                root.reveal-folder(root.card-path);
                root.dismiss();
            }
        }
        if root.is-track && !root.multi-active: MenuItem {
            label: @tr("Open Containing Folder");
            icon: "folder_open";
            clicked => {
                Nav.reveal-in-folder(root.card-id);
                root.dismiss();
            }
        }
        if !root.multi-active && root.card-artist-id != 0: MenuItem {
            label: @tr("Go to Artist");
            icon: "person";
            clicked => {
                Nav.go-to-artist(root.card-artist-id);
                root.dismiss();
            }
        }

        // Clear is gated on the scope holding a set, not on this card being in it: a card has no
        // second activation, so a set out of view leaves every visible card picking with none
        // able to offer the way back.
        MenuSeparator {}
        MenuItem {
            label: @tr("Select all");
            icon: "select_all";
            clicked => {
                root.select-all();
                root.dismiss();
            }
        }
        if root.selection-count > 0: MenuItem {
            label: @tr("Clear selection");
            icon: "close";
            clicked => {
                root.clear-selection();
                root.dismiss();
            }
        }

        // The right-click path to the card's hover trio, smart playlists included.
        if root.is-playlist: MenuSeparator {}
        if root.playlist-edits: MenuItem {
            label: @tr("Rename…");
            icon: "edit";
            clicked => {
                root.rename();
                root.dismiss();
            }
        }
        if root.playlist-edits: MenuItem {
            label: @tr("Edit Artwork…");
            icon: "image";
            clicked => {
                root.edit-artwork();
                root.dismiss();
            }
        }
        if root.is-playlist && !root.multi-active && root.card-is-smart: MenuItem {
            label: @tr("Edit Rules…");
            icon: "auto_awesome";
            clicked => {
                root.edit-rules();
                root.dismiss();
            }
        }
        if root.is-playlist: MenuItem {
            label: root.multi-active
                ? @tr("Delete {} Playlists", root.multi-count)
                : @tr("Delete Playlist");
            icon: "delete";
            destructive: true;
            clicked => {
                root.delete-cards(pop.effective-ids);
                root.dismiss();
            }
        }
    }
}
