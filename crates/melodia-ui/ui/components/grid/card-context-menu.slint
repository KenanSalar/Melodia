import { Theme } from "../../theme.slint";
import { CardActions } from "../../globals/card-actions.slint";
import { CopyActions } from "../../globals/copy-actions.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Nav } from "../../globals/nav.slint";
import { ContextMenuMetrics, MenuFlyout, MenuItem, MenuSeparator } from "../context-menu.slint";
import { PopupSurface } from "../popup-surface.slint";
import { PopupDismissCatcher } from "../popup-dismiss-catcher.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// The right-click menu every entity card raises, and the only place its entries are spelled.
//
// `TrackContextMenu`'s contract, one layer over: **the host keeps the pointer position; this keeps
// the menu.** What differs is that a card
// is a *set* of tracks, so the actions go through `CardActions` with a kind and an id list and
// Rust resolves the set once, rather than each entry naming a track callback.
//
// `card-kind` is what a host configures, and it both picks the per-kind entries and travels to
// Rust as the token `EntityKind::from_token` parses.
export component CardContextMenu inherits Rectangle {
    // "album" | "artist" | "genre" | "playlist" | "track" | "folder". Only "folder" is not an
    // `EntityKind`: Browse routes those through its own global, a folder being a path.
    in property <string> card-kind;
    in property <int> card-id;
    // Folder cards only.
    in property <string> card-path;
    // Playlist cards only: gates the rules entry, which a manual playlist has no answer for.
    // Rename and Edit Artwork are *not* gated on it. Both are well defined for a smart playlist
    // and three other surfaces already offer them, the card's own hover buttons included, so
    // gating here only made the menu disagree with the pencil sitting on the same card.
    in property <bool> card-is-smart: false;
    // Album cards only. 0 means no linkage and hides the entry.
    in property <int> card-artist-id: 0;
    // Whether this card's own favorite state is known, and what it is. A track card carries one,
    // on the grids that draw its heart; an album, artist, genre or playlist is a set of tracks and
    // has no single answer.
    in property <bool> favorite-known: false;
    in property <bool> card-is-favorite: false;

    in property <bool> card-selected;
    // The batch payload in multi mode, the host's own scope's selection.
    in property <[int]> effective-selection;
    in property <int> selection-count;
    in property <length> at-x;
    in property <length> at-y;

    // Read by the host to route a batch action. Multi mode needs this card selected *and* more
    // than one selected — a right-click on an unselected card falls back to that card alone and
    // leaves the selection untouched.
    out property <bool> multi-active: root.card-selected && root.selection-count > 1;

    property <int> multi-count: root.selection-count;
    property <bool> is-playlist: root.card-kind == "playlist";
    property <bool> is-folder: root.card-kind == "folder";
    property <bool> is-track: root.card-kind == "track";
    // A folder is one path and never joins a selection, so its whole arm is single-target.
    property <bool> folder-single: root.is-folder && !root.multi-active;
    // Rename and Edit Artwork: single-target, and a playlist's whatever its kind.
    property <bool> playlist-edits: root.is-playlist && !root.multi-active;

    // **Only the kinds with more than one field to copy open a flyout.** The rest copy their one
    // field from the row itself, and their menu reserves no room for a column it never opens.
    property <bool> has-flyout: root.is-track || root.card-kind == "album";
    property <bool> copy-open;

    public function show() {
        root.copy-open = false;
        pop.show();
    }

    // `TrackContextMenu.dismiss`: every entry closes the menu after acting, the popup's own policy
    // being unable to spare the click that opens the flyout.
    function dismiss() {
        root.copy-open = false;
        pop.close();
    }

    // Per-kind entries the host owns, because the grid already has these wired for its hover
    // controls or its navigation.
    callback rename();
    callback edit-artwork();
    callback edit-rules();
    callback delete-cards([int] /*playlist_ids*/);
    // Take every card the grid is showing, and drop the whole set. No payload either way: the
    // host owns the set.
    callback select-all();
    callback clear-selection();
    // Track cards only. Their grids *do* play on activation, so Play over one of them has to mean
    // what clicking it means, the whole displayed set from that track, rather than a queue of one.
    // `TrackContextMenu` carries the same callback for the same reason.
    callback play-single();
    callback open-folder(string /*path*/);
    callback play-folder(string /*path*/);
    callback play-folder-next(string /*path*/);
    callback queue-folder(string /*path*/);
    callback reveal-folder(string /*path*/);
    // The album card's one cross-tab entry, routed by the grid to `Albums.go-to-artist` — this
    // file imports no view global, as the row menu's "Go to …" set doesn't either.
    callback go-to-artist(int /*artist_id*/);

    // **Pinned at the origin, and the zero size is why** — the `TrackContextMenu` argument
    // verbatim: a child with no `x`/`y` in a non-layout parent is *centred*, so at zero width the
    // wrapper lands at half the card and carries the popup with it, `at-x` being measured from
    // here. Set inside the component, where a host cannot forget it.
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    // One PopupWindow per mounted card. The grids virtualize by row, so this stays a screenful of
    // popups whatever the library size. Opened wide enough for its Copy flyout where it has one,
    // on whichever side has room, `TrackContextMenu`'s reserve.
    pop := PopupWindow {
        // On the popup, so it can read its own descendant's layout.
        property <length> menu-w: ContextMenuMetrics.menu-w(menu-vl.preferred-width);
        property <length> menu-h: menu-vl.preferred-height;
        property <length> flyout-h: ContextMenuMetrics.flyout-h(root.is-track ? 5 : 3);
        property <length> reserve: root.has-flyout
            ? ContextMenuMetrics.gap + ContextMenuMetrics.flyout-w
            : 0px;
        // Off the root's position, which sits outside the popup and so still means the window.
        property <bool> flyout-left: root.has-flyout
            && ContextMenuMetrics.opens-left(root.absolute-position.x + root.at-x, self.menu-w);

        x: root.at-x - (self.flyout-left ? self.reserve : 0px);
        y: root.at-y;
        width: self.menu-w + self.reserve;
        height: root.has-flyout ? max(self.menu-h, self.flyout-h) : self.menu-h;
        close-policy: close-on-click-outside;

        // This card alone in single mode, the whole selection in multi. Computed once so every
        // handler reads the same list.
        property <[int]> effective-ids:
            root.multi-active ? root.effective-selection : [root.card-id];

        // Ungated, as on the row menu: the popup's body exists only while it is shown.
        FocusLossWatcher {
            close => { root.dismiss(); }
        }

        // First, so every row drawn over it wins its own click and a click on the empty reserve
        // still closes the menu.
        PopupDismissCatcher {
            width: parent.width;
            height: parent.height;
            clicked => { root.dismiss(); }
        }

        PopupSurface {
            x: pop.flyout-left ? pop.reserve : 0px;
            y: 0px;
            width: pop.menu-w;
            height: pop.menu-h;

            menu-vl := VerticalLayout {
                padding: ContextMenuMetrics.inset;
                spacing: 0;

                // **Play stays in multi mode here, unlike the row menu.** There it is dropped
                // because "play a selection" is ambiguous against "queue it"; on the entity grids
                // nothing else plays at all — a card click opens the detail — so dropping it would
                // remove what the selection is for.
                //
                // A lone track card is the exception, its grid playing on activation, and it goes
                // through the host's own path rather than `CardActions`.
                MenuItem {
                    label: @tr("Play");
                    icon: "play_arrow";
                    clicked => {
                        if (root.is-folder) {
                            root.play-folder(root.card-path);
                        } else if (root.is-track && !root.multi-active) {
                            root.play-single();
                        } else {
                            CardActions.play(root.card-kind, pop.effective-ids);
                        }
                        root.dismiss();
                    }
                }
                if !root.is-folder: MenuItem {
                    label: @tr("Shuffle");
                    icon: "shuffle";
                    clicked => {
                        CardActions.shuffle(root.card-kind, pop.effective-ids);
                        root.dismiss();
                    }
                }
                MenuItem {
                    label: root.multi-active
                        ? @tr("Play {} Next", root.multi-count)
                        : @tr("Play Next");
                    icon: "queue_play_next";
                    clicked => {
                        if (root.is-folder) {
                            root.play-folder-next(root.card-path);
                        } else {
                            CardActions.play-next(root.card-kind, pop.effective-ids);
                        }
                        root.dismiss();
                    }
                }
                MenuItem {
                    label: root.multi-active
                        ? @tr("Add {} to Queue", root.multi-count)
                        : @tr("Add to Queue");
                    icon: "queue_music";
                    clicked => {
                        if (root.is-folder) {
                            root.queue-folder(root.card-path);
                        } else {
                            CardActions.add-to-queue(root.card-kind, pop.effective-ids);
                        }
                        root.dismiss();
                    }
                }

                // The playlist entries below need a real track list, which a folder reaches only
                // through Browse's own callbacks — so the whole block sits out for a folder card.
                if !root.is-folder: MenuSeparator {}
                if !root.is-folder: MenuItem {
                    label: @tr("New Playlist…");
                    icon: "add";
                    clicked => {
                        // Unlike the row menu's, this can't fill `Dialog` inline: the opener wants
                        // the *track* ids, which only Rust knows. It sets its own `@tr` chrome and
                        // raises the card once they land.
                        CardActions.create-playlist-from(root.card-kind, pop.effective-ids);
                        root.dismiss();
                    }
                }
                if !root.is-folder: MenuItem {
                    label: @tr("Add to Playlist");
                    icon: "playlist_add";
                    clicked => {
                        // A plain heading even over a selection: the count here is *cards*, and
                        // the track total only exists once Rust has resolved them.
                        Dialog.prepare-add-to-playlist(@tr("Add to Playlist"));
                        CardActions.add-to-playlist(root.card-kind, pop.effective-ids);
                        root.dismiss();
                    }
                }

                if !root.is-folder: MenuSeparator {}
                // **One entry where the card's state is known, the row menu's toggle**: it names
                // the direction away from the clicked card and applies it to the whole set, so a
                // selection of favorites is only ever offered their removal.
                if root.favorite-known: MenuItem {
                    label: root.multi-active
                        ? (root.card-is-favorite
                            ? @tr("Remove {} from Favorites", root.multi-count)
                            : @tr("Add {} to Favorites", root.multi-count))
                        : (root.card-is-favorite
                            ? @tr("Remove from Favorites")
                            : @tr("Add to Favorites"));
                    icon: root.card-is-favorite ? "heart_minus" : "favorite";
                    clicked => {
                        CardActions.set-favorites(
                            root.card-kind, pop.effective-ids, !root.card-is-favorite);
                        root.dismiss();
                    }
                }
                // **Two entries where it isn't.** An album, artist, genre or playlist is a set of
                // tracks, so the state the row menu reads off `row-is-favorite` has no honest
                // answer here: half a playlist favourited would make either label a lie, and
                // resolving the truth means a query per menu open, per card. Both operations are
                // well defined over a set whatever its mixture, so offering them retires the
                // question rather than answering it.
                if !root.is-folder && !root.favorite-known: MenuItem {
                    label: @tr("Add to Favorites");
                    icon: "favorite";
                    clicked => {
                        CardActions.set-favorites(root.card-kind, pop.effective-ids, true);
                        root.dismiss();
                    }
                }
                if !root.is-folder && !root.favorite-known: MenuItem {
                    label: @tr("Remove from Favorites");
                    icon: "heart_minus";
                    clicked => {
                        CardActions.set-favorites(root.card-kind, pop.effective-ids, false);
                        root.dismiss();
                    }
                }
                if !root.is-folder: MenuItem {
                    label: root.multi-active
                        ? @tr("Edit Tags for {}", root.multi-count)
                        : @tr("Edit Tags…");
                    icon: "edit";
                    clicked => {
                        CardActions.edit-tags(
                            root.card-kind,
                            pop.effective-ids,
                            root.multi-active
                                ? @tr("Edit {} Tracks", root.multi-count)
                                : @tr("Edit Track Information"));
                        root.dismiss();
                    }
                }

                // Copy heads the group of entries that read the card rather than act on its
                // tracks, the single-target ones below it. Every kind has it, so the separator
                // above needs no gate. Not behind an `if`, the flyout lining up against its `y`.
                MenuSeparator {}
                copy-row := MenuItem {
                    label: root.has-flyout
                        ? @tr("Copy")
                        : (root.is-folder ? @tr("Copy Path") : @tr("Copy Name"));
                    icon: "content_copy";
                    submenu: root.has-flyout;
                    submenu-open: root.copy-open;
                    submenu-left: pop.flyout-left;
                    clicked => {
                        if (root.has-flyout) {
                            root.copy-open = !root.copy-open;
                        } else {
                            if (root.is-folder) {
                                CopyActions.copy-text(root.card-path);
                            } else {
                                CopyActions.copy-entities(root.card-kind, "name", pop.effective-ids);
                            }
                            root.dismiss();
                        }
                    }
                }
                if root.folder-single: MenuItem {
                    label: @tr("Open Folder");
                    icon: "folder_open";
                    clicked => {
                        root.open-folder(root.card-path);
                        root.dismiss();
                    }
                }
                if root.folder-single: MenuItem {
                    label: @tr("Show in File Manager");
                    icon: "drive_file_move";
                    clicked => {
                        root.reveal-folder(root.card-path);
                        root.dismiss();
                    }
                }
                if root.is-track && !root.multi-active: MenuItem {
                    label: @tr("Open Containing Folder");
                    icon: "folder_open";
                    clicked => {
                        Nav.reveal-in-folder(root.card-id);
                        root.dismiss();
                    }
                }
                if !root.multi-active && root.card-artist-id != 0: MenuItem {
                    label: @tr("Go to Artist");
                    icon: "person";
                    clicked => {
                        root.go-to-artist(root.card-artist-id);
                        root.dismiss();
                    }
                }

                // The selection group. **Clear is gated on the scope holding a set rather than on
                // this card being in it.** That is the row menu's gate and a grid cannot borrow
                // it: a card has no second activation, so a set scrolled or filtered out of view
                // leaves every visible card picking instead of opening, with no card left able to
                // offer the way back. Both go through the host, five grids keeping their set on
                // `CardSelection` while Browse keeps its cards' on `Browse`, its cards being its
                // list rows.
                MenuSeparator {}
                MenuItem {
                    label: @tr("Select all");
                    icon: "select_all";
                    clicked => {
                        root.select-all();
                        root.dismiss();
                    }
                }
                if root.selection-count > 0: MenuItem {
                    label: @tr("Clear selection");
                    icon: "close";
                    clicked => {
                        root.clear-selection();
                        root.dismiss();
                    }
                }

                // The playlist block mirrors the card's own hover trio, which stays: the buttons
                // are the discoverable path and these are the right-click one. Mirrors it for a
                // smart playlist too, the buttons being ungated there.
                if root.is-playlist: MenuSeparator {}
                if root.playlist-edits: MenuItem {
                    label: @tr("Rename…");
                    icon: "edit";
                    clicked => {
                        root.rename();
                        root.dismiss();
                    }
                }
                if root.playlist-edits: MenuItem {
                    label: @tr("Edit Artwork…");
                    icon: "image";
                    clicked => {
                        root.edit-artwork();
                        root.dismiss();
                    }
                }
                if root.is-playlist && !root.multi-active && root.card-is-smart: MenuItem {
                    label: @tr("Edit Rules…");
                    icon: "auto_awesome";
                    clicked => {
                        root.edit-rules();
                        root.dismiss();
                    }
                }
                if root.is-playlist: MenuItem {
                    label: root.multi-active
                        ? @tr("Delete {} Playlists", root.multi-count)
                        : @tr("Delete Playlist");
                    icon: "delete";
                    destructive: true;
                    clicked => {
                        root.delete-cards(pop.effective-ids);
                        root.dismiss();
                    }
                }
            }
        }

        // Level with the Copy row, and lifted where that row sits too low for the whole column to
        // fit. A track card offers what a track row does; an album its own name and credit.
        if root.copy-open: MenuFlyout {
            x: pop.flyout-left ? 0px : pop.menu-w + ContextMenuMetrics.gap;
            y: max(0px, min(copy-row.y - ContextMenuMetrics.inset, pop.height - pop.flyout-h));
            width: ContextMenuMetrics.flyout-w;
            height: pop.flyout-h;

            if root.is-track: MenuItem {
                label: @tr("Title");
                icon: "title";
                clicked => {
                    CopyActions.copy-tracks("title", pop.effective-ids);
                    root.dismiss();
                }
            }
            if root.is-track: MenuItem {
                label: @tr("Artist");
                icon: "person";
                clicked => {
                    CopyActions.copy-tracks("artist", pop.effective-ids);
                    root.dismiss();
                }
            }
            if root.is-track: MenuItem {
                label: @tr("Album");
                icon: "album";
                clicked => {
                    CopyActions.copy-tracks("album", pop.effective-ids);
                    root.dismiss();
                }
            }
            if root.is-track: MenuItem {
                label: @tr("Artist - Title");
                icon: "music_note";
                clicked => {
                    CopyActions.copy-tracks("artist-title", pop.effective-ids);
                    root.dismiss();
                }
            }
            if root.is-track: MenuItem {
                label: @tr("File Path");
                icon: "folder_open";
                clicked => {
                    CopyActions.copy-tracks("path", pop.effective-ids);
                    root.dismiss();
                }
            }
            if !root.is-track: MenuItem {
                label: @tr("Album");
                icon: "album";
                clicked => {
                    CopyActions.copy-entities("album", "name", pop.effective-ids);
                    root.dismiss();
                }
            }
            if !root.is-track: MenuItem {
                label: @tr("Artist");
                icon: "person";
                clicked => {
                    CopyActions.copy-entities("album", "artist", pop.effective-ids);
                    root.dismiss();
                }
            }
            if !root.is-track: MenuItem {
                label: @tr("Artist - Album");
                icon: "music_note";
                clicked => {
                    CopyActions.copy-entities("album", "artist-name", pop.effective-ids);
                    root.dismiss();
                }
            }
        }
    }
}
