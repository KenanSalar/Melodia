import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EntityStripRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";
import { CollapsibleSectionHeader } from "../collapsible-section-header.slint";

// A horizontally scrolling row of `EntityCard`s under a heading. Every card is built and every
// cover requested, which is affordable only for a short set; a library-sized one takes
// `EntityCardGrid`. Its panel is a rounded fill rather than a rounded clip, which would render
// the cards into a texture on every scroll frame.
export component HorizontalCardStrip inherits Rectangle {
    in property <string>             heading;
    in property <[EntityStripRow]>   rows;
    in property <length>             card-width: 160px;
    in property <length>             card-height: 206px;
    in property <bool>               circular: false;
    in property <string>             fallback-icon: "music-note";
    in property <bool>               collapsible: false;
    in property <bool>               collapsed: false;

    pure callback request-cover(string) -> image;
    callback row-clicked(int);
    callback toggled();

    private property <length> strip-height: root.card-height + 18px;

    background: Theme.surface0;
    border-radius: Theme.radius-lg;

    VerticalLayout {
        // The panel's own radius, so the strip's square clip stays inside the curve.
        padding: root.border-radius;
        spacing: Theme.pad-sm;

        if root.collapsible: HorizontalLayout {
            alignment: start;

            CollapsibleSectionHeader {
                label: root.heading;
                collapsed: root.collapsed;
                toggled => { root.toggled(); }
            }
        }
        if !root.collapsible: Text {
            text: root.heading;
            color: Theme.text;
            font-size: Theme.font-size-md;
            font-weight: 700;
            letter-spacing: 0.4px;
        }

        // Unmounted rather than hidden, since a collapse hands the strip's covers back.
        if root.rows.length > 0 && !root.collapsed: Rectangle {
            height: root.strip-height;
            clip: true;

            sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy:   always-off;
                // The style's default too, pinned: a drag-pan takes any press that drifts.
                mouse-drag-pan-enabled: false;
                content-height: self.height;

                HorizontalLayout {
                    spacing: Theme.pad-md;
                    alignment: start;

                    for row in root.rows: EntityCard {
                        artwork-path: row.artwork_path;
                        cover: root.request-cover(row.artwork_path);
                        title: row.title;
                        subtitle: row.subtitle;
                        card-width: root.card-width;
                        card-height: root.card-height;
                        circular: root.circular;
                        fallback-icon: root.fallback-icon;
                        cover-scale-hover: row.artwork_path == "" ? 1.15 : 1.04;
                        on-card: true;
                        clicked => { root.row-clicked(row.id); }
                    }
                }
            }

            OverlayScrollbar {
                horizontal: true;
                x: 0;
                y: parent.height - self.height;
                width: parent.width;
                height: 8px;
                track-color: Theme.scrollbar-track-on-card;
                visible-size: sv.visible-width;
                content-size: sv.content-width;
                offset: -sv.content-x;
                scroll-to(o) => { sv.content-x = -o; }
            }
        }
    }
}
