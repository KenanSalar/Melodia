import { ListView } from "std-widgets.slint";
import { GenreGridRow } from "../../models.slint";
import { CardSelection } from "../../globals/card-selection.slint";
import { PopupHighlight } from "../../globals/shell.slint";
import { EntityCard } from "entity-card.slint";
import { CardContextMenu } from "card-context-menu.slint";

// Virtualized genre-card grid: `AlbumGrid` minus the cover plumbing. A genre has no artwork, so
// each card falls back to its glyph and nothing here allocates an `Image` or needs an LRU. Rust
// chunks the flat list into rows of `columns` cards, so the inner `ListView` virtualizes by row.
// Same host-mounted-scrollbar contract as `TrackList` and `AlbumGrid`.
export component GenreGrid inherits Rectangle {
    in property <[GenreGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is baked into the slot height because a `ListView` lays its delegates back-to-back
    // and has no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-genre(int /*genre_id*/);

    // Same sign convention as `TrackList` — a positive `v-offset` is N px scrolled, where the
    // inner `ListView` holds that as a non-positive `viewport-y`.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // A card click and a drag-pan are one gesture, and the default is the style's to pick;
        // argument on `views/radio/station-grid.slint`.
        mouse-drag-pan-enabled: false;

        for grid-row in root.rows: Rectangle {
            // A `ListView` delegate needs a fixed height or the virtualization math breaks.
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                // A wrapper per card, for the reason `PlaylistGrid` gives.
                for genre in grid-row.genres: cell := Rectangle {
                    width: root.card-width;
                    height: root.card-height;

                    property <length> ctx-x;
                    property <length> ctx-y;
                    property <int> ctx-card-id: -1;

                    EntityCard {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        // With no cover binding the card paints its glyph over a
                        // name-hashed gradient. Rust precomputes both stops on
                        // three independent axes — hue, hue offset, S/V jitter — so
                        // cards stay distinguishable even at neighbouring hues.
                        fallback-icon: "theater_comedy";
                        tile-bg: @linear-gradient(135deg,
                            genre.tile_color_1,
                            genre.tile_color_2);
                        tile-icon-color: #ffffff.with-alpha(0.3);
                        // The pronounced zoom, not the covers' gentle one: on a glyph drawn at
                        // just over half the tile, the gentle one reads as no zoom at all.
                        cover-scale-hover: 1.15;
                        title: genre.name;
                        // The duration arrives display-ready from Rust; the count takes the
                        // Artists grid's plural pair, a genre being able to exist for one track.
                        subtitle:
                            @tr("{n} track" | "{n} tracks" % genre.track_count)
                            + " · " + genre.display_duration;
                        clicked => { root.open-genre(genre.id); }

                        selectable: true;
                        selected: CardSelection.selected(
                            "genres", genre.id, CardSelection.generation);
                        selection-live: CardSelection.any-in("genres");
                        select-clicked(shift, ctrl) => {
                            CardSelection.pick("genres", genre.id, shift, ctrl);
                        }
                        context-requested(x, y) => {
                            cell.ctx-x = x;
                            cell.ctx-y = y;
                            cell.ctx-card-id = genre.id;
                            PopupHighlight.card-ctx-id = genre.id;
                            ctx-menu.show();
                        }
                    }

                    ctx-menu := CardContextMenu {
                        card-kind: "genre";
                        card-id: genre.id;
                        clear-selection => { CardSelection.clear(); }
                        card-selected: CardSelection.selected(
                            "genres", genre.id, CardSelection.generation);
                        effective-selection: CardSelection.scope == "genres"
                            ? CardSelection.selected-ids
                            : [];
                        selection-count: CardSelection.count-in("genres");
                        at-x: cell.ctx-x;
                        at-y: cell.ctx-y;
                        ctx-key: cell.ctx-card-id;
                        live-ctx-key: PopupHighlight.card-ctx-id;

                        released => {
                            PopupHighlight.card-ctx-id = -1;
                            cell.ctx-card-id = -1;
                        }
                    }
                }
            }
        }
    }
}
