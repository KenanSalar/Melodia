import { ListView } from "std-widgets.slint";
import { BrowseCardGridRow, TrackListRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";
import { CardContextMenu } from "card-context-menu.slint";
import { CardFavoriteButton } from "card-favorite-button.slint";

// Browse's card view over subfolders and files, in the list's order. `EntityCardGrid`'s skeleton,
// to be kept in step with it; the card differs, carrying a folder path, a fallback glyph and
// whether the row is a library track, which `EntityStripRow` would carry for nobody else.
export component BrowseCardGrid inherits Rectangle {
    in property <[BrowseCardGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is in the slot height, a `ListView` having no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    // The repaint token: bumped as decodes land, so the `pure` cover lookup re-runs.
    in property <int> covers-generation: 0;

    // Split at the delegate, so the existing `Browse` callbacks get the list's arguments.
    callback folder-clicked(string /*path*/);
    callback track-clicked(int /*track_id*/, int /*row_index*/);
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    // The list's selection rather than a `CardSelection` scope: the cards are its rows, so a
    // presentation toggle keeps the set. Forwarded, this file naming no view global.
    in property <[int]> selected-ids;
    in property <int> selection-generation: 0;
    pure callback is-card-selected(int /*track_id*/, int /*generation*/) -> bool;
    // `row_index` first, matching `Browse.select-row`, so a shift-range walks one order for both.
    callback select-card(int /*row_index*/, int /*track_id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();

    // A track card's heart reads the list row it is, which the list's toggle patches in place.
    in property <[TrackListRow]> list-rows;
    callback toggle-favorite(int /*track_id*/, bool /*favorite*/);

    // A folder is a path, which the entity actions can't answer.
    callback play-folder(string /*path*/);
    callback play-folder-next(string /*path*/);
    callback queue-folder(string /*path*/);
    callback reveal-folder(string /*path*/);

    // `TrackList`'s sign convention: a positive `v-offset` is N px scrolled.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.content-height;
    out property <length> v-offset: -list.content-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.content-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // A pin, not an override (`slint-pitfalls.md`'s drag-pan entry).
        mouse-drag-pan-enabled: false;

        for grid-row in root.rows: Rectangle {
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                // `CardCell`'s wrapper spelled out, that component answering from a
                // `CardSelection` scope this grid hasn't got.
                for card in grid-row.cards: cell := Rectangle {
                    width: root.card-width;
                    height: root.card-height;

                    property <bool> favorable: card.enabled && !card.is_folder;
                    property <bool> is-favorite:
                        cell.favorable && root.list-rows[card.row_index].is_favorite;

                    card-body := EntityCard {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        artwork-path: card.artwork_path;
                        cover: root.request-cover(card.artwork_path, root.covers-generation);
                        fallback-icon: card.is_folder ? "folder" : "music-note";
                        // Real artwork stays gentle so a cover doesn't jitter in the tile clip.
                        cover-scale-hover: card.artwork_path == "" ? 1.15 : 1.04;
                        title: card.title;
                        subtitle: card.is_folder ? @tr("Folder") : card.subtitle;
                        enabled: card.enabled;
                        clicked => {
                            if (card.is_folder) {
                                root.folder-clicked(card.path);
                            } else {
                                root.track-clicked(card.id, card.row_index);
                            }
                        }

                        // A folder and a disk-only file both hold `id == 0`, out of an id-keyed set.
                        selectable: card.enabled && !card.is_folder;
                        selected: root.is-card-selected(card.id, root.selection-generation);
                        selection-live: root.selected-ids.length > 0;
                        select-clicked(shift, ctrl) => {
                            root.select-card(card.row_index, card.id, shift, ctrl);
                        }
                        context-requested(x, y) => { ctx-menu.show-at(x, y); }
                        menu-open: ctx-menu.is-open;
                        overlay-hovered: fav.has-hover;
                    }

                    fav := CardFavoriteButton {
                        visible: cell.favorable;
                        card-width: root.card-width;
                        is-favorite: cell.is-favorite;
                        card-hovered: card-body.card-hovered;
                        clicked => { root.toggle-favorite(card.id, !cell.is-favorite); }
                    }

                    ctx-menu := CardContextMenu {
                        card-kind: card.is_folder ? "folder" : "track";
                        card-id: card.id;
                        card-path: card.path;
                        favorite-known: cell.favorable;
                        card-is-favorite: cell.is-favorite;
                        select-all => { root.select-all(); }
                        clear-selection => { root.clear-selection(); }
                        card-selected: root.is-card-selected(card.id, root.selection-generation);
                        effective-selection: root.selected-ids;
                        selection-count: root.selected-ids.length;

                        // What a click gives: the folder from this track.
                        play-single => { root.track-clicked(card.id, card.row_index); }
                        open-folder(path) => { root.folder-clicked(path); }
                        play-folder(path) => { root.play-folder(path); }
                        play-folder-next(path) => { root.play-folder-next(path); }
                        queue-folder(path) => { root.queue-folder(path); }
                        reveal-folder(path) => { root.reveal-folder(path); }
                    }
                }
            }
        }
    }
}
