import { ListView } from "std-widgets.slint";
import { BrowseCardGridRow } from "../../models.slint";
import { PopupHighlight } from "../../globals/shell.slint";
import { EntityCard } from "entity-card.slint";
import { CardContextMenu } from "card-context-menu.slint";

// Browse's card view: one virtualized grid over subfolders *and* files, folders first, in the same
// order the list would draw them. Rust chunks the flat card list into rows of `columns`, so the
// inner `ListView` virtualizes by row.
//
// **`EntityCardGrid`'s skeleton, kept deliberately in step with it** — the delegate's fixed height,
// the gap-padded row, the lazy `covers-generation` cover binding and the host-mounted-scrollbar
// contract are that component's and should move together with it. What can't be shared is the card:
// a browse card carries three things no entity card has — a coverless tile's fallback glyph,
// whether the row is a real library track, and a folder path to drill into — and putting those on
// `EntityStripRow` would tax the four grids sharing it for a case none of them has.
export component BrowseCardGrid inherits Rectangle {
    in property <[BrowseCardGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is baked into the slot height because a `ListView` lays its delegates back-to-back
    // and has no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    // Bumped by the host once the card tier behind `request-cover` is warm. A mode toggle has no
    // fetch to await before the grid mounts, so the binding reads this to re-run and its value
    // tells Rust whether it may decode.
    in property <int> covers-generation: 0;

    // A folder card drills in; a track card plays the folder from that track. Split at the delegate
    // rather than dispatched in Rust, so the two existing `Browse` callbacks are reached with
    // exactly the arguments the list already passes them.
    callback folder-clicked(string /*path*/);
    callback track-clicked(int /*track_id*/, int /*row_index*/);
    // Forwarded by the host to its own global. `pure` so a binding can call it.
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    // **Browse's cards read the *list's* selection**, not the shared `CardSelection` the four
    // entity grids use — they are the same rows, so toggling the presentation keeps the selection
    // and the view's existing pill group already describes it. Forwarded rather than imported,
    // as the two callbacks above are: `Browse` is a view global and this file names none.
    in property <[int]> selected-ids;
    in property <int> selection-generation: 0;
    pure callback is-card-selected(int /*track_id*/, int /*generation*/) -> bool;
    // `row_index` first, so the host forwards straight to `Browse.select-row` with the arguments
    // the list already passes it and the shift-range walks one order for both presentations.
    callback select-card(int /*row_index*/, int /*track_id*/, bool /*shift*/, bool /*ctrl*/);
    // Raised by a card's context menu; the view answers it against the list's set.
    callback clear-selection();

    // The folder card's menu, which the entity actions can't answer: a folder is a path.
    callback play-folder(string /*path*/);
    callback play-folder-next(string /*path*/);
    callback queue-folder(string /*path*/);
    callback reveal-folder(string /*path*/);

    // Same sign convention as `TrackList`, `AlbumGrid` and `EntityCardGrid` — a positive `v-offset`
    // is N px scrolled, where the inner `ListView` holds that as a non-positive `viewport-y`.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // A card click and a drag-pan are one gesture, and the default is the style's to pick;
        // argument on `views/radio/station-grid.slint`.
        mouse-drag-pan-enabled: false;

        for grid-row in root.rows: Rectangle {
            // A `ListView` delegate needs a fixed height or the virtualization math breaks.
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                // A wrapper per card, for the reason `PlaylistGrid` gives.
                for card in grid-row.cards: cell := Rectangle {
                    width: root.card-width;
                    height: root.card-height;

                    property <length> ctx-x;
                    property <length> ctx-y;
                    property <int> ctx-card-id: -1;

                    EntityCard {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        artwork-path: card.artwork_path;
                        cover: root.request-cover(card.artwork_path, root.covers-generation);
                        fallback-icon: card.is_folder ? "folder" : "music-note";
                        // A pronounced zoom on the placeholder, as on the other grids; real
                        // artwork stays gentle so a cover doesn't jitter inside the tile clip.
                        cover-scale-hover: card.artwork_path == "" ? 1.15 : 1.04;
                        title: card.title;
                        // A folder's subtitle is a literal here rather than a string Rust pushed,
                        // `@tr` only translating literals at codegen. A track card has its artist.
                        subtitle: card.is_folder ? @tr("Folder") : card.subtitle;
                        // A disk-only file — on disk inside a library folder but not in the DB.
                        // `EntityCard` dims it and disables its own TouchArea.
                        enabled: card.enabled;
                        clicked => {
                            if (card.is_folder) {
                                root.folder-clicked(card.path);
                            } else {
                                root.track-clicked(card.id, card.row_index);
                            }
                        }

                        // **A folder and a disk-only file both hold `id == 0`**, which is what
                        // keeps them out of an id-keyed selection — the same guard the list's
                        // handler already opens with, so no second predicate is spelled here.
                        selectable: card.enabled && !card.is_folder;
                        selected: root.is-card-selected(card.id, root.selection-generation);
                        selection-live: root.selected-ids.length > 0;
                        select-clicked(shift, ctrl) => {
                            root.select-card(card.row_index, card.id, shift, ctrl);
                        }
                        // **Keyed on `card_index`, not on `id`** — every folder and every
                        // disk-only file holds id 0, so an id here would arm all of their
                        // watchers on the one open popup. The entity grids have no such
                        // collision and key on their own ids.
                        context-requested(x, y) => {
                            cell.ctx-x = x;
                            cell.ctx-y = y;
                            cell.ctx-card-id = card.card_index;
                            PopupHighlight.card-ctx-id = card.card_index;
                            ctx-menu.show();
                        }
                    }

                    ctx-menu := CardContextMenu {
                        card-kind: card.is_folder ? "folder" : "track";
                        card-id: card.id;
                        card-path: card.path;
                        clear-selection => { root.clear-selection(); }
                        card-selected: root.is-card-selected(card.id, root.selection-generation);
                        effective-selection: root.selected-ids;
                        selection-count: root.selected-ids.length;
                        at-x: cell.ctx-x;
                        at-y: cell.ctx-y;
                        ctx-key: cell.ctx-card-id;
                        live-ctx-key: PopupHighlight.card-ctx-id;

                        // The card's own activation: the folder from this track, as a click gives.
                        play-single => { root.track-clicked(card.id, card.row_index); }
                        open-folder(path) => { root.folder-clicked(path); }
                        play-folder(path) => { root.play-folder(path); }
                        play-folder-next(path) => { root.play-folder-next(path); }
                        queue-folder(path) => { root.queue-folder(path); }
                        reveal-folder(path) => { root.reveal-folder(path); }
                        released => {
                            PopupHighlight.card-ctx-id = -1;
                            cell.ctx-card-id = -1;
                        }
                    }
                }
            }
        }
    }
}
