import { Theme } from "../../theme.slint";
import { IconButton } from "../icon-button.slint";

// A card's heart (`ui-patterns.md`). Up while the card is a favorite, so a grid shows what is kept
// without a hover per card; `marks-kept: false` makes it a hover control where every card is one.
// Beside the card rather than in its overlay slot, so the host owes the card
// `overlay-hovered: <this>.has-hover`.
export component CardFavoriteButton inherits IconButton {
    in property <length> card-width;
    in property <bool> is-favorite;
    in property <bool> marks-kept: true;
    in property <bool> card-hovered;

    // The corner the selection box leaves free.
    x: root.card-width - self.width - 2 * Theme.pad-sm;
    y: 2 * Theme.pad-sm;
    icon: root.is-favorite ? "favorite" : "favorite_border";
    icon-size: 18px;
    diameter: 30px;
    filled: root.is-favorite;
    idle-bg: Theme.floating-chrome-bg;
    idle-fg: root.is-favorite ? Theme.red : Theme.text;
    hover-fg: Theme.red;
    fade: root.has-hover || root.card-hovered || (root.is-favorite && root.marks-kept) ? 1.0 : 0.0;
    animate fade { duration: Theme.dur-fast; easing: ease-in-out; }
}
