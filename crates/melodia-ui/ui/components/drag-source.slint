import { Drag, DragItems, DragOrigin } from "../globals/drag.slint";
import { LiftedRun } from "../models.slint";

// A list's drag: a `DragArea` round its `ListView`, **never inside a row**, which can be destroyed
// before its drag ends. It takes the press at 8 px and sends the rows a cancel, so a drag lands
// no click. Rows report their press through `arm` or `arm-items` (`Drag.payload` argues which),
// and a press carrying the list's picks adds `lift-picks`.
export component DragSource inherits DragArea {
    in property <DragOrigin> origin;

    // Every picked row dims while this holds, as `lifts` dims the pressed one.
    out property <bool> lifting-picks: root.dragging && Drag.payload.origin == root.origin
        && Drag.payload.picks;

    callback background-clicked();

    data: Drag.token;
    // The touch gate, which a mount binding `enabled` would override.
    enabled: !Drag.touching;

    changed dragging => {
        Drag.live = self.dragging;
    }

    // Behind the list: a `DragArea` takes every left press its children don't, so a click on the
    // empty space would otherwise reach nothing.
    TouchArea {
        clicked => { root.background-clicked(); }
    }

    public function arm(index: int) {
        Drag.arm(root.origin, index);
    }

    public function arm-items(index: int, items: DragItems) {
        Drag.arm-items(root.origin, index, items);
    }

    public function lift-picks(run: LiftedRun) {
        Drag.lift-picks(run);
    }

    public pure function lifts(index: int) -> bool {
        return root.dragging && Drag.payload.origin == root.origin && Drag.payload.index == index;
    }
}
