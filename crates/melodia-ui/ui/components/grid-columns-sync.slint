// Carries a grid view's column count into whichever global backs it: this owns when, the host's
// `seed` what.
//
// **Two fire sources, and the Timer is the one easy to leave out**: `changed` doesn't fire on the
// first evaluation, so a window whose first layout lands on its final width would leave Rust
// chunking against the global's default.
export component GridColumnsSync {
    in property <int> computed-cols;
    callback seed(int);

    Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            root.seed(root.computed-cols);
        }
    }

    property <int> watched-cols: root.computed-cols;
    changed watched-cols => {
        root.seed(root.watched-cols);
    }
}
