import { Theme } from "../theme.slint";

// The square artwork tile: a decoded `cover`, else a fallback over `tile-bg`. **Where the image
// comes from is the host's business**: a repeated tile binds a lazy per-path lookup, so only a
// mounted tile costs a cache hit, and a singleton is handed one image Rust decoded.
export component ArtworkImage inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    // **Suppresses a `cover` the host can't withhold**: with no empty-`image` literal, a host
    // choosing between globals' covers binds one even on an arm that owns none.
    in property <bool> has-cover: true;
    in property <length> tile-size: 56px;
    in property <length> tile-radius: Theme.radius-md;
    // An SVG asset rather than a font glyph, for the reason the branches below give.
    in property <string> fallback-icon: "music-note";
    // Lettering in place of the glyph, for a host whose entries have identities of their own: on
    // the Radio grid, one repeated icon is what a station looks like least.
    in property <string> fallback-text;
    // The hover zoom, cropped by the tile's clip.
    in property <float> cover-scale: 1.0;
    // What the source would draw at 1:1, which only the host knows from its tier's decode size.
    // `0px` means don't ask; only the station tiles set it.
    in property <length> native-size: 0px;
    // Past this magnification a source reads soft, so it floats on a card no larger than
    // `max-inset-fraction` of the tile, reading as inset rather than a near-miss fill. Here, so two
    // tiles can't disagree about what sharp means.
    property <float> max-upscale: 2.0;
    property <float> max-inset-fraction: 0.72;

    // Measured on the native size rather than the result, so a source just clearing the bar fills
    // rather than landing on a smaller card.
    property <length> cover-inset-size: root.native-size > 0px
            && root.native-size < root.tile-size / root.max-upscale
        ? min(root.native-size * root.max-upscale, root.tile-size * root.max-inset-fraction)
        : 0px;
    // **The ease is on this mirror, never the derived size**, so a frame resize tracks at once while
    // a hover still eases.
    property <float> anim-scale: root.cover-scale;
    animate anim-scale { duration: Theme.dur-fast; easing: ease-in-out; }
    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;
    // Fades without a host `opacity`, which would layer, this root having children. `tile-bg` is
    // translucent, hence `transparentize`; the icons fade on `opacity` rather than through
    // `colorize`, which is cached per item, so a brush moving per frame re-renders it per frame.
    in property <float> fade: 1.0;

    property <bool> shows-cover: root.has-cover && root.cover.width > 0;
    property <bool> shows-glyph: !root.shows-cover && root.fallback-text == "";
    property <bool> insets-cover: root.shows-cover && root.cover-inset-size > 0px;

    width: tile-size;
    height: tile-size;
    border-radius: tile-radius;
    clip: true;

    // Square inside the clip: painted on the root, the fill and the clip antialias one curve and the
    // corner reads harder than its radius.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.tile-bg.transparentize(1.0 - root.fade);
    }

    if root.shows-cover && !root.insets-cover: Image {
        width: parent.width * root.anim-scale;
        height: parent.height * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.cover;
        image-fit: ImageFit.cover;
        opacity: root.fade;
    }

    // **A clipped `Rectangle` rather than a smaller `Image`**: the rounding is what makes it read as
    // a card, and its radius tracks the tile's by the card's own ratio.
    if root.insets-cover: Rectangle {
        width: root.cover-inset-size * root.anim-scale;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.tile-radius * self.width / root.tile-size;
        clip: true;
        opacity: root.fade;

        Image {
            width: 100%;
            height: 100%;
            source: root.cover;
            image-fit: ImageFit.cover;
        }
    }

    // **Outside the hover zoom**: scaling text means scaling `font-size`, which grows from its
    // metrics origin rather than its centre.
    if !root.shows-cover && root.fallback-text != "": Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.fallback-text;
        color: root.tile-icon-color;
        // Two letters at this fraction fill about as much of the tile as the glyphs' 0.55 box.
        font-size: round(parent.height * 0.3 / Theme.text-size-step) * Theme.text-size-step;
        font-weight: 700;
        opacity: root.fade;
    }

    // **SVG `Image`s, not Material Symbols glyphs**: a glyph scales from its metrics origin and
    // drifts sideways under the zoom, where an `Image` scales its content. One `if` per name, an
    // `@image-url` resolving at codegen.
    if root.shows-glyph && root.fallback-icon == "music-note": Image {
        source: @image-url("../assets/icons/music-note.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if root.shows-glyph && root.fallback-icon == "person": Image {
        source: @image-url("../assets/icons/person.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if root.shows-glyph && root.fallback-icon == "playlist": Image {
        source: @image-url("../assets/icons/playlist.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if root.shows-glyph && root.fallback-icon == "theater_comedy": Image {
        source: @image-url("../assets/icons/theater-comedy.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if root.shows-glyph && root.fallback-icon == "album": Image {
        source: @image-url("../assets/icons/album.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    // A station whose logo is absent, or too small for `media::image::logo_tile` to store.
    if root.shows-glyph && root.fallback-icon == "radio": Image {
        source: @image-url("../assets/icons/radio.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    // Browse's folder cards, which have no cover to have: their resting state, not a missing one.
    if root.shows-glyph && root.fallback-icon == "folder": Image {
        source: @image-url("../assets/icons/folder.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
}
