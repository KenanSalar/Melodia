import "../assets/fonts/MaterialSymbolsRounded.ttf";
import "../assets/fonts/MaterialSymbolsRoundedFilled.ttf";
import { Theme } from "../theme.slint";

// A Material Symbols Rounded glyph by ligature name. `filled` swaps to a FILL=1 static instance
// shipped under its own family, Slint's `Text` exposing no variation axis but weight.
//
// **The fixed square is the point**: it collapses the font's ~1.2× line box to the em box, so the
// glyph centres in that. Otherwise it sits a pixel or two below the text beside it, glaring on a
// circular glyph.
export component MaterialIcon {
    in property <string> name;
    in property <length> icon-size: 22px;
    in property <brush> icon-color: Theme.text;
    in property <bool> filled: false;
    // Not an `opacity`, which would layer and crop the ink. Apart from `icon-color` because hosts
    // that fade also animate that brush, and the fade folded in would stall the crossfade.
    in property <float> fade: 1.0;

    width: icon-size;
    height: icon-size;

    Text {
        text: root.name;
        font-family: root.filled ? "Material Symbols Rounded Filled" : "Material Symbols Rounded";
        font-size: root.icon-size;
        color: root.icon-color.transparentize(1.0 - root.fade);
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
