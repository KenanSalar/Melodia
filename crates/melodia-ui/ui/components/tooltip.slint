import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";

// Which side the pill clears, flipping where only the opposite has room. `below` for a host near
// the top of something that clips, which the pill can't see; `right` for the sidebar rail; `left`
// for the volume popup's percentage beside its slider.
export enum TooltipSide { above, below, left, right }

// Slint has no native tooltip. A pill drawn inside the host rather than a `PopupWindow`, so it
// takes no input and no focus, the host keeping its hover. **The reveal delay lives here**, so a
// quick pass flashes nothing anywhere.
export component Tooltip {
    in property <string> text;
    in property <bool>  hovered;
    // **Both on every mount, whatever the side**: the pill can flip to any of them, and a component
    // root can't reach `parent`.
    in property <length> host-width;
    in property <length> host-height;
    in property <TooltipSide> side: TooltipSide.above;
    in property <length> gap: 6px;
    // Pins the pill's trailing edge to the host's, for a control at the panel's right edge, a clip
    // the window clamp can't see. Read by `above`/`below` only.
    in property <bool> align-end: false;
    // Bypasses the reveal delay, for a pill surfaced without a hover (a keyboard volume change).
    in property <bool> force-shown: false;
    // **A cap rather than the window's width**, so a long translation wraps to two lines. Not
    // `max-width`, the built-in constraint a bound `width` overrides.
    in property <length> max-pill-width: 240px;
    // `absolute-position` inside a `PopupWindow` is the popup's, so there is no window to fit and the
    // pill keeps `side`.
    in property <bool> in-popup: false;

    private property <bool> shown;

    // **A zero-size anchor at the host's origin**: the pill's own `x` can't read its
    // `absolute-position` without reading itself back. Pinned, a child with no `x`/`y` being centred.
    x: 0;
    y: 0;
    width: 0;
    height: 0;

    // Hidden once faded out, not just transparent, so an idle tooltip draws nothing.
    private property <bool> drawn: root.text != "" && (root.shown || root.force-shown || root.fade > 0);
    // Gated on `drawn`, so an idle tooltip depends on nothing that scrolls.
    private property <bool> fits-window: !root.in-popup && root.drawn;

    // The window's edges, in the host's coordinates.
    private property <length> min-x: WindowChrome.shell-x + WindowChrome.edge-clearance - root.absolute-position.x;
    private property <length> max-x: WindowChrome.shell-x + WindowChrome.shell-width
        - WindowChrome.edge-clearance - root.absolute-position.x;
    private property <length> min-y: WindowChrome.edge-clearance - root.absolute-position.y;
    private property <length> max-y: WindowChrome.shell-height - WindowChrome.edge-clearance
        - root.absolute-position.y;

    private property <length> above-y: -pill.height - root.gap;
    private property <length> below-y: root.host-height + root.gap;
    private property <length> left-x: -pill.width - root.gap;
    private property <length> right-x: root.host-width + root.gap;
    // Along the host's edge, before the window moves it.
    private property <length> along-x: root.align-end
        ? (root.host-width - pill.width)
        : (root.host-width - pill.width) / 2;
    private property <length> along-y: (root.host-height - pill.height) / 2;

    private property <bool> room-above: root.above-y >= root.min-y;
    private property <bool> room-below: root.below-y + pill.height <= root.max-y;
    private property <bool> room-left: root.left-x >= root.min-x;
    private property <bool> room-right: root.right-x + pill.width <= root.max-x;

    // The opposite side only where it has the room `side` lacks.
    private property <TooltipSide> placed-side: !root.fits-window ? root.side
        : (root.side == TooltipSide.above && !root.room-above && root.room-below) ? TooltipSide.below
        : (root.side == TooltipSide.below && !root.room-below && root.room-above) ? TooltipSide.above
        : (root.side == TooltipSide.left && !root.room-left && root.room-right) ? TooltipSide.right
        : (root.side == TooltipSide.right && !root.room-right && root.room-left) ? TooltipSide.left
        : root.side;

    reveal-timer := Timer {
        interval: 500ms;
        running: root.hovered && !root.shown && root.text != "";
        triggered => { root.shown = true; }
    }

    // Reset, so the next hover restarts the delay.
    changed hovered => {
        if (!root.hovered) { root.shown = false; }
    }

    private property <float> fade: (root.shown || root.force-shown) ? 1.0 : 0.0;
    animate fade { duration: 150ms; easing: ease-out; }

    pill := Rectangle {
        width: min(tip-text.preferred-width + 16px, root.max-pill-width);
        height: tip-text.preferred-height + 8px;
        // Each side clears the host on one axis and centres on the other, which then slides inside
        // the window.
        x: root.placed-side == TooltipSide.right ? root.right-x
            : root.placed-side == TooltipSide.left ? root.left-x
            : root.fits-window ? clamp(root.along-x, root.min-x, root.max-x - self.width)
            : root.along-x;
        y: root.placed-side == TooltipSide.above ? root.above-y
            : root.placed-side == TooltipSide.below ? root.below-y
            : root.fits-window ? clamp(root.along-y, root.min-y, root.max-y - self.height)
            : root.along-y;

        // The `ActionPill` chrome, but opaque: a tooltip's whole job is to be read.
        background: Theme.surface0.transparentize(1.0 - root.fade);
        border-color: Theme.surface2.transparentize(1.0 - root.fade);
        border-width: 1px;
        border-radius: 6px;
        visible: root.drawn;

        tip-text := Text {
            text: root.text;
            color: Theme.text.transparentize(1.0 - root.fade);
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            // Bounded so the wrap has a width. The pill's width comes off the horizontal layout
            // info, intrinsic to the string, so the two don't cycle.
            width: parent.width - 16px;
            wrap: word-wrap;
        }
    }
}
