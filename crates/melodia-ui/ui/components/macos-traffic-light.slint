import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip, TooltipSide } from "tooltip.slint";

// One macOS traffic light: a 14 px circle with a glyph revealed on the *cluster's* hover, so
// crossing the cluster reveals all three at once.
export component MacOsTrafficLight inherits Rectangle {
    // A semantic Theme slot, so the lights follow the palette rather than macOS's own hex codes.
    in property <brush> circle-color;
    in property <string> glyph-icon;
    in property <string> tooltip-text;

    // The OR of the three lights' `hovered`, handed back down by the cluster.
    in property <bool> cluster-hovered: false;

    // The titlebar's height by default; a host with less room hands its own row's.
    in property <length> cell-height: 32px;
    // Past the glyph's own ease, which a per-frame fade folded into it would stall.
    in property <float> fade: 1.0;

    // Slint has no upward "child has-hover" channel, so each light publishes its own.
    out property <bool> hovered: touch.has-hover;

    // A theme-aware neutral when unfocused, rather than macOS's #D5D5D5.
    property <brush> fill: Theme.window-focused ? root.circle-color : Theme.overlay0;

    // Derived: across the palettes no one token is legible on all three hues and the grey.
    property <brush> glyph-color: Theme.ink-on(root.fill);

    property <float> glyph-t: root.cluster-hovered ? 1.0 : 0.0;
    animate glyph-t { duration: Theme.dur-fast; easing: ease-in-out; }

    callback clicked();

    // macOS's ~20 px centre-to-centre cadence, with a forgiving hit target.
    min-width: 18px;
    max-width: 18px;
    min-height: root.cell-height;
    max-height: root.cell-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    // **All-integer centring**: in centring layouts the 11 px glyph sat on a half pixel the renderer
    // snapped differently across hover states, jiggling it as the fade came in.
    circle := Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.fill.transparentize(1.0 - root.fade);
        border-radius: self.width / 2;

        MaterialIcon {
            name: root.glyph-icon;
            icon-size: 10px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon-color: root.glyph-color;
            // `fade`, never `opacity`: this rests at `0.0`, so the layer and the ink crop would be
            // its whole life.
            fade: root.glyph-t * root.fade;
        }
    }

    // Below, the lights always sitting on the window's top edge.
    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
        host-height: root.height;
        side: TooltipSide.below;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
