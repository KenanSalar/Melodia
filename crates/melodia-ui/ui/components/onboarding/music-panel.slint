import { Theme } from "../../theme.slint";
import { Onboarding } from "../../globals/onboarding.slint";
import { LibrarySettings } from "../../globals/library-settings.slint";
import { MaterialIcon } from "../material-icon.slint";
import { ScanProgress } from "../settings/scan-progress.slint";
import { SectionButton } from "../settings/section-button.slint";
import { OnboardingCard } from "onboarding-card.slint";

// Step 1, and first because nothing else fills the library: no folder is added on its own, so an
// install that skips this starts empty until one is picked on the Library tab.
export component OnboardingMusicPanel inherits OnboardingCard {
    title: @tr("Your music");
    summary: @tr("Add the folders your music lives in. Melodia picks up changes to them on its own.");

    VerticalLayout {
        padding: Theme.pad-md;
        spacing: Theme.pad-sm;

        // Three states, and the scan wins: it is the only one that is still moving.
        if LibrarySettings.scanning: ScanProgress { }
        if !LibrarySettings.scanning && LibrarySettings.folders.length > 0: Text {
            text: @tr("{n} folder in your library" | "{n} folders in your library"
                      % LibrarySettings.folders.length);
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
        // Same copy the Library Folders card shows for the same state.
        if !LibrarySettings.scanning && LibrarySettings.folders.length == 0: Text {
            text: @tr("Add a folder to scan for music files.");
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        // Its own line rather than the button's label, which doesn't elide and would carry a long
        // path past the card's edge.
        if Onboarding.suggested-folder != "": HorizontalLayout {
            spacing: Theme.pad-xs;
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "folder";
                    icon-size: 14px;
                    icon-color: Theme.subtext0;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: @tr("Your Music folder: {}", Onboarding.suggested-folder);
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: Theme.pad-sm;
            padding-top: Theme.pad-sm;

            if Onboarding.suggested-folder != "": SectionButton {
                label: @tr("Add Music Folder");
                icon: "library_music";
                button-enabled: !LibrarySettings.scanning;
                clicked => { Onboarding.add-suggested-folder(); }
            }
            SectionButton {
                label: Onboarding.suggested-folder != "" ? @tr("Choose Another Folder") : @tr("Add Folder");
                icon: "create_new_folder";
                // The Library tab's own callback, so the picker is parented and the scan is queued
                // exactly as it is there.
                button-enabled: !LibrarySettings.scanning;
                primary: false;
                clicked => { LibrarySettings.add-folder(); }
            }
        }
    }
}
