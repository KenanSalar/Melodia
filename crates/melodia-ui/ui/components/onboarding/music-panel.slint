import { Theme } from "../../theme.slint";
import { LibrarySettings } from "../../globals/library-settings.slint";
import { ProgressBar } from "../settings/progress-bar.slint";
import { SectionButton } from "../settings/section-button.slint";

// Step 2, and not a question: `tasks::first_launch` adds the Music folder and starts a scan on its
// own, so the panel reports whichever of the three states it finds rather than asking. On the
// install where the auto-add found nothing, this panel is the reason the card exists at all.
export component OnboardingMusicPanel inherits VerticalLayout {
    min-width: 0px;
    spacing: Theme.pad-sm;

    Text {
        text: @tr("Your music");
        font-size: Theme.font-size-lg;
        font-weight: 700;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        text: @tr("Melodia watches your Music folder and picks up changes on its own.");
        font-size: Theme.font-size-sm;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    // Three states, and the scan wins: it is the only one that is still moving.
    if LibrarySettings.scanning: VerticalLayout {
        spacing: Theme.pad-sm;
        padding-top: Theme.pad-sm;
        ProgressBar {
            value: LibrarySettings.scan-progress;
        }
        Text {
            text: LibrarySettings.scanning-file != ""
                ? @tr("{} / {} files · {}",
                      LibrarySettings.scanned-count,
                      LibrarySettings.total-count,
                      LibrarySettings.scanning-file)
                : @tr("{} / {} files",
                      LibrarySettings.scanned-count,
                      LibrarySettings.total-count);
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
    }
    if !LibrarySettings.scanning && LibrarySettings.folders.length > 0: Text {
        text: @tr("{n} folder in your library" | "{n} folders in your library"
                  % LibrarySettings.folders.length);
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        overflow: elide;
    }
    // The silent-and-empty install. Same copy the Library Folders card shows for the same state.
    if !LibrarySettings.scanning && LibrarySettings.folders.length == 0: Text {
        text: @tr("Add a folder to scan for music files.");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: start;
        padding-top: Theme.pad-sm;
        SectionButton {
            label: @tr("Add Folder");
            icon: "create_new_folder";
            // The Library tab's own callback, so the picker is parented and the scan is queued
            // exactly as it is there.
            button-enabled: !LibrarySettings.scanning;
            primary: false;
            clicked => { LibrarySettings.add-folder(); }
        }
    }
}
