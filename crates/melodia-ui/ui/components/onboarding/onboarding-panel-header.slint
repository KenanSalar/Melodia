import { Theme } from "../../theme.slint";

// The heading and summary every step of the welcome card opens with, shared so the three can't
// drift into different weights and read as different surfaces.
export component OnboardingPanelHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> summary;

    min-width: 0px;
    spacing: Theme.pad-sm;

    Text {
        text: root.title;
        font-size: Theme.font-size-lg;
        font-weight: 700;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        text: root.summary;
        font-size: Theme.font-size-sm;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
