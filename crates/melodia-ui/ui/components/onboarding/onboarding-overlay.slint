import { Theme } from "../../theme.slint";
import { Onboarding } from "../../globals/onboarding.slint";
import { IconButton } from "../icon-button.slint";
import { SectionButton } from "../settings/section-button.slint";
import { OnboardingAppearancePanel } from "appearance-panel.slint";
import { OnboardingMusicPanel } from "music-panel.slint";
import { OnboardingFeaturesPanel } from "features-panel.slint";

// The first-run card, on `DialogOverlay`'s backdrop and card treatment, with a step index and a
// footer that doesn't close on Next.
//
// No `changed` handler watching anything outside the branch (the root `CLAUDE.md`), which rules
// out `TabBar`, `SearchBar`, `GridColumnsSync`, `FilterThrottle` and `FocusLossWatcher` here.
// `IconButton`'s `Tooltip` tracks only its own hover, so it may stay.
export component OnboardingOverlay inherits Rectangle {
    width: 100%;
    height: 100%;

    private property <float> t: Onboarding.open ? 1.0 : 0.0;
    animate t { duration: Theme.dur-fast; easing: ease-out; }
    // `DialogOverlay`'s bias, for its reason.
    private property <float> card-t: min(1.0, root.t * 1.5);

    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45 * root.t);
    }
    TouchArea {
        width: 100%;
        height: 100%;
        enabled: Onboarding.open;
        mouse-cursor: pointer;
        clicked => { Onboarding.dismiss(); }
    }

    card := Rectangle {
        // So the feature rows' copy doesn't wrap at every locale.
        property <length> max-w: 560px;

        width: min(self.max-w, max(360px, parent.width - 96px));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1.0 - root.card-t) * 12px;
        // Uncapped, for `DialogOverlay`'s reason: a panel outgrowing a short window owes a
        // scroller, not a cap.
        height: layout.preferred-height;
        background: Theme.surface0;
        // `surface2`, `Theme.border` being `surface0` itself and so invisible on this fill.
        border-color: Theme.surface2;
        border-width: 1px;
        border-radius: Theme.radius-lg;
        opacity: root.card-t;
        visible: root.card-t > 0.01;

        // Keeps a card click from reaching the backdrop's dismiss.
        TouchArea {
            width: 100%;
            height: 100%;
            enabled: Onboarding.open;
            clicked => { }
        }

        close-button := IconButton {
            x: parent.width - self.width - Theme.pad-sm;
            y: Theme.pad-sm;
            icon: "close";
            icon-size: 18px;
            diameter: 32px;
            button-enabled: Onboarding.open;
            tooltip-text: @tr("Close");
            clicked => { Onboarding.dismiss(); }
        }

        layout := VerticalLayout {
            padding: Theme.pad-lg;
            spacing: Theme.pad-md;

            Text {
                // Translators: Melodia is the product name and stays as is
                text: @tr("Welcome to Melodia");
                font-size: Theme.hero-title-size;
                font-weight: 700;
                color: Theme.text;
                // The default `clip` scissors a `Text` at its line box, shorter than the ink.
                overflow: elide;
            }

            // Hand-drawn rather than a `TabBar`, which carries a change tracker. The literal is
            // pinned against `step-count` by `ui::onboarding::tests`.
            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: start;
                for i in [0, 1, 2]: Rectangle {
                    width: i == Onboarding.step ? 20px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: i == Onboarding.step ? Theme.accent : Theme.surface2;
                    animate width, background { duration: Theme.dur-fast; easing: ease-out; enabled: !Theme.recoloring; }
                }
            }

            // The library first, nothing else filling it.
            if Onboarding.step == 0: OnboardingMusicPanel { }
            if Onboarding.step == 1: OnboardingAppearancePanel { }
            if Onboarding.step == 2: OnboardingFeaturesPanel { }

            HorizontalLayout {
                spacing: Theme.pad-sm;
                padding-top: Theme.pad-sm;

                // Only while there is something left to skip; on the last panel Done says it.
                if Onboarding.step < Onboarding.step-count - 1: SectionButton {
                    label: @tr("Skip");
                    icon: "";
                    primary: false;
                    button-enabled: Onboarding.open;
                    clicked => { Onboarding.dismiss(); }
                }

                Rectangle { horizontal-stretch: 1; }

                if Onboarding.step > 0: SectionButton {
                    label: @tr("Back");
                    icon: "";
                    primary: false;
                    button-enabled: Onboarding.open;
                    clicked => { Onboarding.advance(-1); }
                }
                SectionButton {
                    label: Onboarding.step < Onboarding.step-count - 1 ? @tr("Next") : @tr("Done");
                    icon: "";
                    primary: true;
                    button-enabled: Onboarding.open;
                    clicked => {
                        if (Onboarding.step < Onboarding.step-count - 1) {
                            Onboarding.advance(1);
                        } else {
                            Onboarding.dismiss();
                        }
                    }
                }
            }
        }
    }
}
