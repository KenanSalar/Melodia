import { Theme } from "../../theme.slint";
import { Onboarding } from "../../globals/onboarding.slint";
import { SectionButton } from "../settings/section-button.slint";
import { DialogHeader } from "../dialog/dialog-header.slint";
import { DialogScrollPane } from "../dialog/dialog-scroll-pane.slint";
import { ModalCard } from "../dialog/modal-card.slint";
import { OnboardingAppearancePanel } from "appearance-panel.slint";
import { OnboardingMusicPanel } from "music-panel.slint";
import { OnboardingFeaturesPanel } from "features-panel.slint";

// The first-run card, laid out as the duplicate finder is: a header, the step dots over a well
// holding the step's card, and a footer that doesn't close on Next.
//
// No `changed` handler watching anything outside the branch: the branch drops on close, so such a
// tracker survives the first open and panics on the second. That rules out `TabBar`, `SearchBar`,
// `GridColumnsSync`, `FilterThrottle` and `FocusLossWatcher` here.
// A `Tooltip`, the accent dots', tracks only its own hover, so it may stay.
export component OnboardingOverlay inherits Rectangle {
    width: 100%;
    height: 100%;

    private property <float> t: Onboarding.open ? 1.0 : 0.0;
    animate t { duration: Theme.dur-fast; easing: ease-out; }

    // `DialogOverlay`'s eased step height, floor and transition, for its reasons. Rust resets the
    // step before the branch mounts, so the card opens at rest.
    property <length> eased-height: layout.preferred-height;
    states [
        music when Onboarding.step == 0: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
        appearance when Onboarding.step == 1: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
        features when Onboarding.step == 2: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
    ]

    frame := ModalCard {
        t: root.t;
        interactive: Onboarding.open;
        // So the feature rows' copy doesn't wrap at every locale.
        max-card-width: 560px;
        card-height: min(max(root.eased-height, layout.min-height), self.height-cap);
        backdrop-clicked => { Onboarding.dismiss(); }

        layout := VerticalLayout {
            x: 0px;
            y: 0px;
            width: frame.card-width;
            height: frame.card-height;
            padding: Theme.pad-lg;
            spacing: Theme.pad-md;

            DialogHeader {
                // Translators: Melodia is the product name and stays as is
                title: @tr("Welcome to Melodia");
                message: @tr("Three quick steps to set Melodia up. You can change any of it later in Settings.");
            }

            // Hand-drawn rather than a `TabBar`, which carries a change tracker. The literal is
            // pinned against `step-count` by `ui::onboarding::tests`.
            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: start;
                for i in [0, 1, 2]: Rectangle {
                    width: i == Onboarding.step ? 20px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: i == Onboarding.step ? Theme.accent : Theme.surface2;
                    animate width, background { duration: Theme.dur-fast; easing: ease-out; enabled: !Theme.recoloring; }
                }
            }

            // The card's scroller, so a step taller than a short window scrolls instead of pushing
            // the footer off the card. Inset as the duplicate finder's well is.
            Rectangle {
                min-height: 96px;
                preferred-height: pane.content-height + 2 * Theme.pad-xs;
                vertical-stretch: 1;
                background: Theme.base;
                border-radius: Theme.radius-lg;

                pane := DialogScrollPane {
                    x: Theme.pad-md;
                    y: Theme.pad-xs;
                    width: parent.width - Theme.pad-md - Theme.pad-xs;
                    height: parent.height - 2 * Theme.pad-xs;

                    // A step's card keeps its height while the card eases taller than it.
                    VerticalLayout {
                        alignment: start;
                        padding-top: Theme.pad-sm;
                        padding-bottom: Theme.pad-sm;

                        // The library first, nothing else filling it.
                        if Onboarding.step == 0: OnboardingMusicPanel { }
                        if Onboarding.step == 1: OnboardingAppearancePanel { }
                        if Onboarding.step == 2: OnboardingFeaturesPanel { }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.pad-sm;
                padding-top: Theme.pad-sm;

                // Only while there is something left to skip; on the last panel Done says it.
                if Onboarding.step < Onboarding.step-count - 1: SectionButton {
                    label: @tr("Skip");
                    icon: "";
                    primary: false;
                    button-enabled: Onboarding.open;
                    clicked => { Onboarding.dismiss(); }
                }

                Rectangle { horizontal-stretch: 1; }

                if Onboarding.step > 0: SectionButton {
                    label: @tr("Back");
                    icon: "";
                    primary: false;
                    button-enabled: Onboarding.open;
                    clicked => { Onboarding.advance(-1); }
                }
                SectionButton {
                    label: Onboarding.step < Onboarding.step-count - 1 ? @tr("Next") : @tr("Done");
                    icon: "";
                    primary: true;
                    button-enabled: Onboarding.open;
                    clicked => {
                        if (Onboarding.step < Onboarding.step-count - 1) {
                            Onboarding.advance(1);
                        } else {
                            Onboarding.dismiss();
                        }
                    }
                }
            }
        }
    }
}
