import { Theme } from "../theme.slint";
import { DragRegion, WindowChrome } from "../globals/shell.slint";
import { MacOsTitleBarCluster } from "macos-titlebar-cluster.slint";
import { CaptionStyle, MinimizeCaption, MaximizeCaption, CloseCaption } from "caption-buttons.slint";

// The brand on one side, a drag region in the middle, the decoration cluster opposite.
//
// **Slint tracks only the drag region's hover**; Rust takes the press at the winit layer, where a
// double press toggles maximize too (`desktop-shell.md`). **The buttons are the outer layout's own
// children, not a wrapper's**: a Rectangle-rooted wrapper of conditional layout children reports
// 0 × 0.
export component CustomTitleBar inherits Rectangle {
    // A fixed slot: a plain `height` on a layout child claims the window's whole height.
    min-height: 32px;
    max-height: 32px;
    vertical-stretch: 0;
    background: Theme.mantle;

    property <bool> captions-left: Theme.titlebar-button-side == 1;
    property <bool> mac-style: Theme.titlebar-button-style == 1;
    property <CaptionStyle> caption-style: Theme.titlebar-button-style == 2
        ? CaptionStyle.kde
        : CaptionStyle.standard;
    // The pad lies under the resize band, which a maximized window lacks, so a throw at the screen
    // corner still lands on close.
    property <length> caption-edge-pad:
        root.caption-style == CaptionStyle.kde && !WindowChrome.is-maximized
            ? Theme.kde-caption-edge-pad
            : 0px;

    HorizontalLayout {
        spacing: 0;
        alignment: stretch;
        // The cluster side is flush, so close sits at the corner, but for the gap Breeze keeps.
        padding-left: root.captions-left ? root.caption-edge-pad : 12px;
        padding-right: root.captions-left ? 12px : root.caption-edge-pad;

        if root.captions-left && root.mac-style: MacOsTitleBarCluster {
            maximize => { WindowChrome.toggle-maximize(); }
        }

        // Close at the corner, so clicking the corner still closes.
        if root.captions-left && !root.mac-style: CloseCaption { style: root.caption-style; }
        if root.captions-left && !root.mac-style: MaximizeCaption { style: root.caption-style; }
        if root.captions-left && !root.mac-style: MinimizeCaption { style: root.caption-style; }

        // The brand and the middle stretch, so everything but the cluster drags.
        drag-region := TouchArea {
            horizontal-stretch: 1;
            mouse-cursor: default;
            changed has-hover => {
                WindowChrome.drag-region-changed(
                    self.has-hover ? DragRegion.titlebar : DragRegion.none);
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: stretch;
                cross-axis-alignment: center;

                // The spacer before or after the brand pins it to its side.
                if root.captions-left: Rectangle { horizontal-stretch: 1; }

                Image {
                    horizontal-stretch: 0;
                    source: @image-url("../assets/icons/logo-without-background.svg");
                    // The asset's gradient is Mocha's. `colorize` composites a brush through its
                    // alpha, so the mark tracks the palette and the ramp survives.
                    colorize: Theme.brand-mark;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }

                // Regular weight, as an OS sets its caption: Medium beside the native caption's
                // Segoe UI reads as bold once focus darkens the ink.
                Text {
                    horizontal-stretch: 0;
                    text: "Melodia";
                    color: Theme.window-focused ? Theme.text : Theme.overlay2;
                    font-size: 12px;
                }

                if !root.captions-left: Rectangle { horizontal-stretch: 1; }
            }
        }

        if !root.captions-left && root.mac-style: MacOsTitleBarCluster {
            maximize => { WindowChrome.toggle-maximize(); }
        }

        // Windows and KDE order, close at the corner.
        if !root.captions-left && !root.mac-style: MinimizeCaption { style: root.caption-style; }
        if !root.captions-left && !root.mac-style: MaximizeCaption { style: root.caption-style; }
        if !root.captions-left && !root.mac-style: CloseCaption { style: root.caption-style; }
    }
}
