import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { HeroBlurBackdrop } from "../hero-blur-backdrop.slint";
import { AuroraBackdrop } from "../aurora-backdrop.slint";

// The two backdrop stacks as one mount, for the hosts painting off the `HeroBackdrop` tier — the
// tier-bound half the two leaf components may not be, their colours staying defaulted `in property`s
// so one pair can serve this tier *and* Now Playing's `Player.np-*`.
//
// **Only the live arm is mounted**, safe because the condition is a process constant:
// `Theme.aurora-backdrop` is written once by `boot::ui_setup::apply_backdrop_style`, before
// `install_views` and before `app.show()`. Painting the loser transparent is not the free option it
// reads as — `Brush::is_transparent()` answers `false` for *every* gradient whatever its stop
// alphas, so femtovg tessellates the path and fills the whole surface anyway.
//
// `shown` survives the gate as the host's own question — for `LibraryTabBand`, whether the band is
// painting a hero at all — and the surviving stack drains to its idle colours through it, which is
// why each `shown: false` arm stays a gradient of the same shape.
export component HeroBackdropStack inherits Rectangle {
    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;
    in property <bool> shown: true;

    // Named once, because both terms below read it and a second spelling of the condition can
    // invert on its own.
    property <bool> aurora-shown: Theme.aurora-backdrop;

    if !root.aurora-shown: HeroBlurBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        floor-start: HeroBackdrop.floor-start;
        floor-end: HeroBackdrop.floor-end;
        scrim: HeroBackdrop.scrim;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
        shown: root.shown;
    }

    if root.aurora-shown: AuroraBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        base-start: HeroBackdrop.floor-start;
        base-end: HeroBackdrop.floor-end;
        tint-1: HeroBackdrop.tint-1;
        tint-2: HeroBackdrop.tint-2;
        tint-3: HeroBackdrop.tint-3;
        dither: HeroBackdrop.dither;
        shown: root.shown;
    }
}
