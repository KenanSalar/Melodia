import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { NavEnterFrom } from "../../globals/nav.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { HeroChipStrip } from "../hero-chip-strip.slint";
import { IconButton } from "../icon-button.slint";
import { MaterialIcon } from "../material-icon.slint";
import { HeroBackdropStack } from "hero-backdrop-stack.slint";
import { TabSearchHeader } from "tab-search-header.slint";

// My Library's pinned band: a flat pane carrying the tabs, the filter box and the tab's count,
// which morphs into a detail's hero while one is open. `MosaicTabHero`'s sibling
// (`ui-patterns.md`); what is the band's own is the morph, the palette it drives and the back slot.
export component LibraryTabBand inherits Rectangle {
    in property <[string]> tab-labels;
    in property <[string]> tab-icons;
    // Two-way: the bar writes it on every pick (`slint-pitfalls.md`'s orphaned binding).
    in-out property <int> tab-idx;

    in-out property <string> filter;
    in property <string> filter-placeholder;
    in property <int> blur-tick;
    // The page's question: Radio hides it over a station.
    in property <bool> search-shown: true;

    // In place of a page title, the tabs naming the page. Empty while the count is unfetched,
    // the host's guard: a bare `-1` reads as "-1 albums".
    in property <string> count-text;

    in property <bool> detail-open;
    in property <string> title;
    // Inside the title block rather than a row of its own, which leaves room for a second chip row.
    in property <string> subtitle;
    in property <bool> title-badge;

    in property <string> artwork-path;
    in property <image> cover;
    in property <bool> circular-artwork: false;
    in property <string> fallback-icon: "music-note";
    // A station's initials and favicon size, so it reads as it did on its card.
    in property <string> fallback-text;
    in property <length> native-size: 0px;
    // The hero's `placeholder` tier, never `Theme.accent`: only Rust knows which backdrop is under.
    in property <brush> tile-bg: HeroBackdrop.placeholder.transparentize(0.85);
    in property <brush> tile-icon-color: HeroBackdrop.placeholder;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    // Off the host's hidden copy of the row, the drawn one no longer reporting it once its labels
    // close.
    in property <length> pill-natural-w;

    callback back-clicked();
    // Fires after the direction and the arming are settled, so a host handler calling into Rust
    // can't run ahead of them.
    callback tab-selected(int);
    callback search-edited(string);

    // Once the collapse has finished, the `Dialog.closed()` shape: the hero's facts have to
    // outlive the detail id. A re-open cancels it.
    callback hero-collapsed();

    // Seeded by the binding and written by the handler, a bound animation re-basing on every dirty
    // (`slint-pitfalls.md`). The seed lands a page mounted with a detail open at hero height.
    property <float> hero-t: root.detail-open ? 1.0 : 0.0;
    changed detail-open => {
        self.hero-t = self.detail-open ? 1.0 : 0.0;
        collapse.running = !self.detail-open;
    }
    // One duration, two curves. The collapse front-loads its travel, the count line's alpha being
    // biased into the second half; the entry's curve read as a snap going in. The duration stays,
    // the collapse `Timer` and the body's `ViewTransition` both being `dur-spatial`.
    animate hero-t {
        duration: Theme.dur-spatial;
        easing: root.detail-open
            ? cubic-bezier(0.4, 0, 0.2, 1)
            : cubic-bezier(0.2, 0, 0, 1);
    }

    // Armed by the handler rather than gated on a bool, so a re-open genuinely cancels it.
    collapse := Timer {
        interval: Theme.dur-spatial;
        running: false;
        triggered => {
            self.running = false;
            root.hero-collapsed();
        }
    }

    // One frame longer at each end than `detail-open`, and at the start than `hero-t > 0`; both
    // were bugs. Only tracker-free pieces ride it: the chip strip's layout tracker is why the
    // meta column has no `if` (`slint-pitfalls.md`).
    property <bool> hero-shown: root.detail-open || root.hero-t > 0;

    // The body slides only while this is false. Not `hero-t > 0`, which is false on a drill-in's
    // first frame (`ui-patterns.md`).
    out property <bool> morphing: root.hero-t != (root.detail-open ? 1.0 : 0.0);

    // The bar's four brushes cross from `Theme.*` to `HeroBackdrop` tiers through a `states`
    // transition, the hero half landing late off the decode (`slint-pitfalls.md`).
    property <brush> label-brush: Theme.text;
    property <brush> active-brush: Theme.accent;
    property <brush> hover-brush: Theme.surface0;
    property <brush> divider-brush: Theme.surface1;

    // Mirrored so a late solve eases. Each falls back on `detail-open`, not `hero-shown`, so none
    // eases out of a held tier (`ui-patterns.md`).
    property <brush> hero-label: root.detail-open ? HeroBackdrop.on-backdrop : Theme.text;
    property <brush> hero-active: root.detail-open ? HeroBackdrop.chrome : Theme.accent;
    property <brush> hero-hover:
        root.detail-open ? HeroBackdrop.on-backdrop.transparentize(0.88) : Theme.surface0;
    property <brush> hero-divider: root.detail-open ? HeroBackdrop.tile-edge : Theme.surface1;
    // Only the idle half reads the palette a fade steps.
    animate hero-label, hero-active, hero-hover, hero-divider {
        duration: Theme.dur-med;
        easing: ease-in-out;
        enabled: root.detail-open || !Theme.recoloring;
    }

    // Split `in` / `out` to take the morph's two curves.
    states [
        hero when root.detail-open: {
            label-brush: root.hero-label;
            active-brush: root.hero-active;
            hover-brush: root.hero-hover;
            divider-brush: root.hero-divider;
            in {
                animate label-brush, active-brush, hover-brush, divider-brush {
                    duration: Theme.dur-spatial;
                    easing: cubic-bezier(0.4, 0, 0.2, 1);
                }
            }
            out {
                animate label-brush, active-brush, hover-brush, divider-brush {
                    duration: Theme.dur-spatial;
                    easing: cubic-bezier(0.2, 0, 0, 1);
                }
            }
        }
    ]

    // Mirrored, seeded at the header row's floor and re-read by the mount `Timer`
    // (`ui-patterns.md`'s `TabBar`).
    property <length> page-w: 2 * Theme.pad-lg + header.row-floor;
    changed width => { self.page-w = self.width; }

    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            self.running = false;
        }
    }

    // The trailing gap is folded into the slot so the row can carry `spacing: 0`. A stepped gap
    // drops a `pad-md` on the frame the slot unmounts, the last frame of a collapse, and the tab
    // bar jumps left.
    property <length> back-slot-w:
        (root.pill-h + Theme.pad-sm + Theme.pad-md) * root.hero-t;

    property <length> pill-h: 32px;
    property <length> meta-row-h: root.pill-h + 2 * Theme.pad-xs;

    property <length> compact-h:
        2 * Theme.pad-lg + header.row-h + Theme.pad-md + root.meta-row-h;
    // `MosaicTabHero`'s formula, so the two bands agree on what a hero is.
    property <length> hero-h:
        2 * Theme.pad-lg + header.row-h + Theme.pad-md + Theme.hero-artwork;

    // Never a bound `height`, and clipped because of it (`slint-pitfalls.md`).
    min-height: root.compact-h;
    preferred-height: root.compact-h + (root.hero-h - root.compact-h) * root.hero-t;
    max-height: root.hero-h;
    clip: true;
    vertical-stretch: 0;

    // Forwarded under the names `my-library-view.slint` reads. Whether the body may move is the
    // morph's question, which the page answers on `slide` (#45).
    out property <NavEnterFrom> tab-enter-from <=> header.tab-enter-from;
    out property <bool> tab-anim-armed <=> header.tab-anim-armed;

    out property <length> tip-x:
        header.absolute-position.x - root.absolute-position.x + header.tip-x;
    out property <length> tip-y:
        header.absolute-position.y - root.absolute-position.y + header.tip-y;
    out property <length> tip-w <=> header.tip-w;
    out property <length> tip-h <=> header.tip-h;
    out property <string> tip-label <=> header.tip-label;
    out property <bool> tip-visible <=> header.tip-visible;

    // `shown` on `detail-open`, so nothing eases from a tier the band wasn't painting. With no
    // blur image the gradient floor shows through, which is how Genre Detail paints.
    HeroBackdropStack {
        x: 0; y: 0;
        width: 100%; height: 100%;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
        shown: root.detail-open;
    }

    // Alpha in the brush, `opacity` costing a layer on a full-bleed element for the whole morph.
    // `base`, not `mantle`: nothing separates the band from the grid under it.
    idle-pane := Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        background: Theme.base.with-alpha(1.0 - root.hero-t);
    }

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        // `lead-w` takes the back slot out of the bar's budget.
        header := TabSearchHeader {
            tab-labels: root.tab-labels;
            tab-icons: root.tab-icons;
            tab-idx <=> root.tab-idx;
            avail-w: root.page-w - 2 * Theme.pad-lg;
            lead-w: root.back-slot-w;

            filter <=> root.filter;
            filter-placeholder: root.filter-placeholder;
            blur-tick: root.blur-tick;
            search-shown: root.search-shown;

            label-color: root.label-brush;
            active-color: root.active-brush;
            hover-fill: root.hover-brush;
            divider-color: root.divider-brush;

            tab-selected(i) => { root.tab-selected(i); }
            search-edited(t) => { root.search-edited(t); }

            // Clipped rather than faded on width alone: the disc is incompressible and would
            // draw over the first tab.
            if root.hero-shown: Rectangle {
                width: root.back-slot-w;
                clip: true;
                IconButton {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    icon: "arrow_back";
                    // Scales with its slot; pinned, the clip cuts a straight edge through it.
                    icon-size: 20px * root.hero-t;
                    diameter: root.pill-h * root.hero-t;
                    // `hover-bg` named too: its default is an opaque `surface0`, grey over the blur.
                    idle-bg: HeroBackdrop.disc-fill;
                    hover-bg: HeroBackdrop.disc-hover;
                    idle-fg: HeroBackdrop.chrome;
                    on-backdrop: true;
                    // Biased off the morph: the size rides `hero-t` too, so a plain alpha puts its
                    // presence at `hero-t` squared and the entry pops at the end. Through `fade`,
                    // `IconButton`'s root having children (`need_layer`).
                    fade: clamp(root.hero-t * 2.0, 0.0, 1.0);
                    clicked => { root.back-clicked(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.pad-lg;

            if root.hero-shown: VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;

                ArtworkImage {
                    artwork-path: root.artwork-path;
                    cover: root.cover;
                    // The host can't withhold `cover` (`ui-patterns.md`'s `has-cover`).
                    has-cover: root.artwork-path != "";
                    tile-size: Theme.hero-artwork;
                    tile-radius: root.circular-artwork
                        ? Theme.hero-artwork / 2
                        : Theme.radius-lg;
                    fallback-icon: root.fallback-icon;
                    fallback-text: root.fallback-text;
                    native-size: root.native-size;
                    tile-bg: root.tile-bg;
                    tile-icon-color: root.tile-icon-color;
                    // Through `fade`, `ArtworkImage`'s root having children (`need_layer`).
                    fade: root.hero-t;
                }
            }

            // No `if`: the chip strip's tracker may not be dropped. Idle it is an empty strip and
            // a spacer.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: stretch;
                spacing: Theme.pad-xs;
                // Reserved for the floating pill row, so the chip strip's two-row slack holds.
                padding-bottom: root.pill-h + Theme.pad-xs;

                // Alpha in the brushes, a faded layer cropping Arabic marks (`slint-pitfalls.md`).
                if root.hero-shown: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.pad-xs;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.pad-sm;
                        alignment: start;

                        if root.title-badge: MaterialIcon {
                            cross-axis-self-alignment: center;
                            name: "auto_awesome";
                            icon-size: 22px;
                            // Multiplied, not set: `chrome` carries its own alpha on the aurora.
                            icon-color: HeroBackdrop.chrome.transparentize(1.0 - root.hero-t);
                            filled: true;
                        }

                        Text {
                            text: "\u{200e}" + root.title;
                            color: HeroBackdrop.on-backdrop.transparentize(1.0 - root.hero-t);
                            font-size: Theme.hero-title-size;
                            font-weight: Theme.page-title-weight;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }

                    // An optical nudge, tuned by eye: the title's larger side bearing puts its first
                    // stem further in, so the smaller line reads as hanging left. A padding rather
                    // than an `x`, which would drop the child from its parent's layout info.
                    if root.subtitle != "": HorizontalLayout {
                        vertical-stretch: 0;
                        padding-left: 1px;

                        Text {
                            text: "\u{200e}" + root.subtitle;
                            color: HeroBackdrop.on-backdrop.transparentize(1.0 - root.hero-t);
                            font-size: Theme.font-size-md;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                }

                // Emptied by the collapse's teardown, the chips living on a shared global.
                HeroChipStrip { fade: root.hero-t; }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // Anchored to the compact band's floor, where the pill row follows the current one. It leaves
    // downward, the one axis nothing arrives on, and comes back sliding in; `detail-open` tells
    // the two apart. Both ride `hero-t`, a `states` entry flashing the count on a page mounted
    // into a detail. A bounded width as well as elide, per the faked-placeholder pitfall.
    property <length> count-slide: 32px;
    property <length> count-drop: 12px;
    property <float> count-t: clamp(root.hero-t * 2.0, 0.0, 1.0);
    property <length> count-dy: root.detail-open ? root.count-drop * root.count-t : 0px;

    Text {
        x: Theme.pad-lg - (root.detail-open ? 0px : root.count-slide * root.hero-t);
        y: root.compact-h - Theme.pad-lg - root.pill-h + root.count-dy;
        width: root.page-w - 2 * Theme.pad-lg - pills.width - Theme.pad-md;
        height: root.pill-h;
        text: "\u{200e}" + root.count-text;
        color: Theme.text.with-alpha(1.0 - root.count-t);
        font-size: Theme.page-title-size;
        font-weight: Theme.page-title-weight;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    // The room beside the cover, keyed on `detail-open` so it moves once per morph. Short of it
    // the host's labelled pills close onto their glyphs, latched like the tab bar against a
    // jittered resize drag.
    property <length> pill-room: root.page-w - 2 * Theme.pad-lg
        - (root.detail-open ? Theme.hero-artwork + Theme.pad-lg : 0px);
    property <length> pill-hysteresis: 24px;
    property <bool> pill-latched: false;
    property <bool> pills-short:
        root.pill-room < root.pill-natural-w + (root.pill-latched ? root.pill-hysteresis : 0px);

    // `TabBar`'s `compact-t` shape: written, not bound, `pills-short` reading the page's width.
    out property <float> pills-compact-t: root.pills-short ? 1.0 : 0.0;
    changed pills-short => {
        root.pill-latched = root.pills-short;
        root.pills-compact-t = root.pills-short ? 1.0 : 0.0;
    }
    // The tab bar's curve. Landed rather than eased while the band morphs, and in its first
    // moments, which are it learning its width rather than a change.
    animate pills-compact-t {
        duration: 350ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
        enabled: root.pills-eased && !root.morphing;
    }
    property <bool> pills-eased: false;
    Timer {
        interval: 100ms;
        triggered => {
            root.pills-eased = true;
            self.running = false;
        }
    }

    // A floating slot, Slint allowing one `@children` and the two states wanting it in different
    // places. A layout, a bare `Rectangle` reporting 0×0 over `if` children. Spans only
    // `pill-room`, so a row too wide runs off under the clip rather than over the artwork.
    HorizontalLayout {
        x: root.page-w - Theme.pad-lg - root.pill-room;
        y: root.height - Theme.pad-lg - root.pill-h;
        width: root.pill-room;
        height: root.pill-h;
        alignment: end;

        pills := HorizontalLayout {
            @children
        }
    }
}
