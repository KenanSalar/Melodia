import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { NavEnterFrom } from "../../globals/nav.slint";
import { HeroChipStrip } from "../hero-chip-strip.slint";
import { HeroBackdropStack } from "hero-backdrop-stack.slint";
import { MosaicHeroTile } from "mosaic-hero-tile.slint";
import { TabSearchHeader } from "tab-search-header.slint";

// The pinned banner Favorites and Recently Played both wear. Data-agnostic because a component
// can't be parameterised over a global, the two pages' being distinct generated types (the wall
// Rust answers with `ui::detail_view::HeroSlots`).
export component MosaicTabHero inherits Rectangle {
    in property <[string]> tab-labels;
    in property <[string]> tab-icons;
    // Two-way: the bar writes it on every pick, which would detach a one-way binding.
    in-out property <int> tab-idx;

    in property <string> title;
    in property <string> filter-placeholder;
    // A sentence rather than a "0 tracks" chip. The host gates it, knowing the mounted tab and its
    // unfiltered count.
    in property <bool> show-empty-copy;
    in property <string> empty-copy;

    in property <int> mosaic-count;
    in property <image> mosaic-cover;
    in property <string> empty-glyph;
    in property <bool> empty-glyph-filled: false;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    in-out property <string> filter;
    in property <int> blur-tick;

    // Fires after the direction and arming have settled, so a host handler calling into Rust
    // can't run ahead of them.
    callback tab-selected(int);
    callback search-edited(string);

    // Mirrored, seeded at the header row's floor, as a wider seed draws tabs the panel can't seat,
    // and re-read by the mount `Timer`, `changed` not firing when the first layout lands on it.
    property <length> page-w: 2 * Theme.pad-lg + header.row-floor;
    changed width => { self.page-w = self.width; }

    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            self.running = false;
        }
    }

    // Derived, so growing the artwork or the bar can't leave the banner cropping itself.
    out property <length> hero-height:
        2 * Theme.pad-lg + header.row-h + Theme.pad-md + Theme.hero-artwork;

    // Mirrored so a late solve eases; it lands later here than on a detail, riding the mosaic
    // compose. A plain `animate` rather than `states`: this band never morphs.
    property <brush> hero-label: HeroBackdrop.on-backdrop;
    property <brush> hero-active: HeroBackdrop.chrome;
    property <brush> hero-hover: HeroBackdrop.on-backdrop.transparentize(0.88);
    property <brush> hero-divider: HeroBackdrop.tile-edge;
    animate hero-label, hero-active, hero-hover, hero-divider {
        duration: Theme.dur-med;
        easing: ease-in-out;
    }

    // Under the names the two curated pages read.
    out property <NavEnterFrom> tab-enter-from <=> header.tab-enter-from;
    out property <bool> tab-anim-armed <=> header.tab-anim-armed;

    out property <length> tip-x:
        header.absolute-position.x - root.absolute-position.x + header.tip-x;
    out property <length> tip-y:
        header.absolute-position.y - root.absolute-position.y + header.tip-y;
    out property <length> tip-w <=> header.tip-w;
    out property <length> tip-h <=> header.tip-h;
    out property <string> tip-label <=> header.tip-label;
    out property <bool> tip-visible <=> header.tip-visible;

    vertical-stretch: 0;
    height: root.hero-height;

    // Ungated: this band never stops painting a hero.
    HeroBackdropStack {
        x: 0; y: 0;
        width: 100%; height: 100%;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
    }

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Hero tiers through the mirrors, the bar being unable to ease a brush, and never
        // `Theme.*`: the accent has no contrast floor on a pinned band, where `chrome` clears 3:1.
        header := TabSearchHeader {
            tab-labels: root.tab-labels;
            tab-icons: root.tab-icons;
            tab-idx <=> root.tab-idx;
            avail-w: root.page-w - 2 * Theme.pad-lg;

            filter <=> root.filter;
            filter-placeholder: root.filter-placeholder;
            blur-tick: root.blur-tick;

            label-color: root.hero-label;
            active-color: root.hero-active;
            hover-fill: root.hero-hover;
            divider-color: root.hero-divider;

            tab-selected(i) => { root.tab-selected(i); }
            search-edited(t) => { root.search-edited(t); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.pad-lg;

            VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;

                MosaicHeroTile {
                    count: root.mosaic-count;
                    cover: root.mosaic-cover;
                    empty-glyph: root.empty-glyph;
                    empty-glyph-filled: root.empty-glyph-filled;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: stretch;
                spacing: Theme.pad-xs;

                Text {
                    vertical-stretch: 0;
                    text: "\u{200e}" + root.title;
                    // The mirror, not the tier: the title and the tab labels are one text tier.
                    color: root.hero-label;
                    font-size: Theme.hero-title-size;
                    font-weight: Theme.page-title-weight;
                    horizontal-alignment: left;
                    // The default `clip` scissors a `Text` at its line box, shorter than the ink.
                    overflow: elide;
                }

                // An empty tab publishes no chips and the line below takes over.
                HeroChipStrip { }

                if root.show-empty-copy: Text {
                    vertical-stretch: 0;
                    text: root.empty-copy;
                    color: HeroBackdrop.on-backdrop-muted;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: left;
                }

                Rectangle { vertical-stretch: 1; }

                // After the spacer, so the pills sit on the band's floor, the slack the chip
                // strip's two-row cap is measured against.
                @children
            }
        }
    }
}
