import { Theme } from "../../theme.slint";
import { NavEnterFrom } from "../../globals/nav.slint";
import { SearchBar } from "../search-bar.slint";
import { TabBar } from "../tab-bar.slint";

// The tab bar and the filter box sharing one row: the width budget dividing it, the slide
// direction and the tooltip anchor, held once for every page with tabs (`ui-patterns.md`'s
// `TabBar`). No string is spelled here.
export component TabSearchHeader inherits HorizontalLayout {
    in property <[string]> tab-labels;
    in property <[string]> tab-icons;
    // Two-way: the bar writes it on every pick (`slint-pitfalls.md`'s orphaned binding).
    in-out property <int> tab-idx;

    in-out property <string> filter;
    in property <string> filter-placeholder;
    in property <int> blur-tick;
    // Off where the content isn't rows to narrow (Radio's station page). The cell collapses rather
    // than unmounting, so `search.min-w` stays readable and the budget doesn't move.
    in property <bool> search-shown: true;

    // The host's mirror: a live `root.width` read feeding a child's size re-enters layout.
    in property <length> avail-w;
    // The leading slot's width with its trailing gap folded in, so the row can carry `spacing: 0`
    // and the inset can ease to zero.
    in property <length> lead-w: 0px;

    // Theme defaults for a flat page; the hero bands hand over `HeroBackdrop` tiers.
    in property <brush> label-color: Theme.text;
    in property <brush> active-color: Theme.accent;
    in property <brush> hover-fill: Theme.surface0;
    in property <brush> divider-color: Theme.surface1;

    // Fires after the direction and arming have settled, so a host handler calling into Rust
    // can't run ahead of them.
    callback tab-selected(int);
    callback search-edited(string);

    property <length> search-w-max: 220px;
    property <length> search-w-min: search.min-w;
    property <length> content-w: root.avail-w - root.lead-w;

    // The narrowest row seating the compact bar beside the widest box. A host seeds its width
    // mirror here, a wide seed drawing full tabs into a panel that can't seat them.
    out property <length> row-floor:
        bar.compact-w + 2 * Theme.pad-md + root.search-w-max;
    // The filter yields before the tabs do: tabs navigate, search only refines.
    out property <length> search-w: clamp(
        root.content-w - bar.compact-w - 2 * Theme.pad-md,
        root.search-w-min, root.search-w-max);
    out property <length> row-h: bar.height;

    // Past the compact bar beside the box's floor, the box folds to its glyph rather than drawing
    // past its cell. Latched across the bar's band against a jittered resize drag.
    property <length> fold-hysteresis: 24px;
    property <bool> fold-latched: false;
    property <bool> folds: root.search-shown
        && root.content-w < bar.compact-w + 2 * Theme.pad-md + root.search-w-min
            + (root.fold-latched ? root.fold-hysteresis : 0px);
    // Opened across the row, over the bar, while it holds focus or text; a pick clears the filter
    // anyway.
    property <bool> field-over-tabs: root.folds && (search.has-focus || root.filter != "");

    // `TabBar`'s `compact-t` shape: written, not bound, each verdict reading the row's width. The
    // bar's curve and length, so the row folds as one.
    property <float> fold-t: root.folds ? 1.0 : 0.0;
    property <float> open-t: root.field-over-tabs ? 1.0 : 0.0;
    changed folds => {
        root.fold-latched = root.folds;
        root.fold-t = root.folds ? 1.0 : 0.0;
    }
    changed field-over-tabs => { root.open-t = root.field-over-tabs ? 1.0 : 0.0; }
    animate fold-t, open-t {
        duration: 350ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
        enabled: root.eased;
    }
    // `TabBar`'s gate: it has to outlast the host's first `changed width`.
    property <bool> eased: false;
    Timer {
        interval: 100ms;
        triggered => {
            root.eased = true;
            self.running = false;
        }
    }

    // The glyph's square once folded, open or not, so opening never replays the bar's morph.
    property <length> box-w: root.search-w + (search.bar-height - root.search-w) * root.fold-t;

    // Off `bar.previous-index`, never a mirror: the cell writes `selected-index` before it emits.
    out property <NavEnterFrom> tab-enter-from: NavEnterFrom.right;
    // Starts `false` so a page's own entry isn't compounded with a slide into a diagonal; the
    // page's rebuild re-disarms it.
    out property <bool> tab-anim-armed: false;

    // Relative to this row; the host adds its own delta. Both axes carry the bar's offset inside
    // the row, a whole `lead-w` with a leading slot and zero on the hosts without one.
    out property <length> tip-x:
        bar.absolute-position.x - root.absolute-position.x + bar.tab-w * bar.hovered-idx;
    out property <length> tip-y: bar.absolute-position.y - root.absolute-position.y;
    out property <length> tip-w: bar.tab-w;
    out property <length> tip-h: bar.height;
    out property <string> tip-label: bar.hovered-label;
    out property <bool> tip-visible:
        bar.hovered-idx >= 0 && bar.compact && !root.field-over-tabs;

    vertical-stretch: 0;
    // Every gap belongs to a child, the leading slot's having to reach zero.
    spacing: 0px;

    @children

    // Shrunk under the opening field rather than unmounted, so the bar keeps its compact verdict.
    // A radius-less clip, so a scissor. The brushes fade with it through the inputs, the bar
    // easing floats and never a brush.
    Rectangle {
        clip: true;
        min-width: root.open-t > 0.0 ? 0px : bar.min-width;
        preferred-width: bar.preferred-width * (1.0 - root.open-t);
        max-width: bar.max-width * (1.0 - root.open-t);

        HorizontalLayout {
            bar := TabBar {
                labels: root.tab-labels;
                icons: root.tab-icons;
                avail-width: root.content-w - root.box-w - 2 * Theme.pad-md;
                selected-index <=> root.tab-idx;
                label-color: root.label-color.transparentize(root.open-t);
                active-color: root.active-color.transparentize(root.open-t);
                hover-fill: root.hover-fill.transparentize(root.open-t);
                divider-color: root.divider-color.transparentize(root.open-t);
                selected(i) => {
                    // Before the host's `if` re-evaluates next frame and mounts the new body.
                    root.tab-enter-from = i > bar.previous-index
                        ? NavEnterFrom.right
                        : NavEnterFrom.left;
                    root.tab-anim-armed = true;
                    root.tab-selected(i);
                }
            }
        }
    }

    // The budget's two `pad-md`s, as this cell's floor.
    Rectangle {
        horizontal-stretch: 1;
        min-width: 2 * Theme.pad-md;
    }

    // Padded to the bar's divider band, so the input centres on the labels' line.
    //
    // Collapsed through `visible`, never `clip`, which shaved the focus swell flat
    // (`slint-pitfalls.md`). An explicit `min-width` replaces the constraint the bar's bound width
    // would merge in. `box-w` still reserves while hidden, so the bar doesn't replay its morph.
    Rectangle {
        visible: root.search-shown;
        min-width: 0px;
        preferred-width: root.search-shown ? search.preferred-width : 0px;
        max-width: root.search-shown ? search.preferred-width : 0px;

        VerticalLayout {
            alignment: center;
            padding-bottom: Theme.pad-sm;
            search := SearchBar {
                fold-t: root.fold-t * (1.0 - root.open-t);
                input-width: root.search-w
                    + (root.content-w - 2 * Theme.pad-md - root.search-w) * root.open-t;
                text <=> root.filter;
                placeholder: root.filter-placeholder;
                blur-trigger: root.blur-tick;
                edited(t) => { root.search-edited(t); }
                // Folded, the cross also hands the row back to the tabs.
                cleared => {
                    if (root.folds) {
                        self.clear-input-focus();
                    }
                }
            }
        }
    }
}
