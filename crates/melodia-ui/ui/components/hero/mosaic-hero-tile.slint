import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { MaterialIcon } from "../material-icon.slint";

// The curated heroes' artwork square, drawing one composed collage rather than a live mosaic, so
// it matches the banner blur laid out from the same image. Every brush is a `HeroBackdrop` tier,
// never `Theme.*`: with no collage the tile sits on the dark floor, where a light theme's accent
// lands dark-on-dark.
export component MosaicHeroTile inherits Rectangle {
    // Zero is an empty set; a positive count with no cover is a set without artwork, and the two
    // draw different glyphs.
    in property <int> count;
    in property <image> cover;
    // The page's own sidebar glyph.
    in property <string> empty-glyph;
    in property <bool> empty-glyph-filled: false;

    // The cover decides the arm, not `count`.
    property <bool> shows-cover: root.cover.width > 0;

    width: Theme.hero-artwork;
    height: Theme.hero-artwork;
    border-radius: Theme.radius-lg;
    clip: true;

    // Square inside the clip, the corner's only antialiased pass, as in `ArtworkImage`.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.shows-cover
            ? HeroBackdrop.floor-start
            : HeroBackdrop.placeholder.transparentize(0.85);
    }

    if root.shows-cover: Image {
        width: 100%;
        height: 100%;
        source: root.cover;
        image-fit: ImageFit.cover;
    }

    if !root.shows-cover: MaterialIcon {
        name: root.count == 0 ? root.empty-glyph : "music_note";
        filled: root.count == 0 && root.empty-glyph-filled;
        icon-size: 56px;
        icon-color: HeroBackdrop.placeholder;
    }
}
