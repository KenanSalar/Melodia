import { Theme } from "../theme.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";

// Enter-only wrapper, replayed on every branch mount. There is no exit half: an `if` destroys the
// outgoing view at once.
//
// **A one-shot Timer flips `shown`, never `init`**, a flip there being the initial value, and
// `init` reads the animated bindings once so each starts from its `shown: false` value.
export component ViewTransition inherits Rectangle {
    in property <NavEnterFrom> enter-from: NavEnterFrom.above;
    // Off, the view is simply there: a page's tab bodies, inside its own enter, until the first
    // real tab pick.
    in property <bool> enabled: true;
    // **Fade without translating**, for a body something else already moves (My Library's band).
    in property <bool> slide: true;
    private property <bool> shown: false;
    // Disabled or suppressed, `true` from the first evaluation, so nothing below transitions.
    private property <bool> settled: !root.enabled || root.shown || Nav.suppress-enter-animation;

    init => {
        root.opacity;
        root.x;
        root.y;
    }

    Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            root.shown = true;
            // **The suppressed mount hands the flag back, not Rust**: a clear landing while `shown`
            // is still false fades the settled page back out. Gated on `enabled`, so a nested body
            // can't drop the flag for the page above it.
            if (root.enabled) {
                Nav.suppress-enter-animation = false;
            }
        }
    }

    opacity: settled ? 1.0 : 0.0;
    x: settled || !root.slide ? 0px : (enter-from == NavEnterFrom.right ? 32px
                                     : enter-from == NavEnterFrom.left  ? -32px : 0px);
    y: settled || !root.slide ? 0px : (enter-from == NavEnterFrom.above ? -32px : 0px);

    animate opacity { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate x       { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate y       { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
}
