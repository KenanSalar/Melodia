import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip, TooltipSide } from "tooltip.slint";
import { HoldTouchArea } from "hold-touch-area.slint";

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 22px;
    in property <length> diameter: 36px;
    in property <bool> active: false;
    // The FILL=1 variant, so a toggled button reads as a solid glyph.
    in property <bool> filled: false;
    in property <bool> button-enabled: true;
    // A host whose neighbour already says why this one is inert draws it at rest instead, so it
    // doesn't read as broken.
    in property <brush> disabled-fg: Theme.overlay0;
    in property <float> disabled-fade: 0.5;
    // For a popup trigger, bound to its popup's `is-open`, the popup taking the hover.
    in property <bool> force-bg: false;
    in property <brush> idle-bg: transparent;
    in property <brush> hover-bg: Theme.surface0;
    in property <brush> active-bg: transparent;
    in property <brush> active-fg: Theme.accent;
    in property <brush> idle-fg: Theme.text;
    // The hover colour, apart from `active-fg`, the toggled one: a destructive action sets it.
    in property <brush> hover-fg: root.idle-fg;
    // **The only way to change the crossfade's pace from outside**: this button eases every brush
    // it is handed, so a host easing one too restarts that curve every frame. A host repainting in
    // step with a longer fade hands over stepped brushes and this.
    in property <duration> recolor-duration: Theme.dur-fast;
    // Set by a host handing over a tier Rust writes once (`Player.np-*`, `HeroBackdrop`), which keeps
    // easing through a palette fade where the `Theme` defaults stand down.
    in property <bool> on-backdrop: false;
    in property <string> tooltip-text: "";
    // For a button against the edge of something that clips, which would cut a pill centred on it.
    in property <TooltipSide> tooltip-side: TooltipSide.above;
    // For a button at the panel's right edge, which cuts a centred pill off.
    in property <bool> tooltip-align-end: false;
    // A keyboard volume change uses it.
    in property <bool> force-tooltip: false;
    // Scales the disc while held, snapping back on the play button's overshoot curve.
    in property <bool> press-shrink: false;
    // Lets a lit button still answer the pointer: `active` beats hover, so a glyph whose active and
    // hover brushes match reads the same toggled and hovered. Resting the lit state at
    // `Theme.lit-rest` gives the lift somewhere to come from. Off by default: a button lighting a
    // disc already answers, and dimming its glyph would fight the fill.
    in property <bool> hover-lift: false;
    // A higher-z TouchArea flips the host's own `has-hover` false, so the host gates on either
    // (`EntityCard`).
    out property <bool> has-hover: touch.has-hover;
    // Never folded into the brushes that feed the two `animate`s, which a per-frame fade would
    // stall: it lands on the childless `disc` and on `MaterialIcon`'s `fade` instead
    // (`slint-pitfalls.md`'s `opacity` entry).
    in property <float> fade: 1.0;
    // Not gated on `button-enabled`: a button with nothing to click through to can still have
    // something to hold for.
    in property <duration> hold-delay: 0ms;
    in property <duration> repeat-interval: 0ms;

    callback clicked();
    callback held(int /*step*/);
    // Only this button's own area can take the wheel and keep its hover.
    callback scroll-event(PointerScrollEvent) -> EventResult;

    width: diameter;
    height: diameter;
    background: transparent;

    // **Only the factor is animated**: the sizes derived from it also move when the diameter
    // re-clamps on a resize, and easing them wobbles the button on every tick.
    property <float> press-scale: root.press-shrink && touch.pressed ? 0.9 : 1.0;
    animate press-scale {
        duration: touch.pressed ? 100ms : Theme.dur-med;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    // A float rather than a fourth `*-fg` brush: no host can dirty it, so it and the glyph's colour
    // ease never restart one another.
    property <float> lit-level: root.hover-lift && root.active && !touch.has-hover
        ? Theme.lit-rest
        : 1.0;
    animate lit-level { duration: root.recolor-duration; easing: ease-in-out; }

    // **The glyph is the disc's sibling, not its child**, so the disc stays childless and `fade`
    // costs no layer (`need_layer`'s second bail).
    disc := Rectangle {
        width: root.diameter * root.press-scale;
        height: root.diameter * root.press-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: !root.button-enabled
            ? root.idle-bg
            : ((touch.has-hover || root.force-bg)
                ? root.hover-bg
                : (root.active ? root.active-bg : root.idle-bg));

        // Not folded into `background`, whose animated binding it would restart every frame.
        opacity: root.fade;

        animate background { duration: root.recolor-duration; easing: ease-in-out; enabled: root.on-backdrop || !Theme.recoloring; }
    }

    // **Centred by hand, not by a layout**, so the animated `press-scale` doesn't fold into the
    // root's layout info and re-solve the host's layout every frame (`slint-pitfalls.md`).
    MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        icon-size: root.icon-size * root.press-scale;
        filled: root.filled;
        // Active beats hover, so a hovered toggle still reads as toggled; hover beats idle, which
        // carries a destructive cue.
        icon-color: !root.button-enabled
            ? root.disabled-fg
            : (root.active
                ? root.active-fg
                : (touch.has-hover ? root.hover-fg : root.idle-fg));
        fade: root.fade * (root.button-enabled ? 1.0 : root.disabled-fade) * root.lit-level;
        animate icon-color { duration: root.recolor-duration; easing: ease-in-out; enabled: root.on-backdrop || !Theme.recoloring; }
    }

    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
        host-height: root.height;
        side: root.tooltip-side;
        align-end: root.tooltip-align-end;
        force-shown: root.force-tooltip;
    }

    touch := HoldTouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.button-enabled ? pointer : default;
        hold-delay: root.hold-delay;
        repeat-interval: root.repeat-interval;
        clicked => {
            if (root.button-enabled) { root.clicked(); }
        }
        held(step) => { root.held(step); }
        scroll-event(event) => { return root.scroll-event(event); }
    }
}
