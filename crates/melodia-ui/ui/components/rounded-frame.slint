// A rounded edge for a panel over an opaque ground without a rounded clip, which would render the
// whole panel into a texture on every scroll and visualizer frame: a stroke, and the corners
// outside it painted in the ground's colour. Mounted last, at full size, over a radius-less
// `clip: true`, and only where `ground` is exactly what shows around the panel.
export component RoundedFrame inherits Rectangle {
    in property <length> radius;
    in property <length> stroke-width;
    in property <brush> stroke-color;
    in property <brush> ground;

    // Each mask's arc runs down the middle of the stroke, so its antialiased edge lies under solid
    // stroke, the way the renderer tucks a bordered rectangle's own fill. Path units are logical
    // pixels: the viewbox matches the box, and a fill-only path isn't inset by a stroke.
    //
    // **Every path winds counter-clockwise on screen and closes along a vertical or top edge**, or
    // its arc comes out stepped, and **every number goes in through `to-string-unlocalized()`**, or
    // a locale's decimal comma breaks the path (`slint-pitfalls.md`'s two `Path` entries).
    private property <float> side: root.radius / 1px;
    private property <float> inset: root.stroke-width / 2px;
    private property <float> arc: root.side - root.inset;
    private property <string> side-text: root.side.to-string-unlocalized();
    private property <string> inset-text: root.inset.to-string-unlocalized();
    private property <string> arc-text: root.arc.to-string-unlocalized();
    private property <string> arc-to: " A " + root.arc-text + " " + root.arc-text + " 0 0 1 ";

    if root.arc > 0: Rectangle {
        Path {
            x: 0;
            y: 0;
            width: root.radius;
            height: root.radius;
            viewbox-width: root.side;
            viewbox-height: root.side;
            fill: root.ground;
            commands: "M 0 0 V " + root.side-text + " H " + root.inset-text + root.arc-to
                + root.side-text + " " + root.inset-text + " V 0 Z";
        }
        Path {
            x: parent.width - self.width;
            y: 0;
            width: root.radius;
            height: root.radius;
            viewbox-width: root.side;
            viewbox-height: root.side;
            fill: root.ground;
            commands: "M " + root.side-text + " 0 H 0 V " + root.inset-text + root.arc-to
                + root.arc-text + " " + root.side-text + " H " + root.side-text + " Z";
        }
        Path {
            x: 0;
            y: parent.height - self.height;
            width: root.radius;
            height: root.radius;
            viewbox-width: root.side;
            viewbox-height: root.side;
            fill: root.ground;
            commands: "M 0 " + root.side-text + " H " + root.side-text + " V " + root.arc-text
                + root.arc-to + root.inset-text + " 0 H 0 Z";
        }
        Path {
            x: parent.width - self.width;
            y: parent.height - self.height;
            width: root.radius;
            height: root.radius;
            viewbox-width: root.side;
            viewbox-height: root.side;
            fill: root.ground;
            commands: "M " + root.side-text + " 0 H " + root.arc-text + root.arc-to
                + "0 " + root.arc-text + " V " + root.side-text + " H " + root.side-text + " Z";
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: root.stroke-width;
        border-color: root.stroke-color;
    }
}
