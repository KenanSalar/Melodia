import { Tooltip, TooltipSide } from "tooltip.slint";

// The top-layer mount for a tooltip whose host Slint paints *before* what would cover its pill: a
// frame declared at the end of the page, tracking the host's rect.
//
// **The host publishes the rect and this places it**, a component's ids being unreadable from
// outside. A plain `Rectangle`, so it takes no input and the host keeps its hover.
export component TooltipFrame inherits Rectangle {
    in property <string> label;
    in property <bool> shown;
    in property <TooltipSide> side: TooltipSide.below;
    // The pill's horizontal arm is the component's own, so an unlabelled host has no other way to
    // pin the trailing edge.
    in property <bool> align-end: false;
    in property <length> gap: 6px;

    Tooltip {
        text: root.label;
        hovered: root.shown;
        host-width: root.width;
        host-height: root.height;
        side: root.side;
        align-end: root.align-end;
        gap: root.gap;
    }
}
