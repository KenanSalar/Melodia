// Paces filter-box keystrokes: the host bumps `pending` on every `edited`, and this fires while it
// runs ahead of the last applied tick. Its two `fire()` shapes are `slint-pitfalls.md`'s.
export component FilterThrottle {
    // Cadence, or the settle time under `trailing`.
    in property <duration> interval: 130ms;
    in property <int> pending;
    // Fires once the burst *settles* rather than on a cadence. Where the settled value costs a
    // network round trip, the values on the way are requests nobody asked for; where it costs a walk
    // over rows in hand, arriving early is worth more than arriving once.
    in property <bool> trailing: false;
    callback fire();

    private property <int> applied: 0;

    // Pushes the deadline out. Safe against the `running` binding either way round: the generated
    // `update_timers` starts only a stopped timer, so a restart on a live one resets it and one on a
    // stopped timer is followed by the start the binding asks for.
    changed pending => {
        if (root.trailing) { settle.restart(); }
    }

    settle := Timer {
        interval: root.interval;
        running: root.pending != root.applied;
        triggered() => {
            root.applied = root.pending;
            root.fire();
        }
    }
}
