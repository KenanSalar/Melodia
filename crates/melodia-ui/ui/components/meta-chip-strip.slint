import { Theme } from "../theme.slint";
import { MetaChip } from "meta-chip.slint";

// A wrapping strip of `MetaChip`s, broken into lines at the width it is drawn. Both brushes are
// inputs for `MetaChip`'s reason, and every mount sets both.
export component MetaChipStrip inherits Rectangle {
    in property <[string]> chips;
    in property <brush> chip-fill;
    in property <brush> chip-label-color;
    // Now Playing centres its rows under the cover; a hero's text column is left-aligned.
    in property <bool> centred: false;
    // Hides the chips and keeps their lines reserved: Now Playing hides the outgoing track's until
    // the new metadata lands, and a strip shrinking for the gap would bounce the centred column.
    in property <bool> show-rows: true;
    // Zero for all of them. The chips are one height, so the cap clips the next row away whole.
    in property <int> max-rows: 0;

    // Tighter than between chips: a wrapped row is the same strip continuing.
    property <length> row-gap: Theme.pad-xs;
    property <length> capped-h:
        root.max-rows * Theme.meta-chip-h + (root.max-rows - 1) * root.row-gap;
    property <length> rows-h: root.max-rows > 0
        ? min(rows.preferred-height, root.capped-h)
        : rows.preferred-height;

    // Bound, so a host short of height can't squeeze a wrapped row over what follows. One row is
    // reserved with no chips, so a track without metadata doesn't reflow what sits above.
    height: max(Theme.meta-chip-h, root.rows-h);
    // No radius, so a scissor.
    clip: root.max-rows > 0;

    // **Never inside an `if`**, where a flex reports its height at its preferred width rather
    // than the one it draws at.
    rows := FlexboxLayout {
        visible: root.show-rows;
        spacing-horizontal: Theme.pad-sm;
        spacing-vertical: root.row-gap;
        alignment: root.centred ? LayoutAlignment.center : LayoutAlignment.start;

        for t in root.chips: MetaChip {
            text: t;
            fill: root.chip-fill;
            label-color: root.chip-label-color;
        }
    }
}
