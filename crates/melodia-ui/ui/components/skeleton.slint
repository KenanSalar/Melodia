import { Theme } from "../theme.slint";

// What a row or card still loading draws in place of its text and cover, in the ink of what each
// stands in for. A host swaps them in behind an `if`, so a pending row shapes no text and holds no
// rounded clip, and both stay childless and still, so nothing redraws while one shows.
export component SkeletonBar inherits Rectangle {
    in property <brush> ink;
    // Picks the width: the row's place in its list plus the cell's in the row. A place, not an id,
    // since neighbouring rows' ids are unrelated and match one time in five.
    in property <int> seed;
    // A width the host already knows, never the layout's holding the bar, which this would feed.
    in property <length> span;
    in property <length> font-size;

    // Doubled so consecutive seeds land two of the five widths apart.
    property <int> step: Math.mod(root.seed * 2, 5);

    width: root.span * (0.45 + 0.1 * root.step);
    // About the text's cap height, so the bar reads as a line rather than a block.
    height: root.font-size * 0.7;
    // A `Text` reports none and a `Rectangle` one, which would let the cell holding the bar take
    // room the text left to its neighbours.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: root.ink.transparentize(1.0 - Theme.fade-skeleton);
}

export component SkeletonTile inherits Rectangle {
    in property <brush> ink;
    in property <length> tile-size;
    in property <length> tile-radius;

    width: root.tile-size;
    height: root.tile-size;
    border-radius: root.tile-radius;
    background: root.ink.transparentize(1.0 - Theme.fade-skeleton);
}
