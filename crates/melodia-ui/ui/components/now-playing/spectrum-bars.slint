import { Visualizer } from "../../globals/audio.slint";
import { Player } from "../../globals/player.slint";

// One bar per band, bass left. Every band is one figure rather than one element: FemtoVG builds
// and tessellates a path per element every frame, caching none of it. `spectrum::write_bar_path`
// writes it and owns the anchor, so Mirrored mounts this same `Path`.
//
// No `animate`: Rust has already smoothed the heights, and easing a smoothed value phase-lags.
export component SpectrumBars inherits Rectangle {
    Path {
        // Asked for over the live geometry, so a strip moved at rest still lands on whole pixels.
        commands: Visualizer.bars-figure(
            Visualizer.bars-generation,
            Visualizer.style-idx,
            root.absolute-position.x / 1px,
            root.absolute-position.y / 1px,
            root.width / 1px,
            root.height / 1px
        );

        // The box Rust normalizes into; without one the path's own bounds fill the element.
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 1;
        viewbox-height: 1;
        fit: fill;

        // A bar is a few pixels wide, so a half-covered edge is a visible share of it.
        // `write_bar_path` takes the strip's window position and puts every edge on a pixel
        // boundary instead, the strip's origin landing wherever its column puts it.
        anti-alias: false;

        // Tone-floored, so a dark album's accent doesn't sink into the scrim. Lighter than the
        // still chrome's tier, motion reading louder.
        fill: Player.np-viz;
    }
}
