import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { Tooltip } from "../tooltip.slint";
import { HoldTouchArea } from "../hold-touch-area.slint";

// The now-playing bar's play / pause button, with the ring a hold fills and the optional
// Equalizer overlay. The overlay's four bars ride one shared phase counter rather than an
// `animate` each (`slint-pitfalls.md`'s concurrent `animate` entry).
export component PlayButton inherits Rectangle {
    in property <bool>   is-playing;
    // The one glyph showing a state rather than the click's action: a stop drawn as a play arrow
    // reads as a pause.
    in property <bool>   is-stopped;
    in property <int>    animation-mode;        // 0 None | 1 Equalizer
    in property <length> wrapper-d: 38px;
    in property <length> icon-size: wrapper-d * 0.5;
    // The surface under the button, so the glyph reads as a hole punched in the disc. The bar
    // passes its own, which carries the KDE unfocused tint.
    in property <brush>  icon-color: Theme.mantle;
    // On an artwork backdrop the host hands over the accent solved against the cover.
    in property <brush>  disc-color: Theme.accent;
    // Off at zero; see `HoldTouchArea`.
    in property <duration> hold-delay: 0ms;
    callback clicked();
    callback held();

    width: wrapper-d;
    height: wrapper-d;
    background: transparent;

    // A fired hold lets go of the press shrink at once, so the stop shows while the pointer is down.
    property <bool> held-down: pp-touch.pressed && !pp-touch.hold-fired;

    // Held off until a press outlasts a click, so a pause never flashes it.
    property <duration> ring-delay: 250ms;
    property <float> ring-progress: root.hold-delay > root.ring-delay
        ? clamp((pp-touch.hold-progress * root.hold-delay - root.ring-delay)
            / (root.hold-delay - root.ring-delay), 0, 1)
        : 0;

    property <length> disc-d: root.wrapper-d *
        (root.held-down ? 0.9 : (pp-touch.has-hover ? 1.05 : 1.0));

    property <bool> equalizer-active: root.is-playing && root.animation-mode == 1;

    // A period each, so the bars never march in step, and staggered starts, so the first paint
    // isn't a flat line.
    property <int> bar1-cycle: 22;
    property <int> bar2-cycle: 17;
    property <int> bar3-cycle: 25;
    property <int> bar4-cycle: 19;
    property <int> bar1-frame: 0;
    property <int> bar2-frame: 8;
    property <int> bar3-frame: 6;
    property <int> bar4-frame: 14;

    eq-timer := Timer {
        interval: 33ms;
        running: root.equalizer-active;
        triggered => {
            root.bar1-frame = root.bar1-frame + 1;
            if (root.bar1-frame >= root.bar1-cycle) { root.bar1-frame = 0; }
            root.bar2-frame = root.bar2-frame + 1;
            if (root.bar2-frame >= root.bar2-cycle) { root.bar2-frame = 0; }
            root.bar3-frame = root.bar3-frame + 1;
            if (root.bar3-frame >= root.bar3-cycle) { root.bar3-frame = 0; }
            root.bar4-frame = root.bar4-frame + 1;
            if (root.bar4-frame >= root.bar4-cycle) { root.bar4-frame = 0; }
        }
    }

    pp-disc := Rectangle {
        width: root.disc-d;
        height: root.disc-d;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.disc-color;
        animate width, height {
            duration: root.held-down ? 100ms : Theme.dur-med;
            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        MaterialIcon {
            visible: !root.equalizer-active;
            name: root.is-playing ? "pause" : (root.is-stopped ? "stop" : "play_arrow");
            filled: true;
            icon-size: root.icon-size;
            icon-color: root.icon-color;
        }

        // The bars grow up from a baseline, as an analyzer's do.
        if root.equalizer-active: Rectangle {
            property <length> bar-area-w: 14px;
            property <length> bar-area-h: root.icon-size;
            width: bar-area-w;
            height: bar-area-h;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;

            Rectangle {
                property <float> phase: 1.0 * root.bar1-frame / root.bar1-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 0;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: root.icon-color;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar2-frame / root.bar2-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 4px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: root.icon-color;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar3-frame / root.bar3-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 8px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: root.icon-color;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar4-frame / root.bar4-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 12px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: root.icon-color;
                border-radius: 1px;
            }
        }

        // Clockwise from twelve. Short of a full turn, where an arc's two ends meet and it draws
        // nothing; the hold fires there anyway.
        if root.ring-progress > 0: Path {
            property <float> radius: 38;
            property <angle> sweep: min(root.ring-progress, 0.999) * 360deg;

            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            fit: fill;
            stroke: root.icon-color;
            stroke-width: 2px;
            // Unlocalized (`slint-pitfalls.md`'s decimal separator).
            commands: "M 50 " + (50 - self.radius).to-string-unlocalized()
                + " A " + self.radius.to-string-unlocalized() + " "
                + self.radius.to-string-unlocalized() + " 0 "
                + (self.sweep > 180deg ? "1" : "0") + " 1 "
                + (50 + self.radius * sin(self.sweep)).to-string-unlocalized() + " "
                + (50 - self.radius * cos(self.sweep)).to-string-unlocalized();
        }
    }

    Tooltip {
        text: root.hold-delay > 0ms
            ? (root.is-playing ? @tr("Pause (hold to stop)") : @tr("Play (hold to stop)"))
            : (root.is-playing ? @tr("Pause") : @tr("Play"));
        hovered: pp-touch.has-hover;
        host-width: parent.width;
        host-height: parent.height;
    }

    pp-touch := HoldTouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        hold-delay: root.hold-delay;
        clicked => { root.clicked(); }
        held => { root.held(); }
    }
}
