import { Theme } from "../../theme.slint";
import { Lyrics, LyricsState } from "../../globals/lyrics.slint";
import { Player } from "../../globals/player.slint";
import { Dialog } from "../../globals/dialog.slint";
import { TagEditor } from "../../globals/dialog-forms.slint";
import { TooltipSide } from "../tooltip.slint";
import { AccentGlyphButton } from "./accent-glyph-button.slint";
import { MenuSurface } from "./menu-surface.slint";
import { OverflowRow } from "./overflow-row.slint";
import { FlyoutMetrics } from "./flyout-presets.slint";

// The lyrics panel's menu, beside the switch that mounts the panel. `VisualizerPicker`'s shape with
// a menu column for a flyout. The switch owns the swap, so everything here acts on a panel that is
// on screen, and the trigger is inert while lyrics are off.
export component LyricsMenu inherits Rectangle {
    width: btn.width;
    height: btn.height;

    // The drawn glyph inside the larger hit slot, for a host matching it by eye.
    out property <length> glyph-size: btn.icon-size;

    // The host's, so it can match the switch beside it.
    in property <brush> off-fg: Player.np-accent-dim;

    // Every row drawn whether it can act or not, so the reserve is a constant and no row moves
    // under the pointer between opens.
    property <length> menu-h: FlyoutMetrics.menu-row-h * 5 + FlyoutMetrics.chrome-h;

    btn := AccentGlyphButton {
        icon: "lyrics";
        filled: Lyrics.enabled;
        // A bare glyph has no disc for `force-bg` to light.
        active: Lyrics.enabled || pop.is-open;
        // Drawn at rest rather than greyed, which beside a working switch reads as broken.
        button-enabled: Lyrics.enabled;
        disabled-fg: root.off-fg;
        disabled-fade: 1.0;
        tooltip-text: @tr("Lyrics");
        // The panel's top edge, with too little room right of the switch for a centred pill.
        tooltip-side: TooltipSide.below;
        tooltip-align-end: true;
        clicked => {
            pop.show();
        }
    }

    pop := PopupWindow {
        // On the popup, the only element that can read its descendant's `preferred-width`.
        property <length> menu-w: max(200px, menu-vl.preferred-width + 2px);

        // Right-aligned, the trigger sitting one control from the panel's edge.
        x: btn.width - self.width;
        y: btn.height + Theme.popup-gap;
        width: self.menu-w;
        height: root.menu-h;
        close-policy: close-on-click-outside;

        MenuSurface {
            width: 100%;
            height: 100%;
            close-requested => {
                pop.close();
            }

            menu-vl := VerticalLayout {
                padding: Theme.pad-xs;
                spacing: 0;

                // The property re-lays the sheet on the click, the callback persists it. Inert
                // without a sheet, where it would claim to have done something.
                OverflowRow {
                    icon: "translate";
                    label: @tr("Show romanization");
                    active: Lyrics.romanization-shown;
                    filled: Lyrics.romanization-shown;
                    button-enabled: Lyrics.state == LyricsState.ready;
                    clicked => {
                        Lyrics.romanization-shown = !Lyrics.romanization-shown;
                        Lyrics.set-romanization-shown(Lyrics.romanization-shown);
                        pop.close();
                    }
                }

                // The Settings switch, here too because the panel's "lookup is off" copy sends the
                // reader to this menu.
                OverflowRow {
                    icon: "travel_explore";
                    label: @tr("Look up lyrics online");
                    active: Lyrics.online-enabled;
                    filled: Lyrics.online-enabled;
                    clicked => {
                        Lyrics.online-enabled = !Lyrics.online-enabled;
                        Lyrics.set-online-enabled(Lyrics.online-enabled);
                        pop.close();
                    }
                }

                OverflowRow {
                    icon: "refresh";
                    label: @tr("Look up again");
                    // Needs the lookup on: forgetting the directory's answer is the re-ask, so off
                    // it could only delete the sheet on show.
                    button-enabled: Lyrics.state != LyricsState.idle && Lyrics.online-enabled;
                    clicked => {
                        Lyrics.refresh();
                        pop.close();
                    }
                }

                OverflowRow {
                    icon: "save";
                    label: @tr("Save to file");
                    button-enabled: Lyrics.can-save-to-tag;
                    clicked => {
                        Lyrics.save-to-tag();
                        pop.close();
                    }
                }

                // For a sheet that is nearly right. The playing track is read at the click, this
                // popup outliving any one song.
                OverflowRow {
                    icon: "edit";
                    label: @tr("Edit lyrics…");
                    button-enabled: Player.vm.has_track;
                    clicked => {
                        Dialog.open-tag-editor(
                            @tr("Edit Track Information"),
                            [Player.vm.track.id],
                            TagEditor.tab-lyrics);
                        pop.close();
                    }
                }
            }
        }
    }
}
