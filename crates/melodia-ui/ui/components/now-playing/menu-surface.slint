import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// A Now-Playing popup's menu column: the shared chrome plus the watcher that dismisses it when the
// OS window loses focus. The rows stay in the *host* and arrive through `@children`, in a layout
// or, where they can outgrow the window, a `PopupColumn`: the popup's width derives from the rows'
// own, and only the host can name a descendant.
export component MenuSurface inherits PopupSurface {
    callback close-requested();

    // Ungated: this sits inside the host's popup, whose body exists only while it is shown.
    FocusLossWatcher {
        close => {
            root.close-requested();
        }
    }

    @children
}
