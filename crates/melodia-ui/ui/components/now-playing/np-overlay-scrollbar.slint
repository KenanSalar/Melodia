import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";

// The Now-Playing column's bar, tinted off the artwork accent so it sits into the blur. One
// component because all three arms of that column draw it, and a per-arm tint would drift.
// `on-backdrop: false` is the miniplayer with its backdrop off.
export component NpOverlayScrollbar inherits OverlayScrollbar {
    on-backdrop: true;

    track-color: root.on-backdrop ? Player.np-accent-bright : Theme.surface0;
    track-opacity: root.on-backdrop ? 0.25 : 0.5;
    track-opacity-active: root.on-backdrop ? 0.4 : 0.85;
    thumb-color: root.on-backdrop ? Player.np-accent-dim : Theme.surface2;
    thumb-active-color: root.on-backdrop ? Player.np-accent-bright.transparentize(0.2) : Theme.accent;
}
