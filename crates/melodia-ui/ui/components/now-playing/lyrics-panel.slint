import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Lyrics, LyricsState } from "../../globals/lyrics.slint";
import { NpOverlayScrollbar } from "np-overlay-scrollbar.slint";
import { NpEmptyState } from "np-empty-state.slint";
import { MaterialIcon } from "../material-icon.slint";

// The lyrics arm of a now-playing column, in the full view and the miniplayer. The scroller, bar
// and palette are the station panel's, so the two sit into the backdrop alike.
//
// No `changed` handler and no `animate`: this is mounted behind an `if`, and a tracker re-dirtied
// on the frame its branch goes panics (`slint-pitfalls.md`). The follow is driven from the timer
// below and eased by arithmetic.
export component LyricsPanel inherits Rectangle {
    // Only the empty state draws at two sizes; the sheet's scale is the `Lyrics` global's.
    in property <bool> compact: false;

    // The miniplayer eases between these and its page's ink out there, the one place it can.
    in property <brush> ink: Player.np-on-backdrop;
    in property <brush> ink-muted: Player.np-on-backdrop-muted;
    in property <brush> row-hover: Player.np-accent-pill;
    in property <brush> empty-glyph: Player.np-on-backdrop-muted.transparentize(0.5);
    // A flag and a pace rather than brushes: `OverlayScrollbar` eases its own colours.
    in property <bool> bar-on-backdrop: true;
    in property <duration> bar-recolor-duration: Theme.dur-fast;

    // A quarter of the distance per tick settles inside a third of a second: a glide, not a snap.
    property <float> follow-step: 0.25;

    // Ticks the panel leaves the reader alone after their last scroll, paging back through a
    // verse being many events.
    property <int> suspend-ticks-total: 120;

    property <int> suspend-ticks;
    // Written, never bound.
    property <length> scroll-y;
    property <length> target-y: max(0px,
        Lyrics.active-offset + Lyrics.active-height / 2 - sv.visible-height / 2);

    property <bool> has-rows: Lyrics.rows.length > 0 && Lyrics.state == LyricsState.ready;

    // Under the words' size, so a break reads as a beat rather than a control. Panel-local: an
    // interlude row is one line tall, so Rust's offset table needs neither.
    property <length> note-size: 15px;
    property <length> note-gap: 5px;

    sv := ScrollView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        content-width: self.width;

        VerticalLayout {
            padding-right: Theme.scrollbar-slot;
            // Rust adds the same term per row to its offset table.
            spacing: Lyrics.row-gap;
            alignment: start;

            for row[i] in Lyrics.rows: Rectangle {
                // Rust's heights, matching its offset table; a `for` can't read drawn ones back.
                property <length> sung-h: row.line_count * Lyrics.line-height;
                property <length> roman-h: row.romanization_line_count
                    * Lyrics.romanization-line-height;
                property <length> gloss-h: row.translation_line_count
                    * Lyrics.translation-line-height;
                // Each part carries the gap above it or nothing, so no shape needs a branch.
                property <length> roman-block: self.roman-h > 0px
                    ? Lyrics.romanization-gap + self.roman-h
                    : 0px;
                property <length> gloss-block: self.gloss-h > 0px
                    ? Lyrics.translation-gap + self.gloss-h
                    : 0px;
                height: 2 * Lyrics.row-pad-y + self.sung-h + self.roman-block + self.gloss-block;

                // -1 on a plain sheet, which then reads as a page with every row quiet.
                property <bool> is-sung: i == Lyrics.active-index;

                // Flat like Up Next's rows. `has-hover` clears it, the index being rewritten only
                // on a crossing.
                background: touch.has-hover && i == Lyrics.hover-index
                    ? root.row-hover
                    : transparent;
                border-radius: Theme.radius-md;

                // Every part spells its own `y`: one with none is centred (`slint-pitfalls.md`).
                Text {
                    x: Lyrics.row-pad-x;
                    y: Lyrics.row-pad-y;
                    width: parent.width - 2 * Lyrics.row-pad-x;
                    height: parent.sung-h;
                    text: row.text;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.font-size;
                    font-weight: parent.is-sung ? 700 : 400;
                    color: parent.is-sung
                        ? root.ink
                        : root.ink-muted.transparentize(0.2);
                }

                // Collapses on a zero line count. Anchored under the words, being the middle part.
                Text {
                    x: Lyrics.row-pad-x;
                    y: Lyrics.row-pad-y + parent.sung-h + Lyrics.romanization-gap;
                    width: parent.width - 2 * Lyrics.row-pad-x;
                    height: parent.roman-h;
                    text: row.romanization;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.romanization-font-size;
                    // Sung along to, so it keeps the sung line's colour a step back.
                    color: parent.is-sung
                        ? root.ink.transparentize(0.15)
                        : root.ink-muted.transparentize(0.3);
                }

                // Bottom-anchored, which keeps the gap spelled in one place.
                Text {
                    x: Lyrics.row-pad-x;
                    y: parent.height - Lyrics.row-pad-y - parent.gloss-h;
                    width: parent.width - 2 * Lyrics.row-pad-x;
                    height: parent.gloss-h;
                    text: row.translation;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.translation-font-size;
                    // A gloss follows the sung line without competing with it.
                    color: parent.is-sung
                        ? root.ink-muted
                        : root.ink-muted.transparentize(0.45);
                }

                // `row.text` is empty on an interlude, so this is the whole row.
                if row.is_interlude: HorizontalLayout {
                    x: Lyrics.row-pad-x;
                    y: Lyrics.row-pad-y;
                    width: 3 * root.note-size + 2 * root.note-gap;
                    height: Lyrics.line-height;
                    spacing: root.note-gap;

                    for k in [0, 1, 2]: Rectangle {
                        width: root.note-size;
                        // A third of the gap each. Only the gap being played fills, which is why
                        // `interlude-progress` can be one global rather than a field per row.
                        property <float> lit: i == Lyrics.active-index
                            ? clamp(Lyrics.interlude-progress * 3 - k, 0.0, 1.0)
                            : 0.0;

                        // Two layers, `mix()` having no brush overload (`slint-pitfalls.md`).
                        MaterialIcon {
                            name: "music_note";
                            icon-size: root.note-size;
                            icon-color: root.ink-muted.transparentize(0.2);
                        }
                        MaterialIcon {
                            name: "music_note";
                            icon-size: root.note-size;
                            icon-color: root.ink;
                            fade: parent.lit;
                        }
                    }
                }
            }
        }
    }

    // One area for the whole sheet, over the scroller where a per-row area never got the click.
    // Rust answers which row a point lands in off its offset table, so it can't disagree with the
    // highlight. The wheel is rejected so the scroller still gets it.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: Lyrics.synced ? MouseCursor.pointer : MouseCursor.default;
        scroll-event(event) => {
            root.suspend-ticks = root.suspend-ticks-total;
            root.settled = false;
            return reject;
        }
        // `moved` fires only while pressed.
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                Lyrics.hover-at(self.mouse-y - sv.content-y);
            }
        }
        clicked => {
            if (Lyrics.synced) {
                Lyrics.seek-at(self.mouse-y - sv.content-y);
                root.settled = false;
            }
        }
    }

    bar := NpOverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: Theme.scrollbar-slot;
        height: parent.height;
        on-backdrop: root.bar-on-backdrop;
        recolor-duration: root.bar-recolor-duration;
        visible-size: sv.visible-height;
        content-size: sv.content-height;
        offset: -sv.content-y;
        scroll-to(o) => { sv.content-y = -o; }
    }

    property <bool> following: root.has-rows && Lyrics.synced && Player.vm.is_playing;

    // Whether the glide has reached the sung line. Written by the tick, never bound to the
    // distance: `target-y` reads a layout property, which the timer's `interval` may not reach
    // (`slint-pitfalls.md`).
    property <bool> settled;

    // Fast while following or catching up, a crawl once both are still. The slow cadence still
    // runs so the width reaches Rust across a resize, a `changed` on it being off limits here.
    // Catching up earns the fast one too: a freshly mounted or scrolled-away panel is nowhere near
    // the target, and a quarter per second is a crawl.
    Timer {
        interval: root.following || (root.has-rows && !root.settled) ? 33ms : 1s;
        running: true;
        triggered => {
            Lyrics.report-width(
                sv.visible-width - Theme.scrollbar-slot - 2 * Lyrics.row-pad-x);
            if (!root.has-rows) {
                return;
            }
            // Not gated on the transport: a remount while paused would otherwise mark no line
            // until playback resumes.
            Lyrics.tick();
            // A plain sheet or the run-in before the first stamp: the reader owns the scroll.
            if (Lyrics.active-index < 0) {
                root.settled = true;
                return;
            }

            // Polled, a `changed dragging` being a tracker this component may not carry.
            if (bar.dragging) {
                root.suspend-ticks = root.suspend-ticks-total;
            }
            if (root.suspend-ticks > 0) {
                root.suspend-ticks -= 1;
                // So resuming glides from where the reader left it.
                root.scroll-y = -sv.content-y;
            } else if (abs(root.target-y - root.scroll-y) > 1px) {
                // A geometric step never arrives, and each sub-pixel write repainted the whole
                // window. `settled`'s threshold, spelled again: the flag is last tick's answer.
                root.scroll-y += (root.target-y - root.scroll-y) * root.follow-step;
                sv.content-y = -root.scroll-y;
            }
            root.settled = abs(root.target-y - root.scroll-y) <= 1px;
        }
    }

    // Each hint names its control in words: the bundled faces carry no `▸` or `⋮`, and a fallback
    // glyph breaks the line box (`slint-pitfalls.md`). Silent in the miniplayer, which has no
    // header menu to point at.
    if !root.has-rows: NpEmptyState {
        glyph: Lyrics.state == LyricsState.instrumental ? "music_note"
            : Lyrics.state == LyricsState.unavailable ? "cloud_off"
            : "lyrics";
        heading: Lyrics.state == LyricsState.loading ? @tr("Looking for lyrics…")
            : Lyrics.state == LyricsState.instrumental ? @tr("This track has no words")
            : Lyrics.state == LyricsState.missing ? @tr("No lyrics found")
            : Lyrics.state == LyricsState.unavailable ? @tr("Couldn't reach the lyrics service")
            : Lyrics.state == LyricsState.off ? @tr("Lyrics lookup is off")
            : @tr("Play something to see its lyrics");
        hint: root.compact ? ""
            // Translators: "Lyrics menu" is the menu whose tooltip reads "Lyrics"
            : Lyrics.state == LyricsState.off ? @tr("Turn it on in the Lyrics menu")
            // Translators: "Lyrics menu" is the menu whose tooltip reads "Lyrics"
            : Lyrics.state == LyricsState.unavailable ? @tr("Try again from the Lyrics menu")
            : "";
        compact: root.compact;
        ink: root.ink-muted;
        glyph-color: root.empty-glyph;
    }
}
