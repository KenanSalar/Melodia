import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Lyrics, LyricsState } from "../../globals/lyrics.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";
import { MaterialIcon } from "../material-icon.slint";

// The Now Playing column's lyrics arm, mounted where Up Next otherwise is. The scroller,
// its bar and the palette are the station panel's, so the two columns sit into the backdrop
// the same way.
//
// **Nothing here carries a `changed` handler, and that is not a style choice.** This is mounted
// behind an `if`, and a tracker in a dropped branch stays registered against whatever it watched;
// the shape that panics is one re-dirtied in the same frame the branch goes, which an `animate`
// on the scroll target is exactly. So the follow is driven imperatively from the timer below and
// the easing is arithmetic rather than an `animate` block.
export component LyricsPanel inherits Rectangle {
    // How far the panel closes on the target each tick. A quarter settles inside a third of a
    // second at this interval, which reads as a glide rather than a snap or a drift.
    property <float> follow-step: 0.25;

    // How long the panel leaves the reader alone after they scroll it themselves, in ticks.
    // Measured from the *last* scroll rather than the first, since paging back through a verse is
    // one gesture made of many events and being yanked forward mid-way is the failure.
    property <int> suspend-ticks-total: 120;

    property <int> suspend-ticks;
    // Where the viewport actually is, eased toward `target-y`. Written, never bound.
    property <length> scroll-y;
    property <length> target-y: max(0px,
        Lyrics.active-offset + Lyrics.active-height / 2 - sv.visible-height / 2);

    property <bool> has-rows: Lyrics.rows.length > 0 && Lyrics.state == LyricsState.ready;

    sv := ScrollView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        viewport-width: self.width;

        VerticalLayout {
            padding-right: Theme.scrollbar-slot;
            alignment: start;

            for row[i] in Lyrics.rows: Rectangle {
                // Rust chose this height and keeps the offset table that matches it. Reading the
                // drawn height back instead is the thing a `for` loop cannot do.
                height: row.line_count * Lyrics.line-height;

                line := Text {
                    width: parent.width;
                    text: row.text;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Theme.font-size-md;
                    // The sung line at full weight, everything else stepped back. On a plain
                    // sheet `active-index` stays -1, so every line takes the quiet tier and the
                    // panel reads as a page rather than as a list with nothing selected.
                    font-weight: i == Lyrics.active-index ? 700 : 400;
                    color: i == Lyrics.active-index
                        ? Player.np-on-backdrop
                        : Player.np-on-backdrop-muted.transparentize(0.2);
                }

                // Click a line to seek, on a timed sheet only: an untimed one has nowhere to send
                // the player, and a row that looked clickable and did nothing would be worse than
                // one that never did.
                TouchArea {
                    enabled: Lyrics.synced;
                    mouse-cursor: pointer;
                    clicked => { Lyrics.seek-to(row.at_ms); }
                }
            }
        }
    }

    // Any wheel over the panel hands it to the reader for a while. Rejected so the scroller still
    // gets the event: this only notices, it does not handle.
    TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(event) => {
            root.suspend-ticks = root.suspend-ticks-total;
            return reject;
        }
    }

    bar := OverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: Theme.scrollbar-slot;
        height: parent.height;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        track-color: Player.np-accent-bright;
        track-opacity: 0.25;
        track-opacity-active: 0.4;
        thumb-color: Player.np-accent-dim;
        thumb-active-color: Player.np-accent-bright.transparentize(0.2);
        scroll-to(o) => { sv.viewport-y = -o; }
    }

    // Whether there is a sung line to keep up with.
    property <bool> following: root.has-rows && Lyrics.synced && Player.vm.is_playing;

    // **One timer on two cadences**, the visualizer strip's `dormant ? 500ms : 33ms` shape. It
    // exists only while this branch is mounted, which is what keeps all of it off every other
    // view, and it drops to a crawl the moment there is no sung line to follow. The slow cadence
    // still runs because the width has to reach Rust and has to survive a window resize, and a
    // `changed` handler on a layout property is the one thing this component may not carry.
    Timer {
        interval: root.following ? 33ms : 1s;
        running: true;
        triggered => {
            Lyrics.report-width(sv.visible-width - Theme.scrollbar-slot);
            if (!root.following) {
                return;
            }
            Lyrics.tick();

            // The bar is polled rather than watched, a `changed dragging` being the tracker this
            // component must not carry.
            if (bar.dragging) {
                root.suspend-ticks = root.suspend-ticks-total;
            }
            if (root.suspend-ticks > 0) {
                root.suspend-ticks -= 1;
                // Keep the eased position with the reader, so resuming glides from where they
                // left the panel rather than from where the song was.
                root.scroll-y = -sv.viewport-y;
            } else {
                root.scroll-y += (root.target-y - root.scroll-y) * root.follow-step;
                sv.viewport-y = -root.scroll-y;
            }
        }
    }

    // The five states with nothing to draw. The centred block is the Up Next list's, not
    // `GridEmptyState`, whose opaque `Theme.base` would punch a hole in the backdrop.
    if !root.has-rows: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: Theme.pad-sm;
                HorizontalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: Lyrics.state == LyricsState.instrumental ? "music_note" : "lyrics";
                        icon-size: 40px;
                        icon-color: Player.np-on-backdrop-muted.transparentize(0.5);
                    }
                }
                Text {
                    text: Lyrics.state == LyricsState.loading ? @tr("Looking for lyrics…")
                        : Lyrics.state == LyricsState.instrumental ? @tr("This track has no words")
                        : Lyrics.state == LyricsState.missing ? @tr("No lyrics found")
                        : Lyrics.state == LyricsState.off ? @tr("Lyrics lookup is off")
                        : @tr("Play something to see its lyrics");
                    color: Player.np-on-backdrop-muted;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // Only the off state can be acted on from here, so only it says where to go.
                if Lyrics.state == LyricsState.off: Text {
                    text: @tr("Turn it on under Settings ▸ Services");
                    color: Player.np-on-backdrop-muted.transparentize(0.35);
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
