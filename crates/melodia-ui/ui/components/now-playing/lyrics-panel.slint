import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Lyrics, LyricsState } from "../../globals/lyrics.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";
import { MaterialIcon } from "../material-icon.slint";

// The Now Playing column's lyrics arm, mounted where Up Next otherwise is. The scroller,
// its bar and the palette are the station panel's, so the two columns sit into the backdrop
// the same way.
//
// **Nothing here carries a `changed` handler, and that is not a style choice.** This is mounted
// behind an `if`, and a tracker in a dropped branch stays registered against whatever it watched;
// the shape that panics is one re-dirtied in the same frame the branch goes, which an `animate`
// on the scroll target is exactly. So the follow is driven imperatively from the timer below and
// the easing is arithmetic rather than an `animate` block.
export component LyricsPanel inherits Rectangle {
    // How far the panel closes on the target each tick. A quarter settles inside a third of a
    // second at this interval, which reads as a glide rather than a snap or a drift.
    property <float> follow-step: 0.25;

    // How long the panel leaves the reader alone after they scroll it themselves, in ticks.
    // Measured from the *last* scroll rather than the first, since paging back through a verse is
    // one gesture made of many events and being yanked forward mid-way is the failure.
    property <int> suspend-ticks-total: 120;

    property <int> suspend-ticks;
    // Where the viewport actually is, eased toward `target-y`. Written, never bound.
    property <length> scroll-y;
    property <length> target-y: max(0px,
        Lyrics.active-offset + Lyrics.active-height / 2 - sv.visible-height / 2);

    property <bool> has-rows: Lyrics.rows.length > 0 && Lyrics.state == LyricsState.ready;

    sv := ScrollView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        viewport-width: self.width;

        VerticalLayout {
            padding-right: Theme.scrollbar-slot;
            // The air *between* lines, so each row's own box only has to hold the text it draws.
            // Rust adds the same term per row to the offset table it follows the song with.
            spacing: Lyrics.row-gap;
            alignment: start;

            for row[i] in Lyrics.rows: Rectangle {
                // Rust chose all three heights and keeps the offset table that matches them.
                // Reading the drawn height back instead is the thing a `for` loop cannot do.
                property <length> sung-h: row.line_count * Lyrics.line-height;
                property <length> roman-h: row.romanization_line_count
                    * Lyrics.romanization-line-height;
                property <length> gloss-h: row.translation_line_count
                    * Lyrics.translation-line-height;
                // Each part carries the gap above it or contributes nothing at all, which is what
                // lets a row of one, two or three come out right with no branch per shape.
                property <length> roman-block: self.roman-h > 0px
                    ? Lyrics.romanization-gap + self.roman-h
                    : 0px;
                property <length> gloss-block: self.gloss-h > 0px
                    ? Lyrics.translation-gap + self.gloss-h
                    : 0px;
                height: self.sung-h + self.roman-block + self.gloss-block;

                // On a plain sheet `active-index` stays -1, so every row takes the quiet tier and
                // the panel reads as a page rather than as a list with nothing selected.
                property <bool> is-sung: i == Lyrics.active-index;

                // The Up Next list's own hover brush, and flat like its rows: an eased fade reads
                // as lag when the pointer crosses rows. `has-hover` is what clears it — the index
                // is only rewritten on a crossing, so nothing reports the pointer leaving.
                background: touch.has-hover && i == Lyrics.hover-index
                    ? Player.np-accent-pill
                    : transparent;
                border-radius: Theme.radius-md;

                // **Every part of a row spells its own `y`, this one included.** A child that
                // sets none is *centred* in its parent by `default_geometry`, not put at the top,
                // so leaving it off puts the words in the middle of a box sized for three lines
                // and draws them over whichever part is really there.
                Text {
                    x: Lyrics.row-pad;
                    y: 0px;
                    width: parent.width - 2 * Lyrics.row-pad;
                    height: parent.sung-h;
                    text: row.text;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.font-size;
                    font-weight: parent.is-sung ? 700 : 400;
                    color: parent.is-sung
                        ? Player.np-on-backdrop
                        : Player.np-on-backdrop-muted.transparentize(0.2);
                }

                // Empty for a Latin line and while the toggle is off, `romanization_line_count`
                // being 0 with it, so this collapses to nothing rather than needing a branch of
                // its own. Anchored under the words rather than off the bottom: it is the middle
                // part now, and only the last of the three can measure back from the far edge.
                Text {
                    x: Lyrics.row-pad;
                    y: parent.sung-h + Lyrics.romanization-gap;
                    width: parent.width - 2 * Lyrics.row-pad;
                    height: parent.roman-h;
                    text: row.romanization;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.romanization-font-size;
                    // Sung along to rather than read, so it keeps the sung line's own colour and
                    // sits one step back from it while the line is not being sung.
                    color: parent.is-sung
                        ? Player.np-on-backdrop.transparentize(0.15)
                        : Player.np-on-backdrop-muted.transparentize(0.3);
                }

                // Empty where the sheet carries no gloss, and `translation_line_count` is 0 with
                // it, so this collapses to nothing rather than needing a branch of its own.
                // Bottom-anchored, which is what keeps the gap spelled in one place.
                Text {
                    x: Lyrics.row-pad;
                    y: parent.height - parent.gloss-h;
                    width: parent.width - 2 * Lyrics.row-pad;
                    height: parent.gloss-h;
                    text: row.translation;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Lyrics.translation-font-size;
                    // A gloss, so it follows the sung line without ever competing with it: no
                    // weight of its own, and a step further back while the line is not sung.
                    color: parent.is-sung
                        ? Player.np-on-backdrop-muted
                        : Player.np-on-backdrop-muted.transparentize(0.45);
                }
            }
        }
    }

    // **One area for the whole sheet, doing both jobs.** It sits over the scroller either way, so
    // a per-row area could never have received the click anyway — the reason clicking a line did
    // nothing at all. Which row a point lands in is arithmetic over the offset table Rust already
    // keeps, so asking it is cheaper than N areas *and* cannot disagree with the highlight.
    //
    // The wheel is rejected so the scroller still gets it: that half only notices.
    touch := TouchArea {
        width: 100%;
        height: 100%;
        // The whole sheet is a seek target on a timed one; an untimed sheet has nowhere to send
        // the player, so it must not look like it does.
        mouse-cursor: Lyrics.synced ? MouseCursor.pointer : MouseCursor.default;
        scroll-event(event) => {
            root.suspend-ticks = root.suspend-ticks-total;
            // The reader just moved one end of the distance the tick's cadence is gauged on.
            root.settled = false;
            return reject;
        }
        // `moved` fires only while pressed, so hover tracking goes through the pointer stream —
        // the same arm Slint's own menu uses to follow a pointer across its entries.
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                Lyrics.hover-at(self.mouse-y - sv.viewport-y);
            }
        }
        clicked => {
            if (Lyrics.synced) {
                // Into the scrolled content's own coordinates; `viewport-y` runs negative.
                Lyrics.seek-at(self.mouse-y - sv.viewport-y);
                // And the seek moves the other end of it.
                root.settled = false;
            }
        }
    }

    bar := OverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: Theme.scrollbar-slot;
        height: parent.height;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        track-color: Player.np-accent-bright;
        track-opacity: 0.25;
        track-opacity-active: 0.4;
        thumb-color: Player.np-accent-dim;
        thumb-active-color: Player.np-accent-bright.transparentize(0.2);
        scroll-to(o) => { sv.viewport-y = -o; }
    }

    // Whether the song is moving under the sheet, so the sung line has to be re-asked for often.
    property <bool> following: root.has-rows && Lyrics.synced && Player.vm.is_playing;

    // Whether the glide has reached the sung line, so the panel has nothing left to do between
    // position ticks. **Written by the tick below, never bound to the distance**, and that is not
    // a style choice: a `Timer`'s `interval` is evaluated through a change tracker Slint
    // initialises while this branch is *mounted*, which is inside the parent's layout pass, so a
    // binding reaching a layout property from there — `target-y` reads the scroller's height —
    // recurses into the very layout doing the mounting and panics. The handler may read the same
    // property freely, running nowhere near that pass.
    //
    // Starts false: the panel mounts at the top of a sheet it has not caught up with.
    property <bool> settled;

    // **One timer on two cadences**, the visualizer strip's `dormant ? 500ms : 33ms` shape. It
    // exists only while this branch is mounted, which is what keeps all of it off every other
    // view, and it drops to a crawl once the song and the scroll are both still. The slow cadence
    // still runs because the width has to reach Rust and has to survive a window resize, and a
    // `changed` handler on a layout property is the one thing this component may not carry.
    //
    // **The catch-up half earns the fast cadence as much as the transport does**: a paused song
    // never moves the target, but a panel that has just mounted, or that a reader has scrolled
    // away from, is nowhere near it, and a quarter of the distance per *second* is a crawl. The
    // `has-rows` term is what keeps a panel with nothing to draw on the slow one.
    Timer {
        interval: root.following || (root.has-rows && !root.settled) ? 33ms : 1s;
        running: true;
        triggered => {
            Lyrics.report-width(
                sv.visible-width - Theme.scrollbar-slot - 2 * Lyrics.row-pad);
            if (!root.has-rows) {
                return;
            }
            // **Not gated on the transport.** A paused song still has a line it is holding at, and
            // this branch is rebuilt, sheet and all, every time the column swaps back to it — so
            // without a tick of its own a paused panel draws a page with nothing marked on it
            // until playback resumes.
            Lyrics.tick();
            // A plain sheet, or the run-in before the first stamp: nothing to centre on, and the
            // reader owns the scroll in both.
            if (Lyrics.active-index < 0) {
                root.settled = true;
                return;
            }

            // The bar is polled rather than watched, a `changed dragging` being the tracker this
            // component must not carry.
            if (bar.dragging) {
                root.suspend-ticks = root.suspend-ticks-total;
            }
            if (root.suspend-ticks > 0) {
                root.suspend-ticks -= 1;
                // Keep the eased position with the reader, so resuming glides from where they
                // left the panel rather than from where the song was.
                root.scroll-y = -sv.viewport-y;
            } else {
                root.scroll-y += (root.target-y - root.scroll-y) * root.follow-step;
                sv.viewport-y = -root.scroll-y;
            }
            root.settled = abs(root.target-y - root.scroll-y) <= 1px;
        }
    }

    // The five states with nothing to draw. The centred block is the Up Next list's, not
    // `GridEmptyState`, whose opaque `Theme.base` would punch a hole in the backdrop.
    if !root.has-rows: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: Theme.pad-sm;
                HorizontalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: Lyrics.state == LyricsState.instrumental ? "music_note"
                            : Lyrics.state == LyricsState.unavailable ? "cloud_off"
                            : "lyrics";
                        icon-size: 40px;
                        icon-color: Player.np-on-backdrop-muted.transparentize(0.5);
                    }
                }
                Text {
                    text: Lyrics.state == LyricsState.loading ? @tr("Looking for lyrics…")
                        : Lyrics.state == LyricsState.instrumental ? @tr("This track has no words")
                        : Lyrics.state == LyricsState.missing ? @tr("No lyrics found")
                        : Lyrics.state == LyricsState.unavailable ? @tr("Couldn't reach the lyrics service")
                        : Lyrics.state == LyricsState.off ? @tr("Lyrics lookup is off")
                        : @tr("Play something to see its lyrics");
                    color: Player.np-on-backdrop-muted;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // The two states a reader can act on from here, and each says how.
                if Lyrics.state == LyricsState.off: Text {
                    text: @tr("Turn it on under Settings ▸ Services");
                    color: Player.np-on-backdrop-muted.transparentize(0.35);
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if Lyrics.state == LyricsState.unavailable: Text {
                    text: @tr("Try again from the ⋮ menu");
                    color: Player.np-on-backdrop-muted.transparentize(0.35);
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
