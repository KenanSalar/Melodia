import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { ArtworkImage } from "../artwork-image.slint";

// The now-playing tile for a track or a station, so the bar and the miniplayer make the split
// once. A logoless station paints the stops and initials its card and hero do.
//
// No `native-size`: `media::image::logo_tile::MIN_LOGO_DIM` is 32 px and the thumbnails mounting
// this draw under twice that, so `ArtworkImage`'s inset arm can't fire. The large tiles ask it
// themselves.
export component SourceArtwork inherits ArtworkImage {
    // The track placeholder's, so a host on an artwork backdrop can hand over its solved accent;
    // a station's colours are its own. Defaults restate `ArtworkImage`'s, so change those first.
    in property <brush> track-tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> track-tile-icon-color: Theme.accent;

    artwork-path: Player.vm.has_station
        ? Player.vm.radio.artwork_path
        : Player.vm.track.artwork_path;
    cover: Player.vm.has_station ? Player.vm.radio.logo_img : Player.vm.track.cover_img;
    fallback-text: Player.vm.has_station ? Player.vm.radio.monogram : "";
    // For a station name with no letters to take initials from.
    fallback-icon: Player.vm.has_station ? "radio" : "music-note";
    tile-bg: Player.vm.has_station
        ? @linear-gradient(135deg, Player.vm.radio.tile_color_1, Player.vm.radio.tile_color_2)
        : root.track-tile-bg;
    tile-icon-color: Player.vm.has_station ? Theme.tile-ink : root.track-tile-icon-color;
}
