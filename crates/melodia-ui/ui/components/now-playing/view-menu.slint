import { Theme } from "../../theme.slint";
import { Visualizer } from "../../globals/audio.slint";
import { PopupHighlight } from "../../globals/shell.slint";
import { AccentDiscButton } from "./accent-disc-button.slint";
import { MenuSurface } from "./menu-surface.slint";
import { PopupDismissCatcher } from "./popup-dismiss-catcher.slint";
import { OverflowRow } from "./overflow-row.slint";
import { VisualizerFlyout } from "./visualizer-flyout.slint";
import { FlyoutMetrics, VizStylePresets } from "./flyout-presets.slint";

// The Now-Playing view's own menu, top right beside the favourite heart.
// Structurally the bar's `overflow-menu.slint` mirrored on the vertical axis: a
// fixed-reserve PopupWindow holding a menu column and a flyout column with a
// transparent catcher over the gaps, but with the trigger at the *top* of the
// view, so it opens downward and both columns are top-anchored.
//
// Tinted off the same accent as the back button and the heart, so the top bar
// reads as one family against the artwork blur.
export component NowPlayingViewMenu inherits Rectangle {
    width: btn.width;
    height: btn.height;

    // Reset to collapsed on every reopen, and by `dismiss()`.
    property <bool> viz-flyout-open: false;

    // The close triple every path needs. A function rather than a callback
    // because the rows invoke it and nothing subscribes to it.
    public function dismiss() {
        pop.close();
        root.viz-flyout-open = false;
        PopupHighlight.id = "";
    }

    // The width lives on the PopupWindow instead — an enclosing component may
    // not read a property declared *inside* one.
    property <length> menu-h: FlyoutMetrics.menu-row-h + FlyoutMetrics.chrome-h;

    // Derived from the shared style list plus the leading "Off" row, so adding
    // a style can't clip the popup.
    property <length> flyout-w: 140px;
    property <length> flyout-h:
        FlyoutMetrics.option-row-h * (VizStylePresets.viz-style-names.length + 1)
        + FlyoutMetrics.chrome-h;
    // Keeps the two columns reading as separate floating chromes.
    property <length> gap: 8px;

    btn := AccentDiscButton {
        icon: "more_vert";
        press-shrink: true;
        // No tooltip — neither of the two buttons flanking it has one.
        //
        // The disc stays highlighted while the popup is open; any close path
        // below clears it, as does the AppWindow scrim on an outside click.
        force-bg: PopupHighlight.id == "np-view-menu";
        clicked => {
            // Always (re)open collapsed.
            root.viz-flyout-open = false;
            PopupHighlight.id = "np-view-menu";
            pop.show();
        }
    }

    pop := PopupWindow {
        // Here rather than up top, so it can read its own descendant's
        // `preferred-width`; the row's content sets the floor, plus the surface
        // border, over a minimum that preserves the English look.
        property <length> menu-w: max(180px, menu-vl.preferred-width + 2px);

        // Fixed reserve, the volume-popup pattern: always big enough for both
        // columns, so expanding the flyout re-lays out nothing. The menu
        // column's screen position cancels `self.width` on both sides, so it
        // stays pinned under the trigger either way.
        width: root.flyout-w + root.gap + self.menu-w;
        height: max(root.menu-h, root.flyout-h);
        x: btn.width - self.width;
        // Downward, unlike the bar's overflow menu.
        y: btn.height + 8px;
        close-policy: close-on-click-outside;

        PopupDismissCatcher {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.dismiss();
            }
        }

        // Left column, top-aligned with the menu and growing downward. Mounted
        // only while open, so its rows aren't built when collapsed.
        if root.viz-flyout-open: VisualizerFlyout {
            x: 0;
            y: 0;
            width: root.flyout-w;
            height: root.flyout-h;
            viz-enabled: Visualizer.enabled;
            current-index: Visualizer.style-idx;
            pick(i) => {
                if (i < 0) {
                    // Both halves — the binding lands the value for the Settings
                    // toggle and for the mirror that disarms the tap, the
                    // callback persists it.
                    Visualizer.enabled = false;
                    Visualizer.set-enabled(false);
                } else {
                    if (!Visualizer.enabled) {
                        Visualizer.enabled = true;
                        Visualizer.set-enabled(true);
                    }
                    Visualizer.set-style(i);
                }
                root.dismiss();
            }
        }

        MenuSurface {
            popup-id: "np-view-menu";
            x: parent.width - pop.menu-w;
            y: 0;
            width: pop.menu-w;
            height: root.menu-h;
            close-requested => {
                root.dismiss();
            }

            menu-vl := VerticalLayout {
                padding: Theme.pad-xs;
                spacing: 0;

                // Doesn't close the popup, so it re-asserts the highlight id the
                // winit Release clear would otherwise take the watcher with.
                OverflowRow {
                    icon: "bar_chart";
                    label: @tr("Visualizer");
                    trailing-text: Visualizer.enabled
                        ? VizStylePresets.viz-style-names[
                            clamp(Visualizer.style-idx, 0,
                                  VizStylePresets.viz-style-names.length - 1)]
                        : @tr("Off");
                    trailing-icon: "chevron_left";
                    active: root.viz-flyout-open;
                    clicked => {
                        root.viz-flyout-open = !root.viz-flyout-open;
                        PopupHighlight.id = "np-view-menu";
                    }
                }
            }
        }
    }
}
