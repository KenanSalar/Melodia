import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { HeroBlurBackdrop } from "../hero-blur-backdrop.slint";
import { AuroraBackdrop } from "../aurora-backdrop.slint";

// `HeroBackdropStack`'s sibling on the `Player.np-*` tier, for Now Playing and the miniplayer,
// which are never on screen together. Both floor stops come from Rust rather than a `Theme.accent`
// mix: an art-less track's title sits on them, its foreground solved light.
export component NpBackdropStack inherits Rectangle {
    // Now Playing leaves it defaulted; the miniplayer drains through it before unmounting.
    in property <bool> shown: true;

    // Named once, so the two gates can't come to disagree.
    property <bool> aurora-shown: Theme.aurora-backdrop;

    if !root.aurora-shown: HeroBlurBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        floor-start: Player.np-floor-start;
        floor-end: Player.np-floor-end;
        scrim: Player.np-scrim;
        blur-a: Player.blur-img-a;
        blur-b: Player.blur-img-b;
        use-a: Player.blur-use-a;
        // The slots fade on `has-blur` alone, so without `shown` a drain leaves the cover at full
        // strength to pop off on unmount.
        has-blur: Player.blur-has-image && root.shown;
        shown: root.shown;
    }

    if root.aurora-shown: AuroraBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        base-start: Player.np-floor-start;
        base-end: Player.np-floor-end;
        tint-1: Player.np-tint-1;
        tint-2: Player.np-tint-2;
        tint-3: Player.np-tint-3;
        dither: Player.np-dither;
        shown: root.shown;
    }
}
