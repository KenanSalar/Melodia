import { Theme } from "../../theme.slint";
import { Lyrics } from "../../globals/lyrics.slint";
import { Player } from "../../globals/player.slint";
import { ToggleSwitch } from "../settings/toggle-switch.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";
import { TuckedFill } from "../tucked-fill.slint";
import { LyricsMenu } from "./lyrics-menu.slint";

// The lyrics menu and the switch that mounts the panel, on one pill. The switch is the whole
// feature's on/off, so a column showing Up Next looks nothing up. The pill makes the glyph read as
// the switch's, which explains a glyph that does nothing while it's off; grouping rather than a
// control, it answers no pointer.
export component LyricsControls inherits Rectangle {
    border-radius: self.height / 2;
    // So a fill this faint keeps a shape against a busy backdrop.
    border-width: 1px;
    border-color: Player.np-accent-bright.transparentize(0.8);

    // A step over `np-accent-dim`, both losing contrast to the pill. One spelling for the glyph and
    // the thumb, so they read as one control switched off.
    property <brush> off-fg: Player.np-accent-bright.transparentize(0.3);
    property <brush> off-track: Player.np-accent-bright.transparentize(0.76);

    // Tucked, the border being translucent (`ui-patterns.md`'s `TuckedFill`). `x`/`y` keep it out
    // of the root's size.
    TuckedFill {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        radius: root.border-radius;
        stroke-width: root.border-width;
        fill: Player.np-accent-bright.transparentize(0.9);
    }

    HorizontalLayout {
        // The glyph's slot margin, mirrored, so the switch's end is concentric with the pill's.
        padding-right: (menu.height - menu.glyph-size) / 2;
        spacing: Theme.pad-xs;
        cross-axis-alignment: center;

        menu := LyricsMenu {
            off-fg: root.off-fg;
        }

        lyrics-switch := ToggleSwitch {
            height: menu.glyph-size;
            // The property swaps the column on the click, the callback persists it.
            checked <=> Lyrics.enabled;
            toggled(on) => {
                Lyrics.set-enabled(on);
            }

            track-on: Player.np-accent-bright;
            track-off: root.off-track;
            thumb-on: Theme.ink-on(Player.np-accent-bright);
            thumb-off: root.off-fg;
            on-backdrop: true;

            // Below and end-aligned, on the panel's top and right edges.
            Tooltip {
                text: @tr("Show lyrics");
                hovered: lyrics-switch.has-hover;
                host-width: lyrics-switch.width;
                host-height: lyrics-switch.height;
                side: TooltipSide.below;
                align-end: true;
            }
        }
    }
}
