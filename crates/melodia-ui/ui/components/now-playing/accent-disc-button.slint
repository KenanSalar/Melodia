import { Player } from "../../globals/player.slint";
import { IconButton } from "../icon-button.slint";

// The Now-Playing view's back button, tinted off the artwork accent. Only the disc is
// translucent. `hover-bg` is set beside `idle-bg`, its default being an opaque theme surface.
export component AccentDiscButton inherits IconButton {
    diameter: 36px;
    icon-size: 22px;
    idle-bg: Player.np-accent-pill;
    hover-bg: Player.np-accent-disc-hover;
    idle-fg: Player.np-accent-bright;
    hover-fg: Player.np-accent-bright;
    on-backdrop: true;
}
