import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { PopupSurface } from "../popup-surface.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";
import { PopupDismissCatcher } from "../popup-dismiss-catcher.slint";
import { SliderPointer } from "../slider-pointer.slint";
import { VolumeTrigger } from "volume-trigger.slint";

// A `VolumeTrigger` and a popup holding a Material 3 vertical slider, its percentage read out to
// the left. The popup is wider than the slider's chrome, the transparent strip holding the
// readout, a popup's content being unable to draw outside its rectangle.
export component VolumePopup inherits Rectangle {
    in property <length> diameter: 36px;
    in property <length> icon-size: 22px;
    // The trigger's only: the popup floats on `Theme.crust` whatever the surface behind the button.
    in property <brush> trigger-fg: Theme.text;
    in property <brush> trigger-hover-fg: root.trigger-fg;
    in property <brush> trigger-hover-bg: Theme.surface0;
    in property <duration> trigger-recolor-duration: Theme.dur-fast;

    width: trigger.width;
    height: trigger.height;

    trigger := VolumeTrigger {
        diameter: root.diameter;
        icon-size: root.icon-size;
        fg: root.trigger-fg;
        hover-fg: root.trigger-hover-fg;
        hover-bg: root.trigger-hover-bg;
        recolor-duration: root.trigger-recolor-duration;
        popup-open: pop.is-open;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        // The chrome centred on the button; matching edges would pull it off the glyph's axis.
        x: (trigger.width + chrome.width) / 2 - self.width;
        y: -self.height - Theme.popup-gap;
        width: 92px;
        height: 180px;
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { pop.close(); }
        }

        // The empty strip is inside the popup, so it closes nothing on its own.
        PopupDismissCatcher {
            x: 0;
            y: 0;
            width: parent.width - chrome.width;
            height: parent.height;
            close-requested => { pop.close(); }
        }

        chrome := PopupSurface {
            x: parent.width - self.width;
            y: 0;
            width: 40px;
            height: parent.height;
            pill: true;

            slider := Rectangle {
                x: 0;
                y: Theme.pad-md;
                width: parent.width;
                height: parent.height - 2 * Theme.pad-md;

                property <float> frac: clamp(Player.vm.volume / 100, 0, 1);
                // Two bars meeting at the thumb's centre, which blankets the seam, so neither
                // extreme needs a threshold. The thumb halves while pressed, as Material 3's does.
                property <length> track-w: 8px;
                property <length> thumb-w: 24px;
                property <length> thumb-h: vol-touch.pressed ? 2px : 4px;
                // A fixed mask, so the gap either side of the thumb grows as it shrinks on press.
                property <length> thumb-bg-w: self.thumb-w;
                property <length> thumb-bg-h: 12px;
                property <length> stop-d: 4px;
                // Inside the bar's top hemisphere, so it reads as the end cap.
                property <length> stop-y: 3px;

                property <length> track-cx: self.width / 2;
                // Against the rest height, not the animated one, which would pin one edge at the
                // extremes and shrink the thumb lopsided.
                property <length> thumb-cy:
                    (1 - self.frac) * (self.height - 4px) + 2px;
                property <length> thumb-y: self.thumb-cy - self.thumb-h / 2;
                property <length> inactive-h: self.thumb-cy;
                property <length> active-h: self.height - self.thumb-cy;

                animate thumb-h { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }

                Rectangle {
                    x: parent.track-cx - parent.track-w / 2;
                    y: 0;
                    width: parent.track-w;
                    height: parent.inactive-h;
                    border-radius: self.width / 2;
                    background: Theme.surface1;
                }

                Rectangle {
                    x: parent.track-cx - parent.track-w / 2;
                    y: parent.thumb-cy;
                    width: parent.track-w;
                    height: parent.active-h;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }

                // The mask drawn after it hides the dot behind the thumb rather than fading it.
                Rectangle {
                    x: parent.track-cx - parent.stop-d / 2;
                    y: parent.stop-y;
                    width: parent.stop-d;
                    height: parent.stop-d;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }

                // Parts the bars without a geometric gap, so near either end it only covers more
                // of the remnant.
                Rectangle {
                    x: parent.track-cx - parent.thumb-bg-w / 2;
                    y: parent.thumb-cy - parent.thumb-bg-h / 2;
                    width: parent.thumb-bg-w;
                    height: parent.thumb-bg-h;
                    border-radius: self.height / 2;
                    background: Theme.crust;
                }

                Rectangle {
                    x: parent.track-cx - parent.thumb-w / 2;
                    y: parent.thumb-y;
                    width: parent.thumb-w;
                    height: parent.thumb-h;
                    border-radius: self.height / 2;
                    background: Theme.accent;
                }

                // So a drag emits once per step rather than per pixel. Forgotten at the commit:
                // the volume can move from outside while the popup is up.
                property <int> last-emitted: -1;
                function emit-volume(v: int) {
                    if (v != self.last-emitted) {
                        self.last-emitted = v;
                        Player.set-volume(v);
                    }
                }

                // The mask is the grab band, being the thumb as the eye reads it.
                vol-touch := SliderPointer {
                    orientation: Orientation.vertical;
                    thumb-center: parent.thumb-cy;
                    grab-half: parent.thumb-bg-h / 2;
                    changed(v) => { slider.emit-volume(round(v * 100)); }
                    committed(v) => {
                        slider.last-emitted = -1;
                        Player.commit-volume();
                    }
                    scroll-event(event) => { return Player.wheel-volume(event); }
                }
            }
        }

        // A zero-size anchor level with the thumb, so the readout hangs off the value it shows.
        Rectangle {
            x: chrome.x;
            y: chrome.y + slider.y + slider.thumb-cy;
            width: 0px;
            height: 0px;

            Tooltip {
                text: round(Player.vm.volume) + "%";
                host-width: 0px;
                host-height: 0px;
                side: TooltipSide.left;
                gap: 10px;
                in-popup: true;
                // Up on the frame the drag starts, with no reveal delay.
                force-shown: vol-touch.has-hover || vol-touch.pressed;
            }
        }
    }
}
