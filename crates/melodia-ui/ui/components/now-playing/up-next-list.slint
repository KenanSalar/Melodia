import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Queue, NowPlaying } from "../../globals/queue.slint";
import { ListTravel } from "../../globals/list-travel.slint";
import { DragOrigin } from "../../globals/drag.slint";
import { QueueRow } from "../../models.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { ContextClick } from "../context-menu.slint";
import { DragSource } from "../drag-source.slint";
import { ListDropTarget } from "../list-drop-target.slint";
import { TrackContextMenu } from "../track-list/track-context-menu.slint";
import { NpOverlayScrollbar } from "np-overlay-scrollbar.slint";
import { NpEmptyState } from "np-empty-state.slint";

// One Up Next row, the same cells at two scales so a track reads alike in the miniplayer and
// full-screen. The palette is the host's and not tied to the scale (`UpNextList`); the hover flips
// without an `animate`, an eased fade reading as lag across rows.
component UpNextRow inherits Rectangle {
    in property <QueueRow> data;
    in property <bool> compact;
    in property <brush> ink;
    in property <brush> ink-muted;
    in property <brush> row-hover;
    // The host's, so the row and the slide can't disagree.
    in property <length> row-height;
    // -1 on the outgoing row, whose place it can no longer skip to, so nothing on it acts.
    in property <int> play-index: -1;
    in property <bool> menu-enabled;
    in property <bool> lifted;

    callback pressed();

    height: row-height;

    property <length> pad-v: compact ? Theme.pad-xs : Theme.pad-sm;
    // Every hover binding reads this, so the row stays lit under its own menu.
    property <bool> hovered: touch.has-hover || ctx-menu.is-open;
    // Through the brushes, `opacity` holding a layer for the length of the drag.
    property <float> fade: root.lifted ? Theme.fade-lifted : 1.0;

    Rectangle {
        background: root.hovered ? root.row-hover.transparentize(1.0 - root.fade) : transparent;
        border-radius: Theme.radius-md;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            padding-top: root.pad-v;
            padding-bottom: root.pad-v;
            spacing: Theme.pad-sm;
            alignment: stretch;

            ArtworkImage {
                cross-axis-self-alignment: center;
                artwork-path: root.data.artwork_path;
                cover: NowPlaying.request-cover(root.data.artwork_path);
                tile-size: compact ? 34px : 38px;
                tile-radius: Theme.radius-md;
                fade: root.fade;
            }

            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "‎" + root.data.title;
                        color: root.ink.transparentize(1.0 - root.fade);
                        font-size: Theme.font-size-row;
                        overflow: elide;
                    }
                    Text {
                        text: "‎" + root.data.artist;
                        color: root.ink-muted.transparentize(1.0 - root.fade);
                        font-size: Theme.font-size-sm;
                        overflow: elide;
                        visible: root.data.artist != "";
                    }
                }
            }

            Text {
                text: root.data.display_duration;
                color: root.ink-muted.transparentize(1.0 - root.fade);
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.play-index >= 0) {
                    Queue.skip-to(root.play-index);
                }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.pressed();
                }
                if (root.menu-enabled
                    && ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    ctx-menu.show-at(self.mouse-x, self.mouse-y);
                }
            }
        }

        ctx-menu := TrackContextMenu {
            row-id: root.data.id;
            row-is-favorite: root.data.is_favorite;
            row-rating: root.data.rating;
            row-selected: false;
            album-id: root.data.album_id;
            artist-id: root.data.artist_id;
            genre-id: root.data.genre_id;
            view-context: "up-next";
            selection-count: 0;

            play-single => { Queue.skip-to(root.play-index); }
            toggle-favorite(ids, on) => { Queue.toggle-row-favorite(ids, on); }
            rate(ids, n) => { Queue.set-row-rating(ids, n); }
            request-remove(ids) => { Queue.remove(root.play-index); }
        }
    }
}

// Up Next, in the full view and the miniplayer but never both at once: entering the miniplayer
// closes Now Playing, so one slide timer runs.
//
// The palette isn't the scale's: the miniplayer is compact with or without its backdrop and hands
// over these tiers or the neutral list palette. The hover too, the accent being solved light for
// the blur and no hover at all on a light theme's mantle.
export component UpNextList inherits Rectangle {
    in property <bool> compact;
    // The miniplayer's sheet has no room for a menu.
    in property <bool> menu-enabled: true;
    in property <brush> ink: Player.np-on-backdrop;
    in property <brush> ink-muted: Player.np-on-backdrop-muted;
    in property <brush> row-hover: Player.np-accent-pill;
    in property <brush> empty-ink: Player.np-on-backdrop-muted;
    in property <brush> empty-glyph: Player.np-on-backdrop-muted.transparentize(0.5);
    // A flag and a pace rather than brushes: `OverlayScrollbar` eases its own colours.
    in property <bool> bar-on-backdrop: true;
    in property <duration> bar-recolor-duration: Theme.dur-fast;
    // Wider than `scrollbar-width`, or the row hover paints under the bar. The rest keeps the rows
    // off the window's right-edge resize band.
    in property <length> list-inset-right: compact ? 12px : 20px;
    // The full host's extra is hit-test margin; the compact sheet has no room for the slot.
    in property <length> scrollbar-width: compact ? 8px : Theme.scrollbar-slot;

    // Handed to every row and to the slide, so the two can't drift.
    property <length> row-h: compact ? 46px : 52px;
    property <int> slide-frames: 18;         // ~288ms at 16ms
    property <float> slide-raw: clamp(1.0 * NowPlaying.slide-phase / root.slide-frames, 0.0, 1.0);
    // Ease-out cubic, so the row decelerates into place.
    property <float> slide-p:
        1.0 - (1.0 - root.slide-raw) * (1.0 - root.slide-raw) * (1.0 - root.slide-raw);

    // Rust restarts it by resetting the phase to 0.
    slide-timer := Timer {
        interval: 16ms;
        running: NowPlaying.slide-phase < root.slide-frames;
        triggered => {
            NowPlaying.slide-phase += 1;
        }
    }

    clip: true;

    // Absolute, so its `y` can carry the slide without fighting a layout.
    src := DragSource {
        origin: DragOrigin.up-next;
        allow-move: true;
        x: 0;
        // One row off rest on a track change: forward slides up, rewound slides down.
        y: NowPlaying.slide-direction * (1.0 - root.slide-p) * root.row-h;
        width: parent.width - root.list-inset-right;
        // Only as tall as its rows, so the space under a short queue stays the miniplayer's window
        // grab (`slint-pitfalls.md`'s in-window drag entry).
        height: min(parent.height, NowPlaying.up-next-rows.length * root.row-h);

        up-next-list := ListView {
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            // A pin, not an override (`slint-pitfalls.md`'s drag-pan entry).
            mouse-drag-pan-enabled: false;
            width: 100%;
            height: 100%;
            for row[idx] in NowPlaying.up-next-rows: UpNextRow {
                data: row;
                compact: root.compact;
                ink: root.ink;
                ink-muted: root.ink-muted;
                row-hover: root.row-hover;
                row-height: root.row-h;
                // Modulo the queue, the list wrapping past the end under repeat-all.
                play-index: Math.mod(NowPlaying.base-index + idx, NowPlaying.queue-length);
                menu-enabled: root.menu-enabled;
                lifted: src.lifts(idx);
                pressed => { src.arm(idx); }
            }
        }
    }

    // The row that just left: off the top going forward, off the bottom going back.
    UpNextRow {
        visible: NowPlaying.outgoing-visible
                 && NowPlaying.slide-phase < root.slide-frames;
        x: 0;
        width: parent.width - root.list-inset-right;
        compact: root.compact;
        ink: root.ink;
        ink-muted: root.ink-muted;
        row-hover: root.row-hover;
        row-height: root.row-h;
        y: NowPlaying.slide-direction == 1
            ? -root.slide-p * root.row-h
            : parent.height - (1.0 - root.slide-p) * root.row-h;
        data: NowPlaying.outgoing-row;
    }

    ListDropTarget {
        x: src.x;
        y: src.y;
        width: src.width;
        // The full height, so a drop below the rows lands at the end; a `DropArea` passes presses
        // through to the window grab.
        height: parent.height;
        origin: DragOrigin.up-next;
        row-height: root.row-h;
        row-count: NowPlaying.up-next-rows.length;
        content-y: up-next-list.content-y;
        // The repeat-all wrap, which `up_next::play_order_move` refuses a move across.
        split-row: NowPlaying.queue-length - NowPlaying.base-index;
        line-color: root.ink;
        reorder(from, to) => { NowPlaying.reorder(from, to); }
        scroll-by(dy) => {
            up-next-list.content-y = ListTravel.pin(
                up-next-list.content-y - dy,
                up-next-list.visible-height,
                up-next-list.content-height);
        }
    }

    NpOverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: root.scrollbar-width;
        height: parent.height;
        on-backdrop: root.bar-on-backdrop;
        recolor-duration: root.bar-recolor-duration;
        visible-size: up-next-list.visible-height;
        content-size: up-next-list.content-height;
        offset: -up-next-list.content-y;
        scroll-to(o) => { up-next-list.content-y = -o; }
    }

    if NowPlaying.up-next-rows.length == 0: NpEmptyState {
        glyph: "queue_music";
        heading: @tr("No tracks up next");
        compact: root.compact;
        ink: root.empty-ink;
        glyph-color: root.empty-glyph;
        wrap: no-wrap;
    }
}
