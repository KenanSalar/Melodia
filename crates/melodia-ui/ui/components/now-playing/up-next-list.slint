import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Queue, NowPlaying } from "../../globals/queue.slint";
import { ListTravel } from "../../globals/list-travel.slint";
import { DragOrigin } from "../../globals/drag.slint";
import { QueueRow } from "../../models.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { ContextClick } from "../context-menu.slint";
import { DragSource } from "../drag-source.slint";
import { ListDropTarget } from "../list-drop-target.slint";
import { TrackContextMenu } from "../track-list/track-context-menu.slint";
import { NpOverlayScrollbar } from "np-overlay-scrollbar.slint";
import { NpEmptyState } from "np-empty-state.slint";

// One row inside the Up Next list. The two variants differ only in scale and palette — same three
// cells, same typography — so a track reads the same way in the miniplayer as full-screen.
//
// **Scale** comes from the host, one source of truth shared with the slide animation, and the tile
// and padding step down with it: the miniplayer sits tighter so more of the queue fits, but not so
// much tighter that it becomes a different list.
//
// **Palette is the host's, and deliberately not tied to the scale**: the list hands every row the
// same three brushes, which `UpNextList` argues. Nothing here eases them, and the hover flips
// without an `animate` like the track rows, where an eased fade reads as lag when crossing rows.
component UpNextRow inherits Rectangle {
    in property <QueueRow> data;
    in property <bool> compact;
    in property <brush> ink;
    in property <brush> ink-muted;
    in property <brush> row-hover;
    // Owned by the host so the row and the slide animation can't disagree
    // about how tall a row is.
    in property <length> row-height;
    // Where the row sits in play order. The outgoing row names none, the place it showed being one
    // it can no longer skip to, so nothing on it acts.
    in property <int> play-index: -1;
    // Whether the row raises the queue's menu.
    in property <bool> menu-enabled;
    // The row the list's drag picked up.
    in property <bool> lifted;

    // A left press, which is what a drag from the row would carry.
    callback pressed();

    height: row-height;

    property <length> pad-v: compact ? Theme.pad-xs : Theme.pad-sm;
    // What every hover-driven binding reads, so the row stays lit under its own menu.
    property <bool> hovered: touch.has-hover || ctx-menu.is-open;
    // The lifted row dims through its brushes rather than `opacity`, which would render it into a
    // layer for the length of the drag.
    property <float> fade: root.lifted ? Theme.fade-lifted : 1.0;

    Rectangle {
        background: root.hovered ? root.row-hover.transparentize(1.0 - root.fade) : transparent;
        border-radius: Theme.radius-md;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            padding-top: root.pad-v;
            padding-bottom: root.pad-v;
            spacing: Theme.pad-sm;
            alignment: stretch;

            ArtworkImage {
                cross-axis-self-alignment: center;
                artwork-path: root.data.artwork_path;
                cover: NowPlaying.request-cover(root.data.artwork_path);
                tile-size: compact ? 34px : 38px;
                tile-radius: Theme.radius-md;
                fade: root.fade;
            }

            // Clips bidi overflow so elide fires — the bar's track-info pattern.
            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "‎" + root.data.title;
                        color: root.ink.transparentize(1.0 - root.fade);
                        font-size: Theme.font-size-row;
                        overflow: elide;
                    }
                    Text {
                        text: "‎" + root.data.artist;
                        color: root.ink-muted.transparentize(1.0 - root.fade);
                        font-size: Theme.font-size-sm;
                        overflow: elide;
                        visible: root.data.artist != "";
                    }
                }
            }

            Text {
                text: root.data.display_duration;
                color: root.ink-muted.transparentize(1.0 - root.fade);
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.play-index >= 0) {
                    Queue.skip-to(root.play-index);
                }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.pressed();
                }
                if (root.menu-enabled
                    && ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    ctx-menu.show-at(self.mouse-x, self.mouse-y);
                }
            }
        }

        // The queue panel's menu without its picks, Up Next selecting nothing; `"up-next"` drops
        // the selection group with Play Next and Add to Queue.
        ctx-menu := TrackContextMenu {
            row-id: root.data.id;
            row-is-favorite: root.data.is_favorite;
            row-rating: root.data.rating;
            row-selected: false;
            album-id: root.data.album_id;
            artist-id: root.data.artist_id;
            genre-id: root.data.genre_id;
            view-context: "up-next";
            selection-count: 0;

            play-single => { Queue.skip-to(root.play-index); }
            toggle-favorite(ids, on) => { Queue.toggle-row-favorite(ids, on); }
            rate(ids, n) => { Queue.set-row-rating(ids, n); }
            request-remove(ids) => { Queue.remove(root.play-index); }
        }
    }
}

// The list itself: advance-by-row slide, outgoing-row overlay, overlay scrollbar and
// empty state, all off the same `NowPlaying` data for both surfaces.
//
// **Two hosts mount it but never at once**: entering the miniplayer force-closes
// `Nav.now-playing-open`, so only one local slide timer ever runs.
//
// Row height, scrollbar slot, list inset and the empty glyph all key off `compact`, so a caller
// threads one property rather than five.
//
// **The palette is not the scale's, and every colour defaults to the backdrop tiers** the full view
// paints on. The miniplayer is compact whether or not it paints its own backdrop, and hands over
// either those tiers or the neutral list palette, easing between them. That includes the row
// hover: the Now-Playing accent is always solved *light* for the blur, and a light tint on a light
// theme's mantle is no hover indication at all.
export component UpNextList inherits Rectangle {
    in property <bool> compact;
    // Whether the rows raise the queue's menu, which the miniplayer's sheet has no room for.
    in property <bool> menu-enabled: true;
    in property <brush> ink: Player.np-on-backdrop;
    // The artist and the duration. Off a backdrop a host takes `Theme.text` here like every other
    // row list; on one the muted tier is what holds the hierarchy against the artwork.
    in property <brush> ink-muted: Player.np-on-backdrop-muted;
    in property <brush> row-hover: Player.np-accent-pill;
    in property <brush> empty-ink: Player.np-on-backdrop-muted;
    in property <brush> empty-glyph: Player.np-on-backdrop-muted.transparentize(0.5);
    // The bar's palette, stepped rather than handed over as brushes: `OverlayScrollbar` eases its own
    // colours, so a host easing them too would restart that curve every frame. It takes the pace
    // instead.
    in property <bool> bar-on-backdrop: true;
    in property <duration> bar-recolor-duration: Theme.dur-fast;
    // **Must exceed `scrollbar-width`**, else the list extent and the scrollbar slot
    // overlap and the row hover paints under the bar. The remaining gap also keeps the
    // row TouchAreas off the window's right-edge resize band.
    in property <length> list-inset-right: compact ? 12px : 20px;
    // The bar keeps its own thickness; the extra in the full host is hit-test margin. The compact
    // branch goes under the shared slot, the sheet having no room for it — as the collapsed
    // sidebar rail does, for the same kind of reason.
    in property <length> scrollbar-width: compact ? 8px : Theme.scrollbar-slot;

    // **The one place a row's height is decided**, handed to every row and to the slide
    // below, so the two can't drift.
    property <length> row-h: compact ? 46px : 52px;
    property <int> slide-frames: 18;         // ~288ms at 16ms
    property <float> slide-raw: clamp(1.0 * NowPlaying.slide-phase / root.slide-frames, 0.0, 1.0);
    // Ease-out cubic, so the row decelerates into place instead of stopping dead.
    property <float> slide-p:
        1.0 - (1.0 - root.slide-raw) * (1.0 - root.slide-raw) * (1.0 - root.slide-raw);

    // Rust resetting the phase to 0 restarts this; it advances the phase per frame and
    // stops itself at the end.
    slide-timer := Timer {
        interval: 16ms;
        running: NowPlaying.slide-phase < root.slide-frames;
        triggered => {
            NowPlaying.slide-phase += 1;
        }
    }

    clip: true;

    // An **absolute** child of this wrapper, not a layout child, so its `y` can carry
    // the one-shot slide without fighting a layout; the clip above hides the row height
    // it is offset by mid-slide.
    src := DragSource {
        origin: DragOrigin.up-next;
        allow-move: true;
        x: 0;
        // Starts one row-height off rest on a track change and slides in. The sign
        // comes from `slide-direction`: forward slides up, rewound slides down.
        y: NowPlaying.slide-direction * (1.0 - root.slide-p) * root.row-h;
        width: parent.width - root.list-inset-right;
        // Only as tall as its rows: a `DragArea` takes every left press its children leave, and the
        // space under a short queue is the miniplayer's window grab.
        height: min(parent.height, NowPlaying.up-next-rows.length * root.row-h);

        up-next-list := ListView {
            // The `OverlayScrollbar` below is the only scrollbar.
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            // A row click jumps the queue and a drag reorders it, so it answers the way a card
            // does; argument on `views/radio/station-grid.slint`.
            mouse-drag-pan-enabled: false;
            width: 100%;
            height: 100%;
            for row[idx] in NowPlaying.up-next-rows: UpNextRow {
                data: row;
                compact: root.compact;
                ink: root.ink;
                ink-muted: root.ink-muted;
                row-hover: root.row-hover;
                row-height: root.row-h;
                // Under repeat-all the list wraps past the end, so the play-order index is
                // taken modulo the queue length.
                play-index: Math.mod(NowPlaying.base-index + idx, NowPlaying.queue-length);
                menu-enabled: root.menu-enabled;
                lifted: src.lifts(idx);
                pressed => { src.arm(idx); }
            }
        }
    }

    // The row that just left the list. Forward, it is the track that became current and
    // slides off the top; backward, the one that fell off the bottom and slides off
    // there. The wrapper clips both ends. **It names no play index**, so nothing on it acts:
    // it lasts a few hundred ms and shows a position it can no longer skip to.
    UpNextRow {
        visible: NowPlaying.outgoing-visible
                 && NowPlaying.slide-phase < root.slide-frames;
        x: 0;
        width: parent.width - root.list-inset-right;
        compact: root.compact;
        ink: root.ink;
        ink-muted: root.ink-muted;
        row-hover: root.row-hover;
        row-height: root.row-h;
        y: NowPlaying.slide-direction == 1
            ? -root.slide-p * root.row-h
            : parent.height - (1.0 - root.slide-p) * root.row-h;
        data: NowPlaying.outgoing-row;
    }

    ListDropTarget {
        x: src.x;
        y: src.y;
        width: src.width;
        // The full height where the source stops at its rows, so a drop below them lands at the end;
        // a `DropArea` passes presses through to the window grab.
        height: parent.height;
        origin: DragOrigin.up-next;
        row-height: root.row-h;
        row-count: NowPlaying.up-next-rows.length;
        content-y: up-next-list.content-y;
        // Where the rows past the repeat-all wrap begin, `up_next::play_order_move` refusing a
        // move across it. With no wrap it falls past the last row.
        split-row: NowPlaying.queue-length - NowPlaying.base-index;
        line-color: root.ink;
        reorder(from, to) => { NowPlaying.reorder(from, to); }
        scroll-by(dy) => {
            up-next-list.content-y = ListTravel.pin(
                up-next-list.content-y - dy,
                up-next-list.visible-height,
                up-next-list.content-height);
        }
    }

    NpOverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: root.scrollbar-width;
        height: parent.height;
        on-backdrop: root.bar-on-backdrop;
        recolor-duration: root.bar-recolor-duration;
        visible-size: up-next-list.visible-height;
        content-size: up-next-list.content-height;
        offset: -up-next-list.content-y;
        scroll-to(o) => { up-next-list.content-y = -o; }
    }

    if NowPlaying.up-next-rows.length == 0: NpEmptyState {
        glyph: "queue_music";
        heading: @tr("No tracks up next");
        compact: root.compact;
        ink: root.empty-ink;
        glyph-color: root.empty-glyph;
        wrap: no-wrap;
    }
}
