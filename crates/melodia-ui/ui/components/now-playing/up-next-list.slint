import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Queue, NowPlaying } from "../../globals/queue.slint";
import { QueueRow } from "../../models.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { NpOverlayScrollbar } from "np-overlay-scrollbar.slint";
import { NpEmptyState } from "np-empty-state.slint";

// One row inside the Up Next list. The two variants differ only in scale and palette — same three
// cells, same typography — so a track reads the same way in the miniplayer as full-screen.
//
// **Scale** comes from the host, one source of truth shared with the slide animation, and the tile
// and padding step down with it: the miniplayer sits tighter so more of the queue fits, but not so
// much tighter that it becomes a different list.
//
// **Palette is `on-backdrop`'s job, and it is deliberately not the scale's.** A host painting on
// the artwork takes the backdrop-solved brushes; one painting on ordinary chrome takes the neutral
// list palette, including the shared row hover — the Now-Playing accent is always solved *light*
// for the blur, and a light tint on a light theme's mantle is no hover indication at all. The
// miniplayer is compact either way and answers this one off its own backdrop switch. Restated
// per branch because Slint can't apply a property conditionally, and flipped without an `animate`
// like the track rows, where an eased fade reads as lag when crossing rows.
component UpNextRow inherits Rectangle {
    in property <QueueRow> data;
    in property <bool> compact;
    in property <bool> on-backdrop;
    // Owned by the host so the row and the slide animation can't disagree
    // about how tall a row is.
    in property <length> row-height;
    callback clicked();

    height: row-height;

    property <length> pad-v: compact ? Theme.pad-xs : Theme.pad-sm;

    Rectangle {
        background: touch.has-hover
            ? (on-backdrop ? Player.np-accent-pill : Theme.surface0)
            : transparent;
        border-radius: Theme.radius-md;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            padding-top: root.pad-v;
            padding-bottom: root.pad-v;
            spacing: Theme.pad-sm;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                ArtworkImage {
                    artwork-path: root.data.artwork_path;
                    cover: NowPlaying.request-cover(root.data.artwork_path);
                    tile-size: compact ? 34px : 38px;
                    tile-radius: Theme.radius-md;
                }
            }

            // Clips bidi overflow so elide fires — the bar's track-info pattern.
            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "‎" + root.data.title;
                        color: on-backdrop ? Player.np-on-backdrop : Theme.text;
                        font-size: Theme.font-size-row;
                        overflow: elide;
                    }
                    Text {
                        text: "‎" + root.data.artist;
                        // Off a backdrop this is body copy on a plain surface, so it takes
                        // `Theme.text` like every other row list. On one it keeps the solved
                        // muted tier: that one floats on the artwork, where the two-tier split
                        // is what holds the hierarchy.
                        color: on-backdrop ? Player.np-on-backdrop-muted : Theme.text;
                        font-size: Theme.font-size-sm;
                        overflow: elide;
                        visible: root.data.artist != "";
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.data.display_duration;
                    color: on-backdrop ? Player.np-on-backdrop-muted : Theme.text;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// The list itself: advance-by-row slide, outgoing-row overlay, overlay scrollbar and
// empty state, all off the same `NowPlaying` data for both surfaces.
//
// **Two hosts mount it but never at once**: entering the miniplayer force-closes
// `Nav.now-playing-open`, so only one local slide timer ever runs.
//
// Row height, scrollbar slot, list inset and the empty glyph all key off `compact`, so a caller
// threads one property rather than five. **Which palette the rows paint is the second flag's**,
// the miniplayer being compact whether or not it is painting its own backdrop.
export component UpNextList inherits Rectangle {
    in property <bool> compact;
    in property <bool> on-backdrop: true;
    // **Must exceed `scrollbar-width`**, else the list extent and the scrollbar slot
    // overlap and the row hover paints under the bar. The remaining gap also keeps the
    // row TouchAreas off the window's right-edge resize band.
    in property <length> list-inset-right: compact ? 12px : 20px;
    // The bar keeps its own thickness; the extra in the full host is hit-test margin. The compact
    // branch goes under the shared slot, the sheet having no room for it — as the collapsed
    // sidebar rail does, for the same kind of reason.
    in property <length> scrollbar-width: compact ? 8px : Theme.scrollbar-slot;

    // **The one place a row's height is decided**, handed to every row and to the slide
    // below, so the two can't drift.
    property <length> row-h: compact ? 46px : 52px;
    property <int> slide-frames: 18;         // ~288ms at 16ms
    property <float> slide-raw: clamp(1.0 * NowPlaying.slide-phase / root.slide-frames, 0.0, 1.0);
    // Ease-out cubic, so the row decelerates into place instead of stopping dead.
    property <float> slide-p:
        1.0 - (1.0 - root.slide-raw) * (1.0 - root.slide-raw) * (1.0 - root.slide-raw);

    // Rust resetting the phase to 0 restarts this; it advances the phase per frame and
    // stops itself at the end.
    slide-timer := Timer {
        interval: 16ms;
        running: NowPlaying.slide-phase < root.slide-frames;
        triggered => {
            NowPlaying.slide-phase += 1;
        }
    }

    clip: true;

    // An **absolute** child of this wrapper, not a layout child, so its `y` can carry
    // the one-shot slide without fighting a layout; the clip above hides the row height
    // it is offset by mid-slide.
    up-next-list := ListView {
        // The `OverlayScrollbar` below is the only scrollbar.
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // A row click jumps the queue, so it answers the way a card does; argument on
        // `views/radio/station-grid.slint`.
        mouse-drag-pan-enabled: false;
        x: 0;
        // Starts one row-height off rest on a track change and slides in. The sign
        // comes from `slide-direction`: forward slides up, rewound slides down.
        y: NowPlaying.slide-direction * (1.0 - root.slide-p) * root.row-h;
        width: parent.width - root.list-inset-right;
        height: 100%;
        for row[idx] in NowPlaying.up-next-rows: UpNextRow {
            data: row;
            compact: root.compact;
            on-backdrop: root.on-backdrop;
            row-height: root.row-h;
            clicked => {
                // Under repeat-all the list wraps past the end, so the play-order
                // index is taken modulo the queue length.
                Queue.skip-to(Math.mod(
                    NowPlaying.base-index + idx,
                    NowPlaying.queue-length));
            }
        }
    }

    // The row that just left the list. Forward, it is the track that became current and
    // slides off the top; backward, the one that fell off the bottom and slides off
    // there. The wrapper clips both ends. **Clicks are deliberately not wired**: it
    // lasts a few hundred ms and names a position this row can no longer skip to.
    UpNextRow {
        visible: NowPlaying.outgoing-visible
                 && NowPlaying.slide-phase < root.slide-frames;
        x: 0;
        width: parent.width - root.list-inset-right;
        compact: root.compact;
        on-backdrop: root.on-backdrop;
        row-height: root.row-h;
        y: NowPlaying.slide-direction == 1
            ? -root.slide-p * root.row-h
            : parent.height - (1.0 - root.slide-p) * root.row-h;
        data: NowPlaying.outgoing-row;
    }

    NpOverlayScrollbar {
        x: parent.width - self.width;
        y: 0;
        width: root.scrollbar-width;
        height: parent.height;
        on-backdrop: root.on-backdrop;
        visible-size: up-next-list.visible-height;
        content-size: up-next-list.viewport-height;
        offset: -up-next-list.viewport-y;
        scroll-to(o) => { up-next-list.viewport-y = -o; }
    }

    if NowPlaying.up-next-rows.length == 0: NpEmptyState {
        glyph: "queue_music";
        heading: @tr("No tracks up next");
        compact: root.compact;
        on-backdrop: root.on-backdrop;
        wrap: no-wrap;
    }
}
