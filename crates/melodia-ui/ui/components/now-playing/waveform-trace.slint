import { Visualizer } from "../../globals/audio.slint";
import { Player } from "../../globals/player.slint";

// The signal itself, drawn as the band between each column's loudest and quietest sample: a
// column covers several samples, and any one of them misrepresents the rest. Pushed by the tick,
// with no `animate` for the bars' reason.
export component WaveformTrace inherits Rectangle {
    Path {
        commands: Visualizer.wave-path;

        // The box Rust normalizes into (`slint-pitfalls.md`'s `Path` entry).
        viewbox-x: 0;
        viewbox-y: -1;
        viewbox-width: 1;
        viewbox-height: 2;
        fit: fill;

        // A wash inside an edge: the fill alone reads as a blob at this height, the stroke alone
        // loses the body. The figure doubles back on itself, and `waveform::MIN_HALF_THICKNESS`
        // keeps the two strokes apart, a path stroked on itself drawing dashed.
        fill: Player.np-viz.transparentize(0.55);
        stroke: Player.np-viz;
        // Scales with the strip, capped before the stroke eats the wash.
        stroke-width: clamp(root.height / 45, 1.25px, 2px);
        stroke-line-join: round;
    }
}
