import { Visualizer } from "../../globals/audio.slint";
import { Player } from "../../globals/player.slint";
import { SpectrumBars } from "spectrum-bars.slint";
import { WaveformTrace } from "waveform-trace.slint";

// The strip's footprint and the one Timer driving whichever style shows, its gate being easy to
// get subtly wrong and three copies three chances to.
export component VisualizerStrip inherits Rectangle {
    // The host's, a component root not reaching `parent`.
    in property <length> strip-height: 56px;

    min-height: root.strip-height;
    max-height: root.strip-height;
    // The cover slot above absorbs a short window.
    vertical-stretch: 0;

    // On the key, so reordering the pickers can't repoint a saved style. `!=` makes the bars the
    // catch-all, Mirrored and an unknown key included.
    if Visualizer.style == "waveform": WaveformTrace { }
    if Visualizer.style != "waveform": SpectrumBars { }

    // Read in a handler, so the width binds nothing to layout.
    function tick() {
        Visualizer.tick(Player.vm.is_playing, root.width / 1px);
    }

    // 30 Hz for every style, each figure rebuilt from scratch per tick; `dormant` only notices
    // frames coming back. Not just `is_playing`: a pause leaves the last window in the ring, so
    // the tick runs on, feeding the analyzers silence, until Rust reports everything settled.
    Timer {
        interval: Visualizer.dormant ? 500ms : 33ms;
        running: (Player.vm.is_playing && Visualizer.window-shown) || !Visualizer.idle;
        triggered() => {
            root.tick();
        }
    }
}
