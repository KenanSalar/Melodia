import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { SliderTrack } from "../slider-track.slint";

// The bar's and the miniplayer's timeline. One component because the elapsed label is easy to get
// subtly wrong: it follows the thumb through a drag and holds a committed seek until the engine
// reports it. Hosts mount it behind `!Player.vm.has_station`, which is safe with no `changed` here.
//
// Every colour is an input, `MetaChip`'s idiom, and nothing here eases a brush, so a host may.
export component SeekRow inherits HorizontalLayout {
    // Body weight, a live readout tracked continuously.
    in property <brush> label-color: Theme.text;
    in property <brush> fill-color: Theme.accent;
    in property <brush> track-color: Theme.surface1;
    // Whatever is painted behind the row; `SliderTrack` says why.
    in property <brush> seam-mask-color: Theme.mantle;

    // An hour-long position's width, so the track doesn't shift as the readout grows.
    private property <length> label-width: 40px;
    private property <length> label-font-size: 11px;

    // A committed seek shows where it's going, not the stale position until it lands.
    private property <int> settled-ms:
        Player.seek_pending_ms >= 0 ? Player.seek_pending_ms : Player.position-ms;

    spacing: Theme.pad-sm;
    // The track's default stretch would take a column's surplus and float mid-slot.
    vertical-stretch: 0;

    Text {
        text: Theme.format-duration(slider.dragging
            ? round(slider.drag-value * Player.duration-ms)
            : root.settled-ms);
        color: root.label-color;
        font-size: root.label-font-size;
        min-width: root.label-width;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    slider := SliderTrack {
        horizontal-stretch: 1;
        value: Player.duration-ms > 0 ? clamp(root.settled-ms / Player.duration-ms, 0, 1) : 0;
        is-disabled: !Player.vm.has_track || Player.duration-ms <= 0;
        fill-color: root.fill-color;
        track-color: root.track-color;
        seam-mask-color: root.seam-mask-color;

        committed(v) => {
            if (Player.duration-ms > 0) {
                Player.seek-to(round(v * Player.duration-ms));
            }
        }
    }

    Text {
        text: Theme.format-duration(Player.duration-ms);
        color: root.label-color;
        font-size: root.label-font-size;
        min-width: root.label-width;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}
