import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { Equalizer, ReplayGain } from "../../globals/audio.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { Player } from "../../globals/player.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { Queue } from "../../globals/queue.slint";
import { SignalPathUi } from "../../globals/signal-path.slint";
import { WindowChrome } from "../../globals/shell.slint";
import { IconButton } from "../icon-button.slint";
import { RatingMenuRow } from "../rating-menu-row.slint";
import { MenuSurface } from "./menu-surface.slint";
import { PopupColumn } from "../popup-column.slint";
import { PopupDismissCatcher } from "../popup-dismiss-catcher.slint";
import { PopupFit } from "../popup-fit.slint";
import { OverflowRow } from "./overflow-row.slint";
import { SpeedFlyout } from "./speed-flyout.slint";
import { SleepTimerFlyout } from "./sleep-timer-flyout.slint";
import { FlyoutMetrics, SleepPresets, SpeedPresets } from "./flyout-presets.slint";
import { EqualizerText } from "../settings/equalizer-controls.slint";
import { ReplayGainText } from "../settings/replaygain-controls.slint";

// The bar's overflow trigger and popup: five permanent rows, two opening a flyout, plus every
// button the user routed here. Always mounted, Speed living nowhere else.
//
// The popup is sized for the menu column and the widest flyout up front, so opening one never
// moves its origin (`slint-pitfalls.md`). It opens upward, cut to the room above the trigger, and
// each column scrolls what the cut takes.
export component OverflowMenu inherits Rectangle {
    in property <length> bar-w;

    width: btn.width;
    height: btn.height;

    // One left column, so the two flyouts are mutually exclusive.
    property <bool> speed-flyout-open: false;
    property <bool> sleep-flyout-open: false;

    public function dismiss() {
        pop.close();
        root.speed-flyout-open = false;
        root.sleep-flyout-open = false;
    }

    // Both effects apply and persist live, so their dialogs end on Done alone.
    function open-effect-dialog(kind: DialogKind, title: string, message: string) {
        root.dismiss();
        Dialog.kind = kind;
        Dialog.title = title;
        Dialog.message = message;
        Dialog.confirm-label = @tr("Done");
        Dialog.cancel-label = "";
        Dialog.destructive = false;
        Dialog.open = true;
    }

    // Each counts only when mounted, or the menu reserves an empty slot.
    property <int> overflow-count:
        (Settings.overflow-favorite ? 1 : 0)
        + (Settings.overflow-repeat ? 1 : 0)
        + (Settings.overflow-shuffle ? 1 : 0)
        + ((WindowChrome.always-on-top-supported && Settings.overflow-pin) ? 1 : 0)
        + (Settings.overflow-queue ? 1 : 0)
        + ((SignalPathUi.chip-shown && Settings.overflow-quality) ? 1 : 0);

    // The width is the popup's, the only element that can read its descendants'.
    property <length> menu-h:
        FlyoutMetrics.menu-row-h * (5 + root.overflow-count) + FlyoutMetrics.chrome-h;

    property <length> flyout-w: 120px;
    property <length> flyout-h:
        FlyoutMetrics.option-row-h * SpeedPresets.list.length + FlyoutMetrics.chrome-h;
    // Wide enough for "End of track" in translation. The presets, a divider, the stepper and the
    // Start pill.
    property <length> sleep-flyout-w: 168px;
    property <length> sleep-flyout-h:
        FlyoutMetrics.option-row-h * (SleepPresets.list.length + 2) + 9px
        + FlyoutMetrics.chrome-h;
    // The wider one plus its scroll gutter, so the popup keeps its box on a switch.
    property <length> left-col-w: max(root.flyout-w, root.sleep-flyout-w) + PopupFit.scroll-gutter;
    property <length> gap: 8px;

    // In lock-step with `SpeedPresets.list` by hand, a Slint function being unable to loop over a
    // model.
    function current-speed-label() -> string {
        if (abs(Player.vm.playback_speed - 0.25) < 0.001) { return "0.25x"; }
        if (abs(Player.vm.playback_speed - 0.5) < 0.001) { return "0.5x"; }
        if (abs(Player.vm.playback_speed - 0.75) < 0.001) { return "0.75x"; }
        if (abs(Player.vm.playback_speed - 1.25) < 0.001) { return "1.25x"; }
        if (abs(Player.vm.playback_speed - 1.5) < 0.001) { return "1.5x"; }
        if (abs(Player.vm.playback_speed - 1.75) < 0.001) { return "1.75x"; }
        if (abs(Player.vm.playback_speed - 2.0) < 0.001) { return "2x"; }
        return "1x";
    }

    btn := IconButton {
        icon: "more_vert";
        press-shrink: true;
        diameter: clamp(root.bar-w * 0.05, 28px, 36px);
        icon-size: clamp(root.bar-w * 0.03, 18px, 20px);
        tooltip-text: @tr("More");
        force-bg: pop.is-open;
        clicked => {
            root.speed-flyout-open = false; root.sleep-flyout-open = false;
            pop.show();
        }
    }

    pop := PopupWindow {
        // The widest row, the surface border and the scroll gutter.
        property <length> menu-w: max(156px, col.rows-w + 2px) + col.gutter;

        // Both offsets cancel `self.width`, so the column stays pinned under the trigger.
        width: root.left-col-w + root.gap + self.menu-w;
        // The bar is the window's foot, so the room is all above the trigger.
        height: min(max(root.menu-h, max(root.flyout-h, root.sleep-flyout-h)),
            PopupFit.room-above(root.absolute-position.y - Theme.popup-gap));
        x: btn.width - self.width;
        y: -self.height - Theme.popup-gap;
        close-policy: close-on-click-outside;

        PopupDismissCatcher {
            width: parent.width;
            height: parent.height;
            close-requested => {
                root.dismiss();
            }
        }

        // Bottom-anchored with the menu column, and right-aligned in the left column so the gap
        // holds whichever flyout is wider.
        if root.speed-flyout-open: SpeedFlyout {
            x: root.left-col-w - self.width;
            y: parent.height - self.height;
            width: root.flyout-w + self.gutter;
            height: min(root.flyout-h, parent.height);
            current-speed: Player.vm.playback_speed;
            pick(v) => {
                Player.set-playback-speed(v);
                root.dismiss();
            }
        }

        if root.sleep-flyout-open: SleepTimerFlyout {
            x: root.left-col-w - self.width;
            y: parent.height - self.height;
            width: root.sleep-flyout-w + self.gutter;
            height: min(root.sleep-flyout-h, parent.height);
            active-total-seconds: Player.sleep-timer-total-seconds;
            track-end-active: Player.vm.sleep_at_track_end;
            track-end-unavailable: Player.vm.has_station;
            pick(m) => {
                Player.set-sleep-timer(m);
                root.dismiss();
            }
            start-custom(secs) => {
                Player.set-sleep-timer-seconds(secs);
                root.dismiss();
            }
        }

        MenuSurface {
            x: parent.width - pop.menu-w;
            y: parent.height - self.height;
            width: pop.menu-w;
            height: min(root.menu-h, parent.height);
            close-requested => {
                root.dismiss();
            }

            col := PopupColumn {
                width: 100%;
                height: 100%;

                OverflowRow {
                    icon: "speed";
                    label: @tr("Speed");
                    trailing-text: root.current-speed-label();
                    trailing-icon: "chevron_left";
                    active: root.speed-flyout-open;
                    // `build_set_speed_actions` pins a station at 1.0, any other ratio starving or
                    // overrunning a live source's buffer; this makes the refusal visible.
                    button-enabled: !Player.vm.has_station;
                    clicked => {
                        root.speed-flyout-open = !root.speed-flyout-open;
                        root.sleep-flyout-open = false;
                    }
                }

                OverflowRow {
                    icon: "bedtime";
                    label: @tr("Sleep timer");
                    trailing-text: Player.vm.sleep_at_track_end
                        ? @tr("Track end")
                        : (Player.sleep-timer-total-seconds > 0 ? Player.sleep-timer-remaining : "");
                    trailing-icon: "chevron_left";
                    active: root.sleep-flyout-open
                        || Player.sleep-timer-total-seconds > 0
                        || Player.vm.sleep_at_track_end;
                    clicked => {
                        root.sleep-flyout-open = !root.sleep-flyout-open;
                        root.speed-flyout-open = false;
                    }
                }

                OverflowRow {
                    icon: "graphic_eq";
                    label: EqualizerText.title;
                    trailing-text: Equalizer.enabled ? @tr("On") : @tr("Off");
                    active: Equalizer.enabled;
                    clicked => {
                        root.open-effect-dialog(DialogKind.equalizer, EqualizerText.title,
                                                EqualizerText.enable-desc);
                    }
                }

                OverflowRow {
                    icon: "tune";
                    label: ReplayGainText.title;
                    trailing-text: ReplayGain.enabled ? @tr("On") : @tr("Off");
                    active: ReplayGain.enabled;
                    clicked => {
                        root.open-effect-dialog(DialogKind.replaygain, ReplayGainText.title,
                                                ReplayGainText.enable-desc);
                    }
                }

                // A star applies and leaves the menu up, so a pick can be corrected in place.
                // Not an `OverflowRow`, so it takes that row's height and icon treatment itself.
                RatingMenuRow {
                    row-height: FlyoutMetrics.menu-row-h;
                    icon-size: 20px;
                    star-size: 18px;
                    idle-icon-color: Theme.text;
                    rating: Player.vm.track.rating;
                    enabled: Player.vm.has_track;
                    rated(n) => {
                        Player.set-current-rating(n);
                    }
                }

                if Settings.overflow-favorite: OverflowRow {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    label: Player.vm.track.is_favorite ? @tr("Unfavorite") : @tr("Favorite");
                    active: Player.vm.track.is_favorite;
                    filled: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    clicked => { Player.toggle-favorite(); root.dismiss(); }
                }
                if Settings.overflow-repeat: OverflowRow {
                    icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
                    label: @tr("Repeat");
                    active: Player.queue.repeat_mode != "off";
                    clicked => { Player.cycle-repeat(); root.dismiss(); }
                }
                if Settings.overflow-shuffle: OverflowRow {
                    icon: "shuffle";
                    label: @tr("Shuffle");
                    active: Player.queue.shuffle;
                    clicked => { Player.toggle-shuffle(); root.dismiss(); }
                }
                if WindowChrome.always-on-top-supported && Settings.overflow-pin: OverflowRow {
                    icon: "push_pin";
                    label: WindowChrome.always-on-top-active ? @tr("Unpin from Top") : @tr("Pin on Top");
                    active: WindowChrome.always-on-top-active;
                    filled: WindowChrome.always-on-top-active;
                    clicked => { WindowChrome.toggle-always-on-top(); root.dismiss(); }
                }
                if Settings.overflow-queue: OverflowRow {
                    icon: "queue_music";
                    label: @tr("Queue");
                    active: Queue.shown;
                    clicked => { Queue.toggle(); root.dismiss(); }
                }
                // The chip's words without its dot, which a menu row has no slot for.
                if SignalPathUi.chip-shown && Settings.overflow-quality: OverflowRow {
                    icon: "graphic_eq";
                    label: SignalPathUi.verdict-label;
                    trailing-text: SignalPathUi.device-rate;
                    clicked => { SettingsPage.open-category(SettingsPage.category-output); root.dismiss(); }
                }
            }
        }
    }
}
