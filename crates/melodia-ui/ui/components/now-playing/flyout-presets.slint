// The now-playing flyouts' option lists and metrics. Hosts size a flyout off a list's length, so
// adding an option can't clip a popup.

// `value` is minutes: 0 off, -1 end of track.
export struct SleepPreset {
    value: int,
    label: string,
}

// Speeds in whole percents of normal.
export global SpeedPresets {
    out property <[int]> list: [25, 50, 75, 100, 125, 150, 175, 200];
    out property <int> step-percent: 5;
    // Mirror `MIN_SPEED` and `MAX_SPEED` in the engine's `state/mod.rs`.
    out property <int> min-percent: 25;
    out property <int> max-percent: 200;

    public pure function percent-of(speed: float) -> int {
        round(speed * 100)
    }
    public pure function label(percent: int) -> string {
        (percent / 100) + "x"
    }
    // Onto the step grid first, so a speed an MPRIS client set off it steps back onto it.
    public pure function stepped(percent: int, direction: int) -> int {
        clamp(direction > 0
                ? (floor(percent / root.step-percent) + 1) * root.step-percent
                : (ceil(percent / root.step-percent) - 1) * root.step-percent,
            root.min-percent, root.max-percent)
    }
}

export global SleepPresets {
    out property <[SleepPreset]> list: [
        { value: 0,   label: @tr("Off") },
        { value: 15,  label: @tr("15 min") },
        { value: 30,  label: @tr("30 min") },
        { value: 45,  label: @tr("45 min") },
        { value: 60,  label: @tr("60 min") },
        { value: 90,  label: @tr("90 min") },
        { value: -1,  label: @tr("End of track") },
    ];
}

export global VizStylePresets {
    // Mirrors `ui::visualizer`'s `STYLES` by position, a row's loop index being what `set-style`
    // takes. Read by both pickers, so they can't drift.
    out property <[string]> viz-style-names: [
        @tr("Bars"),
        @tr("Mirrored"),
        @tr("Waveform"),
    ];
}

export global FlyoutMetrics {
    // The steppers and the sleep flyout's Start row match it.
    out property <length> option-row-h: 32px;
    // The rule between a flyout's presets and its stepper.
    out property <length> divider-h: 9px;
    // The outer surface, so the coarser rhythm.
    out property <length> menu-row-h: 36px;
    // Inner pad, border and a little slack, for a flyout or a menu column.
    out property <length> chrome-h: 12px;
}
