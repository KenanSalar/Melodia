// The option lists behind the now-playing menus' flyouts, plus the row and chrome metrics their
// fixed-reserve geometry needs. Both hosts derive their reserved height from a list length here, so
// adding an option can't clip a popup.

// One speed preset. The label is an untranslated numeric token, kept in lock-step with
// `current-speed-label()` in `overflow-menu.slint`, which maps the live speed back to it.
export struct SpeedPreset {
    value: float,
    label: string,
}

// One sleep-timer preset. `value` is the minutes argument: 0 off, >0 a
// duration, -1 end-of-track.
export struct SleepPreset {
    value: int,
    label: string,
}

export global SpeedPresets {
    // Capped at the player's 2×: the deck resamples naively so pitch shifts with it, and past
    // that it's chipmunk territory. Mirror any change in `current-speed-label()`.
    out property <[SpeedPreset]> list: [
        { value: 0.25, label: "0.25x" },
        { value: 0.5,  label: "0.5x" },
        { value: 0.75, label: "0.75x" },
        { value: 1.0,  label: "1x" },
        { value: 1.25, label: "1.25x" },
        { value: 1.5,  label: "1.5x" },
        { value: 1.75, label: "1.75x" },
        { value: 2.0,  label: "2x" },
    ];
}

export global SleepPresets {
    // `-1` = "End of track"; `0` = off.
    out property <[SleepPreset]> list: [
        { value: 0,   label: @tr("Off") },
        { value: 15,  label: @tr("15 min") },
        { value: 30,  label: @tr("30 min") },
        { value: 45,  label: @tr("45 min") },
        { value: 60,  label: @tr("60 min") },
        { value: 90,  label: @tr("90 min") },
        { value: -1,  label: @tr("End of track") },
    ];
}

export global VizStylePresets {
    // Mirrors `STYLES` in `crates/melodia-views/src/ui/visualizer/mod.rs` **by position** — a row's
    // loop index *is* the index `set-style` takes, so there's no separate value
    // to keep in step, and `visualizer_tests` pins the length. A literal array
    // because a Rust-seeded one renders untranslated.
    //
    // Read by both pickers, so the two can't drift apart.
    out property <[string]> viz-style-names: [
        @tr("Bars"),
        @tr("Mirrored"),
        @tr("Waveform"),
    ];
}

export global FlyoutMetrics {
    // One `FlyoutOption` row; the sleep flyout's stepper and pill rows match it.
    out property <length> option-row-h: 32px;
    // Taller than a flyout row: the menu is the outer surface, and reads as the
    // coarser rhythm.
    out property <length> menu-row-h: 36px;
    // Vertical chrome allowance for a flyout *or* a menu column — inner pad,
    // border and a little slack.
    out property <length> chrome-h: 12px;
}
