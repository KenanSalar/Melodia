import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { MaterialIcon } from "../material-icon.slint";

// The centred glyph-and-copy block the Now-Playing column shows when an arm has nothing to draw.
//
// **Not `GridEmptyState`**, whose opaque `Theme.base` would punch a hole in the backdrop. This is
// the same block against the `np-*` tiers instead, shared so the column's arms cannot drift into
// stating their emptiness in different weights.
//
// `compact` is how big the block draws, which follows the panel it sits in. **The colours are
// inputs rather than a second flag**, defaulting to the backdrop tiers the full view paints on: the
// miniplayer takes the page's ink or those tiers off its own switch, and eases between them, which
// a flag read in here could only step.
export component NpEmptyState inherits VerticalLayout {
    in property <string> glyph;
    in property <string> heading;
    // A second line naming the control that would fill the panel. Empty where there is nothing the
    // reader can do from here, which is most states.
    in property <string> hint;
    in property <bool> compact: false;
    // The heading, and the hint at a step back from it.
    in property <brush> ink: Player.np-on-backdrop-muted;
    in property <brush> glyph-color: Player.np-on-backdrop-muted.transparentize(0.5);
    // Per caller rather than per tier: the lyrics arm writes a sentence and owes the break, where
    // Up Next writes three words and clipping is what keeps the miniplayer's column one line tall.
    in property <TextWrap> wrap: word-wrap;

    alignment: center;

    HorizontalLayout {
        alignment: center;

        VerticalLayout {
            spacing: Theme.pad-sm;

            HorizontalLayout {
                alignment: center;
                MaterialIcon {
                    name: root.glyph;
                    icon-size: root.compact ? 28px : 40px;
                    icon-color: root.glyph-color;
                }
            }

            Text {
                text: root.heading;
                color: root.ink;
                font-size: root.compact ? Theme.font-size-sm : Theme.font-size-md;
                horizontal-alignment: center;
                wrap: root.wrap;
            }

            if root.hint != "": Text {
                text: root.hint;
                color: root.ink.transparentize(0.35);
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                wrap: root.wrap;
            }
        }
    }
}
