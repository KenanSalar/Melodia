import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { FlyoutMetrics } from "flyout-presets.slint";

// It reports press *and* release rather than a click, so the row can repeat on hold, and stays
// enabled at a bound so that release always fires (the host clamps), only dimming to signal it.
component StepperButton inherits Rectangle {
    in property <string> icon;
    in property <bool> at-bound: false;

    // `down == true` on press, `false` on release / cancel.
    callback pressed-changed(bool /*down*/);

    // The bound's dimming, through the brushes rather than `opacity`, which would hold a texture for
    // as long as the flyout sits at a bound.
    private property <float> fade: root.at-bound ? 0.4 : 1.0;

    width: 26px;
    height: 26px;
    border-radius: self.height / 2;
    // The content views' darker page fill, lifting on hover.
    background: (touch.has-hover && !root.at-bound ? Theme.surface0 : Theme.base)
        .transparentize(1.0 - root.fade);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    MaterialIcon {
        name: root.icon;
        icon-size: Theme.font-size-md;
        icon-color: Theme.text;
        fade: root.fade;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.pressed-changed(true);
            }
            if ((ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left)
                || ev.kind == PointerEventKind.cancel) {
                root.pressed-changed(false);
            }
        }
    }
}

// A flyout's − value + row. A press steps once and a hold repeats; each step carries how long the
// press has been held, so a host can accelerate, and the release is reported so a host can commit.
export component FlyoutStepper inherits Rectangle {
    in property <string> text;
    in property <bool> at-min;
    in property <bool> at-max;

    // `held-ticks` is 0 for the press itself, then the 90 ms ticks since it.
    callback stepped(int /*direction*/, int /*held-ticks*/);
    callback released();

    property <int> repeat-dir: 0;   // -1 / 0 / +1
    property <int> held-ticks: 0;

    function press(dir: int) {
        root.held-ticks = 0;
        root.stepped(dir, 0);
        root.repeat-dir = dir;   // starts the repeat timer
    }
    function release() {
        root.repeat-dir = 0;
        root.released();
    }

    height: FlyoutMetrics.option-row-h;

    repeat-timer := Timer {
        interval: 90ms;
        running: root.repeat-dir != 0;
        triggered => {
            root.held-ticks += 1;
            // The press already applied one step, so the repeat waits: a tap must not read as a
            // hold.
            if (root.held-ticks >= 5) {
                root.stepped(root.repeat-dir, root.held-ticks);
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;
        cross-axis-alignment: center;

        StepperButton {
            icon: "remove";
            at-bound: root.at-min;
            pressed-changed(down) => {
                if (down) { root.press(-1); } else { root.release(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-size-md;
            horizontal-alignment: center;
        }
        StepperButton {
            icon: "add";
            at-bound: root.at-max;
            pressed-changed(down) => {
                if (down) { root.press(1); } else { root.release(); }
            }
        }
    }
}
