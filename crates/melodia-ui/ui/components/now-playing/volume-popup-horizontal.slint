import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { WindowChrome } from "../../globals/shell.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SliderTrack } from "../slider-track.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";
import { PopupDismissCatcher } from "../popup-dismiss-catcher.slint";
import { VolumeTrigger } from "volume-trigger.slint";

// `VolumePopup` turned on its side for the miniplayer, whose strip and card clip the vertical one.
// It flies out left of the disc, into the title area, vertical room being what the strip lacks.
export component VolumePopupHorizontal inherits Rectangle {
    in property <length> diameter: 36px;
    in property <length> icon-size: 22px;
    // The trigger's only, for `VolumePopup`'s reason.
    in property <brush> trigger-fg: Theme.text;
    in property <brush> trigger-hover-fg: root.trigger-fg;
    in property <brush> trigger-hover-bg: Theme.surface0;
    in property <duration> trigger-recolor-duration: Theme.dur-fast;
    in property <bool> trigger-on-backdrop: false;

    width: trigger.width;
    height: trigger.height;

    // Slint slides an overhanging popup back inside the window rather than shortening it, so
    // anything longer lands over the disc it flew out of.
    private property <length> max-flyout-width:
        root.absolute-position.x - WindowChrome.shell-x - 2 * Theme.popup-gap;

    trigger := VolumeTrigger {
        diameter: root.diameter;
        icon-size: root.icon-size;
        fg: root.trigger-fg;
        hover-fg: root.trigger-hover-fg;
        hover-bg: root.trigger-hover-bg;
        recolor-duration: root.trigger-recolor-duration;
        on-backdrop: root.trigger-on-backdrop;
        popup-open: pop.is-open;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        x: -self.width - Theme.popup-gap;
        y: (trigger.height - self.height) / 2;
        // The vertical slider's length. Floored too: a tiling window manager can hand the
        // miniplayer less than its minimum, and a negative width is not a shorter slider.
        width: clamp(root.max-flyout-width, 96px, 180px);
        height: 72px;
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { pop.close(); }
        }

        PopupDismissCatcher {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height - chrome.height;
            close-requested => { pop.close(); }
        }

        chrome := PopupSurface {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: 40px;
            pill: true;

            // Per step rather than per pixel, as in `VolumePopup`.
            property <int> last-emitted: -1;
            function emit-volume(v: int) {
                if (v != self.last-emitted) {
                    self.last-emitted = v;
                    Player.set-volume(v);
                }
            }

            slider := SliderTrack {
                x: Theme.pad-md;
                y: 0;
                width: parent.width - 2 * Theme.pad-md;
                height: parent.height;
                value: clamp(Player.vm.volume / 100, 0, 1);
                show-max-stop: true;
                // The surface behind it; the default is the now-playing bar's.
                seam-mask-color: Theme.crust;

                changed(v) => {
                    chrome.emit-volume(round(v * 100));
                }
                committed(v) => {
                    chrome.last-emitted = -1;
                    Player.commit-volume();
                }
                scroll-event(event) => {
                    return Player.wheel-volume(event);
                }
            }
        }

        // A zero-size anchor over the live thumb (`ui-patterns.md`).
        Rectangle {
            x: chrome.x + slider.x + slider.thumb-cx;
            y: chrome.y;
            width: 0px;
            height: 0px;

            Tooltip {
                text: round(Player.vm.volume) + "%";
                host-width: 0px;
                host-height: 0px;
                side: TooltipSide.above;
                in-popup: true;
                force-shown: slider.dragging || slider.has-hover;
            }
        }
    }
}
