import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { PopupHighlight } from "../../globals/shell.slint";
import { IconButton } from "../icon-button.slint";
import { PopupSurface } from "../popup-surface.slint";
import { SliderTrack } from "../slider-track.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// `VolumePopup` rotated 90°, for the rectangle miniplayer, whose wide-short
// window clips the vertical one. Same `SliderTrack` in the same `PopupSurface`
// chrome, laid along the bottom with the shared `Tooltip` pill reading the
// percentage out above the thumb.
//
// It flies out to the *left* of the trigger disc, into the title area, centred
// on it: that miniplayer is always wide enough, and vertical room is the whole
// constraint being escaped.
export component VolumePopupHorizontal inherits Rectangle {
    in property <length> diameter: 36px;
    in property <length> icon-size: 22px;

    width: btn.width;
    height: btn.height;

    // The vertical popup's keyboard-HUD wiring: a volume key bumps the tick,
    // this counts down from it and forces the trigger's tooltip open on the
    // current percentage. A drag doesn't bump it — it raises the chrome itself.
    property <int> hud-tick-mirror: Player.volume-hud-tick;
    property <int> tooltip-ticks-remaining: 0;

    changed hud-tick-mirror => {
        root.tooltip-ticks-remaining = 15;
    }

    tooltip-hide-timer := Timer {
        interval: 100ms;
        running: root.tooltip-ticks-remaining > 0;
        triggered => {
            root.tooltip-ticks-remaining = max(0, root.tooltip-ticks-remaining - 1);
        }
    }

    function volume-icon-name() -> string {
        if (Player.vm.is_muted || Player.vm.volume == 0) {
            return "volume_off";
        }
        if (Player.vm.volume < 50) {
            return "volume_down";
        }
        return "volume_up";
    }

    btn := IconButton {
        icon: root.volume-icon-name();
        press-shrink: true;
        diameter: root.diameter;
        icon-size: root.icon-size;
        filled: true;
        tooltip-text: round(Player.vm.volume) + "%";
        force-tooltip: root.tooltip-ticks-remaining > 0;
        force-bg: PopupHighlight.id == "volume";
        clicked => { PopupHighlight.id = "volume"; pop.show(); }
    }

    pop := PopupWindow {
        // The popup's right edge sits just left of the disc and centres on it,
        // which puts the slider chrome along the bottom at the disc's own Y and
        // leaves the badge floating above.
        x: -self.width - 8px;
        y: (btn.height - self.height) / 2;
        width: 220px;
        height: 72px;
        close-policy: close-on-click-outside;

        if PopupHighlight.id == "volume": FocusLossWatcher {
            close => { pop.close(); PopupHighlight.id = ""; }
        }

        // Catches clicks in the empty top strip. Declared before `chrome`, so
        // the slider's own TouchArea still wins.
        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height - chrome.height;
            clicked => { pop.close(); PopupHighlight.id = ""; }
        }

        chrome := PopupSurface {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: 40px;
            pill: true;

            // `SliderTrack.changed` fires per pixel of movement, so this gates
            // on integer steps and a full drag costs at most 100 emits.
            property <int> last-emitted: -1;
            function emit-volume(v: int) {
                if (v != self.last-emitted) {
                    self.last-emitted = v;
                    Player.set-volume(v);
                }
            }

            // Restores the disc's highlight on every release, moved or not: the
            // winit Release filter clears `PopupHighlight.id` on any mouse-up
            // while `committed` only fires after movement, so a bare click
            // inside the slider would leave the disc dark under an open popup.
            property <bool> slider-pressed: slider.pressed;
            changed slider-pressed => {
                if (!self.slider-pressed) {
                    PopupHighlight.id = "volume";
                }
            }

            slider := SliderTrack {
                x: Theme.pad-md;
                y: 0;
                width: parent.width - 2 * Theme.pad-md;
                height: parent.height;
                value: clamp(Player.vm.volume / 100, 0, 1);
                show-max-stop: true;
                // The seam mask has to match the surface behind it, and the
                // default is the now-playing bar's.
                seam-mask-color: Theme.crust;

                changed(v) => {
                    chrome.emit-volume(round(v * 100));
                }
                committed(v) => {
                    // The highlight is `slider-pressed`'s job above; this fires
                    // only post-drag and just flushes the persisted volume.
                    Player.commit-volume();
                }
            }
        }

        // A zero-size anchor on the chrome's top edge, level with the thumb:
        // `Tooltip` positions itself against a host *box*, and what this pill
        // hangs off is a *point*. Reads `SliderTrack.thumb-cx` straight, so it
        // follows the live thumb through a drag preview.
        Rectangle {
            x: chrome.x + slider.x + slider.thumb-cx;
            y: chrome.y;
            width: 0px;
            height: 0px;

            Tooltip {
                text: round(Player.vm.volume) + "%";
                host-width: 0px;
                host-height: 0px;
                side: TooltipSide.above;
                gap: 10px;
                // No reveal delay — the readout has to be up on the frame the
                // drag starts. Same hook the keyboard HUD above takes.
                force-shown: slider.dragging || slider.has-hover;
            }
        }
    }
}
