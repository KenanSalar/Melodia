import { Player } from "../../globals/player.slint";
import { IconButton } from "../icon-button.slint";

// `AccentDiscButton` without the disc: the Now-Playing header's glyphs. No chrome in any state, so
// hover reads through the glyph's colour; a toggle carries its state as outlined-vs-filled.
export component AccentGlyphButton inherits IconButton {
    diameter: 36px;
    icon-size: 22px;
    hover-bg: transparent;
    idle-fg: Player.np-accent-dim;
    hover-fg: Player.np-accent-bright;
    active-fg: Player.np-accent-bright;
    on-backdrop: true;
    // Active and hover are one brush, so a lit glyph rests a step under and comes up to full,
    // the lift its neighbours make.
    hover-lift: true;
}
