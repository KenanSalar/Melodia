import { WindowRect } from "../globals/drag.slint";

// Reports the window rect its host draws into, for a hit test made outside Slint. Mount it at the
// host's full size, and inside no `if` or `for` but the full-UI branch: its tracker watches layout,
// and a branch dropped while its parent re-flows panics on it (`slint-pitfalls.md`). The miniplayer
// swap drops that one on a tick of its own, as it does `NowPlayingBar`'s width mirror.
export component WindowRectReport {
    callback moved(WindowRect);

    private property <WindowRect> rect: {
        x: self.absolute-position.x,
        y: self.absolute-position.y,
        width: self.width,
        height: self.height,
    };
    changed rect => {
        root.moved(self.rect);
    }

    // `changed` doesn't fire when the first layout settles directly on the final rect.
    Timer {
        interval: 1ms;
        triggered => {
            root.moved(root.rect);
            self.running = false;
        }
    }
}
