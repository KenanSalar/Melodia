import { WindowRect } from "../globals/drag.slint";

// Reports the window rect its host draws into, for a hit test made outside Slint. At the host's
// full size, inside no `if` or `for` but the full-UI branch: its tracker watches layout, and a
// branch dropped while its parent re-flows panics on it.
export component WindowRectReport {
    callback moved(WindowRect);

    private property <WindowRect> rect: {
        x: self.absolute-position.x,
        y: self.absolute-position.y,
        width: self.width,
        height: self.height,
    };
    changed rect => {
        root.moved(self.rect);
    }

    // `changed` doesn't fire when the first layout settles directly on the final rect.
    Timer {
        interval: 1ms;
        triggered => {
            root.moved(root.rect);
            self.running = false;
        }
    }
}
