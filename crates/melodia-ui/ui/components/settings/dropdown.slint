import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PopupColumn } from "../popup-column.slint";
import { PopupFit } from "../popup-fit.slint";
import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// One option row inside the dropdown popup.
component DropdownOption inherits Rectangle {
    in property <string> label;
    in property <bool>   active;

    callback clicked();

    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;

        // Elided, not clipped: a clipped label's layout minimum is the whole string, and
        // Slint widens a popup to its content's minimum past the width bound on it.
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-size-md;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            // The empty branch holds the box, so every row is the same height.
            if root.active: MaterialIcon {
                name: "check";
                icon-size: 16px;
                icon-color: Theme.accent;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Custom rather than `std-widgets.ComboBox`, whose styling follows the backend.
//
// `manual: true` leaves `selected-index` to the host's one-way binding and only fires the
// callback (`slint-pitfalls.md`'s orphaned binding).
//
// `about-to-open` lets a host refresh options nothing announces. A refresh landing later returns
// the `options-revision` it will publish and the popup waits for it, since a list re-measured
// while open moves a pass late (`slint-pitfalls.md`). The wait is bounded, so a refresh that
// never lands costs a stale list rather than a dead control.
//
// `popup-align-end` is for a trigger with no room on its right, Slint clamping an overflowing
// popup flush to the window edge, over the scrollbar.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <length> trigger-width: 160px;
    in property <bool> manual: false;
    in property <bool> popup-align-end: false;
    // What the trigger reads while nothing is selected.
    in property <string> placeholder;
    in property <int> options-revision;

    callback selected(int);
    callback about-to-open() -> int;

    property <int> awaited-revision;
    property <bool> awaiting: false;
    property <duration> waited;
    property <duration> refresh-poll: 16ms;
    property <duration> refresh-timeout: 500ms;

    property <length> option-h: 32px;
    // Past this many the list scrolls, a taller one covering the form it opened over.
    property <int> shown-options: 10;
    property <length> popup-gap: 4px;

    width: root.trigger-width;
    height: trigger.height;

    function has-selection() -> bool {
        return root.selected-index >= 0 && root.selected-index < root.options.length;
    }

    function current-label() -> string {
        return root.has-selection() ? root.options[root.selected-index] : root.placeholder;
    }

    // Polled rather than watched: `options-revision` is usually fed from a global, and a
    // `changed` tracker on one outlives the `if` branch a host mounts this in.
    Timer {
        interval: root.refresh-poll;
        running: root.awaiting;
        triggered => {
            root.waited += root.refresh-poll;
            if root.options-revision >= root.awaited-revision || root.waited >= root.refresh-timeout {
                root.awaiting = false;
                popup.show();
            }
        }
    }

    trigger := Rectangle {
        width: root.trigger-width;
        height: Theme.dropdown-h;
        border-radius: Theme.radius-md;
        background: touch.has-hover ? Theme.card-control-hover : Theme.card-control;
        // The resting fill rather than `transparent`: the renderer tucks a fill under an opaque
        // border only (`slint-pitfalls.md`).
        border-color: touch.has-hover ? Theme.accent : Theme.card-control;
        border-width: 1px;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
        animate border-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-sm;
            cross-axis-alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.current-label();
                color: root.has-selection() ? Theme.text : Theme.overlay2;
                font-size: Theme.font-size-md;
                overflow: elide;
            }
            MaterialIcon {
                name: "arrow_drop_down";
                icon-size: 22px;
                icon-color: Theme.text;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.awaited-revision = root.about-to-open();
                if root.options-revision >= root.awaited-revision {
                    popup.show();
                } else {
                    root.waited = 0ms;
                    root.awaiting = true;
                }
            }
        }
    }

    popup := PopupWindow {
        // On the side with room, never over its own trigger (`PopupFit`).
        property <length> above-y: root.absolute-position.y - root.popup-gap;
        property <length> below-y: root.absolute-position.y + trigger.height + root.popup-gap;
        property <length> wanted-h: min(col.rows-h,
            root.shown-options * root.option-h + 2 * PopupFit.column-inset);
        property <bool> opens-above:
            PopupFit.opens-above(self.above-y, self.below-y, self.wanted-h);

        x: root.popup-align-end ? root.trigger-width - self.width : 0;
        y: self.opens-above ? -root.popup-gap - self.height : trigger.height + root.popup-gap;
        // On the popup, the only scope that may read its descendant's `preferred-width`.
        width: max(root.trigger-width, col.rows-w + col.gutter);
        height: PopupFit.side-h(self.above-y, self.below-y, self.wanted-h);
        // On `close-on-click` a row's own handler wouldn't run, so the rows close it.
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { popup.close(); }
        }

        PopupSurface {
            width: 100%;
            height: 100%;

            col := PopupColumn {
                width: 100%;
                height: 100%;
                // Opens on the current choice, which a long list would otherwise scroll away.
                reveal-y: PopupFit.column-inset + max(0, root.selected-index) * root.option-h;
                reveal-h: root.option-h;

                for option[i] in root.options: DropdownOption {
                    height: root.option-h;
                    label: option;
                    active: i == root.selected-index;
                    clicked => {
                        // `manual` leaves the index to the host's binding.
                        if !root.manual {
                            root.selected-index = i;
                        }
                        root.selected(i);
                        popup.close();
                    }
                }
            }
        }
    }
}
