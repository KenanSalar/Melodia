import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// One option row inside the dropdown popup.
component DropdownOption inherits Rectangle {
    in property <string> label;
    in property <bool>   active;

    callback clicked();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            // Elided, not clipped: a clipped label's layout minimum is the whole string, and
            // Slint widens a popup to its content's minimum past the width bound on it.
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-size-md;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            // The empty branch holds the box, so every row is the same height.
            if root.active: MaterialIcon {
                name: "check";
                icon-size: 16px;
                icon-color: Theme.accent;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Custom rather than `std-widgets.ComboBox`, whose styling follows the active
// backend and can't be made to match the rest of the controls.
//
// The popup is `close-on-click-outside` rather than the default: on
// `close-on-click` a row's own handler wouldn't get to fire, so the rows close
// it themselves.
//
// `manual: true` suppresses the self-write to `selected-index`, leaving only the
// callback — `ToggleSwitch`'s controlled pattern. Reach for it when the index is
// a one-way binding to an owned model value, where a self-write would orphan the
// binding and stop it tracking the model.
//
// `about-to-open` is for a host whose options can change with nothing to announce
// it, so it can refresh them as they are about to be read. A refresh that lands
// later returns the `options-revision` it will publish, and the popup waits for
// it: Slint sizes and places a popup once, as it opens, so options arriving after
// that paint into a box measured for the old ones. The wait is bounded, so a
// refresh that never lands costs a stale list rather than a dead control.
//
// `popup-align-end` lines a popup wider than the trigger up with its trailing
// edge, for a trigger with no room on its right: Slint clamps an overflowing
// popup flush to the window edge, over whatever scrollbar sits there.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    in property <length> trigger-width: 160px;
    in property <bool> manual: false;
    in property <bool> popup-align-end: false;
    // What the trigger reads while nothing is selected.
    in property <string> placeholder;
    in property <int> options-revision;

    callback selected(int);
    callback about-to-open() -> int;

    property <int> awaited-revision;
    property <bool> awaiting: false;
    property <duration> waited;
    property <duration> refresh-poll: 16ms;
    property <duration> refresh-timeout: 500ms;

    width: root.trigger-width;
    height: trigger.height;

    function has-selection() -> bool {
        return root.selected-index >= 0 && root.selected-index < root.options.length;
    }

    function current-label() -> string {
        return root.has-selection() ? root.options[root.selected-index] : root.placeholder;
    }

    // Polled rather than watched: `options-revision` is usually fed from a global, and a
    // `changed` tracker on one outlives the `if` branch a host mounts this in.
    Timer {
        interval: root.refresh-poll;
        running: root.awaiting;
        triggered => {
            root.waited += root.refresh-poll;
            if root.options-revision >= root.awaited-revision || root.waited >= root.refresh-timeout {
                root.awaiting = false;
                popup.show();
            }
        }
    }

    trigger := Rectangle {
        width: root.trigger-width;
        height: 32px;
        border-radius: Theme.radius-md;
        background: touch.has-hover ? Theme.surface2 : Theme.surface1;
        // The resting fill rather than `transparent`, which reads the same: the renderer tucks a
        // fill under an opaque border only, and a border fading through transparent would
        // antialias the corners twice for as long as it eases.
        border-color: touch.has-hover ? Theme.accent : Theme.surface1;
        border-width: 1px;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
        animate border-color { duration: Theme.dur-fast; easing: ease-in-out; }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-sm;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.current-label();
                    color: root.has-selection() ? Theme.text : Theme.overlay2;
                    font-size: Theme.font-size-md;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "arrow_drop_down";
                    icon-size: 22px;
                    icon-color: Theme.text;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.awaited-revision = root.about-to-open();
                if root.options-revision >= root.awaited-revision {
                    popup.show();
                } else {
                    root.waited = 0ms;
                    root.awaiting = true;
                }
            }
        }
    }

    popup := PopupWindow {
        // Always under the trigger; flipping above near the viewport's bottom
        // edge is polish nobody has asked for yet.
        x: root.popup-align-end ? root.trigger-width - self.width : 0;
        y: trigger.height + 4px;
        // Bound on the popup, the only scope that may read its descendant's
        // `preferred-width`.
        width: max(root.trigger-width, rows.preferred-width);
        // See above — the rows need their handlers to run before it closes.
        close-policy: close-on-click-outside;

        // Ungated, unlike the other popups: Settings hosts a handful of these,
        // and a `PopupHighlight` discriminator per instance would buy nothing
        // at that scale.
        FocusLossWatcher {
            close => { popup.close(); }
        }

        PopupSurface {
            rows := VerticalLayout {
                padding: Theme.pad-xs;
                spacing: 0;

                for option[i] in root.options: DropdownOption {
                    label: option;
                    active: i == root.selected-index;
                    clicked => {
                        // `manual` leaves the index to the host's binding.
                        if !root.manual {
                            root.selected-index = i;
                        }
                        root.selected(i);
                        popup.close();
                    }
                }
            }
        }
    }
}
