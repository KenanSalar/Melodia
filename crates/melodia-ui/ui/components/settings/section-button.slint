import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// The labelled pill button, filled primary or outline secondary.
export component SectionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;            // empty = no leading icon
    // For a third-party logo the icon font hasn't got and mustn't recolour. Gated on its source
    // size, there being no empty-`image` literal, and on `icon` being empty.
    in property <image>  leading-image;
    in property <bool>   button-enabled: true;
    in property <bool>   primary: true;   // false = outline / "text" variant
    // The filled variant only; hover brightens the red rather than reaching for a second hue.
    // Not `PillButton`'s `danger`, a different treatment.
    in property <bool>   destructive;
    // Softened only for a button standing in for a third-party badge.
    in property <length> corner-radius: root.height / 2;

    callback clicked();

    // Through each brush, `opacity` holding a texture for as long as it stays disabled.
    private property <float> fade: root.button-enabled ? 1.0 : 0.5;
    private property <brush> ink: (root.primary
            ? (root.destructive ? Theme.danger-text : Theme.accent-text)
            : Theme.text)
        .transparentize(1.0 - root.fade);

    height: 32px;
    horizontal-stretch: 0;
    border-radius: root.corner-radius;
    background: (!root.button-enabled
            ? Theme.card-control
            : (root.primary
                ? (root.destructive
                    ? (touch.has-hover ? Theme.danger.brighter(10%) : Theme.danger)
                    : (touch.has-hover ? Theme.accent.brighter(10%) : Theme.accent))
                : (touch.has-hover ? Theme.card-control-hover : Theme.card-control)))
        .transparentize(1.0 - root.fade);
    border-color: root.primary || !root.button-enabled
        ? transparent
        : Theme.card-control-hover;
    border-width: 1px;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-xs;
        alignment: center;
        cross-axis-alignment: center;

        if root.icon != "": MaterialIcon {
            name: root.icon;
            icon-size: 18px;
            icon-color: root.ink;
        }

        if root.icon == "" && root.leading-image.width > 0 && root.leading-image.height > 0: Image {
            source: root.leading-image;
            // Height matches the glyph branch; the width follows the source aspect,
            // since `contain` inside a square box letterboxes a wide mark and paints
            // it smaller than the icon beside it would be.
            height: 18px;
            width: 18px * root.leading-image.width / root.leading-image.height;
            image-fit: contain;
            // Free on a childless `Image`, which never gets a texture for it.
            opacity: root.fade;
        }

        Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.font-size-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if (root.button-enabled) { root.clicked(); }
        }
    }
}
