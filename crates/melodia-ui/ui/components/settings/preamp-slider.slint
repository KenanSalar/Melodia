import { SettingSlider } from "setting-slider.slint";

// The preamp both effect cards mount. It owns the dB ↔ 0..1 mapping, off bounds the host seeds from
// its own DSP constants, so the formula exists once. It emits dB, which the host splits into live
// and persist.
export component PreampSlider inherits HorizontalLayout {
    in property <float> preamp; // dB
    in property <float> min-preamp; // dB
    in property <float> max-preamp; // dB

    callback changed(float /* dB */);
    callback committed(float /* dB */);

    pure function preamp-to-frac(db: float) -> float {
        return (db - root.min-preamp) / (root.max-preamp - root.min-preamp);
    }
    pure function frac-to-preamp(f: float) -> float {
        return root.min-preamp + f * (root.max-preamp - root.min-preamp);
    }

    SettingSlider {
        value: root.preamp-to-frac(root.preamp);
        // A unit symbol, so untranslated.
        readout: (root.preamp > 0 ? "+" : "") + round(root.preamp) + " dB";
        readout-width: 48px;
        changed(v) => { root.changed(root.frac-to-preamp(v)); }
        committed(v) => { root.committed(root.frac-to-preamp(v)); }
    }
}
