import { Theme } from "../../theme.slint";

// M3-style switch: a pill track with a thumb that slides across it. The travel
// is animated on a 0..1 float and the thumb's `x` derives from that — animating
// the `x` itself would phase-lag the width-derived binding under it.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in-out property <bool> enabled <=> touch.enabled;
    // On, a click doesn't flip `checked` here — the parent owns the state and
    // acts on `toggled` first. That's what the restart-gated rows need: they
    // bind `checked` one-way to the persisted value, and a self-flip would
    // orphan that binding. Off by default, so the `<=>`-bound mounts keep
    // flipping themselves.
    in property <bool> manual: false;

    // The Settings palette by default. Now Playing hands in its own tier, which is written once per
    // track rather than eased, so the `animate background`s below never restart on it.
    in property <brush> track-on: Theme.accent;
    in property <brush> track-off: Theme.surface1;
    in property <brush> thumb-on: Theme.accent-text;
    in property <brush> thumb-off: Theme.text;

    // For a host mounting its own `Tooltip`, a switch having no label to carry the name.
    out property <bool> has-hover: touch.has-hover;

    callback toggled(bool /* requested new value */);

    // Sized by its height alone, so a host shrinking one to sit beside a glyph sets one number and
    // keeps the Settings proportions rather than restating them.
    height: 32px;
    width: self.height * 1.625;
    property <length> thumb-inset: root.height / 8;

    // On the shared fast duration, so it lines up with the page's other
    // control feedback.
    track := Rectangle {
        background: root.checked ? root.track-on : root.track-off;
        border-radius: root.height / 2;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    }

    property <float> a: root.checked ? 1.0 : 0.0;
    animate a { duration: Theme.dur-fast; easing: ease-in-out; }

    Rectangle {
        x: root.thumb-inset + root.a * (root.width - root.height);
        y: root.thumb-inset;
        width: root.height - 2 * root.thumb-inset;
        height: root.height - 2 * root.thumb-inset;
        border-radius: self.width / 2;
        background: root.checked ? root.thumb-on : root.thumb-off;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.manual) {
                // Report the requested value; the parent decides.
                root.toggled(!root.checked);
            } else {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
