import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";

// The chrome around every settings section, its title inside the fill so the card's top starts
// level with the category panel's.
export component SectionCard inherits Rectangle {
    in property <string> title;
    in property <length> card-width: SettingsPage.card-w;

    vertical-stretch: 0;

    // Never `width`, whose floor climbs out to the window's. The pinned preferred keeps every card
    // one width, a grid column starting at it; `min-width` is left alone so the card compresses.
    preferred-width: root.card-width;
    max-width: root.card-width;

    VerticalLayout {
        // The card's own gap, never its host's `spacing`: a section a search hides still holds a
        // slot.
        padding-bottom: Theme.pad-lg;

        // No `clip`: a rounded one is a layer reallocated on every frame of a resize, and nothing
        // reaches the corners.
        Rectangle {
            // The root's pair again on a cell, the only place it reaches the card's height
            // behind an `if`.
            preferred-width: root.card-width;
            max-width: root.card-width;
            background: SettingsPage.card-fill;
            border-radius: Theme.radius-lg;

            VerticalLayout {
                // A floor, so a long locale's title wraps and grows the band.
                HorizontalLayout {
                    min-height: SettingsPage.card-header-h;
                    padding-left: Theme.pad-lg;
                    padding-right: Theme.pad-lg;
                    padding-top: SettingsPage.nav-pad;
                    padding-bottom: SettingsPage.nav-pad;

                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        // A no-wrap `Text` reports its full width as its minimum.
                        wrap: word-wrap;
                    }
                }

                // Full-bleed where `SectionDivider` insets: it parts the title from the body.
                Rectangle {
                    height: 1px;
                    background: Theme.surface2;
                }

                @children
            }
        }
    }
}
