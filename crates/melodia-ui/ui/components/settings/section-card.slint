import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";

// The chrome around every settings section: an uppercase heading over a rounded
// card, the host's rows and dividers inside through `@children`.
export component SectionCard inherits Rectangle {
    in property <string> title;
    // Defaults to the settings body's own answer; override it anywhere a card
    // isn't a body column.
    in property <length> card-width: SettingsPage.card-w;

    vertical-stretch: 0;

    // `preferred-width` and `max-width`, never `width` — Slint reports a bound `width` as the
    // element's minimum *and* maximum, and that floor climbs out to the window's own. Pinning the
    // preferred is what keeps every card one width: the body column is drawn at its preferred
    // width, so cards of different natural width would give categories of different width. The max
    // holds it there inside a wider host. `min-width` is deliberately left alone, so the card still
    // compresses.
    preferred-width: root.card-width;
    max-width: root.card-width;

    VerticalLayout {
        spacing: Theme.pad-sm;
        // **The gap under a card is the card's, never its host's `spacing`.** A section that
        // filters itself away still holds its layout slot, and a search hiding most of ten
        // categories' cards would leave a hole for every one of them.
        padding-bottom: Theme.pad-lg;

        // The size is one-off enough to stay inline; hoist it to Theme if a
        // second site turns up. The layout inset is what optically aligns the
        // heading with the row icons inside the card.
        HorizontalLayout {
            padding-left: Theme.pad-lg;
            Text {
                text: root.title;
                color: Theme.subtext0;
                font-size: 13px;
                font-weight: 600;
                // M3 section-header cadence — the tracking carries the
                // uppercase rhythm.
                letter-spacing: 0.5px;
                // Wrapped, so a long locale's title can't hold the card open —
                // a no-wrap `Text` reports its full width as its *minimum*.
                wrap: word-wrap;
            }
        }

        // **No `clip`.** A rounded clip over children is an offscreen layer in FemtoVG, reallocated
        // whenever the card's width moves, which below the cap is every frame of a resize, and it
        // blurs the card's text on HiDPI. Nothing needs it: rows and dividers inset by `pad-lg`, so
        // nothing reaches the rounded corners.
        Rectangle {
            // **The root's pair, again on a cell**, which is the only place it reaches the card's
            // height: mounted behind an `if`, the card is measured at the width its contents ask
            // for, and a pin on a cell replaces what that cell asks for where the root's cannot.
            // Both bounds, so neither a wider heading nor a long folder path widens it.
            preferred-width: root.card-width;
            max-width: root.card-width;
            background: SettingsPage.card-fill;
            border-radius: Theme.radius-lg;

            VerticalLayout {
                @children
            }
        }
    }
}
