import { Theme } from "../../theme.slint";

// The rule between rows inside a `SectionCard`, inset so it stops short of the
// card's rounded edges.
export component SectionDivider inherits Rectangle {
    height: 1px;
    background: transparent;

    Rectangle {
        x: Theme.pad-lg;
        y: 0;
        width: parent.width - 2 * Theme.pad-lg;
        height: 1px;
        background: Theme.surface2;
    }
}
