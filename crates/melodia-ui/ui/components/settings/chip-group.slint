import { Theme } from "../../theme.slint";
import { FilledChip } from "../filled-chip.slint";

// One pill in a `ChipGroup`. Unexported — it's useful nowhere else.
component Chip inherits FilledChip {
    in property <string> label;

    height: 32px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.ink;
            font-size: Theme.font-size-sm;
        }
    }
}

// Pill-chip selector. A click writes `selected-index` and emits `selected(idx)`.
export component ChipGroup inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    // Off by default: a click writes `selected-index` before emitting, which
    // suits any caller `<=>`-binding it to a global. On, the click only emits —
    // required where `selected-index` is a *derived* expression, since a
    // self-write would orphan that one-way binding.
    in property <bool> manual: false;

    callback selected(int);

    // Left to the flex, the widest chip is a floor the card can't shrink past.
    min-width: 0px;
    // Bound, because the flex reports no maximum and stretches its lines by default: a host
    // with height to spare would spread the rows apart.
    height: flow.preferred-height;

    flow := FlexboxLayout {
        spacing: Theme.pad-sm;

        for option[idx] in root.options: Chip {
            label: option;
            selected: idx == root.selected-index;
            clicked => {
                if (!root.manual) {
                    root.selected-index = idx;
                }
                root.selected(idx);
            }
        }
    }
}
