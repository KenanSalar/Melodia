import { SettingsPage } from "../../globals/settings-page.slint";

// The card's fill over a disabled control, the pixels `opacity: 1 - dim` would give. Not `opacity`:
// its layer is clipped against the scroller when built and not re-measured on scroll, so one built
// above the viewport draws cut off.
export component DisabledScrim inherits Rectangle {
    in property <float> dim;

    background: SettingsPage.card-fill.transparentize(1.0 - root.dim);
}
