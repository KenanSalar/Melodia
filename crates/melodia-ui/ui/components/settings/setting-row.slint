import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MaterialIcon } from "../material-icon.slint";
import { DisabledScrim } from "disabled-scrim.slint";

// The "icon · label · control" row inside a `SectionCard`, the host's control arriving through
// `@children`. `disabled` dims the row and swallows the pointer, Slint propagating nothing across
// `@children`.
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    in property <bool>   disabled: false;
    // A reading column for a long description; the default means unbounded.
    in property <length> description-max-width: 100000px;

    // Through each brush rather than `opacity`, whose layer would crop glyph ink for as long as
    // the row stays disabled. The `@children` control has no brush to reach, so a scrim dims it.
    property <float> dim: root.disabled ? Theme.dim-disabled : 0.0;
    animate dim { duration: Theme.dur-fast; easing: ease-in-out; }

    // The wrapper measures the row at the card's width, a pin on a cell reaching a row behind an
    // `if` where one on its root can't.
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.pad-lg;
            spacing: Theme.pad-lg;
            alignment: stretch;
            preferred-width: SettingsPage.card-w;

            // Pinned, so the labels start at one x however narrow a glyph is.
            MaterialIcon {
                cross-axis-self-alignment: center;
                name: root.icon;
                icon-size: SettingsPage.row-icon-w;
                icon-color: Theme.text;
                fade: 1.0 - root.dim;
            }

            VerticalLayout {
                alignment: center;
                spacing: Theme.pad-xs;
                horizontal-stretch: 1;

                // Wrapped, so the card compresses: a no-wrap `Text` reports its full width as its
                // minimum.
                Text {
                    text: root.label;
                    color: Theme.text.transparentize(root.dim);
                    font-size: Theme.font-size-md;
                    wrap: word-wrap;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: Theme.text-muted.transparentize(root.dim);
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                    max-width: root.description-max-width;
                }
            }

            // The scrim's box, which a conditional child fills without sizing.
            Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-sm;
                    @children
                }

                if root.dim > 0: DisabledScrim {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    dim: root.dim;
                }
            }
        }
    }

    // Handler-less, so the click stops here.
    if root.disabled: TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
    }
}
