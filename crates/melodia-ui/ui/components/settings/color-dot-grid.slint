import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";

// One swatch. The active one carries a check inked against the swatch, the only
// fill under it, so the mark reads on any accent whichever palette hosts the grid.
component ColorDot inherits Rectangle {
    in property <brush> swatch;
    in property <bool>  selected;
    in property <string> label;
    // Rows after the first point downward: anchored above, their pill would
    // land on the row of dots over them.
    in property <TooltipSide> tip-side: TooltipSide.above;

    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: self.width / 2;
    background: root.swatch;

    if root.selected: MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "check";
        icon-size: 20px;
        icon-color: Theme.ink-on(root.swatch);
    }

    // A 1 px ring stands in for a hover lift, Slint applying no `transform-scale`
    // on a component's root.
    if touch.has-hover && !root.selected: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: self.width / 2;
        border-color: Theme.surface2;
        border-width: 1px;
        background: transparent;
    }

    Tooltip {
        text: root.label;
        hovered: touch.has-hover;
        host-width: parent.width;
        // `below` clears by this, so without it the pill lands one `gap` off the dot's own
        // top rather than under it.
        host-height: parent.height;
        side: root.tip-side;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A grid of accent swatches; `labels` is read by index alongside `colors` so each dot names its
// accent in a tooltip. It wraps, and it has to: Catppuccin ships fourteen accents, which on one
// row was the widest incompressible thing on the settings page. Laid out as `ChipGroup` is, for
// its reasons.
export component ColorDotGrid inherits Rectangle {
    in property <[brush]> colors;
    in property <[string]> labels;
    // -1 checks no swatch, for a host whose colour is following something rather than picked.
    in-out property <int> selected-index;

    callback selected(int);

    // The cell runs a little taller than the dot, so the hover ring isn't
    // clipped against the row edge.
    property <length> cell-h: 36px;

    min-width: 0px;
    height: flow.preferred-height;

    flow := FlexboxLayout {
        spacing: Theme.pad-sm;

        for color[i] in root.colors: cell := VerticalLayout {
            height: root.cell-h;
            alignment: center;
            ColorDot {
                swatch: color;
                selected: i == root.selected-index;
                label: i < root.labels.length ? root.labels[i] : "";
                // Off the laid-out position rather than a count of what fits, so the side can't
                // disagree with where the flex actually broke the line.
                tip-side: cell.y < root.cell-h ? TooltipSide.above : TooltipSide.below;
                clicked => {
                    root.selected-index = i;
                    root.selected(i);
                }
            }
        }
    }
}
