import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// **No fill marks the selected tab**, per Material 3: the accent label, the FILL=1 icon and the
// underline carry it. The settings ChipGroups fill because they configure.
component TabBarCell inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool>   selected;
    // Defaulted at the bar, so the two can't disagree about "unset".
    in property <brush>  label-color-idle;
    in property <brush>  active-color;
    in property <brush>  hover-fill;
    // 0 expanded, 1 compact: a scalar, so the label closes onto its icon rather than vanishing.
    in property <float>  compact-t;

    callback clicked();
    callback hover-changed(bool);

    property <float> open: 1.0 - root.compact-t;
    // A no-wrap Text's width is intrinsic to its string, so this is a derivation, not a cycle.
    property <length> label-w: lbl.preferred-width;
    // Gone by the time the slot is half closed, so the clip never shows half a word. Derived
    // rather than animated, which would phase-lag.
    property <float> label-alpha: clamp(1.0 - root.compact-t * 2.0, 0.0, 1.0);

    // **Eases floats, never a brush**: a host on a hero band crosses its brushes in a morph, and
    // an `animate` over them would restart every frame and land late.
    property <float> hover-t: touch.has-hover ? 1.0 : 0.0;
    animate hover-t { duration: Theme.dur-fast; easing: ease-in-out; }

    // On the underline's curve, so the label reaches the accent as the pill arrives under it.
    property <float> sel-t: root.selected ? 1.0 : 0.0;
    animate sel-t { duration: Theme.dur-med; easing: ease-in-out; }

    horizontal-stretch: 0;

    // `SidebarItem`'s wobble. **Only the factor is animated**: the sizes derived from it move every
    // frame of a compact morph, and easing them wobbles every tab through a resize.
    property <float> press-scale: touch.pressed ? 0.97 : 1.0;
    animate press-scale {
        duration: touch.pressed ? 100ms : Theme.dur-med;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    // Spelled out because Slint drops a child with explicit geometry from the root's merge, and
    // `cell` binds its width: the bar's ruler would read the bare default and never go compact.
    preferred-width: content.preferred-width;

    // The root keeps the whole slot, so a press never reflows the row or moves the underline.
    cell := Rectangle {
        width: parent.width * root.press-scale;
        height: parent.height * root.press-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // `transparentize` multiplies alpha, so a translucent hero tier keeps its own weight.
        background: root.hover-fill.transparentize(1.0 - root.hover-t);
        border-radius: Theme.radius-md;

        // Padding and spacing close with the label, so the icon glides to the middle on its own.
        content := HorizontalLayout {
            padding-left: Theme.pad-md * root.open;
            padding-right: Theme.pad-md * root.open;
            spacing: Theme.pad-sm * root.open;
            alignment: center;

            // **Two glyphs rather than one eased brush**, the idle one at full alpha so the cross
            // never thins. The wrapper needs its own geometry: `MaterialIcon` binds its size, so a
            // container merges nothing from it and reports 0×0.
            Rectangle {
                cross-axis-self-alignment: center;
                // Scaled directly: a container shrinking 3% moves the glyph a pixel and no more.
                width: 22px * root.press-scale;
                height: self.width;

                MaterialIcon {
                    name: root.icon;
                    icon-size: parent.width;
                    icon-color: root.label-color-idle;
                    filled: root.selected;
                }

                MaterialIcon {
                    name: root.icon;
                    icon-size: parent.width;
                    icon-color: root.active-color.transparentize(1.0 - root.sel-t);
                    filled: root.selected;
                }
            }

            // **Always mounted**, an `if` turning the compact flip into a pop, and closed by its
            // width. Rectangular so the clip is a scissor; left-aligned so it eats the tail first.
            Rectangle {
                clip: true;
                horizontal-stretch: 0;
                width: root.label-w * root.open;

                // The glyphs' pair, alpha on the brush: `opacity` would cost two layers per tab.
                lbl := Text {
                    text: root.label;
                    color: root.label-color-idle.transparentize(1.0 - root.label-alpha);
                    // Text doesn't scale with its container, so the press reaches it directly.
                    font-size: Theme.font-size-md * root.press-scale;
                    // **One weight for both states**: the cells are sized off a measured maximum,
                    // so a heavier selected label would reflow the row.
                    font-weight: 500;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Text {
                    text: root.label;
                    // Both fades multiply, so the compact close takes the selected word away too.
                    color: root.active-color
                        .transparentize(1.0 - root.label-alpha * root.sel-t);
                    font-size: Theme.font-size-md * root.press-scale;
                    font-weight: 500;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> is-hovered: touch.has-hover;
    changed is-hovered => { root.hover-changed(root.is-hovered); }
}

// Material 3 tab bar: parallel label and icon arrays in, picked index out. **`labels` arrives as an
// inline `[@tr("…"), …]` literal**, an array from Rust rendering untranslated.
//
// Equal-width cells, sized to the widest tab, keep the underline arithmetic: a `for` exposes no
// per-tab element to read a position off.
export component TabBar inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> icons;

    // Every brush is an input, defaulting to a flat page's; a hero band hands `HeroBackdrop` tiers.
    in property <brush> label-color: Theme.text;
    in property <brush> active-color: Theme.accent;
    in property <brush> hover-fill: Theme.surface0;
    // Not `Theme.border`, which every Catppuccin flavour sets to `surface0`: the line would vanish
    // under the hovered cell.
    in property <brush> divider-color: Theme.surface1;
    // A **mirrored** width, never a live `parent.width` read (the host's `page-w`).
    in property <length> avail-width;
    // Two-way, per the orphaned-one-way-binding pitfall.
    in-out property <int> selected-index;
    // The tab active when the pick was made: a cell writes `selected-index` before it emits
    // `selected`, so a handler already reads the new one.
    out property <int> previous-index;

    callback selected(int);

    // For the host's compact-mode tooltip, drawn on a layer of its own: anything the header owns
    // is painted under the scroll body.
    out property <int> hovered-idx: -1;
    out property <string> hovered-label:
        root.hovered-idx >= 0 ? root.labels[root.hovered-idx] : "";

    // **Measured, not a literal threshold**, the labels being translated. Off an always-expanded
    // ruler, so it can't chase the flip.
    property <length> natural-tab-w: measure.preferred-width;
    // The glyph in the minimum touch target.
    property <length> compact-tab-w: 48px;
    // Published so a host sharing the row reserves against the bar's own number.
    out property <length> compact-w: root.labels.length * root.compact-tab-w;
    property <length> expand-w: root.labels.length * root.natural-tab-w;

    // A slow resize drag jitters across the line, so going compact and coming back are a band
    // apart. Only the latch is state; the threshold is re-derived.
    property <length> hysteresis: 24px;
    property <bool> latched: false;
    out property <bool> compact:
        root.avail-width < root.expand-w + (root.latched ? root.hysteresis : 0px);
    changed compact => {
        root.latched = root.compact;
        root.compact-t = root.compact ? 1.0 : 0.0;
    }

    // **Two sources, and every geometry derives from them unanimated**: easing a derived one
    // phase-lags, and easing `ind-x` would tie a tab pick to the cells resizing under a flip.
    property <float> anim-index: root.selected-index;
    animate anim-index { duration: Theme.dur-med; easing: ease-in-out; }

    // **The binding is only a seed**: `changed compact` writes it from the first flip on, so the
    // morph plays at one speed however slow the drag, a bound animation restarting on every
    // dirty input. `mini-player-switch.slint`'s `fade-opacity` is the same shape.
    property <float> compact-t: root.compact ? 1.0 : 0.0;
    // M3's emphasized-decelerate, not `Theme.dur-spatial`, whose tail reads as lag under a resize
    // drag. Both y control points sit in [0, 1], so no width goes negative. Off until `eased`: the
    // first resolution is the bar learning its room, not a change.
    animate compact-t {
        duration: 350ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
        enabled: root.eased;
    }

    // 100 ms rather than the usual 1 ms seed, so it **outlasts** the host's first `changed width`.
    // The page is rebuilt on every entry, so it resets for free.
    property <bool> eased: false;
    Timer {
        interval: 100ms;
        triggered => {
            root.eased = true;
            self.running = false;
        }
    }

    out property <length> tab-w:
        root.natural-tab-w + (root.compact-tab-w - root.natural-tab-w) * root.compact-t;
    property <length> ind-x: root.tab-w * root.anim-index;

    // Radius-less, so a scissor. It holds the morph's shrink leg, where `tab-w` lags the flip and
    // the cells draw past the right edge.
    clip: true;
    height: 48px;
    horizontal-stretch: 0;

    // **Three constraints, never a bound `width`**, which would put the bar's minimum on `tab-w`
    // and ease the window's own along with it.
    min-width: root.compact-w;
    preferred-width: root.labels.length * root.tab-w;
    max-width: root.labels.length * root.tab-w;

    // The ruler: real cells, so measured and drawn shapes can't drift. Hidden, it paints nothing
    // and takes no events, and its layout info is still computed.
    measure := VerticalLayout {
        visible: false;
        for tab-label[i] in root.labels: TabBarCell {
            label: tab-label;
            icon: root.icons[i];
            compact-t: 0.0;
        }
    }

    HorizontalLayout {
        alignment: start;
        // The divider's band, so a hovered fill floats above the line.
        padding-bottom: Theme.pad-sm;

        for tab-label[i] in root.labels: TabBarCell {
            width: root.tab-w;
            label: tab-label;
            icon: root.icons[i];
            selected: i == root.selected-index;
            compact-t: root.compact-t;
            label-color-idle: root.label-color;
            active-color: root.active-color;
            hover-fill: root.hover-fill;
            clicked => {
                root.previous-index = root.selected-index;
                root.selected-index = i;
                root.selected(i);
            }
            hover-changed(hovered) => {
                if (hovered) {
                    root.hovered-idx = i;
                } else if (root.hovered-idx == i) {
                    // A leave landing after the neighbour's enter would blank a live tooltip.
                    root.hovered-idx = -1;
                }
            }
        }
    }

    // Split either side of the pill, both off `ind-x`, so they cut with it rather than lagging.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: root.ind-x;
        height: 1px;
        background: root.divider-color;
    }

    Rectangle {
        x: root.ind-x + root.tab-w;
        y: parent.height - 1px;
        width: root.width - self.x;
        height: 1px;
        background: root.divider-color;
    }

    // Last, over the divider. A cell is far wider than the pill is tall, so `height / 2` needs no
    // clamp.
    Rectangle {
        x: root.ind-x;
        y: parent.height - 3px;
        width: root.tab-w;
        height: 3px;
        background: root.active-color;
        border-radius: self.height / 2;
    }
}
