import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";
import { FocusLossWatcher } from "focus-loss-watcher.slint";
import { MaterialIcon } from "material-icon.slint";
import { PopupColumn } from "popup-column.slint";
import { PopupDismissCatcher } from "popup-dismiss-catcher.slint";
import { PopupFit } from "popup-fit.slint";
import { PopupSurface } from "popup-surface.slint";

// **A menu opens on the right button's release, never its press**: Slint closes an open popup on a
// press outside it and swallows that press, so a right-click on another row reaches it only as a
// release. Inside the area, so a press dragged off before the release raises nothing.
export global ContextClick {
    pure public function raises-menu(
        ev: PointerEvent, x: length, y: length, width: length, height: length) -> bool {
        return ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right
            && x >= 0px && y >= 0px && x <= width && y <= height;
    }
}

// Shared by every right-click menu with a flyout. Opening rightward, a menu grows by the flyout's
// room while it is open; leftward it holds the room from the start, growing left moving an open
// popup's origin, which Slint moves a frame after its content.
export global ContextMenuMetrics {
    out property <length> item-h: 32px;
    out property <length> flyout-w: 200px;
    out property <length> gap: Theme.pad-xs;
    // The padding a menu column puts round its rows, which the flyout's rows line up with.
    out property <length> inset: PopupFit.column-inset;
    // The floor keeps a short menu reading as one, the ceiling a long translation inside the
    // window, a row past it eliding.
    out property <length> menu-min-w: 220px;
    out property <length> menu-max-w: 400px;
    out property <length> flyout-room: root.gap + root.flyout-w;

    // Off the rows' `preferred-width`, which only the popup holding them can read.
    pure public function menu-w(rows-w: length) -> length {
        return clamp(rows-w, root.menu-min-w, root.menu-max-w);
    }

    // Exactly the rows and their padding: any more and the column's layout spreads the surplus
    // between rows that cannot grow.
    pure public function flyout-h(rows: int) -> length {
        return rows * root.item-h + 2 * root.inset;
    }

    // A left flyout takes the room the popup was shifted by, so it starts at the popup's edge.
    pure public function flyout-x(left: bool, menu-w: length) -> length {
        return left ? 0px : menu-w + root.gap;
    }

    // Level with its row, lifted where the column wouldn't fit below it.
    pure public function flyout-y(row-y: length, popup-h: length, flyout-h: length) -> length {
        return max(0px, min(row-y - root.inset, popup-h - flyout-h));
    }

    // In window coordinates: a host passes its menu root's `absolute-position`, the root sitting
    // outside the popup.
    pure public function opens-left(anchor-x: length, menu-w: length) -> bool {
        return anchor-x + menu-w + root.flyout-room > WindowChrome.shell-x + WindowChrome.shell-width;
    }
}

// A menu with a flyout to keep open closes from the row's handler; one without leaves it to its
// popup's close policy.
export component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> destructive;
    // Opens a flyout rather than acting: a chevron pointing the way it opens, and the hover fill
    // held for as long as it is open, so the row it belongs to stays marked.
    in property <bool> submenu;
    in property <bool> submenu-open;
    in property <bool> submenu-left;

    callback clicked();

    height: ContextMenuMetrics.item-h;
    border-radius: Theme.radius-sm;
    background: touch.has-hover || root.submenu-open ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        cross-axis-alignment: center;

        MaterialIcon {
            name: root.icon;
            icon-size: 16px;
            icon-color: root.destructive ? Theme.red : Theme.subtext1;
        }

        // Elided, so a row past the menu's ceiling shortens inside it. Its preferred width
        // stays the whole label, which is what the menu sizes itself off.
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.destructive ? Theme.red : Theme.text;
            font-size: Theme.font-size-md;
            overflow: elide;
        }

        // **A fixed box round the chevron**: the side it points to is decided off the menu's
        // width, so the width may not read back the glyph that side picks.
        if root.submenu: Rectangle {
            width: 16px;
            height: 16px;
            MaterialIcon {
                x: 0px;
                y: 0px;
                name: root.submenu-left ? "chevron_left" : "chevron_right";
                icon-size: 16px;
                icon-color: Theme.subtext1;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Names the direction away from the clicked item and applies it to the whole set, so a selection
// of favorites is only ever offered their removal.
export component FavoriteMenuItem inherits MenuItem {
    in property <bool> is-favorite;
    in property <bool> multi-active;
    in property <int> multi-count;

    label: root.multi-active
        ? (root.is-favorite
            // Translators: `{}` is how many items are selected
            ? @tr("Remove {} from Favorites", root.multi-count)
            // Translators: `{}` is how many items are selected
            : @tr("Add {} to Favorites", root.multi-count))
        : (root.is-favorite ? @tr("Remove from Favorites") : @tr("Add to Favorites"));
    icon: root.is-favorite ? "heart_minus" : "favorite";
}

export component MenuFlyout inherits PopupSurface {
    width: ContextMenuMetrics.flyout-w;

    VerticalLayout {
        padding: ContextMenuMetrics.inset;
        spacing: 0;
        @children
    }
}

export component MenuSeparator inherits Rectangle {
    height: 7px;
    Rectangle {
        x: Theme.pad-xs;
        y: 3px;
        width: parent.width - 2 * Theme.pad-xs;
        height: 1px;
        background: Theme.surface2;
    }
}

// `token` is the field Rust's copy action parses.
export struct CopyField {
    token: string,
    label: string,
    icon: string,
}

// The popup the track, card and station menus open: their entries as children, and the Copy
// flyout beside them. The anchor and the flyout's open state stay on the host's root, where its
// `show-at` and `dismiss()` can reset them.
//
// **A column taller than the shell scrolls** in its `PopupColumn`, and the popup places its own
// `y`, Slint drawing an oversized one past the window's edge. The flyout's rows are data, the
// popup reserving their height before the flyout mounts, so an added row can't clip.
export component ContextMenuPopup inherits PopupWindow {
    // Where the menu was raised, in the host root's frame and in the window's, which only the host
    // can read, `absolute-position` inside a popup being the popup's.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-window-x;
    in property <length> anchor-window-y;
    // Off for a menu whose Copy entry acts on its one field, which then holds no room for a column
    // it never opens.
    in property <bool> has-copy-flyout: true;
    in property <bool> copy-open;
    in property <[CopyField]> copy-fields;
    in property <length> copy-row-y;

    // Wider by a gutter while it scrolls, which keeps the bar off the stars and the chevron without
    // taking width from a row.
    out property <length> menu-w: ContextMenuMetrics.menu-w(col.rows-w) + col.gutter;
    out property <bool> flyout-left: root.has-copy-flyout
        && ContextMenuMetrics.opens-left(root.anchor-window-x, root.menu-w);

    callback dismiss-requested();
    callback copy-picked(string /*token*/);

    property <length> menu-h: min(col.rows-h, PopupFit.max-h);
    property <length> flyout-h: ContextMenuMetrics.flyout-h(root.copy-fields.length);
    property <length> flyout-room:
        root.copy-open || root.flyout-left ? ContextMenuMetrics.flyout-room : 0px;
    // Fitted against the flyout as well, so opening it never moves an open popup.
    property <length> fitted-h: max(root.menu-h, root.has-copy-flyout ? root.flyout-h : 0px);

    x: root.anchor-x - (root.flyout-left ? root.flyout-room : 0px);
    y: PopupFit.fit-y(root.anchor-y, root.anchor-window-y, root.fitted-h);
    width: root.menu-w + root.flyout-room;
    height: max(root.menu-h, root.copy-open ? root.flyout-h : 0px);
    close-policy: close-on-click-outside;

    // Ungated: the body exists only while the popup is open, however many rows mount one.
    FocusLossWatcher {
        close => { root.dismiss-requested(); }
    }

    // First, so every row drawn over it wins its click and one beside the column still closes.
    PopupDismissCatcher {
        width: parent.width;
        height: parent.height;
        close-requested => { root.dismiss-requested(); }
    }

    PopupSurface {
        x: root.flyout-left ? root.flyout-room : 0px;
        y: 0px;
        width: root.menu-w;
        height: root.menu-h;

        col := PopupColumn {
            width: 100%;
            height: 100%;
            @children
        }
    }

    // Lined up with the Copy row as drawn, scroll included.
    if root.copy-open: MenuFlyout {
        x: ContextMenuMetrics.flyout-x(root.flyout-left, root.menu-w);
        y: ContextMenuMetrics.flyout-y(root.copy-row-y - col.scroll-y, root.height, root.flyout-h);
        height: root.flyout-h;

        for field in root.copy-fields: MenuItem {
            label: field.label;
            icon: field.icon;
            clicked => { root.copy-picked(field.token); }
        }
    }
}
