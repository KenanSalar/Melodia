import { Theme } from "../theme.slint";
import { OverlayScrollbar } from "overlay-scrollbar.slint";

// The bar every plain `TrackList` page mounts; `CompositeScrollbars` is for a list nested under
// another scroller. No horizontal bar: the columns always fit the list.
//
// **Mount contract**: a child of the view root after its list, at
// `x: 0; y: 0; width: 100%; height: 100%`. The host mirrors the rest off its `TrackList`, Slint
// having no way to hand an element over.
export component TrackListScrollbars inherits Rectangle {
    // **In the page's coordinates**: `tl.absolute-position.y - root.absolute-position.y`, right at
    // every nesting depth where a bare `tl.y` is right at one.
    in property <length> list-y;

    // The scrolling region inside the list, below its column headers.
    in property <length> body-y;
    in property <length> body-height;

    in property <length> v-visible-height;
    in property <length> v-viewport-height;
    in property <length> v-offset;

    // Forwarded to the list's own clamping setter, the host staying the source of truth.
    callback set-v-offset(length);

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: root.list-y + root.body-y;
        width: Theme.scrollbar-slot;
        height: root.body-height;
        visible-size: root.v-visible-height;
        content-size: root.v-viewport-height;
        offset: root.v-offset;
        scroll-to(o) => { root.set-v-offset(o); }
    }
}
