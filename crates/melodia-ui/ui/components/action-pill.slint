import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";

// The near-opaque chip hosting a row of `PillButton`s and `PillDivider`s. Each of those is a 32 px
// root over shorter, unplaced chrome, a plain parent centring a sized child.
export component ActionPill inherits Rectangle {
    height: 32px;
    border-radius: self.height / 2;
    // The hero back button's fill, so the two read as one family over a blur.
    background: Theme.floating-chrome-bg;
    // `PopupSurface`'s rim, which keeps the pill legible over a blur matching its fill.
    border-width: 1px;
    border-color: Theme.surface2;
    width: layout.preferred-width;

    layout := HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.pad-xs;
        alignment: center;
        @children
    }
}

// The chip-chrome button, for a segment of an `ActionPill` or a standalone secondary action. **The
// hover fill is opaque on purpose**: lifting out of a translucent pill is what makes it read.
//
// **`danger: true` keeps the chrome**, a permanent red fill being too loud in an inline row: only
// the hover tints the icon and label.
export component PillButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <length> icon-size: 14px;
    in property <bool> icon-filled: false;
    in property <bool> danger: false;
    // The current sort field, as the track-list header marks its column.
    in property <bool> active: false;
    // Holds the chevron's room **always**, so the label doesn't shift when a sort pill is clicked.
    // **Never put arrows in `text`**: a glyph Vazirmatn lacks pulls a fallback font off centre.
    in property <bool> reserve-sort-slot: false;
    in property <string> sort-direction: "";
    in property <string> tooltip-text: "";
    // 0 labelled, 1 the glyph alone with the label moved to the tooltip, a scalar so the label
    // closes as a compact tab's does. A text-only pill ignores it.
    in property <float> compact-t: 0.0;
    // For a host drawing the tooltip on a higher layer, off `hovered`.
    in property <bool> tooltip-overlay: false;
    out property <bool> hovered: touch.has-hover;
    // For a popup trigger, bound to its popup's `is-open`, the popup taking the hover.
    in property <bool> force-bg: false;
    callback clicked();

    // `TabBarCell`'s bias: the ink is gone by the time the slot is half closed.
    property <float> open: root.icon == "" ? 1.0 : 1.0 - root.compact-t;
    property <float> label-alpha: clamp(1.0 - (1.0 - root.open) * 2.0, 0.0, 1.0);

    // Published so a top-layer host asks this rather than restating the test.
    out property <bool> icon-only:
        root.icon != "" && (root.text == "" || root.label-alpha == 0.0);
    // A dropped label is the tooltip unless the pill names one of its own.
    out property <string> tip-text: root.tooltip-text != ""
        ? root.tooltip-text
        : (root.icon-only ? root.text : "");

    // **Eased here and faded downstream**: the label's fade folded into an eased brush would
    // restart the ease on every frame of a compact morph.
    property <brush> ink: root.danger
        ? (touch.has-hover ? Theme.danger : Theme.text)
        : (root.active ? Theme.accent : Theme.text);
    animate ink { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    height: 32px;
    width: chrome.width;

    chrome := Rectangle {
        height: 28px;
        // Square once only the glyph is left, so the hover reads as a round button.
        width: max(self.height, layout.preferred-width);
        border-radius: self.height / 2;
        background: (touch.has-hover || root.force-bg)
            ? Theme.surface1
            : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

        // Padding and spacing close with the label, so the glyph glides to the middle.
        layout := HorizontalLayout {
            padding-left: root.text == "" ? 0px : 10px * root.open;
            padding-right: root.text == "" ? 0px : 10px * root.open;
            spacing: 4px * root.open;
            alignment: center;
            cross-axis-alignment: center;

            // Balances the trailing arrow, so the label stays centred in the chrome.
            if root.reserve-sort-slot: Rectangle { width: 16px; }

            if root.icon != "": MaterialIcon {
                name: root.icon;
                icon-size: root.icon-size;
                filled: root.icon-filled;
                icon-color: root.ink;
            }
            // **Always mounted** with a label and closed by its slot, as a compact tab's is.
            // Rectangular so the clip is a scissor, as tall as the chrome so marks past the line
            // box keep their slack, and the label elides so its own line box doesn't cut them.
            if root.text != "": Rectangle {
                clip: true;
                width: lbl.preferred-width * root.open;
                height: chrome.height;

                lbl := Text {
                    x: 0px;
                    text: root.text;
                    color: root.ink.transparentize(1.0 - root.label-alpha);
                    font-size: Theme.font-size-sm;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Mounted while reserved, so the width doesn't follow `active`.
            if root.reserve-sort-slot: MaterialIcon {
                name: root.sort-direction == "asc"
                    ? "arrow_drop_up"
                    : "arrow_drop_down";
                icon-size: 16px;
                icon-color: root.sort-direction != ""
                    ? Theme.accent
                    : transparent;
            }
        }

        Tooltip {
            text: root.tip-text;
            hovered: touch.has-hover && !root.tooltip-overlay;
            host-width: chrome.width;
            host-height: chrome.height;
            // 28 px of chrome leaves a centred label nothing to centre against.
            align-end: root.icon-only;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component PillDivider inherits Rectangle {
    height: 32px;
    width: 1px;

    Rectangle {
        width: 1px;
        height: 18px;
        background: Theme.surface2.with-alpha(0.5);
    }
}
