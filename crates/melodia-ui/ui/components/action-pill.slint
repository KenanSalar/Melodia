import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";

// The rounded near-opaque chip hosting a row of pill segments; callers compose
// `PillButton` / `PillDivider` inside it.
//
// Each primitive below is a 32 px root, the pill's full height, over shorter chrome left
// unplaced: a plain parent centres a sized child, so no layout is needed for it.
export component ActionPill inherits Rectangle {
    height: 32px;
    border-radius: self.height / 2;
    // The same fill the hero's back button takes, so the two read as one family where
    // they sit side by side over a blur.
    background: Theme.floating-chrome-bg;
    // The `popup-surface.slint` chrome convention. It keeps the pill legible over a hero
    // blur whose dominant colour happens to match the fill — which the fill's
    // translucency only sharpens — and paints inside the layout box, so it shifts no
    // child.
    border-width: 1px;
    border-color: Theme.surface2;
    width: layout.preferred-width;

    layout := HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.pad-xs;
        alignment: center;
        @children
    }
}

// The pill-styled button: text-only, icon-only or both. The default home for any interactive
// segment inside an `ActionPill`, and for any standalone secondary action wanting the same chip
// chrome. **The hover fill is fully opaque on purpose** — lifting out of a translucent pill is what
// makes the hover read.
//
// **`danger: true` keeps the same chrome as any other pill.** A permanent red fill read as
// over-prominent for an inline action row, so at rest it looks identical and only the hover tints
// the icon *and* label to `Theme.danger`. `icon-size` corrects a glyph whose optical weight is off
// at the default, and `icon-filled` selects the filled Material Symbols variant.
export component PillButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <length> icon-size: 14px;
    in property <bool> icon-filled: false;
    in property <bool> danger: false;
    // Marks the current sort field in a row of sort pills, as the track-list header
    // marks its active column.
    in property <bool> active: false;
    // Reserves room for a trailing chevron **always**, so the label's x doesn't shift
    // when a sort pill is clicked; `sort-direction` picks the glyph, an empty string
    // leaving the slot transparent. **Never concatenate Unicode arrows into `text`** —
    // a character Vazirmatn lacks pulls a fallback font whose line box pushes the
    // patched glyphs off centre.
    in property <bool> reserve-sort-slot: false;
    in property <string> sort-direction: "";
    in property <string> tooltip-text: "";
    // 0 labelled, 1 the glyph alone with the label moved to the tooltip, for a row short of room.
    // A scalar rather than a bool, so the label closes onto its glyph the way a compact tab's
    // does. A text-only pill has nothing to stand in and ignores it.
    in property <float> compact-t: 0.0;
    // Suppresses the in-tree tooltip so a host can paint one on a higher layer, needed
    // wherever later-painted sibling content would occlude it. `hovered` is exposed so
    // the host can drive that overlay.
    in property <bool> tooltip-overlay: false;
    out property <bool> hovered: touch.has-hover;
    // For a popup trigger, bound to its popup's `is-open`: `has-hover` drops the moment the popup
    // takes the pointer, so hover alone would leave the pill dark under an open popup.
    in property <bool> force-bg: false;
    callback clicked();

    // What the label keeps of its slot. Its ink is gone by the time the slot is half closed, so
    // the clip never shows a half-eaten word: `TabBarCell`'s bias, off the same source rather than
    // eased on its own, which would phase-lag.
    property <float> open: root.icon == "" ? 1.0 : 1.0 - root.compact-t;
    property <float> label-alpha: clamp(1.0 - (1.0 - root.open) * 2.0, 0.0, 1.0);

    // `out` so a host drawing the pill on a higher layer asks this rather than restating the
    // test beside its own frame. The alignment below is the same rule on the other mount.
    out property <bool> icon-only:
        root.icon != "" && (root.text == "" || root.label-alpha == 0.0);
    // The same for the text: a dropped label is the tooltip unless the pill names one of its own.
    out property <string> tip-text: root.tooltip-text != ""
        ? root.tooltip-text
        : (root.icon-only ? root.text : "");

    // One ink for the glyph and the label. Danger tints red only on hover; otherwise accent when
    // active. **Eased here and faded downstream**: folding the label's fade into an eased brush
    // would restart the ease on every frame of a compact morph.
    property <brush> ink: root.danger
        ? (touch.has-hover ? Theme.danger : Theme.text)
        : (root.active ? Theme.accent : Theme.text);
    animate ink { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    height: 32px;
    width: chrome.width;

    chrome := Rectangle {
        height: 28px;
        // Square once only the glyph is left, so the hover reads as a round button; otherwise it
        // grows to fit its content, and a closing label shrinks it onto the square.
        width: max(self.height, layout.preferred-width);
        border-radius: self.height / 2;
        // One chrome for both; danger only re-tints on hover, through `ink`.
        background: (touch.has-hover || root.force-bg)
            ? Theme.surface1
            : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

        // Padding and spacing close with the label, so the glyph glides to the middle with no
        // arithmetic of its own.
        layout := HorizontalLayout {
            padding-left: root.text == "" ? 0px : 10px * root.open;
            padding-right: root.text == "" ? 0px : 10px * root.open;
            spacing: 4px * root.open;
            alignment: center;
            cross-axis-alignment: center;

            // A balance slot mirroring the trailing arrow. The chrome binds its
            // width to the layout's preferred, so without one, centring the
            // text-plus-arrow pair as a group pushes the label left of centre.
            if root.reserve-sort-slot: Rectangle { width: 16px; }

            // `MaterialIcon` pins the glyph in a collapsed em-box, so centring the box
            // lands the glyph at the chrome's centre.
            if root.icon != "": MaterialIcon {
                name: root.icon;
                icon-size: root.icon-size;
                filled: root.icon-filled;
                icon-color: root.ink;
            }
            // **Always mounted** with a label, and closed by shrinking its slot to nothing, as a
            // compact tab's is. Rectangular so it lowers to a scissor, as tall as the chrome so
            // marks reaching past the line box keep their slack, the label eliding so its own line
            // box doesn't cut them first, and pinned left so the clip eats the tail. The patched
            // Vazirmatn metrics land the glyph mass at the line-box centre, so centring the line
            // box is enough.
            if root.text != "": Rectangle {
                clip: true;
                width: lbl.preferred-width * root.open;
                height: chrome.height;

                lbl := Text {
                    x: 0px;
                    text: root.text;
                    color: root.ink.transparentize(1.0 - root.label-alpha);
                    font-size: Theme.font-size-sm;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Always rendered when reserved, so the chrome's width doesn't depend on
            // whether the pill is active; transparent with no direction.
            if root.reserve-sort-slot: MaterialIcon {
                name: root.sort-direction == "asc"
                    ? "arrow_drop_up"
                    : "arrow_drop_down";
                icon-size: 16px;
                icon-color: root.sort-direction != ""
                    ? Theme.accent
                    : transparent;
            }
        }

        Tooltip {
            text: root.tip-text;
            hovered: touch.has-hover && !root.tooltip-overlay;
            host-width: chrome.width;
            host-height: chrome.height;
            // 28 px of chrome under a label several times that leaves the centred arm
            // nothing to centre against, and these chips sit at the panel's right edge,
            // so the overhang is what the window clamp catches. A labelled pill is wide
            // enough to carry its own.
            align-end: root.icon-only;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// The hairline separating segments inside an `ActionPill`.
export component PillDivider inherits Rectangle {
    height: 32px;
    width: 1px;

    Rectangle {
        width: 1px;
        height: 18px;
        // Alpha in the brush, never `opacity` — free on a childless rect like
        // this one, and a layer that crops its subtree's ink on anything else.
        background: Theme.surface2.with-alpha(0.5);
    }
}
