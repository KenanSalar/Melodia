import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { SingleLineInput } from "single-line-input.slint";

// The compact filter input. Its fill **solidifies once the bar is engaged**: half its mounts sit
// over a detail hero, so at rest it lets some blur through like the `ActionPill` beside it.
//
// A named instance exposes `clear-input-focus()`; **`blur-trigger` is for a caller that can't reach
// the instance**, a descendant in another file bumping an int on the view's global.
export component SearchBar inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search…");

    // **Sized off the placeholder it was handed**, several catalogues needing more room than
    // English. Capped so a verbose locale can't take a header row; past the cap it elides.
    in property <length> input-width:
        clamp(root.natural-width, 220px, 320px);

    // Published so a host budgeting its row reserves against it, the `TabBar.compact-w` contract.
    out property <length> min-w: 140px;

    // For a host with two boxes on one filter, handing the focus across when it swaps them.
    out property <bool> has-focus: input.has-focus;

    // 0 the bar, 1 the glyph alone in a `bar-height` square, eased by a host short of room. The
    // input stays mounted at zero width, so a click on the square still focuses it.
    in property <float> fold-t: 0.0;

    property <length> icon-size: 16px;
    // The clear button stays out: it mounts only once there's text, and the placeholder is gone.
    property <length> chrome-overhead:
        Theme.pad-sm + root.icon-size + 2 * Theme.pad-xs;
    property <length> natural-width:
        input.placeholder-width + root.chrome-overhead;

    // Recessed into a surface rather than floating: the host's corner and no swell, inside a popup
    // there being nothing to be above.
    in property <bool> inset: false;
    // Its own knob for a stadium sitting in a column of rows, where growing would crowd them.
    in property <bool> focus-swell: !root.inset;
    in property <length> corner-radius: root.inset ? Theme.radius-md : root.height / 2;
    in property <length> bar-height: 32px;
    // On a card the floating fill composites to the card and leaves only the ring, so the bar takes
    // the card-control pair, as `FieldFrame` does.
    in property <bool> on-card: false;

    // Slint has no click-outside for a `TextInput`, so each increment clears the input's focus.
    in property <int> blur-trigger: 0;
    changed blur-trigger => { input.clear-input-focus(); }

    callback edited(string);
    // The ✕ alone, where `edited("")` also follows a backspace to empty.
    callback cleared();

    // **The Search view wires it** to commit without the debounce, so the same query can be run
    // again after a leave released its results.
    callback accepted();

    // Arms on the raw `has-hover` and releases on a latch, the flag blinking off for a frame over
    // the Search results this floats on (`slint-pitfalls.md`'s `has-hover` entry).
    property <bool> pointer-inside: chrome-touch.has-hover;
    property <bool> hover-held;
    property <bool> engaged:
        root.pointer-inside || root.hover-held || input.has-focus;

    changed pointer-inside => {
        if (root.pointer-inside) {
            root.hover-held = true;
            hover-grace.running = false;
        } else {
            hover-grace.running = true;
        }
    }

    // Long enough to swallow a blink, short enough that a real leave still reads as immediate.
    hover-grace := Timer {
        interval: 120ms;
        running: false;
        triggered() => {
            self.running = false;
            root.hover-held = root.pointer-inside;
        }
    }

    public function clear-input-focus() {
        input.clear-input-focus();
    }

    // `focus` collides with the built-in element method.
    public function focus-input() {
        input.focus-input();
    }

    // The `min`/`preferred`/`max` split rather than a bound `width`, which would drag the window's
    // resize floor out with a locale-sized default (`slint-pitfalls.md`). The floor gives way the
    // moment the fold begins.
    property <length> slot-w: input-width + (root.bar-height - input-width) * root.fold-t;
    min-width: root.fold-t > 0.0 ? root.bar-height : root.min-w;
    preferred-width: root.slot-w;
    max-width: root.slot-w;
    height: root.bar-height;
    background: transparent;

    // Scales from its centre inside the fixed slot, so neighbours don't shift on focus.
    chrome := Rectangle {
        property <float> focus-scale: input.has-focus && root.focus-swell ? 1.015 : 1.0;
        // **The ease is on the scale, never the dimensions**: those derive from it, and `width`
        // also reads the host's mirrored page width, which a resize drag dirties on every event.
        animate focus-scale { duration: Theme.dur-fast; easing: ease-in-out; }

        width: root.width * focus-scale;
        height: root.height * focus-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Floating, the `ActionPill` chip's fill at rest, closing to opaque as a hovered
        // `PillButton` does.
        property <brush> fill: root.on-card
            ? (root.engaged ? Theme.card-control-hover : Theme.card-control)
            : (root.engaged ? Theme.surface0 : Theme.floating-chrome-bg);
        background: self.fill;
        border-radius: root.corner-radius * self.focus-scale;
        border-width: 1px;
        // On a card the rim is the fill rather than `transparent`, a translucent border restacking
        // the corner's antialiasing.
        border-color: input.has-focus
            ? (root.on-card ? Theme.accent : Theme.accent.with-alpha(0.18))
            : (root.on-card ? self.fill : Theme.surface2);
        animate background, border-color {
            duration: Theme.dur-fast;
            easing: ease-in-out;
            enabled: !Theme.recoloring;
        }

        // **Wraps the content rather than sitting beside it**: `TextInput` consumes the hit test, so
        // a sibling lost its hover the moment the pointer crossed into the text. An ancestor gets
        // `has-hover` on the way down and still forwards the event (`track-list-row.slint`'s
        // `touch`).
        chrome-touch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { input.focus-input(); }

        HorizontalLayout {
            // Padding and spacing travel with the fold, so the glyph glides to the middle.
            property <length> fold-inset: (root.bar-height - root.icon-size) / 2;
            padding-left: Theme.pad-sm + (self.fold-inset - Theme.pad-sm) * root.fold-t;
            padding-right: Theme.pad-xs + (self.fold-inset - Theme.pad-xs) * root.fold-t;
            spacing: Theme.pad-xs * (1.0 - root.fold-t);
            alignment: stretch;

            MaterialIcon {
                cross-axis-self-alignment: center;
                name: "search";
                icon-size: root.icon-size;
                // At rest the placeholder's brush, so an empty bar's two halves sit on one rung.
                icon-color: input.has-focus
                    ? Theme.accent
                    : Theme.text.transparentize(0.3);
                animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
            }

            // The bar's full height rather than a line box: the same centre, and the clip around
            // the text leaves room for marks that reach past its line.
            input := SingleLineInput {
                horizontal-stretch: 1;
                text <=> root.text;
                placeholder: root.placeholder;
                // `PillButton`'s label brush, dimmed to stay a hint, and gone by the time the fold
                // is half closed, as a compact pill's label is.
                placeholder-color: Theme.text.transparentize(0.3)
                    .transparentize(1.0 - clamp(1.0 - root.fold-t * 2.0, 0.0, 1.0));
                edited(t) => { root.edited(t); }
                accepted => { root.accepted(); }
            }

            if root.text != "": Rectangle {
                cross-axis-self-alignment: center;
                width: 22px;
                height: 22px;
                border-radius: self.height / 2;
                background: clear-touch.has-hover ? Theme.surface1 : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
                MaterialIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "close";
                    icon-size: 14px;
                    icon-color: Theme.subtext0;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                        root.cleared();
                    }
                }
            }
        }
        }
    }
}
