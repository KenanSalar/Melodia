import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { SingleLineInput } from "single-line-input.slint";

// The reusable compact filter input: an `ActionPill`-matching outline over a fill that
// **solidifies the moment the bar is engaged** — half its mounts sit over a detail hero, so at rest
// it lets a little blur through like the pill beside it. The outer slot asks for `input-width` and
// never stretches past it; the visible chrome is an inner Rectangle scaling from its own centre, so
// neighbours don't shift on focus.
//
// A named instance exposes `clear-input-focus()` for a backdrop or pill. **`blur-trigger` is for
// the case that can't reach the instance**: a descendant in another file bumps an int on the view's
// global. Omit it when nothing outside the view file triggers a blur.
export component SearchBar inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search…");

    // **The default fits the placeholder the bar was actually handed**, a flat number being unable
    // to: several catalogues need noticeably more room than English. Capped so a verbose locale
    // can't take a whole header row; past the cap the placeholder elides.
    in property <length> input-width:
        clamp(root.natural-width, 220px, 320px);

    // Published so a host budgeting its row reserves against it rather than restating the number —
    // the `TabBar.compact-w` contract. What the host leaves behind is exactly what this shrinks to.
    out property <length> min-w: 140px;

    // Named because `chrome-overhead` has to add the same number the layout does.
    property <length> icon-size: 16px;
    // Everything in the pill that isn't the text. The clear button stays out: it only mounts
    // once there's text, by which point the placeholder is gone.
    property <length> chrome-overhead:
        Theme.pad-sm + root.icon-size + 2 * Theme.pad-xs;
    // Measured off the Text the bar actually draws, so measured and drawn can't drift. A Text's
    // *horizontal* layout info is intrinsic to the string, so this is a derivation and not a cycle.
    property <length> natural-width:
        input.placeholder-width + root.chrome-overhead;

    // Recessed into a surface rather than floating over content: the host's corner instead of a
    // stadium, and no swell — inside a popup there is nothing to be above. Fills, border
    // tint, placeholder and icon are unchanged, so both shapes read as one control.
    in property <bool> inset: false;

    // Slint has no click-outside behaviour for `TextInput`, so each increment fires
    // `clear-focus()` on the inner input.
    in property <int> blur-trigger: 0;
    changed blur-trigger => { input.clear-input-focus(); }

    callback edited(string);

    // Most consumers don't wire this, their `edited` already refiltering per keystroke. **The
    // Search view does**: it skips the debounce and commits synchronously, so a user can re-trigger
    // the same query after navigating away and back — the leave released the results, not the query.
    callback accepted();

    // **`has-hover` is not continuous, so the fill can't read it raw.** Slint drops the flag on a
    // wheel event the bar doesn't handle, and its exit dispatch compares an item's stack *position*
    // rather than its membership. Either way it blinks off for a frame, invisible over a flat panel
    // and a visible flicker over the Search results this floats on. So `engaged` arms on the raw
    // flag and releases only once the pointer has stayed gone, the rail tooltip's `held` shape —
    // **beside the raw flag, not replacing it**, `changed` not firing on a first evaluation.
    property <bool> pointer-inside: chrome-touch.has-hover;
    property <bool> hover-held;
    property <bool> engaged:
        root.pointer-inside || root.hover-held || input.has-focus;

    changed pointer-inside => {
        if (root.pointer-inside) {
            root.hover-held = true;
            hover-grace.running = false;
        } else {
            hover-grace.running = true;
        }
    }

    // Long enough to swallow a blink, short enough that a real leave still reads as
    // immediate against the fade that follows it.
    hover-grace := Timer {
        interval: 120ms;
        running: false;
        triggered() => {
            self.running = false;
            root.hover-held = root.pointer-inside;
        }
    }

    // The simple case: a same-file caller with an id skips the `blur-trigger` plumbing.
    public function clear-input-focus() {
        input.clear-input-focus();
    }

    // For a view auto-focusing its bar on mount. Named `focus-input` because `focus`
    // collides with the built-in element method.
    public function focus-input() {
        input.focus-input();
    }

    // The slot still doesn't stretch — `preferred` and `max` are the same number, so the bar is
    // handed exactly `input-width` and the focus swell happens *inside* it. **What the split buys
    // over a bound `width` is the other end**: Slint reports a root's bound `width` as both `min`
    // and `max`, so a locale-sized default would drag the window's own resize floor out with it.
    min-width: root.min-w;
    preferred-width: input-width;
    max-width: input-width;
    height: 32px;
    background: transparent;

    // Holds all the visible styling and scales from the *centre* by binding `x`/`y` to a half-delta
    // against the outer slot — Slint Rectangles have no scale transform.
    chrome := Rectangle {
        property <float> focus-scale: input.has-focus && !root.inset ? 1.015 : 1.0;
        animate focus-scale { duration: Theme.dur-fast; easing: ease-in-out; }

        width: root.width * focus-scale;
        height: root.height * focus-scale;
        // The half-delta keeps the chrome centred against the slot as it scales.
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Rest matches the `ActionPill` chip's fill, so adjacent bars and pills read as
        // one family; engagement closes it to opaque, as a hovered `PillButton` does.
        background: root.engaged
            ? Theme.surface0
            : Theme.floating-chrome-bg;
        // The `ActionPill` outline at rest; focus tints the ring faintly toward the accent.
        border-radius: root.inset ? Theme.radius-md : self.height / 2;
        border-width: 1px;
        border-color: input.has-focus
            ? Theme.accent.with-alpha(0.18)
            : Theme.surface2;
        // **The ease belongs on the scale, not on the dimensions.** Animating a binding derived
        // from another animating property phase-lags, and `width`/`height` derive from this while
        // `x`/`y` derive from those. Second reason: `width` also multiplies `root.width`, which the
        // Settings header drives off the live window width, and Slint restarts an animated binding
        // on dependency *dirtiness* — so an eased `width` re-based on every event of a resize drag.
        // `focus-scale` reads the focus flag and a mount-constant variant, so it only ever sees
        // the toggle.
        animate background, border-color {
            duration: Theme.dur-fast;
            easing: ease-in-out;
            enabled: !Theme.recoloring;
        }

        // **Wraps the content rather than sitting beside it.** As a sibling its `has-hover` only
        // reported the padding and border: `TextInput` consumes the hit test, so the pointer
        // vanished the moment it crossed into the text. An ancestor TouchArea gets `has-hover` on
        // the top-down filter pass and still forwards the event, so the clear button and the
        // `TextInput` keep their clicks — the same fix as `touch` in `track-list-row.slint`.
        chrome-touch := TouchArea {
            width: 100%;
            height: 100%;
            // Forwards focus so the whole pill is the target, not just the input.
            clicked => { input.focus-input(); }

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-xs;
            spacing: Theme.pad-xs;
            alignment: stretch;

            MaterialIcon {
                cross-axis-self-alignment: center;
                name: "search";
                icon-size: root.icon-size;
                // Rest matches the placeholder beside it, so the two halves of
                // an empty bar sit on one rung.
                icon-color: input.has-focus
                    ? Theme.accent
                    : Theme.text.transparentize(0.3);
                animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
            }

            // The bar's full height rather than a line-sized box centred in it: the same centre,
            // and the clip around the text then leaves room for marks that reach past its line.
            input := SingleLineInput {
                horizontal-stretch: 1;
                text <=> root.text;
                placeholder: root.placeholder;
                // `PillButton`'s label brush, so a bar and the pills beside it read as one family,
                // dimmed just enough to stay a hint rather than typed text.
                placeholder-color: Theme.text.transparentize(0.3);
                edited(t) => { root.edited(t); }
                accepted => { root.accepted(); }
            }

            if root.text != "": Rectangle {
                cross-axis-self-alignment: center;
                width: 22px;
                height: 22px;
                border-radius: self.height / 2;
                background: clear-touch.has-hover ? Theme.surface1 : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
                MaterialIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "close";
                    icon-size: 14px;
                    icon-color: Theme.subtext0;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
        }
    }
}
