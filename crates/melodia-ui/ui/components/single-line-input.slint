import { Theme } from "../theme.slint";
import { TextEditMenu } from "text-edit-menu.slint";
import { ContextClick } from "context-menu.slint";

// The editing half of every single-line field, the host drawing the chrome: the `TextInput`, the
// placeholder Slint doesn't give it, and what std-widgets' `LineEdit` adds to one.
//
// **The text slides to keep the cursor in view**, a bare `TextInput` clipping at its own width and
// never scrolling. Upstream's `LineEditBase` arrangement: the input as wide as its text inside a
// clip, moved on every cursor move.
//
// The input takes only left and middle clicks, so a right one reaches the area round it, which
// opens the edit menu.
export component SingleLineInput inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <brush> placeholder-color: Theme.overlay2;
    in property <InputType> input-type: InputType.text;
    // The edit menu holds the keyboard while it is up, so the field reads as focused across it
    // rather than dimming under its own menu.
    out property <bool> has-focus: ti.has-focus || menu.is-open;
    // For a host sizing itself to its hint.
    out property <length> placeholder-width: hint.preferred-width;

    callback edited(string);
    callback accepted();

    // Apart from the built-in `focus` and `clear-focus`, which act on this element.
    public function focus-input() {
        ti.focus();
    }

    public function clear-input-focus() {
        ti.clear-focus();
    }

    // How near the cursor comes to either edge before the text slides.
    property <length> edge-margin: Theme.pad-xs;

    // No radius, so a scissor rather than a layer.
    clip: true;

    TouchArea {
        pointer-event(event) => {
            if (ContextClick.raises-menu(event, self.mouse-x, self.mouse-y, self.width, self.height)) {
                // First, so the popup hands the keyboard back to this field when it closes.
                ti.focus();
                menu.show-at(self.mouse-x, self.mouse-y);
            }
        }

        hint := Text {
            // Hidden while an input method composes too, or the hint paints under the composition.
            visible: root.text == "" && ti.preedit-text == "";
            text: root.placeholder;
            color: root.placeholder-color;
            font-size: Theme.font-size-md;
            vertical-alignment: center;
            // Bounded and elided, per the faked-placeholder pitfall.
            x: 0;
            width: 100%;
            height: 100%;
            overflow: elide;
        }

        ti := TextInput {
            // Where the cursor last pushed the text; the clamp keeps either end from leaving a gap
            // once the text shrinks.
            property <length> scroll-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            color: Theme.text;
            font-size: Theme.font-size-md;
            single-line: true;
            vertical-alignment: center;
            input-type: root.input-type;

            cursor-position-changed(cursor-position) => {
                if (cursor-position.x + self.scroll-x < root.edge-margin) {
                    self.scroll-x = root.edge-margin - cursor-position.x;
                } else if (cursor-position.x + self.scroll-x
                        > parent.width - root.edge-margin - self.text-cursor-width) {
                    self.scroll-x = parent.width - root.edge-margin - self.text-cursor-width
                        - cursor-position.x;
                }
            }
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
        }
    }

    menu := TextEditMenu {
        has-text: root.text != "";
        cut => { ti.cut(); }
        copy => { ti.copy(); }
        paste => { ti.paste(); }
        select-all => { ti.select-all(); }
    }
}
