import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";
import { Tooltip, TooltipSide } from "tooltip.slint";

export enum CaptionGlyph { minimize, maximize, restore, close }

// Whose drawn caption the button follows. macOS isn't one: its traffic lights share nothing with
// these and are `MacOsTitleBarCluster`.
export enum CaptionStyle { standard, kde }

// One decoration button, drawn rather than an `IconButton`'s font glyph: Segoe Fluent Icons isn't
// ours to ship, and Material Symbols' window icons have proportions of their own.
//
// The standard style is Windows 11's: a 46 × 32 cell filled edge to edge under the pointer and a
// 10 px glyph of 1 px strokes. The KDE style is Breeze's at its default button size
// (`breezebutton.cpp`): chevrons, a diamond for restore, and under the pointer an 18 px disc in the
// caption's ink with the glyph punched out of it.
export component CaptionButton inherits Rectangle {
    in property <CaptionGlyph> glyph;
    in property <CaptionStyle> style: CaptionStyle.standard;
    in property <string> tooltip-text;
    // Dimmed on an unfocused window, as an OS draws its own caption.
    in property <brush> idle-fg: Theme.window-focused ? Theme.text : Theme.overlay1;
    // Breeze fills the disc with the caption's ink and draws the glyph in the titlebar's colour.
    in property <brush> hover-bg: root.kde ? root.idle-fg : Theme.surface0;
    in property <brush> hover-fg: root.kde ? Theme.mantle : Theme.text;
    // KDE only: Breeze holds the disc 30 % of the way from the titlebar to the ink while pressed.
    in property <brush> pressed-bg: root.hover-bg.transparentize(0.7);
    // **The width is the style's pitch and no host changes it**, a narrower cluster reading as
    // another decoration; a host with a shorter row changes the height. A KDE cell is Breeze's
    // pitch everywhere.
    in property <length> cell-width: 46px;
    in property <length> cell-height: 32px;

    callback clicked();

    property <bool> kde: root.style == CaptionStyle.kde;
    // Breeze's 20 px button plus the 4 px it leaves before the next, split either side so the hit
    // targets meet.
    property <length> pitch: root.kde ? 24px : root.cell-width;

    // Pinned rather than `height: 100%`, which leaves a layout child unbounded and collapses the
    // sibling buttons to zero width.
    min-width: root.pitch;
    max-width: root.pitch;
    min-height: root.cell-height;
    max-height: root.cell-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    property <length> glyph-size: root.kde ? 18px : 10px;

    // Only the fill's alpha moves: straight RGBA from `transparent` dips through black, which a
    // light disc shows.
    property <float> hover-t: touch.has-hover ? 1.0 : 0.0;
    animate hover-t { duration: Theme.dur-fast; easing: ease-in-out; }

    // A standard fill is the whole cell, square, as Windows paints: close runs into the window's
    // corner, where the shell's clip rounds it.
    Rectangle {
        width: root.kde ? root.glyph-size : parent.width;
        height: root.kde ? root.glyph-size : parent.height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: root.kde ? self.width / 2 : 0px;
        // Breeze steps into and out of the press, easing only the hover.
        background: root.kde && touch.pressed
            ? root.pressed-bg
            : root.hover-bg.transparentize(1.0 - root.hover-t);
    }

    // Slint fits a path into its box inset and shifted by half a stroke (`Path::fitted_path_events`),
    // which shrank the glyph to 9 px and smeared its edges over two pixels. A box a stroke larger
    // and a viewbox half a unit in cancel both, so each half-pixel coordinate lands a stroke on one
    // pixel row. Without a viewbox Slint fits the path's own bounds, and minimize has no height.
    glyph-path := Path {
        x: (root.width - root.glyph-size) / 2;
        y: (root.height - root.glyph-size) / 2;
        width: root.glyph-size + self.stroke-width;
        height: root.glyph-size + self.stroke-width;
        viewbox-x: self.stroke-width / 2px;
        viewbox-y: self.stroke-width / 2px;
        viewbox-width: root.glyph-size / 1px;
        viewbox-height: root.glyph-size / 1px;
        commands: root.kde ? root.kde-commands : root.standard-commands;
        stroke: root.idle-fg;
        stroke-width: 1px;
        // Square where Breeze is round: at scale 1 a round cap this thin tessellates to nothing.
        stroke-line-cap: root.kde ? LineCap.square : LineCap.butt;
        stroke-line-join: round;
    }

    property <string> standard-commands: root.glyph == CaptionGlyph.minimize ? "M 0 5.5 H 10"
        : root.glyph == CaptionGlyph.maximize ? "M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z"
        : root.glyph == CaptionGlyph.restore ? "M 0.5 2.5 H 7.5 V 9.5 H 0.5 Z M 2.5 2.5 V 0.5 H 9.5 V 7.5 H 7.5"
        : "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";

    // Breeze's own coordinates: an 18-unit box, a unit to the pixel at its default size.
    property <string> kde-commands: root.glyph == CaptionGlyph.minimize ? "M 4 7 L 9 12 L 14 7"
        : root.glyph == CaptionGlyph.maximize ? "M 4 11 L 9 6 L 14 11"
        : root.glyph == CaptionGlyph.restore ? "M 4 9 L 9 4 L 14 9 L 9 14 Z"
        : "M 5 5 L 13 13 M 13 5 L 5 13";

    // A transition rather than `animate stroke`, so only a hover eases: a focus change snaps with
    // the title and the window outline, as the OS repaints its caption.
    states [
        hover when touch.has-hover: {
            glyph-path.stroke: root.hover-fg;
            in {
                animate glyph-path.stroke { duration: Theme.dur-fast; easing: ease-in-out; }
            }
            out {
                animate glyph-path.stroke { duration: Theme.dur-fast; easing: ease-in-out; }
            }
        }
    ]

    // Below, a caption always sitting on the window's top edge.
    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
        host-height: root.height;
        side: TooltipSide.below;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The miniplayer mounts the outer two round a middle button of its own, which restores the full
// player rather than maximizing.
export component MinimizeCaption inherits CaptionButton {
    glyph: CaptionGlyph.minimize;
    tooltip-text: @tr("Minimize");
    clicked => { WindowChrome.minimize(); }
}

export component MaximizeCaption inherits CaptionButton {
    glyph: WindowChrome.is-maximized ? CaptionGlyph.restore : CaptionGlyph.maximize;
    tooltip-text: WindowChrome.is-maximized ? @tr("Restore") : @tr("Maximize");
    clicked => { WindowChrome.toggle-maximize(); }
}

export component CloseCaption inherits CaptionButton {
    glyph: CaptionGlyph.close;
    tooltip-text: @tr("Close");
    hover-bg: Theme.danger;
    // **The on-danger ink, never a chrome token** like `Theme.mantle`, which tracks the background
    // rather than the red and lands a dark theme's glyph dark on it. KDE takes it too, though
    // Breeze draws the titlebar's colour.
    hover-fg: Theme.danger-text;
    // Breeze darkens the red while held.
    pressed-bg: Theme.danger.darker(1.0);
    clicked => { WindowChrome.close-window(); }
}
