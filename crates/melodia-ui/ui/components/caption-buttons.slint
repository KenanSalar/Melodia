import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";
import { Tooltip, TooltipSide } from "tooltip.slint";

export enum CaptionGlyph { minimize, maximize, restore, close }

// Whose drawn caption the button follows. macOS isn't one: its traffic lights share nothing with
// these and are `MacOsTitleBarCluster`.
export enum CaptionStyle { standard, kde }

// One decoration button. Hover paints a fill behind the glyph; the close button overrides both hover
// brushes to flash the theme's danger red. Bespoke rather than an `IconButton`, whose glyph is a font
// icon: these are drawn.
//
// The standard cell and glyph follow Windows 11's caption buttons: 46 × 32, with a 10 px glyph of 1 px
// strokes. The glyphs are drawn because Segoe Fluent Icons isn't ours to ship, and Material Symbols'
// window icons have proportions of their own, `minimize` sitting on the baseline like an underscore.
//
// The KDE style follows Breeze's decoration at its default button size (`breezebutton.cpp`): chevrons
// for minimize and maximize, a diamond for restore, and under the pointer an 18 px disc in the
// caption's ink with the glyph punched out of it.
export component CaptionButton inherits Rectangle {
    in property <CaptionGlyph> glyph;
    in property <CaptionStyle> style: CaptionStyle.standard;
    in property <string> tooltip-text;
    // Full ink on the focused window and dimmed otherwise, as an OS draws its own caption.
    in property <brush> idle-fg: Theme.window-focused ? Theme.text : Theme.overlay1;
    // Breeze fills the disc with the caption's own ink and draws the glyph in the titlebar's colour.
    in property <brush> hover-bg: root.kde ? root.idle-fg : Theme.surface0;
    in property <brush> hover-fg: root.kde ? Theme.mantle : Theme.text;
    // KDE only. Breeze holds the disc 30 % of the way from the titlebar to the ink while pressed, and
    // the glyph keeps its hover colour.
    in property <brush> pressed-bg: root.hover-bg.transparentize(0.7);
    // The standard cell. **The width is the style's pitch and no host changes it**: a narrower
    // cluster reads as a different decoration beside the titlebar's. The height is what a host with
    // a shorter row than a titlebar changes. A KDE cell is Breeze's button pitch in every host,
    // narrower than any of them, and the glyph keeps its size either way.
    in property <length> cell-width: 46px;
    in property <length> cell-height: 32px;

    callback clicked();

    property <bool> kde: root.style == CaptionStyle.kde;
    // Breeze's 20 px button plus the 4 px it leaves before the next, split either side so the hit
    // targets meet.
    property <length> pitch: root.kde ? 24px : root.cell-width;

    // Pinned on both axes as a layout child: `height: 100%` forms the unbounded-layout
    // cycle and collapses the sibling buttons to zero width.
    min-width: root.pitch;
    max-width: root.pitch;
    min-height: root.cell-height;
    max-height: root.cell-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    property <length> glyph-size: root.kde ? 18px : 10px;

    // Eased as a float so only the fill's alpha moves: straight RGBA from `transparent` dips through
    // black, which a light disc shows.
    property <float> hover-t: touch.has-hover ? 1.0 : 0.0;
    animate hover-t { duration: Theme.dur-fast; easing: ease-in-out; }

    // A standard fill is inset inside the cell, so the click target stays wide for aim while the
    // painted highlight reads lighter than the full button would. A KDE disc is the glyph box.
    Rectangle {
        width: root.kde ? root.glyph-size : parent.width - 8px;
        height: root.kde ? root.glyph-size : parent.height - 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // The standard fill tracks the window's outer radius, so every button reads as matched to
        // the outline: the close button at the corner is genuinely concentric with the window's arc,
        // and the other two take the same value. Floored at 0 for the Square preset, and only the
        // preset chips populate `shell-radius`, so the subtraction never needs a piecewise floor.
        // Maximized falls back to a pill — the outline goes square there, and 0 reads too sharp on
        // a button.
        border-radius: root.kde
            ? self.width / 2
            : WindowChrome.is-maximized ? 6px : max(0px, Theme.shell-radius - 4px);
        // Breeze steps into and out of the press, easing only the hover.
        background: root.kde && touch.pressed
            ? root.pressed-bg
            : root.hover-bg.transparentize(1.0 - root.hover-t);
    }

    // Slint fits a path into its box inset by the stroke width and shifted half a stroke
    // (`Path::fitted_path_events`), which scaled the glyph to 9 px and pushed the square's edges
    // across two half-lit pixels. Growing the box by a stroke and starting the viewbox half a unit
    // in cancels both, so path units are the glyph box's own pixels and the half-pixel coordinates
    // put each stroke on one pixel row. The viewbox is required anyway: without it Slint fits the
    // path's own bounds, and the minimize line has no height to fit.
    glyph-path := Path {
        x: (root.width - root.glyph-size) / 2;
        y: (root.height - root.glyph-size) / 2;
        width: root.glyph-size + self.stroke-width;
        height: root.glyph-size + self.stroke-width;
        viewbox-x: self.stroke-width / 2px;
        viewbox-y: self.stroke-width / 2px;
        viewbox-width: root.glyph-size / 1px;
        viewbox-height: root.glyph-size / 1px;
        commands: root.kde ? root.kde-commands : root.standard-commands;
        stroke: root.idle-fg;
        stroke-width: 1px;
        // Square where Breeze is round: FemtoVG draws no round cap this thin (`slint-pitfalls.md`).
        stroke-line-cap: root.kde ? LineCap.square : LineCap.butt;
        stroke-line-join: round;
    }

    property <string> standard-commands: root.glyph == CaptionGlyph.minimize ? "M 0 5.5 H 10"
        : root.glyph == CaptionGlyph.maximize ? "M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z"
        : root.glyph == CaptionGlyph.restore ? "M 0.5 2.5 H 7.5 V 9.5 H 0.5 Z M 2.5 2.5 V 0.5 H 9.5 V 7.5 H 7.5"
        : "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";

    // Breeze's own coordinates: it draws in an 18-unit box, a unit to the pixel at its default size.
    property <string> kde-commands: root.glyph == CaptionGlyph.minimize ? "M 4 7 L 9 12 L 14 7"
        : root.glyph == CaptionGlyph.maximize ? "M 4 11 L 9 6 L 14 11"
        : root.glyph == CaptionGlyph.restore ? "M 4 9 L 9 4 L 14 9 L 9 14 Z"
        : "M 5 5 L 13 13 M 13 5 L 5 13";

    // A transition rather than `animate stroke`, so only a hover eases. A focus change then snaps
    // together with the title text and the window outline, the way the OS repaints its caption.
    states [
        hover when touch.has-hover: {
            glyph-path.stroke: root.hover-fg;
            in {
                animate glyph-path.stroke { duration: Theme.dur-fast; easing: ease-in-out; }
            }
            out {
                animate glyph-path.stroke { duration: Theme.dur-fast; easing: ease-in-out; }
            }
        }
    ]

    // Below, a caption always sitting on the window's top edge.
    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
        host-height: root.height;
        side: TooltipSide.below;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The three captions, fixed but for their style and where a host mounts them. The miniplayer mounts
// the outer two and a `CaptionButton` of its own between them, its middle button restoring the full
// player rather than maximizing.
export component MinimizeCaption inherits CaptionButton {
    glyph: CaptionGlyph.minimize;
    tooltip-text: @tr("Minimize");
    clicked => { WindowChrome.minimize(); }
}

export component MaximizeCaption inherits CaptionButton {
    glyph: WindowChrome.is-maximized ? CaptionGlyph.restore : CaptionGlyph.maximize;
    tooltip-text: WindowChrome.is-maximized ? @tr("Restore") : @tr("Maximize");
    clicked => { WindowChrome.toggle-maximize(); }
}

export component CloseCaption inherits CaptionButton {
    glyph: CaptionGlyph.close;
    tooltip-text: @tr("Close");
    hover-bg: Theme.danger;
    // **The on-danger ink, not a chrome token.** `Theme.mantle` stood in here once and it tracks
    // the theme's *background* rather than the red, so GNOME Dark put a dark glyph on a dark red at
    // ~2:1. KDE keeps it too, though Breeze draws the titlebar's colour, for the same reason.
    hover-fg: Theme.danger-text;
    // Breeze darkens the red while held.
    pressed-bg: Theme.danger.darker(1.0);
    clicked => { WindowChrome.close-window(); }
}
