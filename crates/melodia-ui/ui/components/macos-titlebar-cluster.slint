import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";
import { MacOsTrafficLight } from "macos-traffic-light.slint";

// The macOS decoration cluster. Close and minimize go to the same `WindowChrome` callbacks the
// standard captions use, so Rust never knows which style is live. **Maximize is the host's**: the
// titlebar toggles the window, where the miniplayer restores the full player.
export component MacOsTitleBarCluster inherits Rectangle {
    // The titlebar's setting by default; a host with a fixed placement hands its own, so close
    // stays at the corner it actually sits beside.
    in property <bool> captions-left: Theme.titlebar-button-side == 1;
    in property <length> cell-height: 32px;
    in property <string> maximize-tooltip: WindowChrome.is-maximized ? @tr("Restore") : @tr("Maximize");
    callback maximize();

    property <bool> cluster-hovered:
        close-light.hovered || min-light.hovered || max-light.hovered;

    // Pinned to the host's row, so the cluster centres without inheriting the row's stretch.
    min-height: root.cell-height;
    max-height: root.cell-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    GridLayout {
        spacing: 4px;
        padding-top: 0;
        padding-bottom: 0;
        // Wider on the window-corner side, so close sits a touch in from the corner.
        padding-left: root.captions-left ? 8px : 4px;
        padding-right: root.captions-left ? 4px : 8px;

        // `col` flips so close is outermost on either side.
        close-light := MacOsTrafficLight {
            col: root.captions-left ? 0 : 2;
            row: 0;
            cell-height: root.cell-height;
            circle-color: Theme.red;
            glyph-icon: "close";
            tooltip-text: @tr("Close");
            cluster-hovered: root.cluster-hovered;
            clicked => { WindowChrome.close-window(); }
        }

        min-light := MacOsTrafficLight {
            col: 1;
            row: 0;
            cell-height: root.cell-height;
            circle-color: Theme.yellow;
            glyph-icon: "minimize";
            tooltip-text: @tr("Minimize");
            cluster-hovered: root.cluster-hovered;
            clicked => { WindowChrome.minimize(); }
        }

        max-light := MacOsTrafficLight {
            col: root.captions-left ? 2 : 0;
            row: 0;
            cell-height: root.cell-height;
            circle-color: Theme.green;
            // Material Symbols Rounded has no zoom glyph; `add` is the closest widely read "expand".
            glyph-icon: "add";
            tooltip-text: root.maximize-tooltip;
            cluster-hovered: root.cluster-hovered;
            clicked => { root.maximize(); }
        }
    }
}
