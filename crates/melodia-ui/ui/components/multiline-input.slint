import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FieldFrame } from "field-frame.slint";
import { OverlayScrollbar } from "overlay-scrollbar.slint";

// The tree's only wrapping text box: std-widgets' `TextEdit` forwards no appearance properties, so
// it can't be themed to match a dialog. The scrolling recipe is Slint's own
// `widgets/common/textedit-base.slint`.
//
// **No `border-radius` + `clip: true` on the box holding the `TextInput`**: a rounded clip renders
// the text into a texture. `FieldFrame` paints fill and border as one shape, and the `ScrollView`
// clips its viewport square, inset by `pad` so nothing scrolled reaches the border.
export component MultilineInput inherits FieldFrame {
    in property <string> placeholder;
    in-out property <string> text;

    private property <length> pad: Theme.pad-sm;

    focused: ti.has-focus;

    sv := ScrollView {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height - 2 * root.pad;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        // The width locked so lines wrap. The height's `max` gives the content travel past the
        // viewport, without which the caret handler has nothing to scroll and long text runs off.
        content-width: self.visible-width;
        content-height: max(self.visible-height, ti.preferred-height);

        ti := TextInput {
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.font-size-md;
            single-line: false;
            wrap: word-wrap;
            page-height: sv.visible-height;
            // Keeps the caret on screen: upstream's y-branch alone, word-wrap making x inert, with
            // the line height off the font size rather than hardcoded.
            cursor-position-changed(cpos) => {
                if (cpos.y + sv.content-y < 12px) {
                    sv.content-y = min(0px, max(sv.visible-height - self.height, -cpos.y + 12px));
                } else if (cpos.y + sv.content-y > sv.visible-height - 12px - Theme.font-size-md * 1.5) {
                    sv.content-y = min(0px, max(sv.visible-height - self.height, sv.visible-height - cpos.y - 12px - Theme.font-size-md * 1.5));
                }
            }
        }
    }

    // Faked, `TextInput` having no `placeholder-text`.
    Text {
        x: sv.x;
        y: sv.y;
        width: sv.width;
        vertical-alignment: top;
        text: root.text == "" ? root.placeholder : "";
        // `SingleLineInput`'s placeholder rung.
        color: Theme.overlay2;
        font-size: Theme.font-size-md;
        wrap: word-wrap;
    }

    OverlayScrollbar {
        horizontal: false;
        track-color: Theme.scrollbar-track-on-card;
        x: parent.width - self.width - 2px;
        y: root.pad;
        width: Theme.scrollbar-slot;
        height: parent.height - 2 * root.pad;
        visible-size: sv.visible-height;
        content-size: sv.content-height;
        offset: -sv.content-y;
        scroll-to(o) => { sv.content-y = -o; }
    }
}
