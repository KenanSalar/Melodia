import { Theme } from "../theme.slint";
import { PillButton } from "action-pill.slint";
import { PopupSurface } from "popup-surface.slint";
import { FocusLossWatcher } from "focus-loss-watcher.slint";

// A three-dot pill opening the host's own `MenuItem`s, for actions that stop earning a pill of
// their own once a row runs out of room.
//
// **The entries come through `@children`, never a property list**: `@tr` resolves literals at
// codegen, so a label handed over as a string would ship untranslated.
export component PillOverflowMenu inherits Rectangle {
    in property <string> tooltip-text;
    // A floor, past which the widest entry decides; the Now Playing overflow's, so the two match.
    in property <length> min-menu-width: 156px;
    // For a host painting the tooltip on a higher layer, off `hovered`.
    in property <bool> tooltip-overlay: false;
    out property <bool> hovered: btn.hovered;
    // Read back, so the host's frame aligns its pill off the same property the in-tree mount does.
    out property <bool> icon-only: btn.icon-only;

    // The pill row's height, so the popup hangs off this box rather than the button inside it.
    width: btn.width;
    height: 32px;

    btn := PillButton {
        // The Now Playing bar's overflow glyph, so the two read as one control.
        icon: "more_vert";
        tooltip-text: root.tooltip-text;
        tooltip-overlay: root.tooltip-overlay;
        force-bg: pop.is-open;
        clicked => {
            pop.show();
        }
    }

    pop := PopupWindow {
        // Right-aligned, the trigger trailing a row anchored to the band's far edge. No inside
        // margin like `SortMenuPopup`'s: `show_popup` reads this offset before resolving the size,
        // and a bound `width` already answers with the real number.
        x: btn.width - self.width;
        y: root.height + Theme.popup-gap;
        // On the popup, the enclosing component being unable to name an id inside it; `+ 2px`
        // leaves `PopupSurface`'s border a pixel each side.
        width: max(root.min-menu-width, items.preferred-width + 2px);
        close-policy: close-on-click;

        FocusLossWatcher {
            close => {
                pop.close();
            }
        }

        PopupSurface {
            items := VerticalLayout {
                padding: Theme.pad-xs;
                spacing: 0;
                @children
            }
        }
    }
}
