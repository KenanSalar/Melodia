import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { MiniPlayer, MiniLayout } from "../globals/shell.slint";

// The responsive full-UI ↔ miniplayer swap, as a non-visual state machine: both `Timer`s are
// pseudo-elements, so it occupies no layout space and can be mounted anywhere. Compact when the
// window is either narrow *or* short, and which of the miniplayer's layouts fits the window once it
// is. The host passes its size in, a component's root binding not reaching `parent`.
//
// **The swap is two-phase on purpose**: `render-active` lags `active` by the fade, so only *one*
// branch is ever mounted — overlapping them holds the sidebar's grid covers and the mini's up-next
// subscriber alive at once, which is a memory regression.
export component MiniPlayerSwitch {
    // The host window's live size.
    in property <length> host-width;
    in property <length> host-height;

    // What the OS frame adds to the client area, for a host that drops the frame in miniplayer mode.
    in property <length> exit-allowance-w;
    in property <length> exit-allowance-h;

    private property <length> enter-w: 550px;
    private property <length> enter-h: 250px;
    // Absorbs physical-to-logical rounding, so a frame toggle can't land the size exactly on an edge.
    private property <length> exit-slack: 4px;

    // Flips the instant the threshold is crossed. **`render-active` is what a host
    // branches on**; this is only the decision.
    //
    // Leaving takes more room than entering: dropping the frame grows the client area by the
    // allowance, so one shared edge would bounce a window parked just inside it straight back out.
    // Keyed on `render-active`, which only the timers write, so the binding can't loop on itself.
    out property <bool> active: root.render-active
        ? (root.host-width < root.enter-w + root.exit-allowance-w + root.exit-slack
            || root.host-height < root.enter-h + root.exit-allowance-h + root.exit-slack)
        : (root.host-width < root.enter-w || root.host-height < root.enter-h);

    // Which branch is mounted right now: `active`, delayed by one fade so the
    // outgoing layout can reach opacity 0 before it is destroyed.
    out property <bool> render-active: false;

    // Named around the builtin property of that name.
    out property <float> fade-opacity: 1.0;
    animate fade-opacity { duration: 100ms; easing: ease-in-out; }

    // **The layout that draws the artwork largest, except that the column takes any window with room
    // for its panel.** The artwork is what every layout gives up first when the window runs short,
    // so it is the fair measure of which one a window suits: the card sets it beside the controls
    // and so pays in width, the column sets it over them and pays in height. The strip draws a
    // thumbnail and takes whatever is too short for the card.
    //
    // Both sizes are estimates of what the view lays out, and being off only moves where a swap
    // lands: every layout shrinks its artwork before a row clips, so a locale setting taller text
    // costs artwork, never a control.
    //
    // The column's fixed rows, gaps and padding, which is everything in it but the artwork.
    private property <length> column-rows: 141px;
    // The card's controls at their narrowest, with the padding and the gap beside its artwork.
    private property <length> card-controls-width: 202px;
    // The shortest window the card stacks its title, controls and timeline in with room to spare.
    private property <length> card-min-height: 120px;

    private property <length> column-art:
        min(root.host-height - root.column-rows, MiniPlayer.column-art-cap(root.host-width));
    private property <length> card-art:
        min(root.host-height, root.host-width - root.card-controls-width);

    // Internal: nothing outside needs the layout, it only feeds the global.
    private property <MiniLayout> layout:
        root.host-height >= MiniPlayer.panel-height || root.column-art >= root.card-art
            ? MiniLayout.column
            : (root.host-height >= root.card-min-height ? MiniLayout.card : MiniLayout.strip);

    // Mirrored locally because a `changed` handler can't watch a global's property. It publishes to
    // the global so children see the new value, schedules fade-out → swap → fade-in, closes any
    // open Now Playing view so its artwork release runs, and notifies Rust for the up-next gate.
    // **`MiniPlayer.layout` is `watched-layout`'s to own** — Rust re-reads it from the global on
    // entry, so no redundant write belongs here.
    private property <bool> watched-active: root.active;
    changed watched-active => {
        MiniPlayer.active = root.watched-active;
        // **Lateral.** The line below closes Now Playing, which remounts the branch underneath it.
        // Written in both directions anyway: the way back mounts under the swap timer's suppression
        // and never reads it, but an unwritten edge is whatever the last drill or back left behind.
        Nav.pending-enter-from = NavEnterFrom.below;
        if (root.watched-active && Nav.now-playing-open) {
            Nav.now-playing-open = false;
        }
        // The host has no size at construction, so `active` reads `true` for a window about to lay
        // out full-size, and the first settle arrives here looking like a swap. It isn't one while
        // `render-active` already agrees, and a fade with no incoming branch to cross to is the
        // whole-shell flicker that used to open every launch. `active` itself keeps its 0×0
        // answer: `SectionActiveGate` baselines on it.
        if (root.render-active != root.watched-active) {
            root.fade-opacity = 0.0;
            swap-timer.running = true;
        }
        MiniPlayer.active-changed(root.watched-active);
    }

    // **A layout change inside mini deliberately doesn't fade**: it is an in-place re-layout of the
    // same component, and a flash at every threshold crossed through a drag would be jarring. The
    // callback drives the high-res cover cache — seeded for the two layouts that draw it large,
    // released on the way back to the strip.
    private property <MiniLayout> watched-layout: root.layout;
    changed watched-layout => {
        MiniPlayer.layout = root.watched-layout;
        MiniPlayer.layout-changed(root.watched-layout);
    }

    // The mount seed: `changed` doesn't fire when the first settle lands directly on the final
    // value, so without it a launch straight into a mini-sized window paints the full UI first.
    seed-timer := Timer {
        interval: 1ms;
        triggered => {
            MiniPlayer.active = root.active;
            MiniPlayer.layout = root.layout;
            root.render-active = root.active;
            MiniPlayer.active-changed(root.active);
            self.running = false;
        }
    }

    // Flips the render shadow and eases the opacity back. Single-shot, armed only by a crossing the
    // guard above let through — a wiggle back inside the 100 ms needn't re-arm it, the body landing
    // on whichever branch `active` ended on.
    swap-timer := Timer {
        interval: 100ms;
        running: false;
        triggered => {
            // The page returning under the crossfade skips its own entrance, as the launch mount
            // does: a slide played over a whole rebuilt UI is a second full-window layer at the
            // moment that UI is most expensive. The mounted `ViewTransition` hands the flag back.
            if (!root.active) {
                Nav.suppress-enter-animation = true;
            }
            root.render-active = root.active;
            root.fade-opacity = 1.0;
            self.running = false;
        }
    }
}
