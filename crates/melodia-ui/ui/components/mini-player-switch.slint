import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { MiniPlayer, MiniLayout } from "../globals/shell.slint";

// The full-UI ↔ miniplayer swap, and which miniplayer layout fits the window. Non-visual, so it
// mounts anywhere; the host passes its size in.
//
// **The swap is two-phase on purpose**: `render-active` lags `active` by the fade, so only one
// branch is ever mounted. Overlapping them holds the sidebar's grid covers and the miniplayer's
// up-next subscriber alive at once.
export component MiniPlayerSwitch {
    in property <length> host-width;
    in property <length> host-height;
    // The window less the invisible borders a native miniplayer keeps transparent on Win32.
    in property <length> view-width;
    in property <length> view-height;

    // What the OS frame adds to the client area, for a host that drops the frame in miniplayer mode.
    in property <length> exit-allowance-w;
    in property <length> exit-allowance-h;

    private property <length> enter-w: 550px;
    private property <length> enter-h: 250px;
    // Absorbs physical-to-logical rounding, so a frame toggle can't land the size exactly on an edge.
    private property <length> exit-slack: 4px;

    // The decision alone; **a host branches on `render-active`**.
    out property <bool> active: root.fits-mini(root.host-width, root.host-height);

    // Leaving takes more room than entering: dropping the frame grows the client area by the
    // allowance, so one shared edge would bounce a window parked inside it straight back out.
    // Keyed on `render-active`, which no binding writes, so `active` can't loop on itself.
    pure function fits-mini(width: length, height: length) -> bool {
        return root.render-active
            ? (width < root.enter-w + root.exit-allowance-w + root.exit-slack
                || height < root.enter-h + root.exit-allowance-h + root.exit-slack)
            : (width < root.enter-w || height < root.enter-h);
    }

    // `active`, delayed by one fade so the outgoing layout reaches 0 before it is destroyed.
    out property <bool> render-active: false;

    out property <float> fade-opacity: 1.0;
    animate fade-opacity { duration: 100ms; easing: ease-in-out; }

    // **The column once the captions row is fully open above the artwork and the panel has room
    // under it, the card below that, the strip once the artwork is at its floor.** The column is
    // the one layout Rust looks a lyrics sheet up for, so it starts where the panel mounts. The
    // artwork comes off the width as well as the cap, a narrow window's stopping short of it.
    //
    // The thresholds are `MiniPlayer`'s, restating what the view lays out rather than measuring it.
    private property <length> column-rows: MiniPlayer.art-rows + MiniPlayer.captions-height;

    private property <length> card-art: min(MiniPlayer.art-cap,
        root.view-width - MiniPlayer.art-row-insets - MiniPlayer.controls-min-width);

    private property <MiniLayout> layout:
        root.view-height > root.column-rows + root.card-art + MiniPlayer.panel-gap
            ? MiniLayout.column
            : (root.view-height > MiniPlayer.art-rows + MiniPlayer.art-floor
                ? MiniLayout.card
                : MiniLayout.strip);

    // Closes Now Playing so its artwork release runs. **`MiniPlayer.layout` is `watched-layout`'s
    // to write**, Rust re-reading it on entry.
    private property <bool> watched-active: root.active;
    changed watched-active => {
        MiniPlayer.active = root.watched-active;
        // Both ways: the way back mounts under the swap timer's suppression and never reads it,
        // but an unwritten edge is whatever the last drill left behind.
        Nav.pending-enter-from = NavEnterFrom.above;
        if (root.watched-active && Nav.now-playing-open) {
            Nav.now-playing-open = false;
        }
        // The first settle out of the 0×0 construction pass looks like a swap and isn't one. By
        // then the seed `Timer` has settled `render-active`, so only a real swap differs here.
        if (root.render-active != root.watched-active) {
            root.fade-opacity = 0.0;
            swap-timer.running = true;
        }
        MiniPlayer.active-changed(root.watched-active);
    }

    // **A layout change inside the miniplayer doesn't fade**: it re-lays the same component, and a
    // flash at every threshold a drag crosses would be jarring.
    private property <MiniLayout> watched-layout: root.layout;
    changed watched-layout => {
        MiniPlayer.layout = root.watched-layout;
        MiniPlayer.layout-changed(root.watched-layout);
    }

    private property <length> captions-shown: clamp(
        root.view-height - MiniPlayer.art-rows - root.card-art, 0px, MiniPlayer.captions-height);

    // The drag's direction is read against where it began rather than its last step, so a drag
    // that overshoots and comes back a little still settles the way it was going.
    private property <length> captions-at-resize;
    private property <length> captions-open-height:
        root.host-height + MiniPlayer.captions-height - root.captions-shown;
    private property <length> captions-closed-height: root.host-height - root.captions-shown;

    public function resize-began() {
        root.captions-at-resize = root.captions-shown;
    }

    // **A resize never lets go of the captions row part way open.** Closed wherever opening would
    // carry the window past the exit edge, and on the release so the window never moves under a
    // pointer still holding its edge.
    public function resize-released() {
        if (!root.active || root.captions-shown <= 0px
            || root.captions-shown >= MiniPlayer.captions-height) {
            return;
        }
        MiniPlayer.request-height(root.captions-shown > root.captions-at-resize
                && root.fits-mini(root.host-width, root.captions-open-height)
            ? root.captions-open-height
            : root.captions-closed-height);
    }

    // Mounts the branch a restored size calls for before the window exists, which the seed is too
    // late for: on Win32 a frame dropped after `show()` keeps the outer size, so a miniplayer
    // relaunched under the native titlebar would grow by the frame every launch.
    public function adopt-restored-size() {
        root.render-active = root.active;
    }

    // `changed` doesn't fire when the first settle lands on the final value, so without the seed a
    // window mapped at a miniplayer size paints the full UI first.
    seed-timer := Timer {
        interval: 1ms;
        triggered => {
            MiniPlayer.active = root.active;
            MiniPlayer.layout = root.layout;
            root.render-active = root.active;
            MiniPlayer.active-changed(root.active);
            self.running = false;
        }
    }

    // A wiggle back inside the 100 ms needn't re-arm it: the body lands on whichever branch
    // `active` ended on.
    swap-timer := Timer {
        interval: 100ms;
        running: false;
        triggered => {
            // A slide under the crossfade is a second full-window layer over the swap's most
            // expensive frames. The mounted `ViewTransition` hands the flag back.
            if (!root.active) {
                Nav.suppress-enter-animation = true;
            }
            root.render-active = root.active;
            root.fade-opacity = 1.0;
            self.running = false;
        }
    }
}
