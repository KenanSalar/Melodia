import { CopyField } from "context-menu.slint";

// What a track's Copy flyout offers, on its row's menu and on its card's. `ContextMenuPopup`
// reserves the flyout's height off this list's length, so a field added here can't clip the popup.
// `token` travels to Rust as the field `TrackField::from_token` parses.
export global TrackCopyFields {
    out property <[CopyField]> list: [
        { token: "title", label: @tr("Title"), icon: "title" },
        { token: "artist", label: @tr("Artist"), icon: "person" },
        { token: "album", label: @tr("Album"), icon: "album" },
        { token: "artist-title", label: @tr("Artist - Title"), icon: "music_note" },
        { token: "path", label: @tr("File Path"), icon: "folder_open" },
    ];
}
