import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";

// A scrollable column inside a dialog card with its `OverlayScrollbar`, declared together so the
// pane is safe inside an `if`, an id in a branch being unreadable from outside it. The host sizes
// the pane.
export component DialogScrollPane inherits Rectangle {
    in property <length> content-spacing: Theme.pad-sm;

    // Off the column, never the scroller: a `ScrollView`'s `content-height` is
    // `max(content, flickable.height)`, so a host sizing itself off it closes a loop.
    out property <length> content-height: column.preferred-height;

    // A write rather than a binding, so the `Flickable` still pulls the view back in range when
    // the content shrinks, its correction skipping a bound offset.
    public function scroll-to-end() {
        sv.content-y = min(0px, sv.visible-height - sv.content-height);
    }

    sv := ScrollView {
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        // Locked, or the stretchy inputs collapse to nothing.
        content-width: sv.visible-width;

        column := VerticalLayout {
            spacing: root.content-spacing;
            // A gutter, a bar over an input's edge eating the click that lands there.
            padding-right: Theme.pad-md;

            @children
        }
    }

    OverlayScrollbar {
        horizontal: false;
        track-color: Theme.scrollbar-track-on-card;
        x: parent.width - self.width;
        y: 0;
        width: Theme.scrollbar-slot;
        height: parent.height;
        visible-size: sv.visible-height;
        content-size: sv.content-height;
        offset: -sv.content-y;
        scroll-to(o) => {
            sv.content-y = -o;
        }
    }
}
