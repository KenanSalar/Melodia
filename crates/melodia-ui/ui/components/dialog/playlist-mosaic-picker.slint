import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Playlists } from "../../globals/playlists.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { CoverMosaic } from "../grid/cover-mosaic.slint";
import { EdgeOutline } from "../edge-outline.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";
import { SectionButton } from "../settings/section-button.slint";

// The Edit Artwork dialog's body. The candidate tiles take the row tier, a near-exact fit at
// 64 px; the preview cells the grid tier, where a row-tier source pixelates. Rust owns the
// selection and caps it at 4, past which a toggle is a silent no-op.
export component PlaylistMosaicPicker inherits Rectangle {
    private property <length> cand-tile: 64px;
    private property <length> cand-gap: 8px;
    // Two rows visible.
    private property <length> grid-area-h: 160px;
    // Off the card's border; the tiles' gutter clears it too.
    private property <length> bar-inset: 2px;

    private property <length> mosaic-gap: 3px;

    VerticalLayout {
        spacing: Theme.pad-md;

        // A square fill and an `EdgeOutline`, so the clip is the curve's only antialiased pass.
        preview := Rectangle {
            cross-axis-self-alignment: center;
            vertical-stretch: 0;
            width: 220px;
            height: 220px;
            border-radius: Theme.radius-lg;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                background: Theme.card-control;
            }

            // The saved cover, until the first pick or Clear.
            if Dialog.mosaic-selection.length == 0
                    && !Dialog.mosaic-touched
                    && Dialog.current-artwork.width > 0: Image {
                width: 100%;
                height: 100%;
                source: Dialog.current-artwork;
                image-fit: ImageFit.cover;
            }

            if Dialog.mosaic-selection.length == 0
                    && (Dialog.mosaic-touched || Dialog.current-artwork.width == 0): Rectangle {
                background: @linear-gradient(180deg,
                    Theme.accent.with-alpha(0.10) 0%,
                    Theme.accent.with-alpha(0.04) 100%);
                VerticalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: Theme.pad-sm;
                    ArtworkImage {
                        tile-size: 130px;
                        tile-radius: Theme.radius-md;
                    }
                    Text {
                        text: @tr("No artwork");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                    }
                }
            }

            // `CoverMosaic` draws only tiles, so the empty states above are the caller's.
            if Dialog.mosaic-selection.length >= 1: CoverMosaic {
                width: 100%;
                height: 100%;
                artwork-paths: Dialog.mosaic-selection;
                gutter-size: root.mosaic-gap;
                request-cover(p) => {
                    return Playlists.request-cover(p, Playlists.covers-generation);
                }
            }

            EdgeOutline {
                width: 100%;
                height: 100%;
                radius: Theme.radius-lg;
                stroke-width: 1px;
                stroke-color: Theme.border;
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            alignment: space-between;
            spacing: Theme.pad-sm;

            HorizontalLayout {
                spacing: Theme.pad-sm;
                alignment: start;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    for i in [0, 1, 2, 3]: Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: i < Dialog.mosaic-selection.length
                            ? Theme.accent
                            : Theme.surface2;
                        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
                    }
                }

                Text {
                    text: @tr("{} / 4 selected", Dialog.mosaic-selection.length);
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                }
            }

            SectionButton {
                label: @tr("Clear");
                icon: "";
                primary: false;
                clicked => {
                    Dialog.mosaic-selection = [];
                    // The dispatcher gates `clear-artwork` on a deliberate clear.
                    Dialog.mosaic-touched = true;
                }
            }
        }

        if Dialog.mosaic-candidates.length == 0: Rectangle {
            vertical-stretch: 1;
            height: 80px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: Dialog.mosaic-smart
                        ? @tr("None of the tracks these rules match have artwork.")
                        : @tr("Add tracks to this playlist to pick artwork.");
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Mounted only with candidates, so it can't float above the empty-state hint.
        if Dialog.mosaic-candidates.length > 0: Text {
            text: @tr("Select up to 4 tracks");
            color: Theme.subtext0;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
        }

        if Dialog.mosaic-candidates.length > 0: Rectangle {
            vertical-stretch: 1;
            height: root.grid-area-h;
            background: Theme.surface0;
            border-radius: Theme.radius-md;
            border-width: 1px;
            // `surface2`, `Theme.border` being `surface0` itself and so invisible on this fill.
            border-color: Theme.surface2;
            clip: true;

            cand-sv := ScrollView {
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                content-width: self.visible-width;

                VerticalLayout {
                    padding: Theme.pad-xs;
                    padding-right: Theme.scrollbar-slot + root.bar-inset;

                    FlexboxLayout {
                        spacing: root.cand-gap;
                        // The viewport can outgrow the tiles (`slint-pitfalls.md`'s flex entry).
                        cross-axis-line-alignment: start;

                        for path in Dialog.mosaic-candidates: cand := Rectangle {
                            width: root.cand-tile;
                            height: root.cand-tile;
                            // The curve's only antialiased pass, everything inside being square or
                            // an `EdgeOutline`.
                            clip: true;
                            border-radius: Theme.radius-sm;

                            // The cap is 4, so four arms beat a loop.
                            property <int> slot:
                                (Dialog.mosaic-selection.length >= 1
                                    && Dialog.mosaic-selection[0] == path) ? 0 :
                                (Dialog.mosaic-selection.length >= 2
                                    && Dialog.mosaic-selection[1] == path) ? 1 :
                                (Dialog.mosaic-selection.length >= 3
                                    && Dialog.mosaic-selection[2] == path) ? 2 :
                                (Dialog.mosaic-selection.length >= 4
                                    && Dialog.mosaic-selection[3] == path) ? 3 : -1;
                            // The hairline's and the ring's fades, through their brushes rather
                            // than `opacity`, which would layer them.
                            property <float> hover-t:
                                cand-touch.has-hover && cand.slot < 0 ? 1.0 : 0.0;
                            animate hover-t { duration: Theme.dur-fast; easing: ease-out; }
                            property <float> ring-t: cand.slot >= 0 ? 1.0 : 0.0;
                            animate ring-t { duration: Theme.dur-fast; easing: ease-out; }

                            ArtworkImage {
                                artwork-path: path;
                                cover: Playlists.request-row-cover(path);
                                tile-size: root.cand-tile;
                                // Square, `cand` rounding it.
                                tile-radius: 0px;
                                cover-scale: cand-touch.has-hover ? 1.06 : 1.0;
                            }

                            // On the eased float, so the fade-out plays (`slint-pitfalls.md`).
                            if cand.hover-t > 0: EdgeOutline {
                                width: 100%;
                                height: 100%;
                                radius: Theme.radius-sm;
                                stroke-width: 1px;
                                stroke-color: Theme.overlay1.transparentize(1.0 - cand.hover-t);
                            }

                            if cand.ring-t > 0: Rectangle {
                                width: 100%;
                                height: 100%;

                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 100%;
                                    background: Theme.accent.with-alpha(0.18 * cand.ring-t);
                                }

                                EdgeOutline {
                                    width: 100%;
                                    height: 100%;
                                    radius: Theme.radius-sm;
                                    stroke-width: 2px;
                                    stroke-color: Theme.accent.transparentize(1.0 - cand.ring-t);
                                }

                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    x: 4px;
                                    y: 4px;
                                    border-radius: 11px;
                                    background: Theme.accent.transparentize(1.0 - cand.ring-t);
                                    // Empty during a deselect's fade-out.
                                    Text {
                                        text: cand.slot >= 0 ? (cand.slot + 1) + "" : "";
                                        color: Theme.accent-text.transparentize(1.0 - cand.ring-t);
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            cand-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Playlists.toggle-mosaic-candidate(path);
                                }
                            }
                        }
                    }
                }
            }

            OverlayScrollbar {
                horizontal: false;
                track-color: Theme.scrollbar-track-on-card;
                x: parent.width - self.width - root.bar-inset;
                y: root.bar-inset;
                width: Theme.scrollbar-slot;
                height: parent.height - 2 * root.bar-inset;
                visible-size: cand-sv.visible-height;
                content-size: cand-sv.content-height;
                offset: -cand-sv.content-y;
                scroll-to(o) => { cand-sv.content-y = -o; }
            }
        }
    }
}
