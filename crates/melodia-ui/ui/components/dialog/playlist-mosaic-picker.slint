import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Playlists } from "../../globals/playlists.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { CoverMosaic } from "../grid/cover-mosaic.slint";
import { EdgeOutline } from "../edge-outline.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";
import { SectionButton } from "../settings/section-button.slint";

// Mosaic picker body — mounted by `DialogOverlay` for
// `DialogKind.edit-playlist-artwork`: preview over a counter row over a
// wrapping candidate grid.
//
// The two cover tiers are picked by size. The 64 px candidate tiles take the
// shared row tier (72 px, a near-exact fit), the ~110–220 px preview cells the
// grid tier, sized against the window's cards, which stays crisp where a 72 px
// source pixelates badly.
//
// Rust owns selection (`Playlists.toggle-mosaic-candidate`) and caps it at 4 —
// past that the toggle is a silent no-op.
export component PlaylistMosaicPicker inherits Rectangle {
    private property <length> cand-tile: 64px;
    private property <length> cand-gap: 8px;
    // Two rows visible; the ScrollView takes the overflow.
    private property <length> grid-area-h: 160px;
    // The scrollbar's inset off the card's border, which the tiles' gutter clears as well.
    private property <length> bar-inset: 2px;

    // Painted *behind* the cells, so the gaps between tiles read as gutters
    // rather than as butted-up halves; the preview's own padding picks up the
    // same colour for a uniform inset ring.
    private property <length> mosaic-gap: 3px;

    VerticalLayout {
        spacing: Theme.pad-md;

        // The fill is square and the border an `EdgeOutline`, so the clip is the only
        // antialiased pass on the curve a cover fills to.
        preview := Rectangle {
            cross-axis-self-alignment: center;
            vertical-stretch: 0;
            width: 220px;
            height: 220px;
            border-radius: Theme.radius-lg;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                background: Theme.surface1;
            }

            // The saved cover, shown until the first pick or Clear flips
            // `mosaic-touched` and unmounts this branch.
            if Dialog.mosaic-selection.length == 0
                    && !Dialog.mosaic-touched
                    && Dialog.current-artwork.width > 0: Image {
                width: 100%;
                height: 100%;
                source: Dialog.current-artwork;
                image-fit: ImageFit.cover;
            }

            // Empty state — nothing picked, and either cleared or never saved.
            if Dialog.mosaic-selection.length == 0
                    && (Dialog.mosaic-touched || Dialog.current-artwork.width == 0): Rectangle {
                background: @linear-gradient(180deg,
                    Theme.accent.with-alpha(0.10) 0%,
                    Theme.accent.with-alpha(0.04) 100%);
                VerticalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: Theme.pad-sm;
                    ArtworkImage {
                        tile-size: 130px;
                        tile-radius: Theme.radius-md;
                    }
                    Text {
                        text: @tr("No artwork");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                    }
                }
            }

            // The empty cases above stay local: `CoverMosaic` is empty-state-agnostic,
            // drawing only tiles so a caller can own what "none" looks like.
            if Dialog.mosaic-selection.length >= 1: CoverMosaic {
                width: 100%;
                height: 100%;
                artwork-paths: Dialog.mosaic-selection;
                gutter-size: root.mosaic-gap;
                request-cover(p) => {
                    return Playlists.request-cover(p, Playlists.covers-generation);
                }
            }

            EdgeOutline {
                width: 100%;
                height: 100%;
                radius: Theme.radius-lg;
                stroke-width: 1px;
                stroke-color: Theme.border;
            }
        }

        // Pips + counter + Clear. The pips show the cap; the text states it.
        HorizontalLayout {
            vertical-stretch: 0;
            alignment: space-between;
            spacing: Theme.pad-sm;

            HorizontalLayout {
                spacing: Theme.pad-sm;
                alignment: start;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    for i in [0, 1, 2, 3]: Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: i < Dialog.mosaic-selection.length
                            ? Theme.accent
                            : Theme.surface2;
                        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                    }
                }

                Text {
                    text: @tr("{} / 4 selected", Dialog.mosaic-selection.length);
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                }
            }

            // Same outline chrome as Cancel, so Clear / Cancel / Apply read as
            // one family.
            SectionButton {
                label: @tr("Clear");
                icon: "";
                primary: false;
                clicked => {
                    Dialog.mosaic-selection = [];
                    // Separates a deliberate clear from an untouched open — the
                    // dispatcher gates `clear-artwork` on it.
                    Dialog.mosaic-touched = true;
                }
            }
        }

        if Dialog.mosaic-candidates.length == 0: Rectangle {
            vertical-stretch: 1;
            height: 80px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Add tracks to this playlist to pick artwork.");
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Mounted only with candidates, so it can't float above the empty-state hint.
        if Dialog.mosaic-candidates.length > 0: Text {
            text: @tr("Select up to 4 tracks");
            color: Theme.subtext0;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
        }

        if Dialog.mosaic-candidates.length > 0: Rectangle {
            vertical-stretch: 1;
            height: root.grid-area-h;
            background: Theme.surface0;
            border-radius: Theme.radius-md;
            border-width: 1px;
            // `surface2`, for `PickerListCard`'s reason: `Theme.border` is `surface0`
            // on Catppuccin, so this card had no edge against the dialog behind it.
            border-color: Theme.surface2;
            clip: true;

            cand-sv := ScrollView {
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                content-width: self.visible-width;

                VerticalLayout {
                    padding: Theme.pad-xs;
                    // A full row would otherwise run under the scrollbar.
                    padding-right: Theme.scrollbar-slot + root.bar-inset;

                    FlexboxLayout {
                        spacing: root.cand-gap;
                        // The viewport can be taller than the tiles need, and stretched lines
                        // would spread them down it.
                        cross-axis-line-alignment: start;

                        for path in Dialog.mosaic-candidates: cand := Rectangle {
                            width: root.cand-tile;
                            height: root.cand-tile;
                            // The tile's one rounded clip. Everything inside is square or
                            // an `EdgeOutline`, so this is the curve's only antialiased pass.
                            clip: true;
                            border-radius: Theme.radius-sm;

                            // Cap is 4, so four arms beat a loop. On `cand`
                            // itself because `parent` doesn't reach through
                            // nested layouts — descendants read `cand.slot`.
                            property <int> slot:
                                (Dialog.mosaic-selection.length >= 1
                                    && Dialog.mosaic-selection[0] == path) ? 0 :
                                (Dialog.mosaic-selection.length >= 2
                                    && Dialog.mosaic-selection[1] == path) ? 1 :
                                (Dialog.mosaic-selection.length >= 3
                                    && Dialog.mosaic-selection[2] == path) ? 2 :
                                (Dialog.mosaic-selection.length >= 4
                                    && Dialog.mosaic-selection[3] == path) ? 3 : -1;
                            // The hairline's fade. Through its brush, since `opacity` on an
                            // element with children renders it into a texture.
                            property <float> hover-t:
                                cand-touch.has-hover && cand.slot < 0 ? 1.0 : 0.0;
                            animate hover-t { duration: Theme.dur-fast; easing: ease-out; }
                            // The selection ring's fade, the same way for the same reason.
                            property <float> ring-t: cand.slot >= 0 ? 1.0 : 0.0;
                            animate ring-t { duration: Theme.dur-fast; easing: ease-out; }

                            ArtworkImage {
                                artwork-path: path;
                                cover: Playlists.request-row-cover(path);
                                tile-size: root.cand-tile;
                                // Square, so its own clip is a plain one: `cand` rounds it.
                                tile-radius: 0px;
                                // Hover pop, as on the album grid card.
                                // `ArtworkImage` animates the scale itself.
                                cover-scale: cand-touch.has-hover ? 1.06 : 1.0;
                            }

                            // Mounted until its fade-out lands, for the ring's reason below.
                            if cand.hover-t > 0: EdgeOutline {
                                width: 100%;
                                height: 100%;
                                radius: Theme.radius-sm;
                                stroke-width: 1px;
                                stroke-color: Theme.overlay1.transparentize(1.0 - cand.hover-t);
                            }

                            // Selection ring + badge, mounted until the fade-out
                            // lands rather than for as long as the tile is shown:
                            // gated on `slot`, the ring would vanish on deselect.
                            if cand.ring-t > 0: Rectangle {
                                width: 100%;
                                height: 100%;

                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 100%;
                                    background: Theme.accent.with-alpha(0.18 * cand.ring-t);
                                }

                                EdgeOutline {
                                    width: 100%;
                                    height: 100%;
                                    radius: Theme.radius-sm;
                                    stroke-width: 2px;
                                    stroke-color: Theme.accent.transparentize(1.0 - cand.ring-t);
                                }

                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    x: 4px;
                                    y: 4px;
                                    border-radius: 11px;
                                    background: Theme.accent.transparentize(1.0 - cand.ring-t);
                                    // Empty when deselected; only ever seen
                                    // during the ring's fade-out.
                                    Text {
                                        text: cand.slot >= 0 ? (cand.slot + 1) + "" : "";
                                        color: Theme.accent-text.transparentize(1.0 - cand.ring-t);
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            cand-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Playlists.toggle-mosaic-candidate(path);
                                }
                            }
                        }
                    }
                }
            }

            // Inset off the card's border and radius, over the gutter the tiles leave it.
            OverlayScrollbar {
                horizontal: false;
                track-color: Theme.scrollbar-track-on-card;
                x: parent.width - self.width - root.bar-inset;
                y: root.bar-inset;
                width: Theme.scrollbar-slot;
                height: parent.height - 2 * root.bar-inset;
                visible-size: cand-sv.visible-height;
                content-size: cand-sv.content-height;
                offset: -cand-sv.content-y;
                scroll-to(o) => { cand-sv.content-y = -o; }
            }
        }
    }
}
