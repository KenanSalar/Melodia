import { Theme } from "../../theme.slint";
import { TagEditor } from "../../globals/dialog-forms.slint";
import { ArtistCreditRow } from "../../models.slint";
import { Dropdown } from "../settings/dropdown.slint";
import { FieldLabel } from "../field-frame.slint";
import { PillButton } from "../action-pill.slint";
import { ControlledInput } from "./controlled-input.slint";
import { RemoveRowButton } from "./remove-row-button.slint";

// One credited name. The phrase picker names what follows it, so the last row has none, and a
// lone row can't be removed, a credit with no names being unreachable.
component CreditRowView inherits HorizontalLayout {
    in property <ArtistCreditRow> credit;
    in property <bool> is-last;
    in property <bool> is-only;
    in property <string> placeholder;
    callback set-name(string);
    callback set-join(int /*phrase index*/);
    callback remove();

    spacing: Theme.pad-sm;
    cross-axis-alignment: center;

    ControlledInput {
        horizontal-stretch: 1;
        min-width: 120px;
        text: root.credit.name;
        placeholder: root.placeholder;
        edited(t) => { root.set-name(t); }
    }

    if !root.is-last: Dropdown {
        trigger-width: 112px;
        options: TagEditor.join-phrases;
        // `manual`, so no self-write detaches the binding a removal above re-reads as the
        // indices shift.
        manual: true;
        selected-index: root.credit.join-index;
        selected(idx) => { root.set-join(idx); }
    }
    // Keeps the × flush-right on the last row. Not on a lone one, where the reserved slots left
    // the field short of the inputs either side.
    if root.is-last && !root.is-only: Rectangle { width: 112px; }

    if !root.is-only: RemoveRowButton {
        clicked => { root.remove(); }
    }
}

// One artist field of the Edit-Tags dialog, a row per credited name; Artist and Album Artist both.
export component CreditEditor inherits VerticalLayout {
    in property <string> label;
    in property <[ArtistCreditRow]> credits;
    in property <string> placeholder;
    // The credit as written, shown once there is more than one name.
    in property <string> preview;
    in property <int> field;

    // `LabeledInput`'s label gap.
    spacing: 4px;

    FieldLabel {
        text: root.label;
    }

    for credit[i] in root.credits: CreditRowView {
        credit: credit;
        is-last: i == root.credits.length - 1;
        is-only: root.credits.length == 1;
        // Repeated, the multiple-values hint would read as one per artist.
        placeholder: i == 0 ? root.placeholder : "";
        set-name(t) => { TagEditor.set-credit-name(root.field, i, t); }
        set-join(idx) => { TagEditor.set-credit-join(root.field, i, idx); }
        remove => { TagEditor.remove-credit(root.field, i); }
    }

    HorizontalLayout {
        spacing: Theme.pad-sm;
        alignment: start;
        cross-axis-alignment: center;

        // The genre list's add: a literal "+" label reads a size smaller than its control.
        PillButton {
            icon: "add";
            // Bare, the field's heading sitting directly above.
            text: @tr("Add");
            clicked => { TagEditor.add-credit(root.field); }
        }

        if root.credits.length > 1: Text {
            text: root.preview;
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
    }
}
