import { Theme } from "../../theme.slint";
import { Notifications } from "../../globals/notifications.slint";
import { NotificationRow, NotificationVariant } from "../../models.slint";
import { MaterialIcon } from "../material-icon.slint";
import { IconButton } from "../icon-button.slint";
import { SectionButton } from "../settings/section-button.slint";
import { TuckedFill } from "../tucked-fill.slint";

// One card in the notification stack, which a drag to the right also closes. A dismiss only marks
// the row leaving; Rust drops it later. The pointer is caught by the card's body alone, never the
// stack, so the gaps between cards don't block the layers underneath.
export component NotificationCard inherits Rectangle {
    // Not `row`, which Slint reserves as the `for` variable.
    in property <NotificationRow> data;
    private property <bool> shown: false;

    // Read at mount so each eases from its mount value, as in `ViewTransition`.
    init => {
        root.opacity;
        root.slot-h;
        root.rise;
    }

    enter := Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            root.shown = true;
        }
    }

    // Here rather than in Rust so it can stand still while the card is read or held, or the window
    // is in the background; a resume runs the whole interval again.
    clock := Timer {
        interval: root.data.timeout-ms * 1ms;
        running: root.data.timeout-ms > 0 && !root.data.leaving && !root.dragging
            && !sentinel.has-hover && Theme.window-focused;
        triggered => {
            Notifications.dismiss(root.data.id);
        }
    }

    // Only a running clock: `restart()` re-arms a stopped timer, and `running` is re-read only
    // when it changes, so a bump under the pointer would dismiss the card being read.
    private property <int> watched-restarts: root.data.restarts;
    changed watched-restarts => {
        root.lifted = true;
        if (clock.running) {
            clock.restart();
        }
    }

    // A merge rewrites the card in place, so the body lifts and settles to draw the eye to it.
    private property <bool> lifted: false;
    // Less than `gap`, so the lifted body stays inside the card, clipped or not.
    private property <length> bump-rise: 4px;
    private property <length> rise: root.lifted ? root.bump-rise : 0px;
    animate rise { duration: Theme.dur-fast; easing: cubic-bezier(0.2, 0, 0, 1); }

    settle := Timer {
        interval: Theme.dur-fast;
        running: root.lifted;
        triggered => {
            root.lifted = false;
        }
    }

    private property <{accent: brush, icon: string}> look:
        root.data.variant == NotificationVariant.success ? { accent: Theme.green, icon: "check_circle" }
        : root.data.variant == NotificationVariant.warning ? { accent: Theme.yellow, icon: "warning" }
        : root.data.variant == NotificationVariant.error ? { accent: Theme.danger, icon: "error" }
        : root.data.variant == NotificationVariant.neutral ? { accent: Theme.accent, icon: "" }
        : { accent: Theme.accent, icon: "info" };

    // In the card rather than the column's spacing, so it opens and closes with the slot.
    private property <length> gap: 8px;
    private property <length> content-h: layout.preferred-height;
    private property <length> full-h: root.gap + root.content-h;
    private property <bool> up: root.shown && !root.data.leaving;
    private property <length> slot-h: root.up ? root.full-h : 0px;
    animate slot-h { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }

    private property <length> drag-x: 0px;
    private property <bool> dragging: false;
    animate drag-x {
        duration: Theme.dur-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
        enabled: !root.dragging;
    }
    private property <length> fling-distance: 45px;
    // In px per ms over the whole drag: a short, quick flick would fail on distance alone.
    private property <float> fling-speed: 0.11;
    private property <bool> flung: false;

    min-height: 0px;
    preferred-height: root.slot-h;
    max-height: root.slot-h;
    // Only while the slot is short, so at rest nothing the body paints past its edge is cut. A
    // flung card leaves its slot behind, so nothing cuts it.
    clip: root.slot-h < root.full-h && !root.flung;
    opacity: root.up ? 1.0 : 0.0;
    // Out faster than it came in, accelerating away.
    animate opacity {
        duration: root.data.leaving ? Theme.dur-fast : Theme.dur-med;
        easing: root.data.leaving
            ? ease-in
            : cubic-bezier(0.2, 0, 0, 1);
    }

    private property <length> radius: Theme.radius-md;
    private property <length> border-w: 1px;
    // From the card's outer edge.
    private property <length> bar-end: root.border-w + 4px;

    // Hung from the card's top, so as the slot opens in the bottom-anchored column the body slides
    // up out of the stack's edge rather than being uncovered in place. A flung body hangs from the
    // bottom instead, holding its height while the slot closes under it.
    body := Rectangle {
        x: root.drag-x;
        y: root.flung ? root.slot-h - root.content-h - root.rise : root.gap - root.rise;
        width: 100%;
        height: root.content-h;

        // Three elements so the bar sits between fill and border. A fill split off its border
        // isn't tucked under the stroke, so `TuckedFill` insets it.
        TuckedFill {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            radius: root.radius;
            stroke-width: root.border-w;
            fill: Theme.surface0;
        }

        // Cut along the border's middle so its curve lies under solid border. A rectangle this
        // narrow can't carry the card's radius: FemtoVG shrinks it to fit, off the card's curve.
        Path {
            property <float> r: root.radius / 1px;
            property <float> inset: root.border-w / 2px;
            property <float> arc: self.r - self.inset;
            property <float> end: root.bar-end / 1px;
            property <float> h: body.height / 1px;
            // How far above the corner's centre the arc crosses `bar-end`.
            property <float> reach: Math.sqrt(self.arc * self.arc - (self.r - self.end) * (self.r - self.end));

            x: 0;
            y: 0;
            width: root.bar-end;
            height: body.height;
            viewbox-width: self.end;
            viewbox-height: self.h;
            fill: root.look.accent;
            // Counter-clockwise and closed up the right edge, or its antialiasing comes out
            // stepped; numbers unlocalized, a locale's decimal comma breaking the path.
            commands: "M " + self.end.to-string-unlocalized()
                + " " + (self.r - self.reach).to-string-unlocalized()
                + " A " + self.arc.to-string-unlocalized() + " " + self.arc.to-string-unlocalized()
                + " 0 0 0 " + self.inset.to-string-unlocalized() + " " + self.r.to-string-unlocalized()
                + " V " + (self.h - self.r).to-string-unlocalized()
                + " A " + self.arc.to-string-unlocalized() + " " + self.arc.to-string-unlocalized()
                + " 0 0 0 " + self.end.to-string-unlocalized()
                + " " + (self.h - self.r + self.reach).to-string-unlocalized()
                + " Z";
        }

        // Takes the drag and reports `has-hover`. An ancestor of the buttons, so the hover holds
        // over Undo and ✕ while their own areas take the press.
        sentinel := TouchArea {
            // Window-absolute, the sentinel moving with the body it drags.
            property <length> press-abs-x;
            // Where the body sat at the press, so a press landing mid-ease doesn't snap it.
            property <length> start-x;
            property <duration> press-tick;

            width: 100%;
            height: 100%;
            pointer-event(ev) => {
                // Left only, as `pressed` is. A cancel carries no button, a move `Other`.
                if (ev.button != PointerEventButton.left && ev.kind != PointerEventKind.cancel) {
                    return;
                }
                // At rest only, so a fling's switch to the bottom anchor lands where the body is.
                if (ev.kind == PointerEventKind.down && root.up && root.slot-h >= root.full-h) {
                    self.press-abs-x = self.absolute-position.x + self.pressed-x;
                    self.start-x = root.drag-x;
                    self.press-tick = animation-tick();
                    root.dragging = true;
                    // Stops an ease-back mid-run: with `dragging` set, the write lands at once.
                    root.drag-x = self.start-x;
                }
                if ((ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel)
                    && root.dragging) {
                    // First, so the write below eases.
                    root.dragging = false;
                    // A press and its release can share a tick.
                    let elapsed = max(1ms, animation-tick() - self.press-tick);
                    let speed = (root.drag-x - self.start-x) / 1px / (elapsed / 1ms);
                    // A card retired mid-hold is already sinking into its slot, so it eases back.
                    let fling = ev.kind == PointerEventKind.up && root.up
                        && (root.drag-x >= root.fling-distance || speed > root.fling-speed);
                    if (fling) {
                        root.flung = true;
                        root.drag-x = root.width;
                        Notifications.dismiss(root.data.id);
                    } else {
                        root.drag-x = 0px;
                    }
                }
            }
            moved => {
                // Rightward only, toward the stack's own edge.
                if (root.dragging) {
                    let travel = self.absolute-position.x + self.mouse-x - self.press-abs-x;
                    root.drag-x = max(0px, self.start-x + travel);
                }
            }
            // A wheel tick nothing took would drop the hover until the pointer moved.
            scroll-event(ev) => { return accept; }

            layout := HorizontalLayout {
                padding-left: root.bar-end + Theme.pad-md;
                padding-right: Theme.pad-sm;
                padding-top: Theme.pad-sm;
                padding-bottom: Theme.pad-sm;
                spacing: Theme.pad-sm;
                // The glyph box outgrows the title's line box: top-aligned, it sits off centre.
                cross-axis-alignment: center;

                if root.look.icon != "": MaterialIcon {
                    name: root.look.icon;
                    icon-size: 20px;
                    icon-color: root.look.accent;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.data.title;
                        color: Theme.text;
                        font-size: Theme.font-size-md;
                        font-weight: 600;
                        wrap: word-wrap;
                        // A screen reader user has to hear a notice to know it can be undone.
                        accessible-live-region: polite;
                    }
                    if root.data.message != "": Text {
                        text: root.data.message;
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                if root.data.action-label != "": SectionButton {
                    label: root.data.action-label;
                    icon: "";
                    primary: true;
                    clicked => {
                        Notifications.action(root.data.id, root.data.kind);
                    }
                }

                IconButton {
                    icon: "close";
                    icon-size: 16px;
                    diameter: 24px;
                    // A step up from the card's fill, so the hover reads.
                    hover-bg: Theme.surface1;
                    clicked => {
                        Notifications.dismiss(root.data.id);
                    }
                }
            }
        }

        // Last, so it strokes over the bar. `surface2`, `Theme.border` being `surface0` itself.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            border-radius: root.radius;
            border-width: root.border-w;
            border-color: Theme.surface2;
        }
    }
}
