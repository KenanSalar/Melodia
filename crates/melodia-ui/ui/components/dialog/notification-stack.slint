import { Theme } from "../../theme.slint";
import { Notifications } from "../../globals/notifications.slint";
import { NotificationCard } from "notification-card.slint";

// `Notifications.rows` stacked in the bottom-right corner, newest nearest it. Sized to the whole
// window by its mount, so the stack's insets resolve against the viewport.
export component NotificationStack inherits Rectangle {
    inner := VerticalLayout {
        x: parent.width - self.width - 16px;
        y: parent.height - self.preferred-height - 16px - Theme.now-playing-h;
        width: 360px;
        height: self.preferred-height;
        alignment: end;

        for row[i] in Notifications.rows: NotificationCard {
            data: row;
            width: 100%;
        }
    }
}
