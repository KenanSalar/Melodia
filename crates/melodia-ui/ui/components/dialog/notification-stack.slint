import { Theme } from "../../theme.slint";
import { Notifications } from "../../globals/notifications.slint";
import { NotificationRow, NotificationVariant } from "../../models.slint";
import { MaterialIcon } from "../material-icon.slint";
import { IconButton } from "../icon-button.slint";
import { SectionButton } from "../settings/section-button.slint";
import { TuckedFill } from "../tucked-fill.slint";

// One card in the notification stack; the parent pins its width and the height
// follows the content. The variant picks a colour and a glyph, in pairs so neither
// can be styled without the other, `info` being the fall-through.
//
// Enter animation is the `Tooltip` pattern — `shown` flips on `init` and the
// opacity animates in. There is no exit one: dismissing drops the row from the
// model and the component goes with it.
//
// It paints and nothing else. There is no root TouchArea, so the gaps between
// cards don't block the layers underneath; only the inner buttons take clicks.
component NotificationCard inherits Rectangle {
    // `data` rather than `row`, which Slint reserves as the `for` iteration
    // variable and refuses to let a property override.
    in property <NotificationRow> data;
    private property <bool> shown: false;

    init => { root.shown = true; }

    private property <{accent: brush, icon: string}> look:
        root.data.variant == NotificationVariant.success ? { accent: Theme.green, icon: "check_circle" }
        : root.data.variant == NotificationVariant.warning ? { accent: Theme.yellow, icon: "warning" }
        : root.data.variant == NotificationVariant.error ? { accent: Theme.danger, icon: "error" }
        : { accent: Theme.accent, icon: "info" };

    height: layout.preferred-height;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: Theme.dur-fast; easing: ease-out; }

    private property <length> radius: Theme.radius-md;
    private property <length> border-w: 1px;
    // Where the accent bar ends, measured from the card's outer edge.
    private property <length> bar-end: root.border-w + 4px;

    // Fill, bar and border are three elements so the bar can sit between the other two, and the
    // fill is tucked so the card's silhouette still antialiases once.
    TuckedFill {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        radius: root.radius;
        stroke-width: root.border-w;
        fill: Theme.surface0;
    }

    // The part of the card left of `bar-end`, cut along the border's middle so its curved edge
    // lies under solid border. A plain rectangle this narrow can't carry the card's radius: the
    // renderer clamps each corner's radii to half the width and half the height separately, and
    // the ellipse it makes paints past the card's corners.
    Path {
        property <float> r: root.radius / 1px;
        property <float> inset: root.border-w / 2px;
        property <float> arc: self.r - self.inset;
        property <float> end: root.bar-end / 1px;
        property <float> h: root.height / 1px;
        // How far above the corner's centre the arc crosses `bar-end`.
        property <float> reach: Math.sqrt(self.arc * self.arc - (self.r - self.end) * (self.r - self.end));

        x: 0;
        y: 0;
        width: root.bar-end;
        height: root.height;
        viewbox-width: self.end;
        viewbox-height: self.h;
        fill: root.look.accent;
        // Counter-clockwise and closed up the right edge, or it fills as a hole with no
        // antialiasing: `slint-pitfalls.md`'s `Path` entry. Numbers go in unlocalized, a bare `+`
        // writing the translation's decimal separator, which the path parser rejects.
        commands: "M " + self.end.to-string-unlocalized()
            + " " + (self.r - self.reach).to-string-unlocalized()
            + " A " + self.arc.to-string-unlocalized() + " " + self.arc.to-string-unlocalized()
            + " 0 0 0 " + self.inset.to-string-unlocalized() + " " + self.r.to-string-unlocalized()
            + " V " + (self.h - self.r).to-string-unlocalized()
            + " A " + self.arc.to-string-unlocalized() + " " + self.arc.to-string-unlocalized()
            + " 0 0 0 " + self.end.to-string-unlocalized()
            + " " + (self.h - self.r + self.reach).to-string-unlocalized()
            + " Z";
    }

    layout := HorizontalLayout {
        padding-left: root.bar-end + Theme.pad-md;
        padding-right: Theme.pad-sm;
        padding-top: Theme.pad-sm;
        padding-bottom: Theme.pad-sm;
        spacing: Theme.pad-sm;
        // Every cell centres: a one-line card is as tall as its 32 px action pill, and the 20 px
        // glyph box outgrows the title's line box, so a top-aligned cell would sit off the row's
        // centre line.
        cross-axis-alignment: center;

        MaterialIcon {
            name: root.look.icon;
            icon-size: 20px;
            icon-color: root.look.accent;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.data.title;
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 600;
                wrap: word-wrap;
            }
            // An `if` rather than `visible: false`, which would still reserve
            // the text line for an empty message.
            if root.data.message != "": Text {
                text: root.data.message;
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
        }

        // Filled, so the action reads as a button rather than a label.
        if root.data.action-label != "": SectionButton {
            label: root.data.action-label;
            icon: "";
            primary: true;
            clicked => {
                Notifications.action(root.data.id, root.data.kind);
            }
        }

        // Kept small so it doesn't dominate the card.
        IconButton {
            icon: "close";
            icon-size: 16px;
            diameter: 24px;
            // A step up from the card's own fill, so the hover reads.
            hover-bg: Theme.surface1;
            clicked => {
                Notifications.dismiss(root.data.id);
            }
        }
    }

    // Last, so it strokes over the accent bar. The third `surface0` card that floats over the
    // app and so has to state its own edge, `Tooltip` and the dialog being the other two.
    // `Theme.border` is `surface0` on Catppuccin, so this one was painting its own fill.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: root.border-w;
        border-color: Theme.surface2;
    }
}

// Paints `Notifications.rows` as a bottom-right anchored stack. Mounted once at
// the AppWindow root beside `DialogOverlay`, and sized to the whole window so
// its inner stack's absolute coordinates resolve against the viewport.
//
// Newest sits at the bottom: Rust appends, the layout renders in model order,
// and `alignment: end` pins the stack to the bottom edge — so a later row lands
// closest to the corner and older ones slide up as it arrives.
export component NotificationStack inherits Rectangle {
    // The caller keeps the outer Rectangle at full size, so the children can
    // compute their right- and bottom-edge insets against the whole window.
    inner := VerticalLayout {
        x: parent.width - self.width - 16px;
        y: parent.height - self.preferred-height - 16px - Theme.now-playing-h;
        width: 360px;
        height: self.preferred-height;
        spacing: 8px;
        alignment: end;

        for row[i] in Notifications.rows: NotificationCard {
            data: row;
            width: 100%;
        }
    }
}
