import { ApplyFailure, HeadphonePicker, PickerPhase } from "../../globals/correction-dialogs.slint";
import { PickList } from "pick-list.slint";

// AutoEq's models behind a filter, or a state saying why there are none.
export component HeadphonePickerBody inherits PickList {
    property <bool> loading: HeadphonePicker.phase == PickerPhase.loading;

    rows: HeadphonePicker.rows;
    listing: HeadphonePicker.phase == PickerPhase.listing;
    filter <=> HeadphonePicker.filter;
    picked <=> HeadphonePicker.picked;
    placeholder: @tr("Find a model…");

    state-icon: root.loading ? "headphones" : root.listing ? "search_off" : "error";
    state-title: root.loading ? @tr("Loading…")
        : HeadphonePicker.phase == PickerPhase.unreachable ? @tr("Couldn't reach AutoEq")
        : HeadphonePicker.phase == PickerPhase.unreadable ? @tr("AutoEq's list couldn't be read")
        : @tr("No model matches");
    state-body: root.listing || root.loading ? ""
        : @tr("A correction file can still be imported from the card.");

    failure: HeadphonePicker.failure == ApplyFailure.none ? ""
        : HeadphonePicker.failure == ApplyFailure.unreachable
        ? @tr("Couldn't reach AutoEq. Check your connection and try again.")
        : HeadphonePicker.failure == ApplyFailure.refused
        ? @tr("AutoEq's profile for this model holds lines Melodia can't read.")
        : @tr("Couldn't apply the correction. See the log for details.");

    filter-changed(needle) => { HeadphonePicker.filter-changed(needle); }
    subtitle-for(row) => {
        // Translators: {} names who measured the headphones, as oratory1990.
        @tr("Measured by {}", row.subtitle)
    }
}
