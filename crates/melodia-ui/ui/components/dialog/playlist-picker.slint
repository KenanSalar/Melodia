import { Theme } from "../../theme.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Playlists } from "../../globals/playlists.slint";
import { SelectableRow, SelectAllHeader, PickerListCard } from "selectable-picker.slint";

// Add-to-Playlist body: the Export picker's multi-select list, committing the
// pending tracks into every ticked playlist at once through the `Dialog.accepted`
// dispatcher. The row visuals are the shared `selectable-picker.slint` toolkit,
// and Rust owns both the per-row toggle and the header's select-all.
//
// A row's overlap with the pending set drives its subtitle and its disabled
// flag: no overlap is plain and selectable, a partial one says how much is
// already there and stays selectable (the insert only adds what's missing), and
// a playlist that already contains everything is dimmed out.
export component PlaylistPicker inherits Rectangle {
    VerticalLayout {
        spacing: Theme.pad-sm;

        SelectAllHeader {
            checked: Dialog.add-select-all;
            indeterminate: !Dialog.add-select-all
                && Dialog.add-selected-count > 0;
            selected-count: Dialog.add-selected-count;
            toggled => { Playlists.set-all-add-picks(!Dialog.add-select-all); }
        }

        // The menu entry opening this dialog is gated on there being playlists,
        // so an empty list only ever means the queries haven't landed yet. The
        // slot is held so the dialog doesn't snap-resize when they do.
        if Dialog.playlist-pick-rows.length == 0: Rectangle {
            height: 80px;
        }

        if Dialog.playlist-pick-rows.length > 0: PickerListCard {
            row-count: Dialog.playlist-pick-rows.length;
            for r in Dialog.playlist-pick-rows: SelectableRow {
                name: r.name;
                subtitle: (Dialog.pick-total-tracks > 0
                        && r.contained-count >= Dialog.pick-total-tracks)
                    ? @tr("Already added")
                    : (r.contained-count > 0
                        ? @tr("{} of {} already added", r.contained-count, Dialog.pick-total-tracks)
                        : "");
                cover: Playlists.request-row-cover(r.artwork_path);
                artwork-path: r.artwork_path;
                fallback-icon: "playlist";
                selected: r.selected;
                disabled: r.contained-count >= Dialog.pick-total-tracks
                    && Dialog.pick-total-tracks > 0;
                toggled => { Playlists.toggle-add-pick(r.id); }
            }
        }
    }
}
