import { Theme } from "../../theme.slint";
import { SmartEditor, TagEditor, ScrobbleUi, RadioForm } from "../../globals/dialog-forms.slint";
import { Dialog as DialogGlobal, DialogKind } from "../../globals/dialog.slint";
import { DuplicatesUi } from "../../globals/duplicates.slint";
import { LibrarySettings } from "../../globals/library-settings.slint";
import { SectionButton } from "../settings/section-button.slint";
import { PlaylistMosaicPicker } from "playlist-mosaic-picker.slint";
import { PlaylistPicker } from "playlist-picker.slint";
import { ExportPlaylistPicker } from "export-playlist-picker.slint";
import { EqualizerBody } from "equalizer-body.slint";
import { ReplayGainBody } from "replaygain-body.slint";
import { SmartPlaylistEditorBody } from "smart-playlist-editor-body.slint";
import { TagEditorBody } from "tag-editor-body.slint";
import { ScrobbleLastfmBody } from "scrobble-lastfm-body.slint";
import { ScrobbleListenbrainzBody } from "scrobble-listenbrainz-body.slint";
import { AddStationBody } from "add-station-body.slint";
import { DuplicatesBody } from "duplicates-body.slint";
import { KeptOutBody } from "kept-out-body.slint";
import { LabeledInput } from "../labeled-input.slint";
import { DialogHeader } from "dialog-header.slint";
import { ModalCard } from "modal-card.slint";

// The modal overlay the `Dialog` global drives, mounted once at the root. Always rendered, never
// gated on `open`, so the close can play; its input is `enabled` only while open.
export component DialogOverlay inherits Rectangle {
    width: 100%;
    height: 100%;

    private property <float> t: DialogGlobal.open ? 1.0 : 0.0;
    animate t { duration: Theme.dur-fast; easing: ease-out; }

    // Starts true, so the first layout settling at 0 fires no `closed`. The falling edge is the
    // only safe moment to clear the routing state; earlier unmounts the body mid-fade.
    private property <bool> fully-closed: true;
    changed t => {
        if (root.t > 0.99) {
            root.fully-closed = false;
        } else if (root.t < 0.001 && !root.fully-closed) {
            root.fully-closed = true;
            DialogGlobal.closed();
        }
    }

    property <length> max-w:
        DialogGlobal.kind == DialogKind.equalizer ? 600px
        : DialogGlobal.kind == DialogKind.replaygain ? 480px
        : DialogGlobal.kind == DialogKind.edit-playlist-artwork ? 520px
        : DialogGlobal.kind == DialogKind.smart-playlist-editor ? 760px
        : DialogGlobal.kind == DialogKind.duplicates ? 760px
        : DialogGlobal.kind == DialogKind.kept-out-files ? 760px
        : DialogGlobal.kind == DialogKind.edit-tags ? 720px
        : DialogGlobal.kind == DialogKind.scrobble-lastfm-login ? 460px
        : DialogGlobal.kind == DialogKind.scrobble-listenbrainz-login ? 460px
        : DialogGlobal.kind == DialogKind.add-station ? 480px
        : DialogGlobal.kind == DialogKind.edit-station ? 480px
        : 540px;
    // Confirmation kinds only, mapped by kind so a caller sets nothing extra.
    property <string> kind-icon:
        DialogGlobal.kind == DialogKind.delete-playlist
            || DialogGlobal.kind == DialogKind.delete-playlists ? "delete" :
        DialogGlobal.kind == DialogKind.remove-folder ? "folder_off" :
        DialogGlobal.kind == DialogKind.remove-from-favorites
            || DialogGlobal.kind == DialogKind.remove-from-recent ? "delete" :
        DialogGlobal.kind == DialogKind.clear-queue ? "clear_all" :
        DialogGlobal.kind == DialogKind.bit-perfect-exclusive ? "graphic_eq" :
        DialogGlobal.kind == DialogKind.restart-titlebar
            || DialogGlobal.kind == DialogKind.restart-tray
            || DialogGlobal.kind == DialogKind.restart-backdrop ? "restart_alt" :
        "";
    // Only a kind whose body scrolls may be capped: nothing here clips, so a squeezed body paints
    // its remainder, buttons included, onto the backdrop. A kind joining this list owes a scroller.
    property <bool> body-scrolls:
        DialogGlobal.kind == DialogKind.add-station || DialogGlobal.kind == DialogKind.edit-station
        || DialogGlobal.kind == DialogKind.smart-playlist-editor
        || DialogGlobal.kind == DialogKind.duplicates
        || DialogGlobal.kind == DialogKind.kept-out-files;
    property <length> eased-height: layout.preferred-height;
    // A transition rather than `animate`, which would chase a window resize: its curve ends a
    // fixed time after the step changed, so a later resize snaps. `in` only, finding being the
    // default, so the card opens at rest and a close's teardown leaves nothing easing.
    states [
        finder-confirm when root.duplicates-confirming: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
        finder-list when DialogGlobal.kind == DialogKind.duplicates && DuplicatesUi.listing: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
        // Nothing listed, or the find failed.
        finder-settled when DialogGlobal.kind == DialogKind.duplicates && !DuplicatesUi.busy: {
            eased-height: layout.preferred-height;
            in {
                animate eased-height { duration: Theme.dur-med; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
    ]
    // The finder's second step, whose footer reads Back and Remove.
    property <bool> duplicates-confirming:
        DialogGlobal.kind == DialogKind.duplicates && DuplicatesUi.confirming;
    // A fact about the form rather than an action on it, stated opposite the buttons.
    property <string> footer-note:
        DialogGlobal.kind == DialogKind.smart-playlist-editor && SmartEditor.match-count >= 0
            ? @tr("{n} track" | "{n} tracks" % SmartEditor.match-count)
        // A scan can retag or add a copy the list shows, so Remove waits it out.
        : root.duplicates-confirming && LibrarySettings.scanning
            ? @tr("Remove waits until the library scan finishes.")
        : DialogGlobal.kind == DialogKind.duplicates && DuplicatesUi.picked-count > 0
            // Translators: {} is the picked copies' total size, as 1.2 GB.
            ? @tr("{n} copy picked · {}" | "{n} copies picked · {}" % DuplicatesUi.picked-count,
                  DuplicatesUi.picked-size)
            : "";

    frame := ModalCard {
        t: root.t;
        interactive: DialogGlobal.open;
        max-card-width: root.max-w;
        card-height: root.body-scrolls
            // Floored so a step growing out of a shorter one keeps its footer on the card.
            ? min(max(root.eased-height, layout.min-height), self.height-cap)
            : layout.preferred-height;
        backdrop-clicked => {
            // A dismiss is a cancel, so the dispatcher still cleans up.
            DialogGlobal.cancelled();
            DialogGlobal.open = false;
        }

        layout := VerticalLayout {
            x: 0px;
            y: 0px;
            width: frame.card-width;
            height: frame.card-height;
            padding: Theme.pad-lg;
            spacing: Theme.pad-md;

            DialogHeader {
                icon: root.kind-icon;
                title: DialogGlobal.title;
                message: DialogGlobal.message;
                destructive: DialogGlobal.destructive;
            }

            // No auto-focus on init: `focus()` during the open re-enters Slint's property
            // evaluator and trips its recursion guard.
            if DialogGlobal.kind == DialogKind.create-playlist
                || DialogGlobal.kind == DialogKind.rename-playlist: VerticalLayout {
                spacing: Theme.pad-sm;

                LabeledInput {
                    label: @tr("Name");
                    placeholder: @tr("Playlist name");
                    text <=> DialogGlobal.input-text;
                    accepted => {
                        if (DialogGlobal.input-text != "") {
                            DialogGlobal.accepted();
                            DialogGlobal.open = false;
                        }
                    }
                }

                LabeledInput {
                    label: @tr("Description (optional)");
                    placeholder: @tr("Add a description…");
                    text <=> DialogGlobal.input-text-2;
                    accepted => {
                        if (DialogGlobal.input-text != "") {
                            DialogGlobal.accepted();
                            DialogGlobal.open = false;
                        }
                    }
                }
            }

            if DialogGlobal.kind == DialogKind.edit-playlist-artwork: PlaylistMosaicPicker { }

            if DialogGlobal.kind == DialogKind.add-to-playlist: PlaylistPicker { }

            if DialogGlobal.kind == DialogKind.export-playlists: ExportPlaylistPicker { }

            // Applies live; the caller leaves `cancel-label` empty.
            if DialogGlobal.kind == DialogKind.equalizer: EqualizerBody { }

            if DialogGlobal.kind == DialogKind.replaygain: ReplayGainBody { }

            if DialogGlobal.kind == DialogKind.smart-playlist-editor: SmartPlaylistEditorBody { }

            if DialogGlobal.kind == DialogKind.edit-tags: TagEditorBody { }

            if DialogGlobal.kind == DialogKind.scrobble-lastfm-login: ScrobbleLastfmBody { }
            if DialogGlobal.kind == DialogKind.scrobble-listenbrainz-login: ScrobbleListenbrainzBody { }

            if DialogGlobal.kind == DialogKind.add-station
                || DialogGlobal.kind == DialogKind.edit-station: AddStationBody { }

            if DialogGlobal.kind == DialogKind.duplicates: DuplicatesBody { }

            if DialogGlobal.kind == DialogKind.kept-out-files: KeptOutBody { }

            HorizontalLayout {
                spacing: Theme.pad-sm;
                padding-top: Theme.pad-sm;

                if root.footer-note != "": Text {
                    horizontal-stretch: 0;
                    text: root.footer-note;
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }

                // `if` rather than `visible`, so an info-only dialog keeps its primary button
                // flush right.
                if DialogGlobal.cancel-label != "": SectionButton {
                    label: root.duplicates-confirming ? @tr("Back") : DialogGlobal.cancel-label;
                    icon: "";
                    primary: false;
                    button-enabled: DialogGlobal.open
                        && !(root.duplicates-confirming && DuplicatesUi.removing);
                    clicked => {
                        if (root.duplicates-confirming) {
                            DuplicatesUi.confirming = false;
                        } else {
                            DialogGlobal.cancelled();
                            DialogGlobal.open = false;
                        }
                    }
                }

                SectionButton {
                    // Picked here rather than in Rust, so the `@tr` literals localize.
                    label: DialogGlobal.kind == DialogKind.scrobble-lastfm-login
                        ? (ScrobbleUi.lastfm-step == 0 ? @tr("Open Last.fm") : @tr("Finish"))
                        : DialogGlobal.kind == DialogKind.scrobble-listenbrainz-login
                        ? @tr("Connect")
                        : DialogGlobal.kind == DialogKind.duplicates
                        ? (DuplicatesUi.confirming ? @tr("Remove") : @tr("Continue"))
                        : DialogGlobal.confirm-label;
                    icon: "";
                    primary: true;
                    destructive: DialogGlobal.destructive || root.duplicates-confirming;
                    // The dispatcher gates each commit on the same condition; disabled, the
                    // button shows the requirement instead of no-opping.
                    button-enabled: DialogGlobal.open
                        && ((DialogGlobal.kind != DialogKind.create-playlist
                                && DialogGlobal.kind != DialogKind.rename-playlist)
                            || DialogGlobal.input-text != "")
                        && (DialogGlobal.kind != DialogKind.export-playlists
                            || DialogGlobal.export-selected-count > 0)
                        && (DialogGlobal.kind != DialogKind.add-to-playlist
                            || DialogGlobal.add-selected-count > 0)
                        && (DialogGlobal.kind != DialogKind.smart-playlist-editor
                            || (SmartEditor.name != "" && SmartEditor.rules.length > 0))
                        // Rust short-circuits a no-op Save.
                        && (DialogGlobal.kind != DialogKind.edit-tags
                            || TagEditor.track-count > 0)
                        && (DialogGlobal.kind != DialogKind.scrobble-listenbrainz-login
                            || (ScrobbleUi.lb-token != "" && !ScrobbleUi.busy))
                        && (DialogGlobal.kind != DialogKind.scrobble-lastfm-login
                            || !ScrobbleUi.busy)
                        // A station's name is optional and fills itself in.
                        && ((DialogGlobal.kind != DialogKind.add-station
                                && DialogGlobal.kind != DialogKind.edit-station)
                            || (RadioForm.url != "" && !RadioForm.busy))
                        && (DialogGlobal.kind != DialogKind.duplicates
                            || (DuplicatesUi.confirming
                                ? !LibrarySettings.scanning && !DuplicatesUi.removing
                                : DuplicatesUi.picked-count > 0));
                    clicked => {
                        DialogGlobal.accepted();
                        // A kind making a request stays open across it and Rust closes it.
                        if (DialogGlobal.kind != DialogKind.scrobble-lastfm-login
                                && DialogGlobal.kind != DialogKind.scrobble-listenbrainz-login
                                && DialogGlobal.kind != DialogKind.add-station
                                && DialogGlobal.kind != DialogKind.edit-station
                                && DialogGlobal.kind != DialogKind.duplicates) {
                            DialogGlobal.open = false;
                        }
                    }
                }
            }
        }
    }
}
