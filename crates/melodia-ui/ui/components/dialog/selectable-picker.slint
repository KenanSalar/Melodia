import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { MaterialIcon } from "../material-icon.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";

// The selectable-list dialogs' toolkit, data-agnostic so neither picker's globals reach in.
// No rounded `clip` holds the rows, its texture softening text on a fractional pixel.

// The dash is the header's some-but-not-all state.
export component SelectIndicator inherits Rectangle {
    in property <bool> checked;
    in property <bool> indeterminate;
    in property <float> fade: 1.0;

    private property <bool> active: root.checked || root.indeterminate;

    width: 24px;
    height: 24px;
    border-radius: self.width / 2;
    background: (root.active ? Theme.accent : transparent).transparentize(1.0 - root.fade);
    border-width: root.active ? 0px : 2px;
    border-color: Theme.overlay0.transparentize(1.0 - root.fade);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    if root.active: MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.indeterminate ? "remove" : "check";
        icon-size: 16px;
        icon-color: Theme.accent-text;
        fade: root.fade;
    }
}

// One list item, its `height` matching `PickerListCard.row-h`. An empty `subtitle` draws no
// second line.
export component SelectableRow inherits Rectangle {
    in property <string> name;
    in property <string> subtitle;
    in property <image> cover;
    in property <string> artwork-path;
    in property <string> fallback-icon: "playlist";
    in property <bool> selected;
    in property <bool> disabled;
    callback toggled();

    // Through each brush, `opacity` holding a texture for as long as the row is disabled.
    private property <float> fade: root.disabled ? 0.5 : 1.0;

    height: 60px;
    border-radius: Theme.radius-md;
    background: (root.selected
            ? Theme.accent.with-alpha(0.16)
            : (touch.has-hover && !root.disabled ? Theme.surface1 : transparent))
        .transparentize(1.0 - root.fade);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-md;
        alignment: start;
        cross-axis-alignment: center;

        ArtworkImage {
            tile-size: 44px;
            tile-radius: Theme.radius-md;
            artwork-path: root.artwork-path;
            cover: root.cover;
            fallback-icon: root.fallback-icon;
            cover-scale: touch.has-hover && !root.disabled ? 1.05 : 1.0;
            fade: root.fade;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.text.transparentize(1.0 - root.fade);
                font-size: Theme.font-size-md;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: (root.selected ? Theme.accent : Theme.subtext0).transparentize(1.0 - root.fade);
                font-size: Theme.font-size-sm;
                overflow: elide;
                animate color { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
            }
        }

        SelectIndicator {
            checked: root.selected;
            fade: root.fade;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component SelectAllHeader inherits Rectangle {
    in property <bool> checked;
    in property <bool> indeterminate;
    in property <int> selected-count;
    callback toggled();

    height: 52px;
    border-radius: Theme.radius-md;
    background: header-touch.has-hover ? Theme.surface1 : Theme.surface0;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-md;
        alignment: start;
        cross-axis-alignment: center;

        SelectIndicator {
            checked: root.checked;
            indeterminate: root.indeterminate;
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Select all");
            color: Theme.text;
            font-size: Theme.font-size-md;
            font-weight: 600;
        }
        Rectangle {
            height: 26px;
            width: chip-l.preferred-width;
            border-radius: self.height / 2;
            background: root.selected-count > 0
                ? Theme.accent.with-alpha(0.18)
                : Theme.card-control;
            animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

            chip-l := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text {
                    text: @tr("{} selected", root.selected-count);
                    color: root.selected-count > 0
                        ? Theme.accent
                        : Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }

    header-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// The rounded card the rows scroll inside, the host's `for` arriving through `@children`. The
// `ScrollView` clips its viewport with a scissor, no layer, and sits inside the border so no row
// scrolls over it; fill and border are one shape, antialiased once.
export component PickerListCard inherits Rectangle {
    in property <int> row-count;
    in property <length> list-max-height: 312px;

    // `row-h` equals `SelectableRow.height`, so the card sizes itself from `row-count` alone.
    private property <length> row-h: 60px;
    private property <length> row-spacing: 4px;
    private property <length> pad: 6px;
    private property <length> border-w: 1px;
    private property <length> content-h:
        root.row-count * root.row-h
        + (root.row-count > 0 ? (root.row-count - 1) * root.row-spacing : 0px)
        + 2 * root.pad;

    height: min(root.list-max-height, root.content-h);
    background: Theme.surface0;
    border-radius: Theme.radius-md;
    border-width: root.border-w;
    // `surface2`, `Theme.border` being `surface0` itself and so invisible on this fill.
    border-color: Theme.surface2;

    // The border comes out of `pad` and the viewport alike, so a list that fits gains no travel.
    sv := ScrollView {
        x: root.border-w;
        y: root.border-w;
        width: parent.width - 2 * root.border-w;
        height: parent.height - 2 * root.border-w;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: root.content-h - 2 * root.border-w;

        VerticalLayout {
            padding: root.pad - root.border-w;
            spacing: root.row-spacing;
            @children
        }
    }

    OverlayScrollbar {
        horizontal: false;
        track-color: Theme.scrollbar-track-on-card;
        x: parent.width - self.width - 2px;
        y: 2px;
        width: Theme.scrollbar-slot;
        height: parent.height - 4px;
        visible-size: sv.visible-height;
        content-size: sv.content-height;
        offset: -sv.content-y;
        scroll-to(o) => { sv.content-y = -o; }
    }
}
