import { Theme } from "../../theme.slint";
import { SmartEditor } from "../../globals/dialog-forms.slint";
import { SmartRuleRow } from "../../models.slint";
import { Dropdown } from "../settings/dropdown.slint";
import { ToggleSwitch } from "../settings/toggle-switch.slint";
import { LabeledInput } from "../labeled-input.slint";
import { IconButton } from "../icon-button.slint";
import { PillButton } from "../action-pill.slint";
import { FilterThrottle } from "../filter-throttle.slint";
import { ControlledInput } from "./controlled-input.slint";
import { DialogScrollPane } from "./dialog-scroll-pane.slint";

// A dialog-row label centred against its sibling controls. Wraps the
// "fixed-width children don't centre in a wider layout" pitfall once, rather
// than hand-rolling the centring layout at every label site.
component RowLabel inherits VerticalLayout {
    in property <string> text;
    alignment: center;
    Text {
        text: root.text;
        color: Theme.subtext0;
        font-size: Theme.font-size-md;
    }
}

// One editable rule, drawn as its own card. Purely presentational: Rust owns the model and applies
// every edit through the callbacks below, so this never mutates `rule`. The `View` suffix is to
// keep it clear of the model struct's name.
component SmartRuleRowView inherits Rectangle {
    in property <SmartRuleRow> rule;
    in property <[string]> field-names;
    // Resolved by the host, so the four operator arrays live in one place.
    in property <[string]> ops;
    in property <length> control-h;
    callback set-field(int /*field index*/);
    callback set-op(int /*op index*/);
    callback set-value(string);
    callback remove();

    // A fill a step off the card's rather than a border, so the rule reads as one unit and its
    // corners stay a single antialiased curve.
    background: Theme.base;
    border-radius: Theme.radius-md;

    HorizontalLayout {
        padding: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: start;

        Dropdown {
            trigger-width: 148px;
            options: root.field-names;
            // One-way plus `manual` keeps Rust the single source of truth: the index
            // re-reads after every model edit, so a field change that resets the
            // operator can't leave a stale selection. A self-writing `Dropdown`
            // would orphan the binding on the first pick.
            manual: true;
            selected-index: root.rule.field-index;
            selected(idx) => { root.set-field(idx); }
        }
        Dropdown {
            trigger-width: 148px;
            options: root.ops;
            manual: true;
            selected-index: root.rule.op-index;
            selected(idx) => { root.set-op(idx); }
        }

        // Split by input-kind so switching kinds remounts a fresh input that
        // re-reads the Rust-reset value, while a same-kind change reuses it and
        // keeps what's typed. Do NOT collapse the branches into one with a ternary
        // placeholder — that boundary *is* the remount key that resyncs the input.
        if root.rule.input-kind == 1: ControlledInput {
            height: root.control-h;
            horizontal-stretch: 1;
            min-width: 90px;
            text: root.rule.value-text;
            placeholder: @tr("value");
            edited(t) => { root.set-value(t); }
        }
        // Digits only: every numeric field is a whole number, and `decimal` would take the
        // locale's comma, which the Rust parse rejects.
        if root.rule.input-kind == 2: ControlledInput {
            height: root.control-h;
            horizontal-stretch: 1;
            min-width: 90px;
            input-type: InputType.number;
            text: root.rule.value-text;
            placeholder: root.rule.field-kind == 3 ? @tr("days") : @tr("number");
            edited(t) => { root.set-value(t); }
        }
        // Days suffix for the relative-date operators.
        if root.rule.field-kind == 3 && root.rule.input-kind == 2: RowLabel {
            text: @tr("days");
        }
        // Keeps the remove button flush-right when the operator takes no value.
        if root.rule.input-kind == 0: Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: "close";
                icon-size: 16px;
                diameter: 28px;
                idle-bg: Theme.surface1;
                hover-fg: Theme.danger;
                clicked => { root.remove(); }
            }
        }
    }
}

// Body of the rule-builder dialog, over the `SmartEditor` global; Rust owns the
// rules model and rebuilds a `SmartCriteria` on commit.
//
// Every dropdown array below is an inline literal list — a Rust-populated
// `[string]` renders untranslated — ordered to mirror
// `entities::smart_criteria::{FIELDS, ops_for, LimitOrder}` **by index**. Adding
// or reordering a field or operator means editing both sides in lockstep;
// `entities::tests::smart_criteria_tests` pins the leading order and each
// array's length against the Rust side.
export component SmartPlaylistEditorBody inherits VerticalLayout {
    spacing: Theme.pad-md;

    property <[string]> field-names: [
        @tr("Title"), @tr("Artist"), @tr("Album Artist"), @tr("Album"),
        @tr("Genre"), @tr("Credits"), @tr("Mood"), @tr("Key"), @tr("ISRC"),
        @tr("Year"), @tr("BPM"), @tr("Duration (sec)"), @tr("Plays"),
        @tr("Skips"), @tr("Rating"), @tr("Bitrate (kbps)"), @tr("Sample rate (Hz)"),
        @tr("File size (bytes)"), @tr("Favorite"), @tr("Last played"), @tr("Date added"),
    ];
    // By field-kind, mirroring `ops_for(value_type)`.
    property <[string]> text-ops: [
        @tr("contains"), @tr("does not contain"), @tr("is"), @tr("is not"),
        @tr("starts with"), @tr("ends with"), @tr("is set"), @tr("is not set"),
    ];
    property <[string]> number-ops: [
        @tr("is"), @tr("is not"), @tr("greater than"), @tr("at least"),
        @tr("less than"), @tr("at most"), @tr("is set"), @tr("is not set"),
    ];
    property <[string]> bool-ops: [ @tr("is true"), @tr("is false") ];
    property <[string]> date-ops: [
        @tr("in the last"), @tr("not in the last"), @tr("is set"), @tr("is not set"),
    ];
    // Mirrors `smart_criteria::MATCH_MODES`.
    property <[string]> match-modes: [ @tr("all"), @tr("any") ];
    // Mirrors `smart_criteria::LIMIT_ORDERS`.
    property <[string]> limit-orders: [
        @tr("most recently added"), @tr("least recently added"),
        @tr("most played"), @tr("least played"),
        @tr("most recently played"), @tr("least recently played"),
        @tr("highest rated"), @tr("random"),
    ];

    // The `Dropdown` trigger's height, so a value field lines up with the pickers beside it.
    property <length> control-h: 32px;

    // Bumped by every edit that can move the count.
    property <int> recount-pending;
    // Raised by Add rule, lowered once the new row has been scrolled to.
    property <bool> reveal-end;

    function ops-for-kind(kind: int) -> [string] {
        return kind == 0 ? root.text-ops
            : kind == 1 ? root.number-ops
            : kind == 2 ? root.bool-ops
            : root.date-ops;
    }

    function criteria-changed() {
        root.recount-pending += 1;
    }

    // The card is capped against the window, so a long rule set scrolls the whole form rather
    // than a strip of it. `preferred-height` comes off the column, as in `AddStationBody`.
    pane := DialogScrollPane {
        min-height: 96px;
        preferred-height: pane.content-height;
        vertical-stretch: 1;
        content-spacing: Theme.pad-md;

        LabeledInput {
            label: @tr("Name");
            placeholder: @tr("Smart playlist name");
            text <=> SmartEditor.name;
        }

        LabeledInput {
            label: @tr("Description (optional)");
            placeholder: @tr("Add a description…");
            text <=> SmartEditor.description;
        }

        HorizontalLayout {
            spacing: Theme.pad-sm;
            alignment: start;
            RowLabel { text: @tr("Match"); }
            Dropdown {
                trigger-width: 90px;
                options: root.match-modes;
                selected-index <=> SmartEditor.match-mode-index;
                selected(idx) => { root.criteria-changed(); }
            }
            RowLabel { text: @tr("of the following rules"); }
        }

        // The rules and the button that extends them sit closer together than the form's sections.
        VerticalLayout {
            spacing: Theme.pad-sm;

            for rule[i] in SmartEditor.rules: SmartRuleRowView {
                rule: rule;
                field-names: root.field-names;
                ops: root.ops-for-kind(rule.field-kind);
                control-h: root.control-h;
                set-field(idx) => {
                    SmartEditor.set-rule-field(i, idx);
                    root.criteria-changed();
                }
                set-op(idx) => {
                    SmartEditor.set-rule-op(i, idx);
                    root.criteria-changed();
                }
                set-value(t) => {
                    SmartEditor.set-rule-value(i, t);
                    root.criteria-changed();
                }
                remove => {
                    SmartEditor.remove-rule(i);
                    root.criteria-changed();
                }
            }

            HorizontalLayout {
                alignment: start;
                PillButton {
                    icon: "add";
                    text: @tr("Add rule");
                    clicked => {
                        SmartEditor.add-rule();
                        root.reveal-end = true;
                        root.criteria-changed();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.surface2;
        }

        HorizontalLayout {
            spacing: Theme.pad-sm;
            alignment: start;
            VerticalLayout {
                alignment: center;
                ToggleSwitch {
                    checked <=> SmartEditor.limit-enabled;
                    toggled(on) => { root.criteria-changed(); }
                }
            }
            RowLabel { text: @tr("Limit to"); }
            if SmartEditor.limit-enabled: ControlledInput {
                width: 64px;
                height: root.control-h;
                input-type: InputType.number;
                text: SmartEditor.limit-count-text;
                placeholder: @tr("N");
                edited(t) => {
                    SmartEditor.limit-count-text = t;
                    root.criteria-changed();
                }
            }
            if SmartEditor.limit-enabled: RowLabel { text: @tr("tracks by"); }
            if SmartEditor.limit-enabled: Dropdown {
                trigger-width: 190px;
                options: root.limit-orders;
                selected-index <=> SmartEditor.limit-order-index;
                selected(idx) => { root.criteria-changed(); }
            }
        }
    }

    // Always mounted, so its line is held before the first count lands and the card doesn't grow
    // under the pointer. A `Rectangle` rather than a layout, which would give the throttle a slot.
    Rectangle {
        height: count-line.preferred-height;

        count-line := Text {
            x: 0;
            text: SmartEditor.match-count >= 0
                ? @tr("{n} track" | "{n} tracks" % SmartEditor.match-count)
                : "";
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
        }

        // A count is a query over the library, so it waits for a typing burst to settle.
        FilterThrottle {
            pending: root.recount-pending;
            trailing: true;
            interval: 250ms;
            fire() => { SmartEditor.recount(); }
        }
    }

    // The next tick rather than the click itself: the new row has to lay out before there is an
    // end to scroll to.
    Timer {
        interval: 1ms;
        running: root.reveal-end;
        triggered() => {
            root.reveal-end = false;
            pane.scroll-to-end();
        }
    }
}
