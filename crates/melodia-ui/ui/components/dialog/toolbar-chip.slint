import { Theme } from "../../theme.slint";
import { FilledChip } from "../filled-chip.slint";
import { MaterialIcon } from "../material-icon.slint";

// An action over a dialog's list, resting on the card.
export component ToolbarChip inherits FilledChip {
    in property <string> icon;
    in property <string> label;

    height: 30px;
    horizontal-stretch: 0;
    idle-fill: Theme.card-control;
    hover-fill: Theme.card-control-hover;

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-xs;

        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 16px;
                icon-color: root.ink;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }
}
