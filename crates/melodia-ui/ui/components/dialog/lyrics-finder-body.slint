import { Theme } from "../../theme.slint";
import { LyricsFinder, LyricsMasking, LyricsSearchPhase } from "../../globals/lyrics-finder.slint";
import { DialogScrollPane } from "dialog-scroll-pane.slint";
import { PickList } from "pick-list.slint";

// lrclib.net's matches for the playing track, the picked one's lyrics, and whether the track's own
// lyrics would be shown ahead of it.
export component LyricsFinderBody inherits Rectangle {
    property <bool> lookup-off: LyricsFinder.phase == LyricsSearchPhase.lookup-off;
    property <bool> searching: LyricsFinder.phase == LyricsSearchPhase.loading
        || LyricsFinder.phase == LyricsSearchPhase.searching;
    property <bool> rate-limited: LyricsFinder.phase == LyricsSearchPhase.rate-limited;
    property <bool> failed: LyricsFinder.phase == LyricsSearchPhase.failed;
    property <bool> has-rows: LyricsFinder.phase == LyricsSearchPhase.listing
        && LyricsFinder.rows.length > 0;
    property <bool> shows-words: LyricsFinder.picked >= 0 && LyricsFinder.preview != "";

    // A short window caps the card under the floors below: the column overflows and is cut here
    // rather than pushing the dialog's footer off the card.
    min-height: 0px;
    preferred-height: column.preferred-height;
    vertical-stretch: 1;
    clip: self.height < column.min-height;

    column := VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: max(parent.height, self.min-height);
        spacing: Theme.pad-md;

        PickList {
            vertical-stretch: 1;
            rows: LyricsFinder.rows;
            // The box holds the question, so it stays while lrclib.net answers or refuses, and goes
            // only while the lookup is off. A search empties the rows, raising the state block.
            listing: !root.lookup-off;
            filter <=> LyricsFinder.query;
            picked <=> LyricsFinder.picked;
            blur-tick <=> LyricsFinder.blur-tick;
            placeholder: @tr("Title and artist…");
            // In `finder::badge`'s order.
            badges: [@tr("Word-timed"), @tr("Synced"), @tr("Plain"), @tr("Instrumental")];

            state-icon: root.lookup-off ? "travel_explore"
                : root.searching ? "lyrics"
                : root.rate-limited ? "timer"
                : root.failed ? "error"
                : "search_off";
            state-title: root.lookup-off ? @tr("\"Look up lyrics online\" is off")
                : root.searching ? @tr("Searching…")
                : root.rate-limited ? @tr("lrclib.net asked Melodia to wait")
                : root.failed ? @tr("Couldn't search lrclib.net")
                : @tr("No lyrics match");
            state-body: root.lookup-off
                ? @tr("Turning it on lets Melodia ask lrclib.net for this track, and for any track without lyrics of its own.")
                : root.searching ? ""
                : root.rate-limited ? @tr("Press Enter to search again in a minute.")
                : root.failed ? @tr("Check your connection, then press Enter to search again.")
                : @tr("Try fewer words, or the title alone.");

            failure: LyricsFinder.apply-failed
                ? @tr("Couldn't keep the pick. See the log for details.") : "";

            filter-accepted => { LyricsFinder.search(LyricsFinder.query); }
            row-picked(index) => { LyricsFinder.picked-changed(index); }
            subtitle-for(row) => { row.subtitle }
        }

        // Sized by the layout and never by the sheet, so a pick moves nothing, and stretching with
        // the list so the two give way together on a short window.
        if root.has-rows: Rectangle {
            min-height: 96px;
            preferred-height: 200px;
            vertical-stretch: 1;
            background: Theme.base;
            border-radius: Theme.radius-lg;

            // A mirror, `changed` taking no path on a global: each pick reads from its first line.
            property <int> shown-pick: LyricsFinder.picked;
            changed shown-pick => { pane.scroll-to-start(); }

            pane := DialogScrollPane {
                x: Theme.pad-md;
                y: Theme.pad-xs;
                width: parent.width - Theme.pad-md - Theme.pad-xs;
                height: parent.height - 2 * Theme.pad-xs;

                // Slack inside the viewport's clip for the ink past the first and last line box,
                // and `elide` because the default `clip` scissors the `Text` at that box.
                VerticalLayout {
                    padding-top: Theme.pad-xs;
                    padding-bottom: Theme.pad-xs;

                    Text {
                        text: LyricsFinder.picked < 0 ? @tr("Pick a match to read its lyrics.")
                            : root.shows-words ? LyricsFinder.preview
                            : @tr("lrclib.net files this recording as instrumental.");
                        color: root.shows-words ? Theme.text : Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
        }

        // Apply still keeps such a pick, so it has to say why the panel won't show it.
        if LyricsFinder.masking != LyricsMasking.none: Text {
            text: LyricsFinder.masking == LyricsMasking.sidecar
                ? @tr("The .lrc file beside this track is shown ahead of this pick.")
                : LyricsFinder.masking == LyricsMasking.timed-tag
                ? @tr("The timed lyrics in this track's tags are shown ahead of this pick.")
                : @tr("This track's tags hold lyrics, which are shown ahead of an untimed pick.");
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
    }
}
