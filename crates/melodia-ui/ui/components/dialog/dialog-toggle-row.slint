import { Theme } from "../../theme.slint";
import { ToggleSwitch } from "../settings/toggle-switch.slint";

// A toggle beside a stretching label, for a dialog form whose value the call site chains through
// to its global with a two-way binding.
export component DialogToggleRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;

    spacing: Theme.pad-md;
    alignment: stretch;
    cross-axis-alignment: center;

    ToggleSwitch {
        checked <=> root.checked;
    }
    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-md;
    }
}
