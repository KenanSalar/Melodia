import { Theme } from "../../theme.slint";
import { RadioForm } from "../../globals/dialog-forms.slint";
import { LabeledInput } from "../labeled-input.slint";
import { DialogScrollPane } from "./dialog-scroll-pane.slint";

// Add or edit a station by URL, one body for both kinds.
//
// A directory-owned row drops its name and stream URL, which the next play rewrites, so an edit
// would silently revert. It keeps whatever the directory left blank (`radio.md`'s `local_*`).
//
// No auto-focus on init: `focus()` during the open trips Slint's recursion guard.
export component AddStationBody inherits VerticalLayout {
    spacing: Theme.pad-md;

    // The card is capped against the window, so a short one's deficit lands here and scrolls.
    pane := DialogScrollPane {
        min-height: 96px;
        preferred-height: pane.content-height;
        vertical-stretch: 1;
        content-spacing: Theme.pad-md;

        if !RadioForm.directory-owned: LabeledInput {
            label: @tr("Stream URL");
            // Untranslated: a catalogue entry for a URL invites localizing a hostname.
            placeholder: "https://example.com/stream";
            text <=> RadioForm.url;
            accepted => { RadioForm.submit-if-ready(); }
        }

        if !RadioForm.directory-owned: LabeledInput {
            label: @tr("Name (optional)");
            placeholder: @tr("Leave blank to use the station's own name");
            text <=> RadioForm.name;
            accepted => { RadioForm.submit-if-ready(); }
        }

        // Each on its own flag rather than `directory-owned`, the directory leaving them blank
        // one at a time.
        if RadioForm.can-edit-website: LabeledInput {
            label: @tr("Website");
            placeholder: "https://example.com";
            text <=> RadioForm.website;
            accepted => { RadioForm.submit-if-ready(); }
        }

        if RadioForm.can-edit-logo: LabeledInput {
            label: @tr("Logo URL");
            placeholder: "https://example.com/logo.png";
            text <=> RadioForm.logo-url;
            accepted => { RadioForm.submit-if-ready(); }
        }

        // Most stations take this path, so the field is the fallback rather than the ask.
        if RadioForm.can-edit-logo && RadioForm.logo-url == "" && RadioForm.website != "": Text {
            text: @tr("Leave blank to look for a logo on the website above.");
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        if RadioForm.can-edit-genre: LabeledInput {
            label: @tr("Genre");
            placeholder: @tr("Jazz, Blues");
            text <=> RadioForm.genre;
            accepted => { RadioForm.submit-if-ready(); }
        }

        if RadioForm.can-edit-country: LabeledInput {
            label: @tr("Country");
            placeholder: @tr("Tunisia");
            text <=> RadioForm.country;
            accepted => { RadioForm.submit-if-ready(); }
        }

        // Without it, the missing name and URL read as a broken dialog.
        if RadioForm.directory-owned: Text {
            text: @tr("The directory owns this station's name and stream. What it left blank is yours to fill in; leave a field empty to remove it again.");
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
    }

    // Both outside the scroller, where they can't be scrolled away. The submit is a real connect,
    // and a dialog sitting silent for seconds would read as stuck.
    if RadioForm.busy: Text {
        text: @tr("Checking the stream…");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
    }

    if RadioForm.error != "": Text {
        text: RadioForm.error;
        color: Theme.danger;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
