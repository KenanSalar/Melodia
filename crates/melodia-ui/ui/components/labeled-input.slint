import { Theme } from "../theme.slint";
import { FieldFrame, FieldLabel } from "field-frame.slint";
import { SingleLineInput } from "single-line-input.slint";

// Label plus text input for dialog forms, at a form-sized fixed height.
//
// `text` is two-way bound so the host sees edits live; `accepted` fires on Enter
// for the confirm path.
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    // `number` for a field the commit parses as an integer, so a letter can't be typed into it.
    in property <InputType> input-type: InputType.text;
    callback accepted();

    spacing: 4px;

    FieldLabel {
        text: root.label;
    }

    FieldFrame {
        height: 40px;
        focused: input.has-focus;
        drop-shadow-color: input.has-focus
            ? Theme.accent.with-alpha(0.22)
            : transparent;
        drop-shadow-blur: input.has-focus ? 12px : 0px;
        drop-shadow-offset-y: input.has-focus ? 2px : 0px;
        animate drop-shadow-color, drop-shadow-blur, drop-shadow-offset-y {
            duration: Theme.dur-fast;
            easing: ease-in-out;
            enabled: !Theme.recoloring;
        }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-md;

            input := SingleLineInput {
                horizontal-stretch: 1;
                text <=> root.text;
                placeholder: root.placeholder;
                input-type: root.input-type;
                accepted => { root.accepted(); }
            }
        }
    }
}
