import { Theme } from "../theme.slint";
import { FieldFrame, FieldLabel } from "field-frame.slint";
import { SingleLineInput } from "single-line-input.slint";

// A caption over a two-way text field, for dialog forms.
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    // `number` for a field the commit parses as an integer, so a letter can't be typed into it.
    in property <InputType> input-type: InputType.text;
    callback accepted();

    spacing: 4px;

    FieldLabel {
        text: root.label;
    }

    FieldFrame {
        height: 40px;
        focused: input.has-focus;

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-md;

            input := SingleLineInput {
                horizontal-stretch: 1;
                text <=> root.text;
                placeholder: root.placeholder;
                input-type: root.input-type;
                accepted => { root.accepted(); }
            }
        }
    }
}
