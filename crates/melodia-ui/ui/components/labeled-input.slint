import { Theme } from "../theme.slint";
import { SingleLineInput } from "single-line-input.slint";

// Label plus text input for dialog forms: the `SearchBar`'s focus-tracking chrome under a label
// row, at a form-sized fixed height.
//
// `text` is two-way bound so the host sees edits live; `accepted` fires on Enter
// for the confirm path, `edited` per keystroke for anything throttled.
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    // `number` for a field the commit parses as an integer, so a letter can't be typed into it.
    in property <InputType> input-type: InputType.text;
    callback accepted();
    callback edited();

    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        font-weight: 600;
    }

    Rectangle {
        height: 40px;
        background: Theme.surface1;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-md;
        // The `SearchBar`'s focus halo, so dialog fields and the search box read
        // as one family. Collapses to nothing when blurred.
        drop-shadow-color: input.has-focus
            ? Theme.accent.with-alpha(0.22)
            : transparent;
        drop-shadow-blur: input.has-focus ? 12px : 0px;
        drop-shadow-offset-y: input.has-focus ? 2px : 0px;
        animate border-color, drop-shadow-color, drop-shadow-blur,
                drop-shadow-offset-y {
            duration: Theme.dur-fast;
            easing: ease-in-out;
        }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-md;

            input := SingleLineInput {
                horizontal-stretch: 1;
                text <=> root.text;
                placeholder: root.placeholder;
                input-type: root.input-type;
                accepted => { root.accepted(); }
                edited(t) => { root.edited(); }
            }
        }
    }
}
