import { Theme } from "../theme.slint";
import { ActionPill, PillButton, PillDivider } from "action-pill.slint";

// A row of sort pills, **the `TabBar` shape**: the sortable globals are distinct generated types,
// so no component can be parameterised over which one it sorts. It makes the per-pill arrow slot
// and its binding unspellable (`ui-patterns.md`). **`labels` stays an inline `[@tr("Name"), …]`
// literal at the mount.**
export component SortPillRow inherits ActionPill {
    in property <[string]> labels;
    // The bare tokens Rust's comparator matches on: a typo sorts by the default arm while the arrow
    // paints as though it worked.
    in property <[string]> fields;

    in property <string> sort-field;
    in property <string> sort-dir;

    callback request-sort(string);

    for label[i] in root.labels: HorizontalLayout {
        spacing: Theme.pad-xs;
        alignment: center;

        // Interleaved, so the row neither opens nor closes on a divider.
        if i > 0: PillDivider { }

        PillButton {
            text: label;
            reserve-sort-slot: true;
            sort-direction: root.sort-field == root.fields[i] ? root.sort-dir : "";
            active: root.sort-field == root.fields[i];
            clicked => { root.request-sort(root.fields[i]); }
        }
    }
}
