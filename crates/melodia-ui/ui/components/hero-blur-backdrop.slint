import { Theme } from "../theme.slint";

// The hero blur: a gradient floor, two cross-fading `Image` slots and a scrim, the Slint half of
// `write_crossfade_slot`'s two-slot contract. `AuroraBackdrop`'s opposite number.
//
// **Every colour is an input and the defaults are never taken**, `MetaChip`'s idiom, so one
// component serves `HeroBackdrop` and `Player.np-*` alike. A `Theme.*` brush would flip polarity
// with the variant. `width/height: 100%` on the children is mandatory: an `Image` doesn't fill its
// parent on its own.
export component HeroBlurBackdrop inherits Rectangle {
    in property <color> floor-start: #2b2135;
    in property <color> floor-end: #14101a;

    // Alpha baked in (`HeroBackdrop.scrim`).
    in property <brush> scrim: #0a0a0e73;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    // Whether the host paints a hero at all, `LibraryTabBand`'s question; the rest take the
    // default. Not an `if`: at `false` the stack drains to transparent, which an unmounted one
    // can't.
    in property <bool> shown: true;

    // **The floor eases on the slots' duration**, being the whole backdrop wherever there is no blur
    // image. Both arms are two stops at 135deg, the only pair `Brush::interpolate` blends, hence the
    // gate swapping stops rather than the brush. Rust writes these discretely, so animating is safe.
    background: root.shown
        ? @linear-gradient(135deg, root.floor-start, root.floor-end)
        : @linear-gradient(135deg, transparent, transparent);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    // **Every animated layer is read once at mount**: first evaluated after a `shown` flipped
    // before the first paint, it would land unanimated. The miniplayer's press is that flip.
    init => {
        root.background;
        slot-a.opacity;
        slot-b.opacity;
        scrim-layer.background;
    }

    slot-a := Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-a;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    slot-b := Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-b;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && !root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    // The opacity is solved per artwork and baked into the brush, a white sleeve needing about
    // twice a black one's. On the slots' duration, so a swap and its scrim land together; gated
    // with the floor, so the whole stack drains together.
    scrim-layer := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.shown ? root.scrim : transparent;
        animate background { duration: Theme.dur-med; easing: ease-in-out; }
    }
}
