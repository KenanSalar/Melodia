import { Theme } from "../theme.slint";

// Full-bleed hero blur: a gradient floor, two cross-fading `Image` slots, and a scrim. The Slint
// half of the dual-slot contract `write_crossfade_slot` drives — the outgoing slot is never cleared,
// so a refresh fades A↔B without flashing. `AuroraBackdrop`'s opposite number.
//
// **Every colour is an input and the defaults are never taken** — `MetaChip`'s idiom, and what lets
// one component serve the `HeroBackdrop` tier and Now Playing's `Player.np-*` alike. A `Theme.*`
// brush would flip polarity with the variant, painting one cover as a dark banner under one theme
// and a near-white one under another. `width/height: 100%` on the children is mandatory — an `Image`
// does not auto-fill its parent.
export component HeroBlurBackdrop inherits Rectangle {
    in property <color> floor-start: #2b2135;
    in property <color> floor-end: #14101a;

    // Alpha baked in — see `HeroBackdrop.scrim`.
    in property <brush> scrim: #0a0a0e73;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    // Whether the host is painting a hero at all — `LibraryTabBand`'s question alone, its globals
    // outliving the tab that filled them; the mosaic bands never stop and take the default. Not an
    // `if`: at `false` the stack drains to transparent, which an unmounted one cannot do. Which of
    // the two backdrops is live is a different question, and `HeroBackdropStack`'s.
    in property <bool> shown: true;

    // **The floor eases on the slots' own duration**, being the layer that *is* the backdrop whenever
    // there is no blur image: an artwork-less hero, Genre Detail's name-hashed stops, the window
    // between a hero opening and its decode landing. Both arms are two stops at 135deg, the only
    // shape `Brush::interpolate` blends stop-for-stop — hence the gate swapping *stops* rather than
    // the whole brush. Safe to `animate` where a tab-bar brush is not: Rust writes these discretely.
    background: root.shown
        ? @linear-gradient(135deg, root.floor-start, root.floor-end)
        : @linear-gradient(135deg, transparent, transparent);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-a;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-b;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && !root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    // The opacity is solved per artwork and baked into the brush, hence no `with-alpha`: a white
    // sleeve needs roughly twice what a black one does. Animated on the slots' own duration, so a
    // swap and its scrim land together instead of the scrim snapping ahead.
    //
    // **Gated with the floor**, so the whole stack drains together — ungated, the scrim is the one
    // layer still painting once the floor and both slots have gone.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.shown ? root.scrim : transparent;
        animate background { duration: Theme.dur-med; easing: ease-in-out; }
    }
}
