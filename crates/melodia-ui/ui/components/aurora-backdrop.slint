import { Theme } from "../theme.slint";

// One sweep: album colour along one edge, thinning to nothing at the far end. The headings are
// near-orthogonal, so each owns an edge and one corner shows the floor; four symmetric washes
// would average to one flat tone whatever the record. CSS-convention degrees, as Slint takes them.
//
// **The far stop is this tint at zero alpha, never `transparent`**: FemtoVG interpolates straight
// RGBA, so a fade to rgba(0,0,0,0) darkens the ramp instead of thinning it.
//
// **Both stops sit at the extents, which keeps FemtoVG on its two-stop path.** Inset either and
// every sweep synthesizes a gradient texture, growing the driver's pool by a slab it never gives
// back (`slint-pitfalls.md`).
component AuroraSweep inherits Rectangle {
    in property <color> tint;
    in property <angle> heading;
    in property <bool> shown: true;

    // `transparentize` multiplies, so a synthesized wash keeps the weight `ui::aurora` gave it. Both
    // arms are one gradient shape, the only pair `Brush::interpolate` blends. Rust writes the tint
    // discretely, so nothing restarts the ease.
    background: root.shown
        ? @linear-gradient(root.heading, root.tint.transparentize(0.45) 0%, root.tint.transparentize(1.0) 100%)
        : @linear-gradient(root.heading, root.tint.transparentize(1.0) 0%, root.tint.transparentize(1.0) 100%);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    // Read once at mount, so the first flip has something to ease from (`slint-pitfalls.md`'s
    // `init` entry).
    init => {
        root.background;
    }
}

// Three sweeps of album colour over the theme's base, and a grain of noise. Nothing caps the
// washes, so a surface keeps the record's value structure; `ui::aurora` argues the trade.
//
// **Every colour is an input and the defaults are never taken**, `MetaChip`'s idiom, so the file
// imports no global. `base-start`/`base-end` carry `Theme.base` on this arm and stay two because
// the blur solves a real ramp into the same pair.
export component AuroraBackdrop inherits Rectangle {
    in property <color> base-start: #2b2135;
    in property <color> base-end: #14101a;
    in property <color> tint-1: #3a2d4a;
    in property <color> tint-2: #2d3a4a;
    in property <color> tint-3: #4a2d3a;

    // `ui::aurora::dither_tile`'s. Unset, it draws nothing and the gradients go undithered.
    in property <image> dither;

    // `HeroBlurBackdrop.shown`'s twin, drained rather than unmounted. **A discrete bool**: a float
    // would restart every binding below per frame.
    in property <bool> shown: true;

    clip: true;

    background: root.shown
        ? @linear-gradient(135deg, root.base-start, root.base-end)
        : @linear-gradient(135deg, transparent, transparent);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    // As each sweep's.
    init => {
        root.background;
    }

    // **Back to front**, so tint-1, the colour the artwork most is, lands over both others.
    AuroraSweep {
        width: 100%;
        height: 100%;
        tint: root.tint-3;
        heading: 336deg;
        shown: root.shown;
    }
    AuroraSweep {
        width: 100%;
        height: 100%;
        tint: root.tint-2;
        heading: 217deg;
        shown: root.shown;
    }
    AuroraSweep {
        width: 100%;
        height: 100%;
        tint: root.tint-1;
        heading: 127deg;
        shown: root.shown;
    }

    // **`preserve` is what makes this dither**: `fill` scales the tile into blocks, and only
    // `preserve` maps a texel to a physical pixel; `pixelated` so filtering can't average it away.
    // Its alpha lives in the tile, so there is nothing to fade and it unmounts instead.
    if root.shown: Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.dither;
        image-fit: ImageFit.preserve;
        image-rendering: ImageRendering.pixelated;
        horizontal-tiling: ImageTiling.repeat;
        vertical-tiling: ImageTiling.repeat;
    }
}
