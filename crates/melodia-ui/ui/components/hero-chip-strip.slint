import { Theme } from "../theme.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { HeroChips } from "../globals/hero-chips.slint";
import { MetaChipStrip } from "meta-chip-strip.slint";

// Where a hero mounts `MetaChipStrip`, so the wrong mount is unspellable rather than tested
// against (`ui-patterns.md`).
export component HeroChipStrip inherits MetaChipStrip {
    // How much of a morphing band's hero is on screen, multiplied into both brushes: an `opacity`
    // under 1 would cost a layer every frame.
    in property <float> fade: 1.0;

    // **The chips can land after the banner**: a tab re-entered onto an open detail morphs open on
    // held artwork while these are still behind the re-fetch. Safe to animate as a binding, Rust
    // writing the chip model discretely.
    property <float> arrive-t: root.chips.length > 0 ? 1.0 : 0.0;
    animate arrive-t {
        duration: Theme.dur-med;
        easing: ease-in-out;
    }

    chips: HeroChips.chips;
    // Two, measured: a second row fits the slack every hero's trailing spacer leaves, where a third
    // overruns the tile and pushes the action pill out of the banner. On the two heroes with a
    // subtitle, `Theme.hero-title-size` and `font-size-md` share that slack.
    max-rows: 2;
    // `chrome-text`, a label being held to 4.5:1 where `chrome` answers to 3:1. **`transparentize`,
    // never `with-alpha`**: both tiers carry alpha on the aurora arm, which setting it would lose.
    chip-fill: HeroBackdrop.chip-fill-at(root.fade * root.arrive-t);
    chip-label-color: HeroBackdrop.chrome-text.transparentize(1.0 - root.fade * root.arrive-t);
}
