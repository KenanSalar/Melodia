// Responsive card-grid geometry, shared by every grid page; `GridColumnsSync` owns when the column
// count reaches Rust.
//
// **`avail-width` comes from the element the grid fills**, which the layout sizes independently of
// the cards, so a card sizing itself from it is not a cycle.
export component GridGeometry {
    in property <length> avail-width;
    // Columns are packed until one more would take every card below this.
    in property <length> min-card-w: 180px;
    // Between cards *and* at both outer edges, hence `cols + 1`.
    in property <length> gap: 20px;
    in property <length> card-text-h: 46px;
    // Cards on the grid's only row, or `-1` where the width answers for itself: a column a short
    // grid can't fill shrinks every card to make room for nothing.
    in property <int> lone-row-cards: -1;
    // Where an under-filled row stops growing, about where a full row's stretch tops out, so a short
    // grid draws the same card rather than a bigger one. `grid_prewarm::MAX_CARD_W` mirrors it.
    in property <length> max-card-w: 224px;

    // The chunk width Rust is handed.
    out property <int> cols:
        max(1, Math.floor((root.avail-width - root.gap) / (root.min-card-w + root.gap)));
    // Clamped to `cols` too: a resize reaches the cards a frame before Rust re-chunks.
    property <int> drawn-cols:
        root.lone-row-cards < 0 ? root.cols : max(1, min(root.cols, root.lone-row-cards));
    out property <length> card-w: max(0px, min(
        (root.avail-width - (root.drawn-cols + 1) * root.gap) / root.drawn-cols,
        root.max-card-w));
    // The artwork is square.
    out property <length> card-h: root.card-w + root.card-text-h;
    out property <length> row-h: root.card-h + root.gap;
}
