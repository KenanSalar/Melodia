// A popup's empty regions: `close-on-click-outside` fires only *outside* the popup's rect, so the
// room held for a flyout would otherwise take a click and do nothing. Declared **first**, so the
// rows over it win their own clicks; the host sizes it.
//
// **Any other button closes on its press**, so the catcher is gone with its popup by the release
// and Slint hands that release to whatever lies beneath, a right-click there raising its own menu.
// A left click closes on its release, which would otherwise land beneath as a stray click.
//
// A `Rectangle` round the area, so a mount can spell only `close-requested`: its own `clicked` or
// `pointer-event` would replace the handler carrying the close.
export component PopupDismissCatcher inherits Rectangle {
    callback close-requested();

    TouchArea {
        clicked => {
            root.close-requested();
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button != PointerEventButton.left) {
                root.close-requested();
            }
        }
    }
}
