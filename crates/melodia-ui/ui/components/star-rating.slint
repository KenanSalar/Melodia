import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// Inline 0–5 rating: five glyphs, each with its own `TouchArea` so hit-testing
// is per-star. Clicking the current top star clears the rating, the heart's
// click-again-to-toggle-off affordance.
//
// Inside a track row this must stay a *descendant* of the row's own `touch`, so
// hovering a star keeps `has-hover` true and the strip stays mounted — the
// reason the favorite and checkbox TouchAreas live there too.
export component StarRating {
    in property <int> rating;              // 0–5 (values outside are clamped by callers)
    in property <bool> enabled: true;
    in property <length> star-size: 18px;
    // The track-list treatment. Now Playing overrides them, tinting the whole
    // star / heart group with the per-artwork accent.
    in property <brush> filled-color: Theme.yellow;
    in property <brush> empty-color: Theme.subtext0;
    // Answers the pointer per star, the way the heart beside it does in Now Playing: a lit star
    // rests at `Theme.lit-rest` and comes up to full, an unlit one crosses to the lit colour.
    // Off in a track row, where the stars already sit inside the row's own hover treatment.
    in property <bool> hover-lift: false;

    callback rated(int /*new_rating*/);

    HorizontalLayout {
        spacing: 1px;
        alignment: start;

        for i in 5: Rectangle {
            property <int> idx: i + 1;
            property <bool> lit: self.idx <= root.rating;
            // Only where the star can be clicked: a lift under a dead pointer invites one.
            property <bool> lifting: root.hover-lift && root.enabled;
            width: root.star-size;
            height: root.star-size;

            // A float rather than a third brush, so nothing the host hands over can dirty it and
            // restart the colour ease below.
            property <float> level: self.lifting && self.lit && !touch.has-hover
                ? Theme.lit-rest
                : 1.0;
            animate level { duration: Theme.dur-fast; easing: ease-in-out; }

            MaterialIcon {
                name: parent.lit ? "star" : "star_border";
                icon-size: root.star-size;
                // The lit colour under the pointer whether or not the star is lit, which is the
                // heart's own hover. **The face stays keyed on the rating**, so a hovered empty
                // star previews the colour without claiming to be filled.
                icon-color: parent.lifting && touch.has-hover
                    ? root.filled-color
                    : (parent.lit ? root.filled-color : root.empty-color);
                filled: parent.lit;
                fade: parent.level;
                // Animating a brush a host hands over is safe here for `IconButton`'s reason:
                // neither host eases the pair, writing both discretely on a theme or artwork
                // change. Read `slint-pitfalls.md` before giving one of them a crossfade.
                animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
            }

            touch := TouchArea {
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    if (root.enabled) {
                        root.rated(parent.idx == root.rating ? 0 : parent.idx);
                    }
                }
            }
        }
    }
}
