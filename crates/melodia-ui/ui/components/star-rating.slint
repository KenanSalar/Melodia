import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// A 0–5 rating. Clicking the current top star clears it, the heart's toggle-off.
//
// **One `TouchArea` rather than one per star**: a click sets the whole run below the pointer, a
// question about one coordinate, and a press-drag across the strip is one gesture.
//
// In a track row it stays a *descendant* of the row's `touch`, so hovering a star keeps the row's
// `has-hover` and the strip mounted.
export component StarRating {
    in property <int> rating;              // 0–5 (values outside are clamped by callers)
    in property <bool> enabled: true;
    in property <length> star-size: 18px;
    // Now Playing tints both with the per-artwork accent.
    in property <brush> filled-color: Theme.yellow;
    in property <brush> empty-color: Theme.subtext0;
    // `IconButton`'s.
    in property <bool> on-backdrop: false;
    // Draws the rating a click would set, the run rising from `Theme.lit-rest` as the heart beside
    // it does. Off in a track row, inside the row's own hover treatment.
    in property <bool> hover-preview: false;

    callback rated(int /*new_rating*/);

    // The strip's width and the pointed star are both measured against it.
    property <length> gap: 1px;
    // A preview under a dead pointer promises an act it can't make.
    property <bool> previewing: root.hover-preview && root.enabled;
    // 1–5 under the pointer, 0 elsewhere.
    property <int> pointed: touch.has-hover
        ? clamp(Math.floor(touch.mouse-x / (root.star-size + root.gap)) + 1, 1, 5)
        : 0;
    // **The run, not the star pointed at**: a lone third star says nothing about the two a click
    // would light with it.
    property <int> shown: root.previewing && root.pointed > 0 ? root.pointed : root.rating;

    HorizontalLayout {
        alignment: start;

        Rectangle {
            width: 5 * root.star-size + 4 * root.gap;
            height: root.star-size;

            HorizontalLayout {
                spacing: root.gap;

                for i in 5: Rectangle {
                    property <bool> lit: i + 1 <= root.shown;
                    width: root.star-size;
                    height: root.star-size;

                    // A float rather than a third brush, so the host can't restart the colour ease.
                    property <float> level: root.previewing && self.lit && root.pointed == 0
                        ? Theme.lit-rest
                        : 1.0;
                    animate level { duration: Theme.dur-fast; easing: ease-in-out; }

                    MaterialIcon {
                        name: parent.lit ? "star" : "star_border";
                        icon-size: root.star-size;
                        icon-color: parent.lit ? root.filled-color : root.empty-color;
                        filled: parent.lit;
                        fade: parent.level;
                        // Safe for `IconButton`'s reason: neither host eases the pair. Read
                        // `slint-pitfalls.md` before giving one of them a crossfade.
                        animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; enabled: root.on-backdrop || !Theme.recoloring; }
                    }
                }
            }

            touch := TouchArea {
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    if (root.enabled) {
                        root.rated(root.pointed == root.rating ? 0 : root.pointed);
                    }
                }
            }
        }
    }
}
