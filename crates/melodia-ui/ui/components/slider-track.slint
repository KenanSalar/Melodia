import { Theme } from "../theme.slint";
import { SliderPointer } from "slider-pointer.slint";

// Horizontal M3 Expressive slider: two slim bars meeting at the thumb, a stadium in the parent's
// background masking the seam, and a pill thumb that narrows on press. The volume popup's slider
// turned 90°. **The mask colour must match the surface under it**, hence the input.
export component SliderTrack inherits Rectangle {
    in property <float> value;          // bound source-of-truth (0..1)
    in property <bool>  is-disabled: false;
    in property <brush> seam-mask-color: Theme.mantle;
    // The filled bar, the thumb and the max-end dot. An input because a host on an artwork backdrop
    // has a solved accent of its own, beside which the theme's would be the one foreign colour.
    in property <brush> fill-color: Theme.accent;
    in property <brush> track-color: Theme.surface1;
    // Volume's max-end dot, mirroring the vertical popup's.
    in property <bool>  show-max-stop: false;

    // Gated on movement, so a no-move grab doesn't flip the host into drag mode.
    out property <bool>  dragging: touch.dragging;
    out property <float> drag-value: touch.drag-value;    // valid only while dragging
    // So a host can gate a badge on hover without an outer TouchArea stealing the pointer.
    out property <bool>  has-hover: touch.has-hover;

    callback changed(float);
    callback committed(float);
    // Only the area tracking the hover can take the wheel and keep it.
    callback scroll-event(PointerScrollEvent) -> EventResult;

    min-height: 24px;
    background: transparent;

    private property <float> shown-value:
        root.dragging ? root.drag-value : root.value;

    private property <length> track-h: 4px;
    private property <length> thumb-h: 24px;
    private property <length> thumb-w: touch.pressed ? 2px : 4px;
    // Wider than the thumb, so the seam gap widens on each side as the thumb narrows.
    private property <length> thumb-bg-w: 12px;
    private property <length> thumb-bg-h: 24px;
    // The dot seats inside the inactive bar's rounded end.
    private property <length> stop-d: 4px;
    private property <length> stop-margin: 3px;

    private property <float>  frac: clamp(root.shown-value, 0, 1);
    private property <length> track-cy: root.height / 2;
    // Off the *rest* thumb width, not the animated one, which would pin one edge at the extremes and
    // make the press shrink lopsided. The mask hides the pixel of overflow past the ends.
    out property <length> thumb-cx: root.frac * (root.width - 4px) + 2px;
    private property <length> thumb-x: root.thumb-cx - root.thumb-w / 2;
    private property <length> active-w: root.thumb-cx;
    private property <length> inactive-w: root.width - root.thumb-cx;

    animate thumb-w { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    Rectangle {
        x: 0;
        y: root.track-cy - root.track-h / 2;
        width: root.active-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    Rectangle {
        x: root.thumb-cx;
        y: root.track-cy - root.track-h / 2;
        width: root.inactive-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.track-color;
    }

    // Under the mask, so the dot disappears behind the thumb as it reaches the end.
    if root.show-max-stop: Rectangle {
        x: root.width - root.stop-margin - root.stop-d;
        y: root.track-cy - root.stop-d / 2;
        width: root.stop-d;
        height: root.stop-d;
        border-radius: self.width / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    // The seam mask: after the bars, before the thumb.
    Rectangle {
        x: root.thumb-cx - root.thumb-bg-w / 2;
        y: root.track-cy - root.thumb-bg-h / 2;
        width: root.thumb-bg-w;
        height: root.thumb-bg-h;
        border-radius: self.width / 2;
        background: root.seam-mask-color;
    }

    Rectangle {
        // Snapped, not eased: easing off the position ticks phase-lags the source and repaints
        // everything the thumb overlaps for the length of the curve, once per tick.
        x: root.thumb-x;
        y: root.track-cy - root.thumb-h / 2;
        width: root.thumb-w;
        height: root.thumb-h;
        border-radius: self.width / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    // The mask is the grab band, being the thumb as the eye reads it.
    touch := SliderPointer {
        enabled: !root.is-disabled;
        thumb-center: root.thumb-cx;
        grab-half: root.thumb-bg-w / 2;
        changed(v) => { root.changed(v); }
        committed(v) => { root.committed(v); }
        scroll-event(event) => { return root.scroll-event(event); }
    }
}
