import { Theme } from "../theme.slint";
import { SliderPointer } from "slider-pointer.slint";

// Horizontal M3 Expressive slider — twin slim bars meeting at the thumb, a parent-background
// stadium masking the seam, and a vertical-pill thumb that shrinks along the value axis on press.
// `volume-popup`'s slider rotated 90°. The mask colour MUST match the parent surface, hence the
// property: volume's is `Theme.crust` only because its `PopupSurface` paints crust, where the
// now-playing bar paints `mantle` / `mantle-unfocused`.
export component SliderTrack inherits Rectangle {
    in property <float> value;          // bound source-of-truth (0..1)
    in property <bool>  is-disabled: false;
    in property <brush> seam-mask-color: Theme.mantle;
    // The filled bar, the thumb and the max-end dot, which are one colour. Taken as inputs for the
    // seam mask's reason one line up: a host painting on an artwork backdrop has a solved accent of
    // its own, and the theme's would be the only foreign colour on that surface.
    in property <brush> fill-color: Theme.accent;
    in property <brush> track-color: Theme.surface1;
    // Volume's max-end dot, mirroring the vertical popup's top-end one.
    in property <bool>  show-max-stop: false;

    // Gated on movement, so a no-move grab inside the mask doesn't flip the
    // visuals and the time text into drag mode.
    out property <bool>  dragging: touch.dragging;
    out property <float> drag-value: touch.drag-value;    // valid only while dragging
    // So a host can gate a floating badge on hover without wrapping this in an
    // outer TouchArea, which would steal the pointer events.
    out property <bool>  has-hover: touch.has-hover;

    callback changed(float);
    callback committed(float);
    // The pointer's own, for `IconButton`'s reason: only the area tracking the hover can take the
    // wheel and keep it.
    callback scroll-event(PointerScrollEvent) -> EventResult;

    // Tall enough to host the 24 px vertical thumb without clipping.
    min-height: 24px;
    background: transparent;

    private property <float> shown-value:
        root.dragging ? root.drag-value : root.value;

    private property <length> track-h: 4px;
    private property <length> thumb-h: 24px;
    // M3 Expressive: press shrinks the thumb along the value axis.
    private property <length> thumb-w: touch.pressed ? 2px : 4px;
    // Wider than the thumb, so the seam gap visibly widens on each side as the
    // thumb shrinks under press — the active track absorbs the freed pixels.
    private property <length> thumb-bg-w: 12px;
    private property <length> thumb-bg-h: 24px;
    // The dot seats inside the inactive bar's rounded end. `stop-margin` is the
    // vertical popup's far-edge gap expressed as a margin from the right edge
    // rather than as a coordinate.
    private property <length> stop-d: 4px;
    private property <length> stop-margin: 3px;

    private property <float>  frac: clamp(root.shown-value, 0, 1);
    private property <length> track-cy: root.height / 2;
    // Centred against the *rest* thumb width, not the live animated one: a
    // width-dependent term pins one edge at the extremes, so at frac=0 only the
    // right edge moves inward under press and the shrink reads as lopsided. The
    // 12 px mask hides the 1 px of overflow past the track ends. `out` so a host
    // can pin a badge to the thumb without re-deriving this.
    out property <length> thumb-cx: root.frac * (root.width - 4px) + 2px;
    private property <length> thumb-x: root.thumb-cx - root.thumb-w / 2;
    private property <length> active-w: root.thumb-cx;
    private property <length> inactive-w: root.width - root.thumb-cx;

    animate thumb-w { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    // Active bar — masked at the seam end so it reads as one bar under the thumb.
    Rectangle {
        x: 0;
        y: root.track-cy - root.track-h / 2;
        width: root.active-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    Rectangle {
        x: root.thumb-cx;
        y: root.track-cy - root.track-h / 2;
        width: root.inactive-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.track-color;
    }

    // Never faded — the mask paints after it, so the dot simply disappears
    // behind the thumb as it reaches the end.
    if root.show-max-stop: Rectangle {
        x: root.width - root.stop-margin - root.stop-d;
        y: root.track-cy - root.stop-d / 2;
        width: root.stop-d;
        height: root.stop-d;
        border-radius: self.width / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    // Parent-background stadium hiding the bar seam — after the bars, before
    // the thumb.
    Rectangle {
        x: root.thumb-cx - root.thumb-bg-w / 2;
        y: root.track-cy - root.thumb-bg-h / 2;
        width: root.thumb-bg-w;
        height: root.thumb-bg-h;
        border-radius: self.width / 2;
        background: root.seam-mask-color;
    }

    // On top of the mask, so the seam-cover itself stays invisible.
    Rectangle {
        // Snapped, not eased: easing a binding off the position ticks phase-lags
        // the source, and repaints the thumb plus everything it overlaps for the
        // length of the curve, once per tick.
        x: root.thumb-x;
        y: root.track-cy - root.thumb-h / 2;
        width: root.thumb-w;
        height: root.thumb-h;
        border-radius: self.width / 2;
        background: root.is-disabled ? Theme.overlay0 : root.fill-color;
    }

    // The mask region is the grab band, being the thumb as the eye reads it.
    touch := SliderPointer {
        enabled: !root.is-disabled;
        thumb-center: root.thumb-cx;
        grab-half: root.thumb-bg-w / 2;
        changed(v) => { root.changed(v); }
        committed(v) => { root.committed(v); }
        scroll-event(event) => { return root.scroll-event(event); }
    }
}
