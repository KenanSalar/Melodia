import { Theme } from "../theme.slint";
import { PopupHighlight } from "../globals/shell.slint";
import { PillButton } from "action-pill.slint";
import { MaterialIcon } from "material-icon.slint";
import { PopupSurface } from "popup-surface.slint";
import { FocusLossWatcher } from "focus-loss-watcher.slint";

// One field row inside the sort popup. Unexported: useful nowhere else.
//
// `direction` carries active-ness as well as the arrow, the way `PillButton.sort-direction` does.
// An empty string is "not the sorted field", so the two can't be set to disagree.
component SortMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> direction;

    callback clicked();

    property <bool> active: root.direction != "";

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: root.active ? Theme.accent : Theme.text;
                font-size: Theme.font-size-md;
                overflow: elide;
            }
        }

        // Always rendered, transparent off the sorted field, so a pick shifts no row. Never an
        // arrow concatenated into the label: a glyph Vazirmatn lacks pulls a fallback font whose
        // line box pushes the patched glyphs off centre.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            MaterialIcon {
                name: root.direction == "asc" ? "arrow_drop_up" : "arrow_drop_down";
                icon-size: 16px;
                icon-color: root.active ? Theme.accent : transparent;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        // A pick doesn't close the popup, so restore the trigger highlight the winit Release
        // filter just cleared.
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up
                || ev.kind == PointerEventKind.cancel) {
                PopupHighlight.id = "sort";
            }
        }
        clicked => { root.clicked(); }
    }
}

// A labelled pill opening a PopupWindow of sort fields: `ColumnTogglePopup`'s shape, for the
// orders a view can take rather than the columns it can show.
//
// **`SortPillRow`'s inputs verbatim**, so the two are interchangeable at a mount and the parallel
// arrays are one contract rather than two. Which of them a page wants is a question about how much
// room its band has, not about its sort.
//
// **A pick leaves the popup open**, because clicking the sorted field again is how the direction
// flips and reopening for that would cost the second half of the gesture two extra clicks.
export component SortMenuPopup inherits Rectangle {
    // Keep this an inline `[@tr("Name"), …]` literal at the mount: `@tr` folds msgids at codegen,
    // so a Rust-seeded array renders untranslated.
    in property <[string]> labels;
    // Parallel to `labels`. These are the bare tokens Rust's comparator matches on, so a typo here
    // sorts by the default arm while the arrow paints as though it worked.
    in property <[string]> fields;

    in property <string> sort-field;
    in property <string> sort-dir;

    callback request-sort(string /*field*/);

    // Fixed to the pill row's height so the popup anchors below the chip's bottom edge whatever
    // the inner button's alignment.
    width: btn.width;
    height: 32px;

    // The label carries the meaning, so there's no tooltip repeating it.
    btn := PillButton {
        icon: "sort";
        text: @tr("Sort");
        // Held while the popup is open, and cleared by the AppWindow scrim catching an outside
        // click; the rows inside never close it.
        force-bg: PopupHighlight.id == "sort";
        clicked => { PopupHighlight.id = "sort"; pop.show(); }
    }

    pop := PopupWindow {
        // Hangs below, the trigger sitting in the band's header strip. Slint's `place_popup`
        // clamps a popup's right edge to the window clip region, so a negative-x offset on a
        // page-edge trigger just claims space the clamp takes back. The wrapper layout below
        // reserves transparent margin *inside* the popup instead, and the visible chrome stops
        // short of the edge even when the bounding box is clamped flush.
        x: btn.width - self.width;
        // Off the outer's bottom, not the button's, so the gap holds whatever the inner
        // positioning does.
        y: root.height + 8px;
        close-policy: close-on-click-outside;

        // Live only while this is the open popup: the trigger claims `PopupHighlight.id` before
        // `show()`, so focus loss costs one watcher rather than one per popup host in the tree.
        if PopupHighlight.id == "sort": FocusLossWatcher {
            close => { pop.close(); PopupHighlight.id = ""; }
        }

        HorizontalLayout {
            padding-right: Theme.pad-lg;
            alignment: start;

            PopupSurface {
                VerticalLayout {
                    padding: Theme.pad-xs;
                    spacing: 0;

                    for label[i] in root.labels: SortMenuRow {
                        label: label;
                        direction: root.sort-field == root.fields[i] ? root.sort-dir : "";
                        clicked => { root.request-sort(root.fields[i]); }
                    }
                }
            }
        }
    }
}
