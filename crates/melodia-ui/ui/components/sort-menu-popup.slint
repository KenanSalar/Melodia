import { Theme } from "../theme.slint";
import { PillButton } from "action-pill.slint";
import { MaterialIcon } from "material-icon.slint";
import { PopupSurface } from "popup-surface.slint";
import { FocusLossWatcher } from "focus-loss-watcher.slint";

// `direction` carries whether the row is the sorted field as well as the arrow, as
// `PillButton.sort-direction` does, so the two can't disagree.
component SortMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> direction;

    callback clicked();

    property <bool> active: root.direction != "";

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        cross-axis-alignment: center;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.font-size-md;
            overflow: elide;
        }

        // Always rendered, so a pick shifts no row; never an arrow in the label (`PillButton`).
        MaterialIcon {
            horizontal-stretch: 0;
            name: root.direction == "asc" ? "arrow_drop_up" : "arrow_drop_down";
            icon-size: 16px;
            icon-color: root.active ? Theme.accent : transparent;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A labelled pill opening a popup of sort fields, taking **`SortPillRow`'s inputs verbatim** so the
// two swap at a mount: which a page wants depends on how much room its band has.
//
// **A pick leaves the popup open**: clicking the sorted field again is how the direction flips.
export component SortMenuPopup inherits Rectangle {
    // An inline `[@tr("Name"), …]` literal at the mount, a Rust-seeded array rendering untranslated.
    in property <[string]> labels;
    // The bare tokens Rust's comparator matches on: a typo sorts by the default arm while the arrow
    // paints as though it worked.
    in property <[string]> fields;

    in property <string> sort-field;
    in property <string> sort-dir;

    callback request-sort(string /*field*/);

    // The pill row's height, so the popup anchors below the chip whatever the button's alignment.
    width: btn.width;
    height: 32px;

    // The label carries the meaning, so no tooltip repeats it.
    btn := PillButton {
        icon: "sort";
        text: @tr("Sort");
        force-bg: pop.is-open;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        // `place_popup` clamps the right edge to the window, so a negative offset on a page-edge
        // trigger claims room the clamp takes back. The margin is reserved *inside* the popup
        // instead, so the chrome stops short of the edge even when the box is clamped flush.
        x: btn.width - self.width;
        y: root.height + Theme.popup-gap;
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { pop.close(); }
        }

        HorizontalLayout {
            padding-right: Theme.pad-lg;
            alignment: start;

            PopupSurface {
                VerticalLayout {
                    padding: Theme.pad-xs;
                    spacing: 0;

                    for label[i] in root.labels: SortMenuRow {
                        label: label;
                        direction: root.sort-field == root.fields[i] ? root.sort-dir : "";
                        clicked => { root.request-sort(root.fields[i]); }
                    }
                }
            }
        }
    }
}
