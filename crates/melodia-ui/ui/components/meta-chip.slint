import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// One metadata chip, a codec under the Now Playing cover or a count on a hero band. Decorative:
// `FilledChip` is the interactive pill, kept apart because one states a fact and the other
// configures something.
//
// Both brushes are inputs, so one chip sits on a blurred cover *and* a blurred banner, each solved
// per artwork. No mount takes the defaults; they keep this file free of `Player` and
// `HeroBackdrop` imports.
export component MetaChip inherits Rectangle {
    in property <string> text;
    in property <brush> fill: Theme.surface1;
    in property <brush> label-color: Theme.text;
    in property <string> icon;
    in property <brush> icon-color: root.label-color;

    height: Theme.meta-chip-h;
    border-radius: self.height / 2;
    background: root.fill;

    HorizontalLayout {
        // The glyph's own side bearing already reads as padding.
        padding-left: root.icon != "" ? Theme.pad-sm : Theme.pad-md;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-xs;

        if root.icon != "": VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 14px;
                icon-color: root.icon-color;
            }
        }
        Text {
            text: root.text;
            color: root.label-color;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            // **About ink, not elision**: a chip sizes to its label, but the default `clip` cuts a
            // `Text` at its line box, and these labels carry names whose marks leave it.
            overflow: elide;
        }
    }
}
