import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";

// How a popup stays inside the shell, Slint drawing an oversized one past the window's edge:
// raised at a point it slides along (`fit-y`), and hanging off a control it opens on the side with
// room (`opens-above`, `side-h`). Its `PopupColumn` scrolls the rest.
export global PopupFit {
    // Round a popup column's rows.
    out property <length> column-inset: Theme.pad-xs;
    // The bar's slot, inset from the border as the rows are. Here rather than on the column, for a
    // host reserving it before its column mounts.
    out property <length> scroll-gutter: Theme.scrollbar-slot + root.column-inset;
    // The tallest a popup can be and still sit inside the shell.
    out property <length> max-h: WindowChrome.shell-height - 2 * WindowChrome.edge-clearance;

    // The popup's `y` in the host's frame, slid only as far as keeps `popup-h` inside the shell.
    pure public function fit-y(anchor-y: length, anchor-window-y: length, popup-h: length) -> length {
        return anchor-y - anchor-window-y + clamp(anchor-window-y, WindowChrome.edge-clearance,
            WindowChrome.shell-height - WindowChrome.edge-clearance - popup-h);
    }

    pure public function room-below(window-y: length) -> length {
        return WindowChrome.shell-height - WindowChrome.edge-clearance - window-y;
    }

    pure public function room-above(window-y: length) -> length {
        return window-y - WindowChrome.edge-clearance;
    }

    // `below-y` is where a popup below the control would start and `above-y` where one above would
    // end. Below unless it doesn't fit and above has more room, so a short window never puts a
    // popup over the control that opened it.
    pure public function opens-above(above-y: length, below-y: length, popup-h: length) -> bool {
        return root.room-below(below-y) < popup-h
            && root.room-above(above-y) > root.room-below(below-y);
    }

    // `popup-h` cut to the room on the side it opens.
    pure public function side-h(above-y: length, below-y: length, popup-h: length) -> length {
        return min(popup-h, root.opens-above(above-y, below-y, popup-h)
            ? root.room-above(above-y)
            : root.room-below(below-y));
    }
}
