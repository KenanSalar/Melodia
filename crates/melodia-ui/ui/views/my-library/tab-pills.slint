import { MyLibrary } from "../../globals/my-library.slint";
import { Tracks } from "../../globals/tracks.slint";
import { AlbumDetail, Albums } from "../../globals/albums.slint";
import { ArtistDetail, Artists } from "../../globals/artists.slint";
import { GenreDetail, Genres } from "../../globals/genres.slint";
import { PlaylistDetail, Playlists } from "../../globals/playlists.slint";
import { SmartEditor } from "../../globals/dialog-forms.slint";
import { Dialog } from "../../globals/dialog.slint";
import { CardSelection } from "../../globals/card-selection.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../../components/action-pill.slint";
import { MenuItem } from "../../components/context-menu.slint";
import { PillOverflowMenu } from "../../components/pill-overflow-menu.slint";
import { SelectionPills } from "../../components/selection-pills.slint";
import { SortPillRow } from "../../components/sort-pill-row.slint";
import { ColumnTogglePopup } from "../../components/track-list/column-toggle-popup.slint";

// The per-tab and per-detail action pills, handed to `LibraryTabBand` as its whole `@children`.
// Nine mutually exclusive rows matching the sheet's nine body branches — the four detail predicates
// arrive as `in` properties rather than being re-derived, since spelled twice the pills and the
// body could disagree about which branch is up.
//
// **A component rather than rows written into the mount sheet, and the Playlists row is the
// reason**: its pills carry `tooltip-overlay: true`, so the pill is drawn by a frame the host
// declares *after* the scroll body. That frame reaches the pills by id, and an id declared inside
// an `if` can't be read from outside it — so the ids live at a root the host can see and this file
// publishes their rect. One component holds all five rows: the band's slot spaces its cells, so a
// second always-mounted child would offset every other tab's row from the band's right edge.
export component MyLibraryTabPills inherits Rectangle {
    // Which of the sheet's nine branches is mounted. See the file header.
    in property <bool> album-open;
    in property <bool> artist-open;
    in property <bool> genre-open;
    in property <bool> playlist-open;

    HorizontalLayout {
        alignment: end;
        // No spacing. The rows are mutually exclusive, and the Playlists slot below is a
        // real cell even while collapsed, so any gap here would show up as a permanent
        // inset on the other four tabs.
        spacing: 0px;

        // --- Songs: the selection chip, then the column toggle ----------------
        //
        // The chip leads so its group reads to the left of the toggle.
        if MyLibrary.tab-idx == MyLibrary.tab-songs: ActionPill {
            if Tracks.selected-ids.length > 0: SelectionPills {
                count: Tracks.selected-ids.length;
                divider-trails: true;
                cleared => {
                    Tracks.clear-selection();
                    MyLibrary.blur-search-tick += 1;
                }
            }
            ColumnTogglePopup {
                columns <=> Tracks.track-columns;
                toggled(id) => { Tracks.toggle-column(id); }
            }
        }

        // --- Albums / Artists / Genres: one sort row each ---------------------
        //
        // The active field carries the direction arrow. Clicking it flips the direction
        // and a new field starts ascending — both Rust's, through the shared `next_sort`.
        // Each is gated **off** its detail as well as on its tab: a sort row over an open
        // album sorts a grid nobody can see.
        //
        // `labels` stays an inline literal at each mount — `@tr` folds msgids at codegen,
        // so a Rust-seeded array renders untranslated — and `fields` is the parallel list
        // of tokens the comparator matches on.
        if MyLibrary.tab-idx == MyLibrary.tab-albums && !root.album-open: SortPillRow {
            labels: [@tr("Name"), @tr("Year"), @tr("Artist")];
            fields: ["name", "year", "artist"];
            sort-field: Albums.sort-field;
            sort-dir: Albums.sort-dir;
            request-sort(f) => { Albums.request-sort(f); }
            // The card selection, in the sort row's trailing slot. The scope literal is the
            // grid's own and `ui::callbacks::card_selection::scope` holds the matching const.
            if CardSelection.count-in("albums") > 0: SelectionPills {
                count: CardSelection.count-in("albums");
                cleared => { CardSelection.clear(); }
            }
        }

        if MyLibrary.tab-idx == MyLibrary.tab-artists && !root.artist-open: SortPillRow {
            labels: [@tr("Name"), @tr("Tracks"), @tr("Albums")];
            fields: ["name", "track_count", "album_count"];
            sort-field: Artists.sort-field;
            sort-dir: Artists.sort-dir;
            request-sort(f) => { Artists.request-sort(f); }
            if CardSelection.count-in("artists") > 0: SelectionPills {
                count: CardSelection.count-in("artists");
                cleared => { CardSelection.clear(); }
            }
        }

        if MyLibrary.tab-idx == MyLibrary.tab-genres && !root.genre-open: SortPillRow {
            labels: [@tr("Name"), @tr("Tracks"), @tr("Duration")];
            fields: ["name", "track_count", "duration"];
            sort-field: Genres.sort-field;
            sort-dir: Genres.sort-dir;
            request-sort(f) => { Genres.request-sort(f); }
            if CardSelection.count-in("genres") > 0: SelectionPills {
                count: CardSelection.count-in("genres");
                cleared => { CardSelection.clear(); }
            }
        }

        // --- The four details ------------------------------------------------
        //
        // Each is the row that used to sit at the foot of that view's `DetailHeader`,
        // unchanged: one pill holding Shuffle, whatever is particular to the entity, the
        // column toggle with its own column locked off, then the selection slots. **The
        // tooltips stay in-tree** — `Tooltip`'s default side is `above` and the band's
        // slot rides its lower edge, so the pill lands inside the band, painted after
        // everything the band owns and before the body. Only the Playlists row below needs
        // the published-anchor treatment, and it needs it for a reason of its own.
        if root.album-open: ActionPill {
            PillButton {
                icon: "shuffle";
                text: @tr("Shuffle");
                clicked => { AlbumDetail.shuffle-album(); }
            }
            PillDivider { }
            ColumnTogglePopup {
                columns <=> AlbumDetail.track-columns;
                // Meaningless here: every row is the same album.
                hide-album: true;
                toggled(id) => { AlbumDetail.toggle-column(id); }
            }
            if AlbumDetail.selected-ids.length > 0: SelectionPills {
                count: AlbumDetail.selected-ids.length;
                cleared => { AlbumDetail.clear-selection(); }
            }
        }

        if root.artist-open: ActionPill {
            PillButton {
                icon: "shuffle";
                text: @tr("Shuffle");
                clicked => { ArtistDetail.shuffle-artist(); }
            }
            PillDivider { }
            ColumnTogglePopup {
                columns <=> ArtistDetail.track-columns;
                // Meaningless here: every row is the same artist.
                hide-artist: true;
                toggled(id) => { ArtistDetail.toggle-column(id); }
            }
            if ArtistDetail.selected-ids.length > 0: SelectionPills {
                count: ArtistDetail.selected-ids.length;
                cleared => { ArtistDetail.clear-selection(); }
            }
        }

        if root.genre-open: ActionPill {
            PillButton {
                icon: "shuffle";
                text: @tr("Shuffle");
                clicked => { GenreDetail.shuffle-genre(); }
            }
            PillDivider { }
            ColumnTogglePopup {
                columns <=> GenreDetail.track-columns;
                // Meaningless here: every row is the same genre.
                hide-genre: true;
                toggled(id) => { GenreDetail.toggle-column(id); }
            }
            if GenreDetail.selected-ids.length > 0: SelectionPills {
                count: GenreDetail.selected-ids.length;
                cleared => { GenreDetail.clear-selection(); }
            }
        }

        if root.playlist-open: ActionPill {
            PillButton {
                icon: "shuffle";
                text: @tr("Shuffle");
                clicked => { PlaylistDetail.shuffle-all(); }
            }
            PillDivider { }
            // Rust-side because the picker needs the playlist's track artworks first. It
            // fills Dialog from a fresh event-loop tick, so the property-recursion guard
            // doesn't trip.
            PillButton {
                icon: "image";
                tooltip-text: @tr("Edit artwork");
                clicked => { PlaylistDetail.request-edit-artwork(); }
            }
            PillDivider { }
            // Rename / Delete fill Dialog inline — everything they need is already on
            // `PlaylistDetail`, so no Rust hop and no recursion risk.
            PillButton {
                icon: "edit";
                tooltip-text: @tr("Rename");
                clicked => {
                    Dialog.open-rename-playlist(
                        PlaylistDetail.playlist-id,
                        PlaylistDetail.playlist.name,
                        PlaylistDetail.playlist.description,
                    );
                }
            }
            // Chrome inline so `@tr` applies; Rust loads the criteria and opens the editor
            // from a fresh tick.
            if PlaylistDetail.playlist.is_smart: PillDivider { }
            if PlaylistDetail.playlist.is_smart: PillButton {
                icon: "tune";
                tooltip-text: @tr("Edit rules");
                clicked => {
                    Dialog.title = @tr("Edit Rules");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Save");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.kind = "smart-playlist-editor";
                    Dialog.target-id = PlaylistDetail.playlist-id;
                    SmartEditor.request-edit(PlaylistDetail.playlist-id);
                }
            }
            PillDivider { }
            PillButton {
                icon: "delete";
                danger: true;
                tooltip-text: @tr("Delete playlist");
                clicked => {
                    Dialog.open-delete-playlist(PlaylistDetail.playlist-id);
                }
            }
            PillDivider { }
            ColumnTogglePopup {
                columns <=> PlaylistDetail.track-columns;
                toggled(id) => { PlaylistDetail.toggle-column(id); }
            }
            // Selection slots — appended when multi-select is active.
            if PlaylistDetail.selected-ids.length > 0: PillDivider { }
            if PlaylistDetail.selected-ids.length > 0: PillLabel {
                text: @tr("{} selected", PlaylistDetail.selected-ids.length);
            }
            // A smart playlist's membership is derived — nothing to remove from.
            if PlaylistDetail.selected-ids.length > 0
                && !PlaylistDetail.playlist.is_smart: PillButton {
                icon: "playlist_remove";
                // Lighter glyph than its siblings — 16 px puts it back on the same
                // optical row as their 14 px default.
                icon-size: 16px;
                danger: true;
                tooltip-text: @tr("Remove from playlist");
                clicked => {
                    // Confirm even for one row — a stray click on the destructive chip
                    // must not drop tracks silently.
                    Dialog.title = @tr("Remove from playlist?");
                    Dialog.message = @tr(
                        "Remove {n} track from the playlist?"
                            | "Remove {n} tracks from the playlist?"
                            % PlaylistDetail.selected-ids.length
                    );
                    Dialog.confirm-label = @tr("Remove");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = true;
                    Dialog.kind = "remove-playlist-selected";
                    Dialog.target-id = -1;
                    Dialog.open = true;
                }
            }
            if PlaylistDetail.selected-ids.length > 0: PillDivider { }
            if PlaylistDetail.selected-ids.length > 0: PillButton {
                icon: "close";
                tooltip-text: @tr("Clear selection");
                clicked => { PlaylistDetail.clear-selection(); }
            }
        }

        // --- Playlists: collapsed, never unmounted ----------------------------
        //
        // The one row that can't sit under an `if`, per the file header. It collapses to
        // a zero-width clipped cell instead: nothing paints, and `Clip` swallows every
        // event outside its empty rect, so the pills are as unreachable as an unmounted
        // branch while their ids stay readable from this root. The three width
        // constraints are spelled out because an explicit `min-width` is what *replaces*
        // the constraint the pill's own bound width would otherwise merge in.
        Rectangle {
            clip: true;
            min-width: 0px;
            preferred-width: MyLibrary.tab-idx == MyLibrary.tab-playlists
                && !root.playlist-open ? pl.preferred-width : 0px;
            max-width: MyLibrary.tab-idx == MyLibrary.tab-playlists
                && !root.playlist-open ? pl.preferred-width : 0px;

            pl := ActionPill {
                // Fills the Dialog inline rather than hopping through Rust: a synchronous
                // `set_open(true)` mid-click-handler trips Slint's recursion guard.
                np := PillButton {
                    icon: "add";
                    text: @tr("New Playlist");
                    tooltip-text: @tr("Create an empty playlist");
                    // Drawn by the host's top-layer frame, out of the grid's way.
                    tooltip-overlay: true;
                    clicked => { Dialog.open-create-playlist([]); }
                }

                PillDivider { }

                // Chrome inline so `@tr` applies; Rust resets the editor state and opens
                // from a fresh tick, the same hop as Export.
                sp := PillButton {
                    icon: "auto_awesome";
                    icon-filled: true;
                    text: @tr("New Smart Playlist");
                    tooltip-text: @tr("Create a playlist from rules");
                    tooltip-overlay: true;
                    clicked => {
                        Dialog.title = @tr("New Smart Playlist");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Create");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = "smart-playlist-editor";
                        Dialog.target-id = -1;
                        SmartEditor.request-new();
                    }
                }

                PillDivider { }

                // **Import and Export fold in here rather than carrying a pill each.** Four
                // labelled pills plus the selection group overran the band; these two are the
                // rarest of the four, so they are what gives up its width. Both are still pure
                // Rust flows over native rfd dialogs, and their bodies are unchanged.
                om := PillOverflowMenu {
                    menu-id: "playlists-overflow";
                    tooltip-text: @tr("More playlist actions");
                    tooltip-overlay: true;

                    MenuItem {
                        label: @tr("Import");
                        icon: "download";
                        clicked => { Playlists.import-playlists(); }
                    }
                    MenuItem {
                        label: @tr("Export");
                        icon: "upload";
                        clicked => {
                            // Chrome inline so `@tr` applies; Rust fills the rows and opens
                            // from a fresh tick.
                            Dialog.title = @tr("Export Playlists");
                            Dialog.message = @tr("Choose playlists to export.");
                            Dialog.confirm-label = @tr("Export");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "export-playlists";
                            Playlists.request-export-playlists();
                        }
                    }
                }

                if CardSelection.count-in("playlists") > 0: SelectionPills {
                    count: CardSelection.count-in("playlists");
                    cleared => { CardSelection.clear(); }
                }
            }
        }
    }

    // --- The Playlists pills' tooltip anchor ---------------------------------
    //
    // Published, never drawn: see the file header. The window rect comes off the hovered
    // pill live rather than being snapshotted on the hover edge, so a pill that moves
    // under a parked pointer — a resize, Ctrl+B — keeps its tooltip anchored.
    property <length> px: np.hovered ? np.absolute-position.x
        : sp.hovered ? sp.absolute-position.x
        : om.hovered ? om.absolute-position.x
        : 0px;
    property <length> py: np.hovered ? np.absolute-position.y
        : sp.hovered ? sp.absolute-position.y
        : om.hovered ? om.absolute-position.y
        : 0px;

    out property <length> tip-x: root.px - root.absolute-position.x;
    out property <length> tip-y: root.py - root.absolute-position.y;
    out property <length> tip-w: np.hovered ? np.width
        : sp.hovered ? sp.width
        : om.hovered ? om.width
        : 0px;
    out property <length> tip-h: np.hovered ? np.height
        : sp.hovered ? sp.height
        : om.hovered ? om.height
        : 0px;
    out property <string> tip-label: np.hovered ? np.tooltip-text
        : sp.hovered ? sp.tooltip-text
        : om.hovered ? om.tooltip-text
        : "";
    out property <bool> tip-visible: np.hovered || sp.hovered || om.hovered;
}
