import { GenreDetail } from "../../globals/genres.slint";
import { MyLibrary } from "../../globals/my-library.slint";
import { Player } from "../../globals/player.slint";
import { TrackList } from "../../components/track-list/track-list.slint";
import { TrackListScrollbars } from "../../components/track-list-scrollbars.slint";

// Album Detail's shape over the genre's tracks, the hero's gradient being the mount sheet's.
export component GenreDetailBody inherits Rectangle {
    TouchArea {
        clicked => { MyLibrary.blur-search-tick += 1; }
    }

    // Full-bleed, on Album Detail's argument.
    tl := TrackList {
        width: 100%;
        height: 100%;

        rows: GenreDetail.tracks;
        columns <=> GenreDetail.track-columns;

        sort-field: GenreDetail.sort-field;
        sort-dir: GenreDetail.sort-dir;
        playing-track-id: Player.vm.track.id;
        view-context: "genre-detail";
        view-selected-ids: GenreDetail.selected-ids;

        request-sort(f) => { GenreDetail.request-sort(f); }
        play-row(id, idx) => { GenreDetail.play-row(id, idx); }
        play-next(ids) => { GenreDetail.play-next(ids); }
        add-to-queue(ids) => { GenreDetail.add-to-queue(ids); }
        toggle-row-favorite(ids, on) => { GenreDetail.toggle-row-favorite(ids, on); }
        set-row-rating(ids, n) => { GenreDetail.set-row-rating(ids, n); }
        select-row(idx, id, sh, ct) => { GenreDetail.select-row(idx, id, sh, ct); }
        select-all => { GenreDetail.select-all(); }
        clear-selection => { GenreDetail.clear-selection(); }
        request-blur-search => { MyLibrary.blur-search-tick += 1; }
    }

    TrackListScrollbars {
        x: 0; y: 0; width: 100%; height: 100%;
        list-y: tl.absolute-position.y - root.absolute-position.y;
        body-y: tl.body-y;
        body-height: tl.body-height;
        v-visible-height: tl.v-visible-height;
        v-viewport-height: tl.v-viewport-height;
        v-offset: tl.v-offset;
        set-v-offset(o) => { tl.set-v-offset(o); }
    }
}
