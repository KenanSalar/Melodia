import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ArtistDetail } from "../../globals/artists.slint";
import { MyLibrary } from "../../globals/my-library.slint";
import { Player } from "../../globals/player.slint";
import { CompositeScroll } from "../../globals/shell.slint";
import { EntityCard } from "../../components/grid/entity-card.slint";
import { TrackList } from "../../components/track-list/track-list.slint";
import { CompositeScrollbars } from "../../components/composite-scrollbars.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { CollapsibleSectionHeader } from "../../components/collapsible-section-header.slint";

// `AlbumDetailBody` with an optional Albums strip above the list, whose card click hands off to
// the Albums tab. Insets are per child: `below-hero` is the region `CompositeScrollbars` measures
// and the hover sentinel covers, so it runs full-bleed.
export component ArtistDetailBody inherits Rectangle {
    // Smaller than the grid's, so several albums fit without dominating the page.
    property <length> album-card-w: 140px;
    property <length> album-card-h: 184px;
    // The strip's scrollbar band, reserved below the cards as `HorizontalCardStrip` does.
    property <length> albums-bar-h: 8px;

    // A composite view (`slint-pitfalls.md`): one outer `ScrollView` over the strip and the list,
    // the list capped at the outer viewport so its `ListView` keeps virtualizing.
    below-hero := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        // The `CompositeScroll` hover sentinel. It fills the body, so it also takes the
        // empty-space clicks that give the band's box up.
        hover-catch := TouchArea {
            width: 100%;
            height: 100%;
            changed has-hover => { CompositeScroll.hovered = self.has-hover; }
            clicked => { MyLibrary.blur-search-tick += 1; }

            below-sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy:   always-off;
                content-width: self.width;

                VerticalLayout {
                    spacing: 0;

                    if ArtistDetail.albums.length > 0: VerticalLayout {
                        vertical-stretch: 0;
                        padding-left: Theme.pad-lg;
                        padding-right: Theme.pad-lg;
                        padding-top: Theme.pad-md;
                        // The outer column has no `spacing`, so this keeps the divider off the
                        // list header.
                        padding-bottom: Theme.pad-lg;
                        spacing: Theme.pad-sm;

                        HorizontalLayout {
                            alignment: start;

                            CollapsibleSectionHeader {
                                label: @tr("Albums");
                                collapsed: ArtistDetail.albums-collapsed;
                                toggled => { ArtistDetail.toggle-albums-collapsed(); }
                            }
                        }

                        // Not virtualized, an artist's albums being few. Its bar sits inside the
                        // `if`, an id there being unreadable from outside.
                        if !ArtistDetail.albums-collapsed: Rectangle {
                            height: root.album-card-h + 2 * Theme.pad-xs + root.albums-bar-h;

                            albums-sv := ScrollView {
                                width: 100%;
                                height: 100%;
                                vertical-scrollbar-policy: always-off;
                                horizontal-scrollbar-policy: always-off;
                                content-height: self.height;

                                HorizontalLayout {
                                    spacing: Theme.pad-md;
                                    padding-top: Theme.pad-xs;
                                    // Clears the bar's band, so the cards keep their full
                                    // height and nothing paints under the thumb.
                                    padding-bottom: Theme.pad-xs + root.albums-bar-h;
                                    alignment: start;

                                    for album in ArtistDetail.albums: EntityCard {
                                        card-width: root.album-card-w;
                                        card-height: root.album-card-h;
                                        artwork-path: album.artwork_path;
                                        cover: ArtistDetail.request-album-cover(album.artwork_path);
                                        fallback-icon: "album";
                                        cover-scale-hover: album.artwork_path == "" ? 1.15 : 1.04;
                                        title: album.name;
                                        subtitle: album.year > 0 ? "\{album.year}" : "";
                                        clicked => { ArtistDetail.open-album(album.id); }
                                    }
                                }
                            }

                            OverlayScrollbar {
                                horizontal: true;
                                x: 0;
                                y: parent.height - self.height;
                                width: parent.width;
                                height: root.albums-bar-h;
                                visible-size: albums-sv.visible-width;
                                content-size: albums-sv.content-width;
                                offset: -albums-sv.content-x;
                                scroll-to(o) => { albums-sv.content-x = -o; }
                            }
                        }

                        // **Outside the collapse `if`**, so it survives the collapse and
                        // gives the hidden sub-section a clear lower edge against the list.
                        Rectangle {
                            height: 1px;
                            background: Theme.surface2.with-alpha(0.5);
                        }
                    }

                    tl := TrackList {
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                        height: min(self.content-height, below-sv.visible-height);

                        rows: ArtistDetail.tracks;
                        columns <=> ArtistDetail.track-columns;

                        sort-field: ArtistDetail.sort-field;
                        sort-dir: ArtistDetail.sort-dir;
                        playing-track-id: Player.vm.track.id;
                        view-context: "artist-detail";
                        view-selected-ids: ArtistDetail.selected-ids;

                        request-sort(f) => { ArtistDetail.request-sort(f); }
                        play-row(id, idx) => { ArtistDetail.play-row(id, idx); }
                        play-next(ids) => { ArtistDetail.play-next(ids); }
                        add-to-queue(ids) => { ArtistDetail.add-to-queue(ids); }
                        toggle-row-favorite(ids, on) => { ArtistDetail.toggle-row-favorite(ids, on); }
                        set-row-rating(ids, n) => { ArtistDetail.set-row-rating(ids, n); }
                        select-row(idx, id, sh, ct) => { ArtistDetail.select-row(idx, id, sh, ct); }
                        select-all => { ArtistDetail.select-all(); }
                        clear-selection => { ArtistDetail.clear-selection(); }
                        request-blur-search => { MyLibrary.blur-search-tick += 1; }
                    }
                }
            }
        }
    }

    CompositeScrollbars {
        x: 0; y: 0;
        width: 100%; height: 100%;
        outer-viewport-y <=> below-sv.content-y;
        outer-viewport-height: below-sv.content-height;
        outer-visible-height: below-sv.visible-height;
        inner-offset: tl.v-offset;
        inner-viewport-height: tl.v-viewport-height;
        inner-visible-height: tl.v-visible-height;
        set-inner-offset(o) => { tl.set-v-offset(o); }
        v-region-y: below-hero.absolute-position.y - root.absolute-position.y;
        v-region-height: below-hero.height;
    }
}
