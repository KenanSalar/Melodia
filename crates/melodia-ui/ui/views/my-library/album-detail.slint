import { Theme } from "../../theme.slint";
import { AlbumDetail } from "../../globals/albums.slint";
import { MyLibrary } from "../../globals/my-library.slint";
import { Player } from "../../globals/player.slint";
import { TrackList } from "../../components/track-list/track-list.slint";
import { TrackListScrollbars } from "../../components/track-list-scrollbars.slint";

// The album's track list, and nothing above it: the banner is `LibraryTabBand`, which the
// mount sheet grows into this album's hero, and the action pills are `tab-pills.slint`'s.
// The filter box is the page's one box, so every blur here bumps `MyLibrary`'s tick rather
// than a channel of its own.
export component AlbumDetailBody inherits Rectangle {
    // Catches any click no inner TouchArea consumes and gives the band's box up.
    TouchArea {
        clicked => { MyLibrary.blur-search-tick += 1; }
    }

    // Insets the sides only: the header sits flush under the band, and a root bottom pad sits
    // *outside* the list's viewport and reads as a dead strip.
    VerticalLayout {
        padding-left: Theme.track-list-inset;
        padding-right: Theme.pad-lg;

        tl := TrackList {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            rows: AlbumDetail.tracks;
            columns <=> AlbumDetail.track-columns;
            number-mode: "track_number";

            sort-field: AlbumDetail.sort-field;
            sort-dir: AlbumDetail.sort-dir;
            playing-track-id: Player.vm.track.id;
            view-context: "album-detail";
            view-selected-ids: AlbumDetail.selected-ids;

            request-sort(f) => { AlbumDetail.request-sort(f); }
            play-row(id, idx) => { AlbumDetail.play-row(id, idx); }
            play-next(ids) => { AlbumDetail.play-next(ids); }
            add-to-queue(ids) => { AlbumDetail.add-to-queue(ids); }
            toggle-row-favorite(ids, on) => { AlbumDetail.toggle-row-favorite(ids, on); }
            set-row-rating(ids, n) => { AlbumDetail.set-row-rating(ids, n); }
            select-row(idx, id, sh, ct) => { AlbumDetail.select-row(idx, id, sh, ct); }
            // A click in the track list blurs the band's SearchBar.
            request-blur-search => { MyLibrary.blur-search-tick += 1; }
            go-to-album(aid) => { AlbumDetail.go-to-album(aid); }
            go-to-artist(aid) => { AlbumDetail.go-to-artist(aid); }
            go-to-genre(gid) => { AlbumDetail.go-to-genre(gid); }
        }
    }

    // At the view root, flush with the content panel's rounded edges. `tl` is nested, so
    // its position comes through `absolute-position`.
    TrackListScrollbars {
        x: 0; y: 0; width: 100%; height: 100%;
        list-y: tl.absolute-position.y - root.absolute-position.y;
        body-y: tl.body-y;
        body-height: tl.body-height;
        v-visible-height: tl.v-visible-height;
        v-viewport-height: tl.v-viewport-height;
        v-offset: tl.v-offset;
        set-v-offset(o) => { tl.set-v-offset(o); }
    }
}
