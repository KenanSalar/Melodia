import { Theme } from "../theme.slint";
import { Radio } from "../globals/radio.slint";
import { NavEnterFrom } from "../globals/nav.slint";
import { DetailArrival } from "../components/detail-arrival.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { LibraryTabBand } from "../components/hero/library-tab-band.slint";
import { TooltipFrame } from "../components/tooltip-frame.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { RadioBrowseTab } from "radio/browse-tab.slint";
import { KeptStationsTab } from "radio/kept-stations-tab.slint";
import { RadioStationDetail } from "radio/station-detail.slint";
import { RadioTabPills } from "radio/tab-pills.slint";

// Radio's mount sheet, under the same `LibraryTabBand` My Library wears. A station page is a
// fourth body branch belonging to the tab it was opened from: `Radio.detail-open` is derived from
// the seat and the live tab, so a tab pick unmounts the page without forgetting it. The filter box
// goes away over a page, a station having nothing to narrow.
export component RadioView inherits Rectangle {
    property <int> filter-tick-pending: 0;

    TouchArea {
        clicked => { Radio.blur-search-tick += 1; }
    }

    // On Browse a settled burst is a directory request, so it is the tree's only `trailing` mount,
    // at an interval sized to a round trip: a value typed through is a request and a logo burst
    // spent on a page nobody will see. The kept tabs filter rows in hand at every box's cadence.
    FilterThrottle {
        trailing: Radio.tab-idx == Radio.tab-browse;
        interval: Radio.tab-idx == Radio.tab-browse ? 200ms : 130ms;
        pending: root.filter-tick-pending;
        fire() => { Radio.filter-changed(Radio.filter); }
    }

    // One number first, so the `>= 0` guard is written once.
    property <int> mounted-count:
        Radio.tab-idx == Radio.tab-browse ? Radio.browse-count
        : Radio.tab-idx == Radio.tab-favorites ? Radio.favorites-count
        : Radio.recent-count;
    property <string> live-count: root.mounted-count >= 0
        ? @tr("{n} station" | "{n} stations" % root.mounted-count)
        : "";

    // Held across an open, as My Library's is: the band fades it over the morph's first half, and
    // bound live it would re-read a count mid-rewind. `latch-count` is unguarded so `init` can own
    // it.
    property <string> count-line: root.live-count;
    function latch-count() {
        self.count-line = root.live-count;
    }
    changed live-count => {
        if (!Radio.detail-open) { root.latch-count(); }
    }

    // My Library's shape: the bar arms a pick, `DetailArrival` a drill or close, and
    // `watched-tab-idx` a tab move that isn't a pick.
    property <bool> body-anim-armed: band.tab-anim-armed;
    DetailArrival {
        open: Radio.detail-open;
        restoring: Radio.restoring;
        arrived => { root.body-anim-armed = true; }
    }
    property <bool> watched-detail-open: Radio.detail-open;
    changed watched-detail-open => {
        if (!Radio.detail-open) { root.latch-count(); }
        Radio.detail-scope-changed();
    }
    // A Mouse-4/5 walk moves the tab with nobody touching the bar.
    property <int> watched-tab-idx: Radio.tab-idx;
    changed watched-tab-idx => {
        root.body-anim-armed = true;
        Radio.detail-scope-changed();
    }

    init => {
        root.latch-count();
    }

    property <length> grid-gap: 20px;

    property <int> grid-lone-row-cards:
        Radio.tab-idx == Radio.tab-browse
            ? (Radio.browse-rows.length == 1 ? Radio.browse-rows[0].stations.length : -1)
            : Radio.tab-idx == Radio.tab-favorites
                ? (Radio.favorites-rows.length == 1 ? Radio.favorites-rows[0].stations.length : -1)
                : (Radio.recent-rows.length == 1 ? Radio.recent-rows[0].stations.length : -1);

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
        // The one metric Radio moves, its card carrying a third line. The width pitch stays the
        // shared default, the one `grid_prewarm`'s tier is sized off.
        card-text-h: 66px;
        lone-row-cards: root.grid-lone-row-cards;
    }

    // Ungated: Rust re-chunks whichever tab is mounted.
    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Radio.grid-columns = c;
            Radio.columns-changed(c);
        }
    }

    VerticalLayout {
        band := LibraryTabBand {
            // Order matches `Radio.tab-*`.
            tab-labels: [@tr("Browse"), @tr("Favorites"), @tr("Recently Played")];
            tab-icons: ["travel_explore", "favorite", "history"];
            tab-idx <=> Radio.tab-idx;
            tab-selected(i) => {
                // Rust reseats the box rather than clearing it, each tab keeping its own needle:
                // blanked here, Browse's query would stand in Rust with nothing on screen.
                Radio.blur-search-tick += 1;
                Radio.tab-changed(i);
            }

            filter <=> Radio.filter;
            blur-tick: Radio.blur-search-tick;
            search-edited(t) => { root.filter-tick-pending += 1; }

            count-text: root.count-line;

            search-shown: !Radio.detail-open;
            filter-placeholder: Radio.tab-idx == Radio.tab-browse
                ? @tr("Search stations…")
                : @tr("Filter stations…");

            detail-open: Radio.detail-open;
            back-clicked => { Radio.close-detail(); }
            hero-collapsed => { Radio.hero-collapsed(); }

            title: Radio.detail-station.name;
            subtitle: Radio.detail-station.country;

            artwork-path: Radio.detail-station.artwork_path;
            cover: Radio.cover;
            // The card's own tile, so a station reads the same in the grid and the banner.
            fallback-text: Radio.detail-station.monogram;
            fallback-icon: "radio";
            tile-bg: @linear-gradient(135deg,
                Radio.detail-station.tile_color_1,
                Radio.detail-station.tile_color_2);
            tile-icon-color: Theme.tile-ink;
            // The detail tier decodes at source size, so the pixel count is the 1:1 size. Read at
            // one device pixel per point: a favicon too small for the banner at 1× is too small
            // at 2×, so a scale term would move no station across the line.
            native-size: Radio.detail-logo-size * 1px;

            blur-a: Radio.blur-img-a;
            blur-b: Radio.blur-img-b;
            use-a: Radio.blur-use-a;
            has-blur: Radio.has-blur;

            pill-natural-w: pill-ruler.preferred-width;
            pills := RadioTabPills {
                compact-t: band.pills-compact-t;
            }
        }

        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // `!Radio.restoring`: a boot reopening a station has the tab before the station, and
            // the grid would paint for the length of that fetch.
            if !Radio.detail-open && !Radio.restoring
                && Radio.tab-idx == Radio.tab-browse: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                RadioBrowseTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if !Radio.detail-open && !Radio.restoring
                && Radio.tab-idx == Radio.tab-favorites: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                // A hand-typed station is a favorite on the way in, so one query answers the tab.
                KeptStationsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                    rows: Radio.favorites-rows;
                    count: Radio.favorites-count;
                    empty-icon: "favorite";
                    empty-title: @tr("No stations kept yet");
                    empty-body: @tr("Star a station in Browse, or add one by URL.");
                }
            }
            if !Radio.detail-open && !Radio.restoring
                && Radio.tab-idx == Radio.tab-recent: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                // Anything played, favorite or not, which is why this is a tab and not a sort.
                KeptStationsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                    rows: Radio.recent-rows;
                    count: Radio.recent-count;
                    empty-icon: "history";
                    empty-title: @tr("Nothing played yet");
                    empty-body: @tr("Stations you listen to show up here.");
                }
            }

            // `above`, a drill not being a move along the tab bar.
            if Radio.detail-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: NavEnterFrom.above;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                RadioStationDetail {
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }

    // My Library's `pill-ruler`.
    pill-ruler := RadioTabPills {
        x: 0px;
        y: 0px;
        visible: false;
    }

    // Last, since the band clips and the body declared after it would cover its pills.
    TooltipFrame {
        x: band.absolute-position.x - root.absolute-position.x + band.tip-x;
        y: band.absolute-position.y - root.absolute-position.y + band.tip-y;
        width: band.tip-w;
        height: band.tip-h;
        label: band.tip-label;
        shown: band.tip-visible;
    }

    TooltipFrame {
        x: pills.absolute-position.x - root.absolute-position.x + pills.tip-x;
        y: pills.absolute-position.y - root.absolute-position.y + pills.tip-y;
        width: pills.tip-w;
        height: pills.tip-h;
        label: pills.tip-label;
        shown: pills.tip-visible;
        align-end: pills.tip-align-end;
    }
}
