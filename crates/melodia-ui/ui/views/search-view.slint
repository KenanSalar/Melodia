import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Search } from "../globals/search.slint";
import { SearchBar } from "../components/search-bar.slint";
import { HorizontalCardStrip } from "../components/grid/horizontal-card-strip.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { RecentSearches } from "search/recent-searches.slint";
import { NoResults } from "search/no-results.slint";
import { TopResultCard } from "search/top-result-card.slint";
import { SongsSection } from "search/songs-section.slint";

// A mount sheet: this file owns the timers, branch conditions and scroll chrome, and
// `views/search/*.slint` the bodies. The bar floats rather than heading a row, which would clip
// the scroller at its floor; with no `TouchArea` of its own, everything beside it stays clickable.
//
// Both strips match through their tracks as well as by name, so a query reaching only track
// metadata still fills them. No Genres strip: a genre is a route, so it surfaces as the Top Result.
export component SearchView inherits Rectangle {
    // Commits once the keystrokes go quiet, writing `applied` to halt itself.
    debounce := Timer {
        interval: 300ms;
        running: Search.debounce-tick-pending != Search.debounce-tick-applied;
        triggered() => {
            Search.debounce-tick-applied = Search.debounce-tick-pending;
            Search.commit-search(Search.query);
        }
    }

    // A Timer rather than `init`, which keeps `focus()` out of binding evaluation.
    autofocus := Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            search-bar.focus-input();
        }
    }

    TouchArea {
        clicked => { Search.blur-search-tick += 1; }
    }

    // The bar's 32 px plus `pad-md` above and below: nothing starts under the pill, and
    // everything scrolls behind it from there.
    private property <length> bar-inset: 56px;

    body := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        below-sv := ScrollView {
            width: 100%;
            height: 100%;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy:   always-off;
            content-width: self.width;

            VerticalLayout {
                padding-top: root.bar-inset;
                padding-left: Theme.pad-lg;
                padding-right: Theme.pad-lg;
                padding-bottom: Theme.pad-lg;
                spacing: Theme.pad-lg;

                if Search.query == "" && Search.recent-rows.length > 0: RecentSearches { }

                if Search.loading && Search.query != "": HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: center;
                    padding-top: Theme.pad-lg;
                    Text {
                        text: @tr("Searching…");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                    }
                }

                if !Search.loading && Search.query != ""
                    && Search.tracks.length == 0
                    && Search.album-rows.length == 0
                    && Search.artist-rows.length == 0
                    && Search.top-kind == "": NoResults { }

                if Search.top-kind != "" || Search.tracks.length > 0: HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.pad-lg;
                    alignment: stretch;

                    if Search.top-kind != "": TopResultCard { }

                    SongsSection { }
                }

                if Search.album-rows.length > 0: HorizontalCardStrip {
                    heading: @tr("Albums");
                    rows: Search.album-rows;
                    card-width: 160px;
                    card-height: 206px;
                    fallback-icon: "album";
                    request-cover(p) => {
                        return Search.request-album-strip-cover(p);
                    }
                    row-clicked(id) => {
                        Search.blur-search-tick += 1;
                        Search.open-album(id);
                    }
                }

                if Search.artist-rows.length > 0: HorizontalCardStrip {
                    heading: @tr("Artists");
                    rows: Search.artist-rows;
                    card-width: 160px;
                    card-height: 206px;
                    circular: true;
                    fallback-icon: "person";
                    request-cover(p) => {
                        return Search.request-artist-strip-cover(p);
                    }
                    row-clicked(id) => {
                        Search.blur-search-tick += 1;
                        Search.open-artist(id);
                    }
                }

                // Takes the surplus, which the column would otherwise split between the
                // Recent section's heading and its chips.
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: 0;
        width: Theme.scrollbar-slot;
        height: parent.height;
        visible-size: below-sv.visible-height;
        content-size: below-sv.content-height;
        offset: -below-sv.content-y;
        scroll-to(o) => { below-sv.content-y = -o; }
    }

    // Last, so it paints over the results and the scrollbar. The height is pinned, a layout in a
    // plain `Rectangle` otherwise filling the view; the side padding keeps it off the scrollbar,
    // the bar compressing toward its `min-w` rather than overrunning.
    HorizontalLayout {
        y: 0;
        height: root.bar-inset;
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        alignment: center;
        cross-axis-alignment: center;

        search-bar := SearchBar {
            text <=> Search.query;
            placeholder: @tr("Search your library…");
            blur-trigger: Search.blur-search-tick;
            input-width: 420px;
            edited(t) => {
                Search.debounce-tick-pending += 1;
                Search.query-changed(t);
            }
            // Enter commits at once, aligning the ticks so the pending fire doesn't commit it
            // again. It is also how a query kept across a leave, which released the results,
            // is re-run.
            accepted => {
                Search.debounce-tick-applied = Search.debounce-tick-pending;
                Search.commit-search(Search.query);
            }
        }
    }
}
