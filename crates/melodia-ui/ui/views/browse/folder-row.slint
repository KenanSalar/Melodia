import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// The label's `min-width` is its natural width, so a folder name never truncates.
export component BrowseFolderRowItem inherits Rectangle {
    in property <string> name;
    callback clicked();

    // The gap is baked in, a `ListView` having no `spacing`; the host's height cap counts on it.
    height: 50px;

    inner := Rectangle {
        y: 0;
        width: 100%;
        height: 48px;
        border-radius: Theme.radius-md;
        background: touch.has-hover ? Theme.surface0 : transparent;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-md;
            alignment: stretch;
            cross-axis-alignment: center;

            MaterialIcon {
                name: "folder";
                icon-size: 24px;
                icon-color: Theme.accent;
            }

            Text {
                horizontal-stretch: 1;
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 500;
                min-width: self.preferred-width;
                // For the ink, not the elision: the floor pins the width, and this drops the
                // line-box scissor that would cut a filename's Arabic marks.
                overflow: elide;
            }

            MaterialIcon {
                name: "chevron_right";
                icon-size: 20px;
                icon-color: Theme.overlay0;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}
