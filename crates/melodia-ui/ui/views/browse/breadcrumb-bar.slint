import { Theme } from "../../theme.slint";
import { BreadcrumbRow } from "../../models.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

component BreadcrumbPill inherits Rectangle {
    in property <string> label;
    in property <bool> is-current;
    callback clicked();

    height: 28px;
    width: layout.preferred-width;
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.surface0 : transparent;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.is-current ? Theme.accent : Theme.subtext0;
            font-size: Theme.font-size-sm;
            font-weight: 500;
            vertical-alignment: center;
            // For the ink, not the elision: the bound width keeps the segment whole, and this
            // drops the line-box scissor that would cut Arabic marks.
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The clip keeps a deep path from shoving the header's pill off screen: the segments' widths are
// bound, so a trail wider than the slot spills and is cut at the right, the current folder going
// first. Hiding the head instead takes `alignment: end`, which right-aligns every short trail too.
export component BreadcrumbBar inherits Rectangle {
    in property <[BreadcrumbRow]> segments;
    callback segment-clicked(string);

    clip: true;

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: start;
            spacing: 2px;

            for seg[i] in root.segments: HorizontalLayout {
                spacing: 2px;
                alignment: center;
                cross-axis-alignment: center;
                if i > 0: MaterialIcon {
                    name: "chevron_right";
                    icon-size: 14px;
                    icon-color: Theme.overlay0;
                }
                BreadcrumbPill {
                    label: seg.label;
                    is-current: i == root.segments.length - 1;
                    clicked => { root.segment-clicked(seg.path); }
                }
            }
        }
    }
}
