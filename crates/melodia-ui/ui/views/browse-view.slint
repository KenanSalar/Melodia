import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { CompositeScroll } from "../globals/shell.slint";
import { Browse } from "../globals/tracks.slint";
import { IconButton } from "../components/icon-button.slint";
import { TooltipFrame } from "../components/tooltip-frame.slint";
import { ActionPill, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { CompositeScrollbars } from "../components/composite-scrollbars.slint";
import { BrowseCardGrid } from "../components/grid/browse-card-grid.slint";
import { GridEmptyState } from "../components/grid/grid-empty-state.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { BreadcrumbBar } from "browse/breadcrumb-bar.slint";
import { BrowseFolderRowItem } from "browse/folder-row.slint";

// A mount sheet: what stays here is anything the scrollbars reach by id, an id being unreadable
// across a component boundary.
//
// A composite view (`slint-pitfalls.md`): folders and list share one outer `ScrollView`, the list
// capped at the outer viewport so its `ListView` still virtualizes. The card view is a second body
// in that scroller, mounted rather than behind an `if` so its id stays readable; both bodies leave
// the layout through a `0px` height arm, `visible` alone keeping the slot.
export component BrowseView inherits Rectangle {
    property <bool> card-mode: Browse.view-mode == Browse.mode-card;

    // On the view, an `in` property being unreadable from outside its component.
    property <length> grid-gap: 20px;

    // The header's and the card grid's; the body runs full-bleed, the track list insetting itself.
    property <length> page-inset: Theme.pad-lg;

    geom := GridGeometry {
        avail-width: body.width - 2 * root.page-inset;
        gap: root.grid-gap;
        // List mode empties `card-rows`, so what this answers there reaches no card.
        lone-row-cards: Browse.card-rows.length == 1 ? Browse.card-rows[0].cards.length : -1;
    }

    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Browse.columns = c;
            Browse.columns-changed(c);
        }
    }

    vl := VerticalLayout {
        // Top only: a bottom pad is a dead strip under the list (`slint-pitfalls.md`).
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: root.page-inset;
            padding-right: root.page-inset;
            spacing: Theme.pad-sm;
            alignment: stretch;

            IconButton {
                cross-axis-self-alignment: center;
                icon: "arrow_back";
                icon-size: 20px;
                diameter: 32px;
                button-enabled: Browse.can-go-back;
                clicked => { Browse.go-back(); }
            }

            IconButton {
                cross-axis-self-alignment: center;
                icon: "home";
                filled: true;
                icon-size: 20px;
                diameter: 32px;
                clicked => { Browse.navigate-to(""); }
            }

            BreadcrumbBar {
                horizontal-stretch: 1;
                segments: Browse.breadcrumbs;
                segment-clicked(p) => { Browse.navigate-to(p); }
            }

            ActionPill {
                cross-axis-self-alignment: center;
                // The glyph names the presentation you'd switch to, the action rather than
                // the state.
                view-toggle := PillButton {
                    icon: root.card-mode ? "view_list" : "grid_view";
                    tooltip-overlay: true;
                    clicked => { Browse.toggle-view-mode(); }
                }
                // The card grid has no columns to configure.
                if !root.card-mode: PillDivider { }
                if !root.card-mode: ColumnTogglePopup {
                    columns <=> Browse.track-columns;
                    toggled(id) => { Browse.toggle-column(id); }
                }
            }
        }

        // The empty states paint **over** the body on an opaque fill, so the list's
        // column header can't peek through; Rust clears both models whenever one is up.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            // The `CompositeScroll` hover sentinel, round the scroll region only.
            hover-catch := TouchArea {
                width: 100%;
                height: 100%;
                changed has-hover => { CompositeScroll.hovered = self.has-hover; }

                below-sv := ScrollView {
                    width: 100%;
                    height: 100%;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: always-off;
                    content-width: self.width;

                    VerticalLayout {
                        // The folder section carries its own gap and unmounts with no
                        // subfolders, so spacing here would dangle above the list.
                        spacing: 0;

                        // Sized to its full row count, so the folders flow in the outer
                        // scroller rather than scrolling on their own; the gap only when
                        // drilled in, the root listing no songs below. An `if` is safe here,
                        // nothing at the root reading into it.
                        if Browse.folders.length > 0 && !root.card-mode: Rectangle {
                            vertical-stretch: 0;
                            height: Browse.folders.length * 50px
                                + (Browse.current-path == "" ? 0px : Theme.pad-md);

                            // In the track list's column, so the pills line up.
                            ListView {
                                x: Theme.track-list-inset;
                                y: 0;
                                width: parent.width - Theme.track-list-inset - Theme.scrollbar-slot;
                                height: Browse.folders.length * 50px;
                                vertical-scrollbar-policy: always-off;
                                horizontal-scrollbar-policy: always-off;
                                // A row click opens the folder, so it answers the way a
                                // card does; argument on `views/radio/station-grid.slint`.
                                mouse-drag-pan-enabled: false;

                                for folder in Browse.folders : BrowseFolderRowItem {
                                    name: folder.name;
                                    clicked => { Browse.open-folder(folder.path); }
                                }
                            }
                        }

                        // Capped at the outer viewport, so the inner list virtualizes.
                        tl := TrackList {
                            visible: !root.card-mode && Browse.current-path != "";
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            height: (root.card-mode || Browse.current-path == "")
                                ? 0px
                                : min(self.content-height, below-sv.visible-height);

                            rows: Browse.rows;
                            columns <=> Browse.track-columns;

                            sort-field: Browse.sort-field;
                            sort-dir: Browse.sort-dir;
                            playing-track-id: Player.vm.track.id;
                            view-context: "browse";
                            view-selected-ids: Browse.selected-ids;

                            request-sort(f) => { Browse.request-sort(f); }
                            play-row(id, idx) => { Browse.play-row(id, idx); }
                            play-next(ids) => { Browse.play-next(ids); }
                            add-to-queue(ids) => { Browse.add-to-queue(ids); }
                            toggle-row-favorite(ids, on) => { Browse.toggle-row-favorite(ids, on); }
                            set-row-rating(ids, n) => { Browse.set-row-rating(ids, n); }
                            select-row(idx, id, sh, ct) => { Browse.select-row(idx, id, sh, ct); }
                            select-all => { Browse.select-all(); }
                            clear-selection => { Browse.clear-selection(); }
                            // Browse has no filter input — nothing to blur.
                            request-blur-search => { }
                        }

                        HorizontalLayout {
                            vertical-stretch: 0;
                            padding-left: root.page-inset;
                            padding-right: root.page-inset;

                            grid := BrowseCardGrid {
                                visible: root.card-mode;
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                // Pinned to the outer viewport, so its `ListView` virtualizes.
                                height: root.card-mode ? below-sv.visible-height : 0px;

                                rows: Browse.card-rows;
                                card-width: geom.card-w;
                                card-height: geom.card-h;
                                row-height: geom.row-h;
                                gap: root.grid-gap;
                                covers-generation: Browse.covers-generation;

                                request-cover(p, gen) => { Browse.request-card-cover(p, gen) }
                                folder-clicked(path) => { Browse.open-folder(path); }
                                select-all => { Browse.select-all(); }
                                clear-selection => { Browse.clear-selection(); }
                                track-clicked(id, idx) => { Browse.play-row(id, idx); }

                                // The list's selection rather than `CardSelection`, the cards being
                                // these rows, so the mode toggle keeps it.
                                selected-ids: Browse.selected-ids;
                                selection-generation: Browse.selection-generation;
                                is-card-selected(id, gen) => { Browse.is-card-selected(id, gen) }
                                select-card(idx, id, shift, ctrl) => {
                                    Browse.select-row(idx, id, shift, ctrl);
                                }

                                play-folder(path) => { Browse.play-folder(path); }
                                play-folder-next(path) => { Browse.play-folder-next(path); }
                                queue-folder(path) => { Browse.queue-folder(path); }
                                reveal-folder(path) => { Browse.reveal-folder(path); }

                                list-rows: Browse.rows;
                                toggle-favorite(id, fav) => { Browse.toggle-row-favorite([id], fav); }
                            }
                        }
                    }
                }
            }

            if Browse.current-path == "" && !Browse.has-library-folders: GridEmptyState {
                icon: "folder_off";
                title: @tr("No library folders configured");
                body: @tr("Open Settings to add a folder");
                action-icon: "settings";
                action-label: @tr("Open Settings");
                // Persisted and marked like any sidebar pick.
                action-clicked => {
                    Nav.pending-enter-from = NavEnterFrom.above;
                    Nav.selected-index = 9;
                    Nav.persist-selected-index(9);
                }
            }

            // Back goes to the root rather than back: a persisted path seeds this with an empty
            // history, where `go-back` is a no-op.
            if Browse.error-message != "": GridEmptyState {
                icon: "error";
                title: @tr("Could not load folder");
                body: Browse.error-message;
                action-icon: "arrow_back";
                action-label: @tr("Back");
                action-clicked => { Browse.navigate-to(""); }
            }

            if Browse.current-path != ""
                && Browse.error-message == ""
                && !Browse.loading
                && Browse.folders.length == 0
                && Browse.rows.length == 0: GridEmptyState {
                icon: "folder_open";
                title: @tr("Empty folder");
            }
        }
    }

    // The inner half follows the mounted body, the outer scroller having no travel in card mode.
    CompositeScrollbars {
        x: 0; y: 0;
        width: 100%; height: 100%;
        outer-viewport-y <=> below-sv.content-y;
        outer-viewport-height: below-sv.content-height;
        outer-visible-height: below-sv.visible-height;
        inner-offset: root.card-mode ? grid.v-offset : tl.v-offset;
        inner-viewport-height: root.card-mode ? grid.v-viewport-height : tl.v-viewport-height;
        inner-visible-height: root.card-mode ? grid.v-visible-height : tl.v-visible-height;
        set-inner-offset(o) => {
            if (root.card-mode) {
                grid.set-v-offset(o);
            } else {
                tl.set-v-offset(o);
            }
        }
        v-region-y: body.absolute-position.y - root.absolute-position.y;
        v-region-height: body.height;
    }

    // The view toggle's tooltip hangs below the header, where the body declared after it would
    // cover an in-tree pill, so it is drawn here, last.
    TooltipFrame {
        x: view-toggle.absolute-position.x - root.absolute-position.x;
        y: view-toggle.absolute-position.y - root.absolute-position.y;
        width: view-toggle.width;
        height: view-toggle.height;
        label: root.card-mode ? @tr("List view") : @tr("Card view");
        shown: view-toggle.hovered;
        // Off the pill, which knows when card mode leaves it at the chip's trailing edge.
        align-end: view-toggle.icon-only;
    }
}
