import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { RadioForm } from "../../globals/dialog-forms.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { ActionPill, PillButton, PillDivider } from "../../components/action-pill.slint";
import { MenuItem } from "../../components/context-menu.slint";
import { PillOverflowMenu } from "../../components/pill-overflow-menu.slint";
import { SortMenuPopup } from "../../components/sort-menu-popup.slint";
import { FacetChip } from "facet-chip.slint";

// A chip whose options come off the directory. The bitrate chip isn't one: its options are a
// literal, so it has no fetch, no needle and nothing to be shown.
component DirectoryFacetChip inherits FacetChip {
    options: Radio.facet-shown == self.kind ? Radio.facet-options : [];
    loading: Radio.facet-shown == self.kind && Radio.facet-loading;
    needle <=> Radio.facet-filter;
    opened(k) => { Radio.request-facet(k); }
    needle-edited(t) => { Radio.facet-filter-changed(t); }
    picked(k, n, c) => { Radio.facet-picked(k, n, c); }
    cleared(k) => { Radio.clear-facet(k); }
}

// Every pill row the Radio band can show, one per tab and the station page's over them, handed to
// `LibraryTabBand` as its `@children`. Recently Played has none, its order being the page.
//
// Favorites sorts through a popup rather than a `SortPillRow`, four field pills leaving the band
// no room for its count line. Labels rather than tooltips, a label being legible without aiming
// at it, except on the overflow, which has none.
//
// That tooltip opens downward, where the band clips, so the host draws it from a top-layer frame
// that reaches the pill by id. An `if` would hide the id, so the Favorites row collapses to a
// zero-width cell instead and `radio-view.slint` hangs the frame, as My Library does for its
// Playlists row.
export component RadioTabPills inherits Rectangle {
    property <bool> favorites-row-up: !Radio.detail-open && Radio.tab-idx == Radio.tab-favorites;
    // The band's eased verdict, for the station page's pills only: the Favorites row's cell clips,
    // so a dropped label would land on a tooltip nothing draws.
    in property <float> compact-t: 0.0;

    HorizontalLayout {
        alignment: end;
        // The Favorites cell never unmounts, so spacing here would inset every other tab.
        spacing: 0px;

        // Nested so the chips carry their own spacing.
        if !Radio.detail-open && Radio.tab-idx == Radio.tab-browse: HorizontalLayout {
            spacing: Theme.pad-sm;

            DirectoryFacetChip {
                kind: Radio.facet-country;
                label: @tr("Country");
                value: Radio.pick-country;
            }

            DirectoryFacetChip {
                kind: Radio.facet-language;
                label: @tr("Language");
                value: Radio.pick-language;
            }

            DirectoryFacetChip {
                kind: Radio.facet-tag;
                label: @tr("Genre");
                value: Radio.pick-tag;
            }

            DirectoryFacetChip {
                kind: Radio.facet-codec;
                label: @tr("Format");
                value: Radio.pick-codec;
            }

            // The floors are ours to choose, not the directory's to list. `code` is what the
            // request carries, so it stays unlocalized.
            FacetChip {
                kind: Radio.facet-bitrate;
                label: @tr("Bitrate");
                value: Radio.pick-bitrate-min > 0
                    ? @tr("{} kbps and up", Radio.pick-bitrate-min)
                    : "";
                searchable: false;
                options: [
                    { name: @tr("{} kbps and up", 64), code: "64" },
                    { name: @tr("{} kbps and up", 128), code: "128" },
                    { name: @tr("{} kbps and up", 192), code: "192" },
                    { name: @tr("{} kbps and up", 320), code: "320" },
                ];
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }
        }

        // Collapsed rather than unmounted: a zero-width clip paints nothing and takes no events,
        // while `om` stays readable from the root. `min-width` is spelled because it replaces the
        // constraint the pill's own width would merge in.
        Rectangle {
            clip: true;
            min-width: 0px;
            preferred-width: root.favorites-row-up ? fav.preferred-width : 0px;
            max-width: root.favorites-row-up ? fav.preferred-width : 0px;

            fav := ActionPill {
                // Fills the Dialog inline rather than hopping through Rust: a synchronous
                // `set_open(true)` mid-click-handler trips Slint's recursion guard.
                PillButton {
                    icon: "add";
                    text: @tr("Add Station");
                    clicked => {
                        // As well as at the teardown: the session's first open has had no close
                        // before it, and the declared defaults are not the add form's.
                        RadioForm.reset();
                        Dialog.title = @tr("Add Station");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Add");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = DialogKind.add-station;
                        Dialog.target-id = -1;
                        Dialog.open = true;
                    }
                }

                PillDivider { }

                SortMenuPopup {
                    labels: [@tr("Name"), @tr("Added"), @tr("Plays"), @tr("Last played")];
                    fields: ["name", "added", "plays", "played"];
                    sort-field: Radio.sort-field;
                    sort-dir: Radio.sort-dir;
                    request-sort(f) => { Radio.request-sort(f); }
                }

                PillDivider { }

                // The rarest actions on the row, so they give up the width.
                om := PillOverflowMenu {
                    tooltip-text: @tr("More station actions");
                    tooltip-overlay: true;

                    MenuItem {
                        label: @tr("Import");
                        icon: "download";
                        clicked => { Radio.import-stations(); }
                    }
                    MenuItem {
                        label: @tr("Export");
                        icon: "upload";
                        clicked => { Radio.export-stations(); }
                    }
                }
            }
        }

        // What the station page can do; what it states is a row in its body. Starring and removing
        // stay on the cards, each changing a list the page isn't showing. One mount for all three
        // tabs, the page being decided by the station.
        if Radio.detail-open: ActionPill {
            PillButton {
                icon: "play_arrow";
                icon-filled: true;
                text: @tr("Play");
                compact-t: root.compact-t;
                clicked => { Radio.play-station(Radio.detail-station); }
            }
            if Radio.detail-votable || Radio.detail-station.editable: PillDivider { }

            if Radio.detail-votable: PillButton {
                icon: "thumb_up";
                icon-size: 16px;
                text: @tr("Vote");
                compact-t: root.compact-t;
                clicked => {
                    Radio.vote(Radio.detail-station.uuid, Radio.detail-station.id);
                }
            }

            if Radio.detail-votable && Radio.detail-station.editable: PillDivider { }

            if Radio.detail-station.editable: PillButton {
                icon: "edit";
                text: @tr("Edit");
                compact-t: root.compact-t;
                clicked => { Radio.edit-station(Radio.detail-station); }
            }
        }
    }

    // The overflow's tooltip rect, read live so a pill moving under a parked pointer keeps its
    // tooltip anchored. Collapsed, the cell takes no events, so nothing draws wherever it sits.
    out property <length> tip-x: om.absolute-position.x - root.absolute-position.x;
    out property <length> tip-y: om.absolute-position.y - root.absolute-position.y;
    out property <length> tip-w: om.width;
    out property <length> tip-h: om.height;
    out property <string> tip-label: om.tooltip-text;
    out property <bool> tip-visible: om.hovered;
    // `PillButton`'s rule, read rather than restated.
    out property <bool> tip-align-end: om.icon-only;
}
