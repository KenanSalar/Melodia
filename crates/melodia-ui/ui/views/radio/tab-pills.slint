import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { RadioForm } from "../../globals/dialog-forms.slint";
import { Dialog } from "../../globals/dialog.slint";
import { ActionPill, PillButton, PillDivider } from "../../components/action-pill.slint";
import { MenuItem } from "../../components/context-menu.slint";
import { PillOverflowMenu } from "../../components/pill-overflow-menu.slint";
import { SortMenuPopup } from "../../components/sort-menu-popup.slint";
import { FacetChip } from "facet-chip.slint";

// One of the four chips whose options come off the directory. Everything below is the same for
// all four, and the `facet-shown == kind` test was previously spelled twice per chip with the kind
// restated on both sides — eight chances to name the wrong one, none of them visible until a
// picker filled with another chip's list. The bitrate chip is deliberately not one of these: its
// options are a literal, so it has no fetch, no needle and nothing to be shown.
component DirectoryFacetChip inherits FacetChip {
    options: Radio.facet-shown == self.kind ? Radio.facet-options : [];
    loading: Radio.facet-shown == self.kind && Radio.facet-loading;
    needle <=> Radio.facet-filter;
    opened(k) => { Radio.request-facet(k); }
    needle-edited(t) => { Radio.facet-filter-changed(t); }
    picked(k, n, c) => { Radio.facet-picked(k, n, c); }
    cleared(k) => { Radio.clear-facet(k); }
}

// Every pill row the Radio band can show, mutually exclusive on the mounted tab and handed to
// `LibraryTabBand` as its whole `@children`: Browse's filter chips, then Favorites' single chip of
// add and sort with import / export folded into an overflow. Recently Played has none, its order
// being the page.
//
// **The two tab rows gate on `!detail-open`**, describing the tab under a station page rather
// than the page, and the station's own row takes the slot instead — which is where My Library
// puts each of its four details' actions.
//
// **Favorites sorts through a popup rather than the usual `SortPillRow`.** Four fields spelled out
// beside the row's own pills mounted two chips at once, flush against each other under the
// `spacing: 0px` below, and left the band no room for the count line it reserves against
// `pills.width`.
//
// **Labels rather than tooltips, the overflow excepted** — it has no label to restate, and a
// label is legible without aiming at it, which is the trade My Library's detail arms decline
// because theirs run to fifteen segments where the widest row here is four.
//
// **That one tooltip is the reason the Favorites row can't sit under an `if`.** It opens
// *downward*, where the band clips its own height and the page body is declared after it, so the
// host places it from a top-layer frame — and a frame reaches the pill by id, which an `if` makes
// unreadable from out here. The row collapses to a zero-width cell instead; this file publishes
// the rect and `radio-view.slint` hangs the frame, the shape `MyLibraryTabPills` carries for its
// Playlists row.
export component RadioTabPills inherits Rectangle {
    // Spelled once: the collapse below and the pills it holds must not be able to disagree about
    // whether the row is up.
    property <bool> favorites-row-up: !Radio.detail-open && Radio.tab-idx == Radio.tab-favorites;

    HorizontalLayout {
        alignment: end;
        // The rows are mutually exclusive, so any spacing here would read as a permanent inset on
        // the tabs that mount nothing.
        spacing: 0px;

        // The Browse filters, in the band's slot rather than in the tab body: this is where the
        // page's controls go and where a station detail's own will land. Country carries a code
        // because `countrycode` is the search endpoint's one code-keyed parameter; the rest filter
        // by name, and the bitrate chip's `code` is its own floor in kbps.
        //
        // Nested so the chips carry their own spacing, the outer row's `0px` being what keeps
        // every other row flush with the band's edge.
        if !Radio.detail-open && Radio.tab-idx == Radio.tab-browse: HorizontalLayout {
            spacing: Theme.pad-sm;

            DirectoryFacetChip {
                kind: Radio.facet-country;
                popup-id: "facet-country";
                label: @tr("Country");
                value: Radio.pick-country;
            }

            DirectoryFacetChip {
                kind: Radio.facet-language;
                popup-id: "facet-language";
                label: @tr("Language");
                value: Radio.pick-language;
            }

            DirectoryFacetChip {
                kind: Radio.facet-tag;
                popup-id: "facet-tag";
                label: @tr("Genre");
                value: Radio.pick-tag;
            }

            DirectoryFacetChip {
                kind: Radio.facet-codec;
                popup-id: "facet-codec";
                label: @tr("Format");
                value: Radio.pick-codec;
            }

            // Its options are a literal rather than a fetch: the floors are ours to choose, not
            // the directory's to list. `code` is what the request carries, so it stays unlocalized
            // while the label is not.
            FacetChip {
                kind: Radio.facet-bitrate;
                popup-id: "facet-bitrate";
                label: @tr("Bitrate");
                value: Radio.pick-bitrate-min > 0
                    ? @tr("{} kbps and up", Radio.pick-bitrate-min)
                    : "";
                searchable: false;
                options: [
                    { name: @tr("{} kbps and up", 64), code: "64" },
                    { name: @tr("{} kbps and up", 128), code: "128" },
                    { name: @tr("{} kbps and up", 192), code: "192" },
                    { name: @tr("{} kbps and up", 320), code: "320" },
                ];
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }
        }

        // --- Favorites: collapsed, never unmounted --------------------------------------------
        //
        // The one row that can't sit under an `if`, per the file header. It collapses to a
        // zero-width clipped cell instead: nothing paints, and `Clip` swallows every event outside
        // its empty rect, so the pills are as unreachable as an unmounted branch while `om` stays
        // readable from this root. The three width constraints are spelled out because an explicit
        // `min-width` is what *replaces* the constraint the pill's own bound width would otherwise
        // merge in.
        Rectangle {
            clip: true;
            min-width: 0px;
            preferred-width: root.favorites-row-up ? fav.preferred-width : 0px;
            max-width: root.favorites-row-up ? fav.preferred-width : 0px;

            fav := ActionPill {
                // Fills the Dialog inline rather than hopping through Rust: a synchronous
                // `set_open(true)` mid-click-handler trips Slint's recursion guard.
                PillButton {
                    icon: "add";
                    text: @tr("Add Station");
                    clicked => {
                        // Reset here as well as at the teardown: the session's first open has had
                        // no close before it, and the declared defaults are not the add form's.
                        RadioForm.reset();
                        Dialog.title = @tr("Add Station");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Add");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = "add-station";
                        Dialog.target-id = -1;
                        Dialog.open = true;
                    }
                }

                PillDivider { }

                SortMenuPopup {
                    labels: [@tr("Name"), @tr("Added"), @tr("Plays"), @tr("Last played")];
                    fields: ["name", "added", "plays", "played"];
                    sort-field: Radio.sort-field;
                    sort-dir: Radio.sort-dir;
                    request-sort(f) => { Radio.request-sort(f); }
                }

                PillDivider { }

                // **Import and Export fold in here rather than carrying a pill each**, the trade
                // the Playlists row already makes: they are the rarest actions on the row, so they
                // are what gives up the width. Portable lists, so a station collection survives a
                // database wipe and arrives from whatever the user was using before; both are pure
                // Rust flows over native pickers.
                om := PillOverflowMenu {
                    menu-id: "radio-favorites-overflow";
                    tooltip-text: @tr("More station actions");
                    // Drawn by the host's top-layer frame, out of the body's way.
                    tooltip-overlay: true;

                    MenuItem {
                        label: @tr("Import");
                        icon: "download";
                        clicked => { Radio.import-stations(); }
                    }
                    MenuItem {
                        label: @tr("Export");
                        icon: "upload";
                        clicked => { Radio.export-stations(); }
                    }
                }
            }
        }

        // --- The station page -----------------------------------------------------------------
        //
        // Everything the page can *do*; everything it can *say* is a row in its body. Copy URL and
        // Website went there with the facts they act on.
        //
        // **Starring and removing are the grid's, not the page's.** Every card already carries
        // both, on the tab whose list the answer changes — un-starring from a page is a row
        // leaving a list the page is not showing, and removing is a confirm about membership of a
        // list you are not looking at. Keeping them here meant the same station offering the same
        // two actions twice, and the trash needing to know which tab it was opened from to mean
        // anything. All three of these act on the station itself.
        //
        // One mount for all three tabs: what is on the page is decided by the station, so
        // Recently Played's page is Favorites' page is Browse's.
        if Radio.detail-open: ActionPill {
            PillButton {
                icon: "play_arrow";
                icon-filled: true;
                text: @tr("Play");
                clicked => { Radio.play-station(Radio.detail-station); }
            }
            if Radio.detail-votable || Radio.detail-station.editable: PillDivider { }

            // **Labelled, and no tooltip with it.** Three segments fit the slot, and a label a
            // reader can weigh at a glance beats a glyph they have to hover to identify — which
            // is the trade the two tab rows above already make. A tooltip restating the label is
            // a second copy of the same string.
            if Radio.detail-votable: PillButton {
                icon: "thumb_up";
                icon-size: 16px;
                text: @tr("Vote");
                clicked => {
                    Radio.vote(Radio.detail-station.uuid, Radio.detail-station.id);
                }
            }

            if Radio.detail-votable && Radio.detail-station.editable: PillDivider { }

            if Radio.detail-station.editable: PillButton {
                icon: "edit";
                text: @tr("Edit");
                clicked => { Radio.edit-station(Radio.detail-station); }
            }
        }
    }

    // --- The overflow pill's tooltip anchor ----------------------------------
    //
    // Published, never drawn: see the file header. The rect is read off the pill live rather than
    // snapshotted on the hover edge, so a pill that moves under a parked pointer — a resize,
    // Ctrl+B — keeps its tooltip anchored. Collapsed, the cell takes no events, so `hovered` is
    // false and the frame draws nothing wherever the rect happens to sit.
    out property <length> tip-x: om.absolute-position.x - root.absolute-position.x;
    out property <length> tip-y: om.absolute-position.y - root.absolute-position.y;
    out property <length> tip-w: om.width;
    out property <length> tip-h: om.height;
    out property <string> tip-label: om.tooltip-text;
    out property <bool> tip-visible: om.hovered;
    // Off the pill rather than spelled here: which pills want their trailing edge pinned is
    // `PillButton`'s rule, and the in-tree mount reads the same property.
    out property <bool> tip-align-end: om.icon-only;
}
