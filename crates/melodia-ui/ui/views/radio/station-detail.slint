import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { MaterialIcon } from "../../components/material-icon.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { StationFacts, StationHistory } from "../../components/station-facts.slint";

// A note about the station rather than a control, so not a pill.
component StatusLine inherits HorizontalLayout {
    in property <string> icon;
    in property <brush> tint;
    in property <string> text;

    alignment: start;
    spacing: Theme.pad-xs;
    vertical-stretch: 0;
    // A collapsed em-box beside a line box, which share a centre line rather than a top edge.
    cross-axis-alignment: center;

    MaterialIcon {
        name: root.icon;
        icon-size: 16px;
        icon-color: root.tint;
    }
    Text {
        text: root.text;
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        overflow: elide;
    }
}

// A station's page under the band that morphed into its hero: the band owns the title, artwork,
// chips and actions, this file the facts. No empty state, the song history appearing only once
// the station has announced something.
export component RadioStationDetail inherits Rectangle {
    // Harmless while the band's box is hidden over this page, and right on the frame it returns.
    TouchArea {
        clicked => { Radio.blur-search-tick += 1; }
    }

    VerticalLayout {
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        padding-top: Theme.pad-lg;

        body := Rectangle {
            vertical-stretch: 1;

            // One scroller: the history is capped by its ring, so there's nothing to virtualize.
            sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                content-width: self.width;

                VerticalLayout {
                    spacing: Theme.pad-md;
                    padding-right: Theme.scrollbar-slot;
                    alignment: start;

                    // Only once the directory's check has answered: "it failed" is worth printing,
                    // "nobody asked" isn't.
                    if Radio.detail-check-known: StatusLine {
                        icon: Radio.detail-check-ok ? "check_circle" : "error";
                        tint: Radio.detail-check-ok ? Theme.green : Theme.yellow;
                        text: Radio.detail-check-ok
                            ? @tr("The directory reached this station on its last check.")
                            : @tr("The directory could not reach this station on its last check.");
                    }

                    StationFacts {
                        stream-url: Radio.detail-stream-url;
                        homepage: Radio.detail-station.homepage;
                        codec: Radio.detail-station.codec;
                        bitrate: Radio.detail-station.bitrate;
                        // Only this surface has a directory refresh behind it to state one.
                        votes: Radio.detail-votes;
                        play-count: Radio.detail-station.play_count;
                        open-homepage(url) => { Radio.open-homepage(url); }
                    }

                    if Radio.detail-station-is-playing && Radio.history-rows.length > 0: StationHistory {
                        rows: Radio.history-rows;
                    }
                }
            }

            OverlayScrollbar {
                horizontal: false;
                x: parent.width - self.width;
                width: Theme.scrollbar-slot;
                height: 100%;
                visible-size: sv.visible-height;
                content-size: sv.content-height;
                offset: -sv.content-y;
                scroll-to(o) => { sv.content-y = -o; }
            }
        }
    }
}
