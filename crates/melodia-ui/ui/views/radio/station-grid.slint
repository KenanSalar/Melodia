import { ListView } from "std-widgets.slint";
import { RadioStationGridRow, RadioStationRow } from "../../models.slint";
import { CardCell } from "../../components/grid/card-cell.slint";
import { StationCard } from "station-card.slint";

// `EntityCardGrid`'s contract over `RadioStationGridRow`, its own component because a station card
// carries three text lines and its own hover controls. All three Radio tabs mount it.
export component StationGrid inherits Rectangle {
    in property <[RadioStationGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 246px;
    // The gap is baked in, a `ListView` laying its delegates back-to-back with no `spacing`.
    in property <length> row-height: 266px;
    in property <length> gap: 20px;

    // The repaint token; at `0` Rust answers cache-only, the logo tier being released on a leave
    // because the card lays out off the decoded logo's size.
    in property <int> covers-generation: 0;
    pure callback request-logo(string /*artwork_path*/, int /*generation*/) -> image;

    in property <int> logo-decode-size;

    // The kept tabs only.
    in property <bool> manageable;

    // Off on Favorites, whose rows are starred by definition.
    in property <bool> star-marks-kept: true;

    // Off by default, as on `EntityCardGrid`: a badge says nothing on a list not ranked by it.
    in property <bool> show-play-count: false;

    // One scope per tab. Cards pick by `select_key`, so Browse's id-less stations take part.
    in property <string> selection-scope;
    // `Radio.tab-*`, the list these cards are on, which the menu reads for what removal means.
    in property <int> list;

    callback station-clicked(RadioStationRow);
    callback play-clicked(RadioStationRow);
    callback favorite-clicked(RadioStationRow);
    callback homepage-clicked(RadioStationRow);
    callback edit-clicked(RadioStationRow);
    callback remove-clicked(RadioStationRow);

    // A positive `v-offset` is px scrolled, as on `TrackList` and the entity grids.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.content-height;
    out property <length> v-offset: -list.content-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.content-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        // Pinned rather than left to the style, a card click and a drag-pan being one gesture:
        // where the pan is on it takes a press that drifts, which reads as "sometimes it doesn't
        // open". The wheel scrolls either way; `slint-pitfalls.md` has the mechanism.
        mouse-drag-pan-enabled: false;

        for grid-row in root.rows: Rectangle {
            // A `ListView` delegate needs a fixed height or the virtualization math breaks.
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for station in grid-row.stations: cell := CardCell {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    scope: root.selection-scope;
                    card-kind: "station";
                    card-id: station.select_key;
                    station: station;
                    station-list: root.list;

                    StationCard {
                        card-width: root.card-width;
                        card-height: root.card-height;
                        artwork-path: station.artwork_path;
                        cover: root.request-logo(station.artwork_path, root.covers-generation);
                        name: station.name;
                        // Each separator hangs off what precedes it, so a missing field never
                        // leaves a leading middot; the directory often reports `bitrate` as `0`.
                        meta: station.country
                            + (station.country != "" && station.codec != "" ? " · " : "")
                            + station.codec
                            + ((station.country != "" || station.codec != "") && station.bitrate > 0
                                ? " · " : "")
                            + (station.bitrate > 0 ? @tr("{} kbps", station.bitrate) : "");
                        tags: station.tags;
                        logo-decode-size: root.logo-decode-size;
                        tile-color-1: station.tile_color_1;
                        tile-color-2: station.tile_color_2;
                        monogram: station.monogram;
                        is-favorite: station.is_favorite;
                        // An empty uuid is a station typed in by hand.
                        starrable: station.uuid != "";
                        star-marks-kept: root.star-marks-kept;
                        // On the row rather than the uuid: a directory entry already naming a site
                        // has nothing to set and everything to lose.
                        editable: root.manageable && station.editable;
                        removable: root.manageable;
                        homepage-known: station.homepage != "";
                        play-count: root.show-play-count ? station.play_count : 0;
                        clicked => { root.station-clicked(station); }
                        play-clicked => { root.play-clicked(station); }
                        favorite-clicked => { root.favorite-clicked(station); }
                        homepage-clicked => { root.homepage-clicked(station); }
                        edit-clicked => { root.edit-clicked(station); }
                        remove-clicked => { root.remove-clicked(station); }

                        selected: cell.selected;
                        selection-live: cell.selection-live;
                        select-clicked(shift, ctrl) => { cell.pick(shift, ctrl); }
                        context-requested(x, y) => { cell.open-menu(x, y); }
                        menu-open: cell.menu-open;
                    }
                }
            }
        }
    }
}
