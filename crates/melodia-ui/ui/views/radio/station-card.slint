import { Theme } from "../../theme.slint";
import { CardFavoriteButton } from "../../components/grid/card-favorite-button.slint";
import { EntityCard } from "../../components/grid/entity-card.slint";
import { IconButton } from "../../components/icon-button.slint";

// One station, as all three Radio tabs draw it: an `EntityCard` carrying its own hover controls.
//
// The card frame is not restated here — the tile, the hover fill and zoom, the elided text block
// and the play-count badge are all that component's, and the third line under the tile is its
// `subtitle2`. What is genuinely a station's own is the overlay's five controls and the rule that
// the star outlives a hover, so those are what this file holds.
//
// **The tags line is a string, not a chip strip.** `MetaChipStrip` carries a `changed` tracker
// over a layout property, and a tracker inside a `ListView` delegate outlives the delegate the
// virtualization destroys. Rust hands the line over already trimmed and joined.
export component StationCard inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    in property <string> name;
    in property <string> meta;
    in property <string> tags;
    // The logo-less tile's two stops and its lettering, hashed off the name in `ui::radio::rows`.
    in property <color> tile-color-1;
    in property <color> tile-color-2;
    in property <string> monogram;
    in property <bool> is-favorite;
    // A station typed in by hand has no star: un-starring it would drop it from the only list
    // that shows it, leaving a row nothing can reach. Remove is its affordance instead.
    in property <bool> starrable: true;
    // Whether being a favorite is worth marking on this list. False where the list *is* the
    // favorites, so the mark answers nothing — see the button.
    in property <bool> star-marks-kept: true;
    in property <bool> editable;
    in property <bool> removable;
    in property <bool> homepage-known;
    // Recently Played only, where it is what tells a station listened to daily from one played
    // once by accident. `0` everywhere else draws nothing.
    in property <int> play-count: 0;
    // `EntityCard`'s selection, passed through. Only the kept tabs turn it on, Browse's stations
    // having no row id to select by.
    in property <bool> selectable;
    in property <bool> selected;
    in property <bool> selection-live;

    in property <length> card-width: 180px;
    // The square tile plus three text lines, where an entity card of the same width carries two.
    in property <length> card-height: 246px;
    // `Radio.logo-decode-size`, drilled like `covers-generation` — this file imports no global.
    in property <int> logo-decode-size;

    // What the stored logo would draw at 1:1 here. The tier decodes to `logo-decode-size` physical
    // pixels across this tile and never pads a small source up, so the source's own width is the
    // fraction of the tile it can cover — scale-free, both numbers being physical. What
    // `ArtworkImage` does with it, and the budget it does it against, is the tile's own.
    //
    // Off the card's published square rather than a second copy of its formula, which would skew
    // this silently if the card's padding ever moved.
    property <length> logo-native-size: root.logo-decode-size > 0
        ? card-body.tile-size * root.cover.width / root.logo-decode-size
        : card-body.tile-size;

    callback clicked();
    callback play-clicked();
    callback favorite-clicked();
    callback homepage-clicked();
    callback edit-clicked();
    callback remove-clicked();
    callback select-clicked(bool /*shift*/, bool /*ctrl*/);
    callback context-requested(length /*x*/, length /*y*/);
    callback context-released();

    width: card-width;
    height: card-height;

    card-body := EntityCard {
        width: 100%;
        height: 100%;
        card-width: root.card-width;
        card-height: root.card-height;

        artwork-path: root.artwork-path;
        cover: root.cover;
        title: root.name;
        subtitle: root.meta;
        subtitle2: root.tags;
        play-count: root.play-count;

        // A favicon is small by trade, so a good share of the directory has a logo that cannot
        // cross the tile without going soft. Those float at a size that stays sharp, over the same
        // gradient a station with no logo at all gets.
        native-size: root.logo-native-size;
        // A station whose logo is missing, dead, or too small to draw gets its own two stops and
        // its initials instead — a third of a directory page has no logo field at all, and one
        // repeated glyph across them is what makes Browse read as a grid of icons rather than of
        // stations. `ui::radio::identity` keeps the stops deep enough that this one ink is legible
        // on every station.
        tile-bg: @linear-gradient(135deg, root.tile-color-1, root.tile-color-2);
        tile-icon-color: Theme.tile-ink;
        fallback-text: root.monogram;
        // Still the last resort, for a name with no letters to take initials from.
        fallback-icon: "radio";

        // The body opens the station's page; the play button over the tile is what tunes in.
        clicked => { root.clicked(); }

        selectable: root.selectable;
        selected: root.selected;
        selection-live: root.selection-live;
        select-clicked(shift, ctrl) => { root.select-clicked(shift, ctrl); }
        context-requested(x, y) => { root.context-requested(x, y); }
        context-released => { root.context-released(); }

        // The four below are hover affordances and ride the card's own single overlay fade; the
        // star is not one of them and sits outside, below.
        show-overlay-actions: true;
        overlay-hovered: fav_btn.has-hover
            || play_btn.has-hover
            || home_btn.has-hover
            || edit_btn.has-hover
            || remove_btn.has-hover;

        // **In the middle of the tile, the top left being the selection box's** as on every
        // selectable card, and the bottom right the play count's. A body click aimed at the
        // artwork still opens the page anywhere but on the button itself.
        //
        // **The four below frame the tile off `card-body`'s published metrics, never off
        // `parent`.** These are laid out inside the card's overlay slot, but a `@children` element
        // resolves names where it is *written*, so `parent` here is the `EntityCard` — its full
        // height, not the square. The source reads correctly either way and only the generated
        // tree tells them apart, which is what `crates/melodia/tests/entity_card_overlay.rs` walks
        // for.
        play_btn := IconButton {
            x: (card-body.tile-size - self.width) / 2;
            y: (card-body.tile-size - self.height) / 2;
            icon: "play_arrow";
            icon-size: 18px;
            diameter: 30px;
            filled: true;
            idle-bg: Theme.floating-chrome-bg;
            clicked => { root.play-clicked(); }
        }

        // Under the selection box's corner, which is empty on Browse, whose cards draw no box.
        home_btn := IconButton {
            visible: root.homepage-known;
            x: Theme.pad-sm;
            y: card-body.select-box-bottom + Theme.pad-xs;
            icon: "link";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            clicked => { root.homepage-clicked(); }
        }

        // Bottom-left, clear of the column above: the two that change the row rather than
        // following it. Only the kept tabs mount them, so Browse looks exactly as it did.
        remove_btn := IconButton {
            visible: root.removable;
            x: Theme.pad-sm;
            y: card-body.tile-size - self.height - Theme.pad-sm;
            icon: "delete";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            hover-fg: Theme.danger;
            clicked => { root.remove-clicked(); }
        }

        edit_btn := IconButton {
            visible: root.editable;
            x: Theme.pad-sm + remove_btn.width + Theme.pad-xs;
            y: card-body.tile-size - self.height - Theme.pad-sm;
            icon: "edit";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            clicked => { root.edit-clicked(); }
        }
    }

    // Browse and Recently Played both mix kept and unkept stations, a station played out of
    // Browse being kept without a star, so the mark says something on both.
    fav_btn := CardFavoriteButton {
        visible: root.starrable;
        card-width: root.card-width;
        is-favorite: root.is-favorite;
        marks-kept: root.star-marks-kept;
        card-hovered: card-body.card-hovered;
        clicked => { root.favorite-clicked(); }
    }
}
