import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { RadioSuggestionRow } from "../../models.slint";
import { FilledChip } from "../../components/filled-chip.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// A scope the needle could be asking for: "Language: Turkish · 281 stations". Taking one fills
// the chip of that name and empties the box in one query edit (`ui::radio::suggest::apply`). The
// scope names are the chips' own msgids, so the two can't be called different things in a locale.
//
// A `FilledChip` rather than an `ActionPill`, for `FacetChip`'s reason: a bound root `width` would
// floor the window's resize at the widest locale's label.
export component SuggestionPill inherits Rectangle {
    in property <RadioSuggestionRow> data;

    callback picked();

    private property <string> scope-label:
        root.data.kind == Radio.facet-country ? @tr("Country")
        : root.data.kind == Radio.facet-language ? @tr("Language")
        : root.data.kind == Radio.facet-tag ? @tr("Genre")
        : root.data.kind == Radio.facet-codec ? @tr("Format")
        : @tr("Bitrate");

    // A bitrate names a floor rather than a value, and reads the way its own chip shows it.
    private property <string> scope-value: root.data.kind == Radio.facet-bitrate
        ? @tr("{} kbps and up", root.data.name)
        : root.data.name;

    height: 32px;
    min-width: 0px;
    preferred-width: chip.preferred-width;
    max-width: chip.preferred-width;

    chip := FilledChip {
        height: 100%;
        clicked => { root.picked(); }

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-md;
            spacing: Theme.pad-xs;
            cross-axis-alignment: center;

            MaterialIcon {
                name: "filter_alt";
                icon-size: 16px;
                icon-color: Theme.subtext0;
            }

            Text {
                // Leading U+200E, as `FacetOption` marks the same names: the value can be any
                // script, and the mark pins the line's direction and its elide edge.
                text: "\u{200e}" + @tr("{}: {}", root.scope-label, root.scope-value);
                color: Theme.text;
                font-size: Theme.font-size-sm;
                overflow: elide;
            }

            // `-1` is a scope read off the needle's shape (a bitrate floor), which nothing counted.
            if root.data.station_count >= 0: Text {
                text: @tr("{n} station" | "{n} stations" % root.data.station_count);
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                overflow: elide;
            }
        }
    }
}
