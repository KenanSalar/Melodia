import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { RadioFacetRow } from "../../models.slint";
import { FilledChip } from "../../components/filled-chip.slint";
import { FocusLossWatcher } from "../../components/focus-loss-watcher.slint";
import { MaterialIcon } from "../../components/material-icon.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { PopupFit } from "../../components/popup-fit.slint";
import { PopupSurface } from "../../components/popup-surface.slint";
import { SearchBar } from "../../components/search-bar.slint";

component FacetOption inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active;

    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface1 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; enabled: !Theme.recoloring; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        // The row's own inset plus the scrollbar's lane: flush against the bar, the count's last
        // pixels sit under a `TouchArea` that eats the click landing on them.
        padding-right: Theme.pad-sm + Theme.scrollbar-slot;
        spacing: Theme.pad-sm;
        cross-axis-alignment: center;

        Text {
            horizontal-stretch: 1;
            text: "‎" + root.label;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.font-size-md;
            overflow: elide;
        }
        // The bitrate floors are ours, so they arrive uncounted.
        if root.count > 0: Text {
            horizontal-stretch: 0;
            text: root.count;
            color: Theme.overlay1;
            font-size: Theme.font-size-sm;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A filter chip over the Browse grid and the picker behind it. The options are an input, so the
// bitrate chip's fixed list needs no second component and no fetch. The needle goes to Rust, Slint
// rejecting an inline `for … : if …` and a country list running to hundreds.
export component FacetChip inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    // Empty means nothing is picked.
    in property <string> value;
    in property <[RadioFacetRow]> options;
    in property <bool> loading: false;
    // The four directory facets need a needle; the bitrate list is five entries and does not.
    in property <bool> searchable: true;
    // Reset by Rust on `opened`, beside the model it narrows: the two have to move together.
    in-out property <string> needle;

    callback opened(int /*kind*/);
    callback needle-edited(string);
    callback picked(int /*kind*/, string /*name*/, string /*code*/);
    callback cleared(int /*kind*/);

    property <bool> is-set: root.value != "";
    // Named, the filter box's slot being this less the surface's padding.
    property <length> popup-w: 320px;
    // The picker's height wherever the window has room for it; the list scrolls inside either way.
    property <length> popup-h: 380px;
    property <length> popup-gap: 4px;

    height: 32px;
    // Never a bound `width`, which is reported as both `min` and `max`: five locale-sized labels
    // would floor the window's resize.
    min-width: 0px;
    preferred-width: chip.preferred-width;
    max-width: chip.preferred-width;

    chip := FilledChip {
        height: 100%;
        selected: root.is-set;
        held: popup.is-open;
        clicked => {
            if (root.is-set) {
                root.cleared(root.kind);
            } else {
                root.opened(root.kind);
                popup.show();
            }
        }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-sm;
            spacing: 2px;
            cross-axis-alignment: center;

            Text {
                text: root.is-set ? root.value : root.label;
                color: chip.ink;
                font-size: Theme.font-size-sm;
                overflow: elide;
            }
            MaterialIcon {
                // A set chip offers the clear; an unset one says it opens something.
                name: root.is-set ? "close" : "expand_more";
                icon-size: 18px;
                icon-color: chip.ink;
            }
        }
    }

    popup := PopupWindow {
        // Both dimensions spelled, a popup sized by its scrolling body growing to the whole list.
        // Trailing edges aligned: the strip sits at the band's right, where a left-anchored picker
        // is clamped flush to the window and off its chip, as `ColumnTogglePopup` answers too.
        property <length> above-y: root.absolute-position.y - root.popup-gap;
        property <length> below-y: root.absolute-position.y + chip.height + root.popup-gap;
        property <bool> opens-above:
            PopupFit.opens-above(self.above-y, self.below-y, root.popup-h);

        x: root.width - self.width;
        y: self.opens-above ? -root.popup-gap - self.height : chip.height + root.popup-gap;
        width: root.popup-w;
        height: PopupFit.side-h(self.above-y, self.below-y, root.popup-h);
        // The rows need their own handlers to run before it closes, so they close it themselves.
        close-policy: close-on-click-outside;

        FocusLossWatcher {
            close => { popup.close(); }
        }

        PopupSurface {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: Theme.pad-xs;
                spacing: Theme.pad-xs;

                if root.searchable: SearchBar {
                    inset: true;
                    input-width: root.popup-w - 2 * Theme.pad-xs;
                    placeholder: @tr("Filter…");
                    text <=> root.needle;
                    edited(t) => {
                        root.needle-edited(t);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    if root.loading: Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: @tr("Loading…");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                    }

                    if !root.loading && root.options.length == 0: Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: @tr("Nothing to pick from");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        overflow: elide;
                        width: parent.width - 2 * Theme.pad-md;
                        horizontal-alignment: center;
                    }

                    list := ListView {
                        width: 100%;
                        height: 100%;
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: always-off;
                        // An option click picks the facet, so it answers the way a card
                        // does; argument on `views/radio/station-grid.slint`.
                        mouse-drag-pan-enabled: false;

                        for option in root.options: FacetOption {
                            label: option.name;
                            count: option.station_count;
                            active: option.name == root.value;
                            clicked => {
                                root.picked(root.kind, option.name, option.code);
                                popup.close();
                            }
                        }
                    }

                    OverlayScrollbar {
                        horizontal: false;
                        x: parent.width - self.width;
                        width: Theme.scrollbar-slot;
                        height: 100%;
                        visible-size: list.visible-height;
                        content-size: list.content-height;
                        offset: -list.content-y;
                        scroll-to(o) => { list.content-y = -o; }
                    }
                }
            }
        }
    }
}
