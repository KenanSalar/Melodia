import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { DuplicatesUi } from "../../globals/duplicates.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// The duplicate finder's way in. The dialog raises at once and fills behind its find, so its one
// opener stays here rather than in `Dialog`, which keeps those for a raise that waits.
export component DuplicatesSection inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> category-name;

    property <string> card-title: @tr("Duplicates");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    property <string> find-label: @tr("Duplicate tracks");
    property <string> find-desc: @tr("Find songs the library holds more than once, and pick the copies you don't need.");

    property <bool> show-find: row-visible(find-label, find-desc);

    out property <bool> has-matches: show-find;

    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            if root.show-find: SettingRow {
                icon: "library_music";
                label: root.find-label;
                description: root.find-desc;
                SectionButton {
                    label: @tr("Find…");
                    icon: "";
                    primary: false;
                    clicked => {
                        Dialog.title = @tr("Duplicate Tracks");
                        Dialog.message = @tr("Songs the library seems to hold more than once. Pick the copies you don't need.");
                        Dialog.confirm-label = @tr("Continue");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = DialogKind.duplicates;
                        DuplicatesUi.busy = true;
                        Dialog.open = true;
                        DuplicatesUi.find();
                    }
                }
            }
        }
    }
}
