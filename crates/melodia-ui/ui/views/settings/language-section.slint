import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { ChoiceList } from "../../components/settings/choice-list.slint";

// The native names `ui::settings::locale::install_locale` fills stay untranslated, each in its own
// script.
//
// The pattern every section follows: a thin Rectangle hosting its card inside `if has-matches:`,
// so a card matching nothing leaves the layout, and the flag `out` so the page can spot the
// all-hidden state. The local `row-visible` binds the title once, keeping each row's call to two
// arguments.
export component LanguageSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> category-name;

    property <string> card-title: @tr("Language");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Every option's own name, so a search for one finds the card: the way back from a UI in a
    // language the reader can't read.
    property <string> names-haystack: Settings.language-search-terms;

    out property <bool> has-matches: row-visible(names-haystack, "");

    // The wrapper every section needs: a `Rectangle` sizes to a layout child, never to an `if`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            // Rust resolves the code, switches the bundled translation and persists.
            ChoiceList {
                options: Settings.language-names;
                selected-index <=> Settings.language-idx;
                selected(idx) => { Settings.language-changed(idx); }
            }
        }
    }
}
