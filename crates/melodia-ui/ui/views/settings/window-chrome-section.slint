import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { Dialog } from "../../globals/dialog.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { ChipGroup } from "../../components/settings/chip-group.slint";

// The OS-facing window shell — titlebar mode, decoration buttons, corner
// radius, tray. Split from `appearance-section.slint`: chrome is set once and
// forgotten, where the palette rows carry the page's traffic.
//
// Search visibility follows `language-section.slint` — each row ANDs its state
// condition with the predicate, and a divider gates on a visible row either
// side so the card can't end on a stranded one.
export component WindowChromeSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> native-titlebar: Theme.use-native-titlebar;

    in property <string> tab-name;

    property <string> card-title: @tr("Window");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Each row's pair, declared once and read by both the visibility term and the row. Three of
    // the descriptions swap with live state, so whichever form is on screen is the one in the
    // haystack — which only holds while there is one copy of it.
    property <string> os-managed-desc: @tr("Managed by the operating system");
    property <string> native-titlebar-label: @tr("Native Title Bar");
    property <string> native-titlebar-desc: @tr("Use the operating system's native title bar instead of the custom one. Restart required to apply.");
    property <string> match-unfocused-label: @tr("Match Unfocused Window Background");
    property <string> match-unfocused-desc: !Theme.use-native-titlebar
        ? @tr("Only available with the native title bar.")
        : @tr("Tint the sidebar and now-playing bar toward the content background when the window loses focus.");
    property <string> corner-radius-label: @tr("Window Corner Radius");
    property <string> tb-style-label: @tr("Decoration Button Style");
    property <string> tb-side-label: @tr("Decoration Button Side");
    property <string> tray-icon-label: @tr("System Tray Icon");
    property <string> tray-icon-desc: @tr("Show a Melodia icon in the system tray with playback controls.");
    property <string> close-to-tray-label: @tr("Close to Tray");
    property <string> close-to-tray-desc: Settings.tray-active
        ? @tr("Keep Melodia running in the system tray when you close the window, instead of quitting.")
        : @tr("Available only while the system tray icon is active.");
    // The three OS-managed rows share one description, blank unless the native bar is on.
    property <string> os-managed-when-native: root.native-titlebar ? os-managed-desc : "";

    property <bool> show-native-titlebar: row-visible(native-titlebar-label, native-titlebar-desc);
    property <bool> show-match-unfocused: Settings.match-unfocused-supported
        && row-visible(match-unfocused-label, match-unfocused-desc);
    property <bool> show-corner-radius: row-visible(corner-radius-label, os-managed-when-native);
    property <bool> show-titlebar-button-style: row-visible(tb-style-label, os-managed-when-native);
    property <bool> show-titlebar-button-side: row-visible(tb-side-label, os-managed-when-native);
    property <bool> show-tray-icon: row-visible(tray-icon-label, tray-icon-desc);
    property <bool> show-close-to-tray: row-visible(close-to-tray-label, close-to-tray-desc);

    out property <bool> has-matches:
        show-native-titlebar || show-match-unfocused || show-corner-radius
            || show-titlebar-button-style || show-titlebar-button-side
            || show-tray-icon || show-close-to-tray;

    property <bool> any-above-match: show-native-titlebar;
    property <bool> any-above-corner: any-above-match || show-match-unfocused;
    property <bool> any-above-tb-style: any-above-corner || show-corner-radius;
    property <bool> any-above-tb-side: any-above-tb-style || show-titlebar-button-style;
    property <bool> any-above-tray-icon: any-above-tb-side || show-titlebar-button-side;
    property <bool> any-above-close-to-tray: any-above-tray-icon || show-tray-icon;

    // Square=0, KDE=6, Windows 11=8, macOS=10, GNOME=15. Presets only, no manual
    // stepper: a radius in 1..=5 falls under femtovg's visible-arc threshold at
    // 1× DPI and reads as Square anyway. It also lets `custom-titlebar.slint`'s
    // hover-radius math assume 0 or >= 6 with no piecewise floor.
    pure function px-to-preset(px: int) -> int {
        if (px == 0)  { return 0; }
        if (px == 6)  { return 1; }
        if (px == 8)  { return 2; }
        if (px == 10) { return 3; }
        if (px == 15) { return 4; }
        return -1;
    }
    pure function preset-to-px(idx: int) -> int {
        if (idx == 0) { return 0; }
        if (idx == 1) { return 6; }
        if (idx == 2) { return 8; }
        if (idx == 3) { return 10; }
        if (idx == 4) { return 15; }
        return 0;
    }

    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        // Slint reads `Window.no-frame` once at first show, so a runtime flip
        // would leave the OS frame stale — hence the restart dialog, with
        // `target-id: 1|0` carrying the requested value. `manual: true` keeps
        // the switch anchored to the persisted value until the new process
        // boots, so cancelling needs no explicit revert.
        if root.show-native-titlebar: SettingRow {
            icon: "title";
            label: root.native-titlebar-label;
            description: root.native-titlebar-desc;
            ToggleSwitch {
                checked: root.native-titlebar;
                manual: true;
                toggled(new-value) => {
                    Dialog.kind = "restart-titlebar";
                    Dialog.target-id = new-value ? 1 : 0;
                    Dialog.title = @tr("Restart Required");
                    Dialog.message = new-value
                        ? @tr("Switching to the native title bar requires restarting Melodia. Restart now?")
                        : @tr("Switching to the custom title bar requires restarting Melodia. Restart now?");
                    Dialog.confirm-label = @tr("Restart");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
        }

        if root.any-above-match && root.show-match-unfocused: SectionDivider {}

        // KDE-only, so hidden off-KDE; greyed out under a custom titlebar
        // because it mirrors OS-drawn decorations fading on focus loss, and we
        // paint our own. `Theme.window-focused` is written unconditionally by
        // `winit_filter.rs`; the tint itself is gated at the binding sites in
        // `sidebar.slint` / `now-playing-bar.slint` on all three conditions.
        if root.show-match-unfocused: SettingRow {
            icon: "tonality";
            label: root.match-unfocused-label;
            description: root.match-unfocused-desc;
            disabled: !Theme.use-native-titlebar;
            ToggleSwitch {
                checked <=> Settings.match-unfocused-bg;
                toggled(v) => { Settings.match-unfocused-bg-changed(v); }
            }
        }

        if root.any-above-corner && root.show-corner-radius: SectionDivider {}

        // The OS owns the radius under a native titlebar. Stacked because the
        // chips sit below the description.
        if root.show-corner-radius: SettingRowStacked {
            icon: "rounded_corner";
            label: root.corner-radius-label;
            description: root.os-managed-when-native;
            disabled: root.native-titlebar;

            if !root.native-titlebar: ChipGroup {
                // "Square" is a generic UI label and takes `@tr()`; the rest are
                // brand names and never do.
                options: [@tr("Square"), "KDE", "Windows 11", "macOS", "GNOME"];
                // `manual: true` — `selected-index` is a derived expression, and
                // a self-write on click would orphan the px-to-preset binding.
                manual: true;
                selected-index: px-to-preset(Settings.corner-radius);
                selected(i) => {
                    Settings.corner-radius = preset-to-px(i);
                    Settings.corner-radius-changed(Settings.corner-radius);
                }
            }
        }

        if root.any-above-tb-style && root.show-titlebar-button-style: SectionDivider {}

        // Standard Material glyphs vs macOS traffic lights. Disabled under the
        // native titlebar, which owns its own buttons.
        if root.show-titlebar-button-style: SettingRowStacked {
            icon: "category";
            label: root.tb-style-label;
            description: root.os-managed-when-native;
            disabled: root.native-titlebar;

            if !root.native-titlebar: ChipGroup {
                // Same brand-name rule as the corner-radius chips above.
                options: [@tr("Standard"), "macOS"];
                selected-index <=> Settings.titlebar-button-style;
                selected(i) => {
                    Settings.titlebar-button-style-changed(i);
                }
            }
        }

        if root.any-above-tb-side && root.show-titlebar-button-side: SectionDivider {}

        // Independent of the style above; close stays at the outer window
        // corner in all four combinations.
        if root.show-titlebar-button-side: SettingRowStacked {
            icon: "swap_horiz";
            label: root.tb-side-label;
            description: root.os-managed-when-native;
            disabled: root.native-titlebar;

            if !root.native-titlebar: ChipGroup {
                options: [@tr("Right"), @tr("Left")];
                selected-index <=> Settings.titlebar-button-side;
                selected(i) => {
                    Settings.titlebar-button-side-changed(i);
                }
            }
        }

        if root.any-above-tray-icon && root.show-tray-icon: SectionDivider {}

        // Master toggle for the tray subsystem — off, `main.rs` skips
        // `tray_bridge::install` entirely (no D-Bus connection, no service
        // thread). That gate reads the value once at startup, so this takes the
        // same restart-dialog shape as the Native Title Bar row above.
        if root.show-tray-icon: SettingRow {
            icon: "dock_to_right";
            label: root.tray-icon-label;
            description: root.tray-icon-desc;
            ToggleSwitch {
                checked: Settings.tray-enabled;
                manual: true;
                toggled(new-value) => {
                    Dialog.kind = "restart-tray";
                    Dialog.target-id = new-value ? 1 : 0;
                    Dialog.title = @tr("Restart Required");
                    Dialog.message = @tr("Changing the system tray icon requires restarting Melodia. Restart now?");
                    Dialog.confirm-label = @tr("Restart");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
        }

        if root.any-above-close-to-tray && root.show-close-to-tray: SectionDivider {}

        // Greyed out whenever no tray icon is active — the toggle above is off,
        // or the session has no StatusNotifier host — since it then does
        // nothing. Wired in `crates/melodia-views/src/ui/appearance/window_settings.rs`.
        if root.show-close-to-tray: SettingRow {
            icon: "move_to_inbox";
            label: root.close-to-tray-label;
            description: root.close-to-tray-desc;
            disabled: !Settings.tray-active;
            ToggleSwitch {
                checked <=> Settings.close-to-tray;
                toggled(v) => { Settings.close-to-tray-changed(v); }
            }
        }
    }
    }
}
