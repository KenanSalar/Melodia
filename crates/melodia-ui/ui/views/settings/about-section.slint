import { Settings } from "../../settings.slint";
import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MelodiaUpdater } from "../../globals/updater.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// The version reads `MelodiaUpdater.current-version`, so About and Updates can't disagree. The two
// support pages open through `ui::support`, which owns them because the support toast fires
// Ko-fi's callback. Search visibility follows `language-section.slint`.
export component AboutSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> category-name;

    property <string> card-title: @tr("About");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // The brands and the SPDX id stay untranslated but belong in the haystack, being what a user
    // would type.
    property <string> app-label: "Melodia";
    // Translators: `{}` is the version number, such as 0.9.2
    property <string> version-desc: @tr("Version {}", MelodiaUpdater.current-version);
    // Translators: `{}` is the author's name, a proper noun kept as is
    property <string> author-label: @tr("Made by {}", "Kenan Salar");
    property <string> repo-label: "GitHub";
    // Translators: support as in funding the project, not technical support
    property <string> support-label: @tr("Support Melodia");
    property <string> support-desc: @tr("Melodia is free and open source. Support helps keep it going.");
    property <string> license-label: @tr("License");
    property <string> license-desc: "AGPL-3.0-or-later";
    property <string> kofi-label: "Ko-fi";
    property <string> sponsors-label: "GitHub Sponsors";
    property <string> welcome-label: @tr("Welcome Guide");
    property <string> welcome-desc: @tr("Run the first-run setup again.");
    // Translators: a button in a narrow slot, so keep it short
    property <string> welcome-action: @tr("Show");

    property <bool> show-app: row-visible(app-label, version-desc);
    property <bool> show-author: row-visible(author-label, repo-label);
    // The buttons' brands are terms too, the row's own text naming neither.
    property <bool> show-support: row-visible(support-label, support-desc)
        || row-visible(kofi-label, sponsors-label);
    property <bool> show-license: row-visible(license-label, license-desc);
    property <bool> show-welcome: row-visible(welcome-label, welcome-desc);

    out property <bool> has-matches: show-app || show-author || show-support || show-license
        || show-welcome;

    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            if root.show-app: SettingRow {
                icon: "info";
                label: root.app-label;
                description: root.version-desc;
            }

            if root.show-app && root.show-author: SectionDivider {}
            if root.show-author: SettingRow {
                icon: "person";
                label: root.author-label;
                SectionButton {
                    label: root.repo-label;
                    icon: "";
                    primary: false;
                    clicked => { Settings.open-repository(); }
                }
            }

            // The card's only filled buttons: they ask for something rather than going somewhere,
            // and share one shape and fill so neither reads as preferred. Ko-fi's mark keeps its
            // colours, reading on any accent; GitHub's is one colour, so Sponsors takes a glyph.
            if (root.show-app || root.show-author) && root.show-support: SectionDivider {}
            if root.show-support: SettingRow {
                icon: "favorite";
                label: root.support-label;
                description: root.support-desc;
                // The row stacks its controls, so the pair needs a line of its own.
                HorizontalLayout {
                    spacing: Theme.pad-sm;
                    SectionButton {
                        label: root.kofi-label;
                        icon: "";
                        leading-image: @image-url("../../assets/icons/kofi-symbol.svg");
                        corner-radius: Theme.radius-md;
                        primary: true;
                        clicked => { Settings.open-kofi(); }
                    }
                    SectionButton {
                        label: root.sponsors-label;
                        icon: "favorite";
                        corner-radius: Theme.radius-md;
                        primary: true;
                        clicked => { Settings.open-github-sponsors(); }
                    }
                }
            }

            if (root.show-app || root.show-author || root.show-support) && root.show-license: SectionDivider {}
            if root.show-license: SettingRow {
                icon: "balance";
                label: root.license-label;
                description: root.license-desc;
            }

            // Wired from `ui/onboarding/`, not `about.rs`, so neither the row nor the feature knows
            // about the other.
            if (root.show-app || root.show-author || root.show-support || root.show-license)
                && root.show-welcome: SectionDivider {}
            if root.show-welcome: SettingRow {
                icon: "waving_hand";
                label: root.welcome-label;
                description: root.welcome-desc;
                SectionButton {
                    label: root.welcome-action;
                    icon: "";
                    primary: false;
                    clicked => { Settings.run-onboarding(); }
                }
            }
        }
    }
}
