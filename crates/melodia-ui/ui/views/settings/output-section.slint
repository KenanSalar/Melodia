import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SignalPathUi } from "../../globals/signal-path.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { ChipGroup } from "../../components/settings/chip-group.slint";
import { Dropdown } from "../../components/settings/dropdown.slint";
import { SliderTrack } from "../../components/slider-track.slint";

// One step of the signal path: a dot in its grade's colour, what the step is, and what it did.
// Denser than a `SettingRow` because eight of them sit under one heading; the dot takes the icon
// column so the labels line up with the rows above.
component StageRow inherits HorizontalLayout {
    in property <int> grade;
    in property <string> label;
    in property <string> value;

    padding-left: Theme.pad-lg;
    padding-right: Theme.pad-lg;
    padding-top: Theme.pad-xs;
    padding-bottom: Theme.pad-xs;
    spacing: Theme.pad-lg;

    Rectangle {
        width: SettingsPage.row-icon-w;
        Rectangle {
            width: 8px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.grade == 0 ? Theme.green : root.grade == 1 ? Theme.yellow : Theme.red;
        }
    }
    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text-muted;
        font-size: Theme.font-size-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

// How the audio device is opened, and what the playing track goes through to reach it. Search
// visibility follows `playback-section.slint`.
export component OutputSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Output");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // A slider fraction as the whole ten milliseconds the readout shows.
    pure function resync-step(fraction: float) -> float {
        return round(fraction * Settings.output-resync-max-ms / 10) * 10;
    }

    property <string> mode-label: @tr("Output Mode");
    property <string> mode-desc: @tr("Exclusive gives Melodia the audio device alone: other apps can't play through it while Melodia plays, and the system mixer can't change the sound");

    property <string> device-label: @tr("Exclusive Device");
    property <string> device-desc: @tr("The sound card exclusive output takes");

    property <string> period-label: @tr("Buffer Period");
    property <string> period-desc: @tr("How much audio the device is handed at a time. Longer periods ride out a busy system; shorter ones react sooner");

    property <string> polling-label: @tr("Polling Mode");
    property <string> polling-desc: @tr("Top the device up on a timer instead of waiting for it to ask. Try it if a USB device stutters or crackles in exclusive mode");

    property <string> hardware-volume-label: @tr("Hardware Volume");
    property <string> hardware-volume-desc: @tr("Turn the device's own volume control instead of scaling the samples, so the volume slider keeps the sound bit-perfect. That control is the device's system volume, and it's put back when Melodia lets go of the device. Devices without one keep Melodia's own volume");

    property <string> resync-label: @tr("Silence After a Rate Change");
    property <string> resync-desc: @tr("Some DACs mute for a moment while they switch sample rates. A short silence at each change keeps the start of the track from being cut off");

    property <string> follow-rate-label: @tr("Match the File's Sample Rate");
    property <string> follow-rate-desc: @tr("Reopen the audio device at each track's own rate, so the system doesn't resample it. The system has to allow that rate. Turns crossfade off");

    property <string> signal-label: @tr("Signal Path");
    property <string> signal-desc: @tr("What reaches the audio device, and what changes it on the way. Bit-perfect means nothing does");

    property <bool> exclusive-chosen: Settings.exclusive-supported && Settings.output-mode-idx == 1;
    property <bool> show-mode: Settings.exclusive-supported && row-visible(mode-label, mode-desc);
    property <bool> show-device: root.exclusive-chosen && row-visible(device-label, device-desc);
    property <bool> show-period: root.exclusive-chosen && row-visible(period-label, period-desc);
    property <bool> show-polling: root.exclusive-chosen && Settings.polling-supported
        && row-visible(polling-label, polling-desc);
    property <bool> show-hardware-volume: root.exclusive-chosen && Settings.hardware-volume-supported
        && row-visible(hardware-volume-label, hardware-volume-desc);
    // Exclusive output always runs at the file's rate, so the toggle has nothing to add there.
    property <bool> show-follow-rate: Settings.follow-rate-supported && !root.exclusive-chosen
        && row-visible(follow-rate-label, follow-rate-desc);
    // The hold falls only where the output changes rate, which it does under exclusive and while
    // following the file's rate.
    property <bool> show-resync: (root.exclusive-chosen
            || (Settings.follow-rate-supported && Settings.output-follow-rate))
        && row-visible(resync-label, resync-desc);
    property <bool> show-signal-path: row-visible(signal-label, signal-desc);

    // What the rows above the signal path hand the divider under them.
    property <bool> shows-exclusive-rows: root.show-mode || root.show-device || root.show-period
        || root.show-polling || root.show-hardware-volume;
    property <bool> shows-rate-rows: root.show-follow-rate || root.show-resync;

    out property <bool> has-matches: shows-exclusive-rows || shows-rate-rows || show-signal-path;

    property <string> verdict-text: !SignalPathUi.playing ? @tr("Nothing is playing")
        : SignalPathUi.verdict == 0 ? @tr("Bit-perfect: the device receives the decoder's samples untouched")
        : SignalPathUi.verdict == 1 ? @tr("Enhanced: only effects you chose change the sound")
        : SignalPathUi.verdict == 3 ? @tr("Fallback: exclusive output was refused, so the system mixer is in the way")
        : @tr("Converted: the sound is changed on its way to the device");

    // The stages a click can put right. A resample counts only where following the file's rate is
    // the setting that would stop it, and a volume on the device's own control only while muted:
    // the reset never raises the device, only unmutes it.
    property <bool> can-reset: SignalPathUi.playing && (SignalPathUi.dsp-grade > 0
        || SignalPathUi.speed-grade > 0
        || (SignalPathUi.volume-grade > 0
            && (SignalPathUi.muted || !SignalPathUi.volume-on-device))
        || (SignalPathUi.rate-grade > 0 && Settings.follow-rate-supported
            && !root.exclusive-chosen && !Settings.output-follow-rate));

    // Indexed by `SignalPathUi.fallback-reason`; the order is Rust's, see that property.
    property <string> fallback-text: SignalPathUi.fallback-reason == 0 ? @tr("the device is in use by another app")
        : SignalPathUi.fallback-reason == 1 && SignalPathUi.fallback-by != "" ? @tr("{} holds the device", SignalPathUi.fallback-by)
        : SignalPathUi.fallback-reason == 1 ? @tr("another app holds the device")
        : SignalPathUi.fallback-reason == 2 ? @tr("the device can't run at this sample rate")
        : SignalPathUi.fallback-reason == 3 ? @tr("the device can't play this many channels")
        : SignalPathUi.fallback-reason == 4 ? @tr("the device takes no sample format that holds this track")
        : SignalPathUi.fallback-reason == 5 ? @tr("the chosen device isn't connected")
        : SignalPathUi.fallback-reason == 6 ? @tr("exclusive output isn't available on this system")
        : SignalPathUi.fallback-reason == 8 ? @tr("the device doesn't allow exclusive control, which its Advanced properties in the Sound control panel can turn on")
        : @tr("the device couldn't be opened");

    property <string> effects-text: SignalPathUi.dsp-grade == 0 ? @tr("No effects")
        : SignalPathUi.eq-on && SignalPathUi.rg-on ? @tr("Equalizer and ReplayGain")
        : SignalPathUi.rg-on ? @tr("ReplayGain")
        : @tr("Equalizer");

    property <string> device-text: SignalPathUi.device-name == "" ? SignalPathUi.device-format
        : SignalPathUi.device-name + " · " + SignalPathUi.device-format;

    // Wrapper so the root's preferred-height tracks the card's natural height. See
    // `language-section.slint`.
    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        if root.show-mode: SettingRowStacked {
            icon: "volume_up";
            label: root.mode-label;
            description: root.mode-desc;
            ChipGroup {
                options: [
                    @tr("Shared"),
                    @tr("Exclusive"),
                ];
                selected-index <=> Settings.output-mode-idx;
                selected(i) => { Settings.output-mode-changed(i); }
            }
        }

        if root.show-mode && root.show-device: SectionDivider {}

        if root.show-device: SettingRow {
            icon: "tune";
            label: root.device-label;
            description: root.device-desc;
            Dropdown {
                options: Settings.output-device-names;
                selected-index <=> Settings.output-device-idx;
                trigger-width: 200px;
                selected(idx) => { Settings.output-device-changed(idx); }
            }
        }

        if (root.show-mode || root.show-device) && root.show-period: SectionDivider {}

        if root.show-period: SettingRowStacked {
            icon: "history";
            label: root.period-label;
            description: root.period-desc;
            ChipGroup {
                // The order is `ui::settings::output_mode::PERIOD_PRESETS`'.
                options: [
                    @tr("{} ms", 5),
                    @tr("{} ms", 10),
                    @tr("{} ms", 20),
                    @tr("{} ms", 50),
                    @tr("{} ms", 100),
                ];
                selected-index <=> Settings.output-period-idx;
                selected(i) => { Settings.output-period-changed(i); }
            }
            // What the device took, which a driver rounds to its own step.
            if SignalPathUi.playing && SignalPathUi.exclusive && SignalPathUi.device-period != "": Text {
                text: @tr("The device is running at {}", SignalPathUi.device-period);
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }
        }

        if (root.show-mode || root.show-device || root.show-period) && root.show-polling: SectionDivider {}

        if root.show-polling: SettingRow {
            icon: "refresh";
            label: root.polling-label;
            description: root.polling-desc;
            ToggleSwitch {
                checked <=> Settings.output-polling;
                toggled(v) => { Settings.output-polling-changed(v); }
            }
        }

        if (root.show-mode || root.show-device || root.show-period || root.show-polling)
            && root.show-hardware-volume: SectionDivider {}

        if root.show-hardware-volume: SettingRow {
            icon: "volume_down";
            label: root.hardware-volume-label;
            description: root.hardware-volume-desc;
            ToggleSwitch {
                checked <=> Settings.output-hardware-volume;
                toggled(v) => { Settings.output-hardware-volume-changed(v); }
            }
        }

        if root.shows-exclusive-rows && root.show-follow-rate: SectionDivider {}

        if root.show-follow-rate: SettingRow {
            icon: "speed";
            label: root.follow-rate-label;
            description: root.follow-rate-desc;
            ToggleSwitch {
                checked <=> Settings.output-follow-rate;
                toggled(v) => { Settings.output-follow-rate-changed(v); }
            }
        }

        if (root.shows-exclusive-rows || root.show-follow-rate) && root.show-resync: SectionDivider {}

        if root.show-resync: SettingRowStacked {
            icon: "volume_off";
            label: root.resync-label;
            description: root.resync-desc;
            HorizontalLayout {
                spacing: Theme.pad-md;
                alignment: stretch;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    SliderTrack {
                        value: Settings.output-resync-ms / Settings.output-resync-max-ms;
                        seam-mask-color: SettingsPage.card-fill;
                        changed(v) => { Settings.output-resync-ms = root.resync-step(v); }
                        committed(v) => { Settings.output-resync-committed(root.resync-step(v)); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("{} ms", Settings.output-resync-ms);
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        min-width: 56px;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        if (root.shows-exclusive-rows || root.shows-rate-rows) && root.show-signal-path: SectionDivider {}

        if root.show-signal-path: SettingRow {
            icon: "graphic_eq";
            label: root.signal-label;
            description: root.verdict-text;
            if root.can-reset: SectionButton {
                label: @tr("Make Bit-Perfect");
                icon: "";
                primary: false;
                clicked => { SignalPathUi.make-bit-perfect(); }
            }
        }

        if root.show-signal-path && SignalPathUi.playing: VerticalLayout {
            padding-bottom: Theme.pad-md;

            StageRow {
                grade: SignalPathUi.source-grade;
                label: @tr("Source");
                value: SignalPathUi.source-grade == 0 ? SignalPathUi.source-format
                    : @tr("{}, rounded to fit 32-bit float", SignalPathUi.source-format);
            }
            StageRow {
                grade: SignalPathUi.dsp-grade;
                label: @tr("Effects");
                value: root.effects-text;
            }
            StageRow {
                grade: SignalPathUi.speed-grade;
                label: @tr("Speed");
                value: SignalPathUi.speed-grade == 0 ? @tr("Normal") : SignalPathUi.speed;
            }
            StageRow {
                grade: SignalPathUi.volume-grade;
                label: @tr("Volume");
                value: SignalPathUi.muted ? @tr("Muted")
                    : SignalPathUi.volume-on-device ? @tr("{}% on the device", SignalPathUi.volume)
                    : SignalPathUi.volume + "%";
            }
            StageRow {
                grade: SignalPathUi.crossfade-grade;
                label: @tr("Crossfade");
                value: SignalPathUi.crossfade-grade == 0 ? @tr("Not fading") : @tr("Fading between tracks");
            }
            StageRow {
                grade: SignalPathUi.rate-grade;
                label: @tr("Sample Rate");
                value: SignalPathUi.rate-grade == 0 ? SignalPathUi.source-rate
                    : @tr("{} resampled to {}", SignalPathUi.source-rate, SignalPathUi.device-rate);
            }
            StageRow {
                grade: SignalPathUi.channels-grade;
                label: @tr("Channels");
                value: SignalPathUi.channels-grade == 0 ? @tr("Unchanged") : @tr("Mixed down for the device");
            }
            StageRow {
                grade: SignalPathUi.output-grade;
                label: @tr("Device");
                value: SignalPathUi.fallback-reason >= 0 && SignalPathUi.refused-by != "" ? @tr("{} refused exclusive output because {}. Playing shared on {}", SignalPathUi.refused-by, root.fallback-text, root.device-text)
                    : SignalPathUi.fallback-reason >= 0 ? @tr("{}, shared: exclusive output was refused because {}", root.device-text, root.fallback-text)
                    : !SignalPathUi.exclusive ? @tr("{}, shared: the system mixer may still convert it", root.device-text)
                    : SignalPathUi.output-grade == 0 ? @tr("{}, exclusive", root.device-text)
                    : @tr("{}, exclusive, in a format that can't hold the source exactly", root.device-text);
            }
        }
    }
    }
}
