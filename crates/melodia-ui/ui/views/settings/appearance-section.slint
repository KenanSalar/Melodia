import { Settings } from "../../settings.slint";
import { Theme } from "../../theme.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { ChipGroup } from "../../components/settings/chip-group.slint";
import { ColorDotGrid } from "../../components/settings/color-dot-grid.slint";

// The palette rows; the window-chrome ones are `window-chrome-section.slint`'s. Search visibility
// follows `language-section.slint`, a divider gating on a visible row either side so the card
// can't end on a stranded one.
export component AppearanceSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    // Hidden only for KDE Breeze on System on a live KDE session, where `kdeglobals` dictates the
    // accent. Not for Material You, a swatch picked there overriding the artwork's accent.
    pure function show-accent-row() -> bool {
        return !Settings.kde-system-active;
    }

    in property <string> category-name;

    // The switch reads the same property `ui::backdrop::kind` does, `Native Title Bar`'s idiom —
    // one bool with no `Settings` mirror beside it.
    out property <bool> aurora-backdrop: Theme.aurora-backdrop;

    property <string> card-title: @tr("Appearance");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Color Style's description swaps with `material-you-active`, so whichever
    // form is on screen is the one in the haystack.
    property <string> theme-label: @tr("Theme");
    property <string> variant-label: @tr("Theme Variant");
    property <string> follow-artwork-label: @tr("Material You Accent");
    property <string> follow-artwork-desc: @tr("Take the accent color from the current track's artwork.");
    property <string> accent-label: @tr("Accent Color");
    property <string> color-style-label: @tr("Color Style");
    property <string> color-style-desc: Settings.material-you-active
        ? @tr("Active — palette derived from the current track's artwork.")
        : @tr("Generate theme colors from album artwork.");
    property <string> backdrop-label: @tr("Aurora Backdrop");
    property <string> backdrop-desc: @tr("Paint album, playlist and Now Playing headers with a wash of the album's own colors, instead of a blurred copy of its cover art. Nothing needs blurring, so headers appear sooner and Melodia stays lighter. Restart required to apply.");

    property <bool> show-theme: row-visible(theme-label, "");
    property <bool> show-variant: row-visible(variant-label, "");
    property <bool> show-follow-artwork: Settings.material-you-enabled
        && row-visible(follow-artwork-label, follow-artwork-desc);
    property <bool> show-accent: show-accent-row() && row-visible(accent-label, "");
    property <bool> show-color-style: Settings.material3-selected
        && row-visible(color-style-label, color-style-desc);
    property <bool> show-backdrop: row-visible(backdrop-label, backdrop-desc);

    out property <bool> has-matches:
        show-theme || show-variant || show-follow-artwork || show-accent || show-color-style
            || show-backdrop;

    property <bool> any-above-follow-artwork: show-theme || show-variant;
    property <bool> any-above-accent: any-above-follow-artwork || show-follow-artwork;
    property <bool> any-above-color-style: any-above-accent || show-accent;
    property <bool> any-above-backdrop: any-above-color-style || show-color-style;

    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        // `<=>`: `ChipGroup` writes its own `selected-index`, which orphans a one-way binding.
        if root.show-theme: SettingRowStacked {
            icon: "brush";
            label: root.theme-label;
            description: "";
            ChipGroup {
                options: Settings.theme-names;
                selected-index <=> Settings.theme-idx;
                selected(i) => { Settings.theme-changed(i); }
            }
        }
        if root.show-theme && root.show-variant: SectionDivider {}

        // Inline literals in `theme.variants` order, plus the "System" chip Rust appends, since
        // `Settings.variant-idx` indexes the list both sides see. Catppuccin names stay verbatim.
        if root.show-variant: SettingRowStacked {
            icon: "palette";
            label: root.variant-label;
            description: "";
            ChipGroup {
                options: Settings.catppuccin-selected
                    ? ["Latte", "Frappe", "Macchiato", "Mocha", @tr("System")]
                    : [@tr("Dark"), @tr("Light"), @tr("System")];
                selected-index <=> Settings.variant-idx;
                selected(i) => { Settings.variant-changed(i); }
            }
        }

        // On, no swatch is checked; picking one turns it off, so a colour is one click either way.
        if root.any-above-follow-artwork && root.show-follow-artwork: SectionDivider {}
        if root.show-follow-artwork: SettingRow {
            icon: "image";
            label: root.follow-artwork-label;
            description: root.follow-artwork-desc;
            ToggleSwitch {
                checked <=> Settings.accent-follows-artwork;
                toggled(v) => { Settings.accent-follows-artwork-changed(v); }
            }
        }

        // Swatches are per-(theme, variant); Rust computes the brush list.
        if root.any-above-accent && root.show-accent: SectionDivider {}
        if root.show-accent: SettingRowStacked {
            icon: "colorize";
            label: root.accent-label;
            description: "";
            ColorDotGrid {
                colors: Settings.accent-colors;
                labels: Settings.accent-names;
                selected-index <=> Settings.accent-idx;
                selected(i) => { Settings.accent-changed(i); }
            }
        }

        // Material 3 only. Same `<=>` requirement and same inlined-literal
        // labels as the two rows above; order MUST match
        // `services::material_you::SchemeStyle::all()`, which
        // `Settings.color-style-idx` indexes alongside these chips.
        if root.any-above-color-style && root.show-color-style: SectionDivider {}
        if root.show-color-style: SettingRowStacked {
            icon: "auto_awesome";
            label: root.color-style-label;
            description: root.color-style-desc;
            ChipGroup {
                options: [
                    @tr("None"),
                    @tr("Tonal Spot"),
                    @tr("Content"),
                    @tr("Vibrant"),
                    @tr("Expressive"),
                    @tr("Fidelity"),
                    @tr("Neutral"),
                    @tr("Monochrome"),
                ];
                selected-index <=> Settings.color-style-idx;
                selected(i) => { Settings.color-style-changed(i); }
            }
        }

        // Restart-gated for the reason the two backdrops don't share a contract: the blur solves its
        // tiers off the artwork where the aurora publishes the theme's own, so a live flip leaves one
        // stack painting the other's colours. Raising the flag at boot is also what lets the blur
        // half go unbuilt — the cost the setting is for.
        if root.any-above-backdrop && root.show-backdrop: SectionDivider {}
        if root.show-backdrop: SettingRow {
            icon: "tonality";
            label: root.backdrop-label;
            description: root.backdrop-desc;
            ToggleSwitch {
                checked: root.aurora-backdrop;
                manual: true;
                toggled(new-value) => {
                    Dialog.kind = DialogKind.restart-backdrop;
                    Dialog.target-id = new-value ? 1 : 0;
                    Dialog.title = @tr("Restart Required");
                    Dialog.message = @tr("Changing the backdrop style requires restarting Melodia. Restart now?");
                    Dialog.confirm-label = @tr("Restart");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
        }
    }
    }
}
