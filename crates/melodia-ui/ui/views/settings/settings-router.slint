import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { LibraryPage } from "pages/library-page.slint";
import { PlaybackPage } from "pages/playback-page.slint";
import { EffectsPage } from "pages/effects-page.slint";
import { OutputPage } from "pages/output-page.slint";
import { AppearancePage } from "pages/appearance-page.slint";
import { LanguagePage } from "pages/language-page.slint";
import { WindowPage } from "pages/window-page.slint";
import { RadioPage } from "pages/radio-page.slint";
import { LyricsPage } from "pages/lyrics-page.slint";
import { IntegrationsPage } from "pages/integrations-page.slint";
import { UpdatesPage } from "pages/updates-page.slint";
import { AboutPage } from "pages/about-page.slint";

// The Settings router: one category, or every one at once while a search is running.
// `settings-view.slint` owns the chrome around it.
//
// **Search deliberately escapes the categories.** Filtering only the selected one would answer "no
// matching settings" for a query whose row sits a category over — the failure that makes split
// settings worse than a single scroll. Mounting every page gives back the flat cross-category list
// and needs no filtering logic of its own, each card already hiding itself. Both modes mount the
// same pages, so which card lives in which category is stated once, in the page files.
export component SettingsRouter inherits Rectangle {
    in property <int> category-index;
    in property <bool> searching;

    horizontal-stretch: 1;
    vertical-stretch: 0;

    VerticalLayout {
        if root.searching: VerticalLayout {
            library := LibraryPage {}
            playback := PlaybackPage {}
            effects := EffectsPage {}
            output := OutputPage {}
            appearance := AppearancePage {}
            language := LanguagePage {}
            window := WindowPage {}
            radio := RadioPage {}
            lyrics := LyricsPage {}
            integrations := IntegrationsPage {}
            updates := UpdatesPage {}
            about := AboutPage {}

            // Only reachable here — outside search every card is visible. One term per page
            // rather than per card, because each page folds its own.
            if !library.has-matches && !playback.has-matches && !effects.has-matches
                    && !output.has-matches && !appearance.has-matches && !language.has-matches && !window.has-matches
                    && !radio.has-matches && !lyrics.has-matches && !integrations.has-matches
                    && !updates.has-matches && !about.has-matches: Rectangle {
                height: 200px;
                // A card's width, so the line centres in the column the cards would fill rather
                // than hugging the panel.
                preferred-width: SettingsPage.card-w;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("No matching settings");
                        horizontal-alignment: center;
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                    }
                }
            }
        }

        if !root.searching && root.category-index == SettingsPage.category-library: LibraryPage {}
        if !root.searching && root.category-index == SettingsPage.category-playback: PlaybackPage {}
        if !root.searching && root.category-index == SettingsPage.category-effects: EffectsPage {}
        if !root.searching && root.category-index == SettingsPage.category-output: OutputPage {}
        if !root.searching && root.category-index == SettingsPage.category-appearance: AppearancePage {}
        if !root.searching && root.category-index == SettingsPage.category-language: LanguagePage {}
        if !root.searching && root.category-index == SettingsPage.category-window: WindowPage {}
        if !root.searching && root.category-index == SettingsPage.category-radio: RadioPage {}
        if !root.searching && root.category-index == SettingsPage.category-lyrics: LyricsPage {}
        if !root.searching && root.category-index == SettingsPage.category-integrations: IntegrationsPage {}
        if !root.searching && root.category-index == SettingsPage.category-updates: UpdatesPage {}
        if !root.searching && root.category-index == SettingsPage.category-about: AboutPage {}
    }
}
