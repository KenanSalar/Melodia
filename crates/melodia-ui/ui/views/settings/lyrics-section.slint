import { Settings } from "../../settings.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Player } from "../../globals/player.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// The switch that turns lyrics on, the one that lets the panel reach the network, the one that
// decides how it draws a line, and the finder for the playing track. The lookup's description
// names lrclib.net for the radio master row's reason: a user deciding to stay local is entitled to
// know who would be contacted. Search visibility follows `radio-section.slint`.
//
// **Unlike Radio's, the rows under the master stay put while it is off.** The two switches are
// defaults a user sets before turning lyrics on, and the finder greys and says why. Every
// row here is also in Now Playing, the master as the header's switch and the rest in its lyrics
// menu, each switch being two things: a default worth finding in Settings, and the one you reach
// for the moment it is wanted.
export component LyricsSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> category-name;

    property <string> card-title: @tr("Lyrics");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Declared once, because the search predicate is fed `label + " " + desc` and a pair spelled
    // at both sites lets a reworded description stop its own row matching.
    property <string> enabled-label: @tr("Show lyrics");
    property <string> enabled-desc: @tr("Show the playing track's words in Now Playing instead of Up Next");

    property <string> online-label: @tr("Look up lyrics online");
    property <string> online-desc: @tr("When a track carries no words of its own, ask lrclib.net for them");

    property <string> romanization-label: @tr("Show romanization");
    property <string> romanization-desc: @tr("Print how a line sounds in Latin letters under the words, for a script that does not use them");

    property <string> find-label: @tr("Find lyrics");
    property <string> find-desc: @tr("Pick the playing track's lyrics from lrclib.net's matches");

    property <bool> show-enabled: row-visible(enabled-label, enabled-desc);
    property <bool> show-online: row-visible(online-label, online-desc);
    property <bool> show-romanization: row-visible(romanization-label, romanization-desc);
    property <bool> show-find: row-visible(find-label, find-desc);

    out property <bool> has-matches: show-enabled || show-online || show-romanization || show-find;

    if has-matches: SectionCard {
        title: root.card-title;

        if root.show-enabled: SettingRow {
            icon: "lyrics";
            label: root.enabled-label;
            description: root.enabled-desc;
            ToggleSwitch {
                checked <=> Settings.lyrics-enabled;
                toggled(v) => { Settings.lyrics-enabled-changed(v); }
            }
        }

        if root.show-online: SettingRow {
            icon: "travel_explore";
            label: root.online-label;
            description: root.online-desc;
            ToggleSwitch {
                checked <=> Settings.lyrics-online-enabled;
                toggled(v) => { Settings.lyrics-online-enabled-changed(v); }
            }
        }

        if root.show-romanization: SettingRow {
            icon: "translate";
            label: root.romanization-label;
            description: root.romanization-desc;
            ToggleSwitch {
                checked <=> Settings.lyrics-romanization-shown;
                toggled(v) => { Settings.lyrics-romanization-shown-changed(v); }
            }
        }

        // Greyed rather than hidden while lyrics are off, as the radio scrobble row is, saying which
        // switch to turn on. With the lookup off it opens, the dialog offering that switch.
        if root.show-find: SettingRow {
            icon: "search";
            label: root.find-label;
            description: Settings.lyrics-enabled ? root.find-desc
                : @tr("Turn on \"Show lyrics\" above first");
            disabled: !Settings.lyrics-enabled;
            SectionButton {
                label: @tr("Find…");
                icon: "";
                primary: false;
                button-enabled: Player.vm.has_track;
                clicked => { Dialog.open-lyrics-finder(); }
            }
        }
    }
}
