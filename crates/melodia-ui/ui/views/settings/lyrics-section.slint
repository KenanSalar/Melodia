import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// The one switch that lets the lyrics panel reach the network. The description names lrclib.net
// for the radio master row's reason: a user deciding to stay local is entitled to know who would
// be contacted. Search visibility follows `radio-section.slint`.
//
// **The panel itself is not configured here.** Whether the column shows lyrics or Up Next is a
// view preference, flipped from that view's own overflow menu; this card is only about traffic.
export component LyricsSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Lyrics");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Declared once, because the search predicate is fed `label + " " + desc` and a pair spelled
    // at both sites lets a reworded description stop its own row matching.
    property <string> online-label: @tr("Look up lyrics online");
    property <string> online-desc: @tr("When a track carries no words of its own, ask lrclib.net for them");

    property <bool> show-online: row-visible(online-label, online-desc);

    out property <bool> has-matches: show-online;

    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            if root.show-online: SettingRow {
                icon: "lyrics";
                label: root.online-label;
                description: root.online-desc;
                ToggleSwitch {
                    checked <=> Settings.lyrics-online-enabled;
                    toggled(v) => { Settings.lyrics-online-enabled-changed(v); }
                }
            }
        }
    }
}
