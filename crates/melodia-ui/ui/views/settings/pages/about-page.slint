import { AboutSection } from "../about-section.slint";
import { DiagnosticsSection } from "../diagnostics-section.slint";

// Who makes Melodia and what to hand them when something breaks. The page shape is
// `library-page.slint`'s.
export component AboutPage inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: about.has-matches || diagnostics.has-matches;

    VerticalLayout {
        about := AboutSection { category-name: @tr("About"); }
        diagnostics := DiagnosticsSection { category-name: @tr("About"); }
    }
}
