import { PlaybackSection } from "../playback-section.slint";

// How tracks follow one another. The page shape is `library-page.slint`'s.
export component PlaybackPage inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: pb.has-matches;

    VerticalLayout {
        pb := PlaybackSection { category-name: @tr("Playback"); }
    }
}
