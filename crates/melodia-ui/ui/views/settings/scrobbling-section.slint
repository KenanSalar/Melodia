import { Settings } from "../../settings.slint";
import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { ScrobbleUi } from "../../globals/dialog-forms.slint";
import { Dialog } from "../../globals/dialog.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// Per service: a status row with Connect / Disconnect, an enable toggle that
// mounts only once connected, and a loved-tracks sync. Rust owns every value;
// the status props come off `scrobbling_settings.rs`'s status-watch subscriber.
// Connect fills its login dialog inline rather than through a callback, so the
// `@tr` chrome stays in Slint and a Rust-driven open can't trip the recursion
// guard. Search visibility follows `playback-section.slint`.
export component ScrobblingSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Scrobbling");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // Each row's strings, declared once and read by both the visibility term and the row.
    property <string> lastfm-label: @tr("Last.fm");
    property <string> lastfm-scrobble-label: @tr("Scrobble to Last.fm");
    property <string> lastfm-scrobble-desc: @tr("Report each play to your Last.fm account");
    property <string> lastfm-loves-label: @tr("Sync loved tracks to Last.fm");
    property <string> lastfm-loves-desc: @tr("Mark tracks you love as loved on Last.fm — turning this on syncs your existing favorites");
    property <string> lb-label: @tr("ListenBrainz");
    property <string> lb-scrobble-label: @tr("Scrobble to ListenBrainz");
    property <string> lb-scrobble-desc: @tr("Report each play to your ListenBrainz account");
    property <string> lb-loves-label: @tr("Sync loved tracks to ListenBrainz");
    property <string> lb-loves-desc: @tr("Mark tracks you love as loved on ListenBrainz — turning this on syncs your existing favorites (needs MusicBrainz IDs)");
    property <string> lb-picard-note: @tr("MusicBrainz Picard adds these IDs to your files, identifying each track by its audio.");

    // A cluster searches as one unit: the toggles' labels fold into the status
    // row's text, so matching any of them reveals the whole thing.
    property <bool> show-lastfm: row-visible(
        lastfm-label + " " + lastfm-scrobble-label + " " + lastfm-loves-label,
        lastfm-scrobble-desc + " " + lastfm-loves-desc);
    property <bool> show-listenbrainz: row-visible(
        lb-label + " " + lb-scrobble-label + " " + lb-loves-label,
        lb-scrobble-desc + " " + lb-loves-desc + " " + lb-picard-note);

    property <string> radio-label: @tr("Scrobble radio songs");
    property <string> radio-desc: @tr("Songs heard in full on a station go to your connected scrobbling services");
    // Here rather than on the Radio card, since this is where a reader looks for what gets
    // scrobbled; it exists only while radio does.
    property <bool> show-radio: Settings.radio-enabled && row-visible(radio-label, radio-desc);
    property <bool> any-service-on: (Settings.scrobble-lastfm-connected && Settings.scrobble-lastfm-enabled)
        || (Settings.scrobble-listenbrainz-connected && Settings.scrobble-listenbrainz-enabled);

    out property <bool> has-matches: show-lastfm || show-listenbrainz || show-radio;

    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        // Last.fm.
        if root.show-lastfm: SettingRow {
            icon: "history";
            label: root.lastfm-label;
            description: Settings.scrobble-lastfm-connected
                ? @tr("Connected as {}", Settings.scrobble-lastfm-username)
                : (Settings.scrobble-lastfm-configured
                    ? @tr("Not connected")
                    : @tr("Not configured in this build"));

            if Settings.scrobble-lastfm-configured && !Settings.scrobble-lastfm-connected: SectionButton {
                label: @tr("Connect");
                icon: "";
                primary: true;
                clicked => {
                    ScrobbleUi.lastfm-step = 0;
                    ScrobbleUi.lastfm-token = "";
                    ScrobbleUi.busy = false;
                    ScrobbleUi.error = "";
                    Dialog.kind = "scrobble-lastfm-login";
                    Dialog.title = @tr("Connect Last.fm");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Open Last.fm");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
            if Settings.scrobble-lastfm-connected: SectionButton {
                label: @tr("Disconnect");
                icon: "";
                primary: false;
                clicked => { Settings.scrobble-lastfm-disconnect(); }
            }
        }

        if root.show-lastfm && Settings.scrobble-lastfm-connected: SettingRow {
            icon: "upload";
            label: root.lastfm-scrobble-label;
            description: root.lastfm-scrobble-desc;
            ToggleSwitch {
                checked <=> Settings.scrobble-lastfm-enabled;
                toggled(v) => { Settings.scrobble-lastfm-enabled-changed(v); }
            }
        }

        if root.show-lastfm && Settings.scrobble-lastfm-connected: SettingRow {
            icon: "favorite";
            label: root.lastfm-loves-label;
            description: root.lastfm-loves-desc;
            ToggleSwitch {
                checked <=> Settings.scrobble-lastfm-love;
                toggled(v) => { Settings.scrobble-lastfm-love-changed(v); }
            }
        }

        if root.show-lastfm && root.show-listenbrainz: SectionDivider {}

        // ListenBrainz.
        if root.show-listenbrainz: SettingRow {
            icon: "history";
            label: root.lb-label;
            description: Settings.scrobble-listenbrainz-connected
                ? @tr("Connected as {}", Settings.scrobble-listenbrainz-username)
                : @tr("Not connected");

            if !Settings.scrobble-listenbrainz-connected: SectionButton {
                label: @tr("Connect");
                icon: "";
                primary: true;
                clicked => {
                    ScrobbleUi.lb-token = "";
                    ScrobbleUi.busy = false;
                    ScrobbleUi.error = "";
                    Dialog.kind = "scrobble-listenbrainz-login";
                    Dialog.title = @tr("Connect ListenBrainz");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Connect");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
            if Settings.scrobble-listenbrainz-connected: SectionButton {
                label: @tr("Disconnect");
                icon: "";
                primary: false;
                clicked => { Settings.scrobble-listenbrainz-disconnect(); }
            }
        }

        if root.show-listenbrainz && Settings.scrobble-listenbrainz-connected: SettingRow {
            icon: "upload";
            label: root.lb-scrobble-label;
            description: root.lb-scrobble-desc;
            ToggleSwitch {
                checked <=> Settings.scrobble-listenbrainz-enabled;
                toggled(v) => { Settings.scrobble-listenbrainz-enabled-changed(v); }
            }
        }

        if root.show-listenbrainz && Settings.scrobble-listenbrainz-connected: SettingRow {
            icon: "favorite";
            label: root.lb-loves-label;
            description: root.lb-loves-desc;
            ToggleSwitch {
                checked <=> Settings.scrobble-listenbrainz-love;
                toggled(v) => { Settings.scrobble-listenbrainz-love-changed(v); }
            }
        }
        // Melodia doesn't look these IDs up, so the loves above reach only as far as the tags
        // already do; this says where the rest come from. The `max-width` keeps the copy to a
        // reading column so it can't inflate the card.
        if root.show-listenbrainz && Settings.scrobble-listenbrainz-connected: HorizontalLayout {
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            padding-bottom: Theme.pad-sm;
            Text {
                text: root.lb-picard-note;
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                max-width: 480px;
            }
        }

        if root.show-radio && (root.show-lastfm || root.show-listenbrainz): SectionDivider {}

        // Greyed rather than hidden with no service on, so the switch is findable and says why
        // it can't be used yet.
        if root.show-radio: SettingRow {
            icon: "radio";
            label: root.radio-label;
            description: root.any-service-on
                ? root.radio-desc
                : @tr("Turn on Last.fm or ListenBrainz above first");
            disabled: !root.any-service-on;
            ToggleSwitch {
                checked <=> Settings.radio-scrobble;
                toggled(v) => { Settings.radio-scrobble-changed(v); }
            }
        }
    }
    }
}
