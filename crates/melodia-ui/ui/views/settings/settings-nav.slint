import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { NavRow } from "../../components/nav-row.slint";
import { SearchBar } from "../../components/search-bar.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";

// The Settings category panel, `TabBar`'s contract on its side. On the rail the
// search box gives way to a button whose field is the host's, beside the panel over the cards, a
// 52 px card having no room for one.
export component SettingsNav inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> icons;
    // Two-way, per the orphaned-one-way-binding pitfall.
    in-out property <int> selected-index;
    // A mirrored width, never a live `parent.width` read (the host's `view-w`).
    in property <length> avail-w;
    // The host's field is open, so the rail's button reads as on.
    in property <bool> search-active;

    // Emitted on every click, the showing row's included: picking it is how a search is left.
    callback selected(int);
    callback search-clicked();

    // The panel's own search box. Mounted for good and collapsed on the rail, never behind an `if`:
    // its `changed blur-trigger` tracker would outlive the branch.
    in-out property <string> filter;
    in property <string> filter-placeholder;
    in property <int> blur-tick;
    callback search-edited();
    out property <bool> search-has-focus: search.has-focus;
    public function focus-search() {
        search.focus-input();
    }

    // Every row, the rail's search button and both search boxes share it, so swapping one for the
    // other on a fold moves nothing beneath them.
    out property <length> row-h: SettingsPage.nav-row-h;
    property <length> row-gap: Theme.pad-xs;
    property <length> card-pad: SettingsPage.nav-pad;
    property <length> row-pad: Theme.pad-md;
    // Centres `NavRow`'s 22 px glyph in a square row.
    property <length> rail-inset: (root.row-h - 22px) / 2;
    property <length> rail-w: root.row-h + 2 * root.card-pad;

    // Measured, the labels being translated, and clamped: a long locale can't take the page, and
    // the search box keeps its `min-w`. Rounded up to a whole pixel, the cards taking its edge.
    property <length> label-w: ruler.preferred-width;
    property <length> natural-w:
        root.label-w + 2 * root.row-pad + 22px + Theme.pad-md + 2 * root.card-pad;
    out property <length> expanded-w: clamp(Math.ceil(root.natural-w / 1phx) * 1phx, 184px, 240px);

    // The `TabBar` latch: a resize drag hands over a stream of one-pixel widths and a hand jitters
    // over the last of them, so a bare comparison flips on every one straddling the line.
    property <length> hysteresis: 24px;
    property <bool> latched: false;
    out property <bool> compact: root.avail-w < root.expanded-w + SettingsPage.nav-collapse-body-w
        + (root.latched ? root.hysteresis : 0px);
    changed compact => {
        root.latched = root.compact;
        root.compact-t = root.compact ? 1.0 : 0.0;
    }

    // Only seeded by the binding, `changed compact` owning it after: an animated binding restarts
    // on every dirty dependency, and a resize drag rewrites `avail-w` per motion
    // (`slint-pitfalls.md`).
    property <float> compact-t: root.compact ? 1.0 : 0.0;
    animate compact-t { duration: Theme.dur-med; easing: ease-in-out; enabled: root.eased; }

    // `TabBar`'s 100 ms: it has to outlast the host's first `changed width`, the first verdict
    // being the panel learning how much room it has rather than a change.
    property <bool> eased: false;
    Timer {
        interval: 100ms;
        triggered => {
            root.eased = true;
            self.running = false;
        }
    }

    out property <length> drawn-w: root.expanded-w + (root.rail-w - root.expanded-w) * root.compact-t;

    // Arithmetic rather than read off the button, which would tie the host's layout to this one's
    // and back. Unscrolled, the field's row sitting above the cards.
    out property <length> rail-search-center-y: root.card-pad + root.row-h / 2;

    // One hover area answers for the whole list, the row taken off the pointer's `y`, so the gaps
    // between rows can't drop the pill and moving between icons moves it rather than re-arming it.
    property <int> hovered-row: !list-hover.has-hover ? -1
        : clamp(Math.floor(list-hover.mouse-y / (root.row-h + root.row-gap)),
                0, root.labels.length - 1);
    // Not on the search button while its field is open: the pill would cover the field.
    out property <bool> tip-visible: root.compact
        && ((rail-search.has-hover && !root.search-active) || root.hovered-row >= 0);
    out property <string> tip-label: rail-search.has-hover ? rail-search.label
        : root.hovered-row >= 0 ? root.labels[root.hovered-row] : "";
    out property <length> tip-x: 0px;
    out property <length> tip-y: scroller.y + scroller.content-y + (rail-search.has-hover ? 0px
        : list-hover.y + root.hovered-row * (root.row-h + root.row-gap));
    out property <length> tip-w: root.width;
    out property <length> tip-h: root.row-h;

    background: SettingsPage.card-fill;
    border-radius: Theme.radius-lg;

    // Never a bound `width`, whose ease would drag the window's minimum along.
    min-width: root.rail-w;
    preferred-width: root.drawn-w;
    max-width: root.drawn-w;

    // The widest label at the weight a selected row draws it. Pinned at `x`/`y` so the root's
    // layout info skips it, and `visible: false` lowers to a 0×0 clip.
    ruler := VerticalLayout {
        x: 0;
        y: 0;
        visible: false;
        for label in root.labels: Text {
            text: label;
            font-size: Theme.font-size-md;
            font-weight: 600;
        }
    }

    VerticalLayout {
        padding: root.card-pad;

        // Asks for the whole column, so the card hugs it and only scrolls on a page too short to.
        // The search box scrolls with the rows, as one more entry in the list.
        scroller := ScrollView {
            vertical-stretch: 1;
            preferred-height: column.preferred-height;
            max-height: column.preferred-height;
            // The std scroller floors its own width, which would draw the rail's rows past it.
            min-width: 0px;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            mouse-drag-pan-enabled: false;
            // Spelled out: the default is the column's minimum, which the search box's zero floor
            // sits under, so a short page would squash the box into the rows.
            content-height: column.preferred-height;

            column := VerticalLayout {
                // The inset again, which a card's title band counts on
                // (`SettingsPage.card-header-h`).
                spacing: root.card-pad;

                // One of the two shows, so they share a layout without spacing.
                VerticalLayout {
                    // Explicit bounds, not `visible` alone, which would still claim the slot; the
                    // zero `min-width` replaces the bar's own, which would hold the rail open.
                    Rectangle {
                        min-width: 0px;
                        min-height: 0px;
                        preferred-height: root.compact ? 0px : search.height;
                        max-height: root.compact ? 0px : search.height;
                        visible: !root.compact;

                        // The page's own bar at the rows' corner, minus the swell: in a column of
                        // rows it would crowd them.
                        search := SearchBar {
                            x: 0;
                            y: 0;
                            focus-swell: false;
                            on-card: true;
                            corner-radius: Theme.radius-md;
                            bar-height: root.row-h;
                            input-width: root.drawn-w - 2 * root.card-pad;
                            text <=> root.filter;
                            placeholder: root.filter-placeholder;
                            blur-trigger: root.blur-tick;
                            edited => { root.search-edited(); }
                        }
                    }

                    rail-search := NavRow {
                        height: root.compact ? root.row-h : 0px;
                        visible: root.compact;
                        icon: "search";
                        label: @tr("Search");
                        show-label: false;
                        selected: root.search-active;
                        pad-left: root.rail-inset;
                        pad-right: root.rail-inset;
                        ease-padding: false;
                        selected-fill: Theme.accent.with-alpha(0.16);
                        hover-fill: Theme.card-control;
                        clicked => { root.search-clicked(); }
                    }
                }

                // An ancestor of the rows, so it sees the pointer on the filter pass and still
                // hands every click and hover through to them.
                list-hover := TouchArea {
                    list := VerticalLayout {
                        spacing: root.row-gap;

                        for label[i] in root.labels: NavRow {
                            height: root.row-h;
                            icon: root.icons[i];
                            label: label;
                            selected: i == root.selected-index;
                            show-label: !root.compact;
                            pad-left: root.compact ? root.rail-inset : root.row-pad;
                            pad-right: root.compact ? root.rail-inset : root.row-pad;
                            ease-padding: root.eased;
                            // `ChoiceList`'s pair, the panel being the same card fill.
                            selected-fill: Theme.accent.with-alpha(0.16);
                            hover-fill: Theme.card-control;
                            clicked => {
                                root.selected-index = i;
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }

    // In the card's own padding, slimmer than the shared slot, so it never crowds the glyphs.
    OverlayScrollbar {
        x: parent.width - self.width - 1px;
        y: scroller.y;
        width: 6px;
        height: scroller.height;
        bar-thickness: 4px;
        bar-radius: 2px;
        min-thumb: 20px;
        track-color: Theme.scrollbar-track-on-card;
        visible-size: scroller.visible-height;
        content-size: scroller.content-height;
        offset: -scroller.content-y;
        scroll-to(o) => { scroller.content-y = -o; }
    }
}
