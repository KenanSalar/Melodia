import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { CorrectionFrom, Crossfeed, HeadphoneCorrection, Headphones, HeardDevice } from "../../globals/audio.slint";
import { CorrectionImport, HeadphonePicker, ImportStep, PickerPhase } from "../../globals/correction-dialogs.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { HeadphonesText } from "../../components/settings/headphones-controls.slint";
import { CorrectionText } from "../../components/settings/correction-controls.slint";
import { CrossfeedStrengthSlider, CrossfeedText } from "../../components/settings/crossfeed-controls.slint";

// What each output device keeps, headed by the device it is kept for. One cluster on the equalizer
// card's shape: the rows under a switch mount only while it is on, as Radio's do, the online one
// keeping its value while hidden. That row names github.com for the lyrics lookup's reason.
export component HeadphonesSection inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> category-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.category-name, HeadphonesText.title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    out property <bool> has-matches: row-visible(HeadphonesText.device-desc, "")
        || row-visible(CorrectionText.enable-label, CorrectionText.enable-desc)
        || row-visible(CorrectionText.find-label + " " + CorrectionText.import-label, "")
        || row-visible(CorrectionText.online-label, CorrectionText.online-desc)
        || row-visible(CrossfeedText.enable-label, CrossfeedText.enable-desc)
        || row-visible(CrossfeedText.strength-label, "");

    property <bool> show-correction: root.has-matches && HeadphoneCorrection.enabled;
    property <bool> show-strength: root.has-matches && Crossfeed.enabled;
    property <bool> device-named: Headphones.device != HeardDevice.pending;

    if has-matches: SectionCard {
        title: HeadphonesText.title;

        SettingRow {
            icon: "volume_up";
            label: HeadphonesText.device;
            description: HeadphonesText.device-desc;
            init => { Headphones.refresh(); }
        }

        SettingRow {
            icon: "headphones";
            label: CorrectionText.enable-label;
            description: CorrectionText.enable-desc;
            ToggleSwitch {
                checked <=> HeadphoneCorrection.enabled;
                toggled(v) => { HeadphoneCorrection.set-enabled(v); }
            }
        }

        // Stacked so the three buttons never contend with the correction's name for the width.
        if root.show-correction: SettingRowStacked {
            icon: "graphic_eq";
            label: CorrectionText.correction;

            HorizontalLayout {
                alignment: start;
                spacing: Theme.pad-sm;

                SectionButton {
                    label: CorrectionText.find-label;
                    icon: "search";
                    button-enabled: root.device-named && HeadphoneCorrection.online;
                    clicked => {
                        Dialog.title = @tr("Find Your Headphones");
                        Dialog.message = @tr("AutoEq's corrections, one measurement for each model.");
                        Dialog.confirm-label = @tr("Apply");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = DialogKind.headphone-picker;
                        HeadphonePicker.phase = PickerPhase.loading;
                        Dialog.open = true;
                        HeadphonePicker.load();
                    }
                }
                SectionButton {
                    label: CorrectionText.import-label;
                    icon: "upload";
                    primary: false;
                    button-enabled: root.device-named;
                    clicked => {
                        Dialog.title = @tr("Import a Correction");
                        Dialog.message = "";
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.kind = DialogKind.correction-import;
                        CorrectionImport.step = ImportStep.paste;
                        Dialog.open = true;
                    }
                }
                SectionButton {
                    label: @tr("Clear");
                    icon: "delete";
                    primary: false;
                    button-enabled: HeadphoneCorrection.origin != CorrectionFrom.none;
                    clicked => { HeadphoneCorrection.clear(); }
                }
            }
        }

        if root.show-correction: SettingRow {
            icon: "travel_explore";
            label: CorrectionText.online-label;
            description: CorrectionText.online-desc;
            ToggleSwitch {
                checked <=> HeadphoneCorrection.online;
                toggled(v) => { HeadphoneCorrection.set-online(v); }
            }
        }

        SettingRow {
            icon: "swap_horiz";
            label: CrossfeedText.enable-label;
            description: CrossfeedText.enable-desc;
            disabled: !root.device-named;
            ToggleSwitch {
                checked <=> Crossfeed.enabled;
                toggled(v) => { Crossfeed.set-enabled(v); }
            }
        }

        if root.show-strength: SettingRowStacked {
            icon: "tune";
            label: CrossfeedText.strength-label;
            CrossfeedStrengthSlider { }
        }
    }
}
