import { RecentlyPlayed } from "../../globals/curated.slint";
import { Player } from "../../globals/player.slint";
import { TrackListScrollbars } from "../../components/track-list-scrollbars.slint";
import { TrackList } from "../../components/track-list/track-list.slint";

// A file of its own so the scrollbars sit beside the list, as on My Library's Songs tab.
//
// `sortable: false`, recency being the page: its order is a synthetic `"recency"` field no header
// cell owns, so a header click, which persists, could never be undone.
export component RecentlyPlayedSongsTab inherits Rectangle {
    tl := TrackList {
        width: 100%;
        height: 100%;

        rows: RecentlyPlayed.tracks;
        columns <=> RecentlyPlayed.track-columns;

        sortable: false;
        playing-track-id: Player.vm.track.id;
        view-context: "recently_played";
        view-selected-ids: RecentlyPlayed.selected-ids;

        play-row(id, idx) => { RecentlyPlayed.play-row(id, idx); }
        play-next(ids) => { RecentlyPlayed.play-next(ids); }
        add-to-queue(ids) => { RecentlyPlayed.add-to-queue(ids); }
        toggle-row-favorite(ids, on) => { RecentlyPlayed.toggle-row-favorite(ids, on); }
        set-row-rating(ids, n) => { RecentlyPlayed.set-row-rating(ids, n); }
        select-row(idx, id, sh, ct) => { RecentlyPlayed.select-row(idx, id, sh, ct); }
        select-all => { RecentlyPlayed.select-all(); }
        clear-selection => { RecentlyPlayed.clear-selection(); }
        request-blur-search => { RecentlyPlayed.blur-search-tick += 1; }
    }

    TrackListScrollbars {
        x: 0; y: 0; width: 100%; height: 100%;
        list-y: tl.absolute-position.y - root.absolute-position.y;
        body-y: tl.body-y;
        body-height: tl.body-height;
        v-visible-height: tl.v-visible-height;
        v-viewport-height: tl.v-viewport-height;
        v-offset: tl.v-offset;
        set-v-offset(o) => { tl.set-v-offset(o); }
    }
}
