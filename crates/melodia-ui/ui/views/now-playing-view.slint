import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Visualizer } from "../globals/audio.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { Radio } from "../globals/radio.slint";
import { ArtworkImage } from "../components/artwork-image.slint";
import { AccentDiscButton } from "../components/now-playing/accent-disc-button.slint";
import { AccentGlyphButton } from "../components/now-playing/accent-glyph-button.slint";
import { MetaChipStrip } from "../components/meta-chip-strip.slint";
import { StarRating } from "../components/star-rating.slint";
import { NowPlayingCover } from "../components/now-playing/now-playing-cover.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";
import { LyricsPanel } from "../components/now-playing/lyrics-panel.slint";
import { Lyrics } from "../globals/lyrics.slint";
import { StationFacts, StationHistory } from "../components/station-facts.slint";
import { NpOverlayScrollbar } from "../components/now-playing/np-overlay-scrollbar.slint";
import { TooltipSide } from "../components/tooltip.slint";
import { LyricsControls } from "../components/now-playing/lyrics-controls.slint";
import { VisualizerPicker } from "../components/now-playing/visualizer-picker.slint";
import { VisualizerStrip } from "../components/now-playing/visualizer-strip.slint";
import { NpBackdropStack } from "../components/now-playing/np-backdrop-stack.slint";

// Transport and seek are deliberately not duplicated here: the bar stays visible below.
export component NowPlayingView inherits Rectangle {
    property <length> cover-size: clamp(root.width * 0.22, 200px, 384px);

    // The cover slot is the column's only slack, so without a floor a short panel shrinks the
    // artwork to nothing and overflows anyway. A fraction rather than a fixed edge, which on the
    // shortest panel is room the strip and the title would have to find instead.
    property <length> cover-min: clamp(root.height * 0.2, 72px, 160px);

    // A low floor: the strip is the largest term under the artwork and the only one that still
    // reads at half height, so a short panel pays for the cover's floor here.
    property <length> strip-h: clamp(root.height * 0.12, 28px, 128px);

    // Padding the layout can't shrink, so it scales off the panel instead.
    property <length> strip-drop: clamp(root.height * 0.06, Theme.pad-sm, Theme.pad-lg * 2.5);

    property <length> up-next-width: clamp(root.width * 0.35, 280px, 420px);
    property <length> content-width: root.width - Theme.pad-lg - Theme.pad-md - root.up-next-width;

    // Bound by the column's width too: on a narrow panel the square tile is width-bound, and
    // reserving the full height leaves empty backdrop under it.
    property <length> cover-h: clamp(root.content-width, root.cover-min, root.cover-size);

    // A per-band column pitch: the band count is fixed, so a wider strip only fattens each bar.
    // Ten pixels, the 2px gap included, is where a resting mark stops reading as one. The count is
    // read rather than restating `spectrum::NUM_BANDS`; the `max` covers boot.
    property <length> strip-w-max: 10px * max(1, Visualizer.band-count);

    // Three quarters of the column, so the strip reads as the base of the cover, title and chips,
    // floored at the cover because `content-width` goes negative at the window's minimum. Capped
    // at the column less both scrollbar lanes, the cover's 200px floor being wider than the whole
    // column on any panel under about 900px; both lanes, so the strip stays on the column's axis.
    property <length> strip-w: max(0px, min(
        root.content-width - 2 * Theme.scrollbar-slot,
        max(root.cover-size, min(root.content-width * 0.75, root.strip-w-max))
    ));

    NpBackdropStack {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            spacing: Theme.pad-sm;
            cross-axis-alignment: center;

            AccentDiscButton {
                icon: "arrow_back";
                clicked => {
                    Nav.pending-enter-from = NavEnterFrom.above;
                    Nav.now-playing-open = false;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if Player.vm.has_track: StarRating {
                rating: Player.vm.track.rating;
                star-size: 22px;
                // Accent rather than the lists' yellow; `AccentGlyphButton` says why the row
                // shares one colour.
                filled-color: Player.np-accent-bright;
                empty-color: Player.np-accent-dim;
                on-backdrop: true;
                // The glyphs beside it answer the pointer, so the stars do too.
                hover-preview: true;
                rated(n) => { Player.set-current-rating(n); }
            }

            if !Player.vm.has_station: AccentGlyphButton {
                icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                filled: Player.vm.track.is_favorite;
                active: Player.vm.track.is_favorite;
                button-enabled: Player.vm.has_track;
                clicked => { Player.toggle-favorite(); }
            }

            // The heart acts on a `tracks` row a station lacks, so a station takes the vote in its
            // slot, gone rather than disabled where there's no directory uuid to vote against.
            if Player.vm.has_station && Player.vm.radio.uuid != "": AccentGlyphButton {
                icon: "thumb_up";
                tooltip-text: @tr("Vote");
                // This row is the panel's top edge, which would cut off an above-pill.
                tooltip-side: TooltipSide.left;
                clicked => {
                    Radio.vote(Player.vm.radio.uuid, Player.vm.radio.station_id);
                }
            }

            // Ungated: a style means something with an empty queue.
            VisualizerPicker { }

            // Gone on a station, a stream having no track to look a sheet up for.
            if !Player.vm.has_station: LyricsControls { }
        }

        // No right or bottom padding: the Up Next column reaches the panel's edges, so its
        // scrollbar lands flush and rows scroll off the bottom rather than under a strip of
        // backdrop.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.pad-lg;
            spacing: Theme.pad-md;

            // Spends the cover's slack first and scrolls only once the group's floors don't fit.
            Rectangle {
                horizontal-stretch: 1;

                group-sv := ScrollView {
                    width: 100%;
                    height: 100%;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: always-off;
                    // Locked, or the content takes its own preferred width and centres against it.
                    content-width: group-sv.visible-width;
                    // Off the column's minimum, never the scroller's: a ScrollView binds
                    // `content-height` back through its own preferred height, so that is a loop.
                    content-height: max(group-sv.visible-height, group.min-height);

                    group := VerticalLayout {
                        alignment: center;
                        padding-bottom: clamp(root.height * 0.04, Theme.pad-sm, Theme.pad-lg);
                        spacing: clamp(root.height * 0.03, 6px, Theme.pad-md);

                        // A plain Rectangle with each tile at an explicit `x`/`y`, which keeps this
                        // slot the column's only slack. A centring layout would
                        // fold the tile's minimum in and take that slack away.
                        cover-slot := Rectangle {
                            min-height: root.cover-min;
                            preferred-height: root.cover-h;
                            max-height: root.cover-h;

                            if !Player.vm.has_station: NowPlayingCover {
                                tile-size: min(parent.height, parent.width);
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                            }

                            // `ArtworkImage`, not `NowPlayingCover`: a station has nothing to
                            // cross-fade, and the shared tile owns the inset a favicon needs.
                            if Player.vm.has_station: ArtworkImage {
                                tile-size: min(parent.height, parent.width);
                                tile-radius: Theme.radius-lg;
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                                artwork-path: Player.vm.radio.artwork_path;
                                // The row tier until the large decode lands. The subscriber empties
                                // the large slot on every source change, so an empty one is a
                                // decode still out.
                                cover: Player.np-station-logo.width > 0
                                    ? Player.np-station-logo
                                    : Player.vm.radio.logo_img;
                                native-size: Player.np-station-logo-size * 1px;
                                fallback-text: Player.vm.radio.monogram;
                                fallback-icon: "radio";
                                tile-bg: @linear-gradient(135deg,
                                    Player.vm.radio.tile_color_1,
                                    Player.vm.radio.tile_color_2);
                                tile-icon-color: Theme.tile-ink;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            // Backdrop-solved: a `Theme.*` brush lands light-on-light on a light
                            // theme. Each size scales off the panel on its own floor, since one
                            // shared scale takes the album line under a readable size first.
                            Text {
                                text: Player.source-title;
                                color: Player.np-on-backdrop;
                                font-size: clamp(root.height * 0.05, Theme.font-size-md, Theme.page-title-size);
                                font-weight: 600;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: Player.source-subtitle;
                                color: Player.np-on-backdrop-muted;
                                font-size: clamp(root.height * 0.04, Theme.font-size-sm, Theme.font-size-lg);
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            if Player.source-tertiary != "": Text {
                                text: Player.source-tertiary;
                                color: Player.np-on-backdrop-muted.transparentize(0.25);
                                font-size: clamp(root.height * 0.035, Theme.font-size-sm, Theme.font-size-md);
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        // Gated on the track id, so a fetch landing after a quick skip is never
                        // shown against the wrong track.
                        if Player.vm.has_track: MetaChipStrip {
                            chips: Player.chips;
                            show-rows: Player.track-meta.track_id == Player.vm.track.id;
                            centred: true;
                            chip-fill: Player.np-chip-fill;
                            chip-label-color: Player.np-chrome-text;
                        }

                        // A row of its own, a bare cell being unable to carry the drop above it.
                        if Visualizer.enabled: HorizontalLayout {
                            alignment: center;
                            // The column is centred, so this splits between both ends: budget
                            // twice the drop you want.
                            padding-top: root.strip-drop;
                            VisualizerStrip {
                                width: root.strip-w;
                                strip-height: root.strip-h;
                            }
                        }
                    }
                }

                // No gutter: the group is centred, which leaves the bar's lane as backdrop.
                NpOverlayScrollbar {
                    x: parent.width - self.width;
                    y: 0;
                    width: Theme.scrollbar-slot;
                    height: parent.height;
                    visible-size: group-sv.visible-height;
                    content-size: group-sv.content-height;
                    offset: -group-sv.content-y;
                    scroll-to(o) => { group-sv.content-y = -o; }
                }
            }

            // One column with three arms: a fourth column would reflow the artwork whenever one
            // became available, `content-width` driving the chip wrap, strip and cover.
            VerticalLayout {
                width: root.up-next-width;
                spacing: Theme.pad-sm;

                Text {
                    // Translators: a heading in place of "Up Next", so keep it as short
                    text: Player.vm.has_station ? @tr("Station")
                        : Lyrics.enabled ? @tr("Lyrics")
                        : @tr("Up Next");
                    color: Player.np-accent-bright;
                    font-size: Theme.font-size-lg;
                    font-weight: 600;
                }
                Rectangle {
                    height: 1px;
                    // Lighter than the glyphs: a hairline at full alpha reads as a stripe.
                    background: Player.np-accent-bright.transparentize(0.55);
                }

                if !Player.vm.has_station && !Lyrics.enabled: UpNextList {
                    vertical-stretch: 1;
                    compact: false;
                }

                if !Player.vm.has_station && Lyrics.enabled: LyricsPanel {
                    vertical-stretch: 1;
                }
                // The station page's body on this view's palette, less the Votes row, whose number
                // comes from a directory refresh only the station page runs. One scroller for
                // both: the history is capped by its ring, so there's nothing to virtualize.
                if Player.vm.has_station: Rectangle {
                    vertical-stretch: 1;

                    station-sv := ScrollView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        content-width: self.width;

                        // The scroller keeps the bar's lane so the wheel works there too; the
                        // content insets instead.
                        VerticalLayout {
                            spacing: Theme.pad-md;
                            padding-right: Theme.scrollbar-slot;
                            alignment: start;

                            StationFacts {
                                stream-url: Player.vm.radio.stream_url;
                                homepage: Player.vm.radio.homepage;
                                codec: Player.vm.radio.codec;
                                bitrate: Player.vm.radio.bitrate;
                                play-count: Player.vm.radio.play_count;
                                // Narrower than the station page's: this column is a third of the
                                // panel, and a stream URL needs what it can get.
                                label-width: 80px;
                                label-color: Player.np-on-backdrop-muted;
                                value-color: Player.np-on-backdrop;
                                action-idle-fg: Player.np-accent-dim;
                                action-hover-fg: Player.np-accent-bright;
                                action-hover-bg: Player.np-accent-pill;
                                action-on-backdrop: true;
                                open-homepage(url) => { Radio.open-homepage(url); }
                            }

                            if Radio.history-rows.length > 0: StationHistory {
                                rows: Radio.history-rows;
                                heading-color: Player.np-on-backdrop-muted;
                                row-color: Player.np-on-backdrop;
                            }
                        }
                    }

                    NpOverlayScrollbar {
                        x: parent.width - self.width;
                        y: 0;
                        width: Theme.scrollbar-slot;
                        height: parent.height;
                        visible-size: station-sv.visible-height;
                        content-size: station-sv.content-height;
                        offset: -station-sv.content-y;
                        scroll-to(o) => { station-sv.content-y = -o; }
                    }
                }
            }
        }
    }
}
