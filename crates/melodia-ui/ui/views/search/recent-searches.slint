import { Theme } from "../../theme.slint";
import { Search } from "../../globals/search.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// One history chip: the body re-runs the term, the X forgets it. Unexported, as `ChipGroup`'s
// own `Chip` is — nothing else wants a removable pill.
component RecentChip inherits Rectangle {
    in property <string> term;

    callback picked();
    callback removed();

    // The 20 px close cell, the 4 px either side of it and the 10 px lead inset.
    property <length> chrome-w: 38px;
    property <length> natural-w: term-text.preferred-width + root.chrome-w;

    // Not a bound `width`, reported as both min and max: a pasted query wider than the strip has
    // to shrink and elide. The floor is the chrome plus the one `…` elide lowers the label to.
    min-width: min(root.chrome-w + term-text.min-width, root.natural-w);
    preferred-width: root.natural-w;
    max-width: root.natural-w;
    horizontal-stretch: 0;

    height: 28px;
    border-radius: self.height / 2;
    background: chip-touch.has-hover
        ? Theme.surface1
        : Theme.surface0;
    border-width: 1px;
    border-color: Theme.surface2;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }

    term-text := Text {
        x: 10px;
        y: (root.height - self.height) / 2;
        // Bound and elided, `slint-pitfalls.md`'s placeholder entry: unbounded, the label paints
        // through the pill's edge.
        width: max(0px, root.width - root.chrome-w);
        text: root.term;
        color: Theme.text;
        font-size: Theme.font-size-sm;
        overflow: elide;
    }

    // Declared **before** the close cell, so that cell's nested TouchArea wins dispatch on
    // the X: Slint dispatches to the last-declared overlapping one.
    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    close-cell := Rectangle {
        x: root.width - self.width - 4px;
        y: (root.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: close-touch.has-hover
            ? Theme.surface2
            : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
        MaterialIcon {
            name: "close";
            icon-size: 14px;
            icon-color: Theme.subtext0;
        }
        close-touch := TouchArea {
            mouse-cursor: pointer;
            // Declared after the chip's own, so this sits on top and wins dispatch here.
            clicked => { root.removed(); }
        }
    }
}

// The empty-query state: saved history as removable chips under a "Clear all" affordance.
// Everything it reads and writes is on `Search`; the mount site gates it on there being
// history, so it never renders an empty case of its own.
export component RecentSearches inherits VerticalLayout {
    vertical-stretch: 0;
    spacing: Theme.pad-sm;
    // Hands out no surplus height: the flex below reports no maximum and stretches its lines by
    // default, so a column with room to spare would spread the chips apart.
    alignment: start;

    HorizontalLayout {
        alignment: space-between;
        cross-axis-alignment: center;
        Text {
            text: @tr("Recent");
            color: Theme.text;
            font-size: Theme.font-size-md;
            font-weight: 700;
            letter-spacing: 0.4px;
        }
        clear-target := Rectangle {
            width: clear-label.preferred-width + 16px;
            height: 24px;
            border-radius: self.height / 2;
            background: clear-touch.has-hover
                ? Theme.surface1
                : transparent;
            animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
            clear-label := Text {
                x: 8px;
                y: (parent.height - self.height) / 2;
                text: @tr("Clear all");
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
            }
            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { Search.recent-clear(); }
            }
        }
    }

    FlexboxLayout {
        spacing: Theme.pad-sm;

        for t in Search.recent-rows: RecentChip {
            term: t;
            picked => { Search.recent-pick(self.term); }
            removed => { Search.recent-remove(self.term); }
        }
    }
}
