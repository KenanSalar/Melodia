import { Theme } from "../theme.slint";
import { Favorites } from "../globals/curated.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { MosaicTabHero } from "../components/hero/mosaic-tab-hero.slint";
import { TooltipFrame } from "../components/tooltip-frame.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { ActionPill, PillButton, PillDivider } from "../components/action-pill.slint";
import { SortPillRow } from "../components/sort-pill-row.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { FavoritesArtistsTab } from "favorites/artists-tab.slint";
import { FavoritesMostPlayedTab } from "favorites/most-played-tab.slint";
import { FavoritesSongsTab } from "favorites/songs-tab.slint";

// A pinned `MosaicTabHero` over three tabs, only the body scrolling so the tabs stay reachable.
// Albums are absent on purpose, the Albums tab reaching them. Each tab owns one scroller under
// plain `OverlayScrollbar`s, which keeps the page off the composite.
export component FavoritesView inherits Rectangle {
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { Favorites.filter-changed(Favorites.filter); }
    }

    TouchArea {
        clicked => { Favorites.blur-search-tick += 1; }
    }

    // Declared here for the geometry and the grids both, an `in` property being unreadable from
    // outside the component declaring it.
    property <length> grid-gap: 20px;

    property <int> grid-lone-row-cards:
        Favorites.tab-idx == Favorites.tab-most-played
            ? (Favorites.most-played-rows.length == 1
                ? Favorites.most-played-rows[0].entities.length : -1)
            : Favorites.tab-idx == Favorites.tab-artists
                ? (Favorites.artist-rows.length == 1
                    ? Favorites.artist-rows[0].entities.length : -1)
                : -1;

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
        lone-row-cards: root.grid-lone-row-cards;
    }

    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Favorites.columns = c;
            Favorites.columns-changed(c);
        }
    }

    property <string> filter-placeholder:
        Favorites.tab-idx == Favorites.tab-most-played
            ? @tr("Filter most played…")
            : Favorites.tab-idx == Favorites.tab-artists
                ? @tr("Filter artists…")
                : @tr("Filter favorites…");

    VerticalLayout {
        hero := MosaicTabHero {
            tab-labels: [@tr("Songs"), @tr("Most Played"), @tr("Favorite Artists")];
            tab-icons: ["music_note", "bar_chart", "person"];
            tab-idx <=> Favorites.tab-idx;

            title: @tr("Favorites");
            filter-placeholder: root.filter-placeholder;
            // The grids say it through their own `GridEmptyState`.
            show-empty-copy: Favorites.tab-idx == Favorites.tab-songs
                && Favorites.track-count == 0;
            empty-copy: @tr("No favorites yet");

            // Clamped, unlike every other reader of this count: `MosaicHeroTile` picks its glyph
            // on `== 0`, so an unfetched `-1` would draw the placeholder note where the page's
            // own glyph belongs while a re-entered section's collage is still empty.
            mosaic-count: max(Favorites.track-count, 0);
            mosaic-cover: Favorites.cover;
            empty-glyph: "favorite";
            empty-glyph-filled: true;

            blur-a: Favorites.blur-img-a;
            blur-b: Favorites.blur-img-b;
            use-a: Favorites.blur-use-a;
            has-blur: Favorites.has-blur;

            filter <=> Favorites.filter;
            blur-tick: Favorites.blur-search-tick;

            search-edited(t) => { root.filter-tick-pending += 1; }
            tab-selected(i) => {
                // Rust drops its own needle in `tab-changed`; this clears the box.
                Favorites.filter = "";
                Favorites.blur-search-tick += 1;
                Favorites.tab-changed(i);
            }

            // Most Played has no sort row on purpose, its title naming its own ordering.
            if Favorites.tab-idx == Favorites.tab-songs
                && Favorites.track-count > 0: HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { Favorites.shuffle-all(); }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        columns <=> Favorites.track-columns;
                        toggled(id) => { Favorites.toggle-column(id); }
                    }
                }
            }

            if Favorites.tab-idx == Favorites.tab-most-played
                && Favorites.most-played-count > 0: HorizontalLayout {
                vertical-stretch: 0;
                alignment: start;

                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { Favorites.shuffle-most-played(); }
                    }
                }
            }

            // The two fields a card shows, so an ordering is always visibly justified.
            if Favorites.tab-idx == Favorites.tab-artists
                && Favorites.artist-count > 0: HorizontalLayout {
                vertical-stretch: 0;
                alignment: start;

                SortPillRow {
                    labels: [@tr("Name"), @tr("Favorites")];
                    fields: ["name", "favorite_count"];
                    sort-field: Favorites.artist-sort-field;
                    sort-dir: Favorites.artist-sort-dir;
                    request-sort(f) => { Favorites.request-artist-sort(f); }
                }
            }
        }

        // Each branch carries its scrollbars, an id inside an `if` being unreadable outside it,
        // and so its own `ViewTransition` to slide them with the content. The `clip` holds the
        // slide's overshoot.
        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            if Favorites.tab-idx == Favorites.tab-songs: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: hero.tab-enter-from;
                enabled: hero.tab-anim-armed;

                FavoritesSongsTab {
                    width: 100%;
                    height: 100%;
                }
            }

            if Favorites.tab-idx == Favorites.tab-most-played: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: hero.tab-enter-from;
                enabled: hero.tab-anim-armed;

                FavoritesMostPlayedTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }

            if Favorites.tab-idx == Favorites.tab-artists: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: hero.tab-enter-from;
                enabled: hero.tab-anim-armed;

                FavoritesArtistsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
        }
    }

    // Last, since the body is declared after the hero and would cover its tab bar's pill.
    TooltipFrame {
        x: hero.absolute-position.x - root.absolute-position.x + hero.tip-x;
        y: hero.absolute-position.y - root.absolute-position.y + hero.tip-y;
        width: hero.tip-w;
        height: hero.tip-h;
        label: hero.tip-label;
        shown: hero.tip-visible;
    }
}
