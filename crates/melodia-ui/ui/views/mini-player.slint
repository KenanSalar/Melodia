import { Theme } from "../theme.slint";
import { Player } from "../globals/player.slint";
import { Lyrics } from "../globals/lyrics.slint";
import { DragRegion, MiniPlayer, MiniLayout, WindowChrome } from "../globals/shell.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";
import { LyricsPanel } from "../components/now-playing/lyrics-panel.slint";
import { MiniArtwork } from "../components/mini-player/mini-artwork.slint";
import { MiniBackdrop } from "../components/mini-player/mini-backdrop.slint";
import { MiniCaptionsRow } from "../components/mini-player/mini-captions.slint";
import { MiniTransport, MiniTrailingControls, MiniTimeline } from "../components/mini-player/mini-controls.slint";

// Replaces the full UI once the window shrinks past the threshold, and a window size is the only
// way in or out: the Full Player caption leaves by resizing the window.
//
// Every control stays clear of the window edges, where `ResizeRing`'s grabs sit above this view,
// so the cursor keeps the resize affordance rather than flickering hover. The corner grabs outgrow
// that inset on the rounder presets. The captions row is the exception, argued at its mount.
export component MiniPlayerView inherits Rectangle {
    background: Theme.mantle;
    private property <length> edge-pad: 4px;

    // The stacks' own pace, so the foreground crosses with the backdrop behind it.
    private property <bool> on-backdrop: MiniPlayer.backdrop-shown;
    private property <duration> recolor: Theme.dur-med;

    // Every leaf that would read a `Theme.*` brush takes one of these, matching what the same
    // element paints in Now Playing: answered once, since one site left on the theme's ink vanishes
    // on a light palette. Each is eased here, once. The two leaves that ease their own colours,
    // `IconButton` and the scrollbar, take `on-backdrop` and `recolor` instead, a brush eased twice
    // restarting its curve every frame (`slint-pitfalls.md`'s shared-brush entry).
    private property <brush> ink: root.on-backdrop ? Player.np-on-backdrop : Theme.text;
    private property <brush> ink-muted: root.on-backdrop ? Player.np-on-backdrop-muted : Theme.subtext0;
    // Off the backdrop Up Next's secondary columns take `Theme.text`, as every row list does.
    private property <brush> list-muted: root.on-backdrop ? Player.np-on-backdrop-muted : Theme.text;
    private property <brush> row-hover: root.on-backdrop ? Player.np-accent-pill : Theme.surface0;
    private property <brush> empty-glyph:
        root.on-backdrop ? Player.np-on-backdrop-muted.transparentize(0.5) : Theme.surface2;
    private property <brush> accent: root.on-backdrop ? Player.np-accent-bright : Theme.accent;
    // On the backdrop, `NowPlayingCover`'s faint recess rather than an accent slab, the wash
    // already carrying colour enough.
    private property <brush> tile-fill:
        root.on-backdrop ? Player.np-on-backdrop.transparentize(0.92) : Theme.accent.with-alpha(0.15);
    private property <brush> tile-glyph:
        root.on-backdrop ? Player.np-on-backdrop-muted.transparentize(0.5) : Theme.accent;
    private property <brush> chip-fill:
        root.on-backdrop ? Player.np-chip-fill : Theme.accent.with-alpha(0.18);
    private property <brush> chip-label: root.on-backdrop ? Player.np-chrome-text : Theme.accent;
    // The seam mask is a stadium in the colour behind the slider, so over a backdrop it is a blob
    // moving with the thumb; it clears there and the bars meet at their own rounded ends. Mantle at
    // no alpha rather than `transparent`, the ease running in straight RGBA: toward rgba(0,0,0,0)
    // the mask darkens on its way out.
    private property <brush> seam-mask:
        root.on-backdrop ? Theme.mantle.transparentize(1.0) : Theme.mantle;
    // Now Playing has no slider, so this takes the lyrics switch's resting track.
    private property <brush> track:
        root.on-backdrop ? Player.np-accent-bright.transparentize(0.76) : Theme.surface1;
    // The play glyph and a lit KDE caption's. `ink-on` rather than the bar's mantle: on the
    // backdrop the disc is the solved accent, whose brightness is the cover's to decide.
    private property <brush> disc-ink:
        root.on-backdrop ? Theme.ink-on(Player.np-accent-bright) : Theme.mantle;
    // Eased here, a caption easing only its hover. Off the backdrop it keeps the titlebar's
    // unfocused dimming.
    private property <brush> caption-ink: root.on-backdrop
        ? Player.np-accent-dim
        : (Theme.window-focused ? Theme.text : Theme.overlay1);
    // Only the theme arm stands down for a palette fade, the `Player` tier being written once a
    // track.
    animate ink, ink-muted, list-muted, row-hover, empty-glyph, accent, tile-fill, tile-glyph,
        chip-fill, chip-label, seam-mask, track, disc-ink, caption-ink {
        duration: root.recolor;
        easing: ease-in-out;
        enabled: root.on-backdrop || !Theme.recoloring;
    }

    // Its own pair rather than the title's ratio, which shrinks a line this small past reading.
    private property <length> subtitle-card-size: 11px;
    private property <length> subtitle-strip-size: 10px;

    pure function grown-size(strip: length, card: length) -> length {
        return round((strip + (card - strip) * stack.title-grow) / Theme.text-size-step)
            * Theme.text-size-step;
    }
    // The card end of that travel, grown on over `MiniPlayer.room-grow`. The two are continuous,
    // `title-grow` reaching 1 where the artwork's remaining travel begins.
    pure function roomy-size(card: length, roomy: length) -> length {
        return card + (roomy - card) * MiniPlayer.room-grow;
    }
    // How high the card's title line may ride, as a share of the artwork: a centred pair otherwise
    // climbs to the window's top as the artwork shrinks and stops reading as beside the cover.
    private property <float> line-share: 0.3;

    backdrop := MiniBackdrop {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        fade-duration: root.recolor;
    }

    // With no titlebar this is how the window moves. Under every control, so its hover is true
    // only over empty space; reported under its own name so a double press only moves it.
    drag-region := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
        changed has-hover => {
            WindowChrome.drag-region-changed(
                self.has-hover ? DragRegion.miniplayer : DragRegion.none);
        }
    }

    // Strip, card and column are one mount that grows rather than three that swap. Each part opens
    // into the height the one before it leaves (the artwork, then the captions row, then the
    // panel), so nothing arrives with height of its own to claim and the block never jumps. Below
    // the card the artwork's last stretch carries the controls up onto the title's line.
    stack := VerticalLayout {
        property <length> art-rows: 2 * root.edge-pad + timeline-gap.preferred-height
            + timeline.preferred-height;
        // Off the height the artwork is sized by rather than eased, so the controls rise with the
        // drag and at no other time.
        property <float> inline-t: clamp((MiniPlayer.stacked-art - (root.height - self.art-rows))
            / (MiniPlayer.stacked-art - MiniPlayer.art-floor), 0, 1);
        property <float> title-grow: 1 - self.inline-t;
        // The title makes the controls' room over the first eighth of their rise, before they reach
        // the bottom of its line.
        property <float> title-lead: min(1.0, self.inline-t * 8);

        property <length> captions-shown: clamp(
            root.height - self.art-rows - head.preferred-height, 0px, MiniPlayer.captions-height);

        // Off the block rather than a fixed height: a narrow window's artwork stops short of its
        // cap and frees the room sooner.
        property <bool> shows-panel: MiniPlayer.layout == MiniLayout.column
            && root.height - 2 * root.edge-pad - block.preferred-height > MiniPlayer.panel-gap;

        padding: root.edge-pad;
        spacing: 0;

        block := VerticalLayout {
            vertical-stretch: 0;
            spacing: 0;

            // Over the head, so a caption's tooltip lands on the title. The head's pills never
            // reach up here, the controls rising near the top only once the row has closed.
            MiniCaptionsRow {
                z: 2;
                open-height: stack.captions-shown;
                edge-pad: root.edge-pad;
                ink: root.caption-ink;
                ink-on-lit: root.disc-ink;
            }

            // Over the timeline, which a pill flips down onto when the controls sit near the top.
            head := HorizontalLayout {
                z: 1;
                vertical-stretch: 0;
                spacing: Theme.pad-sm;
                padding-left: Theme.pad-xs;

                // The block's only slack, which keeps every control on screen. Floored at the
                // strip's thumbnail, below which the timeline's gap gives instead. A plain
                // `Rectangle` with the tile placed by `x`/`y`, for Now Playing's cover-slot reason.
                Rectangle {
                    property <length> size: max(0px, min(MiniPlayer.art-cap,
                        root.width - 2 * root.edge-pad - Theme.pad-xs - Theme.pad-sm
                            - info.min-width,
                        max(MiniPlayer.art-floor, root.height - stack.art-rows)));

                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    min-width: 0px;
                    min-height: 0px;
                    preferred-width: self.size;
                    preferred-height: self.size;
                    max-width: self.size;
                    max-height: self.size;

                    MiniArtwork {
                        tile-size: min(parent.width, parent.height);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        track-tile-bg: root.tile-fill;
                        track-tile-icon-color: root.tile-glyph;
                    }
                }

                // The title over the controls, or beside them on the strip. Placed by `x`/`y`, a
                // layout only being able to jump between the two, so its bounds are spelled:
                // hand-placed children fold nothing into them.
                info := Rectangle {
                    property <length> titles-h: titles.preferred-height;
                    property <length> cluster-h: cluster.preferred-height;
                    property <length> stacked-gap: clamp(Theme.pad-xs
                        + (self.height - self.titles-h - Theme.pad-xs - self.cluster-h) / 3,
                        Theme.pad-xs, Theme.pad-md);
                    property <length> stacked-top:
                        (self.height - self.titles-h - self.stacked-gap - self.cluster-h) / 2;
                    property <length> card-line: max(self.stacked-top + self.titles-h / 2,
                        self.height * root.line-share);
                    property <length> card-cluster-y: min(self.height - self.cluster-h,
                        max(self.stacked-top + self.titles-h + self.stacked-gap,
                            self.card-line + self.titles-h / 2 + Theme.pad-xs));
                    // Comes down to the row's middle as the controls rise, so they meet the title
                    // wherever it is.
                    property <length> line-center: self.card-line
                        + (self.height / 2 - self.card-line) * stack.inline-t;
                    property <length> stacked-min-width: max(titles.min-width, cluster.min-width);
                    property <length> inline-min-width:
                        titles.min-width + Theme.pad-sm + cluster.min-width;
                    property <length> stacked-min-height:
                        self.titles-h + Theme.pad-xs + self.cluster-h;
                    property <length> inline-min-height: max(self.titles-h, self.cluster-h);

                    horizontal-stretch: 1;
                    // The layout clamps this up to the minimum; asking for more would have the
                    // shrink pass take width from the controls alongside the artwork.
                    preferred-width: 0px;
                    min-width: self.stacked-min-width
                        + (self.inline-min-width - self.stacked-min-width) * stack.title-lead;
                    min-height: self.stacked-min-height
                        + (self.inline-min-height - self.stacked-min-height) * stack.inline-t;

                    // No clip: the elide already stops the text, and a scissor at the line box
                    // cuts the marks above and below it.
                    titles := VerticalLayout {
                        x: 0;
                        y: parent.line-center - self.height / 2;
                        width: parent.width - (cluster.width + Theme.pad-sm) * stack.title-lead;
                        height: self.preferred-height;
                        spacing: 2px;

                        Text {
                            text: Player.source-title;
                            color: root.ink;
                            font-size: root.grown-size(Theme.font-size-sm,
                                root.roomy-size(Theme.font-size-md, Theme.font-size-lg));
                            font-weight: 500;
                            overflow: elide;
                        }
                        Text {
                            text: Player.source-subtitle;
                            color: root.ink-muted;
                            font-size: root.grown-size(root.subtitle-strip-size,
                                root.roomy-size(root.subtitle-card-size, Theme.font-size-sm));
                            overflow: elide;
                        }
                    }

                    cluster := HorizontalLayout {
                        property <length> inline-y: parent.line-center - self.height / 2;

                        x: parent.width - self.width;
                        y: parent.card-cluster-y
                            + (self.inline-y - parent.card-cluster-y) * stack.inline-t;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        spacing: Theme.pad-sm;

                        MiniTransport {
                            disc-color: root.accent;
                            disc-ink: root.disc-ink;
                        }

                        MiniTrailingControls {
                            recolor: root.recolor;
                            toggle-backdrop => { backdrop.set-shown(!MiniPlayer.backdrop-shown); }
                        }
                    }
                }
            }

            timeline-gap := Rectangle {
                min-height: Theme.pad-xs;
                preferred-height: Theme.pad-md;
                max-height: Theme.pad-md;
            }

            timeline := MiniTimeline {
                label-color: root.ink;
                fill-color: root.accent;
                track-color: root.track;
                seam-mask-color: root.seam-mask;
                chip-fill: root.chip-fill;
                chip-label: root.chip-label;
            }
        }

        if !stack.shows-panel: Rectangle { vertical-stretch: 1; }

        // Two arms rather than Now Playing's three: no room for the station panel under the
        // artwork, and the queue under a station is still what the controls act on. The preferred
        // height is the floor on purpose, so the shrink pass takes from the artwork first; the
        // stretch hands the panel the rest.
        if stack.shows-panel: VerticalLayout {
            min-height: MiniPlayer.panel-gap;
            preferred-height: MiniPlayer.panel-gap;
            vertical-stretch: 1;
            padding-top: MiniPlayer.panel-gap;

            // Clipped here, unlike Up Next: the sheet's empty state centres on the panel rather
            // than in its scroller, so a short panel would paint it over the timeline.
            if !Player.vm.has_station && Lyrics.enabled: LyricsPanel {
                clip: true;
                vertical-stretch: 1;
                compact: true;
                ink: root.ink;
                ink-muted: root.ink-muted;
                row-hover: root.row-hover;
                empty-glyph: root.empty-glyph;
                bar-on-backdrop: root.on-backdrop;
                bar-recolor-duration: root.recolor;
            }
            if Player.vm.has_station || !Lyrics.enabled: UpNextList {
                vertical-stretch: 1;
                compact: true;
                menu-enabled: false;
                ink: root.ink;
                ink-muted: root.list-muted;
                row-hover: root.row-hover;
                empty-ink: root.ink-muted;
                empty-glyph: root.empty-glyph;
                bar-on-backdrop: root.on-backdrop;
                bar-recolor-duration: root.recolor;
            }
        }
    }
}
