import { Theme } from "../theme.slint";
import { Player } from "../globals/player.slint";
import { Lyrics } from "../globals/lyrics.slint";
import { MiniPlayer, MiniLayout, WindowChrome } from "../globals/shell.slint";
import { IconButton } from "../components/icon-button.slint";
import { TooltipSide } from "../components/tooltip.slint";
import { CaptionButton, CaptionGlyph, MinimizeCaption, CloseCaption } from "../components/caption-buttons.slint";
import { MacOsTitleBarCluster } from "../components/macos-titlebar-cluster.slint";
import { MetaChip } from "../components/meta-chip.slint";
import { SourceArtwork } from "../components/now-playing/source-artwork.slint";
import { SeekRow } from "../components/now-playing/seek-row.slint";
import { VolumePopupHorizontal } from "../components/now-playing/volume-popup-horizontal.slint";
import { PlayButton } from "../components/now-playing/play-button.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";
import { LyricsPanel } from "../components/now-playing/lyrics-panel.slint";
import { AuroraBackdrop } from "../components/aurora-backdrop.slint";
import { HeroBlurBackdrop } from "../components/hero-blur-backdrop.slint";

// The view's own button, so the treatment is answered once rather than as five bindings on each of
// a dozen `IconButton`s. Private to this file and reading the switch straight off the global: the
// rule that a shared leaf takes its colours as inputs is there so one component can serve both
// tiers, and this one has a single host.
//
// **On the backdrop these are `AccentGlyphButton`'s**, the family Now Playing's header is made of:
// no chrome in any state, the glyph resting at the dim tier and coming up to full under the
// pointer, and a lit glyph lifting too so it still answers. Off it, the stock button. Not that
// component mounted directly, which has no off arm to switch to.
//
// **`MiniPlayerView`'s `glyph` / `glyph-lit` / `glyph-hover-bg` restate the first three arms**,
// for the volume trigger that is not this component, and that is forced rather than sloppy: a
// component cannot read a property off the host it is mounted in. Move one and move the other.
//
// Every arm steps, and `IconButton` eases the step itself at the view's repaint pace: easing them
// out here as well would restart its curve on every frame of this one.
component MiniIconButton inherits IconButton {
    private property <bool> on-backdrop: MiniPlayer.backdrop-shown;

    recolor-duration: Theme.dur-med;
    idle-fg: root.on-backdrop ? Player.np-accent-dim : Theme.text;
    hover-fg: root.on-backdrop ? Player.np-accent-bright : Theme.text;
    hover-bg: root.on-backdrop ? Colors.transparent : Theme.surface0;
    active-fg: root.on-backdrop ? Player.np-accent-bright : Theme.accent;
    hover-lift: root.on-backdrop;
    disabled-fg: root.on-backdrop
        ? Player.np-on-backdrop-muted.transparentize(0.55)
        : Theme.overlay0;
}

// Minimize, full player and close for the column's corner, in the style the Settings card picked.
// **The middle one restores rather than maximizes**: a miniplayer is a window size, so the button
// that grows the window hands back the full player at the geometry it last settled at.
//
// A layout rather than a `Rectangle`, so the `if`-mounted captions size it. Every caption takes the
// column's 28 px top row rather than a titlebar's 32.
component MiniCaptions inherits HorizontalLayout {
    // The standard glyphs' ink, eased by the host with the rest of its surface. Hover and its fill
    // stay stepped, the caption easing those itself.
    in property <brush> ink;
    in property <brush> ink-lit;
    in property <brush> hover-fill;

    private property <length> cell-width: 34px;
    private property <length> cell-height: 28px;

    horizontal-stretch: 0;
    spacing: 0;

    // The corner is fixed, so the cluster's side is too, whichever the titlebar's is set to.
    if MiniPlayer.button-style == 1: MacOsTitleBarCluster {
        captions-left: false;
        cell-height: root.cell-height;
        maximize-tooltip: @tr("Full Player");
        maximize => { WindowChrome.restore-full-player(); }
    }
    if MiniPlayer.button-style != 1: MinimizeCaption {
        cell-width: root.cell-width;
        cell-height: root.cell-height;
        idle-fg: root.ink;
        hover-fg: root.ink-lit;
        hover-bg: root.hover-fill;
    }
    if MiniPlayer.button-style != 1: CaptionButton {
        glyph: CaptionGlyph.maximize;
        tooltip-text: @tr("Full Player");
        cell-width: root.cell-width;
        cell-height: root.cell-height;
        idle-fg: root.ink;
        hover-fg: root.ink-lit;
        hover-bg: root.hover-fill;
        clicked => { WindowChrome.restore-full-player(); }
    }
    // Hover keeps the danger fill and its ink on either surface: closing is the one caption whose
    // warning is the point.
    if MiniPlayer.button-style != 1: CloseCaption {
        cell-width: root.cell-width;
        cell-height: root.cell-height;
        idle-fg: root.ink;
    }
}

// The artwork the card and the column set beside the controls. It takes the 384 px
// `Player.np-cover-{a,b}` slot the Now Playing view uses, falling back to the 72 px row tier until
// the seed lands and for tracks whose decode failed; `NowPlayingState::renders_artwork` gates that
// decode on these two layouts.
component MiniLargeArtwork inherits SourceArtwork {
    // Everything else about the tile is the shared track-or-station split. A station's large slot
    // is its own, `np-cover-*` being the track cross-fade.
    cover: Player.vm.has_station
        ? (Player.np-station-logo.width > 0
            ? Player.np-station-logo
            : Player.vm.radio.logo_img)
        : (Player.np-cover-has-image
            ? (Player.np-cover-use-a ? Player.np-cover-a : Player.np-cover-b)
            : Player.vm.track.cover_img);
    // Written together with the slot above, so a `0` here means the row-tier fallback is what's
    // drawing and there is nothing to measure.
    native-size: Player.np-station-logo-size * 1px;
}

// Previous, play and next at the strip's scale, for the strip and the controls row the card and the
// column share.
component MiniTransport inherits HorizontalLayout {
    // The play disc and the glyph punched out of it, eased by the host with the rest of its surface.
    in property <brush> disc-color;
    in property <brush> disc-ink;

    spacing: 2px;
    horizontal-stretch: 0;
    alignment: center;

    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "chevron_left";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            button-enabled: Player.vm.has_previous;
            tooltip-text: @tr("Previous");
            clicked => { Player.previous(); }
        }
    }
    VerticalLayout {
        alignment: center;
        PlayButton {
            wrapper-d: 30px;
            icon-size: 16px;
            is-playing: Player.vm.is_playing;
            animation-mode: 0;
            disc-color: root.disc-color;
            icon-color: root.disc-ink;
            clicked => { Player.play-pause(); }
        }
    }
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "chevron_right";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            button-enabled: Player.vm.has_next;
            tooltip-text: @tr("Next");
            clicked => { Player.next(); }
        }
    }
}

// Volume, the pin, the backdrop switch and the heart at the strip's scale, ending the controls row
// at the window's right edge in every layout.
component MiniTrailingControls inherits HorizontalLayout {
    // The volume trigger's glyph family, stepped for its `IconButton` to ease at `recolor`.
    in property <brush> glyph;
    in property <brush> glyph-lit;
    in property <brush> glyph-hover-bg;
    in property <duration> recolor;
    // The host's, the switch fading through `MiniPlayerView.set-backdrop`, which only the view can
    // reach.
    callback toggle-backdrop();

    spacing: 2px;
    horizontal-stretch: 0;
    alignment: end;
    // Keeps the corner-resize TouchAreas' hit zone clear.
    padding-right: 4px;

    VerticalLayout {
        alignment: center;
        // The vertical `VolumePopup` is 180 px tall and clips against the top edge of a strip or a
        // card; the horizontal sibling is the same slider rotated, flying out to the left of the
        // disc.
        //
        // A step above the row's glyphs, as the bar sets its own: at one size the speaker reads
        // smaller than the icons beside it.
        VolumePopupHorizontal {
            diameter: 28px;
            icon-size: 20px;
            trigger-fg: root.glyph;
            trigger-hover-fg: root.glyph-lit;
            trigger-hover-bg: root.glyph-hover-bg;
            trigger-recolor-duration: root.recolor;
        }
    }
    // Collapsed where the window manager gives no way to keep a window on top.
    if WindowChrome.always-on-top-supported: VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "push_pin";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            active: WindowChrome.always-on-top-active;
            filled: WindowChrome.always-on-top-active;
            tooltip-text: WindowChrome.always-on-top-active
                ? @tr("Unpin from Top") : @tr("Pin on Top");
            clicked => { WindowChrome.toggle-always-on-top(); }
        }
    }
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "tonality";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            active: MiniPlayer.backdrop-shown;
            filled: MiniPlayer.backdrop-shown;
            tooltip-text: MiniPlayer.backdrop-shown
                ? @tr("Album Backdrop: on") : @tr("Album Backdrop: off");
            clicked => { root.toggle-backdrop(); }
        }
    }
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            active: Player.vm.track.is_favorite;
            filled: Player.vm.track.is_favorite;
            button-enabled: Player.vm.has_track;
            tooltip-text: Player.vm.track.is_favorite
                ? @tr("Unfavorite") : @tr("Favorite");
            clicked => { Player.toggle-favorite(); }
        }
    }
}

// What sits under the controls in every layout: the seek row between shuffle and repeat, or for a
// stream, which has no position to seek within, the bar's live pill in its slot.
//
// **The two queue modes flank the track rather than joining the transport**, whose row already
// takes all the width the narrowest window can spare beside the artwork: two more buttons there
// would come out of the artwork, and out of the strip's title.
component MiniTimeline inherits HorizontalLayout {
    in property <brush> label-color;
    in property <brush> fill-color;
    in property <brush> track-color;
    in property <brush> seam-mask-color;
    in property <brush> chip-fill;
    in property <brush> chip-label;

    vertical-stretch: 0;
    spacing: 2px;
    // Keeps the corner-resize TouchAreas' hit zones clear at both ends.
    padding-left: 4px;
    padding-right: 4px;

    // Both pills open inward: at the window's edge a centred one runs off it.
    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: "shuffle";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            active: Player.queue.shuffle;
            tooltip-text: Player.queue.shuffle
                ? @tr("Shuffle: on") : @tr("Shuffle: off");
            tooltip-side: TooltipSide.right;
            clicked => { Player.toggle-shuffle(); }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;

        if !Player.vm.has_station: SeekRow {
            label-color: root.label-color;
            fill-color: root.fill-color;
            track-color: root.track-color;
            seam-mask-color: root.seam-mask-color;
        }
        if Player.vm.has_station: HorizontalLayout {
            alignment: center;
            MetaChip {
                text: Player.live-label;
                fill: root.chip-fill;
                label-color: root.chip-label;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        MiniIconButton {
            icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
            press-shrink: true;
            diameter: 28px;
            icon-size: 18px;
            active: Player.queue.repeat_mode != "off";
            tooltip-text: Player.queue.repeat_mode == "off"
                ? @tr("Repeat: off")
                : (Player.queue.repeat_mode == "one"
                    ? @tr("Repeat: one")
                    : @tr("Repeat: all"));
            tooltip-side: TooltipSide.left;
            clicked => { Player.cycle-repeat(); }
        }
    }
}

// Compact miniplayer replacing the full UI once the window shrinks past the
// responsive threshold. `MiniPlayer.active` (derived at the `AppWindow` root)
// arms it; `MiniPlayer.layout` picks the strip or the card, and whether the card has grown into the
// column.
//
// Resize is the only way in *and* out — there are no buttons. Double-clicking
// the bare drag region maximizes, so it also leaves mini.
//
// Every interactive control stays 8 px clear of the window edges, where
// `ResizeRing`'s grabs sit above this view, so the cursor keeps showing the
// resize affordance instead of flickering hover. The corner grabs grow with the
// window radius and reach past that inset on the rounder presets.
export component MiniPlayerView inherits Rectangle {
    background: Theme.mantle;
    // Doubles as resize-ring breathing room: the ring's TouchAreas sit above
    // this component, and the inset preserves their hit zones at all four edges.
    private property <length> edge-pad: 4px;

    // Which stack the backdrop button paints, the same property Now Playing reads. *Whether* one
    // is painted at all is `MiniPlayer.backdrop-shown`, and the two are deliberately separate
    // questions: this one is the restart-gated setting deciding which tier every colour is solved
    // for, that one is a live mount.
    private property <bool> aurora-shown: Theme.aurora-backdrop;

    // The switch the whole view repaints on, and how long the repaint takes. **The pace is the
    // stacks' own**: both drain on `Theme.dur-med` with this easing, so a foreground crossing on
    // anything else would land early or late against the backdrop behind it.
    private property <bool> on-backdrop: MiniPlayer.backdrop-shown;
    private property <duration> recolor: Theme.dur-med;

    // Every leaf that would otherwise read a `Theme.*` brush takes one of these instead, each on the
    // backdrop matching what the same kind of element paints in Now Playing. Answered once rather
    // than per site: on the blur arm the floor is solved dark under a solved-light foreground, so a
    // site left on the theme's ink vanishes on a light palette, and one site answering differently
    // from its neighbour is invisible until someone switches theme.
    //
    // **Each brush is eased exactly once, and this block is where for every leaf that paints it
    // straight.** The two leaves that ease their own colours, `IconButton` and the scrollbar, take
    // the stepped answer and `recolor` instead: a brush eased here that one of them eases too
    // restarts its curve on every frame of this one, `slint-pitfalls.md`'s shared-brush entry.
    private property <brush> ink: root.on-backdrop ? Player.np-on-backdrop : Theme.text;
    private property <brush> ink-muted: root.on-backdrop ? Player.np-on-backdrop-muted : Theme.subtext0;
    // Up Next's artist and duration, which off the backdrop take `Theme.text` like every row list
    // rather than the muted line under a title.
    private property <brush> list-muted: root.on-backdrop ? Player.np-on-backdrop-muted : Theme.text;
    private property <brush> row-hover: root.on-backdrop ? Player.np-accent-pill : Theme.surface0;
    private property <brush> empty-glyph:
        root.on-backdrop ? Player.np-on-backdrop-muted.transparentize(0.5) : Theme.surface2;
    private property <brush> accent: root.on-backdrop ? Player.np-accent-bright : Theme.accent;
    // The artwork placeholder, as `NowPlayingCover` draws it on the backdrop: a faint recess and a
    // quiet glyph rather than an accent slab, which a wash already carries colour enough for.
    private property <brush> tile-fill:
        root.on-backdrop ? Player.np-on-backdrop.transparentize(0.92) : Theme.accent.with-alpha(0.15);
    private property <brush> tile-glyph:
        root.on-backdrop ? Player.np-on-backdrop-muted.transparentize(0.5) : Theme.accent;
    // The live pill, as Now Playing's chips paint it: their own fill tier and a lettering tier held
    // to the text bar, rather than the chrome glyph colour.
    private property <brush> chip-fill:
        root.on-backdrop ? Player.np-chip-fill : Theme.accent.with-alpha(0.18);
    private property <brush> chip-label: root.on-backdrop ? Player.np-chrome-text : Theme.accent;
    // The seam mask is a stadium painted in whatever sits *behind* the slider, so it only works
    // over a flat surface. A backdrop is washes over a gradient, or a blurred cover under a scrim,
    // and no one colour matches either — a mask there is a flat blob that moves with the thumb.
    // Clear instead, which leaves the two bars meeting at their own rounded ends: the thumb covers
    // that join at rest, and the expressive gap is worth less than the blob costs. **Mantle at no
    // alpha rather than `transparent`**, the ease running in straight RGBA: toward rgba(0,0,0,0)
    // the mask darkens on its way out.
    private property <brush> seam-mask:
        root.on-backdrop ? Theme.mantle.transparentize(1.0) : Theme.mantle;
    // The seek track's unplayed half. Now Playing draws no slider, so this is the lyrics switch's
    // resting track, the one track that view lays on the backdrop.
    private property <brush> track:
        root.on-backdrop ? Player.np-accent-bright.transparentize(0.76) : Theme.surface1;
    // The play glyph, punched out of the disc above it. `ink-on` rather than the mantle the bar's
    // copy uses: on the backdrop the disc is the solved accent, whose brightness is the cover's to
    // decide, so the glyph has to be picked against it rather than against a surface.
    private property <brush> disc-ink:
        root.on-backdrop ? Theme.ink-on(Player.np-accent-bright) : Theme.mantle;
    // The standard captions' glyph at rest. A caption eases only its hover, so this one is eased
    // here. Off the backdrop it keeps the titlebar's own dimming on an unfocused window.
    private property <brush> caption-ink: root.on-backdrop
        ? Player.np-accent-dim
        : (Theme.window-focused ? Theme.text : Theme.overlay1);
    animate ink, ink-muted, list-muted, row-hover, empty-glyph, accent, tile-fill, tile-glyph,
        chip-fill, chip-label, seam-mask, track, disc-ink, caption-ink {
        duration: root.recolor;
        easing: ease-in-out;
    }

    // The glyph family, for the volume trigger, stepped for its `IconButton` to ease.
    // `MiniIconButton` carries the same three arms and says why it has to.
    private property <brush> glyph: root.on-backdrop ? Player.np-accent-dim : Theme.text;
    private property <brush> glyph-lit: root.on-backdrop ? Player.np-accent-bright : Theme.text;
    private property <brush> glyph-hover-bg: root.on-backdrop ? Colors.transparent : Theme.surface0;

    // The gap between the timeline and the column's panel, and the panel's whole floor: the list
    // comes in under the gap the moment there is room for it, rather than that room standing empty
    // until a row fits.
    private property <length> panel-gap: Theme.pad-sm;

    // The column's captions row with the gap under it. Spelled rather than measured: the row is
    // behind an `if`, and the artwork's height budget has to leave room for it from outside.
    private property <length> captions-height: 32px;

    // **Two flags rather than one, because a fade needs both of its ends on screen.** A stack
    // mounted already painting has nothing to ease in from, and one that stops painting still has
    // to be there for the length of its drain. So a press on mounts the stack unpainted and paints
    // it a tick later, and a press off unpaints it and unmounts it once the drain has run.
    //
    // Seeded by the binding and owned by `set-backdrop`, `my-library-view.slint`'s latch idiom:
    // `init` writes both to take them off the switch, which the function moves after them.
    private property <bool> backdrop-mounted: MiniPlayer.backdrop-shown;
    private property <bool> backdrop-painting: MiniPlayer.backdrop-shown;
    init => {
        root.backdrop-mounted = MiniPlayer.backdrop-shown;
        root.backdrop-painting = MiniPlayer.backdrop-shown;
    }

    // The one way the switch moves, for both variants' buttons. **Imperative rather than a `changed`
    // handler on the switch**: this view is mounted behind an `if`, and a tracker on a global
    // outlives the branch that declared it, so the next miniplayer's press would fire the last
    // one's and panic.
    function set-backdrop(on: bool) {
        backdrop-drain.running = false;
        if (on) {
            // Still mounted means mid-drain, with painted frames to ease back from. Otherwise the
            // timer inside the mount paints it once its unpainted first frame is down.
            root.backdrop-painting = root.backdrop-mounted;
            root.backdrop-mounted = true;
        } else {
            root.backdrop-painting = false;
            backdrop-drain.running = true;
        }
        MiniPlayer.backdrop-shown = on;
        MiniPlayer.set-backdrop-shown(on);
    }

    // Unmounts the stack once it has drained, so nothing fills the surface with a backdrop faded to
    // nothing. Reads the switch rather than clearing the flag, for a press back on that landed as
    // it fired.
    backdrop-drain := Timer {
        interval: root.recolor;
        running: false;
        triggered => {
            self.running = false;
            root.backdrop-mounted = MiniPlayer.backdrop-shown;
        }
    }

    // **Mounted as a pair behind the setting's two branches**, the contract every backdrop site
    // keeps: an arm behind the wrong branch reads perfectly and paints the other setting's
    // backdrop. Unmounted once drained rather than left drained to transparent, unlike the hero
    // bands, which have an idle state to hold: `Brush::is_transparent()` answers false for every
    // gradient whatever its stop alphas, so a hidden stack still fills the whole surface every
    // frame, and this one is hidden for every install that leaves the button off.
    //
    // Safe to read `Player.np-*` here for the reason Now Playing does: entering the miniplayer
    // force-closes `Nav.now-playing-open`, so the two readers of that tier are never on screen at
    // once.
    if root.backdrop-mounted: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // Paints the stack a tick after it mounts, so the first frame is the unpainted one its
        // drain eases in from. Reads the switch rather than setting `true`, for a press back off
        // inside that tick.
        Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                root.backdrop-painting = MiniPlayer.backdrop-shown;
            }
        }

        if !root.aurora-shown: HeroBlurBackdrop {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            floor-start: Player.np-floor-start;
            floor-end: Player.np-floor-end;
            scrim: Player.np-scrim;
            blur-a: Player.blur-img-a;
            blur-b: Player.blur-img-b;
            use-a: Player.blur-use-a;
            has-blur: Player.blur-has-image;
            shown: root.backdrop-painting;
        }

        if root.aurora-shown: AuroraBackdrop {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            base-start: Player.np-floor-start;
            base-end: Player.np-floor-end;
            tint-1: Player.np-tint-1;
            tint-2: Player.np-tint-2;
            tint-3: Player.np-tint-3;
            dither: Player.np-dither;
            shown: root.backdrop-painting;
        }
    }

    // Window-move drag region. Mini hides the `CustomTitleBar`, so without this
    // the window can't be moved at all. It covers the whole area at z-bottom
    // and every control sits above it — Slint dispatches to the topmost
    // TouchArea, so `has-hover` only goes true over empty space. Same
    // `drag-region-hover-changed` → winit press-intercept path as
    // `custom-titlebar.slint`.
    drag-region := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
        changed has-hover => {
            WindowChrome.drag-region-hover-changed(self.has-hover);
        }
        double-clicked => {
            // The size flip trips `mini-active = false` on its own.
            WindowChrome.toggle-maximize();
        }
    }

    // Strip, for a window too short for the card. The row and the timeline under it stay centred as a
    // pair, and the timeline moves down off the artwork as the window gives it height.
    //
    // **Spacers rather than an alignment**, here and in the card, since a non-stretch alignment
    // never hands out surplus: under `stretch` they split it evenly, the ones between rows capped so
    // the block still reads as one, and the outer two take the rest. Everything else pins its
    // stretch to 0.
    if MiniPlayer.layout == MiniLayout.strip: VerticalLayout {
        padding: root.edge-pad;
        spacing: 0;

        Rectangle { vertical-stretch: 1; }

        // No right inset of its own: the trailing controls carry the resize grabs' clearance, and
        // end where the timeline's repeat button does.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-sm;
            padding-left: Theme.pad-xs;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                SourceArtwork {
                    tile-size: 48px;
                    track-tile-bg: root.tile-fill;
                    track-tile-icon-color: root.tile-glyph;
                }
            }

            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Player.source-title;
                        color: root.ink;
                        font-size: Theme.font-size-sm;
                        font-weight: 500;
                        overflow: elide;
                    }
                    Text {
                        text: Player.source-subtitle;
                        color: root.ink-muted;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }

            MiniTransport {
                disc-color: root.accent;
                disc-ink: root.disc-ink;
            }

            MiniTrailingControls {
                glyph: root.glyph;
                glyph-lit: root.glyph-lit;
                glyph-hover-bg: root.glyph-hover-bg;
                recolor: root.recolor;
                toggle-backdrop => { root.set-backdrop(!MiniPlayer.backdrop-shown); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            max-height: Theme.pad-md;
        }

        MiniTimeline {
            label-color: root.ink;
            fill-color: root.accent;
            track-color: root.track;
            seam-mask-color: root.seam-mask;
            chip-fill: root.chip-fill;
            chip-label: root.chip-label;
        }

        Rectangle { vertical-stretch: 1; }
    }

    // Card and column, **one mount that grows rather than two that swap**: the artwork beside the
    // title and controls, the timeline under both, and in the column the window's captions above
    // and a panel below. Crossing between the two mounts or unmounts those rows and remounts
    // nothing else, and the switch crosses where the artwork has already stopped growing, so it
    // keeps its size across the swap.
    //
    // **Centred in the card, top-aligned in the column.** The column's surplus is where its panel
    // mounts, so the block holds still as the window grows rather than jumping up to make room.
    if MiniPlayer.layout != MiniLayout.strip: stack := VerticalLayout {
        // Any room for the list under the block. Measured off the block rather than a fixed
        // height, a narrow window's artwork stopping short of its cap and freeing the room that
        // much sooner.
        property <bool> shows-panel: MiniPlayer.layout == MiniLayout.column
            && root.height - 2 * root.edge-pad - block.preferred-height > root.panel-gap;

        padding: root.edge-pad;
        spacing: 0;

        if MiniPlayer.layout == MiniLayout.card: Rectangle { vertical-stretch: 1; }

        block := VerticalLayout {
            vertical-stretch: 0;
            spacing: 0;

            // The window's captions in the corner, where every titlebar puts them, and the panel's
            // switch opposite.
            if MiniPlayer.layout == MiniLayout.column: HorizontalLayout {
                min-height: root.captions-height;
                max-height: root.captions-height;
                spacing: 2px;
                padding-left: 4px;
                padding-right: 4px;
                padding-bottom: Theme.pad-xs;

                // **Hidden rather than unmounted**: gone on a station, which has no track to look a
                // sheet up for, and wherever no panel is mounted for it to swap. `shows-panel`
                // measures this row, so a branch here would read its own height.
                VerticalLayout {
                    alignment: center;
                    MiniIconButton {
                        visible: stack.shows-panel && !Player.vm.has_station;
                        icon: "lyrics";
                        press-shrink: true;
                        diameter: 28px;
                        icon-size: 18px;
                        active: Lyrics.enabled;
                        filled: Lyrics.enabled;
                        tooltip-text: Lyrics.enabled
                            ? @tr("Show Up Next") : @tr("Show lyrics");
                        tooltip-side: TooltipSide.right;
                        // Both halves, the full view's switch and the visualizer picker's shape:
                        // the property so the panel swaps on the press, the callback so it is
                        // still swapped next launch.
                        clicked => {
                            Lyrics.enabled = !Lyrics.enabled;
                            Lyrics.set-enabled(Lyrics.enabled);
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                MiniCaptions {
                    ink: root.caption-ink;
                    ink-lit: root.glyph-lit;
                    hover-fill: root.glyph-hover-bg;
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-sm;
                padding-left: Theme.pad-xs;

                // **The block's only slack, which is what keeps every control on screen.** Sized
                // to the smallest of the cap, the width the controls leave it and the height the
                // other rows leave it, so the tile fills the slot and sits flush with the title.
                // `MiniPlayerSwitch` hands a window too short even for the controls to the strip.
                //
                // **A plain `Rectangle` with the tile placed by `x` and `y`**, Now Playing's cover
                // slot and for its reason: a centring layout folds the tile's fixed size into the
                // slot's minimum, and the slot stops being able to give.
                Rectangle {
                    property <length> size: max(0px, min(MiniPlayer.art-cap,
                        root.width - 2 * root.edge-pad - Theme.pad-xs - Theme.pad-sm
                            - info.min-width,
                        root.height - 2 * root.edge-pad - timeline-gap.preferred-height
                            - timeline.preferred-height
                            - (MiniPlayer.layout == MiniLayout.column ? root.captions-height : 0px)));

                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    min-width: 0px;
                    min-height: 0px;
                    preferred-width: self.size;
                    preferred-height: self.size;
                    max-width: self.size;
                    max-height: self.size;

                    MiniLargeArtwork {
                        tile-size: min(parent.width, parent.height);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        track-tile-bg: root.tile-fill;
                        track-tile-icon-color: root.tile-glyph;
                    }
                }

                info := VerticalLayout {
                    horizontal-stretch: 1;
                    // Its floor, clamped up to its real minimum by the layout: asking for more
                    // would have the shrink pass take width from these controls alongside the
                    // artwork.
                    preferred-width: 0px;
                    spacing: 0;

                    Rectangle { vertical-stretch: 1; }

                    Rectangle {
                        clip: true;
                        vertical-stretch: 0;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Player.source-title;
                                color: root.ink;
                                font-size: Theme.font-size-md;
                                font-weight: 500;
                                overflow: elide;
                            }
                            Text {
                                text: Player.source-subtitle;
                                color: root.ink-muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        min-height: Theme.pad-xs;
                        max-height: Theme.pad-md;
                    }

                    HorizontalLayout {
                        vertical-stretch: 0;

                        MiniTransport {
                            disc-color: root.accent;
                            disc-ink: root.disc-ink;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        MiniTrailingControls {
                            glyph: root.glyph;
                            glyph-lit: root.glyph-lit;
                            glyph-hover-bg: root.glyph-hover-bg;
                            recolor: root.recolor;
                            toggle-backdrop => { root.set-backdrop(!MiniPlayer.backdrop-shown); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            timeline-gap := Rectangle {
                min-height: Theme.pad-xs;
                preferred-height: Theme.pad-md;
                max-height: Theme.pad-md;
            }

            timeline := MiniTimeline {
                label-color: root.ink;
                fill-color: root.accent;
                track-color: root.track;
                seam-mask-color: root.seam-mask;
                chip-fill: root.chip-fill;
                chip-label: root.chip-label;
            }
        }

        if !stack.shows-panel: Rectangle { vertical-stretch: 1; }

        // Both arms are shared with the full-screen view, and `up_next.rs` keeps the list's rows
        // fed while mini is up.
        //
        // **Two arms rather than three**: a station keeps Up Next here, where the full view swaps
        // in a panel describing the stream. There is no room for that panel under the artwork, and
        // the queue underneath a station is still what the controls above act on.
        //
        // **Its preferred height is its floor on purpose.** The shrink pass takes height from every
        // row with room between the two, so a panel asking for more would give ground alongside
        // the artwork, where the artwork is meant to give first. Everything past the floor still
        // comes to it through the stretch.
        if stack.shows-panel: VerticalLayout {
            min-height: root.panel-gap;
            preferred-height: root.panel-gap;
            vertical-stretch: 1;
            padding-top: root.panel-gap;

            // **Clipped here**, Up Next clipping itself: the sheet's empty state is centred on the
            // panel rather than inside its scroller, so a panel shorter than the message would
            // paint it over the timeline.
            if !Player.vm.has_station && Lyrics.enabled: LyricsPanel {
                clip: true;
                vertical-stretch: 1;
                compact: true;
                ink: root.ink;
                ink-muted: root.ink-muted;
                row-hover: root.row-hover;
                empty-glyph: root.empty-glyph;
                bar-on-backdrop: root.on-backdrop;
                bar-recolor-duration: root.recolor;
            }
            if Player.vm.has_station || !Lyrics.enabled: UpNextList {
                vertical-stretch: 1;
                compact: true;
                ink: root.ink;
                ink-muted: root.list-muted;
                row-hover: root.row-hover;
                empty-ink: root.ink-muted;
                empty-glyph: root.empty-glyph;
                bar-on-backdrop: root.on-backdrop;
                bar-recolor-duration: root.recolor;
            }
        }
    }
}
