import { MyLibrary } from "../globals/my-library.slint";
import { NavEnterFrom } from "../globals/nav.slint";
import { AlbumDetail, Albums } from "../globals/albums.slint";
import { ArtistDetail, Artists } from "../globals/artists.slint";
import { GenreDetail, Genres } from "../globals/genres.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { PlaylistDetail, Playlists } from "../globals/playlists.slint";
import { Tracks } from "../globals/tracks.slint";
import { DetailArrival } from "../components/detail-arrival.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { LibraryTabBand } from "../components/hero/library-tab-band.slint";
import { TooltipFrame } from "../components/tooltip-frame.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { MyLibrarySongsTab } from "my-library/songs-tab.slint";
import { MyLibraryAlbumsTab } from "my-library/albums-tab.slint";
import { MyLibraryArtistsTab } from "my-library/artists-tab.slint";
import { MyLibraryGenresTab } from "my-library/genres-tab.slint";
import { MyLibraryPlaylistsTab } from "my-library/playlists-tab.slint";
import { MyLibraryTabPills } from "my-library/tab-pills.slint";
import { AlbumDetailBody } from "my-library/album-detail.slint";
import { ArtistDetailBody } from "my-library/artist-detail.slint";
import { GenreDetailBody } from "my-library/genre-detail.slint";
import { PlaylistDetailBody } from "my-library/playlist-detail.slint";

// My Library's mount sheet. The tab index routes, not the detail id: a tab left with its detail
// open keeps the id, so several `*Detail.*-id` can be `>= 0` at once.
export component MyLibraryView inherits Rectangle {
    property <int> filter-tick-pending;

    // Which of the nine branches is mounted, spelled once so the router, the band and the pills
    // can't disagree. Here rather than on `MyLibrary`, which would then import its siblings.
    property <bool> album-open:
        MyLibrary.tab-idx == MyLibrary.tab-albums && AlbumDetail.album-id >= 0;
    property <bool> artist-open:
        MyLibrary.tab-idx == MyLibrary.tab-artists && ArtistDetail.artist-id >= 0;
    property <bool> genre-open:
        MyLibrary.tab-idx == MyLibrary.tab-genres && GenreDetail.genre-id >= 0;
    property <bool> playlist-open:
        MyLibrary.tab-idx == MyLibrary.tab-playlists && PlaylistDetail.playlist-id >= 0;
    property <bool> detail-open:
        root.album-open || root.artist-open || root.genre-open || root.playlist-open;

    // A boot restore's id lands only with its fetch, so until then this keeps the tab's grid from
    // painting the wrong page. Each arm carries its tab check, so a grid branch reads it alone.
    property <bool> detail-restoring:
        (MyLibrary.tab-idx == MyLibrary.tab-albums && AlbumDetail.restoring)
        || (MyLibrary.tab-idx == MyLibrary.tab-artists && ArtistDetail.restoring)
        || (MyLibrary.tab-idx == MyLibrary.tab-genres && GenreDetail.restoring)
        || (MyLibrary.tab-idx == MyLibrary.tab-playlists && PlaylistDetail.restoring);

    // The arm the band's hero paints, lagging the four above by one close: those flip on the
    // frame the exit morph starts, which would spend the whole collapse on the ternaries' last
    // arm. Seeded by the binding and owned by the handlers, guarded on `detail-open` so a
    // cross-tab drill moves them and a close leaves them alone.
    property <bool> hero-album: root.album-open;
    property <bool> hero-artist: root.artist-open;
    property <bool> hero-genre: root.genre-open;
    property <bool> hero-playlist: root.playlist-open;

    // All four on every latch: the ternaries test them in order, so a stale arm from an earlier
    // drill would outrank the one actually open.
    function latch-hero() {
        self.hero-album = root.album-open;
        self.hero-artist = root.artist-open;
        self.hero-genre = root.genre-open;
        self.hero-playlist = root.playlist-open;
    }

    // The idle band's sentence, held across an open as `hero-*` is: the band fades it over the
    // morph's first half, and bound live it would re-read the arriving tab's count mid-rewind.
    // `latch-count` is unguarded so `init` can take ownership; the guard sits at the call sites.
    property <string> live-count:
        MyLibrary.tab-idx == MyLibrary.tab-songs
            ? (Tracks.total-count >= 0
                ? @tr("{n} song" | "{n} songs" % Tracks.total-count) : "")
        : MyLibrary.tab-idx == MyLibrary.tab-albums
            ? (Albums.total-count >= 0
                ? @tr("{n} album" | "{n} albums" % Albums.total-count) : "")
        : MyLibrary.tab-idx == MyLibrary.tab-artists
            ? (Artists.total-count >= 0
                ? @tr("{n} artist" | "{n} artists" % Artists.total-count) : "")
        : MyLibrary.tab-idx == MyLibrary.tab-genres
            ? (Genres.total-count >= 0
                ? @tr("{n} genre" | "{n} genres" % Genres.total-count) : "")
        : (Playlists.total-count >= 0
            ? @tr("{n} playlist" | "{n} playlists" % Playlists.total-count) : "");
    property <string> count-line: root.live-count;
    function latch-count() { self.count-line = root.live-count; }
    changed live-count => {
        if (!root.detail-open) { root.latch-count(); }
    }

    // A latch owns its binding only once written, and neither guard fires on a page mounting
    // straight into the state it holds for: entered onto a detail, the first back would follow the
    // live binding through the collapse. `init` runs after the bindings resolve, so nothing moves.
    init => {
        root.latch-hero();
        root.latch-count();
    }

    // Whether a mounting body may animate, the page's own entrance still being in flight when its
    // first body mounts. The bar arms it for a pick, `DetailArrival` for a drill or close, and
    // `watched-tab-idx` for a tab move that isn't a pick.
    property <bool> body-anim-armed: band.tab-anim-armed;
    DetailArrival {
        open: root.detail-open;
        restoring: root.detail-restoring;
        arrived => { root.body-anim-armed = true; }
    }
    changed detail-open => {
        if (!root.detail-open) { root.latch-count(); }
    }

    changed album-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed artist-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed genre-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed playlist-open => {
        if (root.detail-open) { root.latch-hero(); }
    }

    // The surface under the filter box moved, so Rust reseats the box from it
    // (`slint-pitfalls.md`'s filter entry).
    property <int> watched-album-id: AlbumDetail.album-id;
    changed watched-album-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-artist-id: ArtistDetail.artist-id;
    changed watched-artist-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-genre-id: GenreDetail.genre-id;
    changed watched-genre-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-playlist-id: PlaylistDetail.playlist-id;
    changed watched-playlist-id => { MyLibrary.detail-scope-changed(); }

    // A cross-tab drill or a Mouse-4/5 walk moves the tab without a pick's clear, so it reseats
    // the box too. A pick clears both sides first, which leaves `sync_box` nothing to do.
    property <int> watched-tab-idx: MyLibrary.tab-idx;
    changed watched-tab-idx => {
        root.body-anim-armed = true;
        MyLibrary.detail-scope-changed();
    }

    TouchArea {
        clicked => { MyLibrary.blur-search-tick += 1; }
    }

    FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { MyLibrary.filter-changed(MyLibrary.filter); }
    }

    // Declared here for the geometry and the grids both, an `in` property being unreadable from
    // outside the component declaring it.
    property <length> grid-gap: 20px;

    property <int> grid-lone-row-cards:
        MyLibrary.tab-idx == MyLibrary.tab-albums
            ? (Albums.grid-rows.length == 1 ? Albums.grid-rows[0].albums.length : -1)
            : MyLibrary.tab-idx == MyLibrary.tab-artists
                ? (Artists.grid-rows.length == 1 ? Artists.grid-rows[0].artists.length : -1)
                : MyLibrary.tab-idx == MyLibrary.tab-genres
                    ? (Genres.grid-rows.length == 1 ? Genres.grid-rows[0].genres.length : -1)
                    : MyLibrary.tab-idx == MyLibrary.tab-playlists
                        ? (Playlists.grid-rows.length == 1
                            ? Playlists.grid-rows[0].playlists.length : -1)
                        : -1;

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
        lone-row-cards: root.grid-lone-row-cards;
    }

    // The count goes to all four, so no grid's fetch enters at a stale one; the re-chunk only to
    // the tab on screen. Gated on the tab rather than the detail id, so a detail closing finds its
    // grid already chunked to fit.
    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Albums.columns = c;
            Artists.columns = c;
            Genres.columns = c;
            Playlists.columns = c;
            if (MyLibrary.tab-idx == MyLibrary.tab-albums) { Albums.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-artists) { Artists.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-genres) { Genres.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-playlists) {
                Playlists.columns-changed(c);
            }
        }
    }

    VerticalLayout {
        band := LibraryTabBand {
            // Order matches `MyLibrary.tab-*`.
            tab-labels: [@tr("Songs"), @tr("Albums"), @tr("Artists"), @tr("Genres"), @tr("Playlists")];
            tab-icons: ["music_note", "album", "person", "theater_comedy", "playlist_play"];
            tab-idx <=> MyLibrary.tab-idx;
            // The bodies take their direction off `band.tab-enter-from`, never
            // `Nav.pending-enter-from`, which a write here would leave stale for the next page.
            tab-selected(i) => { MyLibrary.tab-changed(i); }

            filter <=> MyLibrary.filter;
            blur-tick: MyLibrary.blur-search-tick;
            search-edited(t) => { root.filter-tick-pending += 1; }

            pill-natural-w: pill-ruler.preferred-width;

            // The latched sentence, not `live-count`.
            count-text: root.count-line;

            // A detail's arms first, so a drill-in states what the box now filters.
            filter-placeholder:
                root.artist-open ? @tr("Filter tracks & albums…")
                : root.detail-open ? @tr("Filter tracks…")
                : MyLibrary.tab-idx == MyLibrary.tab-songs ? @tr("Filter tracks…")
                : MyLibrary.tab-idx == MyLibrary.tab-albums ? @tr("Filter albums…")
                : MyLibrary.tab-idx == MyLibrary.tab-artists ? @tr("Filter artists…")
                : MyLibrary.tab-idx == MyLibrary.tab-genres ? @tr("Filter genres…")
                : @tr("Filter playlists…");

            // The hero facts read `hero-*` and everything else `*-open`: which banner is painted
            // has to survive the id clear, which body is mounted must not.
            detail-open: root.detail-open;
            back-clicked => { MyLibrary.back(); }
            hero-collapsed => { MyLibrary.hero-collapsed(); }

            title:
                root.hero-album ? AlbumDetail.album.name
                : root.hero-artist ? ArtistDetail.artist.name
                : root.hero-genre ? GenreDetail.genre.name
                : PlaylistDetail.playlist.name;
            subtitle:
                root.hero-album ? AlbumDetail.album.artist_name
                : root.hero-playlist ? PlaylistDetail.playlist.description
                : "";
            title-badge: root.hero-playlist && PlaylistDetail.playlist.is_smart;

            artwork-path:
                root.hero-album ? AlbumDetail.album.artwork_path
                : root.hero-artist ? ArtistDetail.artist.image_path
                : root.hero-playlist ? PlaylistDetail.playlist.artwork_path
                : "";
            // Genre owns no cover and Slint has no empty `image`, so its arm lands on a
            // sibling's and the band gates on `artwork-path` instead.
            cover:
                root.hero-album ? AlbumDetail.cover
                : root.hero-artist ? ArtistDetail.cover
                : PlaylistDetail.cover;
            circular-artwork: root.hero-artist;
            fallback-icon:
                root.hero-album ? "album"
                : root.hero-artist ? "person"
                : root.hero-genre ? "theater_comedy"
                : "playlist";
            // The grid card's own name-hashed stops, so a genre stays recognisable across the
            // drill-in.
            tile-bg: root.hero-genre
                ? @linear-gradient(135deg,
                    GenreDetail.genre.tile_color_1,
                    GenreDetail.genre.tile_color_2)
                : HeroBackdrop.placeholder.transparentize(0.85);
            tile-icon-color: root.hero-genre
                ? #ffffff.with-alpha(0.3)
                : HeroBackdrop.placeholder;

            // `has-blur` is the gate, not the slot: Genre declares no blur quartet, so its arm
            // lands on a sibling's and paints only the floor, as a procedural backdrop should.
            blur-a:
                root.hero-artist ? ArtistDetail.blur-img-a
                : root.hero-playlist ? PlaylistDetail.blur-img-a
                : AlbumDetail.blur-img-a;
            blur-b:
                root.hero-artist ? ArtistDetail.blur-img-b
                : root.hero-playlist ? PlaylistDetail.blur-img-b
                : AlbumDetail.blur-img-b;
            use-a:
                root.hero-artist ? ArtistDetail.blur-use-a
                : root.hero-playlist ? PlaylistDetail.blur-use-a
                : AlbumDetail.blur-use-a;
            has-blur:
                root.hero-album ? AlbumDetail.has-blur
                : root.hero-artist ? ArtistDetail.has-blur
                : root.hero-playlist ? PlaylistDetail.has-blur
                : false;

            // `tab-pills.slint` says why the rows are a component rather than `if`s here.
            pills := MyLibraryTabPills {
                album-open: root.album-open;
                artist-open: root.artist-open;
                genre-open: root.genre-open;
                playlist-open: root.playlist-open;
                compact-t: band.pills-compact-t;
            }
        }

        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Nothing slides while the band morphs, not even on the same axis, the two curves
            // disagreeing enough that the sum runs the wrong way. A detail isn't a move along
            // the bar, so the four keep `above`.
            if MyLibrary.tab-idx == MyLibrary.tab-songs: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                MyLibrarySongsTab { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-albums && !root.album-open && !root.detail-restoring: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                MyLibraryAlbumsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.album-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: NavEnterFrom.above;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                AlbumDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-artists && !root.artist-open && !root.detail-restoring: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                MyLibraryArtistsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.artist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: NavEnterFrom.above;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                ArtistDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-genres && !root.genre-open && !root.detail-restoring: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                MyLibraryGenresTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.genre-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: NavEnterFrom.above;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                GenreDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-playlists && !root.playlist-open && !root.detail-restoring: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                MyLibraryPlaylistsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.playlist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: NavEnterFrom.above;
                enabled: root.body-anim-armed;
                slide: !band.morphing;
                PlaylistDetailBody { width: 100%; height: 100%; }
            }
        }
    }

    // Measured, never drawn: the band weighs the room beside the cover against the labelled width,
    // which the drawn row stops reporting once its labels close.
    pill-ruler := MyLibraryTabPills {
        x: 0px;
        y: 0px;
        visible: false;
        album-open: root.album-open;
        artist-open: root.artist-open;
        genre-open: root.genre-open;
        playlist-open: root.playlist-open;
    }

    // Last, since the body is declared after the band and would cover a pill the band drew.
    TooltipFrame {
        x: band.absolute-position.x - root.absolute-position.x + band.tip-x;
        y: band.absolute-position.y - root.absolute-position.y + band.tip-y;
        width: band.tip-w;
        height: band.tip-h;
        label: band.tip-label;
        shown: band.tip-visible;
    }

    TooltipFrame {
        x: pills.absolute-position.x - root.absolute-position.x + pills.tip-x;
        y: pills.absolute-position.y - root.absolute-position.y + pills.tip-y;
        width: pills.tip-w;
        height: pills.tip-h;
        label: pills.tip-label;
        shown: pills.tip-visible;
        align-end: pills.tip-align-end;
    }
}
