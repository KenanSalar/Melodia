import { Favorites } from "../../globals/curated.slint";
import { Player } from "../../globals/player.slint";
import { TrackListScrollbars } from "../../components/track-list-scrollbars.slint";
import { TrackList } from "../../components/track-list/track-list.slint";

// The Songs tab: a `TrackList` over the post-filter model, with its own overlay
// scrollbars. No inputs — everything it reads is on a global. The scrollbars
// live here rather than at the mount site because Slint can't read an id
// declared inside an `if` from outside it, which is also what makes a per-tab
// file the natural boundary.
export component FavoritesSongsTab inherits Rectangle {
    tl := TrackList {
        width: 100%;
        height: 100%;

        rows: Favorites.tracks;
        columns <=> Favorites.track-columns;

        sort-field: Favorites.sort-field;
        sort-dir: Favorites.sort-dir;
        playing-track-id: Player.vm.track.id;
        view-context: "favorites";
        view-selected-ids: Favorites.selected-ids;

        request-sort(f) => { Favorites.request-sort(f); }
        play-row(id, idx) => { Favorites.play-row(id, idx); }
        play-next(ids) => { Favorites.play-next(ids); }
        add-to-queue(ids) => { Favorites.add-to-queue(ids); }
        toggle-row-favorite(ids, on) => { Favorites.toggle-row-favorite(ids, on); }
        set-row-rating(ids, n) => { Favorites.set-row-rating(ids, n); }
        select-row(idx, id, sh, ct) => { Favorites.select-row(idx, id, sh, ct); }
        request-blur-search => { Favorites.blur-search-tick += 1; }
        go-to-album(aid) => { Favorites.go-to-album(aid); }
        go-to-artist(aid) => { Favorites.go-to-artist(aid); }
        go-to-genre(gid) => { Favorites.go-to-genre(gid); }
    }

    TrackListScrollbars {
        x: 0; y: 0; width: 100%; height: 100%;
        list-y: tl.absolute-position.y - root.absolute-position.y;
        body-y: tl.body-y;
        body-height: tl.body-height;
        v-visible-height: tl.v-visible-height;
        v-viewport-height: tl.v-viewport-height;
        v-offset: tl.v-offset;
        set-v-offset(o) => { tl.set-v-offset(o); }
    }
}
