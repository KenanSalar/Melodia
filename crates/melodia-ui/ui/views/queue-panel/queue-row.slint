import { Theme } from "../../theme.slint";
import { Queue } from "../../globals/queue.slint";
import { QueueRow } from "../../models.slint";
import { ArtworkImage } from "../../components/artwork-image.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Checkbox } from "../../components/checkbox.slint";
import { TrackContextMenu } from "../../components/track-list/track-context-menu.slint";
import { ContextClick } from "../../components/context-menu.slint";
import { SelectionPill } from "../../components/track-list/selection-pill.slint";
import { TrackTitle } from "../../components/track-list/track-title.slint";

// One fixed-height queue row: number-or-checkbox, artwork, title, and the duration, which gives way
// to the remove button on hover. Favourite and rating are the row menu's, so the title keeps the
// room a heart and a star strip would take.
//
// **The checkbox starts a selection and the row body extends one** — a body click is a no-op
// until the panel holds a pick, the whole-row TouchArea otherwise being double-click skip-to. A
// drag is the panel's `DragSource`, which this row only tells about its press.
export component QueueRowItem inherits Rectangle {
    in property <QueueRow> row-data;
    in property <int> row-index;
    // Owned by the host, so the rows and its drop target's slots can't disagree about how tall a
    // row is.
    in property <length> row-height;
    // Merge contiguous selected rows into one continuous pill; `QueuePanel` computes
    // both from `Queue.rows[idx ± 1].selected`.
    in property <bool> prev-selected;
    in property <bool> next-selected;
    // The row the panel's drag picked up.
    in property <bool> lifted;

    // A left press on the row body, which is what a drag from it would carry.
    callback pressed();

    property <bool> playing: root.row-index == Queue.current-index;
    property <bool> selected: root.row-data.selected;
    // The lifted row dims through its brushes rather than `opacity`, which would render it into a
    // texture for the length of the drag, and a drag of picks lifts a screenful.
    property <float> fade: root.lifted ? Theme.fade-lifted : 1.0;
    // The number's and the title's colour; `Theme.text` throughout, as in the track lists: same
    // body copy on the same background, and reading dimmer than the lists beside the panel is the
    // one thing these rows shouldn't do.
    property <brush> ink: (root.playing ? Theme.accent : Theme.text).transparentize(1.0 - root.fade);
    // What every hover-driven binding reads, so the row stays lit under its own menu.
    property <bool> hovered: touch.has-hover || ctx-menu.is-open;
    // An open menu takes the panel's hover, so the winit filter reads the press on an entry as a
    // press elsewhere and drops the queue's keys. The menu hands them back as it closes.
    property <bool> menu-open: ctx-menu.is-open;
    changed menu-open => {
        if (!self.menu-open) {
            Queue.keys-owned = true;
        }
    }
    property <bool> show-checkbox: root.hovered || root.selected;
    // Once the panel holds a selection the row body picks instead of doing nothing; the first
    // pick stays the checkbox's. The track lists' rule, spelled against the queue's own count.
    property <bool> selecting: Queue.selected-count > 0;
    // Modifiers as they stood on the press the pick is about to complete; see `touch.clicked`.
    property <bool> press-ctrl;
    property <bool> press-shift;

    // The checkbox and the row body both pick through here. Ctrl is forced on whenever shift
    // isn't held, so a pick on a selected row always removes it.
    function pick(ctrl: bool, shift: bool) {
        Queue.toggle-select(root.row-index, ctrl || !shift, shift);
    }

    height: root.row-height;

    // Inset so the rounded hover pill clears the card edges. The whole-row `TouchArea`
    // lives **inside** chrome and **wraps** the cells layout, the `track-list-row.slint`
    // pattern: that makes the checkbox and the delete button real descendants of
    // `touch`, so deepest-wins hit-testing routes clicks to them first and falls through
    // to `touch` only on empty cell area. Declared as a sibling instead, the inner
    // TouchAreas are cousins, get none of that routing, and the row swallows every click.
    chrome := Rectangle {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;

        if root.selected || root.hovered: SelectionPill {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            selected: root.selected;
            hovered: root.hovered;
            fade: root.fade;
            prev-selected: root.prev-selected;
            next-selected: root.next-selected;
        }

        touch := TouchArea {
            // On `clicked` rather than the release, per `slint-pitfalls.md`, this row's checkbox
            // being hover-mounted too. A drag sends this area a cancel, so neither fires after one.
            clicked => {
                if (root.selecting) {
                    root.pick(root.press-ctrl, root.press-shift);
                }
            }
            double-clicked => { Queue.skip-to(root.row-index); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    // `clicked` carries no modifiers, so they are taken off the press.
                    root.press-ctrl = ev.modifiers.control;
                    root.press-shift = ev.modifiers.shift;
                    root.pressed();
                }
                if (ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    ctx-menu.show-at(self.mouse-x, self.mouse-y);
                }
            }

            // Kept off the cross-axis solve, so the artwork keeps its own centring layout: under
            // it the duration cell would be held to the remove button's 26 px while it shows.
            HorizontalLayout {
                padding-left: Theme.pad-md;
                padding-right: Theme.pad-md;
                spacing: 10px;
                alignment: stretch;

                // Fixed width, with the number by default and the checkbox swapping in
                // on hover or selection.
                Rectangle {
                    width: 28px;
                    if !root.show-checkbox: Text {
                        text: root.row-index + 1;
                        color: root.ink;
                        font-size: Theme.font-size-row;
                        horizontal-alignment: center;
                    }
                    if root.show-checkbox: Rectangle {
                        width: 16px;
                        height: 16px;
                        Checkbox {
                            checked: root.selected;
                            fade: root.fade;
                        }
                        // The box starts a selection; once one is live the row body
                        // picks too. Modifiers ride through `ev.modifiers`.
                        cb-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up
                                    && ev.button == PointerEventButton.left) {
                                    root.pick(
                                        ev.modifiers.control, ev.modifiers.shift);
                                }
                            }
                        }
                    }
                }

                // Artwork tile.
                VerticalLayout {
                    alignment: center;
                    ArtworkImage {
                        artwork-path: root.row-data.artwork_path;
                        cover: Queue.request-cover(root.row-data.artwork_path,
                                                   Queue.covers-generation);
                        tile-size: 36px;
                        tile-radius: Theme.radius-sm;
                        fade: root.fade;
                    }
                }

                // The track lists' title cell. `horizontal-stretch: 1` here is half of what lets
                // the title elide (`TrackTitle` argues the other). The right padding is breathing
                // room between the title and the duration, which otherwise butt against each
                // other across the layout's spacing.
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    padding-right: Theme.pad-md;
                    TrackTitle {
                        title: root.row-data.title;
                        ink: root.ink;
                    }
                }

                // The track-list length-cell pattern with the remove button in the heart's
                // place: the `min-width` keeps the cell wide enough that the button lands where
                // the duration's right edge was, and `alignment: end` right-aligns both states;
                // an `h:mm:ss` duration expands it naturally. Swapped rather than faded, as the
                // checkbox is: a fade leaves trails as the pointer sweeps across rows.
                Rectangle {
                    min-width: 50px;
                    clip: true;
                    HorizontalLayout {
                        alignment: end;
                        cross-axis-alignment: center;
                        if !root.hovered: Text {
                            text: root.row-data.display_duration;
                            color: Theme.text.transparentize(1.0 - root.fade);
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: right;
                        }
                        if root.hovered: IconButton {
                            diameter: 26px;
                            icon-size: 18px;
                            icon: "close";
                            hover-fg: Theme.danger;
                            fade: root.fade;
                            clicked => { Queue.remove(root.row-index); }
                        }
                    }
                }
            }
        }

        // The same menu the track lists raise, under `view-context: "queue"` — which drops Play
        // Next and Add to Queue (the queue *is* what they name) and swaps the remove entry onto
        // this list. `play-next` and `add-to-queue` are left unbound; nothing under that
        // context fires them.
        ctx-menu := TrackContextMenu {
            row-id: root.row-data.id;
            row-is-favorite: root.row-data.is_favorite;
            row-rating: root.row-data.rating;
            row-selected: root.row-data.selected;
            album-id: root.row-data.album_id;
            artist-id: root.row-data.artist_id;
            genre-id: root.row-data.genre_id;
            view-context: "queue";
            effective-selection: Queue.selected-ids;
            selection-count: Queue.selected-count;

            play-single => { Queue.skip-to(root.row-index); }
            toggle-favorite(ids, on) => { Queue.toggle-row-favorite(ids, on); }
            rate(ids, n) => { Queue.set-row-rating(ids, n); }
            select-all => { Queue.select-all(); }
            clear-selection => { Queue.clear-selection(); }
            // Index-shaped rather than by the payload's ids, which name tracks: a single remove
            // takes this row and `remove-selected` the rows Rust has picked, neither touching
            // another copy of the same track.
            request-remove(ids) => {
                if (ctx-menu.multi-active) {
                    Queue.remove-selected();
                } else {
                    Queue.remove(root.row-index);
                }
            }
        }
    }
}
