import { Theme } from "../../theme.slint";
import { Queue } from "../../globals/queue.slint";
import { QueueRow } from "../../models.slint";
import { ArtworkImage } from "../../components/artwork-image.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Checkbox } from "../../components/checkbox.slint";
import { TrackContextMenu } from "../../components/track-list/track-context-menu.slint";
import { ContextClick } from "../../components/context-menu.slint";
import { SelectionPill } from "../../components/track-list/selection-pill.slint";
import { TrackTitle } from "../../components/track-list/track-title.slint";

// Favourite and rating are the row menu's, so the title keeps the room a heart and stars would
// take. The checkbox starts a selection and the row body extends one, a body click otherwise
// being a no-op beside the double-click skip-to.
export component QueueRowItem inherits Rectangle {
    in property <QueueRow> row-data;
    in property <int> row-index;
    // The host's, so the rows and its drop target's slots agree.
    in property <length> row-height;
    in property <bool> prev-selected;
    in property <bool> next-selected;
    in property <bool> lifted;

    // A left press on the row body, which is what a drag from it would carry.
    callback pressed();

    property <bool> playing: root.row-index == Queue.current-index;
    property <bool> selected: root.row-data.selected;
    // The lifted row dims through its brushes rather than `opacity`, which would render it into a
    // texture for the length of the drag, and a drag of picks lifts a screenful.
    property <float> fade: root.lifted ? Theme.fade-lifted : 1.0;
    // `Theme.text`, as in the track lists: these rows shouldn't read dimmer than the lists beside.
    property <brush> ink: (root.playing ? Theme.accent : Theme.text).transparentize(1.0 - root.fade);
    // What every hover-driven binding reads, so the row stays lit under its own menu.
    property <bool> hovered: touch.has-hover || ctx-menu.is-open;
    // An open menu takes the panel's hover, so the winit filter reads the press on an entry as a
    // press elsewhere and drops the queue's keys. The menu hands them back as it closes.
    property <bool> menu-open: ctx-menu.is-open;
    changed menu-open => {
        if (!self.menu-open) {
            Queue.keys-owned = true;
        }
    }
    property <bool> show-checkbox: root.hovered || root.selected;
    property <bool> selecting: Queue.selected-count > 0;
    // The ✕ removes this row alone, so it hides while two or more rows are picked: beside them it
    // reads as acting on the set, which the menu and Delete are for.
    property <bool> shows-remove: root.hovered && Queue.selected-count < 2;
    // Modifiers as they stood on the press the pick is about to complete; see `touch.clicked`.
    property <bool> press-ctrl;
    property <bool> press-shift;

    // The checkbox and the row body both pick through here. Ctrl is forced on whenever shift
    // isn't held, so a pick on a selected row always removes it.
    function pick(ctrl: bool, shift: bool) {
        Queue.toggle-select(root.row-index, ctrl || !shift, shift);
    }

    height: root.row-height;

    // The whole-row `TouchArea` wraps the cells, as in `track-list-row.slint`, so the checkbox and
    // the remove button are its descendants and take their clicks first; as siblings, the row
    // would swallow every click.
    chrome := Rectangle {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;

        if root.selected || root.hovered: SelectionPill {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            selected: root.selected;
            hovered: root.hovered;
            fade: root.fade;
            prev-selected: root.prev-selected;
            next-selected: root.next-selected;
        }

        touch := TouchArea {
            // On `clicked`, which the hover-mounted checkbox's release, handed on as it unmounts,
            // never fires. A drag sends this area a cancel, so neither fires after one.
            clicked => {
                if (root.selecting) {
                    root.pick(root.press-ctrl, root.press-shift);
                }
            }
            double-clicked => { Queue.skip-to(root.row-index); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    // `clicked` carries no modifiers, so they are taken off the press.
                    root.press-ctrl = ev.modifiers.control;
                    root.press-shift = ev.modifiers.shift;
                    root.pressed();
                }
                if (ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                    ctx-menu.show-at(self.mouse-x, self.mouse-y);
                }
            }

            // Kept off the cross-axis solve, so the artwork keeps its own centring layout: under
            // it the duration cell would be held to the remove button's 26 px while it shows.
            HorizontalLayout {
                padding-left: Theme.pad-md;
                padding-right: Theme.pad-md;
                spacing: 10px;
                alignment: stretch;

                Rectangle {
                    width: 28px;
                    if !root.show-checkbox: Text {
                        text: root.row-index + 1;
                        color: root.ink;
                        font-size: Theme.font-size-row;
                        horizontal-alignment: center;
                    }
                    if root.show-checkbox: Rectangle {
                        width: 16px;
                        height: 16px;
                        Checkbox {
                            checked: root.selected;
                            fade: root.fade;
                        }
                        cb-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up
                                    && ev.button == PointerEventButton.left) {
                                    root.pick(
                                        ev.modifiers.control, ev.modifiers.shift);
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ArtworkImage {
                        artwork-path: root.row-data.artwork_path;
                        cover: Queue.request-cover(root.row-data.artwork_path,
                                                   Queue.covers-generation);
                        tile-size: 36px;
                        tile-radius: Theme.radius-sm;
                        fade: root.fade;
                    }
                }

                // `horizontal-stretch: 1` is half of what lets the title elide (`TrackTitle` argues
                // the other); the padding keeps it off the duration.
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    padding-right: Theme.pad-md;
                    TrackTitle {
                        title: root.row-data.title;
                        ink: root.ink;
                    }
                }

                // The track list's length cell with the remove button in the heart's place, the
                // `min-width` landing it on the duration's right edge. Swapped rather than faded,
                // a fade leaving trails as the pointer sweeps across rows.
                Rectangle {
                    min-width: 50px;
                    clip: true;
                    HorizontalLayout {
                        alignment: end;
                        cross-axis-alignment: center;
                        if !root.shows-remove: Text {
                            text: root.row-data.display_duration;
                            color: Theme.text.transparentize(1.0 - root.fade);
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: right;
                        }
                        if root.shows-remove: IconButton {
                            diameter: 26px;
                            icon-size: 18px;
                            icon: "close";
                            hover-fg: Theme.danger;
                            fade: root.fade;
                            clicked => { Queue.remove(root.row-index); }
                        }
                    }
                }
            }
        }

        // `"queue"` drops Play Next and Add to Queue, so neither callback is bound.
        ctx-menu := TrackContextMenu {
            row-id: root.row-data.id;
            row-is-favorite: root.row-data.is_favorite;
            row-rating: root.row-data.rating;
            row-selected: root.row-data.selected;
            album-id: root.row-data.album_id;
            artist-id: root.row-data.artist_id;
            genre-id: root.row-data.genre_id;
            view-context: "queue";
            effective-selection: Queue.selected-ids;
            selection-count: Queue.selected-count;

            play-single => { Queue.skip-to(root.row-index); }
            add-favorites(ids) => { Queue.toggle-row-favorite(ids, true); }
            rate(ids, n) => { Queue.set-row-rating(ids, n); }
            select-all => { Queue.select-all(); }
            clear-selection => { Queue.clear-selection(); }
            // By row rather than by the payload's ids, which name tracks, so no other copy of the
            // same track goes with it.
            request-remove(ids) => {
                if (ctx-menu.multi-active) {
                    Queue.remove-selected();
                } else {
                    Queue.remove(root.row-index);
                }
            }
        }
    }
}
