import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { Queue } from "../../globals/queue.slint";
import { ListTravel } from "../../globals/list-travel.slint";
import { MaterialIcon } from "../../components/material-icon.slint";
import { IconButton } from "../../components/icon-button.slint";
import { ActionPill, PillButton } from "../../components/action-pill.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { EdgeResizeHandle, GrowEdge } from "../../components/edge-resize-handle.slint";
import { QueueRowItem } from "queue-row.slint";

// The queue, docked after the content panel in the shell's row, so the sidebar, the content and
// the bar all stay live beside it. It draws no fill: the shell's mantle shows through, which is the
// ground `RoundedFrame` masks the content panel's corners in.
export component QueuePanel inherits Rectangle {
    // The panel sits in the full-UI branch, which the miniplayer swap unmounts, so a remount finds
    // `Queue.shown` already settled and the reset in `changed watched-shown` never fires.
    init => {
        Queue.pointer-in = false;
        Queue.drag-source = -1;
        Queue.drop-slot = -1;
        root.arm-seat();
    }

    // The width shown, which a narrow window holds below the one chosen. The host's to work out,
    // being the only one that sees the row the panel shares.
    in property <length> open-w;
    // What the row leaves the panel beside the sidebar as it is drawn, the furthest its edge drags.
    in property <length> room;
    // The ease rides a float rather than the width, so dragging the edge moves `open-w` straight
    // through instead of restarting an animation on every move.
    private property <float> shown-t: Queue.shown ? 1.0 : 0.0;
    animate shown-t { duration: Theme.dur-med; easing: ease-in-out; }

    // Never a bound `width`: a component root reports that as its min and max, and an eased one
    // drags the window's own floor along with it (`slint-pitfalls.md`).
    min-width: 0px;
    preferred-width: root.open-w * root.shown-t;
    max-width: root.open-w;
    horizontal-stretch: 0;
    // The content is laid out at `open-w` and the box eases under it, so it rides the moving edge
    // rather than reflowing every frame. Square, so a scissor rather than a layer.
    clip: true;

    private property <bool> watched-shown: Queue.shown;
    changed watched-shown => {
        // Neither a showing nor a hidden panel can have a drag in flight. Worth spelling out on
        // hide: the panel stays mounted, so the pressed row outlives it until the teardown drops
        // the rows a beat later, and a destroyed row never delivers the pointer-up that would have
        // cleared these itself.
        Queue.drag-source = -1;
        Queue.drop-slot = -1;
        // `AppWindow` writes `Queue.shown` before it fires `shown-changed`, so this runs after Rust
        // has filled the rows and the playing index, and the arm below reads the fresh index.
        root.arm-seat();
    }

    private property <bool> has-rows: Queue.rows.length > 0;

    // Owned here and handed to every row. The drop indicator and the rows' slot math
    // both derive from it, so **one value is what keeps the painted line and the
    // committed insert on the same row**.
    private property <length> row-height: 50px;
    // Where the dragged row's top sits inside the visible list — meaningful only
    // mid-drag, and read by the auto-scroll gate below.
    private property <length> drag-src-screen-y:
        Queue.drag-source * root.row-height + inner-list.content-y;

    // In the list body's own coordinates: centred on the slot boundary, then **pinned
    // inside the band**. The after-the-last-row slot sits exactly on the content's
    // bottom edge, which the body's `clip` cuts away once the queue is scrolled to the
    // end, so an unpinned line for that slot is never drawn at all; the top end is
    // pinned for the mirror case, and both ends catch a pointer dragged clean out of the
    // list. `draggable-track-list.slint` has the same shape — keep the two in step.
    private property <length> drop-line-h: 2px;
    private property <length> drop-line-y: max(
        0px,
        min(
            inner-list.visible-height - root.drop-line-h,
            Queue.drop-slot * root.row-height + inner-list.content-y
                - root.drop-line-h / 2,
        ),
    );

    pure function in-travel(y: length) -> length {
        return ListTravel.pin(y, inner-list.visible-height, inner-list.content-height);
    }

    // Where the viewport sits with `index` centred, pinned inside the travel. Every row is
    // the same height, so a row's top is its index times that and the panel needs no offset
    // table.
    pure function centred-on(index: int) -> length {
        return root.in-travel(
            inner-list.visible-height / 2 - index * root.row-height - root.row-height / 2);
    }

    // How long the seat keeps trying before it gives up, so a list that never finishes
    // measuring cannot leave the timer running for the rest of the session. In ticks rather
    // than a duration, so it follows whatever cadence the timer below is set to.
    private property <int> seat-ticks-total: 40;
    private property <int> seat-ticks-left;

    // Arms the seat: the show transition, and a remount that finds the panel already shown.
    // Reading `Queue.shown` is what makes a hide disarm it. **Assigned rather than bound**,
    // because `self.running = false` in the handler would orphan a binding on the first fire,
    // leaving the panel seating once per process; and a binding reaching the list's height
    // fails earlier still, evaluated by a change tracker in the pass that mounts the branch,
    // the panel sitting inside the miniplayer `if`.
    //
    // **Arms rather than seats.** A scroll written from `changed watched-shown` lands inside
    // `run_change_handlers`, which drains the flickable's in-bounds tracker re-entrantly, and
    // that tracker evaluates against the `content-height` the hide's teardown left at zero and
    // pins the offset straight back to the top.
    function arm-seat() {
        root.seat-ticks-left = root.seat-ticks-total;
        seat-timer.running = Queue.shown && Queue.current-index >= 0;
    }

    // Seats the list on the playing row once per show and then leaves it alone — a queue is
    // read *past* the current track, so a panel that kept following would fight every
    // scroll. **It converges rather than writing once.** A `ListView` publishes
    // `visible-height` off its own geometry and `content-height` off its repeater, and on a
    // fresh mount the two land on different passes, so a single write committed to whichever
    // pair its one tick happened to find: the show after a miniplayer swap centred against a
    // height of zero and put the playing row at the top, where the second show, laid out
    // already, was reliably right. Converging also picks up the ListView's own re-anchoring,
    // which row-aligns the offset and drops the centring remainder. Re-reading the target
    // each tick costs one tick where it already agreed.
    seat-timer := Timer {
        // Roughly a frame: the list republishes its heights once per layout pass, so a faster
        // cadence only re-reads the answer it already has.
        interval: 16ms;
        running: false;
        triggered => {
            root.seat-ticks-left -= 1;
            if (root.seat-ticks-left <= 0) {
                self.running = false;
                return;
            }
            // Two ways to be unmeasured and neither is safe to centre against: no geometry at
            // all, and a content height short of its own rows, where `in-travel` collapses to
            // the top against a height about to grow. The second reads `QueueRowItem`'s height,
            // which is the `row-height` handed to it.
            if (inner-list.visible-height <= 0px
                || inner-list.content-height < Queue.rows.length * root.row-height) {
                return;
            }
            if (abs(inner-list.content-y - root.centred-on(Queue.current-index)) <= 1px) {
                self.running = false;
                return;
            }
            inner-list.content-y = root.centred-on(Queue.current-index);
        }
    }

    // The `CompositeScroll.hovered` shape: everything passes through to the children, and only
    // `has-hover` is read, into what the winit filter consults to decide whether a press makes
    // Escape and Ctrl+A the queue's. The edge handle sits inside it so a press there counts.
    hover-catch := TouchArea {
        x: 0;
        y: 0;
        width: root.open-w;
        height: 100%;
        changed has-hover => { Queue.pointer-in = self.has-hover; }

        VerticalLayout {
            spacing: 0px;

            // Title, count, Clear, and close.
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 8px;
                    spacing: 12px;
                    alignment: stretch;
                    cross-axis-alignment: center;

                    // A title over a count, the shape the My Library band states in its
                    // idle row — restacked, and keeping its own font sizes: the band's
                    // are tuned for a full page, where this sits in a single short row.
                    VerticalLayout {
                        spacing: 0;
                        Text {
                            text: @tr("Queue");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                        Text {
                            // Its own msgid: some locales build "no items" differently
                            // from the counted form.
                            text: Queue.rows.length == 0
                                ? @tr("No tracks")
                                : @tr(
                                    "{n} track" | "{n} tracks" % Queue.rows.length
                                );
                            color: Theme.subtext0;
                            font-size: Theme.font-size-row;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }

                    // `if` rather than `visible:` so the absent branch leaves no phantom
                    // layout slot.
                    if root.has-rows: ActionPill {
                        PillButton {
                            text: @tr("Clear queue");
                            clicked => {
                                Dialog.title = @tr("Clear queue?");
                                Dialog.message = @tr("Remove all tracks from the queue? Playback will stop.");
                                Dialog.confirm-label = @tr("Clear");
                                Dialog.cancel-label = @tr("Cancel");
                                Dialog.destructive = true;
                                Dialog.kind = DialogKind.clear-queue;
                                Dialog.target-id = -1;
                                Dialog.open = true;
                            }
                        }
                    }
                    IconButton {
                        icon: "close";
                        diameter: 32px;
                        icon-size: 18px;
                        clicked => { Queue.close(); }
                    }
                }
            }

            // Header separator.
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // List body.
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                inner-list := ListView {
                    // The `OverlayScrollbar` below is the only scrollbar.
                    vertical-scrollbar-policy: always-off;
                    horizontal-scrollbar-policy: always-off;
                    x: 0;
                    y: 0;
                    // Reserves the rail for the overlay scrollbar — the bar itself, the
                    // panel inset, and a visible gap to the row content. Without it the
                    // row hover pill paints under the scrollbar with no breathing room.
                    width: parent.width - 14px;
                    height: 100%;
                    // Every row here is draggable, so the pan never gets the gesture:
                    // it intercepts the row's grab mid-drag and the drop never commits.
                    // Stated rather than inherited, the default being the style's to
                    // pick; mechanism in `draggable-track-list.slint`.
                    mouse-drag-pan-enabled: false;
                    for row[idx] in Queue.rows: QueueRowItem {
                        row-data: row;
                        row-index: idx;
                        list-y0: inner-list.absolute-position.y;
                        list-height: inner-list.height;
                        list-viewport-y: inner-list.content-y;
                        row-height: root.row-height;
                        // Drives the per-corner radius gating, so contiguous selected
                        // rows merge into one pill.
                        prev-selected: idx > 0 && Queue.rows[idx - 1].selected;
                        next-selected: idx < Queue.rows.length - 1 && Queue.rows[idx + 1].selected;
                        request-scroll-by(dy) => {
                            // **Skipped when the nudge would carry the dragged row out
                            // of the visible range.** A `ListView` destroys the rows
                            // that leave it, and a destroyed row never delivers its
                            // pointer-up, so the drag would neither commit nor clean up
                            // — auto-scroll stops once the source reaches the far edge.
                            if (Queue.drag-source >= 0
                                && (root.drag-src-screen-y - dy) > -root.row-height
                                && (root.drag-src-screen-y - dy) < inner-list.visible-height) {
                                inner-list.content-y =
                                    root.in-travel(inner-list.content-y - dy);
                            }
                        }
                    }
                }

                // Painted in the gap *between* rows rather than at a row's top edge, so
                // the drop target reads clearly against the still-painted source ghost.
                // Hidden when the slot is a no-op — either side of the source both mean
                // "stays put" after the slot → index adjustment, so a line there would
                // mislead.
                if Queue.drag-source >= 0
                    && Queue.drop-slot >= 0
                    && Queue.drop-slot != Queue.drag-source
                    && Queue.drop-slot != Queue.drag-source + 1: Rectangle {
                    x: 0;
                    y: root.drop-line-y;
                    width: inner-list.width;
                    height: root.drop-line-h;
                    background: Theme.accent;
                }

                // A sibling, flush with the panel's edge.
                OverlayScrollbar {
                    x: parent.width - self.width - 2px;
                    y: 0;
                    width: Theme.scrollbar-slot;
                    height: parent.height;
                    visible-size: inner-list.visible-height;
                    content-size: inner-list.content-height;
                    offset: -inner-list.content-y;
                    scroll-to(o) => { inner-list.content-y = -o; }
                }

                // Empty state.
                if Queue.rows.length == 0: VerticalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: Theme.pad-sm;
                    MaterialIcon {
                        name: "queue_music";
                        icon-size: 40px;
                        icon-color: Theme.surface2;
                    }
                    Text {
                        text: @tr("Queue is empty");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // After the list, so it paints over it, and `if` rather than `visible:` so the absent
        // branch claims no layout slot. **A plain Rectangle with no TouchArea**, so the OS drop
        // event still lands at the winit layer below Slint.
        if Queue.is-drop-hovered && Queue.shown: Rectangle {
            x: 0;
            y: 57px; // 56 px header + 1 px separator
            width: 100%;
            height: parent.height - 57px;
            background: Theme.crust.with-alpha(0.85);

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: Theme.pad-md;
                MaterialIcon {
                    name: "library_add";
                    icon-size: 40px;
                    icon-color: Theme.accent;
                }
                Text {
                    text: @tr("Drop to add to queue");
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }

        // Last, over the rows it borders.
        EdgeResizeHandle {
            x: 0;
            y: 0;
            height: parent.height;
            grows: GrowEdge.left;
            // Not `open-w`: the ease, or a row still giving way, can draw the box narrower.
            drawn-width: root.width;
            min-w: Theme.queue-panel-min-w;
            // Capped at the room, so a drag can't store a width the window won't draw or fold the
            // sidebar to make it.
            max-w: clamp(root.room, Theme.queue-panel-min-w, Theme.queue-panel-max-w);
            resized(width) => {
                Queue.panel-width = width;
            }
            reset => {
                Queue.panel-width = 0px;
            }
        }
    }
}
