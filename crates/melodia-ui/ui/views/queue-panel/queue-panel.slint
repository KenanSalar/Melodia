import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Dialog, DialogKind } from "../../globals/dialog.slint";
import { Queue } from "../../globals/queue.slint";
import { ListTravel } from "../../globals/list-travel.slint";
import { WindowChrome } from "../../globals/shell.slint";
import { MaterialIcon } from "../../components/material-icon.slint";
import { IconButton } from "../../components/icon-button.slint";
import { ActionPill, PillButton } from "../../components/action-pill.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { EdgeResizeHandle, GrowEdge } from "../../components/edge-resize-handle.slint";
import { DragSource } from "../../components/drag-source.slint";
import { ListDropTarget } from "../../components/list-drop-target.slint";
import { Drag, DragItems, DragOrigin, FileDrag, FileDropTarget } from "../../globals/drag.slint";
import { WindowRectReport } from "../../components/window-rect-report.slint";
import { FileDropBanner } from "../../components/file-drop-banner.slint";
import { QueueRowItem } from "queue-row.slint";

// The queue, docked after the content panel in the shell's row, so the sidebar, the content and
// the bar all stay live beside it. Docked it draws no fill: the shell's mantle shows through, which
// is the ground `RoundedFrame` masks the content panel's corners in.
//
// **A window with no room to dock floats it over the content panel instead**, and it stays this
// one element: a second would share the rows' fetch anchor, the drag state and `pointer-in`, and
// couldn't sit behind an `if`, its tracker on `Queue.shown` outliving the branch. Floating, the
// root takes no width in the row and draws its body to its own left.
export component QueuePanel inherits Rectangle {
    // The panel sits in the full-UI branch, which the miniplayer swap unmounts, so a remount finds
    // `Queue.shown` already settled and the reset in `changed watched-shown` never fires.
    init => {
        Queue.pointer-in = false;
        root.arm-seat();
    }

    // The width shown, which a narrow window holds below the one chosen. The host's to work out,
    // being the only one that sees the row the panel shares.
    in property <length> open-w;
    // What the row leaves the panel beside the sidebar as it is drawn, the furthest its edge drags.
    in property <length> room;
    // The width it floats at. The host's too, for the same reason as `open-w`.
    in property <length> float-w;
    // How far a floating panel keeps from the content panel's top, right and bottom edges, so it
    // never covers the corners `RoundedFrame` rounds. Published for the host's `float-w`.
    out property <length> float-inset: Theme.pad-sm;

    // The eases ride floats rather than the width, so dragging the edge moves `open-w` straight
    // through instead of restarting an animation on every move.
    private property <float> docked-t: Queue.shown && !Queue.floating ? 1.0 : 0.0;
    animate docked-t { duration: Theme.dur-med; easing: ease-in-out; }
    private property <float> float-t: Queue.floating ? 1.0 : 0.0;
    animate float-t { duration: Theme.dur-med; easing: ease-in-out; }
    // Still floating while it slides back out.
    private property <bool> floating-drawn: Queue.floating || root.float-t > 0;

    // Where the body is drawn, in the root's frame. Floating, it slides in from beyond the content
    // panel's right edge, which is the root's left.
    private property <length> body-x: root.floating-drawn
        ? -(root.float-w + root.float-inset) * root.float-t
        : 0px;
    private property <length> body-y: root.floating-drawn ? root.float-inset : 0px;
    private property <length> body-w: root.floating-drawn ? root.float-w : root.open-w;
    private property <length> body-h: root.floating-drawn
        ? root.height - 2 * root.float-inset
        : root.height;
    // The list stops a corner's radius above a floating body's bottom, so its square clip never
    // cuts into the rounding and no rounded clip has to hold the list as a texture.
    private property <length> body-pad-bottom: root.floating-drawn ? Theme.radius-lg : 0px;

    // Never a bound `width`: a component root reports that as its min and max, and an eased one
    // drags the window's own floor along with it (`slint-pitfalls.md`).
    min-width: 0px;
    preferred-width: root.open-w * root.docked-t;
    max-width: root.open-w;
    horizontal-stretch: 0;
    // The content is laid out at `open-w` and the box eases under it, so it rides the moving edge
    // rather than reflowing every frame. Square, so a scissor rather than a layer. Off while
    // floating: a clipping item takes every press outside its own box, and the body is all
    // outside it then.
    clip: !root.floating-drawn;

    private property <bool> watched-shown: Queue.shown;
    changed watched-shown => {
        // `AppWindow` writes `Queue.shown` before it fires `shown-changed`, so this runs after Rust
        // has filled the rows and the playing index, and the arm below reads the fresh index.
        root.arm-seat();
    }

    private property <bool> has-rows: Queue.rows.length > 0;

    // What letting go of another list's drag would do. Tracks are counted; a card is named, and
    // several are counted by what they are, the tracks behind them being unknown until the drop.
    private property <DragItems> dragged: Drag.payload.items;
    private property <int> dragged-count: root.dragged.ids.length;
    private property <string> drop-label: root.dragged.kind == "track"
        // Translators: `{n}` is how many tracks are being dragged into the queue
        ? @tr("Add {n} track to the queue" | "Add {n} tracks to the queue" % root.dragged-count)
        : root.dragged-count == 1
        // Translators: `{}` names the dragged album, artist, genre or playlist
        ? @tr("Add \"{}\" to the queue", root.dragged.title)
        : root.dragged.kind == "album"
        ? @tr("Add {n} album to the queue" | "Add {n} albums to the queue" % root.dragged-count)
        : root.dragged.kind == "artist"
        ? @tr("Add {n} artist to the queue" | "Add {n} artists to the queue"
            % root.dragged-count)
        : root.dragged.kind == "genre"
        ? @tr("Add {n} genre to the queue" | "Add {n} genres to the queue" % root.dragged-count)
        : @tr("Add {n} playlist to the queue" | "Add {n} playlists to the queue"
            % root.dragged-count);

    // Handed to every row and to the drop target, so the line it paints and the slot it commits
    // are the same one.
    private property <length> row-height: 50px;

    pure function in-travel(y: length) -> length {
        return ListTravel.pin(y, inner-list.visible-height, inner-list.content-height);
    }

    // Where the viewport sits with `index` centred, pinned inside the travel. Every row is
    // the same height, so a row's top is its index times that and the panel needs no offset
    // table.
    pure function centred-on(index: int) -> length {
        return root.in-travel(
            inner-list.visible-height / 2 - index * root.row-height - root.row-height / 2);
    }

    // How long the seat keeps trying before it gives up, so a list that never finishes
    // measuring cannot leave the timer running for the rest of the session. In ticks rather
    // than a duration, so it follows whatever cadence the timer below is set to.
    private property <int> seat-ticks-total: 40;
    private property <int> seat-ticks-left;

    // Arms the seat: the show transition, and a remount that finds the panel already shown.
    // Reading `Queue.shown` is what makes a hide disarm it. **Assigned rather than bound**,
    // because `self.running = false` in the handler would orphan a binding on the first fire,
    // leaving the panel seating once per process; and a binding reaching the list's height
    // fails earlier still, evaluated by a change tracker in the pass that mounts the branch,
    // the panel sitting inside the miniplayer `if`.
    //
    // **Arms rather than seats.** A scroll written from `changed watched-shown` lands inside
    // `run_change_handlers`, which drains the flickable's in-bounds tracker re-entrantly, and
    // that tracker evaluates against the `content-height` the hide's teardown left at zero and
    // pins the offset straight back to the top.
    function arm-seat() {
        root.seat-ticks-left = root.seat-ticks-total;
        seat-timer.running = Queue.shown && Queue.current-index >= 0;
    }

    // Seats the list on the playing row once per show and then leaves it alone — a queue is
    // read *past* the current track, so a panel that kept following would fight every
    // scroll. **It converges rather than writing once.** A `ListView` publishes
    // `visible-height` off its own geometry and `content-height` off its repeater, and on a
    // fresh mount the two land on different passes, so a single write committed to whichever
    // pair its one tick happened to find: the show after a miniplayer swap centred against a
    // height of zero and put the playing row at the top, where the second show, laid out
    // already, was reliably right. Converging also picks up the ListView's own re-anchoring,
    // which row-aligns the offset and drops the centring remainder. Re-reading the target
    // each tick costs one tick where it already agreed.
    seat-timer := Timer {
        // Roughly a frame: the list republishes its heights once per layout pass, so a faster
        // cadence only re-reads the answer it already has.
        interval: 16ms;
        running: false;
        triggered => {
            root.seat-ticks-left -= 1;
            if (root.seat-ticks-left <= 0) {
                self.running = false;
                return;
            }
            // Two ways to be unmeasured and neither is safe to centre against: no geometry at
            // all, and a content height short of its own rows, where `in-travel` collapses to
            // the top against a height about to grow. The second reads `QueueRowItem`'s height,
            // which is the `row-height` handed to it.
            if (inner-list.visible-height <= 0px
                || inner-list.content-height < Queue.rows.length * root.row-height) {
                return;
            }
            if (abs(inner-list.content-y - root.centred-on(Queue.current-index)) <= 1px) {
                self.running = false;
                return;
            }
            inner-list.content-y = root.centred-on(Queue.current-index);
        }
    }

    // A floating surface over the page: the docked look's mantle, rimmed so it lifts off the
    // content, with fill and border on one element so the renderer tucks one under the other.
    if root.floating-drawn: Rectangle {
        x: root.body-x;
        y: root.body-y;
        width: root.body-w;
        height: root.body-h;
        background: WindowChrome.mantle;
        border-width: 1px;
        border-color: Theme.surface2;
        border-radius: Theme.radius-lg;
    }

    // The `CompositeScroll.hovered` shape: everything passes through to the children, and only
    // `has-hover` is read, into what the winit filter consults to decide whether a press makes
    // Escape, Ctrl+A and Delete the queue's. The edge handle sits inside it so a press there
    // counts. Floating, it also keeps a press on the body's bare parts off the scrim beneath.
    hover-catch := TouchArea {
        x: root.body-x;
        y: root.body-y;
        width: root.body-w;
        height: root.body-h;
        changed has-hover => { Queue.pointer-in = self.has-hover; }
        // A wheel tick the list didn't take would clear the hover until the pointer moves, so a
        // click in place after it wouldn't claim the keys (`slint-pitfalls.md`, `has-hover`).
        scroll-event(ev) => { return accept; }

        // Where a file let go of lands in the queue, docked or floating.
        WindowRectReport {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            moved(rect) => { FileDrag.queue-rect = rect; }
        }

        VerticalLayout {
            spacing: 0px;
            padding-bottom: root.body-pad-bottom;

            // Title, count, Clear, and close, giving way to what letting go would do while a
            // drag from another list holds the rows: there the drop lands at the line, which a
            // banner over the rows would hide.
            Rectangle {
                height: 56px;

                // Hidden rather than `if`-mounted, so a drag passing in and out rebuilds nothing.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    visible: !drop.holds-items;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 8px;
                        spacing: 12px;
                        alignment: stretch;
                        cross-axis-alignment: center;

                        // A title over a count, the shape the My Library band states in its
                        // idle row — restacked, and keeping its own font sizes: the band's
                        // are tuned for a full page, where this sits in a single short row.
                        VerticalLayout {
                            spacing: 0;
                            Text {
                                text: @tr("Queue");
                                color: Theme.text;
                                font-size: Theme.font-size-lg;
                                font-weight: 600;
                            }
                            Text {
                                // Its own msgid: some locales build "no items" differently
                                // from the counted form.
                                text: Queue.rows.length == 0
                                    ? @tr("No tracks")
                                    : @tr(
                                        "{n} track" | "{n} tracks" % Queue.rows.length
                                    );
                                color: Theme.subtext0;
                                font-size: Theme.font-size-row;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }

                        // `if` rather than `visible:` so the absent branch leaves no phantom
                        // layout slot.
                        if root.has-rows: ActionPill {
                            PillButton {
                                text: @tr("Clear queue");
                                clicked => {
                                    Dialog.title = @tr("Clear queue?");
                                    Dialog.message = @tr("Remove all tracks from the queue? Playback will stop.");
                                    Dialog.confirm-label = @tr("Clear");
                                    Dialog.cancel-label = @tr("Cancel");
                                    Dialog.destructive = true;
                                    Dialog.kind = DialogKind.clear-queue;
                                    Dialog.target-id = -1;
                                    Dialog.open = true;
                                }
                            }
                        }
                        IconButton {
                            icon: "close";
                            diameter: 32px;
                            icon-size: 18px;
                            clicked => { Queue.close(); }
                        }
                    }
                }

                if drop.holds-items: HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: Theme.pad-sm;
                    cross-axis-alignment: center;
                    MaterialIcon {
                        name: "library_add";
                        icon-size: 22px;
                        icon-color: Theme.accent;
                    }
                    Text {
                        text: root.drop-label;
                        color: Theme.text;
                        font-size: Theme.font-size-md;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Header separator.
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // List body.
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                src := DragSource {
                    origin: DragOrigin.queue;
                    allow-move: true;
                    x: 0;
                    y: 0;
                    // Reserves the rail for the overlay scrollbar — the bar itself, the
                    // panel inset, and a visible gap to the row content. Without it the
                    // row hover pill paints under the scrollbar with no breathing room.
                    width: parent.width - 14px;
                    height: 100%;

                    inner-list := ListView {
                        // The `OverlayScrollbar` below is the only scrollbar.
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: always-off;
                        width: 100%;
                        height: 100%;
                        // A drag and a drag-pan are one gesture and only one element can own
                        // it. Stated rather than inherited, the default being the style's to
                        // pick; mechanism in `slint-pitfalls.md`.
                        mouse-drag-pan-enabled: false;
                        for row[idx] in Queue.rows: QueueRowItem {
                            row-data: row;
                            row-index: idx;
                            row-height: root.row-height;
                            // Drives the per-corner radius gating, so contiguous selected
                            // rows merge into one pill.
                            prev-selected: idx > 0 && Queue.rows[idx - 1].selected;
                            next-selected: idx < Queue.rows.length - 1 && Queue.rows[idx + 1].selected;
                            lifted: src.lifts(idx);
                            pressed => { src.arm(idx); }
                        }
                    }
                }

                drop := ListDropTarget {
                    x: src.x;
                    y: src.y;
                    width: src.width;
                    height: src.height;
                    origin: DragOrigin.queue;
                    takes-items: true;
                    row-height: root.row-height;
                    row-count: Queue.rows.length;
                    content-y: inner-list.content-y;
                    reorder(from, to) => { Queue.reorder(from, to); }
                    dropped-items(slot) => {
                        Queue.drop-in(Drag.payload.items.kind, Drag.payload.items.ids, slot);
                    }
                    scroll-by(dy) => {
                        inner-list.content-y = root.in-travel(inner-list.content-y - dy);
                    }
                }

                // A sibling, flush with the panel's edge.
                OverlayScrollbar {
                    x: parent.width - self.width - 2px;
                    y: 0;
                    width: Theme.scrollbar-slot;
                    height: parent.height;
                    visible-size: inner-list.visible-height;
                    content-size: inner-list.content-height;
                    offset: -inner-list.content-y;
                    scroll-to(o) => { inner-list.content-y = -o; }
                }

                // Empty state.
                if Queue.rows.length == 0: VerticalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: Theme.pad-sm;
                    MaterialIcon {
                        name: "queue_music";
                        icon-size: 40px;
                        icon-color: Theme.surface2;
                    }
                    Text {
                        text: @tr("Queue is empty");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // After the list, so it paints over it, and `if` rather than `visible:` so the absent
        // branch claims no layout slot.
        if FileDrag.target == FileDropTarget.queue: FileDropBanner {
            x: 0;
            y: 57px; // 56 px header + 1 px separator
            width: 100%;
            height: parent.height - 57px - root.body-pad-bottom;
            icon: "library_add";
            label: @tr("Drop to add to queue");
        }

        // Last, over the rows it borders. Docked only: a floating panel's width is the room the
        // content panel leaves it, nothing to drag.
        if !root.floating-drawn: EdgeResizeHandle {
            x: 0;
            y: 0;
            height: parent.height;
            grows: GrowEdge.left;
            // Not `open-w`: the ease, or a row still giving way, can draw the box narrower.
            drawn-width: root.width;
            min-w: Theme.queue-panel-min-w;
            // Capped at the room, so a drag can't store a width the window won't draw or fold the
            // sidebar to make it.
            max-w: clamp(root.room, Theme.queue-panel-min-w, Theme.queue-panel-max-w);
            resized(width) => {
                Queue.panel-width = width;
            }
            reset => {
                Queue.panel-width = 0px;
            }
        }
    }
}
