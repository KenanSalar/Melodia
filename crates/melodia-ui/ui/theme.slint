// Seeded with Catppuccin Mocha so the first frame paints before settings load. The 21 palette
// brushes are `in-out` for `ui::appearance::theme_paint` to swap; the rest is design system, `out`.

export global Theme {
    // Surfaces / structure
    in-out property <brush> base: #1e1e2e;
    in-out property <brush> mantle: #181825;
    // KDE's inactive titlebar off `kdeglobals` on Breeze's System variant, `base` everywhere else.
    // Read only through `WindowChrome.mantle`.
    in-out property <brush> mantle-unfocused: #1e1e2e;
    in-out property <brush> crust: #11111b;
    in-out property <brush> surface0: #313244;
    in-out property <brush> surface1: #45475a;
    in-out property <brush> surface2: #585b70;
    // A control resting on a `surface0` card, and its hover. Not `surface1`, which most palettes
    // keep all but level with the card.
    in-out property <brush> card-control: #505367;
    in-out property <brush> card-control-hover: #606379;

    // Overlays / text
    in-out property <brush> overlay0: #6c7086;
    in-out property <brush> overlay1: #7f849c;
    in-out property <brush> overlay2: #9399b2;
    in-out property <brush> text: #cdd6f4;
    in-out property <brush> subtext0: #a6adc8;
    in-out property <brush> subtext1: #bac2de;
    in-out property <brush> border: #313244;

    // A settings row's description. `subtext0` reads as a second colour beside the label, where a
    // multiplied alpha keeps the hue.
    out property <brush> text-muted: root.text.transparentize(0.2);

    // A disabled settings row's alpha, copy and control alike. Applied to `text-muted` it
    // compounds, so it goes no further than reading as unavailable.
    out property <float> dim-disabled: 0.4;

    // A disk-only Browse file, in the folder but not the database; list row and card alike.
    out property <float> fade-disk-only: 0.45;

    // A row being dragged: dim enough not to read as live, kept as the silhouette of what was
    // picked up.
    out property <float> fade-lifted: 0.4;

    // A lit control at rest, leaving full weight for the hover. Shared because the Now-Playing
    // stars and the glyphs beside them sit in one row, where two hover answers read as a fault.
    out property <float> lit-rest: 0.9;

    // Accent (default mauve) + colour on accent
    in-out property <brush> accent: #cba6f7;
    in-out property <brush> accent-text: #1e1e2e;

    // sRGB luma over gamma-encoded channels, not the relative luminance `ui/backdrop.rs` solves
    // scrims against. A hand-copy of `themes::on_accent_hex`, pinned by `themes::tests`. The only
    // polarity signal Slint gets: `Palette` carries no light/dark flag and the generated palettes
    // no variant id, so polarity is measured, never matched.
    public pure function is-light(fill: brush) -> bool {
        return (0.2126 * fill.red + 0.7152 * fill.green + 0.0722 * fill.blue) / 255 > 0.5;
    }

    // Ink for anything painted on `fill` that isn't the accent, `accent-text` answering only for
    // the accent. Literals: absolute ink for a fill of known lightness.
    public pure function ink-on(fill: brush) -> brush {
        return root.is-light(fill) ? #1e1e2e : #ffffff;
    }

    // No fallback: `themes/palette.rs` says why every theme defines all three.
    in-out property <brush> red: #f38ba8;
    in-out property <brush> green: #a6e3a1;
    in-out property <brush> yellow: #f9e2af;

    // No hover token: the destructive `SectionButton` brightens its own fill.
    out property <brush> danger: root.red;
    out property <brush> danger-text: root.ink-on(root.danger);

    // Nearly opaque, or artwork reads through and the control looks like a watermark. What
    // translucency is left keeps `IconButton`'s hover swap to solid `surface0` legible.
    out property <brush> floating-chrome-bg: root.surface0.with-alpha(0.75);

    // `OverlayScrollbar`'s default track composites to exactly `surface0` over a dialog; `crust`
    // is a recess under every palette.
    out property <brush> scrollbar-track-on-card: root.crust;

    // The titlebar mark sits on `mantle`, where the asset's Mocha pastels wash out on a light
    // palette. Latte's own pair rather than `darker()`, which divides HSV value alone and greys a
    // pastel.
    out property <brush> brand-mark: root.is-light(root.mantle)
        ? @linear-gradient(135deg, #1e66f5 0%, #179299 100%)
        : @linear-gradient(135deg, #89b4fa 0%, #94e2d5 100%);

    // Layout
    out property <length> sidebar-collapsed-w: 46px;
    out property <length> sidebar-default-w: 180px;
    out property <length> sidebar-min-w: 105px;
    out property <length> sidebar-max-w: 400px;
    // Seats a queue row's fixed cells with room left for its title.
    out property <length> queue-panel-min-w: 300px;
    out property <length> queue-panel-default-w: 360px;
    out property <length> queue-panel-max-w: 560px;
    // Two grid columns and the page's insets: what a narrow window keeps for the content before
    // the sidebar and the queue panel give way.
    out property <length> content-min-w: 452px;
    out property <length> now-playing-h: 72px;
    out property <length> row-h: 46px;
    // With the thumbnail hidden, sized to clear the hover swap-in.
    out property <length> row-h-compact: 34px;
    out property <length> row-gap: 0px;
    public pure function track-row-h(show-artwork: bool) -> length {
        return show-artwork ? root.row-h : root.row-h-compact;
    }
    // Slot math that leaves the gap out drifts further with every row.
    public pure function track-row-pitch(show-artwork: bool) -> length {
        return root.track-row-h(show-artwork) + root.row-gap;
    }
    out property <length> track-header-h: 36px;
    // Off the content panel's left edge, before the column solver's own `pad-sm`. The right edge
    // stops at `scrollbar-slot`.
    out property <length> track-list-inset: 7px;

    // Radii / spacing
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    // The custom-frame window outline, apart from `radius-md` so component radii hold when it
    // moves.
    in-out property <length> shell-radius: 6px;
    // The host's corner radius, which native mode follows whatever the user picked for custom
    // mode. Read through `window-radius`.
    in-out property <length> native-content-radius: 6px;

    // The floor of `AppWindow`'s `resize-band`. `ResizeRing` reads the band, never this.
    out property <length> resize-border: 4px;

    // Breeze keeps its caption buttons 4 px in, and a KDE cell carries 2 px of that.
    out property <length> kde-caption-edge-pad: 2px;

    // The `OverlayScrollbar` element's slot, not the 8 px it paints inside it. A track list's
    // right edge stops here so a row's pill never runs under the track.
    out property <length> scrollbar-slot: 10px;

    // Between a menu or flyout and the control that opened it. One value because a gap a pixel
    // off between two popups reads as one misplaced. The two dropdown-shaped pickers
    // (`settings/dropdown.slint`, `radio/facet-chip.slint`) hang at 4px; folding them in is a
    // design call.
    out property <length> popup-gap: 8px;

    // Ink on a name-hashed tile. Theme-independent: it stays legible because
    // `ui::radio::identity` keeps the generated stops deep, so lowering those floors breaks it.
    out property <brush> tile-ink: #ffffff.transparentize(0.1);

    out property <length> pad-xs: 4px;
    out property <length> pad-sm: 8px;
    out property <length> pad-md: 12px;
    out property <length> pad-lg: 16px;

    // Every hero band's artwork tile, one number so the page doesn't shift under a nav. It sets
    // each band's height too, so shrinking it squeezes the detail heroes' wrapped chips first.
    out property <length> hero-artwork: 140px;

    // `MetaChipStrip` caps its rows in multiples of it, so a chip and a cap that disagree slice a
    // row instead of dropping it whole.
    out property <length> meta-chip-h: 26px;

    // The smart editor's value fields sit beside its pickers at this height.
    out property <length> dropdown-h: 32px;

    // Typography
    out property <length> font-size-sm: 12px;
    out property <length> font-size-row: 13px;
    out property <length> font-size-md: 14px;
    out property <length> font-size-lg: 16px;

    // What a size derived from a live dimension rounds to: FemtoVG keeps a glyph for every tenth
    // of a pixel it has drawn at, in an atlas it never evicts.
    out property <length> text-size-step: 0.5px;

    // Every view's header band; a subtitle reuses `font-size-sm` + `subtext0`.
    out property <length> page-title-size: 20px;
    out property <int> page-title-weight: 600;
    out property <brush> page-title-color: root.text;

    // A step above a page heading, sitting on a blurred band. Capped: the two heroes with a second
    // text line nest it in the title row, so raising this spends a chip row's slack.
    out property <length> hero-title-size: 22px;

    // Easing is inlined at each `animate`: Slint can't expose an `easing` across the Rust boundary,
    // and a global one warns at build time.
    out property <duration> dur-fast: 200ms;
    out property <duration> dur-med: 250ms;
    out property <duration> dur-spatial: 400ms;

    // Up while `theme_paint` eases one palette into the next, writing these brushes every frame.
    // An `animate` reading one is `enabled` only while this is down: each write restarts its curve.
    in property <bool> recoloring: false;

    // **Hydrated between `AppWindow::new()` and `app.show()`**: Slint applies `no-frame` live, so a
    // later write maps the window with the wrong frame and swaps it on screen.
    in-out property <bool> use-native-titlebar: false;

    // Under the native titlebar the host's, so the miniplayer keeps the frame's corners once it
    // drops the frame.
    out property <length> window-radius: use-native-titlebar ? native-content-radius : shell-radius;

    // 0 = Windows, 1 = macOS (traffic lights), 2 = KDE (Breeze). On `Theme` so the titlebar needn't
    // reach into `Settings`.
    in-out property <int> titlebar-button-style: 0;

    // 0 = Right, 1 = Left.
    in-out property <int> titlebar-button-side: 0;

    in-out property <bool> window-focused: true;

    // On `Theme` because both colour tiers ask, and `ui::backdrop::kind` is its only Rust reader.
    // `in` so `boot::ui_setup::chrome::apply_backdrop_style` stays the one writer: the artwork
    // tiers decide at construction whether to build a blur, so the setting is restart-gated. The
    // default matches the setting's.
    in property <bool> aurora-backdrop: true;

    // Anything ≤ 0 is "0:00", so the bar can format a mid-transition position.
    public pure function format-duration(ms: int) -> string {
        // **Byte-identical to `format_duration_ms`**: the rows show the Rust string, the bar this.
        ms <= 0
            ? "0:00"
            : Math.floor(ms / 3600000) > 0
                ? Math.floor(ms / 3600000) + ":"
                    + (Math.mod(Math.floor(ms / 60000), 60) < 10 ? "0" : "")
                    + Math.mod(Math.floor(ms / 60000), 60) + ":"
                    + (Math.mod(Math.floor(ms / 1000), 60) < 10 ? "0" : "")
                    + Math.mod(Math.floor(ms / 1000), 60)
                : Math.floor(ms / 60000) + ":"
                    + (Math.mod(Math.floor(ms / 1000), 60) < 10 ? "0" : "")
                    + Math.mod(Math.floor(ms / 1000), 60)
    }
}
