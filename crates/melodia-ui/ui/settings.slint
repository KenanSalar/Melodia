// The values the user configures. How the page configuring them is navigated and searched is
// `SettingsPage`'s.

export global Settings {
    // Seeded once from `themes::registry()`.
    in property <[string]> theme-names;
    // Seeded beside `theme-names`, so no binding here spells a registry position.
    in property <int> catppuccin-idx: -1;
    in property <int> material3-idx: -1;
    in-out property <int> theme-idx;
    out property <bool> catppuccin-selected: root.theme-idx == root.catppuccin-idx;
    out property <bool> material3-selected: root.theme-idx == root.material3-idx;

    // The chips are inline `@tr` literals in `appearance-section.slint`, so a locale switch
    // re-renders them; Rust drives only the index. Same for `color-style-idx`.
    in-out property <int> variant-idx;

    // Re-seeded on a theme or variant change, Catppuccin shading each accent per variant. 1:1 with
    // `accent-names`, the dots' tooltips.
    in property <[brush]> accent-colors;
    in property <[string]> accent-names;
    in-out property <int> accent-idx;

    // Material You's accent, a switch above the swatches rather than one of them, `accent-idx`
    // being -1 while it holds. Shown with a Color Style set, playing or not, so the choice doesn't
    // vanish with the artwork.
    in-out property <bool> accent-follows-artwork;

    // KDE Breeze's System variant over a parsed `kdeglobals`, where the OS already picked the
    // accent and the dot grid hides.
    in property <bool> kde-system-active;

    // 1:1 with `material_you::SchemeStyle::all()`, 0 being None.
    in-out property <int> color-style-idx;

    // A Color Style *and* a seed actually extracted from the artwork, which the row's description
    // reports.
    in property <bool> material-you-active;

    // Unlike `material-you-active`, holds with nothing playing, so the rows it shows don't come and
    // go between tracks.
    out property <bool> material-you-enabled: root.material3-selected && root.color-style-idx != 0;

    callback theme-changed(int);
    callback variant-changed(int);
    callback accent-changed(int);
    callback accent-follows-artwork-changed(bool);
    callback color-style-changed(int);

    // Hides the row off KDE, whose decoration fade it mirrors.
    in property <bool> match-unfocused-supported;

    in-out property <bool> match-unfocused-bg;
    callback match-unfocused-bg-changed(bool);

    // Never written from Slint: the switch is `manual` and routes through the `restart-tray`
    // dialog, the change applying next launch.
    in property <bool> tray-enabled;

    // A tray icon exists. Without one "Close to Tray" greys out, the close handlers quitting
    // regardless.
    in property <bool> tray-active;

    // Can't strand the window: with no tray icon the close handlers quit regardless.
    in-out property <bool> close-to-tray: false;
    callback close-to-tray-changed(bool);

    in-out property <bool> gapless-playback: true;
    callback gapless-playback-changed(bool);

    // 0 = None, 1 = Equalizer, mapped to a token in Rust so a malformed one can't pin an invalid
    // index.
    in-out property <int> play-button-animation-idx: 0;
    callback play-button-animation-changed(int);

    // Persist-only: `boot::tasks::maybe_resume_on_startup` reads it at the next launch.
    in-out property <bool> resume-on-startup: false;
    callback resume-on-startup-changed(bool);

    // Seconds here, the slider's unit; Rust converts to the backend's milliseconds and seeds the
    // bounds from `player::crossfade::{MIN,MAX}`. `-changed` fires live through a drag and only
    // applies, `-committed` persists on release.
    in-out property <bool> crossfade-enabled: false;
    callback crossfade-enabled-changed(bool);
    in-out property <float> crossfade-duration-secs: 2.0;
    in property <float> crossfade-min-secs;
    in property <float> crossfade-max-secs;
    callback crossfade-duration-changed(float /* seconds */);
    callback crossfade-duration-committed(float /* seconds */);
    in-out property <bool> crossfade-skip-same-album: true;
    callback crossfade-skip-same-album-changed(bool);
    in-out property <bool> crossfade-manual: false;
    callback crossfade-manual-changed(bool);
    in-out property <bool> crossfade-fade-on-pause: false;
    callback crossfade-fade-on-pause-changed(bool);

    // Acted on at the next track, which then plays without a crossfade: a fade can't cross the
    // reopen. Hidden where Rust says following the rate changes nothing.
    in-out property <bool> output-follow-rate: false;
    callback output-follow-rate-changed(bool);
    in property <bool> follow-rate-supported;

    // Linear (0) or band-limited (1), for every conversion, any speed but one included. Applied off
    // the UI thread, the engine waiting out a reopen.
    in-out property <int> output-resampler-idx: 0;
    out property <bool> resampler-linear: root.output-resampler-idx == 0;
    callback output-resampler-changed(int);

    // Shared (0) or exclusive (1), and the card a claim takes, shared output's too where
    // `shared-device-supported`. Applied off the UI thread, claiming a card blocking; hidden where
    // there is no exclusive backend.
    in property <bool> exclusive-supported;
    in property <bool> shared-device-supported;
    // The first row where the picker chooses for shared output too: no saved card. Translated here,
    // the rest of the list being device names.
    pure callback output-device-system-default() -> string;
    output-device-system-default => {
        return @tr("System Default");
    }
    in-out property <int> output-mode-idx: 0;
    out property <bool> exclusive-chosen: root.exclusive-supported && root.output-mode-idx == 1;
    // The engine's own answer: exclusive output always follows the file's rate.
    out property <bool> rate-follows: root.exclusive-chosen
        || (root.follow-rate-supported && root.output-follow-rate);
    callback output-mode-changed(int);
    // Make Bit-Perfect from shared output: a pick of exclusive, then the reset, in one task, since
    // the reset keeps the volume only where the claim carries it.
    callback output-switch-to-bit-perfect();
    in property <[string]> output-device-names;
    in-out property <int> output-device-idx: -1;
    callback output-device-changed(int);
    // Asked as the picker mounts, opens and shows, a card plugged in or pulled announcing nothing.
    // Returns the revision the answer will publish under, which the popup waits for.
    callback list-output-devices() -> int;
    in property <int> output-devices-revision;
    // Where the card lacks the file's rate: play shared (0) or resample to a rate it runs (1).
    // Reopens the claim; hidden where a card can't be asked its other rates.
    in property <bool> rate-fallback-supported;
    in-out property <int> output-rate-fallback-idx: 0;
    callback output-rate-fallback-changed(int);
    // The saved card is not among those listed.
    in property <bool> output-device-missing;
    // The exclusive writer's period, -1 where the saved one matches no chip, and polling in place
    // of the card's events where the platform tells the two apart. Either reopens the card.
    in-out property <int> output-period-idx: 2;
    callback output-period-changed(int);
    in property <bool> polling-supported;
    in-out property <bool> output-polling: false;
    callback output-polling-changed(bool);
    // The volume on the card's own control, so the samples reach it untouched. Reopens the claim:
    // moving the gain mid-stream could play a period at the wrong level.
    in property <bool> hardware-volume-supported;
    in-out property <bool> output-hardware-volume: false;
    callback output-hardware-volume-changed(bool);
    // Changes nothing about the claim, so it applies at once and reopens nothing.
    in-out property <bool> output-release-paused: false;
    callback output-release-paused-changed(bool);
    // Silence written first on a reopen at a new rate, for DACs that mute while they relock.
    // Nothing hears it until the next rate change, so the drag moves only the readout.
    in-out property <float> output-resync-ms: 200;
    in property <float> output-resync-max-ms: 1000;
    callback output-resync-committed(int /* milliseconds */);

    // Rust's alone, `ScrobbleService`'s status subscriber being the one writer. `configured` says
    // whether this build shipped Last.fm app keys.
    in property <bool> scrobble-lastfm-configured;
    in property <bool> scrobble-lastfm-connected;
    in property <string> scrobble-lastfm-username;
    in-out property <bool> scrobble-lastfm-enabled;
    callback scrobble-lastfm-enabled-changed(bool);
    callback scrobble-lastfm-disconnect();
    // Favorites mirrored to Loved Tracks, independent of scrobbling.
    in-out property <bool> scrobble-lastfm-love;
    callback scrobble-lastfm-love-changed(bool);
    in property <bool> scrobble-listenbrainz-connected;
    in property <string> scrobble-listenbrainz-username;
    in-out property <bool> scrobble-listenbrainz-enabled;
    callback scrobble-listenbrainz-enabled-changed(bool);
    callback scrobble-listenbrainz-disconnect();
    // Favorites mirrored to recording feedback.
    in-out property <bool> scrobble-listenbrainz-love;
    callback scrobble-listenbrainz-love-changed(bool);

    // Scrobbling's shape: `DiscordPresenceService`'s status subscriber is the one writer, so a
    // Discord restart flips the row live, and `set_flags` starts and stops the IPC worker.
    in property <bool> discord-rpc-connected;
    in-out property <bool> discord-rpc-enabled;
    callback discord-rpc-enabled-changed(bool);
    in-out property <bool> discord-rpc-artwork;
    callback discord-rpc-artwork-changed(bool);
    in-out property <bool> discord-rpc-hide-when-paused;
    callback discord-rpc-hide-when-paused-changed(bool);

    // The sidebar row and the nav-10 router branch read it, so the feature mounts with no restart.
    // False so a failed settings read leaves an install local-only. **The gate that matters is
    // Rust's**: `library::radio` refuses on its shadow, so off means no traffic (`radio.md`).
    in-out property <bool> radio-enabled: false;
    callback radio-enabled-changed(bool);
    // Only the click one defaults on, describing what the feature does rather than whether it
    // runs. Nothing in Slint reads these: `library::radio::directory`, the play path and
    // `tasks::scrobble` each answer off a Rust shadow.
    in-out property <bool> radio-hide-segmented: false;
    callback radio-hide-segmented-changed(bool);
    in-out property <bool> radio-send-clicks: true;
    callback radio-send-clicks-changed(bool);
    in-out property <bool> radio-scrobble: false;
    callback radio-scrobble-changed(bool);

    // The Now Playing switch's twin. False so a failed settings read doesn't hand Up Next's column
    // to a panel nobody asked for.
    in-out property <bool> lyrics-enabled: false;
    callback lyrics-enabled-changed(bool);

    // False for the radio switch's reason, and like it gates nothing in Slint: `library::lyrics`
    // refuses on the Rust shadow. The panel reads it only to tell "nothing found" from "the lookup
    // is off".
    in-out property <bool> lyrics-online-enabled: false;
    callback lyrics-online-enabled-changed(bool);

    // True: it reaches nothing and draws only under a script the reader can't sound out. **The Now
    // Playing menu writes it too**, hence one `SharedFlag` for both.
    in-out property <bool> lyrics-romanization-shown: true;
    callback lyrics-romanization-shown-changed(bool);

    // **On by default**: off, the library falls behind the disk with nothing saying why. Flips the
    // `FolderWatcher` on the runtime, not the blocking pool, its start awaiting a query first.
    in-out property <bool> watch-for-file-changes: true;
    callback watch-for-file-changes-changed(bool);

    // **On by default**: a rating only in the database is lost to a rebuild and invisible to every
    // other player. The switch is for the cost, lofty re-serializing the whole tag.
    in-out property <bool> write-ratings-to-tags: true;
    callback write-ratings-to-tags-changed(bool);

    // Mirrored into `Theme.shell-radius`. Rust snaps to the nearest chip on read, so a hand-edited
    // `settings.json` still selects one.
    in-out property <int> corner-radius: 6;
    callback corner-radius-changed(int);

    // Mirrored into `Theme.titlebar-button-style`, which spells the tokens. Inert under the native
    // titlebar.
    in-out property <int> titlebar-button-style: 0;
    callback titlebar-button-style-changed(int);

    // Independent of the style: close sits at the outer corner in all four combinations.
    in-out property <int> titlebar-button-side: 0;
    callback titlebar-button-side-changed(int);

    // `titlebar-button-style`'s tokens, mirrored into `MiniPlayer.button-style`. Live under the
    // native titlebar too, the miniplayer dropping the frame.
    in-out property <int> mini-player-button-style: 0;
    callback mini-player-button-style-changed(int);

    // The outline reads the switch directly, so Rust only persists it.
    in-out property <bool> window-border-shown: true;
    callback window-border-shown-changed(bool);

    // The OS's own colour, `window-border-color-idx` being -1 while it holds.
    in-out property <bool> window-border-system: true;
    callback window-border-system-changed(bool);
    // Under Material You, System mixes from the artwork's palette rather than the theme's own.
    in-out property <bool> window-border-material-you: true;
    callback window-border-material-you-changed(bool);
    in-out property <int> window-border-color-idx: -1;
    callback window-border-color-changed(int);

    // `SettingsData.overflow_buttons`' ids as bools, so the callback names the button that toggled
    // without diffing arrays.
    in-out property <bool> overflow-favorite;
    in-out property <bool> overflow-repeat;
    in-out property <bool> overflow-shuffle;
    in-out property <bool> overflow-pin;
    in-out property <bool> overflow-queue;
    in-out property <bool> overflow-quality;
    callback overflow-buttons-changed(string /*id*/, bool /*overflow-on*/);

    // Native names, never re-translated, 1:1 with the `SUPPORTED_LOCALES` codes beside them.
    in property <[string]> language-names;
    in property <[string]> language-codes;
    // The native names joined, for the Language card's search term.
    in property <string> language-search-terms;
    in-out property <int>  language-idx;
    callback language-changed(int);

    // `CARGO_PKG_REPOSITORY`, in the browser.
    callback open-repository();

    // Both support buttons are wired in `ui/support.rs` rather than `about.rs`, Ko-fi's being the
    // support toast's action too.
    callback open-kofi();
    callback open-github-sponsors();

    // Wired in `ui/onboarding/`, which owns the card.
    callback run-onboarding();

    // Wired in `ui/settings/diagnostics.rs`; `open-log-folder` is the crash toast's action too.
    callback open-log-folder();
    callback save-diagnostics-report();
    // Applied live, and inert under `RUST_LOG`, which wins (`platform::logging`).
    in-out property <bool> verbose-logging: false;
    callback verbose-logging-changed(bool);

    // The rest wrap `@tr` literals, Slint exposing no Rust-callable `tr`, so Rust resolves each at
    // push time in the locale running then.
    pure callback watcher-disabled-title() -> string;
    watcher-disabled-title => {
        return @tr("File watching disabled");
    }
    pure callback watcher-disabled-message() -> string;
    watcher-disabled-message => {
        return @tr("Tracks won't reflect disk changes until you re-enable it.");
    }

    // On a watcher-overflow rescan (`FileEvent::RescanNeeded`).
    pure callback library-resyncing-title() -> string;
    library-resyncing-title => {
        return @tr("Library re-syncing");
    }
    pure callback library-resyncing-message() -> string;
    library-resyncing-message => {
        return @tr("Filesystem event burst — rescanning your folders.");
    }
    pure callback artwork-restoring-title() -> string;
    artwork-restoring-title => {
        return @tr("Restoring cover art");
    }
    pure callback artwork-restoring-message() -> string;
    artwork-restoring-message => {
        return @tr("Some cover art was missing. Melodia is restoring it from your music files.");
    }

    pure callback update-available-title() -> string;
    update-available-title => {
        return @tr("Update available");
    }
    pure callback update-available-message(string /*version*/) -> string;
    update-available-message(version) => {
        return @tr("Melodia {} is ready to install.", version);
    }
    pure callback update-install-action-label() -> string;
    update-install-action-label => {
        return @tr("Install");
    }
    pure callback update-installed-title() -> string;
    update-installed-title => {
        return @tr("Update installed");
    }
    pure callback update-installed-message() -> string;
    update-installed-message => {
        return @tr("Restart Melodia to start using the new version.");
    }
    pure callback update-restart-action-label() -> string;
    update-restart-action-label => {
        return @tr("Restart");
    }
    pure callback update-failed-title() -> string;
    update-failed-title => {
        return @tr("Update failed");
    }
    // `kind` is `FailureKind::as_kind_str`'s. The raw error was logged at the send site.
    pure callback update-failed-reason(string /*kind*/) -> string;
    update-failed-reason(kind) => {
        if (kind == "network") {
            return @tr("Couldn't reach the update server. Check your internet connection.");
        }
        if (kind == "signature") {
            return @tr("Signature check failed. The downloaded update may be corrupted; please try again.");
        }
        if (kind == "parse") {
            return @tr("The update server returned an unexpected response.");
        }
        if (kind == "io") {
            return @tr("Couldn't write the downloaded update to disk.");
        }
        return @tr("Update failed. See logs for details.");
    }

    pure callback diagnostics-saved-title() -> string;
    diagnostics-saved-title => {
        return @tr("Diagnostics report saved");
    }
    pure callback diagnostics-saved-message(string /*path*/) -> string;
    diagnostics-saved-message(path) => {
        return @tr("Saved to {}", path);
    }
    pure callback diagnostics-failed-title() -> string;
    diagnostics-failed-title => {
        return @tr("Couldn't save the diagnostics report");
    }
    pure callback diagnostics-failed-message() -> string;
    diagnostics-failed-message => {
        return @tr("See the log for details.");
    }

    // Pushed once after a panic (`crash_report::take_unseen`). The action shares the Diagnostics
    // card button's msgid, going to the same place.
    pure callback crash-report-title() -> string;
    crash-report-title => {
        return @tr("Melodia crashed last time");
    }
    pure callback crash-report-message() -> string;
    crash-report-message => {
        return @tr("A crash report was written. Open the log folder to find it.");
    }
    pure callback crash-report-action-label() -> string;
    crash-report-action-label => {
        return @tr("Open Folder");
    }

    // Pushed once ever by `ui::support`, and sticky: a notice that fires once is wasted on a user
    // looking away.
    pure callback support-prompt-title() -> string;
    support-prompt-title => {
        return @tr("Enjoying Melodia?");
    }
    pure callback support-prompt-message() -> string;
    support-prompt-message => {
        return @tr("It's free and open source, built in my spare time. If it's useful to you, you can support me. You'll only see this once.");
    }
    pure callback support-prompt-action-label() -> string;
    support-prompt-action-label => {
        return @tr("Support");
    }

    pure callback audio-device-lost-title() -> string;
    audio-device-lost-title => {
        return @tr("Audio device disconnected");
    }
    pure callback audio-device-lost-message() -> string;
    audio-device-lost-message => {
        return @tr("Playback won't be audible until you reconnect it and restart Melodia.");
    }

    pure callback playlist-import-title(int /*imported*/) -> string;
    playlist-import-title(imported) => {
        return @tr("{n} playlist imported" | "{n} playlists imported" % imported);
    }
    pure callback playlist-import-message(int /*tracks*/, int /*missing*/) -> string;
    playlist-import-message(tracks, missing) => {
        // The no-missing arm shares its msgid with `add-to-playlist-message`.
        return missing > 0
            ? @tr("{n} track added · {} missing" | "{n} tracks added · {} missing" % tracks, missing)
            : @tr("{n} track added" | "{n} tracks added" % tracks);
    }
    pure callback playlist-import-failed-title() -> string;
    playlist-import-failed-title => {
        return @tr("Import failed");
    }
    pure callback playlist-import-failed-message() -> string;
    playlist-import-failed-message => {
        return @tr("Couldn't read the selected playlist file(s).");
    }

    pure callback playlist-export-title(int /*exported*/) -> string;
    playlist-export-title(exported) => {
        return @tr("{n} playlist exported" | "{n} playlists exported" % exported);
    }
    pure callback playlist-export-message(string /*path*/) -> string;
    playlist-export-message(path) => {
        return @tr("Saved to {}", path);
    }
    pure callback playlist-export-failed-title() -> string;
    playlist-export-failed-title => {
        return @tr("Export failed");
    }
    pure callback playlist-export-failed-message() -> string;
    playlist-export-failed-message => {
        return @tr("Couldn't write the playlist files.");
    }
    pure callback playlist-export-too-large-message() -> string;
    playlist-export-too-large-message => {
        return @tr("These playlists are too large for one .zip file. Export fewer at a time.");
    }

    // Not a shared "{n} items imported": a station isn't a playlist, and the skipped line has no
    // playlist twin.
    pure callback station-import-title(int /*imported*/) -> string;
    station-import-title(imported) => {
        return @tr("{n} station added" | "{n} stations added" % imported);
    }
    pure callback station-import-message(int /*skipped*/) -> string;
    station-import-message(skipped) => {
        // Empty for the ordinary import, the card dropping a blank body.
        return skipped > 0
            ? @tr("{n} was already in your list." | "{n} were already in your list." % skipped)
            : "";
    }
    pure callback station-import-failed-title() -> string;
    station-import-failed-title => {
        return @tr("Import failed");
    }
    pure callback station-import-failed-message() -> string;
    station-import-failed-message => {
        return @tr("Couldn't read any stations from the selected file(s).");
    }

    pure callback station-export-title(int /*exported*/) -> string;
    station-export-title(exported) => {
        return @tr("{n} station exported" | "{n} stations exported" % exported);
    }
    pure callback station-export-message(string /*path*/) -> string;
    station-export-message(path) => {
        return @tr("Saved to {}", path);
    }
    pure callback station-export-failed-title() -> string;
    station-export-failed-title => {
        return @tr("Export failed");
    }
    pure callback station-export-failed-message() -> string;
    station-export-failed-message => {
        return @tr("Couldn't write the station list.");
    }

    // The `utils::toast` bridge's titles, by kind; the detail rides the body untranslated.
    pure callback toast-playback-error-title() -> string;
    toast-playback-error-title => {
        return @tr("Playback error");
    }
    pure callback toast-operation-failed-title() -> string;
    toast-operation-failed-title => {
        return @tr("Something went wrong");
    }
    pure callback toast-love-sync-title() -> string;
    toast-love-sync-title => {
        return @tr("Loved tracks");
    }
    pure callback toast-lyrics-saved-title() -> string;
    toast-lyrics-saved-title => {
        return @tr("Lyrics saved");
    }
    pure callback toast-copied-title() -> string;
    toast-copied-title => {
        return @tr("Copied to clipboard");
    }
    pure callback toast-nothing-to-copy-title() -> string;
    toast-nothing-to-copy-title => {
        return @tr("Nothing to copy");
    }
    pure callback toast-radio-vote-title() -> string;
    toast-radio-vote-title => {
        return @tr("Vote not counted");
    }
    // The body is translated too, the detail being only the device's name, empty where it couldn't
    // be found. The reason is left to the Output settings, where it reads in full.
    pure callback toast-exclusive-refused-title() -> string;
    toast-exclusive-refused-title => {
        return @tr("Exclusive output unavailable");
    }
    pure callback toast-exclusive-refused-message(string /* device */) -> string;
    toast-exclusive-refused-message(device) => {
        return device == ""
            ? @tr("Exclusive output was refused, so Melodia is playing shared for now. The Output section of Settings says why.")
            : @tr("{} refused exclusive output, so Melodia is playing shared for now. The Output section of Settings says why.", device);
    }
    pure callback toast-exclusive-refused-action-label() -> string;
    toast-exclusive-refused-action-label => {
        return @tr("Details");
    }
    // A localized body: a relaunch that failed has no path or error to show, only an instruction.
    pure callback toast-restart-required-title() -> string;
    toast-restart-required-title => {
        return @tr("Restart Required");
    }
    pure callback toast-restart-required-message() -> string;
    toast-restart-required-message => {
        return @tr("Melodia couldn't relaunch itself. Close and reopen it to apply the change.");
    }

    pure callback add-to-playlist-title(int /*playlists*/) -> string;
    add-to-playlist-title(playlists) => {
        return @tr("Added to {n} playlist" | "Added to {n} playlists" % playlists);
    }
    pure callback add-to-playlist-message(int /*tracks*/) -> string;
    add-to-playlist-message(tracks) => {
        return @tr("{n} track added" | "{n} tracks added" % tracks);
    }

    // A disagreeing field's placeholder in a batch edit; the rest are the Save toast.
    pure callback tag-multiple-values() -> string;
    tag-multiple-values => {
        return @tr("‹multiple values›");
    }
    pure callback tag-edit-title(int /*updated*/) -> string;
    tag-edit-title(updated) => {
        return @tr("{n} track updated" | "{n} tracks updated" % updated);
    }
    pure callback tag-edit-message(int /*failed*/, int /*unsupported*/) -> string;
    tag-edit-message(failed, unsupported) => {
        if (failed > 0) {
            return @tr("{n} file failed" | "{n} files failed" % failed);
        }
        if (unsupported > 0) {
            return @tr("{n} file has unsupported fields" | "{n} files have unsupported fields" % unsupported);
        }
        return "";
    }
    // Reached instead of the count wherever every file fell out the same way, the usual shape (one
    // album, one format, one field), so the toast can say what to do about it.
    pure callback tag-unsupported-message(string /*fields*/, string /*format*/) -> string;
    tag-unsupported-message(fields, format) => {
        return @tr("{} can't be saved to {} files", fields, format);
    }
    // Indexed by `TagField::label_index`: `PLAIN_TAG_FIELDS`, then the ten `ROLES`. Inline so `@tr`
    // reaches it, Rust sending indices; `tags_tests.rs` pins the order, which nothing else would.
    out property <[string]> tag-field-labels: [
        @tr("Title"), @tr("Artist"), @tr("Album"), @tr("Album Artist"), @tr("Genre"),
        @tr("Year"), @tr("Track"), @tr("Track Total"), @tr("Disc"), @tr("Disc Total"),
        @tr("Original Year"), @tr("BPM"), @tr("Comment"), @tr("Subtitle"), @tr("Disc Subtitle"),
        @tr("Grouping"), @tr("Work"), @tr("Movement"), @tr("Movement Number"),
        @tr("Movement Total"), @tr("Key"), @tr("Mood"), @tr("Language"), @tr("ISRC"),
        @tr("Copyright"), @tr("Record Label"), @tr("Catalog Number"), @tr("Barcode"),
        @tr("Media"), @tr("Release Type"), @tr("Release Country"), @tr("Compilation"),
        @tr("Lyrics"), @tr("Rating"),
        @tr("Composer"), @tr("Lyricist"), @tr("Arranger"), @tr("Conductor"), @tr("Performer"),
        @tr("Remixer"), @tr("Producer"), @tr("Engineer"), @tr("Mixer"), @tr("DJ Mixer"),
    ];
    pure callback tag-edit-failed-title() -> string;
    tag-edit-failed-title => {
        return @tr("Couldn't save tags");
    }
    pure callback tag-edit-failed-message() -> string;
    tag-edit-failed-message => {
        return @tr("No tracks were updated.");
    }
}
