import { LyricRow } from "../models.slint";

export enum LyricsState {
    // Nothing local and the lookup off: the one state whose copy names a setting.
    off,
    idle,
    loading,
    ready,
    // Asked, and nobody has a sheet.
    missing,
    // The directory says the recording has no words. Never retried.
    instrumental,
    // Asking failed, which is no fact about the track: nothing is cached, and Refresh retries.
    unavailable,
}

// Rust owns everything here but `enabled`, `romanization-shown` and `online-enabled`, which Now
// Playing writes directly so each swaps on the click rather than after a round trip.
export global Lyrics {
    // **The type scale Rust builds its offset table from too**, so the two can't disagree about
    // where a line sits. **Every line height is a floor**: an elided line past its box is dropped,
    // not clipped, so each clears the tallest face a lyric reaches it with, CJK at ~1.45× its size.
    out property <length> font-size: 16px;
    out property <length> line-height: 28px;

    // A step under the words and over the gloss, the order the three are read in.
    out property <length> romanization-font-size: 14px;
    out property <length> romanization-line-height: 22px;

    out property <length> translation-font-size: 13px;
    out property <length> translation-line-height: 20px;

    // **The gaps group a line with the two under it**, so the inner ones stay well under half
    // `row-gap`. Each is the drawn gap's smaller half, every part sitting in a box sized for CJK.
    out property <length> romanization-gap: 2px;
    out property <length> translation-gap: 2px;
    out property <length> row-gap: 12px;

    // The horizontal half comes off the width Rust's wrap estimate measures. **The vertical half is
    // not decoration**: CJK sets its ink close under the line-box top and would touch the fill.
    out property <length> row-pad-x: 8px;
    out property <length> row-pad-y: 6px;

    in property <[LyricRow]> rows;
    in property <LyricsState> state: LyricsState.idle;
    in property <bool> synced;

    // **All three are Rust's**, off the offset table it can keep because it also chose each row's
    // `line_count`. `-1` is no line yet: every plain sheet, and the run-in before the first stamp.
    in property <int> active-index: -1;
    in property <length> active-offset;
    in property <length> active-height;

    // How far through the active row's gap the song is. One property rather than a per-row field,
    // which would rewrite the whole model on every tick of a solo.
    in property <float> interlude-progress;

    // Persisted by Rust, the `Visualizer.enabled` shape. **Not the gate that matters**:
    // `library::lyrics` refuses on the `SharedFlag` behind it, so off means nothing is looked up.
    in-out property <bool> enabled;
    callback set-enabled(bool);

    // **A display filter and nothing more**: Rust fills the line whatever this says. One
    // `SharedFlag` answers for its two writers, this menu and the Settings card.
    in-out property <bool> romanization-shown;
    callback set-romanization-shown(bool);

    // The Settings switch, mirrored for the row `LyricsState.off`'s sentence offers as its button.
    in-out property <bool> online-enabled;
    callback set-online-enabled(bool);

    // Forgets what the directory said about this track, for a sheet matched off tags since
    // corrected. A sidecar and a lyrics tag are the user's own files and stay.
    callback refresh();
    callback save-to-tag();

    // Rust's, off the sheet it resolved: nothing the menu reads says where a sheet came from.
    in property <bool> can-save-to-tag;

    // Off the offset table the click resolves against, so the row lit is the row a click seeks.
    in property <int> hover-index: -1;
    callback hover-at(length);

    // **A point rather than a row**: one `TouchArea` covers the sheet, and the offset table Rust
    // keeps already answers which row it landed in.
    callback seek-at(length);

    // Moves the sung line between position ticks, which arrive about once a second. Fired by the
    // panel's own `Timer`, so it dies with the panel.
    callback tick();

    // **Polled from that `Timer` rather than watched**: a `changed` on a layout property is the
    // tracker this panel must not carry. A wrong width costs wrap quality and nothing else, the
    // panel drawing whatever `line_count` Rust chose.
    callback report-width(length);
}
