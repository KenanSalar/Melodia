// **`mounted` gates the card's `if` branch and `open` drives its fade**, so a close lowers `open`
// and Rust lowers `mounted` a beat later. Rust owns both timers because nothing under
// `components/onboarding/` may carry a `changed` handler, one outliving the dropped branch
// panicking on the next open.
export global Onboarding {
    in-out property <bool> mounted;
    // Raised a frame after `mounted`, so `animate` has an edge to run on.
    in-out property <bool> open;

    in-out property <int> step;
    // **The sole definition of how many panels there are**: the footer, the step dots and Rust's
    // clamp all read it.
    out property <int> step-count: 3;

    public function advance(delta: int) {
        root.step = clamp(root.step + delta, 0, root.step-count - 1);
    }

    // Every way out marks the card seen, a card that comes back because it was closed early being
    // a nag.
    callback dismiss();

    // Onto Settings ▸ Integrations: a scrobbling login has no business inside a welcome card.
    callback open-services();

    // Empty where there is nothing to offer: no Music folder, or one the library already covers.
    // Rust keeps it current while the card is up.
    in property <string> suggested-folder;
    // The Library tab's add, minus the picker.
    callback add-suggested-folder();
}
