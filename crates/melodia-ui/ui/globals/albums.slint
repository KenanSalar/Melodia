import { AlbumRow, AlbumGridRow, TrackListRow, TrackColumns } from "../models.slint";

// `grid-rows` is a paged model Rust installs once (`ui::card_grid`): `apply-filter` and
// `request-sort` reload its ids, and `columns` re-chunks them.
export global Albums {
    in-out property <[AlbumGridRow]> grid-rows;
    // `-1` until fetched (`ui::tab_bar::UNFETCHED_COUNT`): a count outliving the model a leave
    // empties would hide the empty state, and `0` would claim one through the fetch. The header
    // guards on `>= 0`, `@tr` otherwise spelling the sentinel out.
    in-out property <int> total-count: -1;      // pre-filter album count
    in-out property <int> columns: 4;           // view-computed; always >= 1
    in-out property <string> filter;
    in-out property <string> sort-field: "name";   // "name" | "year" | "artist"
    in-out property <string> sort-dir: "asc";

    callback columns-changed(int);
    callback apply-filter(string);
    callback request-sort(string /*field*/);
    callback open-album(int /*album_id*/);
    // Asked by each mounted card, so only those hold a cover. A miss schedules a decode and
    // repaints on the `covers-generation` bump.
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;
    in property <int> covers-generation: 0;
    // A leave shrinks the grid tier to proxies, so a re-entry paints the right cover at once.
    callback section-active-changed(bool);
}

// `album-id` -1 shows the grid. **The album column is off and locked**, redundant inside one
// album.
export global AlbumDetail {
    in-out property <int> album-id: -1;
    // A persisted detail is being reopened and its id hasn't landed. Raised before `app.show()`,
    // or on the first enter of a tab the launch left hidden, so the grid never paints a frame of
    // the wrong page while the restore fetches.
    in-out property <bool> restoring: false;
    in-out property <AlbumRow> album;
    in-out property <[TrackListRow]> tracks;

    // Fed by the band's box. Cleared on a fresh open and kept across a library refresh, so a typed
    // needle survives a scan.
    in-out property <string> filter;

    in-out property <TrackColumns> track-columns;

    in-out property <string> sort-field: "track_number";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // The **section** the detail was opened from, which the close restores **before** clearing
    // `album-id`, so the page reroutes in one frame. A drill from a sibling tab records -1: the
    // back arrow means "close this detail", and the tab bar names Albums for the whole visit.
    // In memory only.
    in-out property <int> origin-nav-index: -1;

    // Decoded **once** per album into a `(cover, blur)` pair by `ui::artwork_cache`.
    in-out property <image> cover;

    // The two-slot cross-fade: Rust fills the hidden slot and flips, so nothing flashes.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    // False with no artwork or a failed decode, leaving the gradient floor.
    in-out property <bool>  has-blur;

    callback close-detail();
    callback shuffle-album();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback filter-changed(string);
}
