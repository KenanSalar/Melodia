import { NotificationRow, NotificationKind } from "../models.slint";

// The bottom-right transient stack, for messages that don't warrant a modal.
// `crates/melodia-views/src/ui/shell/notifications.rs` owns the backing model and handles both
// callbacks. Unlike `Dialog`, `kind` lives on the *row*: several can be up at once, each with its
// own, and a single field on the global wouldn't survive stacking.
export global Notifications {
    in-out property <[NotificationRow]> rows: [];
    // Closing an update toast doesn't skip the version, so it returns next launch; the permanent
    // skip lives in Settings, where that's what it obviously means.
    callback dismiss(int /*id*/);
    callback action(int /*id*/, NotificationKind);
}
