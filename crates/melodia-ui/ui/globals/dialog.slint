import { PlaylistPickRow, PlaylistExportPickRow, RadioStationRow } from "../models.slint";
import { SmartEditor, TagEditor, ScrobbleUi, RadioForm } from "dialog-forms.slint";
import { Radio } from "radio.slint";
import { LibrarySettings } from "library-settings.slint";
import { Playlists, PlaylistDetail } from "playlists.slint";
import { Queue } from "queue.slint";
import { WindowChrome } from "shell.slint";
import { Settings } from "../settings.slint";

// `none` first, so a dialog never opened and one torn down read the same.
export enum DialogKind {
    none,
    remove-folder,
    restart-titlebar,
    restart-tray,
    restart-backdrop,
    clear-queue,
    bit-perfect-exclusive,
    create-playlist,
    rename-playlist,
    delete-playlist,
    delete-playlists,
    edit-playlist-artwork,
    export-playlists,
    add-to-playlist,
    smart-playlist-editor,
    edit-tags,
    add-station,
    edit-station,
    remove-from-favorites,
    remove-from-recent,
    scrobble-listenbrainz-login,
    scrobble-lastfm-login,
    equalizer,
    replaygain,
}

// A caller writes the chrome and a routing payload, `kind` and `target-id`, and `accepted` below
// forwards on `kind`, so Rust holds no closure per dialog. An empty `cancel-label` is an info
// dialog with one button.
export global Dialog {
    in-out property <bool> open;
    // Bumped by every opener through `claim-request()`: `open` can't say which intent is live
    // while a deferred raise fetches, so Rust's `DialogClaim` compares this past the await.
    in-out property <int> request-generation;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> confirm-label: "OK";
    in-out property <string> cancel-label;
    in-out property <bool> destructive;

    in-out property <DialogKind> kind;
    in-out property <int> target-id: -1;

    // A playlist's name and optional description.
    in-out property <string> input-text;
    in-out property <string> input-text-2;

    // The mosaic picker's 1–4 picks. **Empty means "clear artwork"**, hence `mosaic-touched`.
    in-out property <[string]> mosaic-selection;

    // The covers of the playlist's tracks, deduplicated in the page's order.
    in-out property <[string]> mosaic-candidates;

    // Picks the empty pool's hint: a smart playlist's tracks come from its rules, so telling the
    // user to add some is advice they can't take.
    in-out property <bool> mosaic-smart;

    // The saved artwork, so the picker opens on what the playlist looks like now.
    in-out property <image> current-artwork;

    // Raised by any toggle and by Clear. The preview switches to what Apply would save, and an
    // untouched empty confirms as a no-op rather than wiping the saved artwork.
    in-out property <bool> mosaic-touched;

    // What a "New Playlist…" from a row's Add to Playlist adds once the playlist exists, and what
    // the `add-to-playlist` picker adds.
    in-out property <[int]> pending-track-ids;

    // Entity ids, kept off the property above so a delete never carries playlist ids under a
    // name that says tracks.
    in-out property <[int]> pending-card-ids;

    // Filled before `open` flips. Rust keeps the count over enabled rows, a Slint expression being
    // unable to iterate a model.
    in-out property <[PlaylistPickRow]> playlist-pick-rows;
    in-out property <bool> add-select-all: false;
    in-out property <int> add-selected-count: 0;

    // The same shape, every row opening unticked.
    in-out property <[PlaylistExportPickRow]> export-pick-rows;
    in-out property <bool> export-select-all: false;
    in-out property <int> export-selected-count: 0;

    // `pending-track-ids.length` at open, so a row derives `disabled` without re-reading the array.
    in-out property <int> pick-total-tracks;

    callback accepted();
    callback cancelled();

    // A default body here, Slint rejecting `Dialog.accepted => { … }` at component scope.
    // **Never clear state in it**: clearing `kind` unmounts the body before the close animation
    // plays. Teardown is `closed-teardown`'s.
    accepted => {
        if (root.kind == DialogKind.remove-folder) {
            LibrarySettings.remove-folder(root.target-id);
        } else if (root.kind == DialogKind.restart-titlebar) {
            // Rust reads the new value off `target-id`: 1 native, 0 custom.
            WindowChrome.restart-app();
        } else if (root.kind == DialogKind.restart-tray) {
            // 1 enabled, 0 disabled.
            WindowChrome.restart-tray();
        } else if (root.kind == DialogKind.restart-backdrop) {
            // 1 aurora, 0 blurred cover.
            WindowChrome.restart-backdrop();
        } else if (root.kind == DialogKind.clear-queue) {
            Queue.clear-queue();
        } else if (root.kind == DialogKind.bit-perfect-exclusive) {
            // One Rust handler, which moves the chip too, rather than the chip's pick beside the
            // button's: the reset reads off the claim whether the device carries the volume, and
            // run first it would raise the device.
            Settings.output-switch-to-bit-perfect();
        } else if (root.kind == DialogKind.create-playlist) {
            Playlists.create-playlist(
                root.input-text,
                root.input-text-2,
                root.pending-track-ids,
            );
        } else if (root.kind == DialogKind.rename-playlist) {
            Playlists.rename-playlist(
                root.target-id,
                root.input-text,
                root.input-text-2,
            );
        } else if (root.kind == DialogKind.delete-playlist) {
            Playlists.delete-playlist(root.target-id);
        } else if (root.kind == DialogKind.delete-playlists) {
            Playlists.delete-playlists(root.pending-card-ids);
        } else if (root.kind == DialogKind.edit-playlist-artwork) {
            if (root.mosaic-selection.length == 0) {
                if (root.mosaic-touched) {
                    Playlists.clear-artwork(root.target-id);
                }
            } else {
                Playlists.apply-mosaic(root.target-id, root.mosaic-selection);
            }
        } else if (root.kind == DialogKind.export-playlists) {
            Playlists.export-selected-playlists();
        } else if (root.kind == DialogKind.add-to-playlist) {
            Playlists.add-tracks-to-selected();
        } else if (root.kind == DialogKind.smart-playlist-editor) {
            SmartEditor.commit();
        } else if (root.kind == DialogKind.edit-tags) {
            TagEditor.commit();
        } else if (root.kind == DialogKind.add-station || root.kind == DialogKind.edit-station) {
            RadioForm.submit();
        } else if (root.kind == DialogKind.remove-from-favorites) {
            Radio.remove-from-favorites(root.pending-card-ids);
        } else if (root.kind == DialogKind.remove-from-recent) {
            Radio.remove-from-recent(root.pending-card-ids);
        } else if (root.kind == DialogKind.scrobble-listenbrainz-login) {
            ScrobbleUi.listenbrainz-verify(ScrobbleUi.lb-token);
        } else if (root.kind == DialogKind.scrobble-lastfm-login) {
            if (ScrobbleUi.lastfm-step == 0) {
                ScrobbleUi.lastfm-open-auth();
            } else {
                ScrobbleUi.lastfm-finish(ScrobbleUi.lastfm-token);
            }
        }
    }
    cancelled => { }

    // Fired by `DialogOverlay` once the close animation ends, into the one Rust handler
    // (`ui::callbacks::dialog_closed`), which runs `closed-teardown()` and resets the `image`
    // properties, those having no Slint literal. **The teardown is a `public function`**: a default
    // `closed` body would be replaced by that handler.
    callback closed();

    public function closed-teardown() {
        root.kind = DialogKind.none;
        root.target-id = -1;
        root.input-text = "";
        root.input-text-2 = "";
        root.mosaic-selection = [];
        root.mosaic-candidates = [];
        root.mosaic-touched = false;
        root.mosaic-smart = false;
        root.pending-track-ids = [];
        root.pending-card-ids = [];
        // Unmounts the picker's rows, and with them the row-tier buffers their covers pin.
        root.playlist-pick-rows = [];
        root.add-select-all = false;
        root.add-selected-count = 0;
        root.pick-total-tracks = 0;
        RadioForm.reset();
        root.export-pick-rows = [];
        root.export-select-all = false;
        root.export-selected-count = 0;
        // `confirm-label` is restored rather than cleared, so a caller that flips `open` without
        // setting it still gets a label.
        root.title = "";
        root.message = "";
        root.confirm-label = "OK";
        root.cancel-label = "";
        root.destructive = false;
    }

    // Openers state what a dialog says, as `accepted` routes where it goes. **A kind earns one on
    // either of two counts**: two callers share it, or its raise is deferred past a fetch and so
    // has to take a claim. `crates/melodia/tests/dialog_openers.rs` walks the tree for a populate
    // block spelled again, which opens the right dialog and is free to drift.

    // Retires whatever a slower intent was still resolving. Every opener opens with it.
    function claim-request() {
        root.request-generation += 1;
    }

    public function open-create-playlist(track-ids: [int]) {
        root.claim-request();
        root.title = @tr("New Playlist");
        root.message = "";
        root.confirm-label = @tr("Create");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.create-playlist;
        root.target-id = -1;
        root.input-text = "";
        root.input-text-2 = "";
        root.pending-track-ids = track-ids;
        root.open = true;
    }

    // The heading is the caller's, which alone knows how many rows it holds. Doesn't set `open`:
    // Rust fetches the rows, the lyrics and a cover and raises the card itself, which is also why
    // the tab is an argument, the populate resetting `active-tab` a tick later.
    public function open-tag-editor(heading: string, ids: [int], tab: int) {
        root.claim-request();
        root.title = heading;
        root.message = "";
        root.confirm-label = @tr("Save");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.edit-tags;
        TagEditor.request-edit(ids, tab);
    }

    public function open-rename-playlist(id: int, name: string, description: string) {
        root.claim-request();
        root.title = @tr("Rename Playlist");
        root.message = "";
        root.confirm-label = @tr("Save");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.rename-playlist;
        root.target-id = id;
        root.input-text = name;
        root.input-text-2 = description;
        root.open = true;
    }

    public function open-delete-playlist(id: int) {
        root.claim-request();
        root.title = @tr("Delete playlist?");
        root.message = @tr("The playlist and its track order will be removed. The tracks themselves stay in your library.");
        root.confirm-label = @tr("Delete");
        root.cancel-label = @tr("Cancel");
        root.destructive = true;
        root.kind = DialogKind.delete-playlist;
        root.target-id = id;
        root.open = true;
    }

    // Its own opener rather than a count ternary in the one above: the singular copy names one
    // playlist's track order.
    public function open-delete-playlists(ids: [int]) {
        root.claim-request();
        root.title = @tr("Delete {} playlists?", ids.length);
        root.message = @tr("The playlists and their track order will be removed. The tracks themselves stay in your library.");
        root.confirm-label = @tr("Delete");
        root.cancel-label = @tr("Cancel");
        root.destructive = true;
        root.kind = DialogKind.delete-playlists;
        root.pending-card-ids = ids;
        root.open = true;
    }

    // The kind carries the tab, so a removal means the list the card was on rather than whichever
    // is mounted when the confirm lands. **A hand-typed station's copy says it goes for good**:
    // with no uuid it is listed by its star alone, so `is_listed` deletes it with its history, and
    // understating that is a destructive action with no undo.
    public function open-remove-station(station: RadioStationRow, from-recent: bool) {
        root.claim-request();
        root.title = from-recent
            ? @tr("Remove from Recently Played?")
            : @tr("Remove from favorites?");
        root.message = from-recent
            ? @tr("\"{}\" will be removed from Recently Played.", station.name)
            : station.uuid == ""
                ? @tr("\"{}\" will be removed from your stations, along with its play history.", station.name)
                : @tr("\"{}\" will be removed from your favorites.", station.name);
        root.confirm-label = @tr("Remove");
        root.cancel-label = @tr("Cancel");
        root.destructive = true;
        root.kind = from-recent ? DialogKind.remove-from-recent : DialogKind.remove-from-favorites;
        root.pending-card-ids = [station.id];
        root.open = true;
    }

    // A selection may hold hand-typed stations the menu can't see, so the Favorites copy always
    // says what removing one of those costs.
    public function open-remove-stations(ids: [int], from-recent: bool) {
        root.claim-request();
        root.title = from-recent
            ? @tr("Remove {n} station from Recently Played?" | "Remove {n} stations from Recently Played?" % ids.length)
            : @tr("Remove {n} station from favorites?" | "Remove {n} stations from favorites?" % ids.length);
        root.message = from-recent
            ? @tr("The stations will be removed from Recently Played.")
            : @tr("The stations will be removed from your favorites. Any you added by hand are removed from your stations, along with their play history.");
        root.confirm-label = @tr("Remove");
        root.cancel-label = @tr("Cancel");
        root.destructive = true;
        root.kind = from-recent ? DialogKind.remove-from-recent : DialogKind.remove-from-favorites;
        root.pending-card-ids = ids;
        root.open = true;
    }

    // Shares only its `kind` with `open-new-smart-playlist`, every string differing. Rust raises
    // the card once the rules load.
    public function open-edit-smart-rules(id: int) {
        root.claim-request();
        root.title = @tr("Edit Rules");
        root.message = "";
        root.confirm-label = @tr("Save");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.smart-playlist-editor;
        root.target-id = id;
        SmartEditor.request-edit(id);
    }

    // One caller, here for the claim: Rust raises the card from a later tick.
    public function open-new-smart-playlist() {
        root.claim-request();
        root.title = @tr("New Smart Playlist");
        root.message = "";
        root.confirm-label = @tr("Create");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.smart-playlist-editor;
        root.target-id = -1;
        SmartEditor.request-new();
    }

    // The heading is the caller's: a row menu counts tracks, and a card menu can't name a track
    // total until Rust resolves one. Rust raises the card once the rows are filled.
    public function prepare-add-to-playlist(heading: string) {
        root.claim-request();
        root.title = heading;
        root.message = "";
        root.confirm-label = @tr("Add");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.add-to-playlist;
    }

    // Called from Rust, so its strings sit here where `@tr` reaches them. Rust raises the card once
    // the pool and the preview are filled.
    public function prepare-edit-artwork(id: int, is-smart: bool) {
        root.claim-request();
        root.title = @tr("Edit Artwork");
        root.message = "";
        root.confirm-label = @tr("Apply");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.edit-playlist-artwork;
        root.target-id = id;
        root.input-text = "";
        root.mosaic-selection = [];
        root.mosaic-touched = false;
        root.mosaic-smart = is-smart;
    }

    // One caller, here for the claim. Rust raises the card once it has recounted the smart lists.
    public function prepare-export-playlists() {
        root.claim-request();
        root.title = @tr("Export Playlists");
        root.message = @tr("Choose playlists to export.");
        root.confirm-label = @tr("Export");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = DialogKind.export-playlists;
    }
}
