import { Theme } from "../theme.slint";

// Sidebar nav drops in from `above`, a drill from the `right`, the back button from the `left`.
// **The mount it steers is a page**, so a drill that doesn't move `Nav.selected-index` steers
// nothing.
export enum NavEnterFrom { above, right, left }

// Which content view the shell shows:
//   0=search, 1=browse, 2=favorites, 3=my-library, 8=recently-played, 9=settings, 10=radio
// **4–7 are retired** My Library tabs, which `boot::ui_setup` folds onto 3. 8 and 9 kept their
// numbers, being in `views.json` on every install. **Sidebar order is source order.**
// `services::view_state::MAX_NAV_INDEX` bounds the persisted value both ways.
export global Nav {
    in-out property <int> selected-index: 3;
    // Toggled from the bar's track card, which stays mounted to close it.
    in-out property <bool> now-playing-open: false;
    // Lets the Up Next subscriber skip its rebuild while the view is closed. Fired from
    // `AppWindow`'s mirror, a global being unable to watch its own property.
    callback now-playing-open-changed(bool);
    callback persist-selected-index(int);
    callback reveal-in-folder(int /*track_id*/);
    // One trio for every menu (`ui::callbacks::cross_tab_nav`): the origin a drill records is read
    // off where the user stands, not off who asked.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
    // Written **immediately before** the flip that mounts the view (`ui/nav_transition.rs`).
    in-out property <NavEnterFrom> pending-enter-from: NavEnterFrom.above;
    // Handed back by the mount once settled (`view-transition.slint`). Declared raised because
    // `AppWindow::new()` already builds the default page, which a raise from Rust would fade in.
    in-out property <bool> suppress-enter-animation: true;
    // The user's fold, and the only one persisted.
    in-out property <bool> sidebar-collapsed: false;
    in-out property <length> sidebar-width: 180px;
    // Clamped here rather than on hydrate, so a stored width from anywhere is drawn in range.
    out property <length> sidebar-expanded-w:
        clamp(self.sidebar-width, Theme.sidebar-min-w, Theme.sidebar-max-w);
    // Written only by `AppWindow`, which alone sees the window's width, and written rather than
    // bound so a resize can't restart the sidebar's width ease on every move.
    in-out property <bool> sidebar-yields: false;
    // What the sidebar draws, which every part of it reads.
    out property <bool> sidebar-rail: self.sidebar-collapsed || self.sidebar-yields;
    // Switches off the rail's and the rows' eases for a handle drag, which every mouse move would
    // otherwise restart.
    in-out property <bool> sidebar-dragging: false;
    // The rail's tooltip channel, `app-window.slint` painting the pill: on the row, `nav-scroll`
    // would clip it and the content panel paint over it. -1 is none, and **only the row owning the
    // hover may clear it**, or a late leave would blank the next row's tooltip.
    in-out property <int> sidebar-tip-idx: -1;
    // Outside `selected-index`'s range, the Collapse toggle owning no nav index.
    out property <int> sidebar-collapse-tip-idx: -2;
    in-out property <string> sidebar-tip-label;
    // Snapshotted on enter: only scrolling the rail moves a row, which re-fires this anyway.
    in-out property <length> sidebar-tip-y;
    in-out property <length> sidebar-tip-h;
}
