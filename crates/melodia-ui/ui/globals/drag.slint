// Slint's `DragArea` carries an opaque `data-transfer` Slint code can't read, so the token is a
// constant and what a drag means sits here.

import { LiftedRun } from "../models.slint";

// A list takes back only its own rows, as a reorder.
export enum DragOrigin { none, queue, up-next, playlist }

// Add to Queue's `(kind, ids)`, and what the chip under the pointer draws. A `kind` of "" carries
// nothing.
export struct DragItems {
    kind: string,
    ids: [int],
    title: string,
    cover: image,
}

export struct DragPayload {
    origin: DragOrigin,
    // In its own list's order.
    index: int,
    // Whether the press lifted every row its list holds picked, rather than that row alone.
    picks: bool,
    // So a drop beside the lifted rows can be told to move nothing.
    run: LiftedRun,
    items: DragItems,
}

export global Drag {
    // Built once in Rust, the host being the only way to make one, and given user data alone so no
    // backend can take the drag out of the window.
    in property <data-transfer> token;

    // **Armed by the row a press lands on, and disarmed by every press first** in the winit filter.
    // A `DragArea` drags from any press it contains, a gap or a row's own button included, so a
    // drag from one of those carries nothing rather than the last row clicked.
    out property <DragPayload> payload;

    // The source's `dragging`, the one end every drag reaches (`slint-pitfalls.md`). A source
    // unmounted mid-drag never hears it, and the next press's disarm lowers this instead.
    in-out property <bool> live;

    // Raised by the winit filter as a touch begins and lowered by a mouse press. Every `DragSource`
    // stands down for a touch, which pans the list instead.
    in-out property <bool> touching;

    // Written by whatever took the last move: a target, or the leaf behind them all.
    out property <length> x;
    out property <length> y;
    out property <bool> ghost-shown;

    public function arm(origin: DragOrigin, index: int) {
        self.payload = { origin: origin, index: index, run: { first: index, count: 1 } };
    }

    public function arm-items(origin: DragOrigin, index: int, items: DragItems) {
        self.payload = {
            origin: origin,
            index: index,
            run: { first: index, count: 1 },
            items: items,
        };
    }

    // After the arm, for a press on a picked row while others are picked too. Rust says where they
    // sit, a list it pages being one Slint can't walk.
    public function lift-picks(run: LiftedRun) {
        self.payload = {
            origin: self.payload.origin,
            index: self.payload.index,
            picks: true,
            run: run,
            items: self.payload.items,
        };
    }

    public function disarm() {
        self.payload = { origin: DragOrigin.none, index: -1 };
        self.live = false;
        self.ghost-shown = false;
    }

    // For a list whose rows moved under a live drag: the drag goes on, but its index no longer
    // names the row it lifted. The items are ids and still hold.
    public function revoke(origin: DragOrigin) {
        if (self.payload.origin == origin) {
            self.payload = { origin: DragOrigin.none, index: -1, items: self.payload.items };
        }
    }

    public function follow(x: length, y: length, ghost: bool) {
        self.x = x;
        self.y = y;
        self.ghost-shown = ghost;
    }
}

export enum FileDropTarget { none, queue, playlist }

// In window coordinates, the space the winit filter has the pointer in.
export struct WindowRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

// A file dragged in from the file manager. No OS drag reaches a `DropArea`, so the winit filter
// hit-tests it against these rects (`desktop-shell.md`).
export global FileDrag {
    // Each written by a `WindowRectReport` as it moves. The filter reads one only while its target
    // can take a drop, so neither is cleared when its target goes.
    in-out property <WindowRect> queue-rect;
    in-out property <WindowRect> content-rect;

    // Written by the filter on every move, and the one thing either banner reads.
    in property <FileDropTarget> target;
}
