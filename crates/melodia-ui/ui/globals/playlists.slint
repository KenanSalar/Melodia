import { LiftedRun, PlaylistRow, PlaylistGridRow, TrackListRow, TrackColumns } from "../models.slint";

// On `Albums`' contract. Sorted by most recently updated, with no sort control.
export global Playlists {
    in-out property <[PlaylistGridRow]> grid-rows;
    // Smart ones included, kept current from launch: every row menu gates Add to Playlist on it.
    in property <int> count: 0;
    // `-1` until fetched; see `Albums.total-count`.
    in-out property <int> total-count: -1;      // pre-filter playlist count
    in-out property <int> columns: 4;           // view-computed; always >= 1
    in-out property <string> filter;

    callback columns-changed(int);
    callback apply-filter(string);
    callback open-playlist(int /*playlist_id*/);
    // The `Albums.request-cover` contract.
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;
    in property <int> covers-generation: 0;
    // The row tier, for the mosaic picker's tiles, which a grid-size decode would oversize.
    pure callback request-row-cover(string /*artwork_path*/) -> image;
    callback section-active-changed(bool);

    // Fired by `Dialog.accepted` on confirm.
    callback create-playlist(
        string /*name*/,
        string /*description (empty ⇒ no description)*/,
        [int] /*pending_track_ids*/,
    );
    callback rename-playlist(
        int /*id*/,
        string /*new_name*/,
        string /*description (empty ⇒ clear)*/,
    );
    callback delete-playlist(int /*id*/);
    // One refetch and one selection clear for the batch, where looping `delete-playlist` would do
    // both per playlist.
    callback delete-playlists([int] /*ids*/);

    // 1–4 of the playlist's own covers, composed and persisted by Rust.
    callback apply-mosaic(int /*id*/, [string] /*paths*/);
    // Leaves no artwork at all, an automatic cover included.
    callback clear-artwork(int /*id*/);

    // `toggle-add-pick` skips a row already holding every track, and `set-all-add-picks` touches
    // enabled rows only.
    callback toggle-add-pick(int /*playlist_id*/);
    callback set-all-add-picks(bool /*selected*/);

    callback add-tracks-to-selected();

    // Rust caps the picks at four.
    callback toggle-mosaic-candidate(string /*artwork_path*/);

    // For the card's Rename, `PlaylistGridRow` carrying no description. Answered from a cache, so
    // safe in a click handler.
    pure callback row-name(int /*playlist_id*/) -> string;
    pure callback row-description(int /*playlist_id*/) -> string;

    // For the card, whose playlist needn't be the open detail.
    callback request-edit-artwork-for(int /*playlist_id*/);

    // Rust raises the dialog once the rows and their overlap counts are in. An
    // `exclude_playlist_id` of -1 lists every playlist; Playlist Detail passes its own.
    callback request-add-to-playlist(
        [int] /*track_ids*/,
        int /*exclude_playlist_id*/,
    );

    callback import-playlists();

    callback request-export-playlists();

    // One `.m3u8`, or a zip of several.
    callback export-selected-playlists();

    callback toggle-export-pick(int /*playlist_id*/);
    callback set-all-export-picks(bool /*selected*/);
}

// `playlist-id` -1 shows the grid. **Drag-to-reorder needs an ascending `"position"` sort**,
// which a column's third click hands back (`ui-patterns.md`'s synthetic-field entry).
export global PlaylistDetail {
    in-out property <int> playlist-id: -1;
    // See `AlbumDetail.restoring`.
    in-out property <bool> restoring: false;
    in-out property <PlaylistRow> playlist;
    in-out property <[TrackListRow]> tracks;

    // As `AlbumDetail.filter`, and drag-reorder stands down while it is set.
    in-out property <string> filter;

    // Hydrated from `views.json` under `playlist_detail`.
    in-out property <TrackColumns> track-columns;

    in-out property <string> sort-field: "position";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // `AlbumDetail`'s two slots.
    in-out property <image> cover;
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    callback close-detail();
    callback shuffle-all();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);

    callback reorder(int /*from*/, int /*to*/);
    // Gathers every picked row in front of row `slot`.
    callback move-picks(int /*slot*/);
    // Asked by a press on a picked row; only Rust holds the whole list.
    callback picked-run() -> LiftedRun;

    // Rust queries the covers first and raises the picker from a fresh tick.
    callback request-edit-artwork();

    callback remove-track([int] /*track_ids*/);

    callback filter-changed(string);
}
