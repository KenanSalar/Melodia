import { Theme } from "../theme.slint";

// Chrome state for the Settings page — the search filter, the rule every section applies to it,
// and the body's responsive geometry. Split out of `Settings`, which holds the values the user
// configures: how the page is filtered is a different axis of change from what it configures.
export global SettingsPage {
    // Named so the router and the bar's arrays key off something readable instead of a bare
    // 0..4, and so adding a tab is a rename-safe edit.
    out property <int> tab-library: 0;
    out property <int> tab-playback: 1;
    out property <int> tab-interface: 2;
    out property <int> tab-services: 3;
    out property <int> tab-about: 4;

    // **The sole definition of how many tabs exist.** Rust clamps the persisted index against
    // it rather than carrying a copy.
    out property <int> tab-count: 5;

    // Seeded from `views.json` at boot and persisted on change.
    in-out property <int> tab-idx: 0;
    callback tab-changed(int);

    // What the user is typing, and what the page is filtered by. **Two properties**, joined by a
    // `FilterThrottle`: `row-visible` is three `matches` round-trips into Rust across dozens of call
    // sites, and a non-empty query mounts *all five* tab pages at once. Cleared together on nav-away
    // and on a tab pick — clearing only the settled one leaves the box holding a stale filter.
    in-out property <string> search-input;
    in-out property <string> search-query;

    // Releases keyboard focus from the SearchBar, the `MyLibrary.blur-search-tick` pattern.
    in-out property <int> blur-search-tick: 0;

    // The two facts the view writes imperatively — a global can't be bound from a view, and the
    // page can't read its live width into a binding feeding a child's size without re-entering
    // layout. **Everything below derives from them.** The seed is a plausible narrow page: too
    // narrow costs an extra chip row, where zero collapses the strips outright.
    in-out property <length> page-w: 440px;
    // 1 or 2. Also what `grid-row`/`grid-col` key off.
    in-out property <int> body-cols: 1;

    // How wide one card column may grow — **one number, and both layouts obey it**: a card grows to
    // the cap, then takes margins, and a second column appears exactly when two *capped* cards fit
    // beside each other, so the flip resizes nothing. A threshold undercutting the cap is the
    // failure to avoid, reading as a card that grows without limit and then halves.
    out property <length> card-cap: 800px;

    // What the centred body may grow to — a function of the layout, not the panel.
    out property <length> body-w: root.body-cols == 2
        ? 2 * root.card-cap + Theme.pad-lg
        : root.card-cap;

    // What one column is drawn at, which below the cap is just the panel. The `min` only bites
    // in a single column — two are reached exactly when both fit at the cap.
    out property <length> body-avail: max(0px, root.page-w - 2 * Theme.pad-lg);
    out property <length> card-w: min(
        root.body-cols == 2
            ? max(0px, (root.body-avail - Theme.pad-lg) / 2)
            : root.body-avail,
        root.card-cap);

    // The glyph column both settings rows lead with. Here rather than in the rows because
    // `row-content-w` has to subtract it, and two copies could drift with nothing failing.
    out property <length> row-icon-w: 22px;

    // What a `SettingRowStacked` leaves its content column. Derived rather than measured, every
    // card spanning a full column — which is what lets the strips wrap with no mirror of their own.
    out property <length> row-content-w:
        max(0px, root.card-w - (3 * Theme.pad-lg + root.row-icon-w));

    // Where a page's **column** sits in the body grid — not a card. Cards placed as cells are
    // row-aligned and a grid row is as tall as its taller cell, so a short card leaves a hole; one
    // cell per column lets the two sides flow independently, in **contiguous halves** so stacked
    // they read in source order. The pages mount their sections exactly once and place them through
    // these — a page reads `has-matches` off its instances, unreadable from inside an `if`.
    public pure function grid-row(i: int) -> int {
        return root.body-cols == 2 ? Math.floor(i / 2) : i;
    }
    public pure function grid-col(i: int) -> int {
        return root.body-cols == 2 ? Math.mod(i, 2) : 0;
    }

    // The wrapping strips' row split, as index groups. **In Rust because Slint can't build a
    // nested array**, and indices rather than items so a chip still knows which option it is.
    pure callback chunk-indices(int /*count*/, int /*per-row*/) -> [[int]];

    // The half of that wrap expressible here; `ChipGroup` and `ColorDotGrid` derived both
    // identically. Floored at one — a row of zero items never terminates, where one too wide for
    // its slot is a visible overflow rather than a hang.
    public pure function wrap-per-row(avail: length, item-w: length, gap: length) -> int {
        return max(1, Math.floor((avail + gap) / (item-w + gap)));
    }
    // Zero items stand at zero rather than at minus one gap.
    public pure function wrap-height(count: int, per-row: int, cell-h: length,
                                     gap: length) -> length {
        return max(0px, Math.ceil(count / per-row) * cell-h
            + (Math.ceil(count / per-row) - 1) * gap);
    }

    // Slint 1.16 has no `.contains()` on string, so the test is wired in Rust.
    pure callback matches(string /*haystack*/, string /*needle*/) -> bool;

    // Whether a row survives the filter, shared rather than copied into ten sections. **Reading
    // `search-query` at the call site is what makes the result reactive** — Slint tracks the
    // property read; `matches` is opaque to it. `tab` is a term of its own, not a prefix spliced
    // onto each title, so no card can match a substring spanning the seam — and search escapes the
    // tabs, so without it "Interface" and "Services" appear in no haystack.
    public pure function row-visible(tab: string, section: string, haystack: string,
                                     query: string) -> bool {
        return query == ""
            || root.matches(tab, query)
            || root.matches(section, query)
            || root.matches(haystack, query);
    }
}
