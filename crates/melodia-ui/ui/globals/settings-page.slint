import { Theme } from "../theme.slint";

// The Settings page's chrome, apart from `Settings`' values: how the page is filtered and laid out
// is a different axis of change from what it configures.
export global SettingsPage {
    out property <int> category-library: 0;
    out property <int> category-playback: 1;
    out property <int> category-effects: 2;
    out property <int> category-output: 3;
    out property <int> category-appearance: 4;
    out property <int> category-language: 5;
    out property <int> category-window: 6;
    out property <int> category-radio: 7;
    out property <int> category-lyrics: 8;
    out property <int> category-integrations: 9;
    out property <int> category-updates: 10;
    out property <int> category-accessibility: 11;
    out property <int> category-about: 12;

    // **The sole definition of how many categories exist**, every list of them pinned to it.
    out property <int> category-count: 13;

    in-out property <int> category-idx: 0;
    callback category-changed(int);

    // The Slint face of `settings_page::open_on`, from anywhere; a pick in the panel is
    // `category-changed`.
    callback open-category(int);

    // **Two properties**, joined by a `FilterThrottle`: a settled query fans out to every page's
    // `row-visible`, a search mounting them all.
    in-out property <string> search-input;
    in-out property <string> search-query;

    in-out property <int> blur-search-tick: 0;

    // Spelled once for its two callers, `app-window.slint`'s nav-away and Rust's category pick. A
    // `public function` because a callback has one handler slot, which a Rust registration takes.
    public function clear-search() {
        root.search-input = "";
        root.search-query = "";
        root.blur-search-tick += 1;
    }

    // The one fact the view writes imperatively: a global can't be bound from a view, and a live
    // width read into a child's size re-enters layout. Seeded narrow, zero collapsing every card
    // for the frame before the first write.
    in-out property <length> body-avail: 440px;

    out property <length> card-cap: 720px;

    // Pinned rather than left to the layout, where the column would sit at its widest card's
    // natural width and one category's cards would come out narrower than another's.
    out property <length> card-w: min(root.body-avail, root.card-cap);

    // Below this the panel folds to its rail: the cards need the room more than the labels do, and
    // the rail's tooltips still carry the names.
    out property <length> nav-collapse-body-w: 440px;

    // Anything painting to match the card reads it here, a brush one shade off showing as a seam.
    out property <brush> card-fill: Theme.surface0;

    out property <length> row-icon-w: 22px;

    // A card's title band is the panel's search row with its inset either side, so the title
    // shares the search box's centre line and the rule under it meets the first category row.
    out property <length> nav-row-h: 36px;
    out property <length> nav-pad: Theme.pad-sm;
    out property <length> card-header-h: root.nav-row-h + 2 * root.nav-pad;

    // Slint 1.18 has no `.contains()` on string.
    pure callback matches(string /*haystack*/, string /*needle*/) -> bool;

    // **Reading `search-query` at the call site is what makes the result reactive**, `matches`
    // being opaque to Slint. `category` is a term of its own so no match spans the seam.
    public pure function row-visible(category: string, section: string, haystack: string,
                                     query: string) -> bool {
        return query == ""
            || root.matches(category, query)
            || root.matches(section, query)
            || root.matches(haystack, query);
    }
}
