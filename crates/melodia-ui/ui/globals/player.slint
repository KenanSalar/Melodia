import { PlayerVm, QueueVm, TrackMetaRow } from "../models.slint";
import { Settings } from "../settings.slint";

export global Player {
    in-out property <PlayerVm> vm;
    in-out property <QueueVm> queue;

    // `player::now_playing::SourceSummary`'s ladder, spelled again because only `@tr` at a literal
    // reaches the catalogues. The LRM forces an LTR base so `elide` puts its `…` on the right for
    // RTL scripts too (`track-title.slint`).
    out property <string> source-title: root.vm.has_station
        ? "‎" + (root.vm.radio.live_title == "" ? root.vm.radio.name : root.vm.radio.live_title)
        : (root.vm.has_track ? "‎" + root.vm.track.title : @tr("No track playing"));

    out property <string> source-subtitle: root.vm.has_station
        ? "‎" + (root.vm.radio.live_title == ""
            ? root.vm.radio.tags
            : (root.vm.radio.live_artist == "" ? root.vm.radio.name : root.vm.radio.live_artist))
        : (root.vm.has_track
            ? "‎" + (root.vm.track.artist == "" ? @tr("Unknown artist") : root.vm.track.artist)
            : "—");

    // **Empty rather than LRM-prefixed when there is nothing**, so a host can gate on `!= ""`.
    out property <string> source-tertiary: root.vm.has_station
        ? (root.vm.radio.live_artist != ""
            ? "‎" + root.vm.radio.name
            : (root.vm.radio.country == "" ? "" : "‎" + root.vm.radio.country))
        : (root.vm.has_track && root.vm.track.album != "" ? "‎" + root.vm.track.album : "");

    // `loading` is also the re-open a play on a paused station is, so that never reads as a resume;
    // `buffering` is a starved ring under a still-`playing` status, so a dip never reads as a stop.
    out property <string> live-label: root.vm.status == "loading"
        ? @tr("Connecting…")
        : (root.vm.status == "paused"
            // Translators: a state on the station pill, not the Pause button's verb
            ? @tr("Paused")
            : (root.vm.radio.buffering
                ? @tr("Buffering…")
                // Translators: a short pill in place of a track's seek bar
                : @tr("LIVE")));

    // For the lyrics follow's 33 ms tick, a Rust read of `vm` cloning all of it.
    out property <bool> vm-is-playing: root.vm.is_playing;
    out property <float> vm-playback-speed: root.vm.playback_speed;

    // Outside `vm` for the reason `PlayerVm` in `models.slint` gives.
    in-out property <int> position-ms;
    in-out property <int> duration-ms;

    // Held until the position lands within ±2 s, so the slider's thumb doesn't snap back.
    in-out property <int> seek_pending_ms: -1;

    // -1 between runs. Here rather than beside `ShortcutScope`'s timer so `seek-to` can cancel a
    // run whose trailing edge would land on the target an absolute seek abandoned.
    in-out property <int> seek-run-target-ms: -1;
    // Keeps the trailing edge quiet when the leading one already covered the whole run.
    in-out property <bool> seek-run-unsent: false;
    // Non-zero is also what runs the timer, so clearing it drops the trailing edge.
    in-out property <int> seek-run-ticks: 0;
    out property <duration> seek-run-tick: 100ms;
    property <int> seek-run-window-ticks: 3;

    property <bool> can-scan: root.vm.has_track && root.duration-ms > 0;
    // Longer than a slow click, so an ordinary one never turns into a scan.
    out property <duration> scan-hold: root.can-scan ? 500ms : 0ms;
    // Long enough to hear each burst, short enough to read as one sweep.
    out property <duration> scan-interval: 250ms;
    // A refill keeps the timer's phase, so a window of n ticks can lapse n - 1 ticks after its
    // step. One tick past the interval keeps each step inside the last one's run.
    property <int> scan-window-ticks: floor(root.scan-interval / root.seek-run-tick) + 2;
    // A nudge first, growing per step up to a share of the track, so an hour-long recording crosses
    // about as fast as a song.
    property <int> scan-first-jump-ms: 3000;
    property <float> scan-jump-growth: 1.2;
    property <int> scan-jump-cap-floor-ms: 15000;
    property <int> scan-crossing-steps: 12;
    // Where a fast-forward parks: short of the crossfade window, where the monitor would start the
    // next track, by a margin one scan interval plus the device's lead can't use up.
    property <int> scan-end-margin-ms: 2000;
    property <int> scan-end-ms: max(0, root.duration-ms - root.scan-end-margin-ms
        - (Settings.crossfade-enabled ? round(Settings.crossfade-duration-secs * 1000) : 0));
    // A launch restores its track stopped mid-way, and that resumes like a pause, hence the position.
    out property <bool> stopped-at-top: root.vm.has_track && root.vm.status == "stopped"
        && root.position-ms == 0;
    // Clearly longer than any click on the most-pressed button, and than the scan's hold. Off where
    // a stop would change nothing, so a slow press there still plays.
    out property <duration> stop-hold:
        (root.vm.has_track && !root.stopped-at-top) || root.vm.has_station ? 900ms : 0ms;

    out property <string> previous-tooltip: root.can-scan
        ? @tr("Previous (hold to rewind)")
        : @tr("Previous");
    out property <string> next-tooltip: root.can-scan
        ? @tr("Next (hold to fast-forward)")
        : @tr("Next");

    // The two-slot cross-fade (`slint-pitfalls.md`), written only on a track change.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool> blur-use-a: true;
    in-out property <bool> blur-has-image: false;

    // The same over the sharp cover, not `vm.track.cover_img`'s row thumbnail.
    in-out property <image> np-cover-a;
    in-out property <image> np-cover-b;
    in-out property <bool> np-cover-use-a: true;
    in-out property <bool> np-cover-has-image: false;

    // Outside the pair, a station change having nothing to cross-fade between.
    in-out property <image> np-station-logo;
    // `Radio.detail-logo-size`'s twin.
    in-out property <int> np-station-logo-size: 0;

    // `track_id` lets the view drop a stale push landing after a rapid track change.
    in-out property <TrackMetaRow> track-meta;

    in-out property <[string]> chips;

    // The backdrop tier, written together from `ui::backdrop`. **Read the tier, never a `Theme.*`
    // brush**: which arm is live is `backdrop::kind`'s answer, not a consumer's.

    // Alpha baked in, solved so the composite lands in one dark band whatever the cover.
    in-out property <brush> np-scrim: #0a0a0e73;

    // `color`s, since gradient stops and `.mix()` take no `brush`.
    in-out property <color> np-floor-start: #2b2135;
    in-out property <color> np-floor-end: #14101a;

    // The aurora's washes, each weight in its alpha. **As many as `ui::aurora::WASH_COUNT`**: a
    // brush animates stop-for-stop only against a matching one.
    in-out property <color> np-tint-1: #3a2d4a;
    in-out property <color> np-tint-2: #2d3a4a;
    in-out property <color> np-tint-3: #4a2d3a;

    // Written once at boot; `ui::aurora::dither_tile` argues it.
    in-out property <image> np-dither;

    // The hue-carrying tier, solved on the blur to 3:1 then floored so a brighter accent keeps its
    // tone. **Never `.brighter()`**: it scales HSV value and can't lift a near-black accent.
    in-out property <brush> np-accent-bright: #cba6f7;

    // **`transparentize`, not `with-alpha`**: the tier carries an alpha of its own on the aurora.
    out property <brush> np-accent-pill: root.np-accent-bright.transparentize(0.84);
    out property <brush> np-accent-disc-hover: root.np-accent-bright.transparentize(0.7);
    out property <brush> np-accent-dim: root.np-accent-bright.transparentize(0.4);

    // `HeroBackdrop.chrome-text`/`.chip-fill`'s twins, not derived from `np-accent-pill`: the discs
    // and Up Next fill with that too, and the chips lightening must not take them along.
    in-out property <brush> np-chrome-text: #cba6f7;
    in-out property <brush> np-chip-fill: #cba6f733;

    in-out property <brush> np-viz: #cba6f7;

    // 4.5:1 on the blur and chroma-capped, the hue being the accent tier's to carry.
    in-out property <brush> np-on-backdrop: #c4c0cc;
    // 3:1, in a dimmer band of its own so the hierarchy survives every backdrop.
    in-out property <brush> np-on-backdrop-muted: #ada9b5;

    callback play-pause();
    callback next();
    callback previous();
    callback stop();
    callback seek(int);          // position in ms

    public function end-seek-run() {
        root.seek-run-target-ms = -1;
        root.seek-run-unsent = false;
        root.seek-run-ticks = 0;
    }

    // Every seek naming a position comes through here; only the run's own flush calls `seek` bare.
    public function seek-to(ms: int) {
        root.end-seek-run();
        root.seek(ms);
    }

    // Walks the run's target rather than the position: a seek lands a round trip later, so each
    // key repeat would aim at the same sample, and every one reopens the track down there.
    public function bump-seek(delta-ms: int) {
        if (root.duration-ms > 0) {
            root.walk-seek-run(delta-ms, root.duration-ms);
            // Leading edge, so a single tap still seeks on the keystroke; a repeat inside
            // the window only moves the target and the trailing edge sends where it ended.
            if (root.seek-run-ticks == 0) {
                root.flush-seek();
            }
            root.seek-run-ticks = root.seek-run-window-ticks;
        }
    }

    // Unlike a key repeat every step is sent, the scan interval being the rate limit. At either end
    // a step lands on the end again, so the position holds rather than playing on.
    public function scan-step(direction: int, step: int) {
        if (root.can-scan) {
            // Never below the run's own base, so a fast-forward started past the parking point
            // holds its place instead of jumping back to it.
            root.walk-seek-run(
                direction * root.scan-jump(step),
                max(root.scan-end-ms, root.seek-run-base()));
            root.flush-seek();
            root.seek-run-ticks = root.scan-window-ticks;
        }
    }

    public function flush-seek() {
        if (root.seek-run-unsent && root.seek-run-target-ms >= 0) {
            root.seek(root.seek-run-target-ms);
            root.seek-run-unsent = false;
        }
    }

    pure function seek-run-base() -> int {
        return root.seek-run-target-ms >= 0 ? root.seek-run-target-ms : root.position-ms;
    }

    function walk-seek-run(delta-ms: int, ceiling-ms: int) {
        root.seek-run-target-ms = clamp(root.seek-run-base() + delta-ms, 0, ceiling-ms);
        root.seek-run-unsent = true;
    }

    pure function scan-jump(step: int) -> int {
        return round(min(
            max(root.scan-jump-cap-floor-ms, root.duration-ms / root.scan-crossing-steps),
            root.scan-first-jump-ms * pow(root.scan-jump-growth, step)));
    }

    callback set-volume(int);    // 0..100, fires continuously during drag
    callback commit-volume();    // fires on slider release; persists to settings.json
    // Relative, so Rust applies it to the level it holds: `vm.volume` comes back a round trip
    // later, and a fast wheel would read the same stale level for several notches.
    callback step-volume(int /*delta*/);
    callback set-playback-speed(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite();
    callback set-current-rating(int /*rating*/);

    // For the bar's row menu, 0 where there is none yet; `ui::track_links` writes them.
    in-out property <int> track-album-id;
    in-out property <int> track-artist-id;
    in-out property <int> track-genre-id;

    // 0 = off, > 0 = duration timer, -1 = "End of current track". **Session-only.**
    callback set-sleep-timer(int /*minutes*/);
    // Rust clamps to [30 s, 2 h].
    callback set-sleep-timer-seconds(int /*seconds*/);
    // The armed duration, 0 for none: a preset is lit when `value * 60 == this`. End-of-track mode
    // rides `vm.sleep_at_track_end`.
    in-out property <int> sleep-timer-total-seconds: 0;
    // Outside `vm` for `position-ms`' reason, being written every second.
    in-out property <string> sleep-timer-remaining: "";

    // Bumped by every volume step, key or wheel: `VolumeTrigger` force-shows its readout off it and
    // `ShortcutScope` debounces the persist. **Slider drags don't bump it**, committing on release.
    in-out property <int> volume-step-tick: 0;

    // Ctrl (Cmd on macOS) is the fine step. A wheel over an unfocused window always takes the coarse
    // one on Linux: Wayland and winit's X11 backend send modifiers only to the focused window.
    public pure function volume-step(modifiers: KeyboardModifiers) -> int {
        return modifiers.control ? 1 : 5;
    }

    public function bump-volume(delta: int) {
        root.step-volume(delta);
        root.volume-step-tick += 1;
    }

    // What Slint's winit backend turns one wheel line into.
    property <length> wheel-notch: 60px;
    // Travel short of a notch, so a touchpad's stream of small deltas adds up to steps.
    property <length> wheel-carry: 0px;

    // **Accepts every event, an empty one included**: a `TouchArea` that rejects the wheel drops
    // its `has-hover` until the pointer moves (`slint-pitfalls.md`).
    public function wheel-volume(event: PointerScrollEvent) -> EventResult {
        if (event.delta-y == 0px) {
            return accept;
        }
        // A reversal answers at once rather than first paying back travel the other way.
        if ((event.delta-y > 0px) != (root.wheel-carry > 0px)) {
            root.wheel-carry = 0px;
        }
        root.wheel-carry += event.delta-y;
        let notches = floor(abs(root.wheel-carry) / root.wheel-notch);
        if (notches == 0) {
            return accept;
        }
        let direction = root.wheel-carry > 0px ? 1 : -1;
        root.wheel-carry -= direction * notches * root.wheel-notch;
        root.bump-volume(direction * notches * root.volume-step(event.modifiers));
        return accept;
    }
}
