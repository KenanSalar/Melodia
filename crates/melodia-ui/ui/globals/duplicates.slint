import { DuplicateRow } from "../models.slint";

// The duplicate finder's state, owned by `ui::duplicates`. `Dialog` imports this for its teardown
// and never the reverse. Every pick rule is Rust's, the rows only reporting where a click landed.
export global DuplicatesUi {
    in property <[DuplicateRow]> rows;
    // Raised by the opener, which writes it in Slint so Rust touches nothing inside the click.
    in-out property <bool> busy;
    in property <bool> failed;
    // Listed groups, so the dismissed ones only while they show.
    in property <int> group-count;
    in property <int> dismissed-count;
    in property <bool> show-dismissed;
    in property <int> picked-count;
    // Built in Rust and untranslated, as the Edit Tags size is.
    in property <string> picked-size;

    callback find();
    callback toggle(int /*copy id*/);
    callback keep-copy(int /*copy id*/);
    callback keep-folder(int /*copy id*/);
    callback suggest();
    callback clear-picks();
    callback set-show-dismissed(bool);
    callback dismiss-group(int /*header id*/);
    callback restore-group(int /*header id*/);
    // From every kind's teardown: a dialog raised as the finder fades out skips the finder's.
    callback released();
}
