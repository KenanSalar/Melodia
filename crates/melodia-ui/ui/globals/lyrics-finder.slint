import { PickRow } from "../models.slint";

// `loading` is the opener's and `searching` each search Rust sends, so the card opens at rest and
// eases into every later step. `lookup-off` asks before anything reaches lrclib.net.
// `rate-limited` and `failed` are `finder::SearchFailure`'s two arms.
export enum LyricsSearchPhase { loading, lookup-off, searching, listing, rate-limited, failed }

// Which of the track's own lyrics the panel shows ahead of the picked sheet, `none` where it would
// show the pick.
export enum LyricsMasking { none, sidecar, timed-tag, plain-tag }

// The Find lyrics dialog, owned by `ui::now_playing::lyrics::finder`. Every search goes out from
// Rust on the open and on Enter, never per keystroke.
export global LyricsFinder {
    in property <[PickRow]> rows;
    // Raised by the opener, so the dialog opens on Searching rather than on an empty list.
    in-out property <LyricsSearchPhase> phase;
    in-out property <string> query;
    // A `PickRow.index`, -1 for none.
    in-out property <int> picked: -1;
    // The picked sheet's lines; empty for an instrumental pick, which has none.
    in property <string> preview;
    in property <LyricsMasking> masking;
    in property <bool> applying;
    in property <bool> apply-failed;

    callback load();
    // The switch `lookup-off` offers, then the search it held back.
    callback turn-on-lookup();
    callback search(string /*query*/);
    callback picked-changed(int /*picked*/);
    callback apply(int /*picked*/);
    // From every kind's teardown, as `HeadphonePicker.released` is.
    callback released();
}
