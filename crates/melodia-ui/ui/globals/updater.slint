// In-app auto-update state, owned by `crates/melodia-views/src/ui/settings/updater_settings.rs` and
// `crates/melodia-views/src/ui/callbacks/updater/`. The `in-out` half is the check/install lifecycle, written directly
// from that directory and, for the background check, by `tasks::updater_daily`; the
// `in` half is capability, seeded once at startup by `updater_settings`. `UpdaterEvent`
// (`crates/melodia-app/src/services/updater/event.rs`) is a *parallel* channel carrying the same
// moments to the toast stack rather than a source these properties are projected from.
//
// The prefix is not cosmetic: Slint's codegen mangles a bare `Updater` with an internal `_NNNN`
// suffix and doesn't re-export it, so `crate::Updater` won't resolve. `notes-short` is plain text,
// `scripts/build-latest-json.py` stripping the Markdown server-side.
export global MelodiaUpdater {
    in-out property <bool> is-checking;
    in-out property <bool> up-to-date;
    in-out property <bool> update-available;
    in-out property <bool> restart-needed;
    in-out property <bool> is-installing;
    in-out property <int> download-progress;     // 0..100
    in property <string> current-version;
    in-out property <string> available-version;
    in-out property <string> notes-short;
    in-out property <string> error-message;
    in-out property <bool> auto-check-enabled;
    // A critical release suppresses "Skip this version", so it can't be permanently deferred; the
    // toast still dismisses for the session and comes back at the next daily check.
    in-out property <bool> is-critical;
    // A read-only install path (RPM / MSI / Homebrew): the section trades Download and Skip for a
    // hint pointing at the package manager. Seeded once at startup.
    in property <bool> system-managed;
    // False on a source build, where there is no update to offer at all — the section doesn't draw
    // and stops matching the settings search. Defaults true so a Slint-only preview keeps it.
    in property <bool> updates-supported: true;
    // Picks that hint string: "linux" | "windows" | "macos", off `cfg!(target_os)` at startup. A
    // string rather than an enum keeps the Slint side free of conditional compilation and lets the
    // hint resolve inline, so it re-translates on a locale switch.
    in property <string> platform-kind;

    callback check();
    callback install();
    callback restart();
    // Persists the version into `settings.updates.skipped_release`; closing the toast is the other
    // thing — "remind me later".
    callback skip();
    callback auto-check-changed(bool);
}
