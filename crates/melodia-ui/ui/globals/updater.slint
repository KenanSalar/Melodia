// The `in-out` half is the check and install lifecycle, painted by `ui::callbacks::updater` (the
// daily check through its `check_painter`); the `in` half is capability, seeded once at startup.
// `UpdaterEvent` carries the same moments to the toasts beside these, not as their source.
//
// Prefixed because Slint's codegen mangles a bare `Updater` with an internal `_NNNN` suffix and
// doesn't export it.
export global MelodiaUpdater {
    in-out property <bool> is-checking;
    in-out property <bool> up-to-date;
    in-out property <bool> update-available;
    in-out property <bool> restart-needed;
    in-out property <bool> is-installing;
    in-out property <int> download-progress;     // 0..100
    in property <string> current-version;
    in-out property <string> available-version;
    // Plain text, `scripts/build-latest-json.py` stripping the Markdown.
    in-out property <string> notes-short;
    in-out property <string> error-message;
    in-out property <bool> auto-check-enabled;
    // Hides "Skip this version", so a critical release can't be deferred for good; the toast still
    // dismisses for the session and returns at the next daily check.
    in-out property <bool> is-critical;
    // A read-only install (RPM, MSI, Homebrew): Download and Skip give way to a hint pointing at
    // the package manager.
    in property <bool> system-managed;
    // False on a source build, where the section neither draws nor matches the settings search.
    in property <bool> updates-supported: true;
    // "linux" | "windows" | "macos", picking the hint. A string so the hint resolves inline and
    // re-translates on a locale switch, with no conditional compilation on the Slint side.
    in property <string> platform-kind;

    callback check();
    callback install();
    callback restart();
    // Persists `settings.updates.skipped_release`; closing the toast is "remind me later".
    callback skip();
    callback auto-check-changed(bool);
}
