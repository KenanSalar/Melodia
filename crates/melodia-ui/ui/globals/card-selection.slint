// Multi-selection for every card grid. Every call carries the asking grid's scope, which is the
// guard against one grid reading another's set (`ui::callbacks::card_selection`).
//
// **It still goes back on section leave**, which the scope guard neither covers nor could. A set
// the user can no longer see still answers `Selection.any-live()`, so it swallows the Escape meant
// for the page they moved to, and it comes back live on re-entry, where a card has no second
// activation and every click picks instead of opening. One `clear()` in each page's leave answers
// for every scope on it.
//
// **Browse is deliberately not here.** Its cards are its list rows, reading `Browse.selected-ids`,
// so a mode toggle keeps the selection.
export global CardSelection {
    in-out property <[int]> selected-ids;
    in-out property <string> scope;
    // The argument that re-runs `selected`, as `covers-generation` does a cover.
    in property <int> generation;

    // Per card, so a selection change re-evaluates one bool per mounted card instead of
    // restamping a chunk row and rebuilding every card in it.
    pure callback selected(string /*scope*/, int /*id*/, int /*generation*/) -> bool;

    // No card index, a chunked card having no flat position; Rust anchors a range on the id.
    callback pick(string /*scope*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    // Scope-guarded, so a grid selects only its own.
    callback select-all(string /*scope*/);
    callback clear();

    // Pure Slint, its two inputs dirtying on their own, so it needs no generation. One home for
    // the scope comparison.
    public pure function count-in(s: string) -> int {
        return root.scope == s ? root.selected-ids.length : 0;
    }

    public pure function any-in(s: string) -> bool {
        return root.count-in(s) > 0;
    }
}
