// What every Copy entry in the tree does.
//
// **Stateless, as `CardActions` is.** A menu holds ids rather than text, a selection's rows being
// mostly unmounted, so Rust resolves the text. An unknown `field` token copies nothing.
export global CopyActions {
    // A `TrackCopyFields` token. One line per track, in the order handed over.
    callback copy-tracks(string /*field*/, [int] /*track_ids*/);
    // `kind` is an `EntityKind` token. "name" for every kind, plus "artist" and "artist-name" for
    // an album.
    callback copy-entities(string /*kind*/, string /*field*/, [int] /*entity_ids*/);
    // Text Slint already holds: a history line, a stream URL, a folder's path.
    callback copy-text(string);
}
