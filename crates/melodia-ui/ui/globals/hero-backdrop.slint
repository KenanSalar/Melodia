// The hero bands' tier, off the same `ui/backdrop.rs` answer as `Player.np-*`, whose notes apply
// here as written. **One global for six views**, only one hero being mountable at a time.
export global HeroBackdrop {
    // Alpha baked in — see `np-scrim`.
    in-out property <brush> scrim: #0a0a0e73;

    // **`floor-start` also fills the mosaic heroes' square**, populated or not, so square and
    // surface move together on either arm.
    in-out property <color> floor-start: #2b2135;
    in-out property <color> floor-end: #14101a;

    // `Player.np-tint-*`'s twin, the defaults agreeing with that block and `AuroraBackdrop`'s.
    in-out property <color> tint-1: #3a2d4a;
    in-out property <color> tint-2: #2d3a4a;
    in-out property <color> tint-3: #4a2d3a;

    in-out property <image> dither;

    // 3:1 against the composite on the blur; on the aurora a neutral ink at partial alpha, the wash
    // beneath supplying the colour.
    in-out property <brush> chrome: #cba6f7;

    // A coverless hero square: `chrome` on the blur, `Theme.accent` on the aurora, where `chrome`'s
    // neutral ink reads as a pale slab. Reached through Rust, so the hero owns no `Theme.*` binding.
    in-out property <brush> placeholder: #cba6f7;

    // Solved in Rust, the two arms wanting different weights (`ui::backdrop`'s
    // `AURORA_CHROME_TEXT_ALPHA` / `AURORA_CHIP_FILL_ALPHA`).
    in-out property <brush> chrome-text: #cba6f7;
    in-out property <brush> chip-fill: #cba6f733;

    // For `LibraryTabBand`, which fades by brush, its chip strip staying mounted. **`transparentize`,
    // not `with-alpha`**, so the result stays a fraction of whatever Rust solved.
    public pure function chip-fill-at(alpha: float) -> brush {
        return root.chip-fill.transparentize(1.0 - alpha);
    }

    // The back disc. Named for one reader each because `IconButton`'s default `hover-bg` is an
    // opaque `Theme.surface0`, which flashes grey over the blur.
    out property <brush> disc-fill: root.chrome.transparentize(0.84);
    out property <brush> disc-hover: root.chrome.transparentize(0.7);

    in-out property <brush> on-backdrop: #f0eef5;
    in-out property <brush> on-backdrop-muted: #c9c5d3;

    // The mosaic heroes' square, the only bordered hero surface. A `Theme.border` hairline vanishes
    // over the blur's dark floor and rings hard over a light aurora.
    out property <brush> tile-edge: root.on-backdrop.transparentize(0.88);
}
