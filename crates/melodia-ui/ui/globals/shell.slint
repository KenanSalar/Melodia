import { Theme } from "../theme.slint";
import { Settings } from "../settings.slint";

// The frameless window's resize grab under the pointer. `ResizeRing` is the only writer.
export enum ResizeZone { none, north, south, west, east, north-west, north-east, south-west, south-east }

// Named by the host, since a double press on the titlebar maximizes and one on the miniplayer only
// moves it. Each region is the only writer of its own name.
export enum DragRegion { none, titlebar, miniplayer }

// The custom titlebar's state, Slint only rendering it (`ui/window_chrome/`); dragging and resizing
// are the winit layer's, a grab started from Slint leaking. Each `restart-*` persists and respawns,
// so a gate read once at startup is read again.
export global WindowChrome {
    // Off a winit `Resized` subscription, so the icon stays right under tiling shortcuts.
    in property <bool> is-maximized;

    // What the OS frame adds to the client on each axis, held across the frameless span for the
    // miniplayer's exit edge and the window's floor; `geometry::frame_allowance` argues the step.
    in property <length> frame-allowance-w;
    in property <length> frame-allowance-h;

    // Win32's invisible resize borders, which a dropped frame hands to the client. Zero elsewhere,
    // and written only while a frame stands.
    in property <length> frame-margin-left;
    in property <length> frame-margin-right;
    in property <length> frame-margin-bottom;

    // The shell's rect, its top always at 0. Mirrored by `AppWindow` because a tooltip keeps its
    // pill inside it and cannot reach the root's geometry.
    in-out property <length> shell-x;
    in-out property <length> shell-width;
    in-out property <length> shell-height;
    out property <length> edge-clearance: Theme.pad-xs;

    // The grid cover tier is sized off this rather than the window (`grid_prewarm::cover_size`).
    in-out property <length> content-panel-width;

    // Unfocused is its own brush because Windows' accent borders go neutral on an inactive window.
    in property <brush> border-color;
    in property <brush> border-color-unfocused;

    // The full UI chrome's ground, so the sidebar, the bar and the gutter swap together. The
    // KDE-only unfocused tint mirrors the fade an OS titlebar does, so it needs the native titlebar
    // under it, and the toggle is kept across a titlebar flip. No `animate` on any reader: the OS
    // swaps its colour instantly.
    out property <brush> mantle: (Settings.match-unfocused-bg && Theme.use-native-titlebar
        && !Theme.window-focused) ? Theme.mantle-unfocused : Theme.mantle;

    // `supported` hides a pin that would do nothing (bare Wayland, GNOME without window-calls).
    // `active` is written optimistically on click; Rust reverts it on failure.
    in property <bool> always-on-top-supported;
    in-out property <bool> always-on-top-active;

    callback minimize();
    callback toggle-maximize();
    // A miniplayer is a window size, so leaving it is a resize back to the full player's last
    // geometry, which Rust holds across a relaunch too.
    callback restore-full-player();
    callback close-window();
    callback toggle-always-on-top();
    // Both kept in cells the winit `MouseInput` filter reads at a press, the resize zone first,
    // before it starts an OS-level move or resize.
    callback drag-region-changed(DragRegion);
    callback resize-zone-changed(ResizeZone);
    // Rust stamps the moment: a client step counts as the frame only while this change is recent.
    callback frame-changed();
    callback restart-app();
    callback restart-tray();
    callback restart-backdrop();
    // Rust to Rust: the winit `Resized` filter is installed before the view handles exist that
    // `boot::ui_setup`'s retune needs. Nothing in Slint reads it.
    callback display-changed();
    // The same retune for a panel toggle or a sidebar drag, which resize no window.
    callback content-panel-resized();
    // Windows only, Rust to Rust: winit `ThemeChanged` and every focus gain, so a change winit
    // never reported costs a click back into the window.
    callback recheck-system-theme();
}

// One mount grown or rearranged across all three, never swapped.
export enum MiniLayout {
    // For a window too short for either of the others: one row, the controls on the title's line.
    strip,
    // The artwork beside the title and controls, the captions opening above as there is room.
    card,
    // The card with its captions all the way open and room for a panel under it.
    column,
}

// `MiniPlayerSwitch` owns both answers. **Entry and exit are resize-only.**
export global MiniPlayer {
    in-out property <bool> active: false;
    in-out property <MiniLayout> layout: MiniLayout.strip;

    // Leaves a tall window's height to the panel.
    out property <length> art-cap: 180px;

    // The row tier's decode size, so the strip draws its cover unscaled.
    out property <length> art-floor: 48px;

    // Spelled rather than measured: the row is behind an `if` and opens by what the rows under it
    // leave, not by its content.
    out property <length> captions-height: 32px;

    // Also the panel's whole floor, so the list comes in the moment there is room for the gap.
    out property <length> panel-gap: Theme.pad-sm;

    // The strip's footprint, which Rust also floors a restored window at.
    out property <length> window-min-width: 350px;
    out property <length> window-min-height: 90px;

    // **These restate the view's layout rather than measure it**: `room-grow` sizes the controls
    // and the artwork takes the width they leave, so reading either back would close a loop.

    // Everything the card's height holds but the artwork.
    out property <length> art-rows: 48px;
    // The same across the artwork's row: the padding, the row's inset and the gap to the title.
    out property <length> art-row-insets: 20px;
    // The smallest artwork that seats the controls under the title.
    out property <length> stacked-art: 70px;
    // The pin collapses where the window manager gives no way to keep a window on top.
    out property <length> controls-min-width: WindowChrome.always-on-top-supported ? 220px : 190px;
    out property <length> controls-max-width: WindowChrome.always-on-top-supported ? 276px : 238px;

    // How far a roomy card has opened the controls past the strip's sizes, by whichever axis has
    // less to give. It spends only the surplus a capped artwork has no use for, so the cover stays
    // at its cap the whole way.
    out property <float> room-grow: min(
        clamp((WindowChrome.shell-height - root.art-rows - root.stacked-art)
            / (root.art-cap - root.stacked-art), 0, 1),
        clamp((WindowChrome.shell-width - root.art-cap - root.art-row-insets
            - root.controls-min-width) / (root.controls-max-width - root.controls-min-width),
            0, 1));

    // 0 = Windows, 1 = macOS, 2 = KDE, `Theme.titlebar-button-style`'s tokens. A setting of its
    // own, the miniplayer drawing captions under the native titlebar too.
    in property <int> button-style: 0;

    // Whether this surface mounts the backdrop already chosen, which can move on a click. **Not
    // `Theme.aurora-backdrop`**, which picks the stack and is restart-gated. Off by default.
    in-out property <bool> backdrop-shown: false;

    callback active-changed(bool);
    callback layout-changed(MiniLayout);
    // Keeps the width: the switch settling a resize let go with the captions part way open.
    callback request-height(length);
    callback set-backdrop-shown(bool);
}

// The winit wheel route into a composite view, whose inner list swallows the wheel at its edge.
// **A page whose sections become tabs needs none of this**: tabs first.
export global CompositeScroll {
    in-out property <bool> hovered: false;
    // Logical px, +y scrolling up as `flickable.rs` does. Rust **adds** the delta and then bumps the
    // tick, which survives Slint coalescing several events into one `changed`.
    in-out property <length> wheel-dy: 0px;
    in-out property <int> wheel-tick: 0;

    // **Every content-view switch owes this call**, a view destroyed under the pointer leaving
    // `hovered` set over the next. A `public function` because a callback has one handler slot.
    public function reset() {
        root.hovered = false;
        root.wheel-dy = 0px;
    }
}
