import { Theme } from "../theme.slint";
import { Settings } from "../settings.slint";

// Window-shell plumbing: the chrome the OS frame doesn't draw, the responsive miniplayer swap, and
// the two globals keeping pointer state coherent when a view switch unmounts what was under it.

// Which of the frameless window's resize grabs the pointer is over, named by the edge or corner it
// moves. `ResizeRing` is the only writer.
export enum ResizeZone { none, north, south, west, east, north-west, north-east, south-west, south-east }

// The custom titlebar, owned by `ui/window_chrome/` with Slint as the dumb renderer.
// `is-maximized` comes off a winit `Resized` subscription, so the icon stays right under tiling
// shortcuts that bypass our buttons. **Window dragging and resizing are not handled inside Slint** — a
// `TouchArea` calling `drag_window()` leaks its mouse grab and wedges the window; Rust intercepts
// the press at the winit layer. `restart-app` persists then respawns for the titlebar toggle;
// `restart-tray` and `restart-backdrop` mirror it so the startup gates each reads
// once — `main.rs`'s tray install, and `boot::ui_setup::apply_backdrop_style` — re-evaluate.
export global WindowChrome {
    in property <bool> is-maximized;

    // What the OS frame adds to the client area on each axis. Rust writes it only while a frame is
    // up, so the reading from before the miniplayer dropped the frame survives for its exit edge.
    // The window's minimum reads it too, while the frame stands.
    in property <length> frame-allowance-w;
    in property <length> frame-allowance-h;

    // The part of that frame outside the edges it draws: Win32's invisible resize borders, which a
    // dropped frame hands to the client. Zero elsewhere, and written only while a frame stands.
    in property <length> frame-margin-left;
    in property <length> frame-margin-right;
    in property <length> frame-margin-bottom;

    // The frameless outline's colour, resolved from the Window Border Color pick. Unfocused is its
    // own brush because Windows' accent borders go neutral on an inactive window; for any other pick
    // the two are the same.
    in property <brush> border-color;
    in property <brush> border-color-unfocused;

    // The mantle behind the full UI's chrome: the sidebar, the now-playing bar and the gutter
    // beside the content panel, so they swap together. The KDE-only unfocused tint mirrors the fade
    // an OS-drawn titlebar does, which is why it also gates on `use-native-titlebar`: under our own
    // chrome there is nothing to match, and the toggle is kept across a titlebar disable so it
    // survives a re-enable. No `animate` on any reader, since the OS swaps its colour instantly.
    out property <brush> mantle: (Settings.match-unfocused-bg && Theme.use-native-titlebar
        && !Theme.window-focused) ? Theme.mantle-unfocused : Theme.mantle;

    // `supported` gates the pin button so bare-Wayland and GNOME-without-window-calls users don't
    // see a dead control. `active` is written optimistically on click; Rust reverts it on failure.
    in property <bool> always-on-top-supported;
    in-out property <bool> always-on-top-active;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback toggle-always-on-top();
    // Mirrored into an atomic the winit `MouseInput` filter checks before starting an
    // OS-level window move.
    callback drag-region-hover-changed(bool);
    // The same for `ResizeRing`'s grabs, kept in a cell the filter checks first, before an OS-level
    // resize.
    callback resize-zone-changed(ResizeZone);
    callback restart-app();
    callback restart-tray();
    callback restart-backdrop();
    // Fired by the winit `Resized` filter, handled in `boot::ui_setup`. Rust to Rust through a
    // global because the two ends are far apart: the filter is installed before the view handles
    // exist, and the handler needs all seven of them. Nothing in Slint reads it.
    //
    // Every cover tier's capacity and decode size are answers about the window, and they were
    // read once after `app.show()` — so a window maximized afterwards mounted more cards than
    // its tier could hold and left the overflow on placeholders.
    callback display-changed();
    // Windows only, the same Rust-to-Rust shape: fired by the winit `ThemeChanged` and focus-gain
    // arms, handled in `ui::appearance`, which re-reads the default app mode and repaints a System
    // variant painted for the other one. Focus gain too, as the border colour's refresh does, so an
    // event winit never sent costs no more than a click back into the window.
    callback recheck-system-theme();
}

// The compact player replacing the full UI once the window shrinks past a threshold, and the
// `square` variant for a window nearly as tall as it is wide. **Entry and exit are resize-only.**
export global MiniPlayer {
    in-out property <bool> active: false;
    in-out property <bool> square: false;

    // Whether the miniplayer paints the artwork backdrop and its solved ink instead of flat chrome.
    // **Not `Theme.aurora-backdrop`**, which decides which of the two stacks every colour tier is
    // solved for and is restart-gated for exactly that reason; this only says whether this surface
    // mounts the one already chosen, which is why it can move on a click. Off by default, so an
    // install that never presses the button keeps the look it has.
    in-out property <bool> backdrop-shown: false;

    callback active-changed(bool);
    callback square-changed(bool);
    callback set-backdrop-shown(bool);
}

// Bridges the winit `MouseWheel` filter to whichever *composite* view is mounted — Artist Detail
// and Browse. Slint's inner `ListView` swallows the vertical wheel at its scroll edge and pure
// Slint can't fix it without breaking row clicks, so the winit layer intercepts vertical-dominant
// wheel over the region. **A page whose sections become tabs needs none of this** — tabs first.
export global CompositeScroll {
    // Set by the mounted view's hover sentinel, cleared by `reset()` on any view switch.
    in-out property <bool> hovered: false;
    // Logical px, +y scrolling up to match `flickable.rs`'s sign. Rust **adds** the delta then bumps
    // the tick, surviving Slint coalescing several events into one `changed` firing. Nothing paints
    // either, so the filter must also request the frame.
    in-out property <length> wheel-dy: 0px;
    in-out property <int> wheel-tick: 0;

    // **Every content-view switch owes this call**, Slint destroying the outgoing view with no
    // unmount hook, so nothing else clears the flag its hover sentinel left set. Miss one and the
    // filter keeps eating vertical wheel on the *new* view until the next mouse move. A `public
    // function` for the `Dialog.closed-teardown()` reason: a callback has one handler slot.
    public function reset() {
        root.hovered = false;
        root.wheel-dy = 0px;
    }
}

// Lets a popup trigger keep its hover background painted while its `PopupWindow` is open: Slint
// 1.16 has no `closed` callback, `has-hover` flips false the moment the popup steals input, and no
// scrim can catch the dismissing click either. The contract:
//   - a trigger writes its own discriminator to `id` right before `show()` and binds
//     `force-bg: PopupHighlight.id == "<my-id>"`. A string, not a bool, so triggers can't cross-talk
//   - the winit layer clears `id` on every mouse Release; an Esc close leaves it until the next click
//   - popup-internal areas that *don't* close the popup re-set `id` from `pointer-event(up)`
//   - areas that *do* close it clear `id` beside `close()`, belt-and-braces with winit
//
// `row-ctx-id` is the track id of the row whose right-click menu is open, -1 for none, gating the
// `FocusLossWatcher` inside `TrackListRowItem`. The same Release path clears it, else a
// click-outside blocks re-opening the row.
//
// `queue-ctx-index` is the queue sheet's own key and holds a **play-order index**, not an id: a
// queue may hold one track twice, where a track list cannot, so an id there would gate two rows'
// watchers onto one popup. Keeping it separate is what lets `row-ctx-id` go on meaning "track id"
// everywhere. Cleared on the same Release.
export global PopupHighlight {
    in-out property <string> id: "";
    in-out property <int> row-ctx-id: -1;
    in-out property <int> queue-ctx-index: -1;
}
