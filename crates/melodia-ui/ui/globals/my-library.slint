// Only what the page owns, each tab keeping its own global. **No `detail-open` here**: it would make
// this a third globals file importing siblings, so `views/my-library-view.slint` derives it.
export global MyLibrary {
    // **`tab-count` is the sole definition of how many tabs there are** (`ui-patterns.md`).
    out property <int> tab-songs: 0;
    out property <int> tab-albums: 1;
    out property <int> tab-artists: 2;
    out property <int> tab-genres: 3;
    out property <int> tab-playlists: 4;
    out property <int> tab-count: 5;

    in-out property <int> tab-idx: 0;
    // **Fires after the bar has moved `tab-idx`.**
    callback tab-changed(int);
    // For the arrivals that aren't picks, a cross-tab drill or a Mouse-4/5 walk, which persist the
    // index but must not clear the filter.
    callback persist-tab-idx(int);

    // Routed by `ui::my_library::filter` to whichever of nine surfaces is mounted.
    in-out property <string> filter;
    in-out property <int> blur-search-tick: 0;
    callback filter-changed(string);
    // Rust *reseats* the box rather than clearing it (`filter::sync_box`). Fired by five mirrors,
    // the four detail ids and `tab-idx`.
    callback detail-scope-changed();

    callback back();

    // **The nav index left the page**, which no gate can answer: only the mounted tab's fires, and
    // a sixth would go false → false behind Now Playing. Rides `changed watched-nav-idx`.
    callback page-active-changed(bool);

    // The band has finished collapsing. The teardown waits for it so the morph doesn't collapse
    // a placeholder; `release_collapsed_hero` hands back per id.
    callback hero-collapsed();
}
