import { LiftedRun, QueueRow } from "../models.slint";

export global Queue {
    in-out property <[QueueRow]> rows;
    // Rows derive `playing` from it, so the highlight flips without a model rewrite.
    in property <int> current-index: -1;
    // A Slint expression can't iterate a model, so Rust keeps this for the header's label.
    in property <int> selected-count: 0;
    // **Deduped by track id**, in display order: a track queued twice is two picks, which the
    // count above counts, and a batch must still act on it once.
    in property <[int]> selected-ids;
    // The docked panel the user asked for, and what persists.
    in-out property <bool> open;
    // Session-only, so a narrow launch with the panel saved open shows nothing until asked.
    in-out property <bool> overlay-open;
    // `shown`, `floating` and `fits` are written by `AppWindow` alone, a global being unable to
    // watch its own properties and only the root seeing the shell's row and the miniplayer swap.
    in-out property <bool> shown;
    in-out property <bool> floating;
    in-out property <bool> fits;
    // 0 is the default width, so changing `Theme.queue-panel-default-w` reaches everyone who never
    // dragged the edge.
    in-out property <length> panel-width: 0px;
    // For the winit filter to read at a press.
    in-out property <bool> pointer-in;
    // Written by the winit filter ahead of any element, and handed back by a row's menu as it
    // closes, its popup having hidden that press from `pointer-in`.
    in-out property <bool> keys-owned;

    // Against the panel's own tier, so hiding the panel frees only its buffers, backed by the row
    // tier so a cover both draw is one allocation.
    pure callback request-cover(/* artwork-path */ string, /* generation */ int) -> image;
    in property <int> covers-generation: 0;

    // In play order.
    callback reorder(int /*from*/, int /*to*/);
    // Gathers every picked row in front of play-order slot `slot`.
    callback move-picks(int /*slot*/);
    // Asked by a press on a picked row; only Rust holds the whole list.
    callback picked-run() -> LiftedRun;
    // Another list's drag let go over the rows: what Add to Queue on it would queue, in front of
    // play-order slot `slot`.
    callback drop-in(string /*kind*/, [int] /*ids*/, int /*slot*/);
    callback remove(int /*play_order_index*/);
    // Every picked row, and no other copy of their tracks.
    callback remove-selected();
    callback skip-to(int /*play_order_index*/);
    callback clear-queue();
    // Rust's: a press under Now Playing closes it to bring the panel up, and `Nav` is not this
    // file's to import.
    callback toggle();
    // A narrow window's ✕ leaves the docked panel to come back with the room. The picks and the
    // keys go too, so neither waits on a panel nobody can see.
    public function close() {
        if (self.fits) {
            self.open = false;
        }
        self.overlay-open = false;
        self.keys-owned = false;
        self.clear-selection();
    }
    // Plain replaces, ctrl toggles, shift extends; the anchor lives in Rust.
    callback toggle-select(int /*idx*/, bool /*ctrl*/, bool /*shift*/);
    callback clear-selection();
    callback select-all();

    // The track lists' contracts: Rust persists, then patches the rows holding those ids.
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);

    callback shown-changed(bool);
}

// Up Next, its own global rather than more of the monolithic `Player`.
export global NowPlaying {
    // The next N tracks in play order, current excluded; Rust does the wrap-around.
    in-out property <[QueueRow]> up-next-rows;

    // No generation, unlike `Queue`'s: nothing warms this tier behind the list's back.
    pure callback request-cover(/* artwork-path */ string) -> image;

    // The play-order index of `up-next-rows[0]`.
    in property <int> base-index: 0;

    // Under repeat-all the list wraps, so a row's play-order index is
    // `mod(base-index + idx, queue-length)`.
    in property <int> queue-length: 0;

    // In the list's own rows; Rust maps them onto play order, refusing a move across the wrap.
    callback reorder(int /*from-row*/, int /*to-row*/);

    // Drives the one-shot slide, at rest from `slide-frames` on. Reset to 0 **only** on a real
    // track change, and on the global so it lands on the same render as the model swap: through a
    // `changed` handler it lands a frame late, after the advanced list has painted at rest once.
    in-out property <int> slide-phase: 18;

    // 1 forward, -1 back. Written **before** `slide-phase` is reset, so one render takes both.
    in-out property <int> slide-direction: 1;

    // Drawn beside the list for the slide. Left hidden where there is nothing to draw, as on
    // skip-to and a queue rebuild.
    in-out property <QueueRow> outgoing-row;
    in-out property <bool> outgoing-visible: false;
}
