// The one arithmetic two scrollers share, and the reason it is worth a global for a single
// function: both the queue sheet and the draggable track list seat a viewport by hand, and the
// copy each kept came with a comment pointing at the other.
export global ListTravel {
    // Pins an offset inside a list's own travel. **Not `clamp()`**: a list shorter than its
    // viewport puts its lower bound *above* its upper one, and `clamp` expands to
    // `max(lo, min(v, hi))`, which then hands back the positive lower bound and shoves every row
    // down the screen. Capping both arguments at 0 resolves that case to 0 instead, which is also
    // what leaves a list with nothing to scroll where it is.
    public pure function pin(y: length, visible: length, viewport: length) -> length {
        return max(min(0px, visible - viewport), min(0px, y));
    }
}
