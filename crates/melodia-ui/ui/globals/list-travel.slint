// For every scroller that seats its viewport by hand.
export global ListTravel {
    // **Not `clamp()`**: a list shorter than its viewport puts its lower bound above its upper one,
    // and `clamp` then hands back that positive bound and shoves every row down the screen. Capping
    // both at 0 resolves it to 0, which also leaves a list with nothing to scroll where it is.
    public pure function pin(y: length, visible: length, viewport: length) -> length {
        return max(min(0px, visible - viewport), min(0px, y));
    }
}
