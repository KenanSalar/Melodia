// Every callback here applies to the live player *and* persists, the drag pairs on release as
// `set-volume` and `commit-volume` split it.

// `band-gains` is dB per band, low to high. `preset-idx`'s last entry is the synthetic "Custom" a
// hand-edited band shows. **Every bound is seeded from the Rust consts**, so nothing can drift.
export global Equalizer {
    in-out property <bool> enabled;
    in-out property <[float]> band-gains;
    in-out property <int> preset-idx;
    in property <float> min-gain;
    in property <float> max-gain;

    // dB of headroom for boosting without clipping.
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    callback set-band(int /*band index*/, float /*gain dB*/);
    callback commit-band(int /*band index*/, float /*gain dB*/);
    callback select-preset(int /*dropdown index*/);
    callback reset();
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// `mode-idx` matches `player::replaygain::RgMode`.
export global ReplayGain {
    in-out property <bool> enabled;
    in-out property <int> mode-idx;
    in-out property <bool> prevent-clipping;
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    callback set-mode(int /*0 = Track, 1 = Album*/);
    callback set-prevent-clipping(bool);
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// `enabled` decides only whether the strip mounts; `set-active`, off the mount, arms the tap.
//
// `style` and `style-idx` are one choice in two shapes: the strip mounts on the key, so reordering
// the picker can't repoint an install, and the Settings chips need the index.
//
// **`window-shown` and `dormant` carry different certainty on purpose.** The OS reports every hide
// and the show that undoes it, so the first may stop the Timer; nothing wakes the second, which is
// inferred, so it only slows it.
export global Visualizer {
    in-out property <bool> enabled: true;
    in-out property <string> style: "bars";
    in-out property <int> style-idx;
    // The token that re-runs `bars-figure` when the bands change what the bars draw.
    in property <int> bars-generation;
    in property <string> wave-path;
    // Only the strip's width ceiling reads it, the figure carrying its own band count.
    in property <int> band-count;
    in property <bool> idle: true;
    in property <bool> window-shown: true;
    in property <bool> dormant;

    callback set-enabled(bool);
    callback set-style(int);
    // Fired by `AppWindow`'s mirror, the strip having no unmount hook.
    callback set-active(bool);
    // Fired by whoever lowers `window-shown`; `ui::visualizer::wire_window_hidden` says why the
    // tick can't cover it.
    callback window-hidden();
    // The width rides along for the trace, whose column count follows it.
    callback tick(bool /*is-playing*/, float /*strip width, logical px*/);
    // The style rides along for its anchor, so a Bars↔Mirrored pick redraws a strip at rest.
    pure callback bars-figure(
        int /*generation*/,
        int /*style-idx*/,
        float /*strip x, logical px from the window's left*/,
        float /*strip y, logical px from the window's top*/,
        float /*strip width, logical px*/,
        float /*strip height, logical px*/,
    ) -> string;
}
