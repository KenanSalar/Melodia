// What a card's right-click menu does, for every entity kind.
//
// **Stateless**: each call carries its `kind` and ids, so nothing goes stale between grids. `kind`
// is an `EntityKind` token ("album", "artist", "genre", "playlist", "track"), resolved to track
// ids in one query. Browse's folder cards go through `Browse`.
export global CardActions {
    // **Replaces the queue.** A card click opens its detail, so this is a grid's only play path.
    // A lone track card's Play routes through `CardContextMenu.play-single` instead, its grid
    // playing the displayed set; a selection of them comes here.
    callback play(string /*kind*/, [int] /*entity_ids*/);
    callback shuffle(string, [int]);
    callback play-next(string, [int]);
    callback add-to-queue(string, [int]);
    // Takes the state to write rather than toggling: a card is a set, which may be half
    // favourited (`ui-patterns.md`).
    callback set-favorites(string /*kind*/, [int] /*entity_ids*/, bool /*favorite*/);

    // The menu writes the dialog's chrome first, where `@tr` reaches it; Rust adds the resolved
    // track ids.
    callback create-playlist-from(string, [int]);
    callback add-to-playlist(string, [int]);
    // The title arrives already translated for the same reason.
    callback edit-tags(string, [int], string /*title*/);
}
