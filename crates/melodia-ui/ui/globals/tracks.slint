import { TrackListRow, TrackColumns, BrowseFolderRow, BrowseCardGridRow, BreadcrumbRow } from "../models.slint";

// `rows` is a paged model (`ui::paged_rows`), so `apply-filter` and `request-sort` reload its ids
// in SQL.
export global Tracks {
    in-out property <[TrackListRow]> rows;
    // `-1` until fetched; see `Albums.total-count`.
    in-out property <int> total-count: -1;   // pre-filter count
    in-out property <string> filter;
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // No default here: Rust writes it before the window shows, `ui::track_list_view` owning every
    // page's defaults.
    in-out property <TrackColumns> track-columns;

    callback request-sort(string /*field*/);
    callback apply-filter(string);
    callback play-row(int /*track_id*/, int /*index_in_filtered*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback request-refresh();
    // Rust skips library refreshes while hidden and re-fetches once on re-enter.
    callback section-active-changed(bool);

    // Rust stamps each row's `selected`, a Slint expression being unable to iterate a model.
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();

    callback toggle-column(string /*column_id*/);
}

// `ui::browse` owns the models. **A disk-only file**, in a library folder but not the database,
// arrives with `id == 0` and `enabled == false` and draws dimmed and inert. `loading` gates the
// empty state so a stale "Empty folder" can't flash mid-drill. Both presentations read `folders`
// and `rows`; only `card-rows` is the grid's alone.
export global Browse {
    in-out property <string> current-path;             // "" = root (library list)
    in-out property <[BrowseFolderRow]> folders;
    in-out property <[TrackListRow]> rows;
    in-out property <[BreadcrumbRow]> breadcrumbs;
    in-out property <bool> loading;
    in-out property <bool> can-go-back;
    in-out property <string> error-message;            // "" = no error
    in-out property <bool> has-library-folders;        // false → root empty-state CTA

    in-out property <TrackColumns> track-columns;

    // Sorted in memory rather than re-queried: the list mixes disk-only and DB files, so
    // there is no query that returns it.
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";

    // Disk-only rows are never selectable.
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // Persisted as `browse_view_mode` and clamped through `clamp_tab` against `view-mode-count`,
    // the sole definition of how many presentations there are.
    in-out property <int> view-mode: 0;
    out property <int> mode-list: 0;
    out property <int> mode-card: 1;
    out property <int> view-mode-count: 2;

    in-out property <[BrowseCardGridRow]> card-rows;
    in-out property <int> columns: 1;
    // The repaint token, read as `RowCovers.generation` is.
    in-out property <int> covers-generation: 0;

    // The cards read the list's `selected-ids`, so a mode toggle keeps the selection. A chunk row
    // can't carry a per-card flag cheaply, so a card asks, against a generation Rust bumps on every
    // selection write.
    in-out property <int> selection-generation: 0;
    pure callback is-card-selected(int /*track_id*/, int /*generation*/) -> bool;

    callback open-folder(string /*path*/);
    // A folder card's menu, here because a folder is named by a path where `CardActions` takes ids.
    // Recursive, where the view lists a folder's own files (`library::browse::folder_track_ids`).
    callback play-folder(string /*path*/);
    callback play-folder-next(string /*path*/);
    callback queue-folder(string /*path*/);
    callback reveal-folder(string /*path*/);
    callback go-back();
    callback navigate-to(string /*absolute-path*/);    // breadcrumb segment click
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int] /*track_ids*/);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback select-all();
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Rust's, so one place knows which surface is mounted.
    callback toggle-view-mode();
    callback columns-changed(int /*columns*/);
    // Against the shared grid tier.
    pure callback request-card-cover(string /*artwork_path*/, int /*generation*/) -> image;
    // As `Tracks.section-active-changed`.
    callback section-active-changed(bool);
}

// Every track row's cover, asked per instantiated row so no model row pins a buffer the row tier
// has evicted.
export global RowCovers {
    // Bumped as each scheduled batch lands, so a row's `pure` binding re-runs then. The value
    // itself means nothing.
    in property <int> generation: 0;
    pure callback request(string /*artwork_path*/, int /*generation*/) -> image;
}
