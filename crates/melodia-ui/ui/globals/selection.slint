import { CardSelection } from "card-selection.slint";
import { AlbumDetail } from "albums.slint";
import { ArtistDetail } from "artists.slint";
import { Favorites, RecentlyPlayed } from "curated.slint";
import { GenreDetail } from "genres.slint";
import { PlaylistDetail } from "playlists.slint";
import { Search } from "search.slint";
import { Browse, Tracks } from "tracks.slint";

// Lets the Escape chain ask once rather than import ten globals into a key binding.
//
// **The queue is deliberately absent.** Its picks are Escape's only while the queue was the last
// thing pressed, which its own arm in `shortcut-scope.slint` asks; joining here would clear them
// wherever Escape landed.
export global Selection {
    // Only when the item sits in a set of more than one, so a right-click beside a selection acts
    // on that item alone. Every item menu asks here.
    public pure function acts-on-set(item-selected: bool, set-count: int) -> bool {
        return item-selected && set-count > 1;
    }

    public pure function effective-ids(
        item-id: int,
        item-selected: bool,
        set-count: int,
        set: [int],
    ) -> [int] {
        return self.acts-on-set(item-selected, set-count) ? set : [item-id];
    }

    public pure function any-live() -> bool {
        return Tracks.selected-ids.length > 0
            || Browse.selected-ids.length > 0
            || Search.selected-ids.length > 0
            || Favorites.selected-ids.length > 0
            || RecentlyPlayed.selected-ids.length > 0
            || AlbumDetail.selected-ids.length > 0
            || ArtistDetail.selected-ids.length > 0
            || GenreDetail.selected-ids.length > 0
            || PlaylistDetail.selected-ids.length > 0
            || CardSelection.selected-ids.length > 0;
    }

    // Guarded per surface, a list's clear walking its whole row model to unstamp the flags.
    public function clear-live() {
        if (Tracks.selected-ids.length > 0) { Tracks.clear-selection(); }
        if (Browse.selected-ids.length > 0) { Browse.clear-selection(); }
        if (Search.selected-ids.length > 0) { Search.clear-selection(); }
        if (Favorites.selected-ids.length > 0) { Favorites.clear-selection(); }
        if (RecentlyPlayed.selected-ids.length > 0) { RecentlyPlayed.clear-selection(); }
        if (AlbumDetail.selected-ids.length > 0) { AlbumDetail.clear-selection(); }
        if (ArtistDetail.selected-ids.length > 0) { ArtistDetail.clear-selection(); }
        if (GenreDetail.selected-ids.length > 0) { GenreDetail.clear-selection(); }
        if (PlaylistDetail.selected-ids.length > 0) { PlaylistDetail.clear-selection(); }
        if (CardSelection.selected-ids.length > 0) { CardSelection.clear(); }
    }
}
