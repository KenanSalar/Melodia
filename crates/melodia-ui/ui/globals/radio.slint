import { RadioFacetRow, RadioStationGridRow, RadioStationRow, RadioSuggestionRow, StationHistoryRow } from "../models.slint";

export global Radio {
    // **`tab-count` is the sole definition of how many there are.**
    out property <int> tab-browse: 0;
    out property <int> tab-favorites: 1;
    // A tab rather than a Favorites sort: a station played from Browse is kept but not a favorite,
    // so this is the only place it can be reached again.
    out property <int> tab-recent: 2;
    out property <int> tab-count: 3;

    in-out property <int> tab-idx: 0;
    callback tab-changed(int);

    // One box for three tabs, each keeping its own needle; `ui::radio::filter::dispatch` routes it.
    in-out property <string> filter;
    in-out property <int> blur-search-tick: 0;
    callback filter-changed(string);

    // Pre-filter, `-1` until fetched (`ui::tab_bar::UNFETCHED_COUNT`).
    in-out property <int> browse-count: -1;
    in-out property <int> favorites-count: -1;
    in-out property <int> recent-count: -1;

    callback section-active-changed(bool);

    // One count for the three grids, which share one `GridGeometry`; Rust re-chunks the mounted tab.
    in-out property <int> grid-columns: 1;
    callback columns-changed(int);

    in-out property <[RadioStationGridRow]> browse-rows;

    // With no rows it is the first paint; with rows on screen, the load-more pill's spinner.
    in-out property <bool> browse-loading: false;
    // Read off the raw response length, so a page the HLS filter thinned still pages on.
    in-out property <bool> browse-has-more: false;
    // A flag rather than a message, so the copy stays an `@tr` literal at the mount.
    in-out property <bool> browse-failed: false;
    callback load-more();
    callback retry();

    // The repaint token. At `0` the tier is released and the lookup answers cache-only
    // (`ui::radio::covers::logo_cover`).
    in-out property <int> covers-generation: 0;
    pure callback request-logo(string /*artwork_path*/, int /*generation*/) -> image;

    // Physical pixels the logo tier decodes to. The tier never pads a source up, so a logo's width
    // over this is the share of the tile it fills at 1:1.
    in-out property <int> logo-decode-size: 0;

    // The whole row: a browsed station has no id (`id == 0`) and a kept one no place in the browse
    // cache.
    callback play-station(RadioStationRow);
    callback toggle-favorite(RadioStationRow);
    callback open-homepage(string);

    // Favorites holds the hand-typed stations too (`uuid == ""`), favorited on the way in.
    in-out property <[RadioStationGridRow]> favorites-rows;
    in-out property <[RadioStationGridRow]> recent-rows;

    // Favorites only: on Recently Played the order *is* the page.
    in-out property <string> sort-field: "name";
    in-out property <string> sort-dir: "asc";
    callback request-sort(string /*field*/);

    // Custom stations only, and the facade checks again: `save_station`'s conflict clause would
    // revert a browsed one on its next play.
    callback edit-station(RadioStationRow);
    // `list` is a kept tab's `tab-*`: removal takes the favorite on Favorites, the plays on
    // Recently Played. `-confirmed` accepts the confirmation a removal past the undo cap raises.
    callback remove-stations(int /*list*/, [int] /*ids*/);
    callback remove-stations-confirmed(int /*list*/, [int] /*ids*/);
    // `keys` are `select_key`s resolved against `tab`'s list, every browsed row's id being 0; a
    // hand-typed station is skipped, its card offering no heart.
    callback set-favorites(int /*tab*/, [int] /*keys*/, bool /*favorite*/);
    // `field` is "name" | "stream-url" | "website". Here rather than on `CopyActions` because the
    // caches the keys resolve from are this slice's.
    callback copy-stations(int /*tab*/, string /*field*/, [int] /*keys*/);
    callback import-stations();
    callback export-stations();

    // **The station detail's seat: which tab the painted page belongs to, `-1` for none**
    // (`ui::radio::detail::NO_SEAT`), since `id == 0` is a browsed station worth opening.
    // `ui::radio::detail::reseat` points these at the mounted tab, so a missed reseat unmounts the
    // page rather than painting the wrong station.
    // Written last, in the tick of the facts below and **after** the navigation has landed.
    in-out property <int> detail-tab: -1;
    out property <bool> detail-open: root.detail-tab >= 0 && root.detail-tab == root.tab-idx;
    // Raised at boot when `views.json` names a station to reopen, lowered behind the fetch. The tab
    // bodies gate on it, or a restore paints a grid and swaps a beat later.
    in-out property <bool> restoring: false;
    in-out property <RadioStationRow> detail-station;
    // Withheld from `RadioStationRow` for the reason its note gives; read by the copy action alone.
    in-out property <string> detail-stream-url;
    // Two properties, since "it failed" and "nobody has said" differ and only the first is printed.
    in-out property <bool> detail-check-known: false;
    in-out property <bool> detail-check-ok: false;
    in-out property <bool> detail-votable: false;
    // `-1` until the directory answers (`ui::radio::detail::VOTES_UNKNOWN`), `0` being real.
    in-out property <int> detail-votes: -1;

    in-out property <image> cover;
    // A logo is routinely a favicon, which the hero insets at native size rather than stretching.
    in-out property <int> detail-logo-size: 0;
    // The two-slot cross-fade: Rust fills the hidden slot and flips, so nothing flashes.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool> blur-use-a;
    in-out property <bool> has-blur;

    // What the station **on the deck** has announced, newest first, not the open page's. Now
    // Playing draws it whole; the station page only beside the flag below.
    in-out property <[StationHistoryRow]> history-rows;
    in-out property <bool> detail-station-is-playing;

    callback open-station(RadioStationRow);
    callback close-detail();
    // Fired once the collapse has finished, the hero painting all the way through it.
    callback hero-collapsed();
    // The box hides under a station page, so this announces the page closing;
    // `ui::radio::filter::sync_box` reseats the mounted tab's needle.
    callback detail-scope-changed();
    // Takes the station because Now Playing votes too, for the one on the deck. The id only
    // repaints the count on a page seated on the same station.
    callback vote(string /*station_uuid*/, int /*station_id*/);

    // The filter chips. Bitrate is no facet: its options are a fixed list the chip carries itself.
    out property <int> facet-country: 0;
    out property <int> facet-language: 1;
    out property <int> facet-tag: 2;
    out property <int> facet-codec: 3;
    out property <int> facet-bitrate: 4;

    // The country's code rides beside its name, the search endpoint taking the code.
    in-out property <string> pick-country;
    in-out property <string> pick-country-code;
    in-out property <string> pick-language;
    in-out property <string> pick-tag;
    in-out property <string> pick-codec;
    in-out property <int> pick-bitrate-min: 0;

    // One model, only one picker being up at a time. `facet-shown` is the kind it holds, so a list
    // landing for a chip the user has left is dropped rather than painted under the wrong label.
    in-out property <[RadioFacetRow]> facet-options;
    in-out property <int> facet-shown: -1;
    in-out property <bool> facet-loading: false;
    // Slint has no `for … : if …`, so Rust narrows `facet-options` per keystroke.
    in-out property <string> facet-filter;
    callback facet-filter-changed(string);
    callback request-facet(int /*kind*/);
    callback facet-picked(int /*kind*/, string /*name*/, string /*code*/);
    callback clear-facet(int /*kind*/);

    // What else the needle could mean, the directory searching one field per request
    // (`ui::radio::suggest`). Browse only, and never under a station page.
    in-out property <[RadioSuggestionRow]> suggestions;
    // Moves the needle into the chip, the two filtering one request; lands as a chip pick's edit.
    callback suggestion-picked(int /*kind*/, string /*name*/, string /*code*/);
}
