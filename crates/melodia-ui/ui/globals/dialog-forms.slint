import { ArtistCreditRow, SmartRuleRow } from "../models.slint";

// The form-shaped dialogs' state, apart from `Dialog` because its dispatcher imports these and
// never the reverse.

// Owned by `ui::playlists::callbacks::smart`, which raises the dialog from a fresh tick: Rust
// writing `Dialog` synchronously inside the click trips the recursion guard.
export global SmartEditor {
    in-out property <[SmartRuleRow]> rules;
    // 0 = match all (AND), 1 = match any (OR).
    in-out property <int> match-mode-index;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <bool> limit-enabled;
    in-out property <string> limit-count-text: "25";
    in-out property <int> limit-order-index;
    // -1 creates; otherwise the playlist being edited.
    in-out property <int> target-id: -1;
    // Limit applied. -1 hides the line.
    in property <int> match-count: -1;

    callback request-new();
    callback request-edit(int /*playlist_id*/);

    // Rust rewrites the row, recomputing field-kind / input-kind.
    callback add-rule();
    callback remove-rule(int /*row*/);
    callback set-rule-field(int /*row*/, int /*field index*/);
    callback set-rule-op(int /*row*/, int /*op index*/);
    callback set-rule-value(int /*row*/, string);

    callback recount();

    callback commit();
}

// Owned by `ui::callbacks::tags`, whose commit diffs the form against the populate-time snapshot
// (`library-data.md`). A field the selection disagrees on starts empty behind a ‹multiple values›
// placeholder.
export global TagEditor {
    in-out property <string> title;
    in-out property <string> album;
    in-out property <string> year;
    in-out property <string> original-year;
    in-out property <string> track-number;
    in-out property <string> disc-number;
    in-out property <string> comment;
    in-out property <string> bpm;
    in-out property <string> lyrics;

    // Track-level first, then from `label` on the release-level tags, which reach `albums` through
    // the re-ingest the commit ends with.
    in-out property <string> track-total;
    in-out property <string> disc-total;
    in-out property <string> disc-subtitle;
    in-out property <string> subtitle;
    in-out property <string> initial-key;
    in-out property <string> mood;
    in-out property <string> grouping;
    in-out property <string> work;
    in-out property <string> movement;
    in-out property <string> movement-number;
    in-out property <string> movement-total;
    in-out property <string> language;
    in-out property <string> copyright;
    in-out property <string> isrc;
    in-out property <string> label;
    in-out property <string> catalog-number;
    in-out property <string> barcode;
    in-out property <string> media;
    in-out property <string> release-type;
    in-out property <string> release-country;
    // A plain bool rather than a tri-state: the commit diffs it against what the populate wrote,
    // so an untouched switch is `Keep` like every other field.
    in-out property <bool> compilation;

    // The sentinel where the selection disagrees, the normal hint otherwise.
    in property <string> title-placeholder;
    in property <string> artist-placeholder;
    in property <string> album-artist-placeholder;
    in property <string> album-placeholder;
    in property <string> genre-placeholder;
    in property <string> year-placeholder;
    in property <string> original-year-placeholder;
    in property <string> track-number-placeholder;
    in property <string> disc-number-placeholder;
    in property <string> comment-placeholder;
    in property <string> bpm-placeholder;
    in property <string> lyrics-placeholder;
    in property <string> track-total-placeholder;
    in property <string> disc-total-placeholder;
    in property <string> disc-subtitle-placeholder;
    in property <string> subtitle-placeholder;
    in property <string> initial-key-placeholder;
    in property <string> mood-placeholder;
    in property <string> grouping-placeholder;
    in property <string> work-placeholder;
    in property <string> movement-placeholder;
    in property <string> movement-number-placeholder;
    in property <string> movement-total-placeholder;
    in property <string> language-placeholder;
    in property <string> copyright-placeholder;
    in property <string> isrc-placeholder;
    in property <string> label-placeholder;
    in property <string> catalog-number-placeholder;
    in property <string> barcode-placeholder;
    in property <string> media-placeholder;
    in property <string> release-type-placeholder;
    in property <string> release-country-placeholder;

    // Credits rather than strings: names with a phrase between each pair. Rust applies every edit,
    // so a row never mutates what it is handed.
    in-out property <[ArtistCreditRow]> artists;
    in-out property <[ArtistCreditRow]> album-artists;
    // Seeded from `entities::artist::JOIN_PHRASES` **plus any the opened files use**, so a credit
    // written elsewhere survives a save. Not an inline `@tr` array: this is tag content, and a
    // localized " feat. " would land in the user's file.
    in property <[string]> join-phrases;
    // A row per name, edited as the credits are: a genre is multi-value in every format that can
    // hold one.
    in-out property <[string]> genres;
    callback set-genre-name(int /*row*/, string);
    callback add-genre();
    callback remove-genre(int /*row*/);

    // The names **per role**, indexed by position in `entities::credits::ROLES`.
    // `tag-editor-body.slint`'s inline label array mirrors that order, and a label out of place
    // silently files a conductor as a producer.
    in-out property <[[string]]> role-names;
    in property <[string]> role-placeholders;
    callback set-role-name(int /*role*/, int /*row*/, string);
    callback add-role(int /*role*/);
    callback remove-role(int /*role*/, int /*row*/);

    // The credit as it will be written.
    in property <string> artist-preview;
    in property <string> album-artist-preview;
    // Which credit a row callback means, the body mounting one editor per field.
    out property <int> field-artist: 0;
    out property <int> field-album-artist: 1;
    callback add-credit(int /*field*/);
    callback remove-credit(int /*field*/, int /*row*/);
    callback set-credit-name(int /*field*/, int /*row*/, string);
    callback set-credit-join(int /*field*/, int /*row*/, int /*phrase index*/);
    // A sheet beside the file or from the directory, which the tab can offer to write into it.
    // False where the tag already holds it, an offer to copy a field onto itself reading as a
    // broken button.
    in property <bool> has-resident-lyrics;
    callback insert-resident-lyrics();

    // 1 = single selection (Lyrics + Summary available), >1 = batch.
    in property <int> track-count;
    // Reset to `tab-tags` by every populate, then set to the tab the request asked for.
    in-out property <int> active-tab;

    // Where `tag-editor-body.slint` mounts each tab, named so an opener and the body can't
    // disagree. The single-selection tabs sit **last**: batch mode mounts the leading three and
    // `active-tab` indexes the visible ones, so no second map is needed.
    out property <int> tab-tags: 0;
    out property <int> tab-credits: 1;
    out property <int> tab-details: 2;
    out property <int> tab-lyrics: 3;
    out property <int> tab-summary: 4;
    // `has-cover` gates Remove.
    in-out property <image> cover;
    in property <bool> has-cover;
    in property <bool> lyrics-enabled;

    // Preformatted by Rust.
    in property <string> summary-path;
    in property <string> summary-codec;
    in property <string> summary-bitrate;
    in property <string> summary-sample-rate;
    in property <string> summary-bit-depth;
    in property <string> summary-channels;
    in property <string> summary-size;
    in property <string> summary-duration;
    in property <string> summary-modified;
    in property <string> summary-hash;

    // Reach it through `Dialog.open-tag-editor`, which says why the tab is an argument.
    callback request-edit([int] /*track ids*/, int /*tab*/);
    // rfd on the UI thread.
    callback pick-artwork();
    callback remove-artwork();
    callback commit();
}

// Owned by `ui::settings::scrobbling_settings`. Last.fm takes two steps: `lastfm-open-auth()`
// opens the approval page for a fresh token, and `lastfm-finish` trades it for a session. `error`
// takes its line from the `err-*` callbacks, Slint 1.18 having no Rust-callable `tr()`.
export global ScrobbleUi {
    in-out property <int> lastfm-step;      // 0 = open browser, 1 = finish
    in-out property <string> lastfm-token;  // unauthorized token between steps
    in-out property <string> lb-token;      // ListenBrainz token input
    in-out property <bool> busy;
    in-out property <string> error;

    callback lastfm-open-auth();
    callback lastfm-finish(string /*token*/);
    callback listenbrainz-verify(string /*token*/);

    pure callback err-invalid-token() -> string;
    err-invalid-token => {
        return @tr("That token wasn't accepted. Check it and try again.");
    }
    pure callback err-network() -> string;
    err-network => {
        return @tr("Couldn't reach the service. Check your connection and try again.");
    }
    pure callback err-not-authorized() -> string;
    err-not-authorized => {
        return @tr("Not approved yet. Approve Melodia in your browser, then click Finish.");
    }
    pure callback err-save-failed() -> string;
    err-save-failed => {
        return @tr("Couldn't save your credentials.");
    }
}

// Owned by `ui::radio::callbacks::kept`; an `edit-id` of -1 adds. **The dialog stays open across
// `submit()`** because the submit is a real connect, the URL followed past any playlist and the
// stream probed, so a mount that can't play is refused here rather than at the first click.
// `error` takes its line from the `err-*` callbacks, as `ScrobbleUi`'s does.
export global RadioForm {
    in-out property <int> edit-id: -1;
    in-out property <string> url;
    // Optional. Left blank, the station names itself off the stream's own headers.
    in-out property <string> name;
    in-out property <bool> busy;
    in-out property <string> error;
    // Hides the name and the URL, which the directory rewrites on the next play, so an edit there
    // would revert.
    in-out property <bool> directory-owned;

    // Each offered only where the directory said nothing (`RadioStation::can_override`).
    in-out property <string> website;
    in-out property <bool> can-edit-website;
    in-out property <string> logo-url;
    in-out property <bool> can-edit-logo;
    in-out property <string> genre;
    in-out property <bool> can-edit-genre;
    in-out property <string> country;
    in-out property <bool> can-edit-country;

    // What an add opens on and a close hands back. It answers every property, a flag left at
    // `false` being a field the add dialog never draws. A `public function`, a callback's one
    // handler slot being clobberable.
    public function reset() {
        root.edit-id = -1;
        root.url = "";
        root.name = "";
        root.website = "";
        root.logo-url = "";
        root.genre = "";
        root.country = "";
        // A typed-in station has no directory to disagree with; an edit answers these off its row.
        root.directory-owned = false;
        root.can-edit-website = true;
        root.can-edit-logo = true;
        root.can-edit-genre = true;
        root.can-edit-country = true;
        root.busy = false;
        root.error = "";
    }

    callback submit();

    // What Enter means in any of the six fields. A directory-owned station draws no URL field, so
    // it asks for none.
    public function submit-if-ready() {
        if (!root.busy && (root.directory-owned || root.url != "")) {
            root.submit();
        }
    }

    // The edit dialog's chrome, here because a string Rust pushed would render untranslated. The
    // add dialog's sits inline in `views/radio/tab-pills.slint`.
    pure callback edit-title() -> string;
    edit-title => {
        return @tr("Edit Station");
    }
    pure callback details-title() -> string;
    details-title => {
        return @tr("Station Details");
    }
    pure callback save-label() -> string;
    save-label => {
        return @tr("Save");
    }
    pure callback cancel-label() -> string;
    cancel-label => {
        return @tr("Cancel");
    }

    pure callback err-unreachable() -> string;
    err-unreachable => {
        return @tr("Couldn't reach that address. Check the URL and your connection.");
    }
    pure callback err-not-audio() -> string;
    err-not-audio => {
        return @tr("That address doesn't play as audio Melodia can decode.");
    }
    pure callback err-save-failed() -> string;
    err-save-failed => {
        return @tr("Couldn't save the station.");
    }
    // The website's and the logo's, the sentence naming neither field.
    pure callback err-bad-url() -> string;
    err-bad-url => {
        return @tr("That doesn't look like a web address. It should start with https://");
    }
}
