// **Field names and types mirror the Rust side exactly**: Slint ignores an extra Rust field and
// defaults a missing one, so a mismatch is silent. No `Option<T>` either, hence the typed defaults
// (`""`, `0`) in the conversions.
//
// No list row carries a decoded image: one in a model pins every row's pixels past LRU eviction,
// so resident artwork would scale with the library. An instantiated row or card asks for its own.

export struct TrackSummaryRow {
    id: int,
    file_path: string,
    title: string,
    artist: string,
    album: string,
    duration_ms: int,
    artwork_path: string,
    // Empty (`width == 0`) without artwork or after a failed decode.
    cover_img: image,
    is_favorite: bool,
    rating: int,   // 0–5, 0 = unrated
}

// Mirror of `entities::track::TrackListRow`.
export struct TrackListRow {
    id: int,
    title: string,
    artist: string,
    album: string,
    genre: string,
    year: int,           // 0 = unknown
    track_number: int,   // 0 = unknown
    duration_ms: int,
    is_favorite: bool,
    rating: int,   // 0–5, 0 = unrated
    artwork_path: string,

    // Formatted in Rust: `Theme.format-duration` here re-runs on every invalidation, per row.
    display_duration: string,
    // UI state on the row because a Slint expression can't test set membership. Browse clears
    // `enabled` on a file in a library folder but not the database (`id == 0`), dimming it.
    selected: bool,
    enabled: bool,
    // The context menu's "Go to …" targets; 0 hides the entry.
    album_id: int,
    artist_id: int,
    genre_id: int,
}

// What `views.json` keeps of a page's columns. `w_number`, `w_year` and `w_length` are pixels and
// the other four weights against the room the list has, `ui::track_columns` being the only reader
// of either. Title and Length always show. `show_artwork` and the three marks switch what a row
// draws inside its cells, not a column.
export struct TrackColumns {
    w_number: length,
    w_title: length,
    w_artist: length,
    w_album: length,
    w_genre: length,
    w_year: length,
    w_length: length,
    show_number: bool,
    show_artwork: bool,
    show_artist: bool,
    show_album: bool,
    show_genre: bool,
    show_year: bool,
    show_favorite_mark: bool,
    show_favorite_button: bool,
    show_rating_strip: bool,
}

// One list width's column positions, shared by the header and every row. A hidden column is zeros.
export struct TrackColumnLayout {
    number_x: length,
    number_w: length,
    title_x: length,
    title_w: length,
    artist_x: length,
    artist_w: length,
    album_x: length,
    album_w: length,
    genre_x: length,
    genre_w: length,
    year_x: length,
    year_w: length,
    length_x: length,
    length_w: length,
}

// The column whose right-edge divider is being dragged.
export enum TrackColumn { number, title, artist, album, genre, year, length }

export struct AlbumRow {
    id: int,
    name: string,
    // For the card menu's "Go to Artist" alone.
    artist_id: int,
    artist_name: string,
    year: int,            // 0 = unknown
    track_count: int,
    total_duration_ms: int,
    artwork_path: string,
}

// A row of up to `columns` cards, so the grid's `ListView` virtualizes by row. Every `*GridRow` is
// this shape.
export struct AlbumGridRow {
    albums: [AlbumRow],
}

export struct ArtistRow {
    id: int,
    name: string,
    image_path: string,
    track_count: int,
    album_count: int,
    total_duration_ms: int,
}

export struct ArtistGridRow {
    artists: [ArtistRow],
}

// No artwork: the card and the hero paint `genres::color::genre_accent`'s name-hashed stops. Only
// the saturated pair crosses; `apply_genre_hero` re-hashes for the dimmed one.
export struct GenreRow {
    id: int,
    name: string,
    track_count: int,
    total_duration_ms: int,
    display_duration: string,
    tile_color_1: color,
    tile_color_2: color,
}

export struct GenreGridRow {
    genres: [GenreRow],
}

export struct PlaylistRow {
    id: int,
    name: string,
    description: string,
    artwork_path: string,
    track_count: int,
    total_duration_ms: int,
    // Rules decide membership, so card and detail disable every manual edit.
    is_smart: bool,
}

export struct PlaylistGridRow {
    playlists: [PlaylistRow],
}

// The Add-to-Playlist picker's row, `selected` read back by the dispatcher. A `contained_count`
// covering the whole selection disables it; a partial one reads "X of Y already added".
export struct PlaylistPickRow {
    id: int,
    name: string,
    artwork_path: string,
    contained_count: int,
    selected: bool,
}

// The Export picker's row: the same shape, no overlap.
export struct PlaylistExportPickRow {
    id: int,
    name: string,
    artwork_path: string,
    track_count: int,
    selected: bool,
}

// `join-index` points into Rust's `TagEditor.join-phrases`, so a mistyped separator can't reach
// the file from here. The last row's is ignored.
export struct ArtistCreditRow {
    name: string,
    join-index: int,
}

// **Every value is an index or code**, so no translated string round-trips: the editor's inline
// `@tr` arrays follow `entities::smart_criteria::{FIELDS, ops_for}` by position.
//   * field-kind — 0 text · 1 number · 2 bool · 3 date; picks the op array
//   * input-kind — 0 none · 1 text · 2 number; picks the value widget
//   * fractional — a number widget that takes a decimal point (`RuleField::holds_fractions`)
export struct SmartRuleRow {
    field-index: int,
    op-index: int,
    field-kind: int,
    input-kind: int,
    fractional: bool,
    value-text: string,
}

// The station on the deck; `has_track` and `has_station` are never both true.
// **`stream_url` crosses here**, where `RadioStationRow` withholds it, because Now Playing
// states it as the station page does. The facts below `buffering` ride the view model
// so the bar and the Now Playing panel can't disagree about the deck, and `monogram` and the stops
// are `ui::radio::identity::station_tile`'s, as the card's and the hero's are.
export struct RadioVm {
    // `0` for a station only browsed to, as `RadioStationRow.id`.
    station_id: int,
    // Empty for a hand-typed station, which the directory has nothing to record a vote against.
    uuid: string,
    name: string,
    // Empty until the stream announces something, which for plenty is never. Split by
    // `RadioNowPlaying::announcement`; a line naming no artist arrives whole as `live_title`.
    live_title: string,
    live_artist: string,
    artwork_path: string,
    // The row tier's copy, empty until its decode lands; the full view takes
    // `Player.np-station-logo`.
    logo_img: image,
    monogram: string,
    tile_color_1: color,
    tile_color_2: color,
    // Raised beside a `playing` status, not instead, so a dip never reads to the OS as a stop.
    buffering: bool,

    stream_url: string,
    // Empty where nobody said: a hand-typed station gets no guess off its host.
    country: string,
    tags: string,
    homepage: string,
    codec: string,
    // `0` means the directory doesn't know.
    bitrate: int,
    play_count: int,
}

// **`position_ms` and `duration_ms` are `Player` scalars, not fields here**: the 500 ms tick would
// otherwise dirty every binding reading any part of `Player.vm`.
export struct PlayerVm {
    has_track: bool,
    track: TrackSummaryRow,
    has_station: bool,
    radio: RadioVm,
    status: string,
    is_playing: bool,
    volume: int,
    is_muted: bool,
    playback_speed: float,
    gapless: bool,
    // `PlayerState::pause_after_current_track`, read straight so the sleep row clears at the end.
    sleep_at_track_end: bool,
    has_next: bool,
    has_previous: bool,
}

export struct QueueVm {
    length: int,
    current_index: int,
    shuffle: bool,
    repeat_mode: string,
    has_next: bool,
    has_previous: bool,
}

// **No `is_current`**: the highlight reads `Queue.current-index`, so one write repaints two rows.
// The model stamps `selected` on every row it hands out, placeholders included, so a row can join
// its neighbours' run of picks.
export struct QueueRow {
    id: int,
    title: string,
    artist: string,
    artwork_path: string,
    display_duration: string,
    selected: bool,
    is_favorite: bool,
    rating: int,   // 0–5, 0 = unrated
    // The context menu's "Go to …" targets; 0 hides the entry.
    album_id: int,
    artist_id: int,
    genre_id: int,
}

// `count` picks together from `first`, or a `count` of 0 for scattered ones
// (`ui::drag::lifted_run`).
export struct LiftedRun {
    first: int,
    count: int,
}

// Display strings, `""` for unknown or not yet loaded. The chip row gates on
// `track_id == Player.vm.track.id`, which marks a fetch landing after a skip as stale.
export struct TrackMetaRow {
    track_id: int,
    codec: string,        // "FLAC"
    bitrate: string,      // "1009 kbps"
    sample_rate: string,  // "44.1 kHz"
    bit_depth: string,    // "16-bit"
    channels: string,     // "Stereo"
    year: string,         // "2017"
    genre: string,        // "Jazz"
}

// `last-scanned` is formatted in Rust, empty for a folder never scanned.
export struct FolderListRow {
    id: int,
    path: string,
    last-scanned: string,
}

export struct BrowseFolderRow {
    path: string,
    name: string,
}

// Not `EntityStripRow`, whose grids would carry fields only Browse needs. `row_index` is what a
// card hands `play-row`, the index the `TrackList` would have passed.
export struct BrowseCardRow {
    id: int,             // track id; 0 for a folder and for a disk-only file
    row_index: int,      // index into `Browse.rows`; -1 for a folder
    path: string,        // folder path; "" for a track card
    title: string,
    subtitle: string,
    artwork_path: string,
    is_folder: bool,
    enabled: bool,
}

export struct BrowseCardGridRow {
    cards: [BrowseCardRow],
}

// One shape for every strip and entity grid, `id` being whichever entity the host deals in.
// `play_count` is read only under `show-play-count`.
export struct EntityStripRow {
    id: int,
    title: string,
    subtitle: string,
    artwork_path: string,
    play_count: int,
    // A track card's heart; no other kind mounts one.
    is_favorite: bool,
}

export struct EntityGridRow {
    entities: [EntityStripRow],
}

// The current folder is the bar's title rather than a segment, so it never appears as a row.
export struct BreadcrumbRow {
    label: string,
    path: string,
}

// `info` first, being both the default and the card's fallback styling.
export enum NotificationVariant { info, success, warning, error }

// Routes a row's action button through `ui::shell::notifications::run_action`'s exhaustive match,
// and groups rows for `dismiss_by_kind`.
export enum NotificationKind {
    none,
    install-update,
    update-restart,
    crash-report,
    support-melodia,
    exclusive-refused,
    update-failed,
    watcher-disabled,
    library-resyncing,
    audio-device-lost,
    artwork-restoring,
}

// `id` is a monotonic handle for `Notifications.dismiss`; an empty `action-label` draws no button.
export struct NotificationRow {
    id: int,
    variant: NotificationVariant,
    title: string,
    message: string,
    action-label: string,
    kind: NotificationKind,
}

// **`id` is `0` for a station only in the directory**, results never being persisted until the
// user keeps or plays one. No `stream_url`: Rust resolves a row back to its own cache by `uuid` or
// `id`. `tags` and `codec` arrive display-ready, the directory's tag field being a
// free-form list of a dozen; `codec` reads `HLS` for a segmented stream the directory couldn't
// name, and nothing badges one, because those play.
export struct RadioStationRow {
    id: int,
    // What the card selects and copies by: the row id, or on Browse the station's 1-based place in
    // the answer, which a fresh search renumbers. A browsed row built outside Browse holds 0.
    select_key: int,
    uuid: string,
    name: string,
    // The user's own wins over the directory's, decided in `RadioStation::website`.
    homepage: string,
    // Whether the card offers its pencil: always on a hand-typed station, and on a directory one
    // only while the directory named no site, a link that isn't the user's to overwrite.
    editable: bool,
    artwork_path: string,
    tags: string,
    country: string,
    codec: string,
    bitrate: int,          // 0 = the directory doesn't know
    is_favorite: bool,
    // `0` on a browsed station. Only Recently Played shows the badge.
    play_count: int,
    // The logo-less tile, name-hashed in Rust as `GenreRow`'s pair is. An empty `monogram` (a name
    // with no letters) leaves the card on the glyph.
    tile_color_1: color,
    tile_color_2: color,
    monogram: string,
}

export struct RadioStationGridRow {
    stations: [RadioStationRow],
}

// `artist` and `title` split the line as the player bar does, both empty where it doesn't split.
export struct StationHistoryRow {
    line: string,
    artist: string,
    title: string,
}

// `code` is sent only for countries, `countrycode` being the one code-keyed search parameter.
export struct RadioFacetRow {
    name: string,
    code: string,
    station_count: int,
}

// `kind` is the chip it fills, in `Radio.facet-*` numbering, so a suggestion and a chip pick are
// one edit. `station_count` is `-1` where nothing counted it (a bitrate floor or a frequency read
// off the needle); `0` is a real answer.
export struct RadioSuggestionRow {
    kind: int,
    name: string,
    code: string,
    station_count: int,
}

// `entities::lyrics::LyricLine` plus its drawn heights. **Every count is Rust's**, which keeps the
// offset table the panel follows (`ui::now_playing::lyrics::follow`). `at_ms` is `-1` on an untimed
// sheet, the two never mixing.
export struct LyricRow {
    text: string,
    // Blanked by Rust for a Latin line or with the toggle off, so one answer decides what is drawn
    // and how tall the row is.
    romanization: string,
    translation: string,
    at_ms: int,
    // Spelled out rather than read off empty text and a stamp, a pair meaning a gap only because
    // the parser folds blank stamps away.
    is_interlude: bool,
    line_count: int,
    romanization_line_count: int,
    translation_line_count: int,
}
