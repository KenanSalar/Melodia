import { Dialog } from "../globals/dialog.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Onboarding } from "../globals/onboarding.slint";
import { Player } from "../globals/player.slint";
import { Queue } from "../globals/queue.slint";
import { Selection } from "../globals/selection.slint";
import { MiniPlayer, WindowChrome } from "../globals/shell.slint";
import { Notifications } from "../globals/notifications.slint";

// The app's shortcuts, round the whole main layout. **The only `FocusScope` in the tree**: a
// scope takes focus on a press, never on mount, so a nested one leaves keys dead on a sheet
// opened from the keyboard. Escape runs under `Dialog.open` too, routing to
// `Dialog.cancelled()`, and so does Ctrl+Z; **every other shortcut early-outs there**.
export component ShortcutScope inherits FocusScope {
    // Slint doesn't hand focus back to an ancestor scope when the focused item dies, so the host
    // calls this on every content-view switch.
    public function grab-focus() {
        self.focus();
    }

    // First grab, at first show.
    init => { root.grab-focus(); }

    // Debounces the persist of a volume step, key or wheel: the step reaches the backend at once,
    // and this commits once on the trailing edge. Here because a global holds no timer, and this
    // scope is mounted over the miniplayer too.
    property <int> commit-debounce-ticks: 0;

    // On a mirror because `changed` rejects path expressions on globals.
    property <int> watched-volume-step: Player.volume-step-tick;
    changed watched-volume-step => {
        root.commit-debounce-ticks = 3;
    }

    commit-debounce-timer := Timer {
        interval: 100ms;
        running: root.commit-debounce-ticks > 0;
        triggered => {
            root.commit-debounce-ticks =
                max(0, root.commit-debounce-ticks - 1);
            if (root.commit-debounce-ticks == 0) {
                Player.commit-volume();
            }
        }
    }

    // A scrub off the end is the common way a track changes mid-run, and the trailing edge would
    // otherwise seek the incoming track to the outgoing one's target.
    property <int> watched-seek-track: Player.vm.track.id;
    changed watched-seek-track => {
        Player.end-seek-run();
    }

    seek-run-timer := Timer {
        interval: Player.seek-run-tick;
        running: Player.seek-run-ticks > 0;
        triggered => {
            Player.seek-run-ticks = max(0, Player.seek-run-ticks - 1);
            if (Player.seek-run-ticks == 0) {
                Player.flush-seek();
                Player.end-seek-run();
            }
        }
    }

    // `pct` stays an integer; the rounding bias is negligible at ms scale.
    function seek-to-percent(pct: int) {
        if (Player.duration-ms > 0) {
            Player.seek-to(round(Player.duration-ms * pct / 100));
        }
    }

    // The docked panel's keys are live only while it was the last thing pressed; the overlay owns
    // them while it is up.
    property <bool> queue-keys: Queue.shown && (Queue.keys-owned || Queue.floating);

    key-pressed(ev) => {
        // Priority: the dialog, the welcome card, the queue's picks, the floating queue, Now
        // Playing, then a live selection.
        if (ev.text == Key.Escape) {
            if (Dialog.open) {
                Dialog.cancelled();
                Dialog.open = false;
                return accept;
            }
            // Below the dialog, matching the paint order: the card mounts under
            // `DialogOverlay`, so a dialog its folder picker raises takes Escape first.
            if (Onboarding.open) {
                Onboarding.dismiss();
                return accept;
            }
            // The docked panel is a place, not a popup, so Escape only clears its picks.
            if (root.queue-keys && Queue.selected-count > 0) {
                Queue.clear-selection();
                return accept;
            }
            // The overlay is the popup, so with its picks gone the next press closes it.
            if (Queue.floating) {
                Queue.close();
                return accept;
            }
            if (Nav.now-playing-open) {
                Nav.pending-enter-from = NavEnterFrom.above;
                Nav.now-playing-open = false;
                return accept;
            }
            // **Last**: `any-live()` can't tell whether its surface is on screen, so higher up a
            // set under Now Playing would swallow the press closing it.
            if (Selection.any-live()) {
                Selection.clear-live();
                return accept;
            }
            return reject;
        }

        // Above the modal gate, as the notice's own button works over a dialog, the stack painting
        // above it. A focused field takes Ctrl+Z before it bubbles here, so it keeps its own.
        if (ev.modifiers.control && !ev.modifiers.shift && ev.text == "z"
            && Notifications.undo-row >= 0) {
            Notifications.undo(Notifications.undo-row);
            return accept;
        }

        // A confirm-only dialog has no input to consume Space, and the welcome card none at all.
        if (Dialog.open || Onboarding.open) {
            return reject;
        }

        // Backspace too, being the key a Mac labels delete.
        if ((ev.text == Key.Delete || ev.text == Key.Backspace)
            && root.queue-keys && Queue.selected-count > 0) {
            Queue.remove-selected();
            return accept;
        }

        // Slint maps `modifiers.control` to Cmd on macOS.
        if (ev.text == Key.LeftArrow) {
            if (ev.modifiers.control) {
                Player.previous();
            } else {
                Player.bump-seek(ev.modifiers.shift ? -30000 : -5000);
            }
            return accept;
        }
        if (ev.text == Key.RightArrow) {
            if (ev.modifiers.control) {
                Player.next();
            } else {
                Player.bump-seek(ev.modifiers.shift ? 30000 : 5000);
            }
            return accept;
        }
        if (ev.text == Key.UpArrow) {
            Player.bump-volume(Player.volume-step(ev.modifiers));
            return accept;
        }
        if (ev.text == Key.DownArrow) {
            Player.bump-volume(-Player.volume-step(ev.modifiers));
            return accept;
        }

        if (ev.text == "0") { seek-to-percent(0);  return accept; }
        if (ev.text == "1") { seek-to-percent(10); return accept; }
        if (ev.text == "2") { seek-to-percent(20); return accept; }
        if (ev.text == "3") { seek-to-percent(30); return accept; }
        if (ev.text == "4") { seek-to-percent(40); return accept; }
        if (ev.text == "5") { seek-to-percent(50); return accept; }
        if (ev.text == "6") { seek-to-percent(60); return accept; }
        if (ev.text == "7") { seek-to-percent(70); return accept; }
        if (ev.text == "8") { seek-to-percent(80); return accept; }
        if (ev.text == "9") { seek-to-percent(90); return accept; }

        if (ev.text == " ") {
            Player.play-pause();
            return accept;
        }

        // **Before the bare letters**, so Ctrl+N wins over N.
        if (ev.modifiers.control) {
            // Only the queue takes it; the guard above keeps it off a modal.
            if (ev.text == "a" && root.queue-keys) {
                Queue.select-all();
                return accept;
            }
            // Not under a forced rail, where the sidebar's own toggle stands down too.
            if (ev.text == "b" && !Nav.sidebar-yields) {
                Nav.sidebar-collapsed = !Nav.sidebar-collapsed;
                return accept;
            }
            if (ev.text == ",") {
                // The edge goes with it as from the sidebar: unwritten, the page inherits the last
                // drill's.
                Nav.pending-enter-from = NavEnterFrom.above;
                Nav.selected-index = 9;
                Nav.persist-selected-index(9);
                return accept;
            }
            if (ev.text == "n") {
                Dialog.open-create-playlist([]);
                return accept;
            }
            return reject;
        }

        if (ev.text == "m") { Player.toggle-mute();     return accept; }
        if (ev.text == "l") { Player.toggle-favorite(); return accept; }
        if (ev.text == "n") { Player.next();            return accept; }
        if (ev.text == "p") { Player.previous();        return accept; }
        if (ev.text == "s") { Player.toggle-shuffle();  return accept; }
        if (ev.text == "r") { Player.cycle-repeat();    return accept; }

        // The miniplayer has no panel to open. A narrow window opens the overlay.
        if (ev.text == "q" && !MiniPlayer.active) {
            Queue.toggle();
            return accept;
        }
        if (ev.text == "f") {
            Nav.pending-enter-from = NavEnterFrom.above;
            Nav.now-playing-open = !Nav.now-playing-open;
            return accept;
        }
        if (ev.text == Key.F11) {
            WindowChrome.toggle-maximize();
            return accept;
        }

        return reject;
    }
}
