import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../settings.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { WindowChrome } from "../globals/shell.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { NavRow } from "../components/nav-row.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { EdgeResizeHandle, GrowEdge } from "../components/edge-resize-handle.slint";

component SidebarItem inherits NavRow {
    in property <int> index;

    selected: Nav.selected-index == root.index;
    show-label: !Nav.sidebar-rail;
    // Expanded, a fraction of the width, so the icons drift outward as the sidebar is dragged.
    pad-left: Nav.sidebar-rail ? 4px : Nav.sidebar-expanded-w * 10%;
    pad-right: Nav.sidebar-rail ? 4px : Theme.pad-md;
    ease-padding: !Nav.sidebar-dragging;

    // `app-window.slint` paints the pill, for the reason the global gives. **Published expanded
    // too**, so the tooltip is armed when the sidebar folds under a parked pointer.
    private property <bool> hover-mirror: root.has-hover;
    changed hover-mirror => {
        if (self.hover-mirror) {
            Nav.sidebar-tip-idx = root.index;
            Nav.sidebar-tip-label = root.label;
            Nav.sidebar-tip-y = root.absolute-position.y;
            Nav.sidebar-tip-h = root.height;
        } else if (Nav.sidebar-tip-idx == root.index) {
            Nav.sidebar-tip-idx = -1;
        }
    }

    // **No detail id is reset here**: it belongs to its tab, so returning restores the last one.
    clicked => {
        // Before the index write, or the new branch enters from wherever the last nav left it.
        Nav.pending-enter-from = NavEnterFrom.above;
        Nav.now-playing-open = false;
        Nav.selected-index = root.index;
        Nav.persist-selected-index(root.index);
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.surface0;
}

export component Sidebar inherits Rectangle {
    // What the row leaves the sidebar beside the content's floor and any docked queue panel, the
    // furthest its edge drags.
    in property <length> room;

    width: Nav.sidebar-rail ? Theme.sidebar-collapsed-w : Nav.sidebar-expanded-w;
    animate width { duration: Theme.dur-med; easing: ease-in-out; enabled: !Nav.sidebar-dragging; }

    background: WindowChrome.mantle;

    VerticalLayout {
        padding: Theme.pad-sm;
        spacing: Theme.pad-xs;

        // Collapse / expand toggle
        Rectangle {
            height: 36px;
            background: transparent;

            // The tooltip shows only on the rail, so it names the click's action, "Expand".
            property <bool> hover-mirror: collapse-touch.has-hover;
            changed hover-mirror => {
                if (self.hover-mirror) {
                    Nav.sidebar-tip-idx = Nav.sidebar-collapse-tip-idx;
                    // Translators: the action a click takes, expanding the sidebar
                    Nav.sidebar-tip-label = @tr("Expand");
                    Nav.sidebar-tip-y = self.absolute-position.y;
                    Nav.sidebar-tip-h = self.height;
                } else if (Nav.sidebar-tip-idx == Nav.sidebar-collapse-tip-idx) {
                    Nav.sidebar-tip-idx = -1;
                }
            }

            // Animated alone, so the wobble fires on press and not while the width eases.
            property <float> press-scale: collapse-touch.pressed ? 0.97 : 1.0;
            animate press-scale {
                duration: collapse-touch.pressed ? 100ms : Theme.dur-med;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            // Scales on press while the outer keeps the fixed layout slot.
            Rectangle {
                width: parent.width * parent.press-scale;
                height: parent.height * parent.press-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-md;
                background: collapse-touch.has-hover ? Theme.surface0 : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
                HorizontalLayout {
                    // `SidebarItem`'s, keeping this icon in line with the nav icons.
                    padding-left: Nav.sidebar-rail ? 4px : Nav.sidebar-expanded-w * 10%;
                    padding-right: Nav.sidebar-rail ? 4px : Theme.pad-md;
                    spacing: Theme.pad-md;
                    alignment: start;
                    cross-axis-alignment: center;
                    animate padding-left, padding-right { duration: Theme.dur-med; easing: ease-in-out; enabled: !Nav.sidebar-dragging; }
                    MaterialIcon {
                        name: Nav.sidebar-rail ? "dock_to_right" : "dock_to_left";
                        icon-size: 22px;
                        icon-color: Theme.text;
                        filled: true;
                        fade: Nav.sidebar-yields ? 0.5 : 1.0;
                    }
                    if !Nav.sidebar-rail: Text {
                        text: @tr("Collapse");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            // Off while a narrow window forces the rail: there is no room to expand into, and a
            // click would flip the user's own fold with nothing on screen to show for it.
            collapse-touch := TouchArea {
                enabled: !Nav.sidebar-yields;
                mouse-cursor: pointer;
                clicked => { Nav.sidebar-collapsed = !Nav.sidebar-collapsed; }
            }
        }

        // Caps the sidebar's preferred height, so the now-playing bar keeps its slot in a short
        // window. `content-width: self.width` locks the other axis against a sideways wheel.
        nav-scroll := ScrollView {
            vertical-stretch: 1;
            // Replaces the std ScrollView's width floor, which the rail is narrower than
            // (`slint-pitfalls.md`).
            min-width: 0px;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;
            content-width: self.width;

            VerticalLayout {
                spacing: Theme.pad-xs;

                Divider {}

                SidebarItem { index: 0; label: @tr("Search"); icon: "search"; }
                SidebarItem { index: 1; label: @tr("Browse"); icon: "folder"; }

                Divider {}

                // **Recently Played keeps index 8 and renders here**: the order follows the
                // source, so no persisted index moves.
                SidebarItem { index: 2;  label: @tr("Favorites");       icon: "favorite";       }
                SidebarItem { index: 8;  label: @tr("Recently Played"); icon: "history";        }
                SidebarItem { index: 3;  label: @tr("My Library");      icon: "library_music";  }

                // Past a divider, the one row that reaches the network. **The divider is gated
                // too**, or it doubles against the one above Settings. Two `if`s, since a wrapper
                // would still claim the column's spacing.
                if Settings.radio-enabled: Divider {}
                if Settings.radio-enabled: SidebarItem { index: 10; label: @tr("Radio"); icon: "radio"; }
            }
        }

        Divider {}

        SidebarItem { index: 9; label: @tr("Settings"); icon: "settings"; }
    }

    // Only meaningful when expanded.
    if !Nav.sidebar-rail: EdgeResizeHandle {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        grows: GrowEdge.right;
        drawn-width: Nav.sidebar-expanded-w;
        min-w: Theme.sidebar-min-w;
        // Past the room the sidebar would yield to its rail mid-drag, unmounting the handle under
        // the pointer and stranding `dragging`.
        max-w: clamp(root.room, Theme.sidebar-min-w, Theme.sidebar-max-w);
        dragging <=> Nav.sidebar-dragging;
        resized(width) => {
            Nav.sidebar-width = width;
        }
        reset => {
            Nav.sidebar-width = Theme.sidebar-default-w;
        }
    }

    // Flush with the sidebar's edge and level with `nav-scroll`. Expanded, it insets by the resize
    // handle's width, leaving that hit-area on the very edge.
    OverlayScrollbar {
        x: parent.width - self.width
            - (Nav.sidebar-rail ? 0px : 4px);
        y: nav-scroll.absolute-position.y - root.absolute-position.y;
        // Slimmer on the rail, off the icons.
        width: Nav.sidebar-rail ? 6px : Theme.scrollbar-slot;
        height: nav-scroll.height;
        bar-thickness: Nav.sidebar-rail ? 4px : 8px;
        bar-radius: Nav.sidebar-rail ? 2px : 4px;
        min-thumb: Nav.sidebar-rail ? 20px : 28px;
        visible-size: nav-scroll.visible-height;
        content-size: nav-scroll.content-height;
        offset: -nav-scroll.content-y;
        scroll-to(o) => {
            nav-scroll.content-y = -o;
        }
    }
}
