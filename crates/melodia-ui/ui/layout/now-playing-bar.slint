import { Theme } from "../theme.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { WindowChrome } from "../globals/shell.slint";
import { Settings } from "../settings.slint";
import { ContextClick } from "../components/context-menu.slint";
import { IconButton } from "../components/icon-button.slint";
import { MetaChip } from "../components/meta-chip.slint";
import { TrackContextMenu } from "../components/track-list/track-context-menu.slint";
import { SourceArtwork } from "../components/now-playing/source-artwork.slint";
import { SeekRow } from "../components/now-playing/seek-row.slint";
import { VolumePopup } from "../components/now-playing/volume-popup.slint";
import { OverflowMenu } from "../components/now-playing/overflow-menu.slint";
import { PlayButton } from "../components/now-playing/play-button.slint";
import { QueueButton } from "../components/now-playing/queue-button.slint";
import { QualityChip } from "../components/quality-chip.slint";
import { SignalPathUi } from "../globals/signal-path.slint";

export component NowPlayingBar inherits Rectangle {
    // Pinned with min/max and no stretch, or a short window hands the height to the layout above
    // and the bar drops below the edge.
    min-height: Theme.now-playing-h;
    max-height: Theme.now-playing-h;
    vertical-stretch: 0;
    background: WindowChrome.mantle;

    // Written from `changed width` rather than bound, so the sizes derived from it don't loop the
    // parent layout's `layoutinfo-h`.
    property <length> bar-w: 1100px;
    changed width => { self.bar-w = self.width; }

    // The mount seed that mirror owes, `changed` skipping a first layout at the final width.
    Timer {
        interval: 1ms;
        triggered => {
            root.bar-w = root.width;
            self.running = false;
        }
    }

    // Every standard button's, evaluated once per `bar-w` change rather than per use.
    out property <length> btn-d: clamp(root.bar-w * 0.05, 28px, 36px);
    out property <length> btn-icon-d: clamp(root.bar-w * 0.03, 18px, 20px);

    // No divider: the content panel's border draws the seam, following its corners.
    HorizontalLayout {
        padding-left: clamp(root.bar-w * 0.02, 10px, 16px);
        padding-right: clamp(root.bar-w * 0.02, 10px, 16px);
        spacing: clamp(root.bar-w * 0.015, 6px, 12px);
        alignment: stretch;

        // A Rectangle so it can clip bidi overflow; the text column's stretch is what lets
        // `elide` fire. **The whole cell is a button** toggling the full view, its TouchArea
        // declared last to sit above the content.
        track-info-cell := Rectangle {
            width: clamp(root.bar-w * 0.25, 120px, 200px);
            // Redundant, but spelled out beside the columns below that genuinely need it.
            horizontal-stretch: 0;
            clip: true;

            // A station opens the full view too.
            property <bool> has-source: Player.vm.has_track || Player.vm.has_station;
            // What the fill and the zoom read, so the cell stays lit under its own menu.
            property <bool> hovered: (track-info-touch.has-hover || track-menu.is-open)
                && track-info-cell.has-source;

            // Drives the fill and the content wrapper both, so they contract toward the centre
            // together. **Only the factor animates**: the cell re-clamps with `bar-w`, so easing
            // the derived sizes would wobble on every resize tick.
            property <float> press-scale: track-info-touch.pressed && track-info-cell.has-source
                ? 0.99
                : 1.0;
            animate press-scale {
                duration: track-info-touch.pressed ? 100ms : Theme.dur-med;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            // Inset off the bar's edges so it reads as a button, and recentred so it pulses in
            // place.
            Rectangle {
                width: parent.width * track-info-cell.press-scale;
                height: (parent.height - 12px) * track-info-cell.press-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-md;
                background: track-info-cell.hovered ? Theme.accent.with-alpha(0.12) : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; enabled: !Theme.recoloring; }
            }

            // Scaled as one block: per element, each would anchor to its own left edge.
            Rectangle {
                width: parent.width * track-info-cell.press-scale;
                height: parent.height * track-info-cell.press-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    // Keeps the tile off the hover fill's edge.
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: clamp(root.bar-w * 0.015, 6px, 10px);
                    alignment: start;
                    cross-axis-alignment: center;

                    SourceArtwork {
                        tile-size: clamp(root.bar-w * 0.07, 36px, 46px);
                        // The frame stays fixed; the cover scales within it.
                        cover-scale: track-info-cell.hovered ? 1.15 : 1.0;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        // `Player` owns the track-or-station ladder and the LRM keeping elide's
                        // `…` on the right for RTL scripts.
                        Text {
                            text: Player.source-title;
                            color: Theme.text;
                            font-size: Theme.font-size-sm;
                            font-weight: 500;
                            overflow: elide;
                        }
                        Text {
                            text: Player.source-subtitle;
                            color: Theme.text;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Text {
                            // The album for a track, the station's country for a stream.
                            text: Player.source-tertiary;
                            // Size and weight separate the three lines, not colour.
                            color: Theme.text;
                            font-size: 11px;
                            overflow: elide;
                            visible: Player.source-tertiary != "";
                        }
                    }
                }
            }

            track-info-touch := TouchArea {
                mouse-cursor: track-info-cell.has-source ? pointer : default;
                enabled: track-info-cell.has-source;
                // Owed by the close: the view under Now Playing is a fresh `ViewTransition`
                // mount, entering from wherever the last drill left the edge otherwise.
                // Unconditional, the open reading nothing.
                clicked => {
                    Nav.pending-enter-from = NavEnterFrom.above;
                    Nav.now-playing-open = !Nav.now-playing-open;
                }
                // A station has no `tracks` row for the menu to act on.
                pointer-event(ev) => {
                    if (Player.vm.has_track
                        && ContextClick.raises-menu(ev, self.mouse-x, self.mouse-y, self.width, self.height)) {
                        track-menu.show-at(self.mouse-x, self.mouse-y);
                    }
                }
            }

            // The row menu with the playing track as its row. A sibling of the TouchArea, so the
            // popup's frame is the cell's, the one `mouse-x` reports in.
            track-menu := TrackContextMenu {
                row-id: Player.vm.track.id;
                row-is-favorite: Player.vm.track.is_favorite;
                row-rating: Player.vm.track.rating;
                album-id: Player.track-album-id;
                artist-id: Player.track-artist-id;
                genre-id: Player.track-genre-id;
                view-context: "now-playing";
                // The bar's own heart and stars, each also repainting every list showing it.
                toggle-favorite(ids, on) => { Player.toggle-favorite(); }
                rate(ids, n) => { Player.set-current-rating(n); }
            }
        }

        // Stretch 0, or this column takes a share of the surplus only the slider should get.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;
                cross-axis-alignment: center;

                IconButton {
                    icon: "chevron_left";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    button-enabled: Player.vm.has_previous;
                    hold-delay: Player.scan-hold;
                    repeat-interval: Player.scan-interval;
                    tooltip-text: Player.previous-tooltip;
                    clicked => { Player.previous(); }
                    held(step) => { Player.scan-step(-1, step); }
                }

                // The glyph is punched out in the bar's own fill.
                PlayButton {
                    wrapper-d: clamp(root.bar-w * 0.055, 30px, 38px);
                    icon-size: clamp(root.bar-w * 0.025, 14px, 20px);
                    icon-color: WindowChrome.mantle;
                    is-playing: Player.vm.is_playing;
                    is-stopped: Player.stopped-at-top;
                    animation-mode: Settings.play-button-animation-idx;
                    hold-delay: Player.stop-hold;
                    clicked => { Player.play-pause(); }
                    held => { Player.stop(); }
                }

                IconButton {
                    icon: "chevron_right";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    button-enabled: Player.vm.has_next;
                    hold-delay: Player.scan-hold;
                    repeat-interval: Player.scan-interval;
                    tooltip-text: Player.next-tooltip;
                    clicked => { Player.next(); }
                    held(step) => { Player.scan-step(1, step); }
                }
            }
        }

        // The inner row keeps the default `alignment: stretch`, which lets the slider expand.
        VerticalLayout {
            alignment: center;
            min-width: 140px;
            horizontal-stretch: 2;

            // The bar's own fill as the mask, so it disappears against it focused or not.
            if !Player.vm.has_station: SeekRow {
                seam-mask-color: WindowChrome.mantle;
            }

            // A stream has no timeline, but how long the connection has run is worth stating; the
            // pill carries the connection's state.
            if Player.vm.has_station: HorizontalLayout {
                spacing: Theme.pad-sm;
                alignment: center;
                cross-axis-alignment: center;

                MetaChip {
                    text: Player.live-label;
                    fill: Theme.accent.with-alpha(0.18);
                    label-color: Theme.accent;
                }

                Text {
                    text: Theme.format-duration(Player.position-ms);
                    color: Theme.text;
                    font-size: 11px;
                    min-width: 40px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }

        // Pinned like the transport, so a button routed into the overflow menu frees its space
        // to the slider.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: clamp(root.bar-w * 0.005, 0px, 2px);
                alignment: end;
                cross-axis-alignment: center;

                // `if`, so a button moved into the overflow menu vacates its slot. The chip's
                // padding is the gap this row's spacing is too tight to give it.
                if SignalPathUi.chip-shown && !Settings.overflow-quality: VerticalLayout {
                    padding-right: Theme.pad-sm;
                    QualityChip { }
                }
                if !Settings.overflow-repeat: IconButton {
                    icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    active: Player.queue.repeat_mode != "off";
                    tooltip-text: Player.queue.repeat_mode == "off"
                        ? @tr("Repeat: off")
                        : (Player.queue.repeat_mode == "one"
                            ? @tr("Repeat: one")
                            : @tr("Repeat: all"));
                    clicked => { Player.cycle-repeat(); }
                }
                if !Settings.overflow-shuffle: IconButton {
                    icon: "shuffle";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    active: Player.queue.shuffle;
                    tooltip-text: Player.queue.shuffle ? @tr("Shuffle: on") : @tr("Shuffle: off");
                    clicked => { Player.toggle-shuffle(); }
                }
                if !Settings.overflow-favorite: IconButton {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    active: Player.vm.track.is_favorite;
                    filled: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    tooltip-text: Player.vm.track.is_favorite ? @tr("Unfavorite") : @tr("Favorite");
                    clicked => { Player.toggle-favorite(); }
                }
                if WindowChrome.always-on-top-supported && !Settings.overflow-pin: IconButton {
                    icon: "push_pin";
                    press-shrink: true;
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                    active: WindowChrome.always-on-top-active;
                    filled: WindowChrome.always-on-top-active;
                    tooltip-text: WindowChrome.always-on-top-active ? @tr("Unpin from Top") : @tr("Pin on Top");
                    clicked => { WindowChrome.toggle-always-on-top(); }
                }
                // In the overflow menu it takes no drop: a drag's opening press shuts the menu.
                if !Settings.overflow-queue: QueueButton {
                    diameter: root.btn-d;
                    icon-size: root.btn-icon-d;
                }
                VolumePopup {
                    diameter: root.btn-d;
                    icon-size: clamp(root.bar-w * 0.035, 22px, 22px);
                }
                // Always mounted: it houses the speed flyout, which is never inline.
                OverflowMenu { bar-w: root.bar-w; }
            }
        }
    }
}
