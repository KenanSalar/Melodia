#: ui/views/settings/ratings-section.slint
msgid "Save ratings to files"
msgstr "Αποθήκευση βαθμολογιών στα αρχεία"

#: ui/views/settings/ratings-section.slint
msgid "Write star ratings into each file's tags, so they survive a rescan and other players can read them."
msgstr "Γράφει τις βαθμολογίες με αστέρια στις ετικέτες κάθε αρχείου, ώστε να διατηρούνται μετά από νέα σάρωση και να μπορούν να τις διαβάσουν άλλα προγράμματα αναπαραγωγής."

#: ui/views/settings/scrobbling-section.slint
msgid "Last.fm"
msgstr "Last.fm"

#: ui/views/settings/scrobbling-section.slint
msgid "Scrobble to Last.fm"
msgstr "Scrobble στο Last.fm"

#: ui/views/settings/scrobbling-section.slint
msgid "Report each play to your Last.fm account"
msgstr "Αναφορά κάθε αναπαραγωγής στον λογαριασμό σας στο Last.fm"

#: ui/views/settings/scrobbling-section.slint
msgid "Sync loved tracks to Last.fm"
msgstr "Συγχρονισμός αγαπημένων κομματιών με το Last.fm"

#: ui/views/settings/scrobbling-section.slint
msgid "Mark tracks you love as loved on Last.fm — turning this on syncs your existing favorites"
msgstr "Σημειώστε ως αγαπημένα στο Last.fm τα κομμάτια που αγαπάτε — η ενεργοποίηση συγχρονίζει τα υπάρχοντα αγαπημένα σας"

#: ui/views/settings/scrobbling-section.slint
msgid "ListenBrainz"
msgstr "ListenBrainz"

#: ui/views/settings/scrobbling-section.slint
msgid "Scrobble to ListenBrainz"
msgstr "Scrobble στο ListenBrainz"

#: ui/views/settings/scrobbling-section.slint
msgid "Report each play to your ListenBrainz account"
msgstr "Αναφορά κάθε αναπαραγωγής στον λογαριασμό σας στο ListenBrainz"

#: ui/views/settings/scrobbling-section.slint
msgid "Sync loved tracks to ListenBrainz"
msgstr "Συγχρονισμός αγαπημένων κομματιών με το ListenBrainz"

#: ui/views/settings/scrobbling-section.slint
msgid "Mark tracks you love as loved on ListenBrainz — turning this on syncs your existing favorites (needs MusicBrainz IDs)"
msgstr "Σημειώστε ως αγαπημένα στο ListenBrainz τα κομμάτια που αγαπάτε — η ενεργοποίηση συγχρονίζει τα υπάρχοντα αγαπημένα σας (απαιτεί αναγνωριστικά MusicBrainz)"

#: ui/views/settings/scrobbling-section.slint
msgid "MusicBrainz Picard adds these IDs to your files, identifying each track by its audio."
msgstr "Το MusicBrainz Picard προσθέτει αυτά τα αναγνωριστικά στα αρχεία σας, αναγνωρίζοντας κάθε κομμάτι από τον ήχο του."

#: ui/views/settings/scrobbling-section.slint
msgid "Scrobble radio songs"
msgstr "Scrobble τραγουδιών από το ραδιόφωνο"

#: ui/views/settings/scrobbling-section.slint
msgid "Songs heard in full on a station go to your connected scrobbling services"
msgstr "Τα τραγούδια που ακούστηκαν ολόκληρα σε έναν σταθμό στέλνονται στις συνδεδεμένες υπηρεσίες scrobbling"

#: ui/views/settings/scrobbling-section.slint
msgid "Connected as {}"
msgstr "Συνδεδεμένος ως {}"

#: ui/views/settings/scrobbling-section.slint
msgid "Not configured in this build"
msgstr "Δεν έχει ρυθμιστεί σε αυτήν την έκδοση"

#: ui/views/settings/scrobbling-section.slint
msgid "Connect Last.fm"
msgstr "Σύνδεση Last.fm"

#: ui/views/settings/scrobbling-section.slint
msgid "Disconnect"
msgstr "Αποσύνδεση"

#: ui/views/settings/scrobbling-section.slint
msgid "Connect ListenBrainz"
msgstr "Σύνδεση ListenBrainz"

#: ui/views/settings/scrobbling-section.slint
msgid "Turn on Last.fm or ListenBrainz above first"
msgstr "Ενεργοποιήστε πρώτα το Last.fm ή το ListenBrainz παραπάνω"

#: ui/views/settings/settings-tabs.slint
msgid "No matching settings"
msgstr "Καμία ρύθμιση δεν ταιριάζει"

#: ui/views/settings/update-section.slint
msgid "Updates"
msgstr "Ενημερώσεις"

#: ui/views/settings/update-section.slint
msgid "Software Updates"
msgstr "Ενημερώσεις λογισμικού"

#: ui/views/settings/update-section.slint
msgid "Current version: {}"
msgstr "Τρέχουσα έκδοση: {}"

#: ui/views/settings/update-section.slint
msgid "You're up to date!"
msgstr "Είσαι ενημερωμένος!"

#: ui/views/settings/update-section.slint
msgid "Melodia {} is the latest version."
msgstr "Η Melodia {} είναι η τελευταία έκδοση."

#: ui/views/settings/update-section.slint
msgid "Update Installed"
msgstr "Η ενημέρωση εγκαταστάθηκε"

#: ui/views/settings/update-section.slint
msgid "Restart Melodia to apply the update"
msgstr "Επανεκκίνησε τη Melodia για να εφαρμοστεί η ενημέρωση"

#: ui/views/settings/update-section.slint
msgid "Version {} Available"
msgstr "Διαθέσιμη η έκδοση {}"

#: ui/views/settings/update-section.slint
msgid "Updates managed by your package manager"
msgstr "Οι ενημερώσεις διαχειρίζονται από τον διαχειριστή πακέτων σας"

#: ui/views/settings/update-section.slint
msgid "Re-run the latest .msi installer from the Releases page."
msgstr "Εκτελέστε ξανά τον τελευταίο εγκαταστάτη .msi από τη σελίδα Releases."

#: ui/views/settings/update-section.slint
msgid "Use brew upgrade melodia."
msgstr "Χρησιμοποιήστε brew upgrade melodia."

#: ui/views/settings/update-section.slint
msgid "Use sudo dnf update melodia (or your distro equivalent)."
msgstr "Χρησιμοποιήστε sudo dnf update melodia (ή το αντίστοιχο της διανομής σας)."

#: ui/views/settings/update-section.slint
msgid "Check for Updates"
msgstr "Έλεγχος για ενημερώσεις"

#: ui/views/settings/update-section.slint
msgid "Checking..."
msgstr "Έλεγχος..."

#: ui/views/settings/update-section.slint
msgid "Restart Now"
msgstr "Επανεκκίνηση τώρα"

#: ui/views/settings/update-section.slint
msgid "Download & Install"
msgstr "Λήψη και εγκατάσταση"

#: ui/views/settings/update-section.slint
msgid "Installing..."
msgstr "Εγκατάσταση..."

#: ui/views/settings/update-section.slint
msgid "Skip this version"
msgstr "Παράλειψη αυτής της έκδοσης"

#: ui/views/settings/update-section.slint
msgid "Critical update"
msgstr "Κρίσιμη ενημέρωση"

#: ui/views/settings/update-section.slint
msgid "This update fixes a critical issue and can't be skipped."
msgstr "Αυτή η ενημέρωση διορθώνει ένα κρίσιμο πρόβλημα και δεν μπορεί να παραλειφθεί."

#: ui/views/settings/window-chrome-section.slint
msgid "Window"
msgstr "Παράθυρο"

#: ui/views/settings/window-chrome-section.slint
msgid "Managed by the operating system"
msgstr "Διαχειρίζεται από το λειτουργικό σύστημα"

#: ui/views/settings/window-chrome-section.slint
msgid "Native Title Bar"
msgstr "Εγγενής γραμμή τίτλου"

#: ui/views/settings/window-chrome-section.slint
msgid "Use the operating system's native title bar instead of the custom one. Restart required to apply."
msgstr "Χρήση της εγγενούς γραμμής τίτλου του λειτουργικού συστήματος αντί της προσαρμοσμένης. Απαιτείται επανεκκίνηση για εφαρμογή."

#: ui/views/settings/window-chrome-section.slint
msgid "Match Unfocused Window Background"
msgstr "Αντιστοίχιση φόντου μη εστιασμένου παραθύρου"

#: ui/views/settings/window-chrome-section.slint
msgid "Only available with the native title bar."
msgstr "Διαθέσιμο μόνο με την εγγενή γραμμή τίτλου."

#: ui/views/settings/window-chrome-section.slint
msgid "Tint the sidebar and now-playing bar toward the content background when the window loses focus."
msgstr "Χρωμάτισε την πλευρική γραμμή και τη γραμμή αναπαραγωγής προς το φόντο του περιεχομένου όταν το παράθυρο χάνει την εστίαση."

#: ui/views/settings/window-chrome-section.slint
msgid "Window Corner Radius"
msgstr "Ακτίνα γωνίας παραθύρου"

#: ui/views/settings/window-chrome-section.slint
msgid "Window Border"
msgstr "Περίγραμμα παραθύρου"

#: ui/views/settings/window-chrome-section.slint
msgid "Draw a thin outline around the miniplayer. The full window keeps the border of its system frame."
msgstr "Σχεδιάζει ένα λεπτό περίγραμμα γύρω από τον μίνι αναπαραγωγέα. Το πλήρες παράθυρο διατηρεί το περίγραμμα του πλαισίου συστήματος."

#: ui/views/settings/window-chrome-section.slint
msgid "Draw a thin outline around the whole window, the miniplayer included."
msgstr "Σχεδιάζει ένα λεπτό περίγραμμα γύρω από ολόκληρο το παράθυρο, μαζί με τον μίνι αναπαραγωγέα."

#: ui/views/settings/window-chrome-section.slint
msgid "Window Border Color"
msgstr "Χρώμα περιγράμματος παραθύρου"

#: ui/views/settings/window-chrome-section.slint
msgid "System follows the color the operating system draws its own window borders in."
msgstr "Το Σύστημα ακολουθεί το χρώμα με το οποίο το λειτουργικό σύστημα σχεδιάζει τα δικά του περιγράμματα παραθύρων."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the window border is shown."
msgstr "Διαθέσιμο μόνο όταν εμφανίζεται το περίγραμμα παραθύρου."

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Style"
msgstr "Στιλ κουμπιών διακόσμησης"

#: ui/views/settings/window-chrome-section.slint
msgid "Decoration Button Side"
msgstr "Πλευρά κουμπιών διακόσμησης"

#: ui/views/settings/window-chrome-section.slint
msgid "System Tray Icon"
msgstr "Εικονίδιο περιοχής ειδοποιήσεων"

#: ui/views/settings/window-chrome-section.slint
msgid "Show a Melodia icon in the system tray with playback controls."
msgstr "Εμφάνιση εικονιδίου Melodia στην περιοχή ειδοποιήσεων με στοιχεία ελέγχου αναπαραγωγής."

#: ui/views/settings/window-chrome-section.slint
msgid "Close to Tray"
msgstr "Κλείσιμο στην περιοχή ειδοποιήσεων"

#: ui/views/settings/window-chrome-section.slint
msgid "Keep Melodia running in the system tray when you close the window, instead of quitting."
msgstr "Διατήρηση της εκτέλεσης του Melodia στην περιοχή ειδοποιήσεων κατά το κλείσιμο του παραθύρου, αντί για έξοδο."

#: ui/views/settings/window-chrome-section.slint
msgid "Available only while the system tray icon is active."
msgstr "Διαθέσιμο μόνο όταν το εικονίδιο περιοχής ειδοποιήσεων είναι ενεργό."

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the native title bar requires restarting Melodia. Restart now?"
msgstr "Η μετάβαση στην εγγενή γραμμή τίτλου απαιτεί επανεκκίνηση της Melodia. Επανεκκίνηση τώρα;"

#: ui/views/settings/window-chrome-section.slint
msgid "Switching to the custom title bar requires restarting Melodia. Restart now?"
msgstr "Η μετάβαση στην προσαρμοσμένη γραμμή τίτλου απαιτεί επανεκκίνηση της Melodia. Επανεκκίνηση τώρα;"

#: ui/views/settings/window-chrome-section.slint
msgid "Square"
msgstr "Τετράγωνο"

#: ui/views/settings/window-chrome-section.slint
msgid "Left"
msgstr "Αριστερά"

#: ui/views/settings/window-chrome-section.slint
msgid "Right"
msgstr "Δεξιά"

#: ui/views/settings/window-chrome-section.slint
msgid "Changing the system tray icon requires restarting Melodia. Restart now?"
msgstr "Η αλλαγή του εικονιδίου περιοχής ειδοποιήσεων απαιτεί επανεκκίνηση του Melodia. Επανεκκίνηση τώρα;"
