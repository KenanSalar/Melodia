<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for customization of this template. The values for each variable are set at
  installer creation time. The following variables are available:

  TargetTriple      = The rustc target triple name.
  TargetEnv         = The rustc target environment. This is typically either
                      "msvc" or "gnu" depending on the toolchain downloaded and
                      installed.
  TargetVendor      = The rustc target vendor. This is typically "pc", but Rust
                      does support other vendors, like "uwp".
  CargoTargetBinDir = The complete path to the directory containing the
                      binaries (exes) to include. The default would be
                      "target\release\". If an explicit rustc target triple is
                      used, i.e. cross-compiling, then the default path would
                      be "target\<CARGO_TARGET>\<CARGO_PROFILE>",
                      where "<CARGO_TARGET>" is replaced with the "CargoTarget"
                      variable value and "<CARGO_PROFILE>" is replaced with the
                      value from the "CargoProfile" variable. This can also
                      be overridden manually with the "target-bin-dir" flag.
  CargoTargetDir    = The path to the directory for the build artifacts, i.e.
                      "target".
  CargoProfile      = The cargo profile used to build the binaries
                      (usually "debug" or "release").
  Version           = The version for the installer. The default is the
                      "Major.Minor.Fix" semantic versioning number of the Rust
                      package.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!--
      cargo-wix's variables all point into `target/`, and there is none for the
      repo. `sys.SOURCEFILEDIR` is the directory of *this* file (WiX appends the
      separator itself), so `..` is the repo root without going through the
      working directory. Every repo-relative source in this file spells it —
      including the product icon, which was a bare `assets\melodia.ico` and
      worked only because cargo-wix happens to run from the package root.
    -->
    <?define RepoRoot = $(sys.SOURCEFILEDIR).. ?>

    <Package Name="Melodia" UpgradeCode="D79812BC-9AE2-42C4-8D1B-418DB5A537B6" Manufacturer="Kenan Salar" Language="1033" Codepage="65001" Version="$(var.Version)" InstallerVersion="500" Scope="perMachine"><!--
          Per-machine MSI. Installs to `C:\Program Files\Melodia\` (or
          `Program Files (x86)\` on 32-bit hosts via the
          `ProgramFiles6432Folder` standard directory below). Triggers a
          UAC prompt at install — the user has explicitly opted into
          machine-wide installs for Start Menu / Windows Search
          discoverability and the matching native-app feel.

          `Package/@Scope='perMachine'` is enough on its own — WiX sets
          `ALLUSERS=1` and flips the Word Count summary bit
          ("elevated privileges required") implicitly. The
          `ALLUSERS=2 + MSIINSTALLPERUSER=1` Property pair that earlier
          revisions of this file carried is for *dual-purpose* packages
          (Microsoft "Single Package Authoring"); mixing patterns
          trips ICE105 during validation, so it's omitted here.

          The in-app updater self-updates by downloading the next signed
          MSI from `latest.json`, then invoking `msiexec /i` — UAC
          prompts again, `MajorUpgrade` below replaces this version, and
          `util:RestartResource` registers the running `Melodia.exe`
          with Windows Installer's Restart Manager so the upgrade
          doesn't need a reboot. See `src/services/updater/install/`.
        -->
        <!--
          SummaryInformation/@Codepage must be a Windows ANSI code page;
          UTF-8 (65001) is rejected by WiX (WIX0349). 1252 = Western
          European, matches Language="1033" (en-US) above and covers
          every char in our summary strings.
        -->
        <SummaryInformation Keywords="Installer" Description="Cross-platform desktop music player (Slint + Rust)" Manufacturer="Kenan Salar" Codepage="1252" />

        <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
        <Property Id="DiskPrompt" Value="Melodia Installation" />

        <!--
          `C:\Program Files\Melodia\bin\Melodia.exe` — the standard
          per-machine layout. `ProgramFiles6432Folder` resolves to
          `Program Files` on 64-bit hosts and `Program Files (x86)` on
          32-bit — correct per-arch automatically without forking the
          WiX file by target triple.
        -->
        

        <Feature Id="Binaries" Title="Application" Description="Installs all binaries and the licenses." Level="1" ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Display="expand" AllowAbsent="no">

            <ComponentRef Id="AppLicense" />
            <ComponentRef Id="ThirdPartyLicenses" />
            <ComponentRef Id="binary0" />
            <ComponentRef Id="StartMenuShortcut" />
            <ComponentRef Id="FileAssociations" />

            <Feature Id="Environment" Title="PATH Environment Variable" Description="Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location." Level="1">
                <ComponentRef Id="Path" />
            </Feature>
        </Feature>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />

        
        <!--
          Product icon shown in Add/Remove Programs ("Apps & features"
          on Windows 10+) and on the Start Menu shortcut. Shares the
          checked-in `assets\melodia.ico` with `build.rs`, which embeds
          the same multi-resolution ICO into Melodia.exe as the EXE's
          primary `ICON` resource (the source Windows pulls for the
          taskbar, titlebar, Alt-Tab thumbnail, and Explorer entry).
          Single source of truth across every shell surface — a logo
          change updates the EXE, MSI, ARP, Start Menu shortcut, and
          running-window icon in one place. To regenerate from the
          WITH-background brand SVG:
              magick -density 384 -background none \
                assets/icons/logo-with-background.svg \
                -define icon:auto-resize=256,128,96,64,48,32,24,16 \
                assets/melodia.ico
        -->
        <Icon Id="ProductICO" SourceFile="$(var.RepoRoot)\assets\melodia.ico" />
        <Property Id="ARPPRODUCTICON" Value="ProductICO" />

        <!--
          Add/Remove Programs links. All three point at the repo today —
          when a dedicated landing page or changelog URL exists, point
          ARPURLINFOABOUT and ARPURLUPDATEINFO there respectively.
        -->
        <Property Id="ARPHELPLINK" Value="https://github.com/KenanSalar/Melodia" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/KenanSalar/Melodia" />
        <Property Id="ARPURLUPDATEINFO" Value="https://github.com/KenanSalar/Melodia/releases" />
        
        <UI>
            <ui:WixUI Id="WixUI_FeatureTree" />
            
            <!--
              Enabling the EULA dialog in the installer is a three step process:

                1. Comment out or remove the two `Publish` tags that follow the
                   `WixVariable` tag.
                2. Uncomment the `<WixVariable Id='WixUILicenseRtf' Value='Path\to\Eula.rft'>` tag further down
                3. Replace the `Value` attribute of the `WixVariable` tag with
                   the path to a RTF file that will be used as the EULA and
                   displayed in the license agreement dialog.
            -->
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="99" />
            <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />

        </UI>

        
        <!--
          Enabling the EULA dialog in the installer requires uncommenting
          the following `WixUILicenseRTF` tag and changing the `Value`
          attribute.
        -->
        <!-- <WixVariable Id='WixUILicenseRtf' Value='Relative\Path\to\Eula.rtf'/> -->

        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom banner image across
          the top of each screen. See the WiX Toolset documentation for details
          about customization.

          The banner BMP dimensions are 493 x 58 pixels.
        -->
        <!--<WixVariable Id='WixUIBannerBmp' Value='wix\Banner.bmp'/>-->

        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom image to the first
          dialog, or screen. See the WiX Toolset documentation for details about
          customization.

          The dialog BMP dimensions are 493 x 312 pixels.
        -->
        <!--<WixVariable Id='WixUIDialogBmp' Value='wix\Dialog.bmp'/>-->

    
            <StandardDirectory Id="ProgramFiles6432Folder">
                <Directory Id="APPLICATIONFOLDER" Name="Melodia">
                    <!--
                      Melodia's own licence, at the install root where the
                      convention puts it. A component belongs to exactly one
                      directory, which is why the third-party texts below are a
                      second component rather than three more Files here.

                      Explicit GUIDs (WIX0230) on both, stable across releases
                      so MajorUpgrade replaces rather than duplicates them —
                      the `binary0` reasoning further down. First File in each
                      is the KeyPath; per-machine ICE rules take a File keypath
                      directly.
                    -->
                    <Component Id="AppLicense" Guid="22687C47-514D-4454-8B81-38B5B1FF9B27">
                        <File Id="AgplLicense" Name="LICENSE" KeyPath="yes" DiskId="1" Source="$(var.RepoRoot)\LICENSE" />
                    </Component>
                    <!--
                      The bundled fonts and the vendored winit fork are all
                      compiled into Melodia.exe, so this MSI redistributes them
                      and owes their licence text — Apache-2.0 §4(a) outright.
                      Every other format globs the directory; WiX needs each file
                      named, so this is the one place a fourth entry in
                      `licenses/` costs an edit. Two pins hold that, and they
                      answer different questions:
                      `every_package_format_ships_the_licenses_dir` catches this
                      file dropping the directory entirely, and
                      `the_msi_names_every_licence_file` walks `licenses/` and
                      fails on any file that isn't a `<File>` below — so the
                      edit is a red test rather than a note someone has to read.
                      Apache-2.0.txt
                      covers two of the three bundled works (Material Symbols and
                      winit) and is deliberately shipped once — the text is the
                      same and a second copy would only be one more thing to keep
                      in step.
                    -->
                    <Directory Id="LicenseDir" Name="licenses">
                        <Component Id="ThirdPartyLicenses" Guid="5E7B947C-120B-4675-898E-21152E128358">
                            <File Id="Attribution" Name="ATTRIBUTION.txt" KeyPath="yes" DiskId="1" Source="$(var.RepoRoot)\licenses\ATTRIBUTION.txt" />
                            <File Id="VazirmatnOfl" Name="Vazirmatn-OFL-1.1.txt" DiskId="1" Source="$(var.RepoRoot)\licenses\Vazirmatn-OFL-1.1.txt" />
                            <File Id="Apache20" Name="Apache-2.0.txt" DiskId="1" Source="$(var.RepoRoot)\licenses\Apache-2.0.txt" />
                        </Component>
                    </Directory>
                    <Directory Id="Bin" Name="bin">
                        <!--
                          Per-machine PATH update. `System="yes"` writes
                          to the machine-wide PATH (HKLM
                          `SYSTEM\CurrentControlSet\Control\Session
                          Manager\Environment`) so every user on the box
                          sees the addition. HKLM registry keypath
                          satisfies ICE38/ICE57 for the per-machine
                          uninstaller; the value carries no semantic
                          meaning beyond "this machine has Melodia's
                          PATH component installed."
                        -->
                        <Component Id="Path" Guid="08538C83-6038-45CA-B3AC-8A932AD78B0D">
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Components" Name="Path" Type="integer" Value="1" KeyPath="yes" />
                            <Environment Id="PATH" Name="PATH" Value="[Bin]" Permanent="no" Part="last" Action="set" System="yes" />
                        </Component>
                        <!--
                          Explicit GUID (WIX0230) — auto-gen ("*") is
                          disqualified when a Component pairs a child
                          File with anything else. The GUID is stable
                          across releases so MajorUpgrade can correctly
                          replace this component on version bumps.
                          File is the implicit KeyPath (no
                          RegistryValue here — per-machine ICE rules
                          accept a File keypath directly, unlike the
                          per-user case where HKCU registry keypath
                          was required).
                        -->
                        <Component Id="binary0" Guid="B7E62D11-9C13-4DF8-A23B-F1E5C9A4D826">
                            <File Id="exe0" Name="Melodia.exe" KeyPath="yes" DiskId="1" Source="$(var.CargoTargetBinDir)\Melodia.exe" />
                            <!--
                              Register Melodia.exe with Windows
                              Installer's Restart Manager so a
                              major-upgrade install (in-app updater
                              flow: `msiexec /i melodia-X.Y.Z.msi`)
                              while the app is running can cleanly
                              close + re-launch it instead of bouncing
                              to the "files in use" prompt and asking
                              for a reboot. Requires WixUtilExtension
                              at link time; cargo-wix includes it by
                              default.
                            -->
                            <util:RestartResource Id="MelodiaProcess" ProcessName="Melodia.exe" />
                        </Component>
                        <!--
                          Audio file associations, as plain RegistryValues
                          rather than WiX's ProgId / Extension / Verb:
                          those predate Vista, produce none of the
                          Capabilities + RegisteredApplications keys
                          Windows 10/11 reads for Default apps, and
                          `Extension` claims `HKCR\.mp3`'s default
                          outright — seizing a file type without asking.
                          Nothing here takes a default; it makes Melodia
                          offerable and the user picks.

                          KeyPath as `Path` / `StartMenuShortcut` above.

                          One ProgId across every extension rather than
                          one apiece: the cost is a generic "Audio File" in
                          Explorer's Type column, against a further four
                          rows per extension all needing to stay in step
                          with `media::AUDIO_EXTENSIONS`. The list is
                          pinned against that constant by
                          `services::tests::the_msi_offers_every_audio_extension`.
                        -->
                        <Component Id="FileAssociations" Guid="3C1F84A0-6D25-4E9B-9A73-0B5E2C8F41D7">
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Components" Name="FileAssociations" Type="integer" Value="1" KeyPath="yes" />

                            <RegistryValue Root="HKLM" Key="Software\Classes\Melodia.AssocFile.Audio" Value="Audio File" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Melodia.AssocFile.Audio\DefaultIcon" Value="[#exe0],0" Type="string" />
                            <!--
                              `Player` hands a whole multi-selection to one
                              invocation; without it the shell launches one
                              process per file and stops offering the verb
                              past a handful.
                            -->
                            <RegistryValue Root="HKLM" Key="Software\Classes\Melodia.AssocFile.Audio\shell\open" Name="MultiSelectModel" Value="Player" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Melodia.AssocFile.Audio\shell\open\command" Value="&quot;[#exe0]&quot; &quot;%1&quot;" Type="string" />

                            <!-- The "Open with" route, independent of any default. -->
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe" Name="FriendlyAppName" Value="Melodia" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\shell\open\command" Value="&quot;[#exe0]&quot; &quot;%1&quot;" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".m4a" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".m4b" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".aac" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".ogg" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".oga" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".aifc" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".mka" Value="" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Melodia.exe\SupportedTypes" Name=".caf" Value="" Type="string" />

                            <!--
                              ApplicationDescription is required, not
                              decorative: without it Windows leaves the app
                              out of the Default apps list entirely and
                              every key below becomes unreachable.
                            -->
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities" Name="ApplicationName" Value="Melodia" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities" Name="ApplicationDescription" Value="Cross-platform desktop music player." Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".mp3" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".flac" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".m4a" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".m4b" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".aac" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".ogg" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".oga" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".wav" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".aiff" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".aif" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".aifc" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".mka" Value="Melodia.AssocFile.Audio" Type="string" />
                            <RegistryValue Root="HKLM" Key="Software\Melodia\Capabilities\FileAssociations" Name=".caf" Value="Melodia.AssocFile.Audio" Type="string" />

                            <!-- Where Windows looks for the block above. -->
                            <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Melodia" Value="Software\Melodia\Capabilities" Type="string" />
                        </Component>
                    </Directory>
                </Directory>
            </StandardDirectory>

            <!--
              Start Menu shortcut so Melodia appears in Windows Search
              and the All Apps list, alongside other native-installed
              apps. Without this, even a per-machine MSI wouldn't show
              up under Start → Melodia. Lives under `ProgramMenuFolder`
              (the all-users Start Menu since this is a per-machine
              install); WiX resolves `[#exe0]` to the installed path of
              the File with Id `exe0` (the Melodia.exe component above)
              at install time, so this entry stays correct if the
              install directory is customised.

              HKLM registry keypath satisfies ICE38/ICE57 for the
              per-machine uninstaller — the shortcut itself can't be a
              KeyPath (WiX shortcuts aren't valid keypath candidates),
              and a registry value is the conventional substitute. Its
              integer value carries no semantic meaning.
            -->
            <StandardDirectory Id="ProgramMenuFolder">
                <Component Id="StartMenuShortcut" Guid="8F4C7E2A-5B91-4D63-A8F5-9C2E7D1B4A86">
                    <Shortcut Id="MelodiaStartMenuShortcut" Name="Melodia" Description="Cross-platform desktop music player" Target="[#exe0]" WorkingDirectory="Bin" Icon="ProductICO" />
                    <RegistryValue Root="HKLM" Key="Software\Melodia\Components" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </StandardDirectory>
        </Package>

</Wix>
