# ---- Notifications -----------------------------------------------------------

# Surfaced as a transient warning when the user disables the file-watching
# toggle in Settings; clears automatically when they re-enable it.
msgid "File watching disabled"
msgstr "Surveillance des fichiers désactivée"

msgid "Tracks won't reflect disk changes until you re-enable it."
msgstr "Les morceaux ne refléteront pas les modifications du disque tant que vous ne réactiverez pas cette option."

# Surfaced as a transient info toast when the file watcher reports a
# kernel-queue overflow (notify Flag::Rescan) and the app reconciles
# every enabled folder against disk to catch missed events.
msgid "Library re-syncing"
msgstr "Resynchronisation de la bibliothèque"

msgid "Filesystem event burst — rescanning your folders."
msgstr "Rafale d'événements du système de fichiers — nouveau scan de vos dossiers."

