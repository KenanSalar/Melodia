# ---- Playback section -------------------------------------------------------

msgid "Playback"
msgstr "Reproducción"

msgid "Gapless Playback"
msgstr "Reproducción sin pausas"

msgid "Seamless transitions between tracks without silence gaps"
msgstr "Transiciones fluidas entre pistas sin silencios"

msgid "Play Button Animation"
msgstr "Animación del botón de reproducción"

msgid "Visual effect on the play button while music is playing"
msgstr "Efecto visual en el botón de reproducción mientras suena la música"

# Animation preset names. "None" stays a generic English UI word in the
# fallback context — we translate it; the others are coined terms / proper
# nouns within the Material 3 motion vocabulary that we keep verbatim
# alongside their localised counterparts where natural.
msgid "None"
msgstr "Ninguna"

msgid "Equalizer"
msgstr "Ecualizador"

msgid "Resume on Startup"
msgstr "Reanudar al iniciar"

msgid "Automatically resume the last track from where you left off when the app starts"
msgstr "Reanuda automáticamente la última pista desde donde la dejaste al iniciar la aplicación"

msgid "Crossfade"
msgstr "Fundido encadenado"

msgid "Overlap the end of one track with the start of the next"
msgstr "Superpone el final de una pista con el principio de la siguiente"

msgid "Crossfade duration"
msgstr "Duración del fundido"

msgid "How long the two tracks overlap"
msgstr "Cuánto se superponen las dos pistas"

# Unit suffix for the crossfade-duration readout, e.g. "2 s".
msgid "{} s"
msgstr "{} s"

msgid "Except on the same album"
msgstr "Excepto dentro del mismo álbum"

msgid "Keep tracks from one album gapless, so continuous mixes stay seamless"
msgstr "Mantén sin pausas las pistas de un mismo álbum, para que las mezclas continuas sigan siendo fluidas"

msgid "Also on manual track change"
msgstr "También al cambiar de pista manualmente"

msgid "Crossfade when you skip to the next or previous track, not only at the end of one"
msgstr "Aplica el fundido al saltar a la pista siguiente o anterior, no solo al final de una"

msgid "Fade out on pause"
msgstr "Fundido al pausar"

msgid "Fade the music out when pausing or stopping, and back in when resuming"
msgstr "Baja la música al pausar o detener, y súbela de nuevo al reanudar"

