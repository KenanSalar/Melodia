# ---- Auto-updater (Settings → Updates + notification toasts) ----------------

msgid "Critical update"
msgstr "Actualización crítica"

msgid "This update fixes a critical issue and can't be skipped."
msgstr "Esta actualización corrige un problema crítico y no se puede omitir."

msgid "Skip this version"
msgstr "Omitir esta versión"

msgid "Updates managed by your package manager"
msgstr "Actualizaciones gestionadas por tu gestor de paquetes"

msgid "Use sudo dnf update melodia (or your distro equivalent)."
msgstr "Usa sudo dnf update melodia (o el equivalente de tu distribución)."

msgid "Re-run the latest .msi installer from the Releases page."
msgstr "Vuelve a ejecutar el último instalador .msi desde la página de Releases."

msgid "Use brew upgrade melodia."
msgstr "Usa brew upgrade melodia."

msgid "Update available"
msgstr "Actualización disponible"

msgid "Melodia {} is ready to install."
msgstr "Melodia {} está lista para instalarse."

msgid "Install"
msgstr "Instalar"

msgid "Update installed"
msgstr "Actualización instalada"

