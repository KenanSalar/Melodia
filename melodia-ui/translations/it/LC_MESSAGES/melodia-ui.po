# ---- Appearance section -----------------------------------------------------

msgid "Appearance"
msgstr "Aspetto"

msgid "Theme"
msgstr "Tema"

msgid "Theme Variant"
msgstr "Variante del tema"

# Theme Variant chips for non-Catppuccin themes (Dark/Light + synthetic System).
# Catppuccin's variant names (Latte/Frappe/Macchiato/Mocha) are proper nouns
# and stay verbatim across locales — only "System" is translatable on that path.
msgid "Dark"
msgstr "Scuro"

msgid "Light"
msgstr "Chiaro"

msgid "System"
msgstr "Sistema"

msgid "Accent Color"
msgstr "Colore d'accento"

msgid "Color Style"
msgstr "Stile colore"

msgid "Active — palette derived from the current track's artwork."
msgstr "Attivo — tavolozza derivata dalla copertina del brano corrente."

msgid "Generate theme colors from album artwork."
msgstr "Genera i colori del tema dalla copertina dell'album."

# Color Style chip labels (Material 3 dynamic-colour scheme variants). Order
# must match `services::material_you::SchemeStyle::all()` — "None" already
# translated above; remaining 7 below. Source: Tauri's `settings.ts` (de),
# kept verbatim so users moving between the apps see consistent vocabulary.

msgid "Tonal Spot"
msgstr "Tonal Spot"

msgid "Content"
msgstr "Contenuto"

msgid "Vibrant"
msgstr "Vibrante"

msgid "Expressive"
msgstr "Espressivo"

msgid "Fidelity"
msgstr "Fedeltà"

msgid "Neutral"
msgstr "Neutrale"

msgid "Monochrome"
msgstr "Monocromatico"

msgid "Aurora Backdrop"
msgstr "Sfondo aurora"

msgid "Paint album, playlist and Now Playing headers with a wash of the album's own colors, instead of a blurred copy of its cover art. Nothing needs blurring, so headers appear sooner and Melodia stays lighter. Restart required to apply."
msgstr "Colora le intestazioni di album, playlist e «In riproduzione» con i colori dell'album stesso, invece di una copia sfocata della sua copertina. Non c'è nulla da sfocare, quindi le intestazioni compaiono prima e Melodia resta più leggero. Richiede il riavvio."

msgid "Changing the backdrop style requires restarting Melodia. Restart now?"
msgstr "Per cambiare lo stile dello sfondo è necessario riavviare Melodia. Riavviare ora?"

# ---- Motion section ---------------------------------------------------------

msgid "Motion"
msgstr "Animazioni"

msgid "Skip Startup Animation"
msgstr "Salta l'animazione di avvio"

msgid "Open with the library already on screen, instead of fading and sliding it into place. A detail page you left open still expands into view once it loads."
msgstr "Apri con la libreria già visibile, invece di mostrarla con una dissolvenza e uno scorrimento. Una pagina di dettaglio che hai lasciato aperta si espande comunque al caricamento."

# Title of the window-chrome settings card.
msgid "Window"
msgstr "Finestra"

msgid "Native Title Bar"
msgstr "Barra del titolo nativa"

msgid "Use the operating system's native title bar instead of the custom one. Restart required to apply."
msgstr "Usa la barra del titolo nativa del sistema operativo invece di quella personalizzata. È necessario riavviare per applicare."

msgid "Restart Required"
msgstr "Riavvio necessario"

msgid "Switching to the native title bar requires restarting Melodia. Restart now?"
msgstr "Per passare alla barra del titolo nativa è necessario riavviare Melodia. Riavviare ora?"

msgid "Switching to the custom title bar requires restarting Melodia. Restart now?"
msgstr "Per passare alla barra del titolo personalizzata è necessario riavviare Melodia. Riavviare ora?"

msgid "Match Unfocused Window Background"
msgstr "Sincronizza sfondo finestra non attiva"

msgid "Only available with the native title bar."
msgstr "Disponibile solo con la barra del titolo nativa."

msgid "Tint the sidebar and now-playing bar toward the content background when the window loses focus."
msgstr "Colora la barra laterale e la barra di riproduzione con lo sfondo del contenuto quando la finestra perde il focus."

msgid "Window Corner Radius"
msgstr "Raggio degli angoli della finestra"

msgid "Managed by the operating system"
msgstr "Gestito dal sistema operativo"

msgid "Square"
msgstr "Quadrato"

