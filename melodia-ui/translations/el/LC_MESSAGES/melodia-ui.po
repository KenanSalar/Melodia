# ---- Motion section ---------------------------------------------------------

msgid "Motion"
msgstr "Κίνηση"

msgid "Skip Startup Animation"
msgstr "Παράλειψη κίνησης εκκίνησης"

msgid "Open with the library already on screen, instead of fading and sliding it into place. A detail page you left open still expands into view once it loads."
msgstr "Άνοιγμα με τη βιβλιοθήκη ήδη στην οθόνη, αντί να εμφανίζεται σταδιακά και να κυλά στη θέση της. Μια σελίδα λεπτομερειών που άφησες ανοιχτή εξακολουθεί να αναπτύσσεται μόλις φορτωθεί."

# Title of the window-chrome settings card.
msgid "Window"
msgstr "Παράθυρο"

msgid "Native Title Bar"
msgstr "Εγγενής γραμμή τίτλου"

msgid "Use the operating system's native title bar instead of the custom one. Restart required to apply."
msgstr "Χρήση της εγγενούς γραμμής τίτλου του λειτουργικού συστήματος αντί της προσαρμοσμένης. Απαιτείται επανεκκίνηση για εφαρμογή."

msgid "Restart Required"
msgstr "Απαιτείται επανεκκίνηση"

msgid "Switching to the native title bar requires restarting Melodia. Restart now?"
msgstr "Η μετάβαση στην εγγενή γραμμή τίτλου απαιτεί επανεκκίνηση της Melodia. Επανεκκίνηση τώρα;"

msgid "Switching to the custom title bar requires restarting Melodia. Restart now?"
msgstr "Η μετάβαση στην προσαρμοσμένη γραμμή τίτλου απαιτεί επανεκκίνηση της Melodia. Επανεκκίνηση τώρα;"

msgid "Match Unfocused Window Background"
msgstr "Αντιστοίχιση φόντου μη εστιασμένου παραθύρου"

msgid "Only available with the native title bar."
msgstr "Διαθέσιμο μόνο με την εγγενή γραμμή τίτλου."

msgid "Tint the sidebar and now-playing bar toward the content background when the window loses focus."
msgstr "Χρωμάτισε την πλευρική γραμμή και τη γραμμή αναπαραγωγής προς το φόντο του περιεχομένου όταν το παράθυρο χάνει την εστίαση."

msgid "Window Corner Radius"
msgstr "Ακτίνα γωνίας παραθύρου"

msgid "Managed by the operating system"
msgstr "Διαχειρίζεται από το λειτουργικό σύστημα"

msgid "Square"
msgstr "Τετράγωνο"

msgid "Decoration Button Style"
msgstr "Στιλ κουμπιών διακόσμησης"

msgid "Decoration Button Side"
msgstr "Πλευρά κουμπιών διακόσμησης"

msgid "Standard"
msgstr "Τυπικό"

msgid "Right"
msgstr "Δεξιά"

msgid "Left"
msgstr "Αριστερά"

