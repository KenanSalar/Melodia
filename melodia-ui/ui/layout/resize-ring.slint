import { Theme } from "../theme.slint";

// The window's resize-affordance perimeter — eight overlays that do nothing but
// set a cursor. Mirrors Tauri's `WindowResizeHandles`.
//
// They carry no `clicked` handler on purpose: the actual resize is processed by
// Slint's winit backend (`i-slint-backend-winit::event_loop`) from the Window's
// `resize-border-width`, before the press is ever dispatched to a TouchArea. So
// the only jobs here are the visual cue and stealing hover from whatever sits
// underneath (close button, scrollbar, now-playing-bar controls) — without that
// theft, aiming at the resize band flashes the close button red and paints
// scrollbar hover.
//
// The caller mounts this at 100% × 100% and owns the decision to mount at all:
// it is hidden when maximized (resize is a no-op then) and in native-frame mode
// (the OS draws its own border), which is one condition at the mount site
// rather than eight repeated here.
export component ResizeRing {
    // Order matters: edges first, corners after. Slint dispatches hover to the
    // topmost — i.e. last-declared — item under the cursor, so the diagonal
    // cursor wins at the corners while the edges win everywhere else along the
    // perimeter.

    // Top edge — full window width.
    TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.resize-border;
        mouse-cursor: ns-resize;
    }
    // Bottom edge.
    TouchArea {
        x: 0;
        y: root.height - Theme.resize-border;
        width: root.width;
        height: Theme.resize-border;
        mouse-cursor: ns-resize;
    }
    // Left edge.
    TouchArea {
        x: 0;
        y: 0;
        width: Theme.resize-border;
        height: root.height;
        mouse-cursor: ew-resize;
    }
    // Right edge — sits over the scrollbar's right-most pixels.
    TouchArea {
        x: root.width - Theme.resize-border;
        y: 0;
        width: Theme.resize-border;
        height: root.height;
        mouse-cursor: ew-resize;
    }

    // Corners.
    TouchArea {
        x: 0;
        y: 0;
        width: Theme.resize-corner;
        height: Theme.resize-corner;
        mouse-cursor: nwse-resize;
    }
    TouchArea {
        x: root.width - Theme.resize-corner;
        y: 0;
        width: Theme.resize-corner;
        height: Theme.resize-corner;
        mouse-cursor: nesw-resize;
    }
    TouchArea {
        x: 0;
        y: root.height - Theme.resize-corner;
        width: Theme.resize-corner;
        height: Theme.resize-corner;
        mouse-cursor: nesw-resize;
    }
    TouchArea {
        x: root.width - Theme.resize-corner;
        y: root.height - Theme.resize-corner;
        width: Theme.resize-corner;
        height: Theme.resize-corner;
        mouse-cursor: nwse-resize;
    }
}
