import { Dialog } from "../globals/dialog.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { Queue } from "../globals/queue.slint";
import { MiniPlayer, WindowChrome } from "../globals/shell.slint";

// The app's global keyboard shortcuts, and the focus scope catching them. It takes the whole main
// layout as its children, so it sits between any nested scope and the Window's key dispatch. **It
// is the only `FocusScope` in the tree** — a second one takes focus on mouse press and steals Esc.
// Text inputs consume their typed keys naturally, so an alphabetic shortcut never fires while the
// user is typing. The handler runs even under `Dialog.open`, so Escape routes through to
// `Dialog.cancelled()`; **every non-Escape shortcut early-outs there**, so a confirm-only kind with
// no input to swallow Space doesn't leak a playback toggle.
export component ShortcutScope inherits FocusScope {
    // **Slint doesn't return focus to an ancestor scope when the focused item is destroyed**, so a
    // view unmounting with focus inside it leaves shortcuts dead until the next click. The host
    // calls this on every content-view switch.
    public function grab-focus() {
        self.focus();
    }

    // First grab, at first show.
    init => { root.grab-focus(); }

    // The debounce for the *persistence* side of a keyboard volume change. `bump-volume` always
    // pushes the new value to the backend, which is cheap, and resets this; the timer below drains
    // it and commits once on the trailing edge, so a held arrow key writes `settings.json` at
    // release. A slider drag has the same one-commit-per-gesture contract via its own gate.
    property <int> commit-debounce-ticks: 0;

    commit-debounce-timer := Timer {
        interval: 100ms;
        running: root.commit-debounce-ticks > 0;
        triggered => {
            root.commit-debounce-ticks =
                max(0, root.commit-debounce-ticks - 1);
            // Trailing edge only. A fresh keystroke reuses this timer by resetting
            // the counter inside `bump-volume`.
            if (root.commit-debounce-ticks == 0) {
                Player.commit-volume();
            }
        }
    }

    // The clamp matches the slider's own emit range. Applies immediately so audio moves
    // on the keystroke, and defers the persist to the debounce above. Bumping
    // `volume-hud-tick` is what force-shows `VolumePopup`'s tooltip with the new
    // percentage — a slider drag doesn't, already raising that chrome itself.
    function bump-volume(delta: int) {
        Player.set-volume(clamp(Player.vm.volume + delta, 0, 100));
        Player.volume-hud-tick += 1;
        // Reset on every keystroke, so the commit fires once the user stops.
        root.commit-debounce-ticks = 3;
    }

    // Scrubbing off the end of a track is how a track change lands mid-run, and it is the
    // common way to reach the end rather than an exotic one. Without this the trailing edge
    // would seek the *incoming* track to the outgoing one's target. On a mirror because
    // `changed` rejects path expressions on globals.
    property <int> watched-seek-track: Player.vm.track.id;
    changed watched-seek-track => {
        Player.end-seek-run();
    }

    seek-run-timer := Timer {
        interval: 100ms;
        running: Player.seek-run-ticks > 0;
        triggered => {
            Player.seek-run-ticks = max(0, Player.seek-run-ticks - 1);
            if (Player.seek-run-ticks == 0) {
                root.flush-seek();
                Player.end-seek-run();
            }
        }
    }

    function flush-seek() {
        if (Player.seek-run-unsent && Player.seek-run-target-ms >= 0) {
            Player.seek(Player.seek-run-target-ms);
            Player.seek-run-unsent = false;
        }
    }

    // Walk the run's target rather than re-reading the position per press, for two reasons that
    // happen to share a fix. A seek round-trips through the backend asynchronously and does not
    // land inside a key repeat, so every repeat would aim at the same sample and the run would
    // travel one step; and a seek is far from free down there, where the track is reopened and
    // the demuxer walked to the target, so issuing one per repeat is the expensive way to go
    // nowhere.
    //
    // Guarded on a real duration, so a press with no track loaded is a no-op rather than a seek
    // against an unloaded backend.
    function bump-seek(delta-ms: int) {
        if (Player.duration-ms > 0) {
            Player.seek-run-target-ms = clamp(
                (Player.seek-run-target-ms >= 0 ? Player.seek-run-target-ms : Player.position-ms)
                    + delta-ms,
                0,
                Player.duration-ms);
            Player.seek-run-unsent = true;
            // Leading edge, so a single tap still seeks on the keystroke; a repeat inside
            // the window only moves the target and the trailing edge sends where it ended.
            if (Player.seek-run-ticks == 0) {
                root.flush-seek();
            }
            Player.seek-run-ticks = 3;
        }
    }

    // The VLC / YouTube convention: 0–9 seeks to that tenth of the track. `pct` stays
    // an integer so the arithmetic does; the rounding bias is negligible at ms scale.
    function seek-to-percent(pct: int) {
        if (Player.duration-ms > 0) {
            Player.seek-to(round(Player.duration-ms * pct / 100));
        }
    }

    // **`Queue.open` alone doesn't mean the sheet is on screen**: the miniplayer swap unmounts the
    // whole full-UI branch, sheet included, without touching the flag — so both queue bindings take
    // the mini state too. `MiniPlayer.active` leads the mount's own flag by a beat, so the keys go
    // dead slightly early during the fade, the harmless direction.
    property <bool> queue-sheet-up: Queue.open && !MiniPlayer.active;

    key-pressed(ev) => {
        // Priority: dialog cancel, then the queue sheet, then closing Now Playing. A nested
        // `FocusScope` can't own the sheet's Esc — Slint focuses a scope on mouse press, never on
        // mount — so owning both keys at the root is what makes the priority explicit.
        if (ev.text == Key.Escape) {
            if (Dialog.open) {
                Dialog.cancelled();
                Dialog.open = false;
                return accept;
            }
            if (root.queue-sheet-up) {
                // Clear a selection first; close only on the second press.
                if (Queue.selected-count > 0) {
                    Queue.clear-selection();
                } else {
                    Queue.close();
                    Queue.open = false;
                }
                return accept;
            }
            if (Nav.now-playing-open) {
                Nav.pending-enter-from = NavEnterFrom.below;
                Nav.now-playing-open = false;
                return accept;
            }
            return reject;
        }

        // A form dialog's input consumes its typed keys naturally, but a confirm-only
        // kind has no input — so without this guard, Space still pauses playback
        // through the backdrop.
        if (Dialog.open) {
            return reject;
        }

        // Bare seeks or steps the volume, Shift takes a bigger seek, Ctrl skips tracks
        // or steps the volume finely — Spotify's track skip over VLC's scrub. Slint
        // maps `modifiers.control` to Cmd on macOS automatically.
        if (ev.text == Key.LeftArrow) {
            if (ev.modifiers.control) {
                Player.previous();
            } else {
                bump-seek(ev.modifiers.shift ? -30000 : -5000);
            }
            return accept;
        }
        if (ev.text == Key.RightArrow) {
            if (ev.modifiers.control) {
                Player.next();
            } else {
                bump-seek(ev.modifiers.shift ? 30000 : 5000);
            }
            return accept;
        }
        if (ev.text == Key.UpArrow) {
            bump-volume(ev.modifiers.control ? 1 : 5);
            return accept;
        }
        if (ev.text == Key.DownArrow) {
            bump-volume(ev.modifiers.control ? -1 : -5);
            return accept;
        }

        // The number row's percentage seek.
        if (ev.text == "0") { seek-to-percent(0);  return accept; }
        if (ev.text == "1") { seek-to-percent(10); return accept; }
        if (ev.text == "2") { seek-to-percent(20); return accept; }
        if (ev.text == "3") { seek-to-percent(30); return accept; }
        if (ev.text == "4") { seek-to-percent(40); return accept; }
        if (ev.text == "5") { seek-to-percent(50); return accept; }
        if (ev.text == "6") { seek-to-percent(60); return accept; }
        if (ev.text == "7") { seek-to-percent(70); return accept; }
        if (ev.text == "8") { seek-to-percent(80); return accept; }
        if (ev.text == "9") { seek-to-percent(90); return accept; }

        // Space is play/pause everywhere.
        if (ev.text == " ") {
            Player.play-pause();
            return accept;
        }

        // **Before the bare letters**, so Ctrl+N wins over N.
        if (ev.modifiers.control) {
            // Only meaningful while the sheet is up, and the guard above keeps it
            // from firing behind a modal — which the old nested scope got wrong.
            if (ev.text == "a" && root.queue-sheet-up) {
                Queue.select-all();
                return accept;
            }
            if (ev.text == "b") {
                Nav.sidebar-collapsed = !Nav.sidebar-collapsed;
                return accept;
            }
            if (ev.text == ",") {
                // Settings' nav index; the `Nav` global has the map. The edge goes with it, as
                // `sidebar.slint` does — lateral nav, and left unwritten the page inherits
                // whichever direction the last drill or back put there.
                Nav.pending-enter-from = NavEnterFrom.below;
                Nav.selected-index = 9;
                Nav.persist-selected-index(9);
                return accept;
            }
            if (ev.text == "n") {
                // Populates the dialog exactly as the New-Playlist menu entry does —
                // which it now does by construction rather than by having been copied
                // from it. Spelled out here, this had drifted to its own title.
                Dialog.open-create-playlist([]);
                return accept;
            }
            return reject;
        }

        // The bare letters.
        if (ev.text == "m") { Player.toggle-mute();     return accept; }
        if (ev.text == "l") { Player.toggle-favorite(); return accept; }
        if (ev.text == "n") { Player.next();            return accept; }
        if (ev.text == "p") { Player.previous();        return accept; }
        if (ev.text == "s") { Player.toggle-shuffle();  return accept; }
        if (ev.text == "r") { Player.cycle-repeat();    return accept; }

        // Mini-gated for a sharper reason than the two above: **arming `Queue.open` while the
        // sheet is unmounted leaves nothing to fire `open-changed`**, so the remount seeds its
        // mirror already-true, Rust never builds the rows, and the sheet slides up empty.
        if (ev.text == "q" && !MiniPlayer.active) {
            Queue.open = !Queue.open;
            return accept;
        }
        if (ev.text == "f") {
            Nav.pending-enter-from = NavEnterFrom.below;
            Nav.now-playing-open = !Nav.now-playing-open;
            return accept;
        }
        if (ev.text == Key.F11) {
            WindowChrome.toggle-maximize();
            return accept;
        }

        return reject;
    }
}
