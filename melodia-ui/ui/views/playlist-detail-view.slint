import { Theme } from "../theme.slint";
import { SmartEditor } from "../globals/dialog-forms.slint";
import { Dialog } from "../globals/dialog.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { Player } from "../globals/player.slint";
import { PlaylistDetail } from "../globals/playlists.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { HeroChipStrip } from "../components/hero-chip-strip.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { SearchBar } from "../components/search-bar.slint";
import { DraggableTrackList } from "../components/track-list/draggable-track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { MaterialIcon } from "../components/material-icon.slint";

// Nav index 7, mounted when `PlaylistDetail.playlist-id >= 0`. Same shape as
// `AlbumDetailView`, but over `DraggableTrackList` — the shared `TrackList`
// stays drag-free for Tracks / Browse / the other three details.
export component PlaylistDetailView inherits Rectangle {
    // The `<=>`s below adopt whatever the globals held — a two-way link keeps
    // the right side's value, and the globals outlive this view. Without the
    // reset a drag interrupted by nav-away returns as a ghosted row under a
    // stranded drop line. `init` runs after the links, so it wins.
    init => {
        PlaylistDetail.drag-source = -1;
        PlaylistDetail.drop-slot = -1;
    }

    // Bumped per keystroke; `FilterThrottle` collapses the burst into one filter.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { PlaylistDetail.filter-changed(PlaylistDetail.filter); }
    }

    // Catches clicks no inner TouchArea consumes; the SearchBar blurs on the tick.
    TouchArea {
        clicked => { PlaylistDetail.blur-search-tick += 1; }
    }

    VerticalLayout {
        DetailHeader {
            vertical-stretch: 0;
            artwork-path: PlaylistDetail.playlist.artwork_path;
            cover: PlaylistDetail.cover;
            fallback-icon: "playlist";
            hero-blur-a: PlaylistDetail.blur-img-a;
            hero-blur-b: PlaylistDetail.blur-img-b;
            hero-blur-use-a: PlaylistDetail.blur-use-a;
            has-hero-blur: PlaylistDetail.has-blur;
            back-clicked => { PlaylistDetail.close-detail(); }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: start;
                        // Smart-playlist badge — matches the grid card's corner badge.
                        if PlaylistDetail.playlist.is_smart: VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "auto_awesome";
                                icon-size: 22px;
                                icon-color: HeroBackdrop.chrome;
                                filled: true;
                            }
                        }
                        Text {
                            text: "‎" + PlaylistDetail.playlist.name;
                            color: HeroBackdrop.on-backdrop;
                            font-size: Theme.hero-title-size;
                            font-weight: Theme.page-title-weight;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                    // Inside the title row, not on one of its own — it rides in the
                    // height the SearchBar already claims, which is what leaves the
                    // band slack for a wrapped second chip row (`HERO_MAX_ROWS`).
                    if PlaylistDetail.playlist.description != "": Text {
                        text: "‎" + PlaylistDetail.playlist.description;
                        color: HeroBackdrop.on-backdrop;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    SearchBar {
                        text <=> PlaylistDetail.filter;
                        placeholder: @tr("Filter tracks…");
                        blur-trigger: PlaylistDetail.blur-search-tick;
                        edited(t) => { root.filter-tick-pending += 1; }
                    }
                }
            }
            // No "Smart" chip — the title already carries the badge.
            HeroChipStrip { }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { PlaylistDetail.shuffle-all(); }
                    }
                    PillDivider { }
                    // Rust-side because the picker needs the playlist's track
                    // artworks first. It fills Dialog from a fresh event-loop tick,
                    // so the property-recursion guard doesn't trip.
                    PillButton {
                        icon: "image";
                        tooltip-text: @tr("Edit artwork");
                        clicked => { PlaylistDetail.request-edit-artwork(); }
                    }
                    PillDivider { }
                    // Rename / Delete fill Dialog inline — everything they need is
                    // already on `PlaylistDetail`, so no Rust hop and no recursion risk.
                    PillButton {
                        icon: "edit";
                        tooltip-text: @tr("Rename");
                        clicked => {
                            Dialog.title = @tr("Rename Playlist");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Save");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "rename-playlist";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            Dialog.input-text = PlaylistDetail.playlist.name;
                            Dialog.input-text-2 = PlaylistDetail.playlist.description;
                            Dialog.open = true;
                        }
                    }
                    // Chrome inline so `@tr` applies; Rust loads the criteria and
                    // opens the editor from a fresh tick.
                    if PlaylistDetail.playlist.is_smart: PillDivider { }
                    if PlaylistDetail.playlist.is_smart: PillButton {
                        icon: "tune";
                        tooltip-text: @tr("Edit rules");
                        clicked => {
                            Dialog.title = @tr("Edit Rules");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Save");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "smart-playlist-editor";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            SmartEditor.request-edit(PlaylistDetail.playlist-id);
                        }
                    }
                    PillDivider { }
                    PillButton {
                        icon: "delete";
                        danger: true;
                        tooltip-text: @tr("Delete playlist");
                        clicked => {
                            Dialog.title = @tr("Delete playlist?");
                            Dialog.message = @tr("The playlist and its track order will be removed. The tracks themselves stay in your library.");
                            Dialog.confirm-label = @tr("Delete");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = true;
                            Dialog.kind = "delete-playlist";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            Dialog.open = true;
                        }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        show-number  <=> PlaylistDetail.show-number;
                        show-artwork <=> PlaylistDetail.show-artwork;
                        show-artist  <=> PlaylistDetail.show-artist;
                        show-album   <=> PlaylistDetail.show-album;
                        show-genre   <=> PlaylistDetail.show-genre;
                        show-year    <=> PlaylistDetail.show-year;
                        toggled(id) => { PlaylistDetail.toggle-column(id); }
                    }
                    // Selection slots — appended when multi-select is active.
                    if PlaylistDetail.selected-ids.length > 0: PillDivider { }
                    if PlaylistDetail.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", PlaylistDetail.selected-ids.length);
                    }
                    // A smart playlist's membership is derived — nothing to remove from.
                    if PlaylistDetail.selected-ids.length > 0
                        && !PlaylistDetail.playlist.is_smart: PillButton {
                        icon: "playlist_remove";
                        // Lighter glyph than its siblings — 16 px puts it back on
                        // the same optical row as their 14 px default.
                        icon-size: 16px;
                        danger: true;
                        tooltip-text: @tr("Remove from playlist");
                        clicked => {
                            // Confirm even for one row — a stray click on the
                            // destructive chip must not drop tracks silently.
                            Dialog.title = @tr("Remove from playlist?");
                            Dialog.message = @tr(
                                "Remove {n} track from the playlist?"
                                    | "Remove {n} tracks from the playlist?"
                                    % PlaylistDetail.selected-ids.length
                            );
                            Dialog.confirm-label = @tr("Remove");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = true;
                            Dialog.kind = "remove-playlist-selected";
                            Dialog.target-id = -1;
                            Dialog.open = true;
                        }
                    }
                    if PlaylistDetail.selected-ids.length > 0: PillDivider { }
                    if PlaylistDetail.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { PlaylistDetail.clear-selection(); }
                    }
                }
            }
        }

        // The list is always mounted so `tl` stays in scope for the overlay
        // scrollbars; the empty state paints on top of its bare header.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            HorizontalLayout {
                padding-left: Theme.pad-lg;
                padding-right: Theme.pad-lg;
                // Hero-to-header gap, matching the other detail views.
                padding-top: Theme.pad-lg;

                tl := DraggableTrackList {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    rows: PlaylistDetail.tracks;
                    // Reorder only in insertion order: any other sort makes it
                    // ambiguous, a filter breaks the index → position mapping, and
                    // a smart playlist has no curated order to reorder into.
                    reorder-enabled: PlaylistDetail.sort-field == "position"
                        && PlaylistDetail.filter == ""
                        && !PlaylistDetail.playlist.is_smart;
                    // On the global so Rust can abort an in-flight drag: refreshing
                    // `tracks` destroys the row holding the pointer grab, and a dead
                    // row never delivers the pointer-up that would clear these.
                    drag-source <=> PlaylistDetail.drag-source;
                    drop-slot <=> PlaylistDetail.drop-slot;

                    w-number <=> PlaylistDetail.w-number;
                    w-title <=> PlaylistDetail.w-title;
                    w-artist <=> PlaylistDetail.w-artist;
                    w-album <=> PlaylistDetail.w-album;
                    w-genre <=> PlaylistDetail.w-genre;
                    w-year <=> PlaylistDetail.w-year;
                    w-length <=> PlaylistDetail.w-length;

                    show-number <=> PlaylistDetail.show-number;
                    show-artwork <=> PlaylistDetail.show-artwork;
                    show-artist <=> PlaylistDetail.show-artist;
                    show-album <=> PlaylistDetail.show-album;
                    show-genre <=> PlaylistDetail.show-genre;
                    show-year <=> PlaylistDetail.show-year;
                    number-mode: "index";

                    sort-field: PlaylistDetail.sort-field;
                    sort-dir: PlaylistDetail.sort-dir;
                    playing-track-id: Player.vm.track.id;
                    view-context: "playlist-detail";
                    current-playlist-id: PlaylistDetail.playlist.id;
                    view-selected-ids: PlaylistDetail.selected-ids;

                    request-sort(f) => { PlaylistDetail.request-sort(f); }
                    play-row(id, idx) => { PlaylistDetail.play-row(id, idx); }
                    play-next(ids) => { PlaylistDetail.play-next(ids); }
                    add-to-queue(ids) => { PlaylistDetail.add-to-queue(ids); }
                    toggle-row-favorite(ids, on) => { PlaylistDetail.toggle-row-favorite(ids, on); }
                    set-row-rating(ids, n) => { PlaylistDetail.set-row-rating(ids, n); }
                    select-row(idx, id, sh, ct) => { PlaylistDetail.select-row(idx, id, sh, ct); }
                    // A click in the track list blurs the hero SearchBar.
                    request-blur-search => { PlaylistDetail.blur-search-tick += 1; }
                    reorder(from, to) => { PlaylistDetail.reorder(from, to); }
                    remove-from-playlist(ids) => { PlaylistDetail.remove-track(ids); }
                    go-to-album(aid) => { PlaylistDetail.go-to-album(aid); }
                    go-to-artist(aid) => { PlaylistDetail.go-to-artist(aid); }
                    go-to-genre(gid) => { PlaylistDetail.go-to-genre(gid); }
                }
            }

            if PlaylistDetail.playlist.track_count == 0: Rectangle {
                background: Theme.base;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-md;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "music_note";
                            icon-size: 64px;
                            icon-color: Theme.overlay0;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: PlaylistDetail.playlist.is_smart
                                ? @tr("No matching tracks")
                                : @tr("No tracks yet");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: PlaylistDetail.playlist.is_smart
                                ? @tr("No tracks match these rules.")
                                : @tr("Drag music files here, or add tracks via any track's overflow menu.");
                            color: Theme.subtext0;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // OS file-hover banner — routed here when the queue sheet is closed
            // and this detail is open. Stacks above the empty state.
            if PlaylistDetail.is-drop-hovered && PlaylistDetail.playlist-id >= 0
                && !PlaylistDetail.playlist.is_smart: Rectangle {
                background: Theme.accent.with-alpha(0.16);
                border-radius: Theme.radius-md;
                border-width: 2px;
                border-color: Theme.accent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-sm;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "playlist_add";
                            icon-size: 56px;
                            icon-color: Theme.accent;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Drop files to add to this playlist");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: tl.absolute-position.y - root.absolute-position.y + tl.body-y;
        width: 10px;
        height: tl.body-height;
        visible-size: tl.v-visible-height;
        content-size: tl.v-viewport-height;
        offset: tl.v-offset;
        scroll-to(o) => { tl.set-v-offset(o); }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
