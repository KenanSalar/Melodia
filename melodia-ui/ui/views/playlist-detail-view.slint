import { Theme } from "../theme.slint";
import { SmartEditor } from "../globals/dialog-forms.slint";
import { Dialog } from "../globals/dialog.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { Player } from "../globals/player.slint";
import { PlaylistDetail } from "../globals/playlists.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { HeroChipStrip } from "../components/hero-chip-strip.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { SearchBar } from "../components/search-bar.slint";
import { DraggableTrackList } from "../components/track-list/draggable-track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { MaterialIcon } from "../components/material-icon.slint";

// The full Playlist Detail view. Mounted by `app-window.slint` for nav
// index 7 when `PlaylistDetail.playlist-id >= 0`. Same shape as
// `AlbumDetailView` — `DetailHeader` (hero blur + artwork tile + right
// column) over a track list — but uses the sibling `DraggableTrackList`
// (drag-reorder enabled when `sort-field == "position"`) instead of the
// shared `TrackList`. The shared component is kept drag-free for the
// other consumers (Tracks / Browse / Album-Artist-Genre Detail).
//
// Header actions: Shuffle, Edit Artwork, Rename, Delete + column
// toggle. The selection chip (when rows are selected) carries a
// "Remove from playlist" action.
export component PlaylistDetailView inherits Rectangle {
    // A fresh mount can't have a drag in flight, but the two `<=>`s below
    // adopt whatever the globals held: Slint's two-way link keeps the
    // right-hand side's value, and the globals outlive this view (nav-away
    // destroys it — see the `if` in `app-window.slint`). Without the reset,
    // a drag interrupted by nav-away comes back as a ghosted row under a
    // stranded drop line. Safe here because `init` runs after the links.
    init => {
        PlaylistDetail.drag-source = -1;
        PlaylistDetail.drop-slot = -1;
    }

    // Filter throttle: each keystroke bumps `filter-tick-pending`; the
    // shared `FilterThrottle` fires the filter callback at most once per
    // ~130 ms while pending is ahead of the last-applied tick.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { PlaylistDetail.filter-changed(PlaylistDetail.filter); }
    }

    // Backdrop catches any click that no inner TouchArea consumes and
    // bumps the blur tick — the SearchBar observes it and clears focus
    // on change.
    TouchArea {
        clicked => { PlaylistDetail.blur-search-tick += 1; }
    }

    VerticalLayout {
        DetailHeader {
            vertical-stretch: 0;
            artwork-path: PlaylistDetail.playlist.artwork_path;
            cover: PlaylistDetail.cover;
            fallback-icon: "playlist";
            hero-blur-a: PlaylistDetail.blur-img-a;
            hero-blur-b: PlaylistDetail.blur-img-b;
            hero-blur-use-a: PlaylistDetail.blur-use-a;
            has-hero-blur: PlaylistDetail.has-blur;
            back-clicked => { PlaylistDetail.close-detail(); }

            // Title row — playlist name on the left, SearchBar pinned
            // to the right. The SearchBar filters the `tracks`
            // DraggableTrackList (title + artist + album substring).
            // Mirrors the Artist Detail hero layout.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: start;
                        // Smart-playlist badge — leading the title, matching
                        // the grid card's corner badge.
                        if PlaylistDetail.playlist.is_smart: VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "auto_awesome";
                                icon-size: 22px;
                                icon-color: HeroBackdrop.chrome;
                                filled: true;
                            }
                        }
                        Text {
                            text: "‎" + PlaylistDetail.playlist.name;
                            color: HeroBackdrop.on-backdrop;
                            font-size: Theme.hero-title-size;
                            font-weight: Theme.page-title-weight;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                    // Description — under the title rather than on a row of
                    // its own, so it rides in the height the SearchBar beside
                    // it already claims. That is what leaves the band enough
                    // slack for a wrapped second chip row; see
                    // `ui::hero_chips::HERO_MAX_ROWS`. Still gated on being
                    // non-empty, so a playlist without one leaves the row at
                    // exactly the SearchBar's height.
                    if PlaylistDetail.playlist.description != "": Text {
                        text: "‎" + PlaylistDetail.playlist.description;
                        color: HeroBackdrop.on-backdrop;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    SearchBar {
                        text <=> PlaylistDetail.filter;
                        placeholder: @tr("Filter tracks…");
                        blur-trigger: PlaylistDetail.blur-search-tick;
                        edited(t) => { root.filter-tick-pending += 1; }
                    }
                }
            }
            // Meta chips — track count + total duration. No "Smart" chip:
            // the title already carries the `auto_awesome` badge.
            HeroChipStrip { }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { PlaylistDetail.shuffle-all(); }
                    }
                    PillDivider { }
                    // Edit-artwork stays as a Rust-callback path — Rust
                    // must fetch the playlist's track artworks (DB query)
                    // before opening the picker. Rust populates Dialog
                    // via `upgrade_in_event_loop`, which lands on a fresh
                    // event-loop tick (not the click tick), so Slint's
                    // property-recursion guard doesn't trip.
                    PillButton {
                        icon: "image";
                        tooltip-text: @tr("Edit artwork");
                        clicked => { PlaylistDetail.request-edit-artwork(); }
                    }
                    PillDivider { }
                    // Rename / Delete populate Dialog inline (Slint-only),
                    // matching the `queue-sheet` / `library-section`
                    // pattern — no Rust hop, no recursion risk. Both can
                    // read header data directly from
                    // `PlaylistDetail.playlist` / `PlaylistDetail.playlist-id`.
                    PillButton {
                        icon: "edit";
                        tooltip-text: @tr("Rename");
                        clicked => {
                            Dialog.title = @tr("Rename Playlist");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Save");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "rename-playlist";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            // Pre-fill both fields with current values
                            // so a quick rename is just a few keystrokes
                            // and clearing description is one keystroke
                            // away.
                            Dialog.input-text = PlaylistDetail.playlist.name;
                            Dialog.input-text-2 = PlaylistDetail.playlist.description;
                            Dialog.open = true;
                        }
                    }
                    // Edit Rules — smart playlists only. Chrome set inline (so
                    // `@tr` applies); Rust `request-edit` loads the criteria +
                    // opens the editor from a fresh event-loop tick.
                    if PlaylistDetail.playlist.is_smart: PillDivider { }
                    if PlaylistDetail.playlist.is_smart: PillButton {
                        icon: "tune";
                        tooltip-text: @tr("Edit rules");
                        clicked => {
                            Dialog.title = @tr("Edit Rules");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Save");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "smart-playlist-editor";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            SmartEditor.request-edit(PlaylistDetail.playlist-id);
                        }
                    }
                    PillDivider { }
                    PillButton {
                        icon: "delete";
                        danger: true;
                        tooltip-text: @tr("Delete playlist");
                        clicked => {
                            Dialog.title = @tr("Delete playlist?");
                            Dialog.message = @tr("The playlist and its track order will be removed. The tracks themselves stay in your library.");
                            Dialog.confirm-label = @tr("Delete");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = true;
                            Dialog.kind = "delete-playlist";
                            Dialog.target-id = PlaylistDetail.playlist-id;
                            Dialog.open = true;
                        }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        show-number  <=> PlaylistDetail.show-number;
                        show-artwork <=> PlaylistDetail.show-artwork;
                        show-artist  <=> PlaylistDetail.show-artist;
                        show-album   <=> PlaylistDetail.show-album;
                        show-genre   <=> PlaylistDetail.show-genre;
                        show-year    <=> PlaylistDetail.show-year;
                        toggled(id) => { PlaylistDetail.toggle-column(id); }
                    }
                    // Selection slots — appended (with leading divider) when
                    // multi-select is active.
                    if PlaylistDetail.selected-ids.length > 0: PillDivider { }
                    if PlaylistDetail.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", PlaylistDetail.selected-ids.length);
                    }
                    // Removing a track is meaningless for a smart playlist
                    // (membership is derived, not curated) — hide it there.
                    if PlaylistDetail.selected-ids.length > 0
                        && !PlaylistDetail.playlist.is_smart: PillButton {
                        icon: "playlist_remove";
                        // `playlist_remove`'s glyph weight is lighter
                        // than `delete` / `edit` etc., so at the
                        // PillButton 14 px default it reads visually
                        // smaller than the sibling icons. 16 px brings
                        // it back into the same optical row.
                        icon-size: 16px;
                        danger: true;
                        tooltip-text: @tr("Remove from playlist");
                        clicked => {
                            // Always confirm before removing — even for
                            // a single selected row — so a stray click
                            // on the destructive chip can't drop tracks
                            // silently. Dispatcher routes Accept to
                            // `PlaylistDetail.remove-selected()`.
                            Dialog.title = @tr("Remove from playlist?");
                            Dialog.message = @tr(
                                "Remove {n} track from the playlist?"
                                    | "Remove {n} tracks from the playlist?"
                                    % PlaylistDetail.selected-ids.length
                            );
                            Dialog.confirm-label = @tr("Remove");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = true;
                            Dialog.kind = "remove-playlist-selected";
                            Dialog.target-id = -1;
                            Dialog.open = true;
                        }
                    }
                    if PlaylistDetail.selected-ids.length > 0: PillDivider { }
                    if PlaylistDetail.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { PlaylistDetail.clear-selection(); }
                    }
                }
            }
        }

        // Body — DraggableTrackList always mounted (so `tl` is always in
        // scope for the overlay scrollbars). The empty-state Rectangle
        // is painted ON TOP when the playlist has no tracks; the
        // DraggableTrackList renders just its header beneath but the
        // overlay covers it.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            HorizontalLayout {
                padding-left: Theme.pad-lg;
                padding-right: Theme.pad-lg;
                // Vertical gap between the hero blur and the tracklist
                // header — keeps the spacing consistent with every
                // other detail view.
                padding-top: Theme.pad-lg;

                tl := DraggableTrackList {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    rows: PlaylistDetail.tracks;
                    // Drag-reorder is silent unless we're in the user's
                    // canonical (insertion) order — any other sort makes
                    // a reorder ambiguous. An active filter also disables
                    // it: filtered row indices don't map to playlist
                    // positions.
                    // Smart playlists are query-derived — there is no curated
                    // order to reorder into, so drag-reorder is off for them.
                    reorder-enabled: PlaylistDetail.sort-field == "position"
                        && PlaylistDetail.filter == ""
                        && !PlaylistDetail.playlist.is_smart;
                    // Surfaced on the global so Rust can abort an in-flight
                    // drag: refreshing `tracks` replaces the model, which
                    // destroys the row instance holding the pointer grab, and
                    // a destroyed row never delivers its pointer-up to clear
                    // these itself.
                    drag-source <=> PlaylistDetail.drag-source;
                    drop-slot <=> PlaylistDetail.drop-slot;

                    w-number <=> PlaylistDetail.w-number;
                    w-title <=> PlaylistDetail.w-title;
                    w-artist <=> PlaylistDetail.w-artist;
                    w-album <=> PlaylistDetail.w-album;
                    w-genre <=> PlaylistDetail.w-genre;
                    w-year <=> PlaylistDetail.w-year;
                    w-length <=> PlaylistDetail.w-length;

                    show-number <=> PlaylistDetail.show-number;
                    show-artwork <=> PlaylistDetail.show-artwork;
                    show-artist <=> PlaylistDetail.show-artist;
                    show-album <=> PlaylistDetail.show-album;
                    show-genre <=> PlaylistDetail.show-genre;
                    show-year <=> PlaylistDetail.show-year;
                    number-mode: "index";

                    sort-field: PlaylistDetail.sort-field;
                    sort-dir: PlaylistDetail.sort-dir;
                    playing-track-id: Player.vm.track.id;
                    view-context: "playlist-detail";
                    current-playlist-id: PlaylistDetail.playlist.id;
                    view-selected-ids: PlaylistDetail.selected-ids;

                    request-sort(f) => { PlaylistDetail.request-sort(f); }
                    play-row(id, idx) => { PlaylistDetail.play-row(id, idx); }
                    play-next(ids) => { PlaylistDetail.play-next(ids); }
                    add-to-queue(ids) => { PlaylistDetail.add-to-queue(ids); }
                    toggle-row-favorite(ids, on) => { PlaylistDetail.toggle-row-favorite(ids, on); }
                    set-row-rating(ids, n) => { PlaylistDetail.set-row-rating(ids, n); }
                    select-row(idx, id, sh, ct) => { PlaylistDetail.select-row(idx, id, sh, ct); }
                    // A click in the track list blurs the hero SearchBar.
                    request-blur-search => { PlaylistDetail.blur-search-tick += 1; }
                    reorder(from, to) => { PlaylistDetail.reorder(from, to); }
                    remove-from-playlist(ids) => { PlaylistDetail.remove-track(ids); }
                    go-to-album(aid) => { PlaylistDetail.go-to-album(aid); }
                    go-to-artist(aid) => { PlaylistDetail.go-to-artist(aid); }
                    go-to-genre(gid) => { PlaylistDetail.go-to-genre(gid); }
                }
            }

            // Empty-state overlay — painted on top of the (still-mounted)
            // DraggableTrackList when the playlist has no rows.
            if PlaylistDetail.playlist.track_count == 0: Rectangle {
                background: Theme.base;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-md;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "music_note";
                            icon-size: 64px;
                            icon-color: Theme.overlay0;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: PlaylistDetail.playlist.is_smart
                                ? @tr("No matching tracks")
                                : @tr("No tracks yet");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: PlaylistDetail.playlist.is_smart
                                ? @tr("No tracks match these rules.")
                                : @tr("Drag music files here, or add tracks via any track's overflow menu.");
                            color: Theme.subtext0;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Drop-hovered banner — paints over the detail body when the
            // OS file-hover routes here (queue sheet closed, this detail
            // open). Z-stacks above the empty-state overlay so users see
            // a clear "drop target" cue.
            if PlaylistDetail.is-drop-hovered && PlaylistDetail.playlist-id >= 0
                && !PlaylistDetail.playlist.is_smart: Rectangle {
                background: Theme.accent.with-alpha(0.16);
                border-radius: Theme.radius-md;
                border-width: 2px;
                border-color: Theme.accent;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-sm;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "playlist_add";
                            icon-size: 56px;
                            icon-color: Theme.accent;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Drop files to add to this playlist");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }

    // Overlay scrollbars — `tl` is always in scope (DraggableTrackList
    // mounts unconditionally), so the scrollbar bindings are
    // unconditional too. Empty playlists still show the header band but
    // no scroll travel; the V-bar simply hides itself via its own
    // visible-size / content-size gating.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: tl.absolute-position.y - root.absolute-position.y + tl.body-y;
        width: 10px;
        height: tl.body-height;
        visible-size: tl.v-visible-height;
        content-size: tl.v-viewport-height;
        offset: tl.v-offset;
        scroll-to(o) => { tl.set-v-offset(o); }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
