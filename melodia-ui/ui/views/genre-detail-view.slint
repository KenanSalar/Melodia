import { Theme } from "../theme.slint";
import { GenreDetail } from "../globals/genres.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { Player } from "../globals/player.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { HeroChipStrip } from "../components/hero-chip-strip.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { SearchBar } from "../components/search-bar.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";

// The full Genre Detail view. Mounted by `app-window.slint` for nav
// index 6 when `GenreDetail.genre-id >= 0`. Same DetailHeader + TrackList
// composition as `album-detail-view.slint` / `artist-detail-view.slint`,
// but with NO artwork wiring:
//
//   * No `cover` / `hero-blur-*` / `has-hero-blur` props passed → the
//     header's hero region paints only the accent gradient floor + scrim.
//   * `fallback-icon: "theater_comedy"` so the left-side tile shows the
//     same glyph the sidebar uses.
//
// Track-list column policy: `show-genre` forced off because every row
// is the same genre (mirrors how Album Detail forces `show-album` off
// and Artist Detail forces `show-artist` off).
export component GenreDetailView inherits Rectangle {
    // Filter throttle: each keystroke bumps `filter-tick-pending`; the
    // shared `FilterThrottle` fires the filter callback at most once per
    // ~130 ms while pending is ahead of the last-applied tick.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { GenreDetail.filter-changed(GenreDetail.filter); }
    }

    // Backdrop catches any click that no inner TouchArea consumes and
    // bumps the blur tick — the SearchBar observes it and clears focus
    // on change.
    TouchArea {
        clicked => { GenreDetail.blur-search-tick += 1; }
    }

    VerticalLayout {
        DetailHeader {
            vertical-stretch: 0;
            // No artwork-path / cover / hero-blur props — genres have
            // no intrinsic image, so the left tile + the full-bleed
            // hero backdrop are both painted from the four-stop accent
            // carried on `GenreDetail.genre`. The hero pair uses
            // dimmer / less-saturated stops than the small tile so the
            // wide backdrop keeps scrim + foreground text legible; the
            // tile pair matches the grid card exactly so genre
            // recognition is consistent across grid ↔ detail. See
            // `src/ui/genres/color.rs::genre_accent` for how the four
            // stops are derived on three name-hash axes.
            //
            // The hero pair isn't passed here — `open_genre` writes it
            // into `HeroBackdrop.floor-{start,end}` on the Rust side,
            // measures it, and solves the scrim + foreground against it,
            // exactly as an artwork-bearing detail view does with its
            // decoded blur.
            fallback-icon: "theater_comedy";
            tile-bg: @linear-gradient(135deg,
                GenreDetail.genre.tile_color_1,
                GenreDetail.genre.tile_color_2);
            tile-icon-color: #ffffff.with-alpha(0.3);
            back-clicked => { GenreDetail.close-detail(); }

            // --- Right column @children ------------------------------
            // Title row — genre name on the left, SearchBar pinned to
            // the right. The SearchBar filters the `tracks` TrackList
            // (title + artist + album substring). Mirrors the Artist
            // Detail hero layout.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    // Title — same typographic hierarchy as Album /
                    // Artist Detail. Leading LRM keeps RTL-bidi titles
                    // laid out correctly inside an LTR shell.
                    Text {
                        text: "‎" + GenreDetail.genre.name;
                        color: HeroBackdrop.on-backdrop;
                        font-size: Theme.hero-title-size;
                        font-weight: Theme.page-title-weight;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    SearchBar {
                        text <=> GenreDetail.filter;
                        placeholder: @tr("Filter tracks…");
                        blur-trigger: GenreDetail.blur-search-tick;
                        edited(t) => { root.filter-tick-pending += 1; }
                    }
                }
            }
            // Meta chips — track count + total duration. No "year" /
            // "artist" chip because neither is a per-genre concept.
            HeroChipStrip { }

            // Spacer — absorbs the slack between the title block and
            // the action row so the row sits flush with the artwork's
            // lower edge.
            Rectangle { vertical-stretch: 1; }

            // Action row — primary pill + optional selection pill.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                // Single pill: Shuffle → toggle → selection chip
                // (trailing, when active).
                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { GenreDetail.shuffle-genre(); }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        show-number  <=> GenreDetail.show-number;
                        show-artwork <=> GenreDetail.show-artwork;
                        show-artist  <=> GenreDetail.show-artist;
                        show-album   <=> GenreDetail.show-album;
                        show-genre   <=> GenreDetail.show-genre;
                        show-year    <=> GenreDetail.show-year;
                        // Genre column is meaningless in this view —
                        // every row belongs to the same genre.
                        hide-genre: true;
                        toggled(id) => { GenreDetail.toggle-column(id); }
                    }
                    if GenreDetail.selected-ids.length > 0: PillDivider { }
                    if GenreDetail.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", GenreDetail.selected-ids.length);
                    }
                    if GenreDetail.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { GenreDetail.clear-selection(); }
                    }
                }
            }
        }

        // Indent the TrackList with `Theme.pad-lg` on both sides so its
        // left/right edges match the Tracks and Browse views (whose
        // root VLs apply uniform `padding: Theme.pad-lg`). The root VL
        // here can't use that pattern because `DetailHeader` is
        // full-bleed for the hero region — so the inset is applied
        // per-child instead.
        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            // Vertical gap between the hero and the TrackList header.
            // Matches the consistent inset every other detail view
            // applies between hero (or last sub-section) and the
            // tracks table.
            padding-top: Theme.pad-lg;

            tl := TrackList {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                rows: GenreDetail.tracks;

                w-number <=> GenreDetail.w-number;
                w-title <=> GenreDetail.w-title;
                w-artist <=> GenreDetail.w-artist;
                w-album <=> GenreDetail.w-album;
                w-genre <=> GenreDetail.w-genre;
                w-year <=> GenreDetail.w-year;
                w-length <=> GenreDetail.w-length;

                show-number <=> GenreDetail.show-number;
                show-artwork <=> GenreDetail.show-artwork;
                show-artist <=> GenreDetail.show-artist;
                show-album <=> GenreDetail.show-album;
                show-genre <=> GenreDetail.show-genre;
                show-year <=> GenreDetail.show-year;
                number-mode: "index";

                sort-field: GenreDetail.sort-field;
                sort-dir: GenreDetail.sort-dir;
                playing-track-id: Player.vm.track.id;
                view-context: "genre-detail";
                view-selected-ids: GenreDetail.selected-ids;

                request-sort(f) => { GenreDetail.request-sort(f); }
                play-row(id, idx) => { GenreDetail.play-row(id, idx); }
                play-next(ids) => { GenreDetail.play-next(ids); }
                add-to-queue(ids) => { GenreDetail.add-to-queue(ids); }
                toggle-row-favorite(ids, on) => { GenreDetail.toggle-row-favorite(ids, on); }
                set-row-rating(ids, n) => { GenreDetail.set-row-rating(ids, n); }
                select-row(idx, id, sh, ct) => { GenreDetail.select-row(idx, id, sh, ct); }
                // A click in the track list blurs the hero SearchBar.
                request-blur-search => { GenreDetail.blur-search-tick += 1; }
                go-to-album(aid) => { GenreDetail.go-to-album(aid); }
                go-to-artist(aid) => { GenreDetail.go-to-artist(aid); }
                go-to-genre(gid) => { GenreDetail.go-to-genre(gid); }
            }
        }
    }

    // Overlay scrollbars at the view root, flush with the content panel's
    // rounded edges. `tl` is nested inside the VerticalLayout, so its
    // position is taken via `absolute-position` (like
    // `album-detail-view.slint`).
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: tl.absolute-position.y - root.absolute-position.y + tl.body-y;
        width: 10px;
        height: tl.body-height;
        visible-size: tl.v-visible-height;
        content-size: tl.v-viewport-height;
        offset: tl.v-offset;
        scroll-to(o) => { tl.set-v-offset(o); }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
