import { Theme } from "../theme.slint";
import { Favorites } from "../globals/curated.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { Player } from "../globals/player.slint";
import { CoverMosaic } from "../components/grid/cover-mosaic.slint";
import { EntityCardGrid } from "../components/grid/entity-card-grid.slint";
import { GridEmptyState } from "../components/grid/grid-empty-state.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { SearchBar } from "../components/search-bar.slint";
import { TabBar } from "../components/tab-bar.slint";
import { Tooltip, TooltipSide } from "../components/tooltip.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { NavEnterFrom } from "../globals/nav.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { HeroBlurBackdrop } from "../components/hero-blur-backdrop.slint";

// The Favorites view (Nav sidebar index 2). A hero banner over three
// mutually-exclusive sub-views:
//
//   * Hero — its top row carries the `TabBar` and the filter `SearchBar`,
//     over the live cover mosaic, the title and a per-tab stats line and
//     action pill. Full-bleed hero blur fades through
//     `Favorites.blur-img-{a,b}` whenever the top-4 most-played favorites
//     change. Pinned: the tabs have to stay reachable, so only the body
//     below scrolls.
//   * Songs — the sortable / filterable `TrackList` over every favorite.
//   * Most Played — a virtualized card grid of the played favorites,
//     ranked by play count.
//   * Favorite Artists — the same grid with circular cards; a click is a
//     cross-tab nav to Artist Detail, and the back arrow there returns here.
//
// Albums are intentionally not surfaced — they're reachable via the Albums
// tab. No Favorite Albums tab.
//
// Each tab owns exactly one scroller, which is why this view mounts plain
// `OverlayScrollbar`s rather than `CompositeScrollbars`: the strips used to
// sit in an outer `ScrollView` above a height-capped `TrackList`, and a
// nested `ListView` swallows the wheel at its own edge instead of bubbling.
// One scroller per tab retires that whole problem — and with it the
// `CompositeScroll` hover sentinel and the two-way `viewport-y` binding that
// opted out of Slint's own out-of-bounds correction.
//
// Stays globals-free apart from the `Favorites` + `Player` + `HeroBackdrop`
// reads — every data fetch and cover lookup is routed through callbacks on
// `Favorites` that Rust's `wire_favorites` wires to `library::favorites::*`.
export component FavoritesView inherits Rectangle {
    // Filter throttle: each keystroke bumps `pending`; the Timer fires the
    // refilter callback at most once per `interval` while `pending !=
    // applied`. Same shape as `tracks-view.slint`'s throttle.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { Favorites.filter-changed(Favorites.filter); }
    }

    // Backdrop catches any click that no inner TouchArea consumes and bumps
    // the blur tick — the SearchBar observes the counter and clears focus on
    // change. Same pattern as tracks-view.
    TouchArea {
        clicked => { Favorites.blur-search-tick += 1; }
    }

    // --- Header width budget ----------------------------------------------
    //
    // The same arrangement `settings-view.slint` uses, for the same reasons —
    // that file carries the long-form rationale. In brief:
    //
    // `page-w` is a *mirror*, written imperatively, because a live
    // `root.width` read feeding a child's size re-enters layout. It is seeded
    // at this header row's own floor rather than a plausible page width:
    // seeded wide the bar believes it can afford full-width tabs and draws
    // them into a panel that can't seat them, which is exactly what a
    // miniplayer → full swap produces. The 1 ms mount Timer beside it is
    // mandatory — `changed` doesn't fire when the first layout settles
    // directly on the final value, which is every window opened at its size.
    property <length> search-w-max: 220px;
    property <length> search-w-min: 140px;

    property <length> page-w:
        2 * Theme.pad-lg + bar.compact-w + 2 * Theme.pad-md + root.search-w-max;
    changed width => { self.page-w = self.width; }

    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            self.running = false;
        }
    }

    property <length> content-w: root.page-w - 2 * Theme.pad-lg;

    // The filter yields room before the tabs do: the tabs navigate, the
    // search only refines what a tab already shows. Reserved against the
    // bar's published `compact-w` — its own floor — so the two can't drift.
    property <length> search-w: clamp(
        root.content-w - bar.compact-w - 2 * Theme.pad-md,
        root.search-w-min, root.search-w-max);

    // --- Hero geometry -----------------------------------------------------
    property <length> hero-artwork: 140px;
    // The bar's own height, restated so the hero can reserve its row.
    property <length> tab-row-h: 48px;
    // Derived rather than a literal, so growing the artwork or the bar can't
    // leave the banner cropping its own contents.
    property <length> hero-height:
        2 * Theme.pad-lg + root.tab-row-h + Theme.pad-md + root.hero-artwork;

    // --- Grid geometry -----------------------------------------------------
    //
    // Shared by both grid tabs — they're mutually exclusive and use the same
    // card shape, so one derivation and one `columns` push covers both.
    // Measured off the body, whose width the layout fixes independently of
    // the cards inside it.
    //
    // The gutter is the host's choice, so it lives here and is handed both to
    // the geometry and to the grids — an `in` property isn't readable back
    // from outside the component that declares it.
    property <length> grid-gap: 20px;

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
    }

    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Favorites.columns = c;
            Favorites.columns-changed(c);
        }
    }

    // --- Hero copy ---------------------------------------------------------
    //
    // The stats line follows the tab: what the hero counts is whatever the
    // body below is showing.
    property <string> stats-text:
        Favorites.tab-idx == Favorites.tab-most-played
            ? @tr("{n} track" | "{n} tracks" % Favorites.most-played-count)
            : Favorites.tab-idx == Favorites.tab-artists
                ? @tr("{n} artist" | "{n} artists" % Favorites.artist-count)
                : Favorites.track-count > 0
                    ? @tr("{n} favorite" | "{n} favorites" % Favorites.track-count)
                        + " · " + Favorites.duration-text
                    : @tr("No favorites yet");

    // --- Sub-view transition -----------------------------------------------
    //
    // The tab bodies enter sideways, in the direction the pick moved: forward
    // along the bar slides in from the right, back from the left. The page's
    // own entrance stays the sidebar's fade-up, and these two must not
    // compound — a horizontal slide over a vertical one reads as a diagonal —
    // so the inner transition stays *disabled* until the first real switch.
    // The page is rebuilt on every entry, so this re-disarms for free.
    property <bool> tab-anim-armed: false;
    // Which way is `bar.previous-index`'s job, and it has to be — the page can
    // be re-entered on any tab, and everything else in reach reads the tab just
    // picked, since the bar writes `selected-index` before it emits `selected`
    // and `Favorites.tab-idx` is two-way bound to it.
    property <NavEnterFrom> tab-enter-from: NavEnterFrom.right;

    property <string> filter-placeholder:
        Favorites.tab-idx == Favorites.tab-most-played
            ? @tr("Filter most played…")
            : Favorites.tab-idx == Favorites.tab-artists
                ? @tr("Filter artists…")
                : @tr("Filter favorites…");

    // --- Full-bleed hero blur backdrop -------------------------------------
    // Behind everything else; the shared component owns the dual-slot
    // crossfade contract (outgoing slot never cleared so mosaic refresh never
    // flashes). Gradient floor shows through when there is no blur image
    // (zero favorites / decode failure).
    HeroBlurBackdrop {
        x: 0; y: 0;
        width: 100%; height: root.hero-height;
        blur-a: Favorites.blur-img-a;
        blur-b: Favorites.blur-img-b;
        use-a: Favorites.blur-use-a;
        has-blur: Favorites.has-blur;
    }

    VerticalLayout {
        // --- Hero -----------------------------------------------------------
        Rectangle {
            vertical-stretch: 0;
            height: root.hero-height;

            VerticalLayout {
                padding: Theme.pad-lg;
                spacing: Theme.pad-md;

                // Tab bar left, filter right — the Settings header row, on a
                // banner. Both paint on the blur, so the bar takes
                // `HeroBackdrop` tiers instead of its `Theme.*` defaults;
                // `SearchBar` is the documented exception and keeps its own
                // `floating-chrome-bg` chrome.
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.pad-md;

                    bar := TabBar {
                        labels: [@tr("Songs"), @tr("Most Played"), @tr("Favorite Artists")];
                        icons: ["music_note", "bar_chart", "person"];
                        avail-width: root.content-w - root.search-w - 2 * Theme.pad-md;
                        selected-index <=> Favorites.tab-idx;
                        label-color: HeroBackdrop.on-backdrop;
                        // `active-color` is one input for the selected label,
                        // its FILL=1 icon and the underline, so it has to be a
                        // hero token like the other three: the band takes its
                        // hue from the mosaic now, and `Theme.accent` is a
                        // theme value that no longer has anything to do with
                        // it. It also had no contrast floor here — Latte's
                        // mauve lands near 1.7:1 on the pinned band, where
                        // `chrome` is solved to clear 3:1 against it whatever
                        // the cover. The cost is that the selected label sits
                        // on the 3:1 tier while the idle ones sit on
                        // `on-backdrop`'s 4.5:1; splitting label from
                        // indicator would mean a second input on `TabBar`,
                        // which Settings would inherit too.
                        active-color: HeroBackdrop.chrome;
                        hover-fill: HeroBackdrop.on-backdrop.with-alpha(0.12);
                        divider-color: HeroBackdrop.tile-edge;
                        selected(i) => {
                            // Direction first, and in the same handler that
                            // moved the index: the bar has already written
                            // `tab-idx`, but Slint re-evaluates the `if`
                            // branches at the next frame, so this still lands
                            // before the new body mounts. Same ordering rule
                            // `src/ui/nav_transition.rs` follows for the
                            // page-level transition.
                            root.tab-enter-from = i > bar.previous-index
                                ? NavEnterFrom.right
                                : NavEnterFrom.left;
                            root.tab-anim-armed = true;
                            // A Songs filter carried into the Artists grid
                            // would silently hide cards, so the pick clears
                            // it. Rust drops its own filter shadow in
                            // `tab-changed` — this only moves the Slint side.
                            Favorites.filter = "";
                            Favorites.blur-search-tick += 1;
                            Favorites.tab-changed(i);
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Padded to the same band the bar keeps clear for its
                    // divider and underline, so the input centres on the tab
                    // labels' line rather than on the row's.
                    VerticalLayout {
                        alignment: center;
                        padding-bottom: Theme.pad-sm;
                        SearchBar {
                            input-width: root.search-w;
                            text <=> Favorites.filter;
                            placeholder: root.filter-placeholder;
                            blur-trigger: Favorites.blur-search-tick;
                            edited(t) => { root.filter-tick-pending += 1; }
                        }
                    }
                }

                // Mosaic tile + title block.
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.pad-lg;

                    // Mosaic tile. The outer Rectangle owns the chrome
                    // (background, border, radius, clip); CoverMosaic just
                    // paints the 1..=4 tile layout inside.
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;

                        Rectangle {
                            width: root.hero-artwork;
                            height: root.hero-artwork;
                            // Empty state mirrors the tracklist placeholder's
                            // 15 %-tinted fill so an empty favorites hero
                            // reads as a giant placeholder tile, not a
                            // generic surface — but tinted off the solved
                            // `HeroBackdrop.chrome`, not `Theme.accent`: this
                            // tile sits *on* the hero, and with no mosaic the
                            // hero is the dark gradient floor, where a light
                            // theme's accent lands dark-on-dark. The
                            // populated fill is a hero token too, and has to
                            // be: the mosaic's placeholder slots are
                            // translucent, so whatever fills this rectangle
                            // is most of what their chrome composites
                            // against. `Theme.surface1` is near-white on a
                            // light theme, which would put a light chrome
                            // glyph on a light tile.
                            background: Favorites.track-count == 0
                                ? HeroBackdrop.chrome.with-alpha(0.15)
                                : HeroBackdrop.floor-start;
                            border-radius: Theme.radius-lg;
                            border-width: 1px;
                            border-color: HeroBackdrop.tile-edge;
                            clip: true;

                            // Empty-state — zero favorites in the library.
                            // A favorite that lacks artwork still contributes
                            // a *tile* to the mosaic (rendered as a
                            // placeholder by `CoverMosaic`), so this branch
                            // fires only on an empty favorites set, not on
                            // "favorites with no artwork".
                            if Favorites.track-count == 0: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    MaterialIcon {
                                        name: "favorite";
                                        filled: true;
                                        icon-size: 56px;
                                        icon-color: HeroBackdrop.chrome;
                                    }
                                }
                            }

                            // Layout adapts to favorite count (capped at 4),
                            // each slot independently artwork-or-placeholder.
                            // Distinct artwork paths fill leading slots;
                            // remaining slots paint chrome-tinted placeholder
                            // tiles via ArtworkImage.
                            if Favorites.track-count > 0: CoverMosaic {
                                width: 100%;
                                height: 100%;
                                artwork-paths: Favorites.mosaic-paths;
                                tile-count: Favorites.track-count > 4 ? 4 : Favorites.track-count;
                                placeholder-icon: "music-note";
                                // Flush-fill: tiles butt up edge-to-edge and
                                // hit the outer rectangle's clip border, so
                                // the hero reads as a single composited image
                                // (parity with the playlist detail's baked
                                // composite) rather than as a grid with
                                // borders between its cells.
                                gutter-size: 0px;
                                tile-radius: 0px;
                                // Slots past the distinct-artwork count paint
                                // placeholders straight onto the hero, so they
                                // take the solved chrome for the same reason
                                // the empty state above does.
                                tile-bg: HeroBackdrop.chrome.with-alpha(0.15);
                                tile-icon-color: HeroBackdrop.chrome;
                                request-cover(p) => {
                                    return Favorites.request-mosaic-cover(p);
                                }
                            }
                        }
                    }

                    // Title, stats, and the per-tab action pill.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: stretch;
                        spacing: Theme.pad-xs;

                        Text {
                            vertical-stretch: 0;
                            text: "\u{200e}" + @tr("Favorites");
                            color: HeroBackdrop.on-backdrop;
                            font-size: 28px;
                            font-weight: Theme.page-title-weight;
                            horizontal-alignment: left;
                        }

                        Text {
                            vertical-stretch: 0;
                            text: root.stats-text;
                            color: HeroBackdrop.on-backdrop-muted;
                            font-size: Theme.font-size-md;
                            horizontal-alignment: left;
                        }

                        Rectangle { vertical-stretch: 1; }

                        // Per-tab action row. Songs gets the full pill —
                        // Shuffle, the column toggle and the selection chip;
                        // Most Played gets a Shuffle scoped to what its grid
                        // shows. Favorite Artists gets neither — over a list
                        // of artists, shuffling and track columns both mean
                        // nothing — and carries a sort row instead, the shape
                        // the Albums / Artists / Genres grids use. Most Played
                        // has no sort row on purpose: its title names its own
                        // ordering.
                        if Favorites.tab-idx == Favorites.tab-songs
                            && Favorites.track-count > 0: HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.pad-md;
                            alignment: start;

                            ActionPill {
                                PillButton {
                                    icon: "shuffle";
                                    text: @tr("Shuffle");
                                    clicked => { Favorites.shuffle-all(); }
                                }
                                PillDivider { }
                                ColumnTogglePopup {
                                    show-number  <=> Favorites.show-number;
                                    show-artwork <=> Favorites.show-artwork;
                                    show-artist  <=> Favorites.show-artist;
                                    show-album   <=> Favorites.show-album;
                                    show-genre   <=> Favorites.show-genre;
                                    show-year    <=> Favorites.show-year;
                                    toggled(id) => { Favorites.toggle-column(id); }
                                }
                                if Favorites.selected-ids.length > 0: PillDivider { }
                                if Favorites.selected-ids.length > 0: PillLabel {
                                    text: @tr("{} selected", Favorites.selected-ids.length);
                                }
                                if Favorites.selected-ids.length > 0: PillButton {
                                    icon: "close";
                                    tooltip-text: @tr("Clear selection");
                                    clicked => {
                                        Favorites.clear-selection();
                                        Favorites.blur-search-tick += 1;
                                    }
                                }
                            }
                        }

                        if Favorites.tab-idx == Favorites.tab-most-played
                            && Favorites.most-played-count > 0: HorizontalLayout {
                            vertical-stretch: 0;
                            alignment: start;

                            ActionPill {
                                PillButton {
                                    icon: "shuffle";
                                    text: @tr("Shuffle");
                                    clicked => { Favorites.shuffle-most-played(); }
                                }
                            }
                        }

                        // Sort row. The two fields are what a card shows —
                        // its title and its "{n} favorites" subtitle — so an
                        // ordering is always visibly justified. Clicking the
                        // active field flips the direction, a new field resets
                        // to ascending; both handled Rust-side in
                        // `wire_favorites`, as on every other sort row.
                        if Favorites.tab-idx == Favorites.tab-artists
                            && Favorites.artist-count > 0: HorizontalLayout {
                            vertical-stretch: 0;
                            alignment: start;

                            ActionPill {
                                PillButton {
                                    text: @tr("Name");
                                    reserve-sort-slot: true;
                                    sort-direction: Favorites.artist-sort-field == "name"
                                        ? Favorites.artist-sort-dir : "";
                                    active: Favorites.artist-sort-field == "name";
                                    clicked => { Favorites.request-artist-sort("name"); }
                                }
                                PillDivider { }
                                PillButton {
                                    text: @tr("Favorites");
                                    reserve-sort-slot: true;
                                    sort-direction: Favorites.artist-sort-field == "favorite_count"
                                        ? Favorites.artist-sort-dir : "";
                                    active: Favorites.artist-sort-field == "favorite_count";
                                    clicked => { Favorites.request-artist-sort("favorite_count"); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Sub-view body ---------------------------------------------------
        //
        // One tab mounted at a time, each owning its own scroller and its own
        // overlay scrollbars. The bars live inside their branch because Slint
        // can't read an id declared inside an `if` from outside it — which is
        // also why each branch wraps in its own `ViewTransition` rather than
        // the body wrapping one: the slide has to carry the scrollbars with
        // the content, and the whole thing is destroyed and rebuilt anyway.
        // `clip` here is what contains the 32 px overshoot.
        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // --- Songs ------------------------------------------------------
            if Favorites.tab-idx == Favorites.tab-songs: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: root.tab-enter-from;
                enabled: root.tab-anim-armed;
                HorizontalLayout {
                    padding-left: Theme.pad-lg;
                    padding-right: Theme.pad-lg;
                    padding-top: Theme.pad-md;

                    tl := TrackList {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        rows: Favorites.tracks;

                        w-number <=> Favorites.w-number;
                        w-title <=> Favorites.w-title;
                        w-artist <=> Favorites.w-artist;
                        w-album <=> Favorites.w-album;
                        w-genre <=> Favorites.w-genre;
                        w-year <=> Favorites.w-year;
                        w-length <=> Favorites.w-length;

                        show-number <=> Favorites.show-number;
                        show-artwork <=> Favorites.show-artwork;
                        show-artist <=> Favorites.show-artist;
                        show-album <=> Favorites.show-album;
                        show-genre <=> Favorites.show-genre;
                        show-year <=> Favorites.show-year;
                        number-mode: "index";

                        sort-field: Favorites.sort-field;
                        sort-dir: Favorites.sort-dir;
                        playing-track-id: Player.vm.track.id;
                        view-context: "favorites";
                        view-selected-ids: Favorites.selected-ids;

                        request-sort(f) => { Favorites.request-sort(f); }
                        play-row(id, idx) => { Favorites.play-row(id, idx); }
                        play-next(ids) => { Favorites.play-next(ids); }
                        add-to-queue(ids) => { Favorites.add-to-queue(ids); }
                        toggle-row-favorite(ids, on) => { Favorites.toggle-row-favorite(ids, on); }
                        set-row-rating(ids, n) => { Favorites.set-row-rating(ids, n); }
                        select-row(idx, id, sh, ct) => { Favorites.select-row(idx, id, sh, ct); }
                        request-blur-search => { Favorites.blur-search-tick += 1; }
                        go-to-album(aid) => { Favorites.go-to-album(aid); }
                        go-to-artist(aid) => { Favorites.go-to-artist(aid); }
                        go-to-genre(gid) => { Favorites.go-to-genre(gid); }
                    }
                }

                OverlayScrollbar {
                    horizontal: false;
                    x: parent.width - self.width;
                    // Align with the ListView body inside TrackList so the bar
                    // stays out of the column-header band.
                    y: tl.y + tl.body-y;
                    width: 10px;
                    height: tl.body-height;
                    visible-size: tl.v-visible-height;
                    content-size: tl.v-viewport-height;
                    offset: tl.v-offset;
                    scroll-to(o) => { tl.set-v-offset(o); }
                }

                OverlayScrollbar {
                    horizontal: true;
                    x: tl.x;
                    y: parent.height - self.height;
                    width: tl.width - 10px;
                    height: 10px;
                    visible-size: tl.h-visible-width;
                    content-size: tl.h-viewport-width;
                    offset: tl.h-offset;
                    scroll-to(o) => { tl.set-h-offset(o); }
                }
            }

            // --- Most Played ------------------------------------------------
            if Favorites.tab-idx == Favorites.tab-most-played: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: root.tab-enter-from;
                enabled: root.tab-anim-armed;

                mp := EntityCardGrid {
                    // Positioned rather than wrapped in a layout, so the
                    // scrollbar below can reuse the same two numbers instead
                    // of chasing a layout's padding.
                    y: Theme.pad-md;
                    width: 100%;
                    height: parent.height - Theme.pad-md;
                    rows: Favorites.most-played-rows;
                    card-width: geom.card-w;
                    card-height: geom.card-h;
                    row-height: geom.row-h;
                    gap: root.grid-gap;
                    show-play-count: true;
                    covers-generation: Favorites.covers-generation;
                    request-cover(p, gen) => { Favorites.request-most-played-cover(p, gen) }
                    row-clicked(id) => { Favorites.play-track(id); }
                }

                if Favorites.most-played-count == 0: GridEmptyState {
                    icon: "bar_chart";
                    title: @tr("Nothing played yet");
                    body: @tr("Play one of your favorites and it will show up here.");
                }

                OverlayScrollbar {
                    horizontal: false;
                    x: parent.width - self.width;
                    y: Theme.pad-md;
                    width: 10px;
                    height: parent.height - Theme.pad-md;
                    visible-size: mp.v-visible-height;
                    content-size: mp.v-viewport-height;
                    offset: mp.v-offset;
                    scroll-to(o) => { mp.set-v-offset(o); }
                }
            }

            // --- Favorite Artists -------------------------------------------
            if Favorites.tab-idx == Favorites.tab-artists: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: root.tab-enter-from;
                enabled: root.tab-anim-armed;

                ar := EntityCardGrid {
                    y: Theme.pad-md;
                    width: 100%;
                    height: parent.height - Theme.pad-md;
                    rows: Favorites.artist-rows;
                    card-width: geom.card-w;
                    card-height: geom.card-h;
                    row-height: geom.row-h;
                    gap: root.grid-gap;
                    circular: true;
                    fallback-icon: "person";
                    covers-generation: Favorites.covers-generation;
                    request-cover(p, gen) => { Favorites.request-artist-cover(p, gen) }
                    row-clicked(id) => { Favorites.open-artist(id); }
                }

                if Favorites.artist-count == 0: GridEmptyState {
                    icon: "person";
                    title: @tr("No favorite artists yet");
                    body: @tr("Favorite a song and its artist appears here.");
                }

                OverlayScrollbar {
                    horizontal: false;
                    x: parent.width - self.width;
                    y: Theme.pad-md;
                    width: 10px;
                    height: parent.height - Theme.pad-md;
                    visible-size: ar.v-visible-height;
                    content-size: ar.v-viewport-height;
                    offset: ar.v-offset;
                    scroll-to(o) => { ar.set-v-offset(o); }
                }
            }
        }
    }

    // Compact-mode tab tooltip, on a layer of its own. It can't hang off the
    // tab: the bar sits in the hero, and Slint paints in declaration order,
    // so anything the hero owns is covered by the body underneath it. Equal
    // width cells let the rect come from the index, so a tab that moves under
    // a parked pointer keeps its tooltip anchored — and since `tab-w` eases,
    // the frame morphs with the cell for free.
    tab-tip := Rectangle {
        x: bar.absolute-position.x - root.absolute-position.x
            + bar.tab-w * bar.hovered-idx;
        y: bar.absolute-position.y - root.absolute-position.y;
        width: bar.tab-w;
        height: bar.height;
        Tooltip {
            text: bar.hovered-label;
            hovered: bar.hovered-idx >= 0 && bar.compact;
            host-width: tab-tip.width;
            host-height: tab-tip.height;
            side: TooltipSide.below;
        }
    }
}
