import { Theme } from "../../theme.slint";
import { RecentlyPlayed } from "../../globals/curated.slint";
import { Player } from "../../globals/player.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { TrackList } from "../../components/track-list/track-list.slint";

// The Songs tab: a `TrackList` over the post-filter recency model, with its own
// overlay scrollbars. No inputs — everything it reads is on a global. The
// scrollbars live here rather than at the mount site because Slint can't read an
// id declared inside an `if` from outside it, which is also what makes a per-tab
// file the natural boundary.
//
// **Mounted `sortable: false`, and that is the page.** Recency is what this list
// is; the order it would otherwise offer is a synthetic `"recency"` field no
// header cell owns, so a single click was unreachable to undo — and it persisted,
// so the page reopened permanently alphabetical. The headers still resize and
// still toggle.
export component RecentlyPlayedSongsTab inherits Rectangle {
    HorizontalLayout {
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        padding-top: Theme.pad-md;

        tl := TrackList {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            rows: RecentlyPlayed.tracks;

            w-number <=> RecentlyPlayed.w-number;
            w-title <=> RecentlyPlayed.w-title;
            w-artist <=> RecentlyPlayed.w-artist;
            w-album <=> RecentlyPlayed.w-album;
            w-genre <=> RecentlyPlayed.w-genre;
            w-year <=> RecentlyPlayed.w-year;
            w-length <=> RecentlyPlayed.w-length;

            show-number <=> RecentlyPlayed.show-number;
            show-artwork <=> RecentlyPlayed.show-artwork;
            show-artist <=> RecentlyPlayed.show-artist;
            show-album <=> RecentlyPlayed.show-album;
            show-genre <=> RecentlyPlayed.show-genre;
            show-year <=> RecentlyPlayed.show-year;
            number-mode: "index";

            sortable: false;
            playing-track-id: Player.vm.track.id;
            view-context: "recently_played";
            view-selected-ids: RecentlyPlayed.selected-ids;

            play-row(id, idx) => { RecentlyPlayed.play-row(id, idx); }
            play-next(ids) => { RecentlyPlayed.play-next(ids); }
            add-to-queue(ids) => { RecentlyPlayed.add-to-queue(ids); }
            toggle-row-favorite(ids, on) => { RecentlyPlayed.toggle-row-favorite(ids, on); }
            set-row-rating(ids, n) => { RecentlyPlayed.set-row-rating(ids, n); }
            select-row(idx, id, sh, ct) => { RecentlyPlayed.select-row(idx, id, sh, ct); }
            request-blur-search => { RecentlyPlayed.blur-search-tick += 1; }
            go-to-album(aid) => { RecentlyPlayed.go-to-album(aid); }
            go-to-artist(aid) => { RecentlyPlayed.go-to-artist(aid); }
            go-to-genre(gid) => { RecentlyPlayed.go-to-genre(gid); }
        }
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        // Aligned with the inner ListView, so the bar stays clear of the header
        // band.
        y: tl.y + tl.body-y;
        width: 10px;
        height: tl.body-height;
        visible-size: tl.v-visible-height;
        content-size: tl.v-viewport-height;
        offset: tl.v-offset;
        scroll-to(o) => { tl.set-v-offset(o); }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
