import { Theme } from "../../theme.slint";
import { RecentlyPlayed } from "../../globals/curated.slint";
import { EntityCardGrid } from "../../components/grid/entity-card-grid.slint";
import { GridEmptyState } from "../../components/grid/grid-empty-state.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";

// The Most Played tab: an `EntityCardGrid` over the library's played tracks,
// ranked by count. It takes the host's grid geometry rather than deriving its
// own — the page owns one, and there is nothing per-tab about a card.
export component RecentlyPlayedMostPlayedTab inherits Rectangle {
    in property <length> card-w;
    in property <length> card-h;
    in property <length> row-h;
    in property <length> gap;

    mp := EntityCardGrid {
        // Positioned rather than wrapped, so the scrollbar below reuses the same
        // two numbers instead of chasing a layout's padding.
        y: Theme.pad-md;
        width: 100%;
        height: parent.height - Theme.pad-md;
        rows: RecentlyPlayed.most-played-rows;
        card-width: root.card-w;
        card-height: root.card-h;
        row-height: root.row-h;
        gap: root.gap;
        show-play-count: true;
        covers-generation: RecentlyPlayed.covers-generation;
        request-cover(p, gen) => { RecentlyPlayed.request-most-played-cover(p, gen) }
        row-clicked(id) => { RecentlyPlayed.play-track(id); }
    }

    if RecentlyPlayed.most-played-count == 0: GridEmptyState {
        icon: "bar_chart";
        title: @tr("Nothing played yet");
        body: @tr("Play something and it will show up here.");
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: Theme.pad-md;
        width: 10px;
        height: parent.height - Theme.pad-md;
        visible-size: mp.v-visible-height;
        content-size: mp.v-viewport-height;
        offset: mp.v-offset;
        scroll-to(o) => { mp.set-v-offset(o); }
    }
}
