import { Theme } from "../theme.slint";
import { Player } from "../globals/player.slint";
import { MiniPlayer, WindowChrome } from "../globals/shell.slint";
import { IconButton } from "../components/icon-button.slint";
import { ArtworkImage } from "../components/artwork-image.slint";
import { SliderTrack } from "../components/slider-track.slint";
import { VolumePopup } from "../components/now-playing/volume-popup.slint";
import { VolumePopupHorizontal } from "../components/now-playing/volume-popup-horizontal.slint";
import { PlayButton } from "../components/now-playing/play-button.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";

// Compact miniplayer that replaces the full app UI when the OS window is
// shrunk past the responsive threshold. Activated by `MiniPlayer.active`
// (computed at the `AppWindow` root from `width`/`height`); chooses between
// a horizontal strip and a square variant via `MiniPlayer.square`.
//
// Resize-only entry AND exit — there are no enter/exit buttons. The user
// shrinks the window past the threshold to engage mini, grows it back
// past the threshold to leave. Double-clicking the bare drag region
// maximises (and so also exits mini).
//
// Cap inner gutters at 8px from any window edge that hosts a resize
// TouchArea (see `app-window.slint` resize-ring). The corner TouchAreas
// are 8×8; insetting interactive controls (volume / pin pills and
// the up-next list's right edge) by 8px keeps the cursor showing the
// resize affordance instead of flickering hover state.
export component MiniPlayerView inherits Rectangle {
    background: Theme.mantle;
    // Padding doubles as resize-ring breathing room. The whole component
    // is gated on `mini-active`, so the resize-ring TouchAreas live above
    // it and the inset preserves their hit zones at all four edges.
    private property <length> edge-pad: 4px;
    // Shared with both variants — tracks live progress, applies the
    // seek-pending hold the same way the bar's slider does.
    private property <float> slider-frac:
        Player.duration-ms > 0
            ? (Player.seek_pending_ms >= 0
                ? clamp(Player.seek_pending_ms / Player.duration-ms, 0, 1)
                : clamp(Player.position-ms / Player.duration-ms, 0, 1))
            : 0;

    // ---- Window-move drag region -----------------------------------------
    // Custom-frame mode hides the `CustomTitleBar` in mini, so without
    // this the user has no way to move the window — only resize edges.
    // Covers the whole mini area at z-bottom; controls layered on top
    // (IconButtons, PlayButton, SliderTrack, UpNextList rows) win
    // hit-testing because Slint dispatches to the topmost TouchArea, so
    // `drag-region.has-hover` only goes true over empty space and
    // press-on-button behaves normally. Wires the same
    // `drag-region-hover-changed` → winit-press-intercept path used by
    // `custom-titlebar.slint` (see `src/ui/window_chrome/winit_filter.rs`).
    drag-region := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
        changed has-hover => {
            WindowChrome.drag-region-hover-changed(self.has-hover);
        }
        double-clicked => {
            // Tauri parity: double-click the mini's bare area maximizes.
            // The resulting size flip naturally trips `mini-active = false`
            // through `app-window.slint`'s derived properties.
            WindowChrome.toggle-maximize();
        }
    }

    // ---- Horizontal variant (wide & short) -------------------------------
    if !MiniPlayer.square: VerticalLayout {
        padding: root.edge-pad;
        spacing: 0;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.pad-sm;
            padding-left: Theme.pad-xs;
            padding-right: Theme.pad-xs;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                ArtworkImage {
                    artwork-path: Player.vm.track.artwork_path;
                    cover: Player.vm.track.cover_img;
                    tile-size: 48px;
                }
            }

            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Player.vm.has_track
                            ? "‎" + Player.vm.track.title
                            : @tr("No track playing");
                        color: Theme.text;
                        font-size: Theme.font-size-sm;
                        font-weight: 500;
                        overflow: elide;
                    }
                    Text {
                        text: Player.vm.has_track
                            ? "‎" + (Player.vm.track.artist == ""
                                ? @tr("Unknown artist")
                                : Player.vm.track.artist)
                            : "—";
                        color: Theme.subtext0;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }

            // Transport — centred trio matching the now-playing bar.
            HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "chevron_left";
                        press-shrink: true;
                        diameter: 28px;
                        icon-size: 18px;
                        button-enabled: Player.vm.has_previous;
                        tooltip-text: @tr("Previous");
                        clicked => { Player.previous(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        wrapper-d: 30px;
                        icon-size: 16px;
                        is-playing: Player.vm.is_playing;
                        animation-mode: 0;
                        clicked => { Player.play-pause(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "chevron_right";
                        press-shrink: true;
                        diameter: 28px;
                        icon-size: 18px;
                        button-enabled: Player.vm.has_next;
                        tooltip-text: @tr("Next");
                        clicked => { Player.next(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                alignment: end;
                // 8px inset from the right edge so the corner-resize
                // TouchAreas in app-window.slint keep their hit zone.
                padding-right: 4px;

                VerticalLayout {
                    alignment: center;
                    // Rectangle mini is wide-and-short; the vertical
                    // VolumePopup (180 px tall) clips against the top edge
                    // here. Use the horizontal sibling — same M3 slider,
                    // rotated 90°, anchored as a LEFT flyout from the disc.
                    VolumePopupHorizontal {
                        diameter: 28px;
                        icon-size: 18px;
                    }
                }
                if WindowChrome.always-on-top-supported: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "push_pin";
                        press-shrink: true;
                        diameter: 28px;
                        icon-size: 18px;
                        active: WindowChrome.always-on-top-active;
                        filled: WindowChrome.always-on-top-active;
                        tooltip-text: WindowChrome.always-on-top-active
                            ? @tr("Unpin from Top") : @tr("Pin on Top");
                        clicked => { WindowChrome.toggle-always-on-top(); }
                    }
                }
            }
        }

        // Slim slider hugging the bottom edge. No time labels (cramped).
        // Keeping `vertical-stretch: 0` here is critical — without it the
        // surrounding HL would steal vertical space and the slider would
        // float mid-row. Let `SliderTrack` use its native 24 px min-height
        // so the 24 px vertical-pill thumb doesn't clip against the
        // mini-player's bottom edge; the 4 px track itself still reads slim.
        h-slider := SliderTrack {
            vertical-stretch: 0;
            value: root.slider-frac;
            is-disabled: !Player.vm.has_track || Player.duration-ms <= 0;
            seam-mask-color: Theme.mantle;
            committed(v) => {
                if (Player.duration-ms > 0) {
                    Player.seek(round(v * Player.duration-ms));
                }
            }
        }
    }

    // ---- Square variant (taller, optionally with Up Next) ----------------
    if MiniPlayer.square: VerticalLayout {
        padding: root.edge-pad;
        spacing: Theme.pad-xs;

        // Top row — pin on the left, favorite on the right, with a
        // flexible spacer in the middle. Reserves a fixed strip even
        // when always-on-top is unsupported so the artwork below keeps
        // the same offset across desktops (the left-side wrapper
        // collapses to zero width but the row's `min-height` holds).
        HorizontalLayout {
            alignment: stretch;
            spacing: 2px;
            vertical-stretch: 0;
            padding-left: 4px;
            padding-right: 4px;
            min-height: 28px;

            // Pin — left side.
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: start;
                if WindowChrome.always-on-top-supported: IconButton {
                    icon: "push_pin";
                    press-shrink: true;
                    diameter: 28px;
                    icon-size: 18px;
                    active: WindowChrome.always-on-top-active;
                    filled: WindowChrome.always-on-top-active;
                    tooltip-text: WindowChrome.always-on-top-active
                        ? @tr("Unpin from Top") : @tr("Pin on Top");
                    clicked => { WindowChrome.toggle-always-on-top(); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Favorite — right side.
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                IconButton {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    press-shrink: true;
                    diameter: 28px;
                    icon-size: 18px;
                    active: Player.vm.track.is_favorite;
                    filled: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    tooltip-text: Player.vm.track.is_favorite
                        ? @tr("Unfavorite") : @tr("Favorite");
                    clicked => { Player.toggle-favorite(); }
                }
            }
        }

        // Centred artwork — `tile-size` clamps so the cover scales with
        // window width without ever ballooning past 180px or shrinking
        // below 90px (where the placeholder glyph stops reading).
        //
        // Source: the high-res `Player.np-cover-{a,b}` slot the
        // Now Playing view uses (decoded at 384px via
        // `NowPlayingArtwork`), with the 72px row-tier `cover_img` as a
        // fallback for the brief window before the seed lands and for
        // tracks whose decode failed. Rust gates the decode + cache
        // lifecycle on `mini_square` — see `src/ui/mini_player.rs`.
        VerticalLayout {
            alignment: center;
            vertical-stretch: 0;
            HorizontalLayout {
                alignment: center;
                ArtworkImage {
                    artwork-path: Player.vm.track.artwork_path;
                    cover: Player.np-cover-has-image
                        ? (Player.np-cover-use-a ? Player.np-cover-a : Player.np-cover-b)
                        : Player.vm.track.cover_img;
                    tile-size: clamp(root.width * 0.5, 90px, 180px);
                }
            }
        }

        // Title + artist block.
        VerticalLayout {
            alignment: center;
            vertical-stretch: 0;
            spacing: 2px;
            Text {
                text: Player.vm.has_track
                    ? "‎" + Player.vm.track.title
                    : @tr("No track playing");
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 500;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: Player.vm.has_track
                    ? "‎" + (Player.vm.track.artist == ""
                        ? @tr("Unknown artist")
                        : Player.vm.track.artist)
                    : "—";
                color: Theme.subtext0;
                font-size: 11px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // Transport + modes + volume — symmetric layout with shuffle and
        // repeat flanking the prev/play/next trio, volume at the end.
        HorizontalLayout {
            alignment: center;
            spacing: Theme.pad-xs;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "shuffle";
                    press-shrink: true;
                    diameter: 32px;
                    icon-size: 20px;
                    active: Player.queue.shuffle;
                    tooltip-text: Player.queue.shuffle
                        ? @tr("Shuffle: on") : @tr("Shuffle: off");
                    clicked => { Player.toggle-shuffle(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "chevron_left";
                    press-shrink: true;
                    diameter: 32px;
                    icon-size: 20px;
                    button-enabled: Player.vm.has_previous;
                    tooltip-text: @tr("Previous");
                    clicked => { Player.previous(); }
                }
            }
            VerticalLayout {
                alignment: center;
                PlayButton {
                    wrapper-d: 36px;
                    icon-size: 18px;
                    is-playing: Player.vm.is_playing;
                    animation-mode: 0;
                    clicked => { Player.play-pause(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "chevron_right";
                    press-shrink: true;
                    diameter: 32px;
                    icon-size: 20px;
                    button-enabled: Player.vm.has_next;
                    tooltip-text: @tr("Next");
                    clicked => { Player.next(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
                    press-shrink: true;
                    diameter: 32px;
                    icon-size: 20px;
                    active: Player.queue.repeat_mode != "off";
                    tooltip-text: Player.queue.repeat_mode == "off"
                        ? @tr("Repeat: off")
                        : (Player.queue.repeat_mode == "one"
                            ? @tr("Repeat: one")
                            : @tr("Repeat: all"));
                    clicked => { Player.cycle-repeat(); }
                }
            }
            VerticalLayout {
                alignment: center;
                VolumePopup {
                    diameter: 32px;
                    icon-size: 20px;
                }
            }
        }

        // Slim full-width slider. Use `SliderTrack`'s native 24 px height
        // so the vertical-pill thumb has room — the 4 px track stays slim,
        // the thumb stops clipping against the Up Next list above and the
        // mini's bottom edge when Up Next isn't mounted.
        s-slider := SliderTrack {
            vertical-stretch: 0;
            value: root.slider-frac;
            is-disabled: !Player.vm.has_track || Player.duration-ms <= 0;
            seam-mask-color: Theme.mantle;
            committed(v) => {
                if (Player.duration-ms > 0) {
                    Player.seek(round(v * Player.duration-ms));
                }
            }
        }

        // Up Next list — only renders when the window is tall enough to
        // hold a couple of rows alongside the artwork + controls. Reuses the
        // shared `UpNextList` component, so the slide animation +
        // outgoing-row overlay + empty state behave identically to the
        // full-screen Now Playing view. The Rust subscriber rebuilds
        // `NowPlaying.up-next-rows` whenever mini is visible (gate in
        // `src/ui/now_playing/up_next.rs`).
        if root.height >= 350px: VerticalLayout {
            vertical-stretch: 1;
            padding-top: Theme.pad-xs;
            UpNextList {
                vertical-stretch: 1;
                compact: true;
            }
        }
    }
}
