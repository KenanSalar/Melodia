import { Theme } from "../../../theme.slint";
import { SettingsPage } from "../../../globals/settings-page.slint";
import { LibrarySection } from "../library-section.slint";
import { FileWatchingSection } from "../file-watching-section.slint";

// Library tab: where music comes from, and how it stays in sync. File
// Watching pairs with the folder list rather than sitting nine cards down
// the page as it did when everything was one scroll.
//
// `has-matches` is the OR of the cards' own verdicts; the router reads it to
// decide whether the whole page filtered itself away. Every tab page carries
// this so the router never special-cases one.
//
// The page hands a `GridLayout` one cell per **column**, each cell a
// `VerticalLayout` of cards, and the columns place themselves through
// `SettingsPage.grid-row`/`grid-col` — side by side when the body is wide,
// stacked when it isn't. Cards as cells would be row-aligned instead, so a
// short card would leave a hole down to the next row rather than being
// followed by the next card.
//
// Columns are contiguous halves of the page's card list, so stacked they read
// in source order and nothing moves when the window narrows. Each card is
// mounted exactly once — see the note on those functions for why the two
// arrangements can't be separate branches. The index passed is the column's
// position in this file: unique, and no page has more than two.
export component LibraryPage inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: lib.has-matches || fw.has-matches;

    GridLayout {
        spacing: Theme.pad-lg;

        VerticalLayout {
            row: SettingsPage.grid-row(0); col: SettingsPage.grid-col(0);
            alignment: start;
            spacing: Theme.pad-lg;

            lib := LibrarySection { tab-name: @tr("Library"); }
        }

        VerticalLayout {
            row: SettingsPage.grid-row(1); col: SettingsPage.grid-col(1);
            alignment: start;
            spacing: Theme.pad-lg;

            fw := FileWatchingSection { tab-name: @tr("Library"); }
        }
    }
}
