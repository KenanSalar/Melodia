import { Theme } from "../../../theme.slint";
import { LibrarySection } from "../library-section.slint";
import { FileWatchingSection } from "../file-watching-section.slint";

// Library tab: where music comes from, and how it stays in sync. File
// Watching pairs with the folder list rather than sitting nine cards down
// the page as it did when everything was one scroll.
//
// `has-matches` is the OR of the cards' own verdicts; the router reads it to
// decide whether the whole page filtered itself away. Every tab page carries
// this so the router never special-cases one.
export component LibraryPage inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: lib.has-matches || fw.has-matches;

    VerticalLayout {
        spacing: Theme.pad-lg;

        lib := LibrarySection { tab-name: @tr("Library"); }
        fw := FileWatchingSection { tab-name: @tr("Library"); }
    }
}
