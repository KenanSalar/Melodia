import { Theme } from "../../../theme.slint";
import { SettingsPage } from "../../../globals/settings-page.slint";
import { LibrarySection } from "../library-section.slint";
import { FileWatchingSection } from "../file-watching-section.slint";

// Where music comes from and how it stays in sync. File Watching pairs with the
// folder list rather than sitting nine cards away as it did when the page was
// one scroll.
//
// `has-matches` ORs the cards' own verdicts, so the router can tell whether the
// page filtered itself away. Every tab page carries it and the router
// special-cases none.
//
// **This is also the shape every page takes.** The `GridLayout` gets one cell
// per *column*, each a `VerticalLayout` of cards placing itself through
// `SettingsPage.grid-row`/`grid-col`: side by side when the body is wide,
// stacked when it isn't. Cards as cells would be row-aligned, so a short one
// would leave a hole down to the next row instead of being followed by the next
// card. The columns are contiguous halves of the list, so stacked they read in
// source order; each card is mounted exactly once, and the index passed is the
// column's position in the file — unique, and no page has more than two.
export component LibraryPage inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: lib.has-matches || fw.has-matches;

    GridLayout {
        spacing: Theme.pad-lg;

        VerticalLayout {
            row: SettingsPage.grid-row(0); col: SettingsPage.grid-col(0);
            alignment: start;
            spacing: Theme.pad-lg;

            lib := LibrarySection { tab-name: @tr("Library"); }
        }

        VerticalLayout {
            row: SettingsPage.grid-row(1); col: SettingsPage.grid-col(1);
            alignment: start;
            spacing: Theme.pad-lg;

            fw := FileWatchingSection { tab-name: @tr("Library"); }
        }
    }
}
