import { Theme } from "../../../theme.slint";
import { SettingsPage } from "../../../globals/settings-page.slint";
import { PlaybackSection } from "../playback-section.slint";

// Playback tab. One card today — gapless, crossfade and its four
// sub-settings, resume-on-startup, the play-button animation and the
// visualizer. It keeps its own file anyway so the router treats all five
// tabs identically and a second card is a one-line addition here.
export component PlaybackPage inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    out property <bool> has-matches: pb.has-matches;

    // See `library-page.slint` for why the cards live in columns and the
    // columns place themselves. One card is one column here, so a wide body
    // leaves the second column's width empty rather than splitting the card —
    // the shape still matches the other four pages, so a second card is the
    // one-line addition promised above, and adding a second *column* is four.
    GridLayout {
        spacing: Theme.pad-lg;

        VerticalLayout {
            row: SettingsPage.grid-row(0); col: SettingsPage.grid-col(0);
            alignment: start;
            spacing: Theme.pad-lg;

            pb := PlaybackSection { tab-name: @tr("Playback"); }
        }
    }
}
