import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { Dropdown } from "../../components/settings/dropdown.slint";

// Language section: single row with the locale dropdown.
//
// Wiring: the dropdown's options + selected index come from the `Settings`
// global, which Rust populates in `src/ui/locale.rs::install_locale` from
// `services::settings::SUPPORTED_LOCALES`. Native-name labels ("English",
// "Deutsch") are intentionally NOT translated — language pickers always
// render each option in its own script. Section title and row label are
// translated via `@tr(...)` so the rest of the page header / label stays
// readable when the user picks a non-English locale.
//
// Search visibility wrapper: each section is a thin Rectangle that hosts
// the SectionCard inside an `if has-matches:` conditional element so the
// whole card is removed from layout when no row matches the live query.
// `visible: false` would keep the title/card slot in the VerticalLayout
// (CLAUDE.md "visible: false does not remove an element from layout"), so
// we use the conditional element form. `has-matches` is exposed as an
// `out property` so the page that mounts this section can detect the
// "all sections hidden" state and render the no-results placeholder.
//
// The rule itself lives on `SettingsPage`; the local wrapper binds this
// section's title once so the per-row call sites stay two arguments.
export component LanguageSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name + " " + @tr("Language"),
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    out property <bool> has-matches:
        row-visible(@tr("Choose your preferred language"), "");

    // The Rectangle wrapper around the conditional SectionCard would
    // report 0 preferred-height to the parent VerticalLayout (Rectangle
    // sizes to a layout child, not to positioned children — including
    // `if`-elements). Wrapping in VerticalLayout makes preferred-height
    // track the SectionCard's natural height when present, 0 when absent,
    // so the section card collapses cleanly under search filtering and
    // expands to its real height otherwise.
    VerticalLayout {
        if has-matches: SectionCard {
            title: @tr("Language");

            if root.row-visible(@tr("Choose your preferred language"), ""): SettingRow {
                icon: "translate";
                label: @tr("Choose your preferred language");
                description: "";
                Dropdown {
                    options: Settings.language-names;
                    selected-index <=> Settings.language-idx;
                    trigger-width: 160px;
                    // Dropdown updates `selected-index` itself before firing
                    // `selected(i)`. Forward straight to the Settings global's
                    // `language-changed(int)` callback — Rust resolves idx →
                    // code, calls `slint::select_bundled_translation`, and
                    // persists.
                    selected(idx) => { Settings.language-changed(idx); }
                }
            }
        }
    }
}
