import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { Dialog } from "../../globals/dialog.slint";
import { LibrarySettings } from "../../globals/library-settings.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { FolderRow } from "../../components/settings/folder-row.slint";
import { ProgressBar } from "../../components/settings/progress-bar.slint";

// Library section: "Manage Folders" header sub-row + Add Folder button,
// optional scan progress, list of folder rows (or empty state). Section
// title is "Library Folders" (Tauri parity, not just "Library"). All state
// flows from the `LibrarySettings` global, which Rust hydrates from the DB
// at startup and refreshes after every mutation.
//
// Search visibility — this section has no SettingRows (it's a folder
// management UI, not a stack of toggleable settings), so we treat the
// whole card as one searchable atom: matches the section title or one of
// the keyword aliases ("manage folders", "add folder") and shows the
// section in full; otherwise hides the card entirely. This is the same
// behaviour macOS System Settings / VS Code / JetBrains use for container
// UIs in their settings search.
export component LibrarySection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    out property <bool> has-matches:
        SettingsPage.row-visible(root.tab-name, @tr("Library Folders"),
                                 @tr("Manage Folders") + " " + @tr("Add Folder"),
                                 SettingsPage.search-query);

    // VerticalLayout wrapper so the Rectangle's preferred-height tracks
    // the SectionCard's natural height. See `language-section.slint`.
    VerticalLayout {
    if has-matches: SectionCard {
        title: @tr("Library Folders");

        // Header row: "Manage Folders" label + Add Folder button. Same row
        // chrome pattern as SettingRow but without the icon column — this is
        // a card-internal sub-header, not a setting row.
        Rectangle {
            background: transparent;
            HorizontalLayout {
                padding: Theme.pad-lg;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Manage Folders");
                        color: Theme.text;
                        font-size: Theme.font-size-md;
                        font-weight: 600;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    SectionButton {
                        label: @tr("Add Folder");
                        icon: "create_new_folder";
                        button-enabled: !LibrarySettings.scanning;
                        primary: true;
                        clicked => {
                            LibrarySettings.add-folder();
                        }
                    }
                }
            }
        }

        SectionDivider {}

        // Scan progress (conditional). Single column laying out the bar +
        // file label + counter; fits within 16 px row padding.
        if LibrarySettings.scanning: Rectangle {
            background: transparent;
            VerticalLayout {
                padding: Theme.pad-lg;
                spacing: Theme.pad-sm;
                ProgressBar {
                    value: LibrarySettings.scan-progress;
                }
                Text {
                    text: LibrarySettings.scanning-file != ""
                        ? @tr("{} / {} files · {}",
                              LibrarySettings.scanned-count,
                              LibrarySettings.total-count,
                              LibrarySettings.scanning-file)
                        : @tr("{} / {} files",
                              LibrarySettings.scanned-count,
                              LibrarySettings.total-count);
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                }
            }
        }
        if LibrarySettings.scanning: SectionDivider {}

        // Folder list. Folders is a tiny list (a handful of entries) so a
        // plain `for` loop is fine; no virtualization. Each row is followed
        // by a divider except the last — Slint has no `last-child` selector,
        // so we draw a divider above each row from index 1 onward. The row's
        // `id` is captured by the closure so callbacks know which folder.
        for row[i] in LibrarySettings.folders: VerticalLayout {
            if i > 0: SectionDivider {}
            FolderRow {
                path: row.path;
                last-scanned: row.last-scanned;
                // Block per-row actions while a scan is in flight: prevents
                // two rescans from racing on `scan_progress_tx` (shared
                // watch channel; the first scan's drop-guard would clear
                // the bar mid-second-scan, causing a visible flicker).
                actions-enabled: !LibrarySettings.scanning;
                rescan-clicked => {
                    LibrarySettings.rescan-folder(row.id);
                }
                remove-clicked => {
                    // Route through the centralised confirmation dialog so a
                    // stray click can't cascade-delete every track in the
                    // folder. `kind` + `target-id` are picked up by the
                    // default `accepted` handler on the `Dialog` global,
                    // which calls `LibrarySettings.remove-folder` on confirm.
                    Dialog.kind = "remove-folder";
                    Dialog.target-id = row.id;
                    Dialog.title = @tr("Remove Folder?");
                    Dialog.message = @tr("Remove \"{}\" from your library? All tracks under this folder will be removed.", row.path);
                    Dialog.confirm-label = @tr("Remove");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = true;
                    Dialog.open = true;
                }
            }
        }

        // Empty state (only when `folders` is empty). Tauri uses
        // `folder_open` icon + "No folders added" + the description below.
        if LibrarySettings.folders.length == 0: Rectangle {
            background: transparent;
            height: 140px;
            VerticalLayout {
                alignment: center;
                spacing: Theme.pad-sm;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "folder_open";
                            font-family: "Material Symbols Rounded";
                            font-size: 32px;
                            color: Theme.subtext0;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: @tr("No folders added");
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Add a folder to scan for music files.");
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
            }
        }
    }
    }
}
