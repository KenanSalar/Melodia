import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// One toggle row. Search visibility follows `language-section.slint`.
export component RatingsSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, @tr("Ratings"),
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    out property <bool> has-matches:
        row-visible(@tr("Save ratings to files"),
            @tr("Write star ratings into each file's tags, so they survive a rescan and other players can read them."));

    // Wrapper so the root's preferred-height tracks the card's natural height —
    // see `language-section.slint`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: @tr("Ratings");

            if root.row-visible(@tr("Save ratings to files"),
                    @tr("Write star ratings into each file's tags, so they survive a rescan and other players can read them.")): SettingRow {
                icon: "star";
                label: @tr("Save ratings to files");
                description: @tr("Write star ratings into each file's tags, so they survive a rescan and other players can read them.");
                ToggleSwitch {
                    checked <=> Settings.write-ratings-to-tags;
                    toggled(v) => { Settings.write-ratings-to-tags-changed(v); }
                }
            }
        }
    }
}
