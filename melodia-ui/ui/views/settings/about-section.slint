import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MelodiaUpdater } from "../../globals/updater.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// About section. The last card on the Settings page — surfaces the app
// identity (name + version), authorship, a link to the source repository,
// and the license. Mirrors the conventional desktop "About" pane.
//
// Unlike the Updates section every row is always present (no backend state
// gates them); only the live search filter can hide a row.
//
// The repository link routes through `Settings.open-repository()` (wired
// in `src/ui/about.rs`), which opens `CARGO_PKG_REPOSITORY` in the system
// browser via the `open` crate — the same launcher the "Open Containing
// Folder" action uses. The version string reads from
// `MelodiaUpdater.current-version` (already seeded with `CARGO_PKG_VERSION`
// by `src/ui/updater_settings.rs`), so the About and Updates cards can't
// disagree.
//
// Search visibility — see header comment in `language-section.slint`.
export component AboutSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, @tr("About"),
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // "Melodia" (brand), the SPDX license id, and "GitHub" (proper noun)
    // are deliberately untranslated but still belong in the search
    // haystack so a query for them surfaces the right row.
    property <bool> show-app:
        row-visible("Melodia", @tr("Version {}", MelodiaUpdater.current-version));
    property <bool> show-author:
        row-visible(@tr("Made by {}", "Kenan Salar"), "GitHub");
    property <bool> show-license:
        row-visible(@tr("License"), "AGPL-3.0-or-later");

    out property <bool> has-matches: show-app || show-author || show-license;

    // VerticalLayout wrapper so the Rectangle's preferred-height tracks
    // the SectionCard's natural height. See `language-section.slint`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: @tr("About");

            // App identity + version.
            if root.show-app: SettingRow {
                icon: "info";
                label: "Melodia";
                description: @tr("Version {}", MelodiaUpdater.current-version);
            }

            // Authorship + source-repository link. The button uses no
            // leading icon, matching the Updates section's action buttons.
            if root.show-app && root.show-author: SectionDivider {}
            if root.show-author: SettingRow {
                icon: "person";
                label: @tr("Made by {}", "Kenan Salar");
                SectionButton {
                    label: "GitHub";
                    icon: "";
                    primary: false;
                    clicked => { Settings.open-repository(); }
                }
            }

            // License (SPDX identifier — not translated).
            if (root.show-app || root.show-author) && root.show-license: SectionDivider {}
            if root.show-license: SettingRow {
                icon: "balance";
                label: @tr("License");
                description: "AGPL-3.0-or-later";
            }
        }
    }
}
