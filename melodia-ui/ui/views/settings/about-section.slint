import { Settings } from "../../settings.slint";
import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MelodiaUpdater } from "../../globals/updater.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// The conventional About pane: identity, authorship, a support link, a repository
// link and the license. Unlike Updates, no backend state gates a row — only the
// search filter can hide one.
//
// The version reads `MelodiaUpdater.current-version` rather than its own copy,
// so About and Updates can't disagree. Both links reach the same launcher "Open
// Containing Folder" uses — the repository through `src/ui/settings/about.rs`, Ko-fi
// through `src/ui/support.rs`, which owns it because the support toast fires the same
// callback. Search visibility follows `language-section.slint`.
export component AboutSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("About");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // The brands, the SPDX id and "GitHub" / "Ko-fi" stay untranslated but still
    // belong in the haystack — they're what a user would type.
    property <string> app-label: "Melodia";
    property <string> version-desc: @tr("Version {}", MelodiaUpdater.current-version);
    property <string> author-label: @tr("Made by {}", "Kenan Salar");
    property <string> repo-label: "GitHub";
    property <string> support-label: @tr("Support Melodia");
    property <string> support-desc: @tr("Melodia is free and open source. Support helps keep it going.");
    property <string> license-label: @tr("License");
    property <string> license-desc: "AGPL-3.0-or-later";
    property <string> kofi-label: @tr("Support me on Ko-fi");

    property <bool> show-app: row-visible(app-label, version-desc);
    property <bool> show-author: row-visible(author-label, repo-label);
    // The button's own wording is a term too, "Ko-fi" alone being the brand rather than
    // anything the row says about it.
    property <bool> show-support: row-visible(support-label, support-desc)
        || row-visible(kofi-label, "Ko-fi");
    property <bool> show-license: row-visible(license-label, license-desc);

    out property <bool> has-matches: show-app || show-author || show-support || show-license;

    // Wrapper so the root's preferred-height tracks the card's natural height —
    // see `language-section.slint`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            if root.show-app: SettingRow {
                icon: "info";
                label: root.app-label;
                description: root.version-desc;
            }

            // No leading icon, matching the Updates section's action buttons.
            if root.show-app && root.show-author: SectionDivider {}
            if root.show-author: SettingRow {
                icon: "person";
                label: root.author-label;
                SectionButton {
                    label: root.repo-label;
                    icon: "";
                    primary: false;
                    clicked => { Settings.open-repository(); }
                }
            }

            // The one filled button in the card, and deliberately so — it asks for
            // something rather than going somewhere. The mark keeps its own colours: it
            // is Ko-fi's, and it reads on any accent because it carries both ends — the
            // dark outline over a light one, the white cup over a dark one.
            if (root.show-app || root.show-author) && root.show-support: SectionDivider {}
            if root.show-support: SettingRow {
                icon: "favorite";
                label: root.support-label;
                description: root.support-desc;
                SectionButton {
                    label: root.kofi-label;
                    icon: "";
                    leading-image: @image-url("../../assets/icons/kofi-symbol.svg");
                    corner-radius: Theme.radius-md;
                    primary: true;
                    clicked => { Settings.open-kofi(); }
                }
            }

            if (root.show-app || root.show-author || root.show-support) && root.show-license: SectionDivider {}
            if root.show-license: SettingRow {
                icon: "balance";
                label: root.license-label;
                description: root.license-desc;
            }
        }
    }
}
