import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MelodiaUpdater } from "../../globals/updater.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// The conventional About pane: identity, authorship, a repository link and the
// license. Unlike Updates, no backend state gates a row — only the search
// filter can hide one.
//
// The version reads `MelodiaUpdater.current-version` rather than its own copy,
// so About and Updates can't disagree; the link goes through `src/ui/about.rs`
// to the same launcher "Open Containing Folder" uses. Search visibility follows
// `language-section.slint`.
export component AboutSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, @tr("About"),
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // The brand, the SPDX id and "GitHub" stay untranslated but still belong in
    // the haystack — they're what a user would type.
    property <bool> show-app:
        row-visible("Melodia", @tr("Version {}", MelodiaUpdater.current-version));
    property <bool> show-author:
        row-visible(@tr("Made by {}", "Kenan Salar"), "GitHub");
    property <bool> show-license:
        row-visible(@tr("License"), "AGPL-3.0-or-later");

    out property <bool> has-matches: show-app || show-author || show-license;

    // Wrapper so the root's preferred-height tracks the card's natural height —
    // see `language-section.slint`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: @tr("About");

            if root.show-app: SettingRow {
                icon: "info";
                label: "Melodia";
                description: @tr("Version {}", MelodiaUpdater.current-version);
            }

            // No leading icon, matching the Updates section's action buttons.
            if root.show-app && root.show-author: SectionDivider {}
            if root.show-author: SettingRow {
                icon: "person";
                label: @tr("Made by {}", "Kenan Salar");
                SectionButton {
                    label: "GitHub";
                    icon: "";
                    primary: false;
                    clicked => { Settings.open-repository(); }
                }
            }

            if (root.show-app || root.show-author) && root.show-license: SectionDivider {}
            if root.show-license: SettingRow {
                icon: "balance";
                label: @tr("License");
                description: "AGPL-3.0-or-later";
            }
        }
    }
}
