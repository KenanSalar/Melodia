import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SettingRowStacked } from "../../components/settings/setting-row-stacked.slint";
import { Checkbox } from "../../components/checkbox.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// One overflow-menu checkbox cell. Local component because it's only
// used inside this section's 2-column grid. `id` is the persisted
// button id (e.g. "favorite"); `toggled` fires after `checked` has
// been flipped so the host can pass the freshly-flipped value
// straight to Rust.
component OverflowCheckCell inherits Rectangle {
    in property <string> id;
    in property <string> icon;
    in property <string> label;
    in-out property <bool> checked;
    callback toggled();

    background: touch.has-hover ? Theme.surface1 : transparent;
    border-radius: Theme.radius-sm;
    animate background { duration: 100ms; easing: ease-in-out; }

    HorizontalLayout {
        padding: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Checkbox { checked: root.checked; }
        }
        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 20px;
                icon-color: Theme.text;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            // The `label` property is already a translated string when
            // populated by the caller (each OverflowCheckCell instantiation
            // below passes `@tr("...")` literals), so no `@tr()` here.
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-size-sm;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// Overflow Menu Buttons section. Split out of `appearance-section.slint`
// because it's a now-playing-bar feature, not a palette / chrome
// concern. The 2-column grid binds two-way to `Settings.overflow-*`;
// each cell fires `Settings.overflow-buttons-changed(id, checked)` on
// click so Rust can persist the new state into
// `settings.overflow_buttons`.
export component OverflowMenuSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name + " " + @tr("Player Bar"),
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    property <bool> show-overflow: row-visible(@tr("Overflow Menu Buttons"),
        @tr("Move selected buttons into a compact overflow menu in the player bar"));

    out property <bool> has-matches: show-overflow;

    VerticalLayout {
    if has-matches: SectionCard {
        title: @tr("Player Bar");

        // Overflow Menu Buttons. 2-column checkbox grid below the
        // description.
        if root.show-overflow: SettingRowStacked {
            icon: "more_vert";
            label: @tr("Overflow Menu Buttons");
            description: @tr("Move selected buttons into a compact overflow menu in the player bar");

            // GridLayout (not nested HorizontalLayouts) is the canonical
            // Slint pattern for a 2-column grid with equal-width cells.
            // `horizontal-stretch: 1` distributes only the *extra* space
            // proportionally on top of each cell's preferred width — so
            // cells with longer labels (e.g. "Pin on Top" vs "Repeat") end
            // up wider, and the right column visibly drifts left between
            // rows. GridLayout sizes each column to the widest cell in
            // that column, then enforces that width across all rows, so
            // columns line up by construction.
            GridLayout {
                spacing: Theme.pad-xs;
                Row {
                    OverflowCheckCell {
                        id: "favorite";
                        icon: "favorite";
                        label: @tr("Favorite");
                        checked <=> Settings.overflow-favorite;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                    OverflowCheckCell {
                        id: "repeat";
                        icon: "repeat";
                        label: @tr("Repeat");
                        checked <=> Settings.overflow-repeat;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                }
                Row {
                    OverflowCheckCell {
                        id: "shuffle";
                        icon: "shuffle";
                        label: @tr("Shuffle");
                        checked <=> Settings.overflow-shuffle;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                    OverflowCheckCell {
                        id: "pin";
                        icon: "push_pin";
                        label: @tr("Pin on Top");
                        checked <=> Settings.overflow-pin;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                }
                Row {
                    OverflowCheckCell {
                        id: "queue";
                        icon: "queue_music";
                        label: @tr("Queue");
                        checked <=> Settings.overflow-queue;
                        toggled => { Settings.overflow-buttons-changed(self.id, self.checked); }
                    }
                    Rectangle { }
                }
            }
        }
    }
    }
}
