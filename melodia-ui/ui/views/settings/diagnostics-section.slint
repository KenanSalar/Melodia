import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// What to hand over when something goes wrong, and the switch that decides how
// much of it there is. The first two rows reach the same folder — log files and
// crash reports share one directory so a reporter opens it once — and all three
// callbacks live in `src/ui/settings/diagnostics.rs`.
//
// No row is gated by backend state; only the search filter can hide one.
// Structure follows `about-section.slint`, which this sits under.
export component DiagnosticsSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Diagnostics");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    property <string> logs-label: @tr("Logs");
    property <string> logs-desc: @tr("Where Melodia writes its log files and crash reports.");
    property <string> report-label: @tr("Diagnostics report");
    property <string> report-desc: @tr("One text file with your system details, settings and recent logs, for attaching to a bug report.");
    property <string> verbose-label: @tr("Verbose logging");
    property <string> verbose-desc: @tr("Record extra detail. Turn this on, reproduce the problem, then save a report.");

    property <bool> show-logs: row-visible(logs-label, logs-desc);
    property <bool> show-report: row-visible(report-label, report-desc);
    property <bool> show-verbose: row-visible(verbose-label, verbose-desc);

    out property <bool> has-matches: show-logs || show-report || show-verbose;

    // Wrapper so the root's preferred-height tracks the card's natural height —
    // see `language-section.slint`.
    VerticalLayout {
        if has-matches: SectionCard {
            title: root.card-title;

            if root.show-logs: SettingRow {
                icon: "description";
                label: root.logs-label;
                description: root.logs-desc;
                SectionButton {
                    label: @tr("Open Folder");
                    icon: "";
                    primary: false;
                    clicked => { Settings.open-log-folder(); }
                }
            }

            // Each divider asks whether anything above it survived the filter,
            // so past the first they take the cumulative form — the shape the
            // second divider in `about-section.slint` uses.
            if root.show-logs && root.show-report: SectionDivider {}
            if root.show-report: SettingRow {
                icon: "bug_report";
                label: root.report-label;
                description: root.report-desc;
                SectionButton {
                    label: @tr("Save…");
                    icon: "";
                    primary: false;
                    clicked => { Settings.save-diagnostics-report(); }
                }
            }

            if (root.show-logs || root.show-report) && root.show-verbose: SectionDivider {}
            if root.show-verbose: SettingRow {
                icon: "tune";
                label: root.verbose-label;
                description: root.verbose-desc;
                ToggleSwitch {
                    checked <=> Settings.verbose-logging;
                    toggled(v) => { Settings.verbose-logging-changed(v); }
                }
            }
        }
    }
}
