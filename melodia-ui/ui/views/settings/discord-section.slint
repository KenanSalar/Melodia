import { Settings } from "../../settings.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// Rich Presence: a master toggle, a live status line, and two sub-options once
// enabled. Simpler than the scrobbling section because Discord needs no
// credentials, so there's no login dialog and every value is a plain toggle.
// Rust owns them; the status props come off `discord_settings.rs`'s status-watch
// subscriber. Search visibility follows `playback-section.slint`.
export component DiscordSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, "Discord",
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    // The section searches as one unit: the sub-options' labels fold in here, so
    // matching either reveals the whole thing rather than just the enable row.
    property <bool> show-discord: row-visible(
        "Discord Rich Presence" + " " + @tr("Show album artwork") + " " + @tr("Hide while paused"),
        @tr("Show the track you're playing on your Discord profile"));

    out property <bool> has-matches: show-discord;

    VerticalLayout {
    if has-matches: SectionCard {
        title: "Discord";

        if root.show-discord: SettingRow {
            icon: "chat";
            label: "Discord Rich Presence";
            description: @tr("Show the track you're playing on your Discord profile");
            ToggleSwitch {
                checked <=> Settings.discord-rpc-enabled;
                toggled(v) => { Settings.discord-rpc-enabled-changed(v); }
            }
        }

        if root.show-discord: SettingRow {
            icon: "history";
            label: @tr("Status");
            description: Settings.discord-rpc-connected
                ? @tr("Connected to Discord")
                : @tr("Discord not running");
        }

        if root.show-discord && Settings.discord-rpc-enabled: SectionDivider {}

        if root.show-discord && Settings.discord-rpc-enabled: SettingRow {
            icon: "image";
            label: @tr("Show album artwork");
            description: @tr("Look up cover art online (via Deezer or iTunes) to show on the card");
            ToggleSwitch {
                checked <=> Settings.discord-rpc-artwork;
                toggled(v) => { Settings.discord-rpc-artwork-changed(v); }
            }
        }

        if root.show-discord && Settings.discord-rpc-enabled: SettingRow {
            icon: "pause";
            label: @tr("Hide while paused");
            description: @tr("Remove the card when paused instead of showing a paused marker");
            ToggleSwitch {
                checked <=> Settings.discord-rpc-hide-when-paused;
                toggled(v) => { Settings.discord-rpc-hide-when-paused-changed(v); }
            }
        }
    }
    }
}
