import { Theme } from "../theme.slint";
import { Albums } from "../globals/albums.slint";
import { SearchBar } from "../components/search-bar.slint";
import { ActionPill, PillButton, PillDivider } from "../components/action-pill.slint";
import { AlbumGrid } from "../components/grid/album-grid.slint";
import { GridEmptyState } from "../components/grid/grid-empty-state.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";

// The Albums grid page: header chrome here, the virtualized `AlbumGrid` below
// it, both over the `Albums` global.
//
// `GridGeometry` sizes the cards and counts the columns; `GridColumnsSync`
// publishes that count, and its `columns-changed` re-chunks the flat list.
export component AlbumView inherits Rectangle {
    // Bumped per keystroke; `FilterThrottle` collapses the burst into one filter.
    property <int> filter-tick-pending: 0;
    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { Albums.apply-filter(Albums.filter); }
    }

    // The gutter is the host's, since the grid takes it too; the rest of the
    // geometry comes off the body's width.
    property <length> grid-gap: 20px;
    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
    }

    // Publishes the count on mount and on every change; see
    // `grid-columns-sync.slint` for why it needs both a `changed` and a Timer.
    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Albums.columns = c;
            Albums.columns-changed(c);
        }
    }

    // Catches clicks no inner widget consumes; the SearchBar blurs on the tick.
    TouchArea {
        clicked => { Albums.blur-search-tick += 1; }
    }

    VerticalLayout {
        // Three sides: the uniform form's bottom pad sits outside the grid's
        // viewport and reads as a dead strip above the panel border, with the
        // last row of cards clipped against the edge.
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-md;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                spacing: 0;
                Text {
                    text: @tr("Albums");
                    color: Theme.page-title-color;
                    font-size: Theme.page-title-size;
                    font-weight: Theme.page-title-weight;
                }
                Text {
                    // Says nothing until there is an answer: the count sits at
                    // the unfetched sentinel between a section leave and the
                    // next fetch, and `@tr` would interpolate it verbatim.
                    text: Albums.total-count >= 0
                        ? @tr("{n} album" | "{n} albums" % Albums.total-count)
                        : "";
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // The active field carries the direction arrow. Clicking it flips
            // the direction and a new field starts ascending — both Rust's, in
            // `wire_albums`.
            VerticalLayout {
                alignment: center;
                ActionPill {
                    PillButton {
                        text: @tr("Name");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "name"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "name";
                        clicked => { Albums.request-sort("name"); }
                    }
                    PillDivider { }
                    PillButton {
                        text: @tr("Year");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "year"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "year";
                        clicked => { Albums.request-sort("year"); }
                    }
                    PillDivider { }
                    PillButton {
                        text: @tr("Artist");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "artist"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "artist";
                        clicked => { Albums.request-sort("artist"); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                SearchBar {
                    text <=> Albums.filter;
                    placeholder: @tr("Filter albums…");
                    blur-trigger: Albums.blur-search-tick;
                    edited(t) => { root.filter-tick-pending += 1; }
                }
            }
        }

        // The grid, with an opaque empty state painted over it when there's
        // nothing to show.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            grid := AlbumGrid {
                width: 100%;
                height: 100%;
                rows: Albums.grid-rows;
                card-width: geom.card-w;
                card-height: geom.card-h;
                row-height: geom.row-h;
                gap: root.grid-gap;
                open-album(id) => { Albums.open-album(id); }
                request-cover(p) => { Albums.request-cover(p) }
            }

            if Albums.total-count == 0: GridEmptyState {
                icon: "album";
                title: @tr("No albums yet");
                body: @tr("Add a music folder in Settings to start building your library.");
            }
        }
    }

    // Outside the padded layout, so it sits flush with the panel's right edge;
    // it drives the grid's inner ListView through the `v-*` contract.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: grid.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: grid.height;
        visible-size: grid.v-visible-height;
        content-size: grid.v-viewport-height;
        offset: grid.v-offset;
        scroll-to(o) => { grid.set-v-offset(o); }
    }
}
