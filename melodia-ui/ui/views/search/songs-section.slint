import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { Search } from "../../globals/search.slint";
import { ActionPill } from "../../components/action-pill.slint";
import { SelectionPills } from "../../components/selection-pills.slint";
import { ColumnTogglePopup } from "../../components/track-list/column-toggle-popup.slint";
import { TrackList } from "../../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";

// The matching tracks: a heading row carrying the column-toggle pill, the list itself,
// and the show-all toggle under it. No inputs — everything is on `Search`. The horizontal
// scrollbar lives here rather than at the mount site because Slint can't read an id
// declared inside an `if` from outside it, which is what makes a per-section file the
// natural boundary.
export component SongsSection inherits VerticalLayout {
    horizontal-stretch: 1;
    spacing: Theme.pad-sm;

    // Pinned so the baseline matches the Top Result heading whether or not the pill is
    // mounted — it renders only with rows, and the row height has to hold either way.
    HorizontalLayout {
        height: 32px;
        alignment: space-between;
        VerticalLayout {
            alignment: center;
            Text {
                text: @tr("Songs");
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 700;
                letter-spacing: 0.4px;
            }
        }

        // **No Shuffle pill here**: Search has no single "all of these tracks" the way
        // Favorites does — the user picked a query, so play expectations are per-row.
        if Search.tracks.length > 0: ActionPill {
            ColumnTogglePopup {
                show-number  <=> Search.show-number;
                show-artwork <=> Search.show-artwork;
                show-artist  <=> Search.show-artist;
                show-album   <=> Search.show-album;
                show-genre   <=> Search.show-genre;
                show-year    <=> Search.show-year;
                toggled(id) => { Search.toggle-column(id); }
            }
            if Search.selected-ids.length > 0: SelectionPills {
                count: Search.selected-ids.length;
                cleared => {
                    Search.clear-selection();
                    Search.blur-search-tick += 1;
                }
            }
        }
    }

    tl := TrackList {
        horizontal-stretch: 1;
        vertical-stretch: 0;
        // Sized to the row count so the outer scroller drives the strips and the list
        // together; the floor keeps the column header rendering with zero rows.
        //
        // **Uncapped, unlike the composite views**, which pin this to the viewport so
        // their inner list keeps virtualizing. Here the *backend* is the cap — the query
        // returns at most a screenful or two — so instantiating them all is affordable,
        // and it buys back native wheel scrolling: a capped list gains inner travel, and
        // a nested `ListView` swallows the wheel at its scroll edge rather than bubbling,
        // which is why those views need `CompositeScrollbars` and this one doesn't.
        // **Raising that SQL limit is what would make the trade wrong.**
        height: max(1, Search.tracks.length)
            * (Search.show-artwork
                ? Theme.row-h
                : Theme.row-h-compact)
            + 32px + Theme.pad-xs;

        rows: Search.tracks;

        w-number <=> Search.w-number;
        w-title  <=> Search.w-title;
        w-artist <=> Search.w-artist;
        w-album  <=> Search.w-album;
        w-genre  <=> Search.w-genre;
        w-year   <=> Search.w-year;
        w-length <=> Search.w-length;

        show-number  <=> Search.show-number;
        show-artwork <=> Search.show-artwork;
        show-artist  <=> Search.show-artist;
        show-album   <=> Search.show-album;
        show-genre   <=> Search.show-genre;
        show-year    <=> Search.show-year;
        number-mode: "index";

        sort-field: Search.sort-field;
        sort-dir:   Search.sort-dir;
        playing-track-id: Player.vm.track.id;
        view-context: "search";
        view-selected-ids: Search.selected-ids;

        request-sort(f)        => { Search.request-sort(f); }
        play-row(id, idx)      => { Search.play-row(id, idx); }
        play-next(ids)         => { Search.play-next(ids); }
        add-to-queue(ids)      => { Search.add-to-queue(ids); }
        toggle-row-favorite(ids, on) => { Search.toggle-row-favorite(ids, on); }
        set-row-rating(ids, n) => { Search.set-row-rating(ids, n); }
        select-row(idx, id, sh, ct) => { Search.select-row(idx, id, sh, ct); }
        request-blur-search => { Search.blur-search-tick += 1; }
        // Reuses the card-click callbacks, so cross-tab nav means the same thing from
        // either surface.
        go-to-album(aid) => { Search.open-album(aid); }
        go-to-artist(aid) => { Search.open-artist(aid); }
        go-to-genre(gid) => { Search.go-to-genre(gid); }
    }

    // **Always mounted, with a fixed slot.** Gating its `if` on the overflow would close
    // a binding loop — the `if` affects layout, which changes the list's width, which
    // changes the visible width, which re-evaluates the `if`. The bar's own visibility
    // gate already hides the thumb with nothing to scroll, leaving a transparent slot: a
    // small visual cost for always-correct overflow access.
    OverlayScrollbar {
        horizontal: true;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }

    // Mounted only when the backend returned more than the compact cap; Rust re-derives
    // the visible slice from its cache with no DB hit.
    if Search.tracks-total > 5: HorizontalLayout {
        alignment: center;
        padding-top: Theme.pad-xs;
        show-more-target := Rectangle {
            width: show-more-label.preferred-width + 24px;
            height: 28px;
            border-radius: self.height / 2;
            background: show-more-touch.has-hover
                ? Theme.surface1
                : transparent;
            border-width: 1px;
            border-color: Theme.surface2;
            animate background { duration: Theme.dur-fast; easing: ease-in-out; }
            show-more-label := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: Search.show-all-tracks
                    ? @tr("Show less")
                    : @tr("Show all {} songs", Search.tracks-total);
                color: Theme.text;
                font-size: Theme.font-size-sm;
                font-weight: 600;
            }
            show-more-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { Search.toggle-show-all-tracks(); }
            }
        }
    }
}
