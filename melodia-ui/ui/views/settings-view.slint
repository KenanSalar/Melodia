import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsPage } from "../globals/settings-page.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { SearchBar } from "../components/search-bar.slint";
import { SettingsTabBar } from "../components/settings/settings-tab-bar.slint";
import { SettingsTabs } from "settings/settings-tabs.slint";

// Settings host page: a pinned header over a vertically scrolling,
// width-clamped body.
//
// This file owns only the page chrome — title, search bar, tab bar, the
// scroll body and its overlay scrollbars. Which cards live on which tab is
// `settings/settings-tabs.slint`'s job.
//
// Scrollbar layout matches the Tracks view: the inner `ScrollView`'s
// built-in bars are hidden (`always-off` on both axes) and a custom
// `OverlayScrollbar` is mounted at the SettingsView root so it sits flush
// with the content panel's right edge (outside the body padding) instead of
// floating just to the right of the centred content card.
export component SettingsView inherits Rectangle {
    // No own background — see TracksView for the why. The parent content
    // panel paints `Theme.base` inside its rounded shape; a transparent
    // root lets the rounded fill show through at the corner cells.

    // Backdrop TouchArea — catches any click that no inner widget consumes
    // (page padding, gaps between section cards, the empty area below the
    // last card) and bumps the SearchBar blur counter so the input releases
    // keyboard focus. Same pattern as `tracks-view.slint`'s root-level
    // TouchArea: Slint's `TextInput` has no native "click outside" behaviour,
    // so once focused it stays focused until something explicitly tells it
    // to clear. Declared first so it sits at the back of the z-order — any
    // TouchArea, button, chip, or input in front of it gets first crack at
    // the click.
    TouchArea {
        clicked => { SettingsPage.blur-search-tick += 1; }
    }

    property <bool> searching: SettingsPage.search-query != "";

    // Panel width, mirrored imperatively rather than read live. A binding
    // that reads `root.width` and feeds a child's size is evaluated inside
    // the shell's own layout pass and re-enters it — which surfaces as a
    // `RefCell already borrowed` panic in parley's text measurement, blamed
    // on whichever sibling happens to own text. Same fix as
    // `layout/now-playing-bar.slint`'s `bar-w`.
    property <length> page-w: 900px;
    changed width => { self.page-w = self.width; }

    // Below this the tab bar drops its labels. Sized off the *longest*
    // catalogue rather than English: five tabs cost 54 px of chrome each plus
    // their text, which is ~570 px in English but ~670 px in Italian
    // ("Riproduzione" / "Interfaccia" / "Informazioni"). Page padding takes
    // 32 px, so 780 px leaves ~75 px of headroom over the worst case. There is
    // no elide fallback — a Text sized by its own content never elides — so
    // this threshold is the only thing standing between a long locale and a
    // clipped last tab. Re-check it when adding a locale.
    //
    // Erring toward icon-only is the safe direction: the tabs keep their
    // tooltips, and the miniplayer takes over at a 550 px window anyway, so
    // the band this covers is narrow.
    property <bool> compact-tabs: root.page-w < 780px;

    // A fresh tab, or entering/leaving search, starts at the top. Without
    // this, switching from a tall tab to a short one leaves the viewport
    // parked past the new content. Mirrored into locals because Slint's
    // `changed` rejects path expressions on globals. The write is
    // imperative on purpose — a `<=>` on `viewport-y` would disable
    // Slint's own out-of-bounds correction.
    property <int> watched-tab: SettingsPage.tab-idx;
    changed watched-tab => { sv.viewport-y = 0px; }
    property <bool> watched-searching: root.searching;
    changed watched-searching => { sv.viewport-y = 0px; }

    VerticalLayout {
        padding-top: Theme.pad-lg;
        padding-bottom: Theme.pad-lg;
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Page header — title on the left, search bar flush right, tab bar
        // on the row below. All of it lives outside the inner ScrollView so
        // it stays pinned while the body scrolls. The SearchBar is the same
        // reusable component the Tracks view mounts; visibility filtering
        // for each section is driven reactively from
        // `SettingsPage.search-query` (no `edited` callback needed, unlike
        // Tracks which throttles model rebuilds).
        HorizontalLayout {
            spacing: Theme.pad-md;
            Text {
                text: @tr("Settings");
                color: Theme.page-title-color;
                font-size: Theme.page-title-size;
                font-weight: Theme.page-title-weight;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                SearchBar {
                    text <=> SettingsPage.search-query;
                    placeholder: @tr("Search settings…");
                    blur-trigger: SettingsPage.blur-search-tick;
                }
            }
        }

        // Tab bar. Stays mounted while a search is running — hiding it would
        // shift the body on the first keystroke, and leaving it live gives
        // the user an obvious way out of search: picking a tab clears the
        // query. The label array must stay an inline literal so `@tr`
        // registers the msgids at codegen, and its order has to match the
        // `tab-*` indices on `SettingsPage`.
        HorizontalLayout {
            alignment: start;
            SettingsTabBar {
                labels: [@tr("Library"), @tr("Playback"), @tr("Interface"),
                         @tr("Services"), @tr("About")];
                icons: ["library_music", "play_circle", "palette", "link", "info"];
                compact: root.compact-tabs;
                selected-index <=> SettingsPage.tab-idx;
                selected(i) => {
                    SettingsPage.search-query = "";
                    SettingsPage.blur-search-tick += 1;
                    SettingsPage.tab-changed(i);
                }
            }
        }

        // Width clamp + vertical scroll. Tauri uses
        // `clamp(640px, 100%, 1100px)` centred; ScrollView's viewport
        // width tracks `self.width`, so we wrap the column in centred
        // spacers and pin the column min/max width. Both built-in
        // scrollbars are hidden — the host-mounted `OverlayScrollbar`
        // below drives the vertical axis through `viewport-y`.
        sv := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: always-off;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    min-width: 640px;
                    max-width: 1100px;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.pad-lg;

                        SettingsTabs {
                            tab-index: SettingsPage.tab-idx;
                            searching: root.searching;
                        }

                        // Trailing spacer — absorbs any surplus vertical
                        // space when the mounted tab is shorter than the
                        // viewport. Without it, the column's surplus gets
                        // distributed across remaining children (including
                        // the visible SectionCard), stretching individual
                        // rows by their share of the surplus. Pinning a
                        // `vertical-stretch: 1` Rectangle at the bottom
                        // forces the surplus to collect there instead. It
                        // earns its keep more now than it did on the flat
                        // page: a one-card tab like Library rarely fills
                        // the viewport, where the full eleven always did.
                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // Overlay scrollbars — siblings of the padded VerticalLayout above,
    // pinned to the SettingsView's edges so they line up with the content
    // panel border (matches the Tracks view). `sv.absolute-position`
    // resolves the ScrollView's window-relative coords; subtracting
    // `root.absolute-position` puts each bar in the SettingsView's local
    // frame so y/height values stay correct regardless of how the
    // VerticalLayout's padding/header row size changes.
    //
    // Horizontal axis: shows up only when the window is narrower than the
    // content card's `min-width: 640px` floor — the inner Rectangle sticks
    // at 640 px and the ScrollView pans through it. The OverlayScrollbar
    // hides itself automatically when `content-size <= visible-size`.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: sv.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: sv.height;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        scroll-to(o) => { sv.viewport-y = -o; }
    }

    OverlayScrollbar {
        horizontal: true;
        x: sv.absolute-position.x - root.absolute-position.x;
        // Bottom edge of the SettingsView root (matches the Tracks view's
        // horizontal bar), not the bottom of the scroll body — so the bar
        // sits flush with the content panel's lower edge.
        y: parent.height - self.height;
        // Stop 10 px before the right edge so the corner doesn't overlap
        // the vertical bar above (same convention as the Tracks view).
        width: sv.width - 10px;
        height: 10px;
        visible-size: sv.visible-width;
        content-size: sv.viewport-width;
        offset: -sv.viewport-x;
        scroll-to(o) => { sv.viewport-x = -o; }
    }
}
