import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsPage } from "../globals/settings-page.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { SearchBar } from "../components/search-bar.slint";
import { Tooltip, TooltipSide } from "../components/tooltip.slint";
import { TabBar } from "../components/tab-bar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { SettingsTabs } from "settings/settings-tabs.slint";

// A pinned header over a vertically scrolling, width-clamped body.
//
// **Page chrome only** — the search bar, the tab bar, the scroll body and its overlay
// scrollbar. Which cards live on which tab is `settings/settings-tabs.slint`'s job.
//
// The scrollbar follows the Tracks view: the inner `ScrollView`'s own bars are off on
// both axes and an `OverlayScrollbar` is mounted at the root, so it sits flush with the
// content panel's right edge rather than floating beside the centred card column.
export component SettingsView inherits Rectangle {
    // No background of its own — the parent panel paints `Theme.base` inside its rounded
    // shape, and a transparent root lets that fill show through at the corner cells.

    // Catches any click no inner widget consumes and bumps the blur counter, so the
    // input releases the keyboard. Slint's `TextInput` has no click-outside behaviour of
    // its own, so once focused it stays focused until told otherwise. Declared first, so
    // everything in front of it gets first crack at the click.
    TouchArea {
        clicked => { SettingsPage.blur-search-tick += 1; }
    }

    // The same throttle every other filterable view mounts. Settings was the one that
    // didn't, on the reading that it only drives visibility rather than rebuilding a
    // model — true, and beside the point once a query started mounting all five tab
    // pages and fanning out to three Rust round-trips per row.
    property <int> filter-tick-pending;
    FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { SettingsPage.search-query = SettingsPage.search-input; }
    }

    // Reads the **settled** query, not the input. The two-column flip is suppressed
    // while searching, and flipping a frame before the five pages mount is the one
    // ordering that shows.
    property <bool> searching: SettingsPage.search-query != "";

    // Mirrored imperatively rather than read live: a binding reading `root.width` and
    // feeding a child's size is evaluated inside the shell's own layout pass and
    // re-enters it, which surfaces as a `RefCell already borrowed` panic in parley's
    // text measurement, blamed on whichever sibling happens to own text. Same fix as
    // `now-playing-bar.slint`'s `bar-w`.
    //
    // **The mirror costs a frame, so the seed is a real decision**, and it is the header
    // row's own *floor* rather than a plausible page width. The failure is asymmetric:
    // seeded wide, the bar believes it can afford five full-width tabs, draws them into
    // a panel that can't seat them, and they spill under the search bar; seeded narrow it
    // draws the icons it would have drawn anyway and widens once. A miniplayer → full
    // swap remounts this page far narrower than any plausible guess, which is the
    // reliable way to see the wide one.
    //
    // The floor is the narrowest page still seating the bar at `compact-w` *and* the
    // input at `search-w-max`, so at the widths Settings is normally opened at, neither
    // pops a frame later.
    property <length> page-w:
        2 * Theme.pad-lg + bar.compact-w + 2 * Theme.pad-md + root.search-w-max;
    changed width => {
        self.page-w = self.width;
        SettingsPage.page-w = self.width;
    }

    // **The seed obliges this.** `changed` doesn't fire when the first layout settles
    // directly on the final value, and opening the app straight into Settings is exactly
    // that — the panel is never *resized*, it is born at its size — so without it the
    // seed is never corrected and a roomy window draws icon-only tabs until something
    // moves it. It only looked fixed coming out of the miniplayer, where the seed's
    // answer happens to be right.
    //
    // It lands well inside the tab bar's ease arming, so the correction snaps rather
    // than morphing. It also publishes the column count, which `changed watched-two-col`
    // can't: `SettingsPage` outlives this page, so a wide visit leaves `body-cols` at 2
    // and re-entering narrow would draw a frame two-up before anything transitioned.
    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            SettingsPage.page-w = root.width;
            SettingsPage.body-cols = root.two-col ? 2 : 1;
            self.running = false;
        }
    }

    // The page less its own padding — what the header row divides up and the body fills.
    // One property, because it is one number and two would be two places for the padding
    // to drift.
    //
    // **`SettingsPage.body-avail` computes the same subtraction and is not the same
    // number**, so don't collapse this onto it. That one reads the *global* `page-w`,
    // this the local mirror, and they differ for exactly one frame — the global seeds at
    // the narrowest panel Settings can be drawn in, the local at this row's own floor,
    // which is the seed the tab bar needs. Point this at the global and the local mirror
    // is written by two handlers and read by nobody, so the floor seed quietly stops
    // meaning anything.
    property <length> content-w: root.page-w - 2 * Theme.pad-lg;

    // A second column appears exactly when two cards **at `card-cap`** fit beside each
    // other, not a pixel sooner. Reserving against the cap is what makes a card's width
    // monotonic — it grows with the panel, stops at the cap, takes margins from there —
    // so the flip adds a column without resizing anything. A threshold under the cap
    // divides the card before it ever gets there, which reads as one column growing
    // without limit and then halving.
    //
    // **Search is single-column regardless**: it mounts all five pages and hides the
    // non-matching cards, and a hidden card still claims its grid cell, so a filtered
    // two-column body reads as holes. One column also keeps the flat cross-tab result
    // order unambiguous, which is the whole point of letting search escape the tabs.
    //
    // Measured against the raw `content-w` and deliberately *not* `SettingsPage.body-w`,
    // which is itself a function of this verdict and would close a cycle.
    //
    // Latched for the `tab-bar.slint` reason: a slow drag delivers a stream of one-pixel
    // widths and a hand jitters over the last of them. There the symptom was a hunting
    // ease; here a whole column blinks in and out.
    property <bool> two-col-latched: false;
    property <bool> two-col: !root.searching
        && root.content-w >= 2 * SettingsPage.card-cap + Theme.pad-lg
            - (root.two-col-latched ? 24px : 0px);

    property <bool> watched-two-col: root.two-col;
    changed watched-two-col => {
        root.two-col-latched = root.two-col;
        SettingsPage.body-cols = root.two-col ? 2 : 1;
        // Halving the body's height under a parked offset otherwise paints blank — the
        // reason the two mirrors below reset it too.
        sv.viewport-y = 0px;
    }

    // The bar's resting width, restated because this page drives the property rather
    // than taking its default.
    property <length> search-w-max: 220px;
    // The floor, taken from the bar's own published one rather than restated, so the
    // width this page stops handing over is the width the bar stops asking for. It is a
    // budget, not a taste call: Settings only exists above the miniplayer cutover, so the
    // narrowest panel it can be drawn in is that less the sidebar at its own floor, the
    // shell's right margin and this page's padding — and the row still has to seat
    // `compact-w` plus two gaps inside what's left.
    property <length> search-w-min: search.min-w;

    // **The filter yields before the tabs do.** They share a row, and tabs are
    // navigation where search only refines what a tab already shows, so a short row
    // narrows the input and leaves all five targets standing. Reserved against the bar's
    // own `compact-w` so the two can't drift: what this leaves behind is exactly what
    // the bar shrinks to, and the row's minimum is a sum rather than a guess. (The
    // forward reference is fine — ids scope to the whole component.)
    property <length> search-w: clamp(
        root.content-w - bar.compact-w - 2 * Theme.pad-md,
        root.search-w-min, root.search-w-max);

    // A fresh tab, or entering or leaving search, starts at the top — otherwise
    // switching from a tall tab to a short one leaves the viewport parked past the new
    // content. Mirrored into locals because `changed` rejects path expressions on
    // globals, and written **imperatively**: a `<=>` on `viewport-y` would disable
    // Slint's own out-of-bounds correction.
    property <int> watched-tab: SettingsPage.tab-idx;
    changed watched-tab => { sv.viewport-y = 0px; }
    property <bool> watched-searching: root.searching;
    changed watched-searching => { sv.viewport-y = 0px; }

    VerticalLayout {
        padding-top: Theme.pad-lg;
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        // **No `padding-bottom`** — that belongs to the scrolling column below.
        // Reserved out here it sits *outside* the viewport and reads as a dead strip of
        // page background between the last card and the panel border, with the card
        // clipped mid-glyph above it. Inside, the same gap scrolls in with the content.
        // With only two children, this spacing is the header's clearance rather than a
        // generic gutter, and it is well clear of the gaps *inside* the header row so
        // the bar reads as the page's lid rather than as the first card's top edge.
        spacing: 2 * Theme.pad-lg;

        // The tab bar where the page title used to sit, and the search bar flush right.
        // Both live outside the ScrollView so they stay pinned while the body scrolls.
        //
        // **The title is gone rather than moved.** No other page's heading sat directly
        // over five tabs reading Library / Playback / Interface / Services / About —
        // those name the page better than the word above them did, and the sidebar item
        // and window title still carry it. Reclaiming the row is what puts the bar at
        // the top of the page instead of pushing the body down.
        //
        // The bar decides for itself when to go icon-only by measuring its own labels;
        // all it wants from here is how much room it has, which sharing the row makes
        // interesting — the page less its padding, the two gaps, and whatever the input
        // is taking. **The label array must stay an inline literal** so `@tr` registers
        // the msgids at codegen, and its order has to match the `tab-*` indices. It stays
        // mounted while searching: hiding it would shift the body on the first
        // keystroke, and leaving it live is the obvious way out of a search, since
        // picking a tab clears the query.
        HorizontalLayout {
            spacing: Theme.pad-md;

            bar := TabBar {
                labels: [@tr("Library"), @tr("Playback"), @tr("Interface"),
                         @tr("Services"), @tr("About")];
                icons: ["library_music", "play_circle", "palette", "link", "info"];
                avail-width: root.content-w - root.search-w - 2 * Theme.pad-md;
                selected-index <=> SettingsPage.tab-idx;
                selected(i) => {
                    SettingsPage.search-input = "";
                    SettingsPage.search-query = "";
                    SettingsPage.blur-search-tick += 1;
                    SettingsPage.tab-changed(i);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Padded to the same band the bar keeps clear for its divider, so the input
            // centres on the tab labels' line rather than on the row's.
            VerticalLayout {
                alignment: center;
                padding-bottom: Theme.pad-sm;
                search := SearchBar {
                    input-width: root.search-w;
                    text <=> SettingsPage.search-input;
                    placeholder: @tr("Search settings…");
                    blur-trigger: SettingsPage.blur-search-tick;
                    edited => { root.filter-tick-pending += 1; }
                }
            }
        }

        // The body is centred between elastic spacers and capped at one card column, or
        // two plus their gap. That cap comes off `SettingsPage`, so the width the
        // columns are sized to and the width the body is drawn at can't be two numbers.
        //
        // **It has no floor**: below the cap it shrinks with the panel down to whatever
        // its cards report, which is what lets the page fit the narrowest panel Settings
        // can be drawn in — and why there is no horizontal scrollbar. Pinned at a
        // `min-width`, any narrower panel stopped shrinking and the ScrollView panned
        // through it instead.
        //
        // Both built-in scrollbars are hidden — the host-mounted
        // `OverlayScrollbar` below drives the vertical axis through
        // `viewport-y`.
        sv := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: always-off;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    max-width: SettingsPage.body-w;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.pad-lg;
                        // In here so it scrolls with the cards rather than being
                        // reserved outside the viewport — see the root layout above.
                        padding-bottom: Theme.pad-lg;

                        SettingsTabs {
                            tab-index: SettingsPage.tab-idx;
                            searching: root.searching;
                        }

                        // Collects the surplus when the mounted tab is shorter than
                        // the viewport. Without it the column divides that surplus
                        // across its children and stretches the cards themselves. It
                        // earns its keep more than it did on the flat page: a one-card
                        // tab rarely fills the viewport, where eleven always did.
                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // A sibling of the padded layout, pinned to the view's right edge so it lines up
    // with the content panel border. The absolute-position subtraction puts it in this
    // view's local frame, so its geometry stays right however the header row resizes.
    //
    // **Vertical only.** The horizontal bar that used to sit here existed to pan the
    // content column's width floor; there is no floor now, so nothing overflows
    // sideways. Don't reintroduce it — a settings page needing one is a page with a row
    // that has stopped being able to wrap.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: sv.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: sv.height;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        scroll-to(o) => { sv.viewport-y = -o; }
    }

    // Declared last so it paints above the scroll body — paint order is declaration
    // order. Left on the tab it belongs to, a below-anchored tooltip lands in the body's
    // band and the first card covers it; same fix, and the same frame-tracks-the-host
    // idiom, as `playlists-view.slint`'s `header-tip`. A plain Rectangle captures no
    // input, so the tab underneath keeps its hover.
    //
    // The rect is derived from the hovered *index* rather than snapshotted out of the
    // bar — which the equal-width cells are what make possible — so a tab that moves
    // under a parked pointer keeps its tooltip anchored to it.
    tab-tip := Rectangle {
        x: bar.absolute-position.x - root.absolute-position.x
            + bar.tab-w * bar.hovered-idx;
        y: bar.absolute-position.y - root.absolute-position.y;
        width: bar.tab-w;
        height: bar.height;
        Tooltip {
            text: bar.hovered-label;
            hovered: bar.hovered-idx >= 0 && bar.compact;
            host-width: tab-tip.width;
            host-height: tab-tip.height;
            side: TooltipSide.below;
        }
    }
}
