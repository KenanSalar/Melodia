import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../../components/material-icon.slint";

// One folder row in Browse's list presentation: icon, name, chevron.
//
// **The label's `min-width` tracks its own natural width**, so a narrowing window pans
// the body's horizontal scrollbar rather than compressing and eliding the row — a folder
// name never truncates.
//
// Data-agnostic like every other row component: the host passes the name and takes the
// click back, so nothing here imports `Browse`. **No `path`** — the row used to navigate
// itself and needed one; now the host owns the handler and already has `folder.path` in
// scope there, so a second copy would only be a property nothing reads.
export component BrowseFolderRowItem inherits Rectangle {
    in property <string> name;
    callback clicked();

    // Chrome plus a gap slot: a `ListView` lays rows back-to-back with no `spacing`, so
    // the gap is baked into the row itself — and the host's height cap counts on it.
    height: 50px;

    inner := Rectangle {
        y: 0;
        width: 100%;
        height: 48px;
        border-radius: Theme.radius-md;
        background: touch.has-hover ? Theme.surface0 : transparent;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-md;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "folder";
                    icon-size: 24px;
                    icon-color: Theme.accent;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 500;
                    min-width: self.preferred-width;
                }
            }

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "chevron_right";
                    icon-size: 20px;
                    icon-color: Theme.overlay0;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}
