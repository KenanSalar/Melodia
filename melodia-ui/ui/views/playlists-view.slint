import { Theme } from "../theme.slint";
import { SmartEditor } from "../globals/dialog-forms.slint";
import { Dialog } from "../globals/dialog.slint";
import { Playlists } from "../globals/playlists.slint";
import { SearchBar } from "../components/search-bar.slint";
import { ActionPill, PillButton, PillDivider } from "../components/action-pill.slint";
import { PlaylistGrid } from "../components/grid/playlist-grid.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { Tooltip } from "../components/tooltip.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";

// The Playlists grid page. Mirrors `AlbumView` structure: header chrome
// (title + count + filter + "New Playlist" action), virtualized grid
// via `PlaylistGrid`, responsive column count via `GridColumnsSync`.
// Bound to the `Playlists` global.
export component PlaylistsView inherits Rectangle {
    // Filter throttle — same pattern as the Tracks / Albums views.
    property <int> filter-tick-pending: 0;
    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { Playlists.apply-filter(Playlists.filter); }
    }

    // --- Responsive grid geometry --------------------------------------
    property <length> min-card-w: 180px;
    property <length> grid-gap: 20px;
    property <length> card-text-h: 46px;
    property <int> computed-cols:
        max(1, Math.floor((grid.width - root.grid-gap) / (root.min-card-w + root.grid-gap)));
    property <length> card-w:
        max(0px, (grid.width - (root.computed-cols + 1) * root.grid-gap) / root.computed-cols);
    property <length> card-h: root.card-w + root.card-text-h;
    property <length> row-h: root.card-h + root.grid-gap;

    GridColumnsSync {
        computed-cols: root.computed-cols;
        seed(c) => {
            Playlists.columns = c;
            Playlists.columns-changed(c);
        }
    }

    TouchArea {
        clicked => { Playlists.blur-search-tick += 1; }
    }

    VerticalLayout {
        // Three sides — see `tracks-view.slint` for why the uniform form's
        // bottom pad reads as a dead strip under the grid.
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-md;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                spacing: 0;
                Text {
                    text: @tr("Playlists");
                    color: Theme.page-title-color;
                    font-size: Theme.page-title-size;
                    font-weight: Theme.page-title-weight;
                }
                Text {
                    text: @tr("{n} playlist" | "{n} playlists" % Playlists.total-count);
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // "+ New Playlist" action — sits before the SearchBar so the
            // primary action stays adjacent to the title chip. Populates
            // the Dialog inline in Slint markup (mirroring `queue-sheet`
            // and `library-section`'s confirmation flows) instead of
            // hopping through a Rust callback — Slint's property graph
            // doesn't tolerate synchronous Rust→`set_open(true)` writes
            // mid-click-handler ("Recursion detected" in
            // `i_slint_core::properties`). The dispatcher in `globals/dialog.slint`
            // routes the Accept to `Playlists.create-playlist(name, [])`.
            VerticalLayout {
                alignment: center;
                ActionPill {
                    np := PillButton {
                        icon: "add";
                        text: @tr("New Playlist");
                        tooltip-text: @tr("Create an empty playlist");
                        // Tooltip rendered by the top-layer overlay below (so it
                        // isn't occluded by the grid painted after the header).
                        tooltip-overlay: true;
                        clicked => {
                            Dialog.title = @tr("New Playlist");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Create");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "create-playlist";
                            Dialog.target-id = -1;
                            Dialog.input-text = "";
                            Dialog.input-text-2 = "";
                            Dialog.pending-track-ids = [];
                            Dialog.open = true;
                        }
                    }

                    PillDivider { }

                    // "New Smart Playlist" — chrome set inline (so `@tr`
                    // applies); the Rust `request-new` resets the `SmartEditor`
                    // state + rules model and flips `open` from a fresh
                    // event-loop tick (same recursion-safe hop as Export).
                    sp := PillButton {
                        icon: "auto_awesome";
                        icon-filled: true;
                        text: @tr("New Smart Playlist");
                        tooltip-text: @tr("Create a playlist from rules");
                        tooltip-overlay: true;
                        clicked => {
                            Dialog.title = @tr("New Smart Playlist");
                            Dialog.message = "";
                            Dialog.confirm-label = @tr("Create");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "smart-playlist-editor";
                            Dialog.target-id = -1;
                            SmartEditor.request-new();
                        }
                    }

                    PillDivider { }

                    // Import / Export to portable `.m3u8` files so playlists
                    // survive a database wipe. Both are pure Rust flows
                    // (native rfd dialogs); Export opens the multi-select
                    // picker dialog, Import opens a multi-file picker.
                    ip := PillButton {
                        icon: "download";
                        text: @tr("Import");
                        tooltip-text: @tr("Import playlists from .m3u8 files");
                        tooltip-overlay: true;
                        clicked => { Playlists.import-playlists(); }
                    }

                    PillDivider { }

                    ep := PillButton {
                        icon: "upload";
                        text: @tr("Export");
                        tooltip-text: @tr("Export playlists to .m3u8 files");
                        tooltip-overlay: true;
                        clicked => {
                            // Chrome set inline (so @tr applies); the Rust
                            // callback fills the rows and flips `open` from a
                            // fresh event-loop tick (same shape as
                            // add-to-playlist).
                            Dialog.title = @tr("Export Playlists");
                            Dialog.message = @tr("Choose playlists to export, then pick a folder.");
                            Dialog.confirm-label = @tr("Export");
                            Dialog.cancel-label = @tr("Cancel");
                            Dialog.destructive = false;
                            Dialog.kind = "export-playlists";
                            Playlists.request-export-playlists();
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                SearchBar {
                    text <=> Playlists.filter;
                    placeholder: @tr("Filter playlists…");
                    blur-trigger: Playlists.blur-search-tick;
                    edited(t) => { root.filter-tick-pending += 1; }
                }
            }
        }

        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            grid := PlaylistGrid {
                width: 100%;
                height: 100%;
                rows: Playlists.grid-rows;
                card-width: root.card-w;
                card-height: root.card-h;
                row-height: root.row-h;
                gap: root.grid-gap;
                open-playlist(id) => { Playlists.open-playlist(id); }
                // Hover-overlay actions — delete + rename populate Dialog
                // inline (same shape as the detail view's CRUD pills, see
                // `playlist-detail-view.slint:108-143`). Edit-artwork
                // routes to Rust so it can fetch the playlist's track
                // artwork pool + seed the dialog's "current artwork"
                // preview before opening.
                delete-playlist(id) => {
                    Dialog.title = @tr("Delete playlist?");
                    Dialog.message = @tr("The playlist and its track order will be removed. The tracks themselves stay in your library.");
                    Dialog.confirm-label = @tr("Delete");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = true;
                    Dialog.kind = "delete-playlist";
                    Dialog.target-id = id;
                    Dialog.open = true;
                }
                edit-playlist-artwork(id) => {
                    Playlists.request-edit-artwork-for(id);
                }
                rename-playlist(id) => {
                    // Grid model doesn't carry description, so go through
                    // `Playlists.row-name` / `row-description` lookups
                    // (Rust-backed, resolved from the cached
                    // `PlaylistStats` list — no DB hop).
                    Dialog.title = @tr("Rename Playlist");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Save");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.kind = "rename-playlist";
                    Dialog.target-id = id;
                    Dialog.input-text = Playlists.row-name(id);
                    Dialog.input-text-2 = Playlists.row-description(id);
                    Dialog.open = true;
                }
                request-cover(p) => { Playlists.request-cover(p) }
            }

            // Empty-state overlay — opaque `Theme.base` fill, mirrors
            // `AlbumView`'s. CTA points at the "New Playlist" action.
            if Playlists.total-count == 0: Rectangle {
                background: Theme.base;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-md;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "queue_music";
                            icon-size: 64px;
                            icon-color: Theme.overlay0;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("No playlists yet");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Click \"+ New Playlist\" to create one.");
                            color: Theme.subtext0;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: grid.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: grid.height;
        visible-size: grid.v-visible-height;
        content-size: grid.v-viewport-height;
        offset: grid.v-offset;
        scroll-to(o) => { grid.set-v-offset(o); }
    }

    // Top-layer tooltip for the header action pills. Declared last so it paints
    // above the grid (Slint has no z-index — paint order is declaration order),
    // fixing the below-anchored tooltip being occluded by the grid. The frame
    // Rectangle tracks the hovered pill's window rect via `absolute-position`
    // (same idiom as the overlay scrollbar above); the `Tooltip` inside anchors
    // beneath it. A plain Rectangle captures no input, so the pill underneath
    // keeps its hover — no flicker.
    header-tip := Rectangle {
        property <bool> any-hover: np.hovered || sp.hovered || ip.hovered || ep.hovered;
        property <length> px: np.hovered ? np.absolute-position.x
            : sp.hovered ? sp.absolute-position.x
            : ip.hovered ? ip.absolute-position.x
            : ep.hovered ? ep.absolute-position.x
            : 0px;
        property <length> py: np.hovered ? np.absolute-position.y
            : sp.hovered ? sp.absolute-position.y
            : ip.hovered ? ip.absolute-position.y
            : ep.hovered ? ep.absolute-position.y
            : 0px;
        property <length> pw: np.hovered ? np.width
            : sp.hovered ? sp.width
            : ip.hovered ? ip.width
            : ep.hovered ? ep.width
            : 0px;
        property <length> ph: np.hovered ? np.height
            : sp.hovered ? sp.height
            : ip.hovered ? ip.height
            : ep.hovered ? ep.height
            : 0px;
        property <string> ptext: np.hovered ? np.tooltip-text
            : sp.hovered ? sp.tooltip-text
            : ip.hovered ? ip.tooltip-text
            : ep.hovered ? ep.tooltip-text
            : "";
        x: self.px - root.absolute-position.x;
        y: self.py - root.absolute-position.y;
        width: self.pw;
        height: self.ph;
        Tooltip {
            text: header-tip.ptext;
            hovered: header-tip.any-hover;
            below: true;
            host-width: header-tip.width;
            host-height: header-tip.height;
        }
    }
}
