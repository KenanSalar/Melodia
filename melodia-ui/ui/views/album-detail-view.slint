import { Theme } from "../theme.slint";
import { AlbumDetail } from "../globals/albums.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { Player } from "../globals/player.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { HeroChipStrip } from "../components/hero-chip-strip.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { SearchBar } from "../components/search-bar.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";

// The full Album Detail view. Mounted by `app-window.slint` for nav index
// 4 when `AlbumDetail.album-id >= 0`. A reusable `DetailHeader` (hero
// blur backdrop + left-side artwork + bottom-anchored right column) sits
// over the shared, virtualized `TrackList` — consumed here exactly the
// way `tracks-view.slint` / `browse-view.slint` consume it, just bound
// to the per-view `AlbumDetail` global.
//
// Layout mirrors Tauri's `pages/AlbumDetail.tsx`: the column-toggle is
// merged into the primary `[Shuffle | Columns]` pill so the action row
// collapses into a single line beside the artwork; the selection chip
// (when rows are selected) lives as a separate `ActionPill` next to the
// primary one.
export component AlbumDetailView inherits Rectangle {
    // Filter throttle: each keystroke bumps `filter-tick-pending`; the
    // shared `FilterThrottle` fires the filter callback at most once per
    // ~130 ms while pending is ahead of the last-applied tick.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { AlbumDetail.filter-changed(AlbumDetail.filter); }
    }

    // Backdrop catches any click that no inner TouchArea consumes and
    // bumps the blur tick — the SearchBar observes it and clears focus
    // on change.
    TouchArea {
        clicked => { AlbumDetail.blur-search-tick += 1; }
    }

    VerticalLayout {
        DetailHeader {
            vertical-stretch: 0;
            artwork-path: AlbumDetail.album.artwork_path;
            cover: AlbumDetail.cover;
            fallback-icon: "album";
            hero-blur-a: AlbumDetail.blur-img-a;
            hero-blur-b: AlbumDetail.blur-img-b;
            hero-blur-use-a: AlbumDetail.blur-use-a;
            has-hero-blur: AlbumDetail.has-blur;
            back-clicked => { AlbumDetail.close-detail(); }

            // --- Right column @children ------------------------------
            // Top block: title + subtitle + meta, pinned to the top of
            // the column. Each entry has `vertical-stretch: 0` so the
            // trailing spacer below collects all the slack.
            // Title row — album name on the left, SearchBar pinned to
            // the right. The SearchBar filters the `tracks` TrackList
            // (title + artist + album substring). Mirrors the Artist
            // Detail hero layout.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    // Title — `hero-title-size` rather than
                    // `page-title-size`, so it carries the larger header
                    // surface and matches the other five banners. Leading
                    // LRM keeps RTL-bidi titles laid out correctly inside
                    // an LTR shell.
                    Text {
                        text: "‎" + AlbumDetail.album.name;
                        color: HeroBackdrop.on-backdrop;
                        font-size: Theme.hero-title-size;
                        font-weight: Theme.page-title-weight;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    // Artist — under the title rather than on a row of
                    // its own, so it rides in the height the SearchBar
                    // beside it already claims. That is what leaves the
                    // band enough slack for a wrapped second chip row;
                    // see `ui::hero_chips::HERO_MAX_ROWS`. Still gated on
                    // being non-empty, so an album with no artist leaves
                    // the row at exactly the SearchBar's height.
                    if AlbumDetail.album.artist_name != "": Text {
                        text: "‎" + AlbumDetail.album.artist_name;
                        color: HeroBackdrop.on-backdrop;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    SearchBar {
                        text <=> AlbumDetail.filter;
                        placeholder: @tr("Filter tracks…");
                        blur-trigger: AlbumDetail.blur-search-tick;
                        edited(t) => { root.filter-tick-pending += 1; }
                    }
                }
            }
            // Meta chips — year / track count / duration / discs /
            // compilation, built by `src/ui/hero_chips.rs`.
            HeroChipStrip { }

            // Spacer — absorbs the slack between the title block and
            // the action row so the action row sits flush with the
            // artwork's lower edge (title at top, pills at bottom).
            Rectangle { vertical-stretch: 1; }

            // Action row — primary pill + optional selection pill.
            // Both align to the start (left), matching Tauri's
            // `headerActionsRow`.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                // Single pill: Shuffle → toggle → selection chip
                // (trailing, when active). Selection slots sit at the
                // trailing edge so they read to the right of the
                // primary actions.
                ActionPill {
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { AlbumDetail.shuffle-album(); }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        show-number  <=> AlbumDetail.show-number;
                        show-artwork <=> AlbumDetail.show-artwork;
                        show-artist  <=> AlbumDetail.show-artist;
                        show-album   <=> AlbumDetail.show-album;
                        show-genre   <=> AlbumDetail.show-genre;
                        show-year    <=> AlbumDetail.show-year;
                        // Album column is meaningless in this view —
                        // every row belongs to the same album.
                        hide-album: true;
                        toggled(id) => { AlbumDetail.toggle-column(id); }
                    }
                    if AlbumDetail.selected-ids.length > 0: PillDivider { }
                    if AlbumDetail.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", AlbumDetail.selected-ids.length);
                    }
                    if AlbumDetail.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { AlbumDetail.clear-selection(); }
                    }
                }
            }
        }

        // Indent the TrackList with `Theme.pad-lg` on both sides so its
        // left/right edges match the Tracks and Browse views (whose root
        // VLs apply uniform `padding: Theme.pad-lg`). The root VL here
        // can't use that pattern because `DetailHeader` is full-bleed
        // for the hero blur — so the inset is applied per-child instead.
        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            // Vertical gap between the hero blur and the TrackList
            // header. Matches Artist Detail's "Albums sub-section ↔
            // TrackList" gap so the spacing reads consistent across
            // every detail view in the app.
            padding-top: Theme.pad-lg;

            tl := TrackList {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                rows: AlbumDetail.tracks;

                w-number <=> AlbumDetail.w-number;
                w-title <=> AlbumDetail.w-title;
                w-artist <=> AlbumDetail.w-artist;
                w-album <=> AlbumDetail.w-album;
                w-genre <=> AlbumDetail.w-genre;
                w-year <=> AlbumDetail.w-year;
                w-length <=> AlbumDetail.w-length;

                show-number <=> AlbumDetail.show-number;
                show-artwork <=> AlbumDetail.show-artwork;
                show-artist <=> AlbumDetail.show-artist;
                show-album <=> AlbumDetail.show-album;
                show-genre <=> AlbumDetail.show-genre;
                show-year <=> AlbumDetail.show-year;
                number-mode: "track_number";

                sort-field: AlbumDetail.sort-field;
                sort-dir: AlbumDetail.sort-dir;
                playing-track-id: Player.vm.track.id;
                view-context: "album-detail";
                view-selected-ids: AlbumDetail.selected-ids;

                request-sort(f) => { AlbumDetail.request-sort(f); }
                play-row(id, idx) => { AlbumDetail.play-row(id, idx); }
                play-next(ids) => { AlbumDetail.play-next(ids); }
                add-to-queue(ids) => { AlbumDetail.add-to-queue(ids); }
                toggle-row-favorite(ids, on) => { AlbumDetail.toggle-row-favorite(ids, on); }
                set-row-rating(ids, n) => { AlbumDetail.set-row-rating(ids, n); }
                select-row(idx, id, sh, ct) => { AlbumDetail.select-row(idx, id, sh, ct); }
                // A click in the track list blurs the hero SearchBar.
                request-blur-search => { AlbumDetail.blur-search-tick += 1; }
                go-to-album(aid) => { AlbumDetail.go-to-album(aid); }
                go-to-artist(aid) => { AlbumDetail.go-to-artist(aid); }
                go-to-genre(gid) => { AlbumDetail.go-to-genre(gid); }
            }
        }
    }

    // Overlay scrollbars at the view root, flush with the content panel's
    // rounded edges. `tl` is nested inside the VerticalLayout, so its
    // position is taken via `absolute-position` (like `browse-view.slint`).
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: tl.absolute-position.y - root.absolute-position.y + tl.body-y;
        width: 10px;
        height: tl.body-height;
        visible-size: tl.v-visible-height;
        content-size: tl.v-viewport-height;
        offset: tl.v-offset;
        scroll-to(o) => { tl.set-v-offset(o); }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
