import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Visualizer } from "../globals/audio.slint";
import { Nav, NavEnterFrom } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { Radio } from "../globals/radio.slint";
import { IconButton } from "../components/icon-button.slint";
import { ArtworkImage } from "../components/artwork-image.slint";
import { AccentDiscButton } from "../components/now-playing/accent-disc-button.slint";
import { MetaChipStrip } from "../components/meta-chip-strip.slint";
import { StarRating } from "../components/star-rating.slint";
import { NowPlayingCover } from "../components/now-playing/now-playing-cover.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";
import { StationFacts, StationHistory } from "../components/station-facts.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { TooltipSide } from "../components/tooltip.slint";
import { NowPlayingViewMenu } from "../components/now-playing/view-menu.slint";
import { VisualizerStrip } from "../components/now-playing/visualizer-strip.slint";
import { AuroraBackdrop } from "../components/aurora-backdrop.slint";
import { HeroBlurBackdrop } from "../components/hero-blur-backdrop.slint";

// The full-screen Now Playing view, rendered inside the content panel — sidebar and now-playing
// bar stay visible — when `Nav.now-playing-open`. A large centred artwork, title / artist / album,
// and metadata chips floating directly on a blurred album-art backdrop, with an "Up Next" list
// beside it. **Transport and seek are deliberately not duplicated here**: they live in the bar,
// which stays visible below. The list itself lives in the shared `UpNextList`, so the mini-player's
// square variant reuses the same behaviour.
export component NowPlayingView inherits Rectangle {
    // Ceiling on the square cover's edge. The tile takes this much when the column has the height
    // for it and less when it doesn't — the cover slot below is why the artwork gives ground.
    property <length> cover-size: clamp(root.width * 0.22, 200px, 384px);

    // The floor is the strip's old fixed height, so no window draws a smaller one than it used to;
    // the ceiling keeps a tall screen from turning the base of the group into the group.
    property <length> strip-h: clamp(root.height * 0.12, 56px, 128px);

    // The strip's drop below the chips. Padding isn't something the layout can shrink on our
    // behalf, so it comes off the panel height directly — the first thing a short window gives up.
    property <length> strip-drop: clamp(root.height * 0.06, Theme.pad-sm, Theme.pad-lg * 2.5);

    // The Up Next column, on a readable floor and a ceiling matching its old fixed width. Named
    // rather than inlined because the body's left column — and so the chip strip's wrapping
    // ceiling — is the panel minus this.
    property <length> up-next-width: clamp(root.width * 0.35, 280px, 420px);

    // What the artwork / title / chip column gets: the panel less its left padding, the
    // inter-column gap and the Up Next column. `Player.recompute-chip-rows` chunks against it.
    property <length> content-width: root.width - Theme.pad-lg - Theme.pad-md - root.up-next-width;

    // **A band no wider than a quarter of the strip is tall.** The band count is fixed, so a strip
    // that widens without getting taller turns a row of beads into a row of slabs. Reading the
    // model's length beats restating `spectrum::NUM_BANDS`; the `max` covers boot.
    property <length> strip-w-max: root.strip-h / 4 * max(1, Visualizer.bars.length);

    // Three quarters of that column, so the strip reads as the base of the whole cover → title →
    // chips group. **The floor is not cosmetic**: at the window's own minimum `content-width` goes
    // negative.
    property <length> strip-w: max(root.cover-size, min(root.content-width * 0.75, root.strip-w-max));

    // Which of the two backdrops this view paints — a process constant, the setting being
    // restart-gated, so only the live arm is mounted: a hidden stack is not free,
    // `Brush::is_transparent()` answering `false` for every gradient whatever its stop alphas.
    // `hero-backdrop-stack.slint` argues it at length.
    property <bool> aurora-shown: Theme.aurora-backdrop;

    // The stack the six hero bands mount, on this view's own colour tier. **Both floor stops come
    // from Rust**, not a `Theme.accent` mix — this is the surface an art-less track's title sits on
    // and the foreground is solved light. `shown` stays defaulted: this view has no idle state to
    // drain to, where a band's globals outlive the tab that filled them.
    if !root.aurora-shown: HeroBlurBackdrop {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        floor-start: Player.np-floor-start;
        floor-end: Player.np-floor-end;
        scrim: Player.np-scrim;
        blur-a: Player.blur-img-a;
        blur-b: Player.blur-img-b;
        use-a: Player.blur-use-a;
        has-blur: Player.blur-has-image;
    }

    if root.aurora-shown: AuroraBackdrop {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        base-start: Player.np-floor-start;
        base-end: Player.np-floor-end;
        tint-1: Player.np-tint-1;
        tint-2: Player.np-tint-2;
        tint-3: Player.np-tint-3;
        dither: Player.np-dither;
    }

    // **Padding is per-section, not uniform on this layout**: the Up Next column has to
    // reach the panel's right edge so its overlay scrollbar sits flush there.
    VerticalLayout {
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Floats directly over the backdrop.
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            spacing: Theme.pad-sm;

            VerticalLayout {
                alignment: center;
                AccentDiscButton {
                    icon: "arrow_back";
                    // Lateral: the view underneath remounts and samples this. See the
                    // bar's own track-info card, which is the other half of the toggle.
                    clicked => {
                        Nav.pending-enter-from = NavEnterFrom.below;
                        Nav.now-playing-open = false;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Left of the favourite heart.
            if Player.vm.has_track: VerticalLayout {
                alignment: center;
                StarRating {
                    rating: Player.vm.track.rating;
                    star-size: 22px;
                    // Accent-tinted rather than the list views' yellow; the heart below
                    // says why the whole group shares one colour.
                    filled-color: Player.np-accent-bright;
                    empty-color: Player.np-accent-dim;
                    rated(n) => { Player.set-current-rating(n); }
                }
            }

            if !Player.vm.has_station: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    filled: Player.vm.track.is_favorite;
                    active: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    diameter: 36px;
                    icon-size: 22px;
                    // A bare glyph like the stars beside it — no chrome disc in any state, hover
                    // included, so `hover-bg` is overridden too; hover reads through icon colour.
                    hover-bg: transparent;
                    // The accent the visualizer paints with, so the group reads as one family
                    // against the blur. Outlined-vs-filled carries the state, so the unfavourited
                    // variant only needs to be quieter.
                    idle-fg: Player.np-accent-dim;
                    hover-fg: Player.np-accent-bright;
                    active-fg: Player.np-accent-bright;
                    clicked => { Player.toggle-favorite(); }
                }
            }

            // **A station takes the vote in the heart's slot.** The favourite toggle acts on a
            // `tracks` row a station has none of, so it could only ever sit there disabled; the
            // vote is the one thing this header can offer that a stream actually answers.
            //
            // **Gone rather than disabled** where the directory does not know the station — a
            // hand-typed one has no uuid to record a vote against — which is what the station
            // page's own pill does with the same question. A permanently dead glyph is exactly
            // what this replaced.
            //
            // Bare glyph and the same accent family as the heart: it is the same slot, not a new
            // kind of control. Labelled on the station page, where three segments fit and a
            // reader can weigh them; here there is room for one glyph, so it takes the tooltip.
            if Player.vm.has_station && Player.vm.radio.uuid != "": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "thumb_up";
                    diameter: 36px;
                    icon-size: 22px;
                    hover-bg: transparent;
                    idle-fg: Player.np-accent-dim;
                    hover-fg: Player.np-accent-bright;
                    tooltip-text: @tr("Vote");
                    // Left, for the station page's own reason: this row is the panel's top edge,
                    // so an above-pill is cut off by it. The left arm centres vertically and
                    // clears inward over the header's own spacer.
                    tooltip-side: TooltipSide.left;
                    clicked => {
                        Radio.vote(Player.vm.radio.uuid, Player.vm.radio.station_id);
                    }
                }
            }

            // Not gated on `vm.has_track` — its options mean something with an empty queue.
            VerticalLayout {
                alignment: center;
                NowPlayingViewMenu { }
            }
        }

        // The centred artwork group left, the Up Next column right, both floating on the backdrop
        // with no card chrome. **No right or bottom padding**: the column reaches the panel edge on
        // both axes, so its scrollbar lands flush and rows scroll off the bottom rather than under
        // a strip of backdrop. The inset the artwork group wants goes on that column alone.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.pad-lg;
            spacing: Theme.pad-md;

            // Artwork, title and chips, vertically centred.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                padding-bottom: Theme.pad-lg;
                spacing: Theme.pad-md;

                // The high-res foreground cover, cross-fading through the dual-slot pattern.
                // **The slot is a plain Rectangle rather than a centring layout, and the tile
                // inside spells out `x` and `y`** — that pair is what makes the artwork the only
                // child of this column with slack, a non-layout element folding its children's
                // constraints *except* those carrying an `x`/`y` binding. Every other child has
                // min == preferred and Slint's shrink pass can only take height off a cell with
                // room between the two, so without this a short window pushes the strip out.
                cover-slot := Rectangle {
                    preferred-height: root.cover-size;
                    max-height: root.cover-size;

                    if !Player.vm.has_station: NowPlayingCover {
                        // Square at whichever axis runs out first. The width term matters on a
                        // narrow window, where the Up Next column holds its floor and this one
                        // can end up narrower than the tile wants to be.
                        tile-size: min(parent.height, parent.width);
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                    }

                    // **`ArtworkImage`, not `NowPlayingCover`.** That component is the *track*
                    // cross-fade, and a station has nothing to cross-fade between; what it does
                    // need is the inset card, the monogram and the `radio` glyph, all of which
                    // the shared tile already owns. A station logo is routinely a favicon, so
                    // without the inset a 32 px source is magnified across 384.
                    //
                    // Both arms spell `x` and `y`, which is what keeps this slot the artwork
                    // column's only slack — see the shrink-pass note in `.claude/rules/visualizer.md`.
                    if Player.vm.has_station: ArtworkImage {
                        tile-size: min(parent.height, parent.width);
                        tile-radius: Theme.radius-lg;
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        artwork-path: Player.vm.radio.artwork_path;
                        // The row tier until the detail decode lands, the miniplayer's ternary.
                        // The subscriber empties the large slot the moment the source moves, so
                        // an empty one is a decode still out rather than a station with no logo.
                        cover: Player.np-station-logo.width > 0
                            ? Player.np-station-logo
                            : Player.vm.radio.logo_img;
                        native-size: Player.np-station-logo-size * 1px;
                        fallback-text: Player.vm.radio.monogram;
                        fallback-icon: "radio";
                        tile-bg: @linear-gradient(135deg,
                            Player.vm.radio.tile_color_1,
                            Player.vm.radio.tile_color_2);
                        tile-icon-color: #ffffff.transparentize(0.1);
                    }
                }

                // Centred under the artwork.
                VerticalLayout {
                    spacing: 4px;
                    // Backdrop-solved rather than a `Theme.*` brush: these sit on the blur, where a
                    // fixed brush lands light-on-light on a light theme. The album line takes the
                    // muted tier at reduced alpha — a three-line hierarchy, two solved tones.
                    Text {
                        text: Player.source-title;
                        color: Player.np-on-backdrop;
                        font-size: Theme.page-title-size;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: Player.source-subtitle;
                        color: Player.np-on-backdrop-muted;
                        font-size: Theme.font-size-lg;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    // An `if` rather than `visible:` — a hidden child still claims its
                    // cell, so an album-less track reserved a full text line for nothing.
                    if Player.source-tertiary != "": Text {
                        text: Player.source-tertiary;
                        color: Player.np-on-backdrop-muted.transparentize(0.25);
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                // **The strip reserves its row unconditionally**, so the centred artwork above
                // never reflows when a slow fetch lands or a track has no metadata. On a narrow
                // window it grows downward, the strip reporting its width and Rust re-chunking
                // uncapped. Contents are gated on the track id, so a fetch landing after a rapid
                // track change is never shown against the wrong track.
                if Player.vm.has_track: MetaChipStrip {
                    rows: Player.chip-rows;
                    show-rows: Player.track-meta.track_id == Player.vm.track.id;
                    centred: true;
                    chip-fill: Player.np-chip-fill;
                    chip-label-color: Player.np-chrome-text;
                    measured(w) => { Player.recompute-chip-rows(w); }
                }

                // The base under the whole cover → title → chips group. Wrapped in a centring
                // layout, a fixed-width child not centring in a wider column; both dimensions
                // come off the view root above.
                if Visualizer.enabled: HorizontalLayout {
                    alignment: center;
                    // Well below the column's shared spacing, so it reads as the base of the group
                    // rather than one more line of metadata. **The column is centred, so this
                    // splits between both ends** — budget twice the drop you actually want.
                    padding-top: root.strip-drop;
                    VisualizerStrip {
                        width: root.strip-w;
                        strip-height: root.strip-h;
                    }
                }
            }

            // Responsive, so a narrow window doesn't squeeze the chip strip first, and
            // reaching the panel's right edge so its scrollbar sits flush at any width.
            VerticalLayout {
                width: root.up-next-width;
                spacing: Theme.pad-sm;

                Text {
                    // A station's queue is untouched underneath it but is not what comes next,
                    // so this column states what the station *is* instead.
                    text: Player.vm.has_station ? @tr("Station") : @tr("Up Next");
                    // Accent-tinted like the divider under it but solid: a heading carries it at
                    // full alpha where a hairline can't. The rows below keep the list palette.
                    color: Player.np-accent-bright;
                    font-size: Theme.font-size-lg;
                    font-weight: 600;
                }
                Rectangle {
                    height: 1px;
                    // Weaker than the stars and heart above: a hairline, not a glyph, so it carries
                    // at a lower alpha without turning into a stripe.
                    background: Player.np-accent-bright.transparentize(0.55);
                }

                // The mini-player mounts the same component with `compact: true`.
                if !Player.vm.has_station: UpNextList {
                    vertical-stretch: 1;
                    compact: false;
                }
                // **The station page's own body, on this view's palette.** What a stream has
                // instead of a queue is a description of itself, so the two surfaces state the
                // same facts through the same component rather than one of them inventing a
                // second answer. No Votes row: that number comes from a directory refresh the
                // station page runs and this column has no reason to.
                //
                // One scroller for the pair — the history is capped by the ring that fills it, so
                // there is nothing to virtualize and no second scroller to nest.
                if Player.vm.has_station: Rectangle {
                    vertical-stretch: 1;

                    station-sv := ScrollView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        viewport-width: self.width;

                        // The station page's shape: the scroller keeps the full width so the
                        // wheel works over the bar's lane too, and the content insets instead.
                        VerticalLayout {
                            spacing: Theme.pad-md;
                            padding-right: Theme.scrollbar-slot;
                            alignment: start;

                            StationFacts {
                                stream-url: Player.vm.radio.stream_url;
                                homepage: Player.vm.radio.homepage;
                                codec: Player.vm.radio.codec;
                                bitrate: Player.vm.radio.bitrate;
                                play-count: Player.vm.radio.play_count;
                                // The column is a third of the panel, so the label gutter gives
                                // ground to the values — a stream URL needs what it can get.
                                label-width: 80px;
                                label-color: Player.np-on-backdrop-muted;
                                value-color: Player.np-on-backdrop;
                                action-idle-fg: Player.np-accent-dim;
                                action-hover-fg: Player.np-accent-bright;
                                action-hover-bg: Player.np-accent-pill;
                                stream-url-copied => {
                                    Radio.copy-stream-url(Player.vm.radio.station_id);
                                }
                                open-homepage(url) => { Radio.open-homepage(url); }
                            }

                            if Radio.history-rows.length > 0: StationHistory {
                                rows: Radio.history-rows;
                                heading-color: Player.np-on-backdrop-muted;
                                row-color: Player.np-on-backdrop;
                            }
                        }
                    }

                    OverlayScrollbar {
                        x: parent.width - self.width;
                        y: 0;
                        width: 10px;
                        height: parent.height;
                        visible-size: station-sv.visible-height;
                        content-size: station-sv.viewport-height;
                        offset: -station-sv.viewport-y;
                        // The Up Next list's weights, so the two columns sit into the backdrop
                        // the same way.
                        track-color: Player.np-accent-bright;
                        track-opacity: 0.25;
                        track-opacity-active: 0.4;
                        thumb-color: Player.np-accent-dim;
                        thumb-active-color: Player.np-accent-bright.transparentize(0.2);
                        scroll-to(o) => { station-sv.viewport-y = -o; }
                    }
                }
            }
        }
    }
}
