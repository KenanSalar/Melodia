import { Theme } from "../theme.slint";
import { Visualizer } from "../globals/audio.slint";
import { Nav } from "../globals/nav.slint";
import { Player } from "../globals/player.slint";
import { IconButton } from "../components/icon-button.slint";
import { AccentDiscButton } from "../components/now-playing/accent-disc-button.slint";
import { MetaChipStrip } from "../components/meta-chip-strip.slint";
import { StarRating } from "../components/star-rating.slint";
import { NowPlayingCover } from "../components/now-playing/now-playing-cover.slint";
import { UpNextList } from "../components/now-playing/up-next-list.slint";
import { NowPlayingViewMenu } from "../components/now-playing/view-menu.slint";
import { VisualizerStrip } from "../components/now-playing/visualizer-strip.slint";

// Full-screen Now Playing view. Rendered inside the main content panel
// (sidebar + now-playing bar stay visible) when `Nav.now-playing-open` is
// true. Mirrors the old Tauri layout: a large centred artwork + title /
// artist / album + metadata chips floating directly on a blurred album-art
// backdrop, with an "Up Next" list beside it. Transport + seek live in the
// now-playing bar (which stays visible below this view), so they are
// intentionally not duplicated here.
//
// The Up Next list itself — including its advance-by-row slide animation,
// outgoing-row overlay, scrollbar and empty state — lives in the shared
// `UpNextList` component (`components/now-playing/up-next-list.slint`) so
// the mini-player's square variant reuses the same behaviour.
export component NowPlayingView inherits Rectangle {
    // Ceiling on the square cover tile's edge. The tile takes this much when
    // the column has the height for it and less when it doesn't — see the
    // cover slot below, which is what makes the artwork the one thing in the
    // column that gives ground.
    property <length> cover-size: clamp(root.width * 0.22, 200px, 380px);

    // Visualizer strip height. 56 px was the strip's fixed height and stays
    // the floor, so no window draws a smaller one than it used to; the ceiling
    // keeps a tall screen from turning the base of the group into the group.
    property <length> strip-h: clamp(root.height * 0.12, 56px, 128px);

    // The strip's drop below the chips. Padding is not something the layout
    // can shrink on our behalf, so it comes off the panel height directly —
    // making it the first thing the column gives up on a short window.
    property <length> strip-drop: clamp(root.height * 0.06, Theme.pad-sm, Theme.pad-lg * 2.5);

    // The "Up Next" column, on a readable 280 px floor and a 420 px ceiling
    // that matches its old fixed value. Named rather than inlined because the
    // body row's left column — and so the chip strip's wrapping ceiling — is
    // the panel minus this.
    property <length> up-next-width: clamp(root.width * 0.35, 280px, 420px);

    // Width the artwork / title / chip column gets inside the body row: the
    // panel minus its left padding, the inter-column gap and the Up Next
    // column. This is the width `Player.recompute-chip-rows` chunks the chips
    // against, and what the visualizer strip below takes its share of.
    property <length> content-width: root.width - Theme.pad-lg - Theme.pad-md - root.up-next-width;

    // Ceiling on the strip's width: a band no wider than a quarter of the strip
    // is tall. The DSP always draws the same number of them, so a strip that
    // widens without getting taller divides them into ever-fatter columns — and
    // since a resting band is drawn as a dot of its own column's width, the row
    // of beads becomes a row of slabs. Reading the model's own length beats
    // restating `spectrum::NUM_BANDS` here; the `max` covers the frame before
    // Rust seeds the model.
    property <length> strip-w-max: root.strip-h / 4 * max(1, Visualizer.bars.length);

    // Three quarters of that column, so the strip reads as the base of the
    // cover → title → chips group rather than of the cover alone. The floor is
    // not cosmetic: at the window's 350 px floor `content-width` goes negative,
    // and flooring at the cover keeps the strip from ever being narrower than
    // the artwork above it.
    property <length> strip-w: max(root.cover-size, min(root.content-width * 0.75, root.strip-w-max));

    // --- Background: accent gradient floor + dual-slot blurred cross-fade -
    // The gradient is always painted. For a track WITH artwork the blur
    // slots fade in over it; for an art-less track `blur-has-image` is
    // false and both slots fade to 0, leaving this accent-tinted gradient
    // visible (Tauri parity). Either way there is never an empty frame.
    //
    // Both stops come from Rust rather than from `Theme.accent.mix(Theme.base,
    // …)`, because this is the surface an art-less track's title sits on: a
    // theme-derived floor is bright on a light theme, and the foreground here
    // is solved light. The stops keep the theme's hue and drop its polarity.
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(135deg, Player.np-floor-start, Player.np-floor-end);
    }

    // Two stacked Image slots. Rust writes the new blurred cover into the
    // inactive slot then flips `Player.blur-use-a`; only opacity animates,
    // and a slot's `source` is NEVER cleared — so the outgoing layer stays
    // fully painted for the whole fade. That overlap (plus the gradient
    // floor) is what makes the cross-fade flash-free.
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.blur-img-a;
        image-fit: ImageFit.cover;
        opacity: (Player.blur-has-image && Player.blur-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.blur-img-b;
        image-fit: ImageFit.cover;
        opacity: (Player.blur-has-image && !Player.blur-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }

    // Scrim — drives the *composited* backdrop into a known dark band so the
    // foreground stays legible whatever the cover looks like. Its opacity is
    // solved per artwork in Rust and baked into the brush, which is why there
    // is no `with-alpha` here: a fixed alpha of a theme colour can't do this
    // job (on a light theme `Theme.crust` is near-white, so raising it
    // *brightens* the backdrop), and a white sleeve needs roughly twice the
    // opacity a black one does.
    //
    // Animated on the same duration as the blur slots above so the two ride
    // one curve — a scrim that snapped mid-cross-fade would read as a glitch.
    Rectangle {
        width: 100%;
        height: 100%;
        background: Player.np-scrim;
        animate background { duration: Theme.dur-med; easing: ease-in-out; }
    }

    // --- Foreground ------------------------------------------------------
    // Padding is applied per-section, NOT uniformly on this VerticalLayout:
    // the "Up Next" column must reach the panel's right edge so its overlay
    // scrollbar sits flush there (same as the Tracks / Browse views).
    VerticalLayout {
        padding-top: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Top bar — back button, then favourite toggle pushed to the right.
        // Floats directly over the backdrop.
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            spacing: Theme.pad-sm;

            VerticalLayout {
                alignment: center;
                AccentDiscButton {
                    icon: "arrow_back";
                    clicked => { Nav.now-playing-open = false; }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Star rating for the current track, left of the favorite heart.
            if Player.vm.has_track: VerticalLayout {
                alignment: center;
                StarRating {
                    rating: Player.vm.track.rating;
                    star-size: 22px;
                    // Accent-tinted rather than the list views' yellow — see
                    // the heart below for why this whole group shares the
                    // spectrum bars' colour.
                    filled-color: Player.np-accent-bright;
                    empty-color: Player.np-accent-dim;
                    rated(n) => { Player.set-current-rating(n); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    filled: Player.vm.track.is_favorite;
                    active: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    diameter: 36px;
                    icon-size: 22px;
                    // A bare glyph like the stars beside it — no chrome disc
                    // in any state, hover included, so `hover-bg` has to be
                    // overridden too (it defaults to a solid `Theme.surface0`).
                    // Hover reads through the icon colour instead.
                    hover-bg: transparent;
                    // Same accent the spectrum bars paint with, so the whole
                    // group reads as one family against the artwork blur. The
                    // outlined-vs-filled glyph carries the favourited state, so
                    // the unfavourited variant only needs to be quieter.
                    idle-fg: Player.np-accent-dim;
                    hover-fg: Player.np-accent-bright;
                    active-fg: Player.np-accent-bright;
                    clicked => { Player.toggle-favorite(); }
                }
            }

            // View-scoped menu (visualizer options). Not gated on
            // `vm.has_track` — its options are meaningful with an empty queue.
            VerticalLayout {
                alignment: center;
                NowPlayingViewMenu { }
            }
        }

        // Body — centred artwork group on the left, fixed-width "Up Next"
        // column on the right. Both float directly on the backdrop (no card
        // chrome). No right or bottom padding: the Up Next column reaches the
        // panel edge on both axes, so its overlay scrollbar lands flush and
        // rows scroll off the bottom edge instead of under a strip of
        // backdrop. The bottom inset the artwork group wants is applied to
        // that column alone.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.pad-lg;
            spacing: Theme.pad-md;

            // -- Artwork + title + chips, vertically centred -------------
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                padding-bottom: Theme.pad-lg;
                spacing: Theme.pad-md;

                // Large foreground cover. Only the cover content cross-fades on
                // a track change (dual-slot pattern, driven by
                // `ui::now_playing_artwork`); high-res source, so it stays
                // crisp at this size.
                //
                // The slot is a plain Rectangle rather than a centring
                // HorizontalLayout, and the tile inside it spells out `x` and
                // `y`, because that combination is what makes the artwork the
                // only child of this column with any slack. A non-layout
                // element folds its children's constraints into its own —
                // except for children carrying an `x` or `y` binding — so the
                // slot reports a min of 0 against a preferred and max of
                // `cover-size`. Every other child here has min == preferred
                // (the text lines, the chip strip's reserved row, the strip
                // itself), and Slint's shrink pass can only take height off a
                // cell with room between the two. Without this the column had
                // none, so a short — or merely wide, since the tile grows with
                // the width — window pushed the last child, the visualizer,
                // straight out of the panel.
                cover-slot := Rectangle {
                    preferred-height: root.cover-size;
                    max-height: root.cover-size;

                    NowPlayingCover {
                        // Square at whichever axis runs out first. The width
                        // term matters on a narrow window, where the Up Next
                        // column holds a 280 px floor and this column can end
                        // up narrower than the tile wants to be.
                        tile-size: min(parent.height, parent.width);
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                    }
                }

                // Title / artist / album, centred under the artwork.
                VerticalLayout {
                    spacing: 4px;
                    // Backdrop-solved rather than `Theme.text` / `subtext1` /
                    // `overlay2`: these sit on the blur, so a fixed theme
                    // brush lands light-on-light on a light theme. The album
                    // line takes the muted tier at reduced alpha, keeping the
                    // three-line hierarchy without a third solved tone.
                    Text {
                        text: Player.vm.has_track
                            ? "‎" + Player.vm.track.title
                            : @tr("No track playing");
                        color: Player.np-on-backdrop;
                        font-size: Theme.page-title-size;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: Player.vm.has_track
                            ? "‎" + (Player.vm.track.artist == ""
                                ? @tr("Unknown artist")
                                : Player.vm.track.artist)
                            : "—";
                        color: Player.np-on-backdrop-muted;
                        font-size: Theme.font-size-lg;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    // An `if` rather than `visible:` — a hidden child still
                    // claims its cell, so an album-less track was reserving a
                    // full text line for nothing.
                    if Player.vm.has_track && Player.vm.track.album != "": Text {
                        text: "‎" + Player.vm.track.album;
                        color: Player.np-on-backdrop-muted.with-alpha(0.75);
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                // Technical-metadata chips. The strip reserves its row
                // unconditionally, so the centred artwork above never
                // reflows when a slow fetch lands — or when a track simply
                // has no metadata. On narrow windows it grows downward
                // into 2+ rows: the strip reports its width, and Rust
                // re-chunks `Player.chip-rows` against it, uncapped.
                // Contents are gated on `track_id == vm.track.id` so a
                // fetch landing after a rapid track change is never shown
                // against the wrong track.
                if Player.vm.has_track: MetaChipStrip {
                    rows: Player.chip-rows;
                    show-rows: Player.track-meta.track_id == Player.vm.track.id;
                    centred: true;
                    chip-fill: Player.np-accent-pill;
                    chip-label-color: Player.np-accent-bright;
                    measured(w) => { Player.recompute-chip-rows(w); }
                }

                // Visualizer strip, as a base under the whole cover → title →
                // chips group. Wrapped in a centring HorizontalLayout because
                // a fixed-width child does not centre in a wider
                // VerticalLayout.
                //
                // Both dimensions come off the view root — see `strip-h` /
                // `strip-w` there for what each is derived from.
                if Visualizer.enabled: HorizontalLayout {
                    alignment: center;
                    // Sits well below the column's shared spacing so it reads as
                    // the base of the cover → title → chips group rather than
                    // one more line of metadata. The column is centred, so this
                    // splits between the two ends: the strip drops by half of
                    // it, everything above rises by the other half — budget
                    // twice the drop you actually want.
                    padding-top: root.strip-drop;
                    VisualizerStrip {
                        width: root.strip-w;
                        strip-height: root.strip-h;
                    }
                }
            }

            // -- "Up Next" list ------------------------------------------
            // Width comes from `up-next-width` (see the root properties) —
            // responsive, so a narrow window doesn't squeeze the chip strip
            // first. Reaches the panel's right edge — the overlay scrollbar
            // inside `list-wrap` sits flush with that edge at any width.
            VerticalLayout {
                width: root.up-next-width;
                spacing: Theme.pad-sm;

                Text {
                    text: @tr("Up Next");
                    // Accent-tinted like the divider under it, but solid — a
                    // heading carries it at full alpha where a hairline can't.
                    // Row text below keeps the neutral list palette.
                    color: Player.np-accent-bright;
                    font-size: Theme.font-size-lg;
                    font-weight: 600;
                }
                Rectangle {
                    height: 1px;
                    // Accent-tinted like the stars and heart above. Weaker than
                    // they are — it's a hairline, not a glyph, so it carries at
                    // a lower alpha without turning into a stripe.
                    background: Player.np-accent-bright.with-alpha(0.45);
                }

                // Shared list body — slide animation, outgoing-row
                // overlay, scrollbar and empty state all live inside
                // `UpNextList`. The mini-player mounts the same component
                // with `compact: true`.
                UpNextList {
                    vertical-stretch: 1;
                    compact: false;
                }
            }
        }
    }
}
