import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { RadioForm } from "../../globals/dialog-forms.slint";
import { Dialog } from "../../globals/dialog.slint";
import { ActionPill, PillButton, PillDivider } from "../../components/action-pill.slint";
import { SortMenuPopup } from "../../components/sort-menu-popup.slint";
import { FacetChip } from "facet-chip.slint";

// Every pill row the Radio band can show, mutually exclusive on the mounted tab and handed to
// `LibraryTabBand` as its whole `@children`: Browse's filter chips, then Favorites' single chip of
// add / import / export plus its sort picker. Recently Played has none, its order being the page.
//
// **Both rows also gate on `!detail-open`.** They describe the tab under the station page, not the
// page, and a station's own actions are in its body rather than up here — six of them will not fit
// as text pills, and the tooltip note below is why they cannot be icons.
//
// **Favorites sorts through a popup rather than the usual `SortPillRow`.** Four fields spelled out
// beside three operations mounted two chips at once, flush against each other under the
// `spacing: 0px` below, and left the band no room for the count line it reserves against
// `pills.width`.
//
// **Text labels rather than icon-and-tooltip.** The band paints its slot before the body, so a
// tooltip drawn from in here would need the published-anchor treatment `MyLibraryTabPills` carries
// for exactly one of its rows; a labelled pill says the same thing and needs none of it.
export component RadioTabPills inherits Rectangle {
    HorizontalLayout {
        alignment: end;
        // The rows are mutually exclusive, so any spacing here would read as a permanent inset on
        // the tabs that mount nothing.
        spacing: 0px;

        // The Browse filters, in the band's slot rather than in the tab body: this is where the
        // page's controls go and where a station detail's own will land. Country carries a code
        // because `countrycode` is the search endpoint's one code-keyed parameter; the rest filter
        // by name, and the bitrate chip's `code` is its own floor in kbps.
        //
        // Nested so the chips carry their own spacing, the outer row's `0px` being what keeps
        // every other row flush with the band's edge.
        if !Radio.detail-open && Radio.tab-idx == Radio.tab-browse: HorizontalLayout {
            spacing: Theme.pad-sm;

            FacetChip {
                kind: Radio.facet-country;
                label: @tr("Country");
                value: Radio.pick-country;
                options: Radio.facet-shown == Radio.facet-country ? Radio.facet-options : [];
                loading: Radio.facet-shown == Radio.facet-country && Radio.facet-loading;
                needle <=> Radio.facet-filter;
                opened(k) => { Radio.request-facet(k); }
                needle-edited(t) => { Radio.facet-filter-changed(t); }
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }

            FacetChip {
                kind: Radio.facet-language;
                label: @tr("Language");
                value: Radio.pick-language;
                options: Radio.facet-shown == Radio.facet-language ? Radio.facet-options : [];
                loading: Radio.facet-shown == Radio.facet-language && Radio.facet-loading;
                needle <=> Radio.facet-filter;
                opened(k) => { Radio.request-facet(k); }
                needle-edited(t) => { Radio.facet-filter-changed(t); }
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }

            FacetChip {
                kind: Radio.facet-tag;
                label: @tr("Genre");
                value: Radio.pick-tag;
                options: Radio.facet-shown == Radio.facet-tag ? Radio.facet-options : [];
                loading: Radio.facet-shown == Radio.facet-tag && Radio.facet-loading;
                needle <=> Radio.facet-filter;
                opened(k) => { Radio.request-facet(k); }
                needle-edited(t) => { Radio.facet-filter-changed(t); }
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }

            FacetChip {
                kind: Radio.facet-codec;
                label: @tr("Format");
                value: Radio.pick-codec;
                options: Radio.facet-shown == Radio.facet-codec ? Radio.facet-options : [];
                loading: Radio.facet-shown == Radio.facet-codec && Radio.facet-loading;
                needle <=> Radio.facet-filter;
                opened(k) => { Radio.request-facet(k); }
                needle-edited(t) => { Radio.facet-filter-changed(t); }
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }

            // Its options are a literal rather than a fetch: the floors are ours to choose, not
            // the directory's to list. `code` is what the request carries, so it stays unlocalized
            // while the label is not.
            FacetChip {
                kind: Radio.facet-bitrate;
                label: @tr("Bitrate");
                value: Radio.pick-bitrate-min > 0
                    ? @tr("{} kbps and up", Radio.pick-bitrate-min)
                    : "";
                searchable: false;
                options: [
                    { name: @tr("{} kbps and up", 64), code: "64" },
                    { name: @tr("{} kbps and up", 128), code: "128" },
                    { name: @tr("{} kbps and up", 192), code: "192" },
                    { name: @tr("{} kbps and up", 320), code: "320" },
                ];
                picked(k, n, c) => { Radio.facet-picked(k, n, c); }
                cleared(k) => { Radio.clear-facet(k); }
            }
        }

        if !Radio.detail-open && Radio.tab-idx == Radio.tab-favorites: ActionPill {
            // Fills the Dialog inline rather than hopping through Rust: a synchronous
            // `set_open(true)` mid-click-handler trips Slint's recursion guard.
            PillButton {
                icon: "add";
                text: @tr("Add Station");
                clicked => {
                    // Reset here as well as at the teardown: the session's first open has had no
                    // close before it, and the declared defaults are not the add form's.
                    RadioForm.reset();
                    Dialog.title = @tr("Add Station");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Add");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.kind = "add-station";
                    Dialog.target-id = -1;
                    Dialog.open = true;
                }
            }

            PillDivider { }

            // Portable playlists, so a station list survives a database wipe and arrives from
            // whatever the user was using before. Both are pure Rust flows over native pickers.
            PillButton {
                icon: "download";
                text: @tr("Import");
                clicked => { Radio.import-stations(); }
            }

            PillDivider { }

            PillButton {
                icon: "upload";
                text: @tr("Export");
                clicked => { Radio.export-stations(); }
            }

            PillDivider { }

            SortMenuPopup {
                labels: [@tr("Name"), @tr("Added"), @tr("Plays"), @tr("Last played")];
                fields: ["name", "added", "plays", "played"];
                sort-field: Radio.sort-field;
                sort-dir: Radio.sort-dir;
                request-sort(f) => { Radio.request-sort(f); }
            }
        }
    }
}
