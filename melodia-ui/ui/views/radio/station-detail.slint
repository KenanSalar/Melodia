import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Radio } from "../../globals/radio.slint";
import { IconButton } from "../../components/icon-button.slint";
import { MaterialIcon } from "../../components/material-icon.slint";
import { OverlayScrollbar } from "../../components/overlay-scrollbar.slint";
import { TooltipSide } from "../../components/tooltip.slint";

// A tinted glyph and a sentence. Two of these sit above the facts and say different things, and
// both are notes about the station rather than controls, so neither is a pill.
component StatusLine inherits HorizontalLayout {
    in property <string> icon;
    in property <brush> tint;
    in property <string> text;

    alignment: start;
    spacing: Theme.pad-xs;
    vertical-stretch: 0;

    MaterialIcon {
        name: root.icon;
        icon-size: 16px;
        icon-color: root.tint;
    }
    // The glyph sits in a collapsed em-box and the text in a line box, so the two need a
    // centring wrapper to share a baseline.
    VerticalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
    }
}

// One labelled fact, with an optional control on the value. Local rather than `SettingRow`, which
// reads `SettingsPage.row-icon-w` and is Settings chrome.
//
// **Pinned to the list's row height, not sized from what it holds.** Two of these carry a 28 px
// control and the rest carry one line box, so left to their content they stand at two different
// heights and the column's rhythm breaks on exactly the rows the eye is drawn to. Every list in
// the tree pins the pair instead (`components/track-list/track-list-row.slint`).
component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> action-icon;
    in property <string> action-tooltip;
    callback action-clicked();

    spacing: Theme.pad-md;
    vertical-stretch: 0;
    min-height: Theme.row-h-compact;
    max-height: Theme.row-h-compact;

    VerticalLayout {
        alignment: center;
        Text {
            // Fixed, so the values line up down the column rather than tracking each label.
            width: 128px;
            text: root.label;
            color: Theme.subtext0;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            // The mark is what keeps a URL from re-ordering under a right-to-left UI locale: it
            // is the station's text, not the interface's.
            text: "\u{200e}" + root.value;
            color: Theme.text;
            font-size: Theme.font-size-md;
            overflow: elide;
        }
    }
    // **Left, where every other tooltip in the tree clears above.** The button is the row's
    // trailing cell, so a pill centred on it runs past the scroller's right edge; and the first
    // row sits at the scroller's *top* edge on a station carrying neither a format warning nor a
    // directory verdict, which cuts an above-pill off entirely. The left arm centres vertically
    // and clears inward, so both edges stop mattering.
    if root.action-icon != "": IconButton {
        icon: root.action-icon;
        icon-size: 16px;
        diameter: 28px;
        tooltip-text: root.action-tooltip;
        tooltip-side: TooltipSide.left;
        clicked => { root.action-clicked(); }
    }
}

// One station's page, under the band it morphed into that station's hero.
//
// **The band owns the title, the artwork, the chips and every action**; this file owns the facts.
// That split is what both radio players with a station page settle on — Shortwave's dialog and
// RadioDroid's detail are each a labelled list — and it is why nothing here grows a header of its
// own, which `ui::hero_chips::tests` walks every band host for.
//
// **No empty state.** The song history is a section that exists only once the station has
// announced something, so a station that has never played shows its facts rather than a page
// apologising for having no songs.
export component RadioStationDetail inherits Rectangle {
    // A click anywhere the rows don't claim gives the band's box up. Harmless while the box is
    // hidden over this page, and correct on the frame it comes back.
    TouchArea {
        clicked => { Radio.blur-search-tick += 1; }
    }

    // **The clipboard, and the whole of it.** Slint's `TextInput` carries `select-all()` and
    // `copy()`; nothing else in the tree reaches a clipboard, and a dependency for one button is
    // a poor trade against a zero-sized field. Outside the layout, so it claims no space —
    // `visible: false` would still take a slot.
    url-field := TextInput {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        text: Radio.detail-stream-url;
    }

    VerticalLayout {
        // Left, right and top only — a bottom pad here sits *outside* the scroller's viewport and
        // reads as a dead strip rather than as breathing room.
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        padding-top: Theme.pad-lg;

        body := Rectangle {
            vertical-stretch: 1;

            // One scroller for the whole page. The history is capped by the ring that fills it,
            // so there is nothing here to virtualize and no second scroller to nest.
            sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: Theme.pad-md;
                    padding-right: Theme.scrollbar-slot;
                    alignment: start;

                    // Why there is no Play control. D13's whole point is that a segmented station
                    // is listed and labelled rather than hidden, and this is the surface with
                    // room to say why.
                    if Radio.detail-station.hls: StatusLine {
                        icon: "error";
                        tint: Theme.yellow;
                        text: @tr("This station streams in a segmented format Melodia can't play yet.");
                    }

                    // What the directory's own reachability check last said. Shown only once an
                    // answer has arrived: "we asked and it failed" and "nobody has asked" are
                    // different, and only the first is worth printing.
                    if Radio.detail-check-known: StatusLine {
                        icon: Radio.detail-check-ok ? "check_circle" : "error";
                        tint: Radio.detail-check-ok ? Theme.green : Theme.yellow;
                        text: Radio.detail-check-ok
                            ? @tr("The directory reached this station on its last check.")
                            : @tr("The directory could not reach this station on its last check.");
                    }

                    // **The facts are a list, so they take a row pitch and no gap between rows.**
                    // The `pad-md` above separates this page's *sections*; handing it to the rows
                    // as well spaces a labelled list like a set of unrelated blocks, and does it
                    // on top of heights that differ by whether a row happens to carry a control.
                    // One group at one pitch is what every other list here does.
                    VerticalLayout {
                        vertical-stretch: 0;

                        // The facts, each absent when the station carries nothing for it. A
                        // hand-typed station arrives with almost none of them.
                        DetailRow {
                            label: @tr("Stream");
                            value: Radio.detail-stream-url;
                            action-icon: "content_copy";
                            action-tooltip: @tr("Copy stream URL");
                            action-clicked => {
                                url-field.select-all();
                                url-field.copy();
                                Radio.copy-stream-url();
                            }
                        }
                        if Radio.detail-station.homepage != "": DetailRow {
                            label: @tr("Website");
                            value: Radio.detail-station.homepage;
                            action-icon: "link";
                            action-tooltip: @tr("Open in your browser");
                            action-clicked => {
                                Radio.open-homepage(Radio.detail-station.homepage);
                            }
                        }
                        if Radio.detail-station.codec != "": DetailRow {
                            label: @tr("Format");
                            value: Radio.detail-station.codec;
                        }
                        // Zero on a large share of live stations, where it means the directory
                        // does not know rather than that the station is silent.
                        if Radio.detail-station.bitrate > 0: DetailRow {
                            label: @tr("Bitrate");
                            value: @tr("{} kbps", Radio.detail-station.bitrate);
                        }
                        if Radio.detail-votes >= 0: DetailRow {
                            label: @tr("Votes");
                            value: @tr("{n} vote" | "{n} votes" % Radio.detail-votes);
                        }
                        if Radio.detail-station.play_count > 0: DetailRow {
                            label: @tr("Plays");
                            value: @tr("{n} play" | "{n} plays" % Radio.detail-station.play_count);
                        }
                    }

                    // **Mounted only when it has something**, which is what retires the empty
                    // state: a station that has never played shows the facts above and nothing
                    // where this would be. Neither radio player with a station page carries a
                    // song list on it at all; this is the one thing Melodia adds, so it earns its
                    // place by never being in the way.
                    //
                    // The heading takes a row at the same pitch rather than a margin of its own,
                    // so it sits in the rhythm of what it labels — `TrackListHeader`'s shape.
                    if Radio.history-rows.length > 0: VerticalLayout {
                        vertical-stretch: 0;

                        VerticalLayout {
                            alignment: center;
                            min-height: Theme.row-h-compact;
                            max-height: Theme.row-h-compact;
                            Text {
                                text: @tr("Recently played on this station");
                                color: Theme.subtext0;
                                font-size: Theme.font-size-sm;
                                font-weight: Theme.page-title-weight;
                                overflow: elide;
                            }
                        }
                        for title in Radio.history-rows: VerticalLayout {
                            alignment: center;
                            min-height: Theme.row-h-compact;
                            max-height: Theme.row-h-compact;
                            Text {
                                text: "\u{200e}" + title;
                                color: Theme.text;
                                font-size: Theme.font-size-md;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            OverlayScrollbar {
                horizontal: false;
                x: parent.width - self.width;
                width: 10px;
                height: 100%;
                visible-size: sv.visible-height;
                content-size: sv.viewport-height;
                offset: -sv.viewport-y;
                scroll-to(o) => { sv.viewport-y = -o; }
            }
        }
    }
}
