import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Search } from "../globals/search.slint";
import { SearchBar } from "../components/search-bar.slint";
import { HorizontalCardStrip } from "../components/grid/horizontal-card-strip.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { RecentSearches } from "search/recent-searches.slint";
import { NoResults } from "search/no-results.slint";
import { TopResultCard } from "search/top-result-card.slint";
import { SongsSection } from "search/songs-section.slint";

// One full-height scroll container holding every state branch, with an autofocused
// `SearchBar` floating over it and no page title. **A mount sheet**: this file owns the
// timers, the branch conditions and the two scroll chromes, and `views/search/*.slint`
// own the bodies — the `views/settings/pages/` and `views/favorites/` precedent. Each
// section reads `Search` directly and takes no inputs, so a branch here is one line.
//
// **The bar is not a band.** It used to head a 96 px row inside the view's column, which
// clipped the scroller at that row's floor: the panel's own `Theme.base` showed through
// above it and the first card and list header were cut off behind an opaque-reading
// strip. Out of the flow it costs nothing but the inset the body reserves, the results
// pass behind it, and — since the row carries no `TouchArea` of its own — everything
// beside the pill stays clickable.
//
// Both strips match through their own tracks as well as by name, so a query reaching
// only track metadata still fills them — and with them the Top Result, which ranks over
// those two lists plus genres.
//
// **There is no Genres strip**: a genre is a *route*, not something to browse a row of,
// so a genre match surfaces as the Top Result card and clicking it goes through the same
// `go-to-genre` a track row's context entry uses.
//
// An album or artist card stamps `*Detail.origin-nav-index` **before** flipping
// `Nav.selected-index`, so the detail's back arrow returns here.
export component SearchView inherits Rectangle {
    // The `edited` bump; this Timer commits after the keystrokes go quiet and writes
    // `applied` to halt itself — the Tracks / Favorites throttle shape.
    debounce := Timer {
        interval: 300ms;
        running: Search.debounce-tick-pending != Search.debounce-tick-applied;
        triggered() => {
            Search.debounce-tick-applied = Search.debounce-tick-pending;
            Search.commit-search(Search.query);
        }
    }

    // The view is rebuilt on every entry, so this re-fires each time. **A Timer, not
    // `init`**, which keeps the `focus()` call out of binding evaluation.
    autofocus := Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            search-bar.focus-input();
        }
    }

    // Catches any click no inner TouchArea consumes and bumps the blur tick.
    TouchArea {
        clicked => { Search.blur-search-tick += 1; }
    }

    // What the scroll body insets its content by, and the height of the floating row:
    // the bar's own 32 px with `pad-md` of clearance above and below. Nothing starts
    // underneath the pill, and everything scrolls behind it from there.
    private property <length> bar-inset: 56px;

    body := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        below-sv := ScrollView {
            width: 100%;
            height: 100%;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy:   always-off;
            viewport-width: self.width;

            VerticalLayout {
                padding-top: root.bar-inset;
                padding-left: Theme.pad-lg;
                padding-right: Theme.pad-lg;
                padding-bottom: Theme.pad-lg;
                spacing: Theme.pad-lg;

                if Search.query == "" && Search.recent-rows.length > 0: RecentSearches { }

                if Search.loading && Search.query != "": HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: center;
                    padding-top: Theme.pad-lg;
                    Text {
                        text: @tr("Searching…");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                    }
                }

                if !Search.loading && Search.query != ""
                    && Search.tracks.length == 0
                    && Search.album-rows.length == 0
                    && Search.artist-rows.length == 0
                    && Search.top-kind == "": NoResults { }

                // The Top Result subtree unmounts entirely with no top result, so the
                // Songs column claims the full width naturally.
                if Search.top-kind != "" || Search.tracks.length > 0: HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.pad-lg;
                    alignment: stretch;

                    if Search.top-kind != "": TopResultCard { }

                    SongsSection { }
                }

                if Search.album-rows.length > 0: HorizontalCardStrip {
                    heading: @tr("Albums");
                    rows: Search.album-rows;
                    card-width: 160px;
                    card-height: 206px;
                    show-play-overlay: false;
                    fallback-icon: "album";
                    request-cover(p) => {
                        return Search.request-album-strip-cover(p);
                    }
                    row-clicked(id) => {
                        Search.blur-search-tick += 1;
                        Search.open-album(id);
                    }
                    // play-clicked unused (no play-overlay).
                }

                if Search.artist-rows.length > 0: HorizontalCardStrip {
                    heading: @tr("Artists");
                    rows: Search.artist-rows;
                    card-width: 160px;
                    card-height: 206px;
                    circular: true;
                    show-play-overlay: false;
                    fallback-icon: "person";
                    request-cover(p) => {
                        return Search.request-artist-strip-cover(p);
                    }
                    row-clicked(id) => {
                        Search.blur-search-tick += 1;
                        Search.open-artist(id);
                    }
                }

                // **Collects the surplus.** A column whose children are all
                // `vertical-stretch: 0` divides spare height equally among them, which on
                // the empty-query state — where only the Recent section is mounted —
                // pushed its heading to the top and its chips to the bottom with a
                // yawning gap between.
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // Covers the whole view, since the results now run its full height.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: 0;
        width: 10px;
        height: parent.height;
        visible-size: below-sv.visible-height;
        content-size: below-sv.viewport-height;
        offset: -below-sv.viewport-y;
        scroll-to(o) => { below-sv.viewport-y = -o; }
    }

    // Declared last so it paints over both the results and the scrollbar — Slint paints
    // in declaration order. The height has to be pinned: as a layout child of a plain
    // Rectangle it would otherwise fill the view and centre the pill down the middle of
    // it. `pad-lg` on both sides keeps the bar clear of the scrollbar's 10 px track at
    // any width, since it compresses toward its own `min-w` rather than overrunning.
    HorizontalLayout {
        y: 0;
        height: root.bar-inset;
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        alignment: center;

        VerticalLayout {
            alignment: center;
            search-bar := SearchBar {
                text <=> Search.query;
                placeholder: @tr("Search your library…");
                blur-trigger: Search.blur-search-tick;
                input-width: 420px;
                edited(t) => {
                    Search.debounce-tick-pending += 1;
                    Search.query-changed(t);
                }
                // Enter commits immediately, and aligning the ticks cancels the pending
                // fire so the query isn't committed twice. **This is what lets a
                // preserved query be re-run**: tab-leave released the results and cleared
                // the models but kept `Search.query`, so no editing is needed — just
                // focus and Enter.
                accepted => {
                    Search.debounce-tick-applied = Search.debounce-tick-pending;
                    Search.commit-search(Search.query);
                }
            }
        }
    }
}
