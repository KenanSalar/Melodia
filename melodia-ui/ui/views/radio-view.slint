import { Radio } from "../globals/radio.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { LibraryTabBand } from "../components/hero/library-tab-band.slint";
import { TooltipFrame } from "../components/tooltip-frame.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { RadioBrowseTab } from "radio/browse-tab.slint";
import { KeptStationsTab } from "radio/kept-stations-tab.slint";
import { RadioTabPills } from "radio/tab-pills.slint";

// Radio: three tabs over the directory, the stations the user kept and the ones they played,
// under the same `LibraryTabBand` My Library wears. The mount sheet and nothing else — the band
// carries the tab bar, the filter box, the action pills and the count line; each tab body owns
// whatever scroller it grows.
//
// **The band's hero half is idle here**, `detail-open` a literal `false`, until the station detail
// gives it something to morph into.
export component RadioView inherits Rectangle {
    property <int> filter-tick-pending: 0;

    // A click anywhere the band or a body doesn't claim gives the filter box up.
    TouchArea {
        clicked => { Radio.blur-search-tick += 1; }
    }

    // **One mount for three tabs, and only one of them is the network case.** On Browse a settled
    // burst is a directory request, not a walk over rows already in hand, so it is the tree's only
    // `trailing` mount — a value the user typed through is a request and a logo burst spent on a
    // page nobody will look at — at an interval sized to a round trip. The two local tabs filter
    // rows the session already holds and take the cadence every other box in the tree takes;
    // `filter::dispatch` routes on the same `tab-idx`, so the pacing follows the destination.
    FilterThrottle {
        trailing: Radio.tab-idx == Radio.tab-browse;
        interval: Radio.tab-idx == Radio.tab-browse ? 200ms : 130ms;
        pending: root.filter-tick-pending;
        fire() => { Radio.filter-changed(Radio.filter); }
    }

    // Every count holds `ui::tab_bar::UNFETCHED_COUNT` until fetched, hence the `>= 0` guard: a
    // bare `-1` interpolates into the plural as "-1 stations". Resolved to one number first so the
    // guard is written once rather than per tab. **No latch over it**, unlike My Library's — that
    // hold exists because a drill re-reads the arriving tab while the band eases the line out, and
    // nothing here morphs yet.
    property <int> mounted-count:
        Radio.tab-idx == Radio.tab-browse ? Radio.browse-count
        : Radio.tab-idx == Radio.tab-favorites ? Radio.favorites-count
        : Radio.recent-count;
    property <string> count-line: root.mounted-count >= 0
        ? @tr("{n} station" | "{n} stations" % root.mounted-count)
        : "";

    // One derivation for all three tabs — they draw the same card in the same grid. Measured off
    // the body, whose width the layout fixes independently of the cards inside it, so a card
    // sizing itself from it is a derivation and not a cycle.
    //
    // **The width pitch stays the shared default**, so a station row packs like an album row and
    // the tier `grid_prewarm` derives from that same default covers the card this grid draws. The
    // text height is the one thing Radio moves, its card carrying a third line.
    property <length> grid-gap: 20px;

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
        card-text-h: 66px;
    }

    // One count for three grids: Rust re-chunks whichever tab is mounted, so the callback fires
    // unconditionally and the branch that used to gate it lives on the Rust side instead.
    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Radio.grid-columns = c;
            Radio.columns-changed(c);
        }
    }

    VerticalLayout {
        band := LibraryTabBand {
            // Inline literals: `@tr` folds msgids at codegen, so a Rust-seeded `[string]`
            // renders untranslated. Order matches `Radio.tab-*`.
            tab-labels: [@tr("Browse"), @tr("Favorites"), @tr("Recently Played")];
            tab-icons: ["travel_explore", "favorite", "history"];
            tab-idx <=> Radio.tab-idx;
            tab-selected(i) => {
                // **The box is reseated, not cleared**, and Rust does it inside `tab-changed`.
                // A directory query carried into the kept list would silently hide rows, but
                // blanking the box here would leave Browse's own query standing in Rust with
                // nothing on screen saying what the grid is filtered by. Each tab's needle is
                // its own, and the box says whichever one is mounted.
                Radio.blur-search-tick += 1;
                Radio.tab-changed(i);
            }

            filter <=> Radio.filter;
            blur-tick: Radio.blur-search-tick;
            search-edited(t) => { root.filter-tick-pending += 1; }

            count-text: root.count-line;

            // The box means different things per tab — a search sent to the directory against a
            // filter over rows already here — so the placeholder says which.
            filter-placeholder: Radio.tab-idx == Radio.tab-browse
                ? @tr("Search stations…")
                : @tr("Filter stations…");

            detail-open: false;

            RadioTabPills { }
        }

        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // `slide` is bound now, though the band cannot morph until it has a detail: it is what
            // stops a body translating under a band that is itself moving, and the two curves
            // disagree enough that the sum briefly runs backwards.
            if Radio.tab-idx == Radio.tab-browse: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: band.tab-anim-armed;
                slide: !band.morphing;
                RadioBrowseTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if Radio.tab-idx == Radio.tab-favorites: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: band.tab-anim-armed;
                slide: !band.morphing;
                // Everything starred out of Browse, plus everything typed in by hand — a custom
                // station is starred on the way in, which is what lets one query answer the tab.
                KeptStationsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                    rows: Radio.favorites-rows;
                    count: Radio.favorites-count;
                    empty-icon: "favorite";
                    empty-title: @tr("No stations kept yet");
                    empty-body: @tr("Star a station in Browse, or add one by URL.");
                }
            }
            if Radio.tab-idx == Radio.tab-recent: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: band.tab-enter-from;
                enabled: band.tab-anim-armed;
                slide: !band.morphing;
                // The wider set: anything with a play behind it, starred or not — which is the
                // whole reason this is a tab rather than a sort of the one beside it.
                KeptStationsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                    rows: Radio.recent-rows;
                    count: Radio.recent-count;
                    empty-icon: "history";
                    empty-title: @tr("Nothing played yet");
                    empty-body: @tr("Stations you listen to show up here.");
                }
            }
        }
    }

    // On a layer of its own: the bar sits in the band, and Slint paints in declaration order, so
    // anything the band owns is covered by the body underneath.
    TooltipFrame {
        x: band.absolute-position.x - root.absolute-position.x + band.tip-x;
        y: band.absolute-position.y - root.absolute-position.y + band.tip-y;
        width: band.tip-w;
        height: band.tip-h;
        label: band.tip-label;
        shown: band.tip-visible;
    }
}
