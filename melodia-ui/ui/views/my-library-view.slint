import { MyLibrary } from "../globals/my-library.slint";
import { Nav } from "../globals/nav.slint";
import { AlbumDetail, Albums } from "../globals/albums.slint";
import { ArtistDetail, Artists } from "../globals/artists.slint";
import { GenreDetail, Genres } from "../globals/genres.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { PlaylistDetail, Playlists } from "../globals/playlists.slint";
import { Tracks } from "../globals/tracks.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { GridGeometry } from "../components/grid-geometry.slint";
import { LibraryTabBand } from "../components/hero/library-tab-band.slint";
import { Tooltip, TooltipSide } from "../components/tooltip.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { MyLibrarySongsTab } from "my-library/songs-tab.slint";
import { MyLibraryAlbumsTab } from "my-library/albums-tab.slint";
import { MyLibraryArtistsTab } from "my-library/artists-tab.slint";
import { MyLibraryGenresTab } from "my-library/genres-tab.slint";
import { MyLibraryPlaylistsTab } from "my-library/playlists-tab.slint";
import { MyLibraryTabPills } from "my-library/tab-pills.slint";
import { AlbumDetailBody } from "my-library/album-detail.slint";
import { ArtistDetailBody } from "my-library/artist-detail.slint";
import { GenreDetailBody } from "my-library/genre-detail.slint";
import { PlaylistDetailBody } from "my-library/playlist-detail.slint";

// My Library: five tabs over the views that used to be five sidebar entries. This file is
// the mount sheet — the band, the grid geometry the four card tabs share, which body is on
// screen, and the two tooltip frames the band and the pills publish anchors for.
//
// **The tab index is what routes, not the detail id.** `seed_detail_from_settings` runs
// for all four detail views at boot whichever section is restored, so more than one
// `*Detail.*-id` can be `>= 0` at once; splitting on the id alone would mount two.
export component MyLibraryView inherits Rectangle {
    // Bumped by the band's `SearchBar`, settled 130 ms later — the list-view shape, where
    // the cost being debounced is a model rebuild in Rust rather than Slint's own
    // re-evaluation.
    property <int> filter-tick-pending;

    // **Which of the nine branches is mounted, spelled once.** The body router, the band's
    // hero facts and the pill rows all read these, because a divergence between any two of
    // them paints one entity's banner over another's list. Private here rather than on
    // `MyLibrary`: a binding belongs to the scope it is written in, so deriving it on the
    // global would make `my-library.slint` the second globals file to import siblings.
    property <bool> album-open:
        MyLibrary.tab-idx == MyLibrary.tab-albums && AlbumDetail.album-id >= 0;
    property <bool> artist-open:
        MyLibrary.tab-idx == MyLibrary.tab-artists && ArtistDetail.artist-id >= 0;
    property <bool> genre-open:
        MyLibrary.tab-idx == MyLibrary.tab-genres && GenreDetail.genre-id >= 0;
    property <bool> playlist-open:
        MyLibrary.tab-idx == MyLibrary.tab-playlists && PlaylistDetail.playlist-id >= 0;
    property <bool> detail-open:
        root.album-open || root.artist-open || root.genre-open || root.playlist-open;

    // **The arm the band's *hero half* paints, held for the length of the collapse.** The
    // four above flip on the frame the detail id clears, and that is the frame the exit
    // morph starts — so every hero ternary below would fall through to whichever sibling
    // global sits in its last arm and the band would spend 400 ms collapsing a placeholder
    // tile, an empty title and `has-blur: false` instead of the banner it is collapsing
    // *from*. These lag by exactly one close. Each is seeded by its binding and owned by
    // its handler (`hero-t`'s idiom, and `LibraryTabBand` re-states why): the write orphans
    // the binding, and the seed is what leaves a page entered straight onto a detail — a
    // boot resuming one — already painting it.
    //
    // The guard is `detail-open` and not the arm's own value, which is what makes a
    // cross-tab drill move them: Album → Artist keeps a detail open throughout, so both
    // writes land, where a close leaves all four where they were.
    property <bool> hero-album: root.album-open;
    property <bool> hero-artist: root.artist-open;
    property <bool> hero-genre: root.genre-open;
    property <bool> hero-playlist: root.playlist-open;

    // **All four on every latch, never one.** Each is written only from here, so a handler
    // touching its own arm alone leaves the other three holding whatever the last drill put
    // there — and the ternaries below test them in order, so a stale `hero-album` outranks
    // the arm that is actually open for the rest of the page mount. Open an album, leave the
    // tab (the guard holds all four, correctly, because no detail is open on that frame),
    // then open a playlist: only `hero-playlist` moved, and the band paints the album's
    // title over the playlist's body. Latching the set is what makes "the arm the hero
    // paints" a single answer rather than four that can disagree.
    function latch-hero() {
        self.hero-album = root.album-open;
        self.hero-artist = root.artist-open;
        self.hero-genre = root.genre-open;
        self.hero-playlist = root.playlist-open;
    }

    // **The seed has to be a *write*, and that is what this line is for.** A declared
    // binding is live until something assigns over it, and the only assignment is
    // `latch-hero`, guarded on `detail-open` — which is false on exactly the frame a close
    // needs the hold. So a view mounted with a detail *already* open has never written, and
    // the first back follows `album-open` to false through the binding: the whole collapse
    // plays out over the last ternary arm, which is the failure the latch exists to
    // prevent. The band's own `hero-t` doesn't need this because its handler is unguarded
    // and takes ownership on that same first close. Reachable on any re-entry, since the
    // content-area `if` rebuilds this view and hands it fresh bindings — drill in, sidebar
    // away, sidebar back, press back — and on a boot resuming a detail. `init` runs after
    // the bindings resolve, so it writes the values they just produced and nothing moves.
    init => { root.latch-hero(); }

    changed album-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed artist-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed genre-open => {
        if (root.detail-open) { root.latch-hero(); }
    }
    changed playlist-open => {
        if (root.detail-open) { root.latch-hero(); }
    }

    // **The scope the page's one filter box describes changed.** Rust reseats the box from
    // whichever surface is now mounted: a drill-in finds the detail's needle already
    // cleared, a back out finds the grid's own still there — so the box can't read empty
    // over a grid that is still filtered, or hold a grid needle over an unfiltered detail.
    // Mirrors rather than `changed AlbumDetail.album-id`, which Slint rejects on a global.
    property <int> watched-album-id: AlbumDetail.album-id;
    changed watched-album-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-artist-id: ArtistDetail.artist-id;
    changed watched-artist-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-genre-id: GenreDetail.genre-id;
    changed watched-genre-id => { MyLibrary.detail-scope-changed(); }
    property <int> watched-playlist-id: PlaylistDetail.playlist-id;
    changed watched-playlist-id => { MyLibrary.detail-scope-changed(); }

    // **A tab move is the other way the surface under the box changes.** The two paths that
    // take it — a cross-tab drill and a Mouse-4/5 walk — go through `persist-tab-idx` rather
    // than `tab-changed`, precisely so they don't clear a filter the user is walking back
    // into; and a *pick* clears only the entering tab's needle, so the departing one keeps
    // its own. Without a reseat here, walking back into a tab you had filtered re-fetches it
    // through that untouched needle under an empty box. A pick is unaffected: it clears both
    // sides before the change-tracker pass runs, so `sync_box` finds them equal and bails.
    property <int> watched-tab-idx: MyLibrary.tab-idx;
    changed watched-tab-idx => { MyLibrary.detail-scope-changed(); }

    // A click anywhere the band or a body doesn't claim gives the filter box up.
    TouchArea {
        clicked => { MyLibrary.blur-search-tick += 1; }
    }

    FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { MyLibrary.filter-changed(MyLibrary.filter); }
    }

    // Shared by all four card tabs — mutually exclusive, same card shape, so one
    // derivation covers them. Measured off the body, whose width the layout fixes
    // independently of the cards inside it.
    //
    // The gutter is the host's choice, so it lives here and is handed to both the
    // geometry and the grids — an `in` property isn't readable back from outside the
    // component declaring it.
    property <length> grid-gap: 20px;

    geom := GridGeometry {
        avail-width: body.width;
        gap: root.grid-gap;
    }

    // **The count goes to all four, the re-chunk only to the tab on screen.** Writing all
    // four is what stops an unmounted grid entering at a stale column count — its fetch
    // reads the property, not the callback. Invoking only the mounted one is what stops a
    // resize rebuilding three models nobody is looking at. The gate is the tab and not
    // the detail id: a detail closing has to find its grid already chunked to fit.
    GridColumnsSync {
        computed-cols: geom.cols;
        seed(c) => {
            Albums.columns = c;
            Artists.columns = c;
            Genres.columns = c;
            Playlists.columns = c;
            if (MyLibrary.tab-idx == MyLibrary.tab-albums) { Albums.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-artists) { Artists.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-genres) { Genres.columns-changed(c); }
            if (MyLibrary.tab-idx == MyLibrary.tab-playlists) {
                Playlists.columns-changed(c);
            }
        }
    }

    VerticalLayout {
        band := LibraryTabBand {
            // Inline literals: `@tr` folds msgids at codegen, so a Rust-seeded `[string]`
            // renders untranslated. Order matches `MyLibrary.tab-*`.
            tab-labels: [@tr("Songs"), @tr("Albums"), @tr("Artists"), @tr("Genres"), @tr("Playlists")];
            tab-icons: ["music_note", "album", "person", "theater_comedy", "playlist_play"];
            tab-idx <=> MyLibrary.tab-idx;
            tab-selected(i) => {
                // **The direction goes through `Nav`, not straight from the band.** The
                // band has already settled `tab-enter-from` by the time this fires, but
                // binding the bodies to it would leave the *other* two ways a body
                // mounts — a drill in, a back out — sliding whichever way the last tab
                // pick went. `Nav.pending-enter-from` is what `nav_transition::mark`
                // writes for those, so routing the pick through it keeps one source of
                // truth for all nine branches.
                Nav.pending-enter-from = band.tab-enter-from;
                MyLibrary.tab-changed(i);
            }

            filter <=> MyLibrary.filter;
            blur-tick: MyLibrary.blur-search-tick;
            search-edited(t) => { root.filter-tick-pending += 1; }

            // **Every count is `>= 0`-guarded**, and that is not optional: all five hold
            // `ui::tab_bar::UNFETCHED_COUNT` until fetched and again after a tab leave,
            // and a bare `-1` interpolates into the plural as "-1 albums".
            count-text:
                MyLibrary.tab-idx == MyLibrary.tab-songs
                    ? (Tracks.total-count >= 0
                        ? @tr("{n} song" | "{n} songs" % Tracks.total-count) : "")
                : MyLibrary.tab-idx == MyLibrary.tab-albums
                    ? (Albums.total-count >= 0
                        ? @tr("{n} album" | "{n} albums" % Albums.total-count) : "")
                : MyLibrary.tab-idx == MyLibrary.tab-artists
                    ? (Artists.total-count >= 0
                        ? @tr("{n} artist" | "{n} artists" % Artists.total-count) : "")
                : MyLibrary.tab-idx == MyLibrary.tab-genres
                    ? (Genres.total-count >= 0
                        ? @tr("{n} genre" | "{n} genres" % Genres.total-count) : "")
                : (Playlists.total-count >= 0
                    ? @tr("{n} playlist" | "{n} playlists" % Playlists.total-count) : "");

            // A detail's own list comes first, so the drill-in states what the box now
            // filters. Artist Detail is the one that filters two things at once.
            filter-placeholder:
                root.artist-open ? @tr("Filter tracks & albums…")
                : root.detail-open ? @tr("Filter tracks…")
                : MyLibrary.tab-idx == MyLibrary.tab-songs ? @tr("Filter tracks…")
                : MyLibrary.tab-idx == MyLibrary.tab-albums ? @tr("Filter albums…")
                : MyLibrary.tab-idx == MyLibrary.tab-artists ? @tr("Filter artists…")
                : MyLibrary.tab-idx == MyLibrary.tab-genres ? @tr("Filter genres…")
                : @tr("Filter playlists…");

            // --- The hero half -----------------------------------------------
            //
            // The band morphs into the open detail's banner rather than a second one
            // appearing under it, so every fact below is a four-arm ternary over the
            // predicates above and none of the four bodies owns a title, a tile or a
            // chip strip any more.
            //
            // **The hero facts read `hero-*`, everything else reads `*-open`.** Which
            // banner is painted has to survive the id clear or the collapse plays out over
            // a placeholder; which body is mounted, which pills are shown and what the
            // filter box now describes must not.
            detail-open: root.detail-open;
            back-clicked => { MyLibrary.back(); }
            // The teardown the band's collapse defers — see its `hero-collapsed`.
            hero-collapsed => { MyLibrary.hero-collapsed(); }

            title:
                root.hero-album ? AlbumDetail.album.name
                : root.hero-artist ? ArtistDetail.artist.name
                : root.hero-genre ? GenreDetail.genre.name
                : PlaylistDetail.playlist.name;
            // Album's artist and Playlist's description; the other two heroes state
            // nothing under the title and the band collapses the row on "".
            subtitle:
                root.hero-album ? AlbumDetail.album.artist_name
                : root.hero-playlist ? PlaylistDetail.playlist.description
                : "";
            title-badge: root.hero-playlist && PlaylistDetail.playlist.is_smart;

            artwork-path:
                root.hero-album ? AlbumDetail.album.artwork_path
                : root.hero-artist ? ArtistDetail.artist.image_path
                : root.hero-playlist ? PlaylistDetail.playlist.artwork_path
                : "";
            // Genre Detail owns no cover, and Slint has no empty-`image` literal to fall
            // through to — so the band gates on `artwork-path` instead, which is `""` on
            // that arm. See its `has-cover`.
            cover:
                root.hero-album ? AlbumDetail.cover
                : root.hero-artist ? ArtistDetail.cover
                : PlaylistDetail.cover;
            circular-artwork: root.hero-artist;
            fallback-icon:
                root.hero-album ? "album"
                : root.hero-artist ? "person"
                : root.hero-genre ? "theater_comedy"
                : "playlist";
            // Genres have no intrinsic image, so the tile paints from the two name-hashed
            // stops on the row and matches the grid card exactly — genre recognition
            // survives the drill-in. The wide backdrop is the *dimmer* pair, written into
            // `HeroBackdrop.floor-*` by Rust's `open_genre`, which measures it and solves
            // the scrim and foreground against it as an artwork-bearing detail does.
            tile-bg: root.hero-genre
                ? @linear-gradient(135deg,
                    GenreDetail.genre.tile_color_1,
                    GenreDetail.genre.tile_color_2)
                : HeroBackdrop.chrome.with-alpha(0.15);
            tile-icon-color: root.hero-genre
                ? #ffffff.with-alpha(0.3)
                : HeroBackdrop.chrome;

            // **`has-blur` is the gate, not the slot.** `GenreDetail` declares no blur
            // quartet at all, and Slint has no empty-`image` literal to fall through to —
            // so the Genre arm lands on a sibling's slot and `HeroBlurBackdrop` paints
            // only its gradient floor, which is exactly what a procedural backdrop wants.
            // Don't "fix" this by requiring the quartet of every detail.
            blur-a:
                root.hero-artist ? ArtistDetail.blur-img-a
                : root.hero-playlist ? PlaylistDetail.blur-img-a
                : AlbumDetail.blur-img-a;
            blur-b:
                root.hero-artist ? ArtistDetail.blur-img-b
                : root.hero-playlist ? PlaylistDetail.blur-img-b
                : AlbumDetail.blur-img-b;
            use-a:
                root.hero-artist ? ArtistDetail.blur-use-a
                : root.hero-playlist ? PlaylistDetail.blur-use-a
                : AlbumDetail.blur-use-a;
            has-blur:
                root.hero-album ? AlbumDetail.has-blur
                : root.hero-artist ? ArtistDetail.has-blur
                : root.hero-playlist ? PlaylistDetail.has-blur
                : false;

            // The band's `@children` slot, in one piece. See `tab-pills.slint` for why
            // the nine rows are a component instead of nine `if`s written here; the
            // predicates come from this sheet so the pills and the body can't disagree
            // about which branch is up.
            pills := MyLibraryTabPills {
                album-open: root.album-open;
                artist-open: root.artist-open;
                genre-open: root.genre-open;
                playlist-open: root.playlist-open;
            }
        }

        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // **A tab body slides, a detail body doesn't gate.** `tab-anim-armed` starts
            // false and only a bar pick arms it, so the page's own fade-up isn't
            // compounded with a horizontal slide — the two together read as a diagonal.
            if MyLibrary.tab-idx == MyLibrary.tab-songs: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                enabled: band.tab-anim-armed;
                MyLibrarySongsTab { width: 100%; height: 100%; }
            }
            // Each grid tab swaps grid ↔ detail on the predicate above, -1 being the
            // grid — the same split these four had while they were separate sidebar
            // sections, now stated once so the band and the pills follow it too.
            if MyLibrary.tab-idx == MyLibrary.tab-albums && !root.album-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                enabled: band.tab-anim-armed;
                MyLibraryAlbumsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.album-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                AlbumDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-artists && !root.artist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                enabled: band.tab-anim-armed;
                MyLibraryArtistsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.artist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                ArtistDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-genres && !root.genre-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                enabled: band.tab-anim-armed;
                MyLibraryGenresTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.genre-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                GenreDetailBody { width: 100%; height: 100%; }
            }
            if MyLibrary.tab-idx == MyLibrary.tab-playlists && !root.playlist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                enabled: band.tab-anim-armed;
                MyLibraryPlaylistsTab {
                    width: 100%;
                    height: 100%;
                    card-w: geom.card-w;
                    card-h: geom.card-h;
                    row-h: geom.row-h;
                    gap: root.grid-gap;
                }
            }
            if root.playlist-open: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: Nav.pending-enter-from;
                PlaylistDetailBody { width: 100%; height: 100%; }
            }
        }
    }

    // Both frames are on a layer of their own, and for one reason: their hosts sit in the
    // band, and Slint paints in declaration order, so anything the band owns is covered by
    // the body underneath. Each publishes the rect it derives from the hovered element, so
    // a tab or a pill that moves under a parked pointer keeps its tooltip anchored.
    tab-tip := Rectangle {
        x: band.absolute-position.x - root.absolute-position.x + band.tip-x;
        y: band.absolute-position.y - root.absolute-position.y + band.tip-y;
        width: band.tip-w;
        height: band.tip-h;
        Tooltip {
            text: band.tip-label;
            hovered: band.tip-visible;
            host-width: tab-tip.width;
            host-height: tab-tip.height;
            side: TooltipSide.below;
        }
    }

    header-tip := Rectangle {
        x: pills.absolute-position.x - root.absolute-position.x + pills.tip-x;
        y: pills.absolute-position.y - root.absolute-position.y + pills.tip-y;
        width: pills.tip-w;
        height: pills.tip-h;
        Tooltip {
            text: pills.tip-label;
            hovered: pills.tip-visible;
            host-width: header-tip.width;
            host-height: header-tip.height;
            side: TooltipSide.below;
        }
    }
}
