import { Theme } from "../theme.slint";

// Tiny utility component: fires `close()` exactly once each time the OS
// window transitions to unfocused. The local `watched-focused` mirror is
// needed because `changed` doesn't accept path expressions on globals.
//
// Mount inside a popup body wrapped in an `if popup-is-open` block:
//
//     if PopupHighlight.id == "overflow": FocusLossWatcher {
//         close => { pop.close(); PopupHighlight.id = ""; }
//     }
//
// Slint instantiates `if` children lazily — so the watcher only exists
// while the popup is actually shown. This collapses what used to be
// O(visible-rows) bindings firing on every focus loss (mass-instantiated
// track-list rows, several singleton popups) into a single live watcher
// for the one popup that is currently open. Per CLAUDE.md's "PopupWindow
// auto-dismiss on OS focus loss" convention.
export component FocusLossWatcher {
    callback close();
    property <bool> watched-focused: Theme.window-focused;
    changed watched-focused => {
        if (!self.watched-focused) {
            root.close();
        }
    }
}
