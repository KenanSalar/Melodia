import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { TrackListRow } from "../../models.slint";
import { TrackListHeader } from "track-list-header.slint";
import { TrackListRowItem } from "track-list-row.slint";

// Reusable, globals-free track table. Wraps the column header + a
// virtualized list body inside a horizontal ScrollView (so growing columns
// past the visible width pans the table). The component itself reads no
// globals.
//
// Overlay scrollbars are NOT mounted inside this component — viewport
// metrics are exposed via the `v-*` / `h-*` out properties and the
// `set-v-viewport-y` / `set-h-viewport-x` callbacks so the host can mount
// `OverlayScrollbar`s at its own root and have them sit flush against the
// outer panel's rounded edges (instead of inside whatever padding the host
// applies to TrackList).
//
// Embedded by every view that needs a track table (Tracks, Browse, Search,
// Favorites, Recently Played, and the Album / Artist / Genre / Playlist
// detail pages), each owning its own column state and persistence.
//
// Property contract:
//   * `rows`            — the model to render. Back it with
//                          `Rc<VecModel<TrackListRow>>` so the host can swap
//                          via `set_rows(ModelRc::from(...))`.
//   * `w-*` / `show-*`  — per-column width and visibility. `in-out` so a
//                          resize drag or a column-toggle popup writes host
//                          state synchronously.
//   * `sort-field` /
//     `sort-dir`        — drive the header chevron. Pure inputs; clicking a
//                          header fires `request-sort`.
//   * `playing-track-id`— this row's cells flip to accent. Usually bound to
//                          `Player.vm.track.id`, but the component imports no
//                          globals, so it stays reusable outside player
//                          contexts.
//
// Callbacks fire on user actions; the host is expected to dispatch them to
// the appropriate `library::*` function via a tokio runtime spawn, then
// push fresh data back through `rows`.
export component TrackList inherits Rectangle {
    in property <[TrackListRow]> rows;

    // Column widths.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Column visibility. `show-artwork` is a pseudo-toggle that controls
    // only the small thumbnail inside the title cell, not a column.
    in-out property <bool> show-number: true;
    in-out property <bool> show-artwork: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;

    // Number-column mode — forwarded to every row. `"index"` (default)
    // shows the 1-based row position; `"track_number"` shows the row's
    // real album track number (Album Detail).
    in property <string> number-mode: "index";

    // Sort indicator (passive; the host owns the actual sort state).
    in property <string> sort-field;
    in property <string> sort-dir;

    // Now-playing highlight.
    in property <int> playing-track-id;

    // Cumulative table width: padding + sum(visible column widths) +
    // (N_visible − 1) × handle-width. Handles are 8 px (= Theme.pad-sm).
    // Title and length are always visible, so the floor is 2 visible
    // columns + 1 handle. The outer horizontal ScrollView reads this to
    // decide whether to pan.
    out property <length> total-w: 16px /* L+R padding */
        + (root.show-number ? root.w-number + 8px : 0px)
        + root.w-title + 8px
        + (root.show-artist ? root.w-artist + 8px : 0px)
        + (root.show-album ? root.w-album + 8px : 0px)
        + (root.show-genre ? root.w-genre + 8px : 0px)
        + (root.show-year ? root.w-year + 8px : 0px)
        + root.w-length;

    callback request-sort(string /*field*/);
    callback play-row(int /*track_id*/, int /*index*/);
    // Batch-shaped — single-row mode emits a 1-element array, multi-
    // select mode emits the entire view selection. Hosts forward
    // straight to their per-view Rust callback.
    callback play-next([int]);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback request-blur-search();
    // Cross-tab navigation from the row's context menu — host wires
    // these to `albums_ui_mod::open_album_with` / equivalents in Rust.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Per-view context for the right-click menu (see TrackListRowItem
    // for the value vocabulary). Plumbed straight through to every row.
    in property <string> view-context;
    in property <int> current-playlist-id: 0;
    in property <[int]> view-selected-ids;

    // Viewport metrics for host-mounted overlay scrollbars. The host reads
    // these to drive its `OverlayScrollbar`s and writes back through the
    // `set-*` callbacks. Slint can't take a `<=>` two-way binding through a
    // sign flip, and inner ids (`inner-list`, `outer-scroll`) aren't
    // visible at the host's scope, so the property+callback pair is the
    // canonical pattern. Sign convention: positive `v-offset` /
    // `h-offset` means "scrolled by N pixels"; the inner ScrollView/ListView
    // store the same as a non-positive `viewport-y` / `viewport-x`, so we
    // negate at the boundary.
    //
    // The host also reads `body-y` to align the vertical bar with the
    // ListView body (skipping the 32 px column header band). It's relative
    // to TrackList's own root.
    out property <length> v-visible-height: inner-list.visible-height;
    out property <length> v-viewport-height: inner-list.viewport-height;
    out property <length> v-offset: -inner-list.viewport-y;
    out property <length> body-y: inner-list.absolute-position.y - root.absolute-position.y;
    out property <length> body-height: inner-list.height;

    out property <length> h-visible-width: outer-scroll.visible-width;
    out property <length> h-viewport-width: outer-scroll.viewport-width;
    out property <length> h-offset: -outer-scroll.viewport-x;

    callback set-v-offset(length);
    callback set-h-offset(length);

    set-v-offset(o) => { inner-list.viewport-y = -o; }
    set-h-offset(o) => { outer-scroll.viewport-x = -o; }

    // Horizontal scroll container. Header + list inside have a total width
    // of `total-w`; if that exceeds the visible width, this ScrollView
    // handles horizontal panning. Vertical scrolling stays on the inner
    // ListView (which keeps its virtualization). `viewport-height:
    // self.height` locks the outer's vertical viewport to its own height
    // so it doesn't try to scroll vertically too — the inner ListView owns
    // that axis.
    //
    // Both built-in scrollbars are hidden (`always-off`) because they ride
    // along with the scrolled content and end up offscreen when columns
    // overflow horizontally. The host mounts custom `OverlayScrollbar`s at
    // its own root and binds them to the `v-*` / `h-*` out properties /
    // `set-*` callbacks above so the bars sit flush with the outer panel
    // edges instead of with TrackList's (potentially padded) edges.
    outer-scroll := ScrollView {
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        viewport-height: self.height;

        VerticalLayout {
            spacing: Theme.pad-xs;

            TrackListHeader {
                w-number <=> root.w-number;
                w-title <=> root.w-title;
                w-artist <=> root.w-artist;
                w-album <=> root.w-album;
                w-genre <=> root.w-genre;
                w-year <=> root.w-year;
                w-length <=> root.w-length;
                show-number: root.show-number;
                show-artist: root.show-artist;
                show-album: root.show-album;
                show-genre: root.show-genre;
                show-year: root.show-year;
                total-w: root.total-w;
                sort-field: root.sort-field;
                sort-dir: root.sort-dir;
                sort-clicked(f) => { root.request-sort(f); }
            }

            inner-list := ListView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: always-off;
                width: root.total-w;
                for r[idx] in root.rows: TrackListRowItem {
                    row-data: r;
                    row-index: idx;
                    // Neighbour-selection lookup — drives the per-corner
                    // radius gating in TrackListRowItem so contiguous
                    // selected rows merge into one continuous pill.
                    prev-selected: idx > 0 && root.rows[idx - 1].selected;
                    next-selected: idx < root.rows.length - 1 && root.rows[idx + 1].selected;
                    w-number: root.w-number;
                    w-title: root.w-title;
                    w-artist: root.w-artist;
                    w-album: root.w-album;
                    w-genre: root.w-genre;
                    w-year: root.w-year;
                    w-length: root.w-length;
                    show-number: root.show-number;
                    show-artwork: root.show-artwork;
                    show-artist: root.show-artist;
                    show-album: root.show-album;
                    show-genre: root.show-genre;
                    show-year: root.show-year;
                    number-mode: root.number-mode;
                    sort-field: root.sort-field;
                    sort-dir: root.sort-dir;
                    row-count: root.rows.length;
                    total-w: root.total-w;
                    playing-track-id: root.playing-track-id;
                    view-context: root.view-context;
                    current-playlist-id: root.current-playlist-id;
                    view-selected-ids: root.view-selected-ids;
                    double-clicked-row => { root.play-row(r.id, idx); }
                    toggle-favorite => { root.toggle-row-favorite([r.id], !r.is_favorite); }
                    play-row(id, i) => { root.play-row(id, i); }
                    play-next(ids) => { root.play-next(ids); }
                    add-to-queue(ids) => { root.add-to-queue(ids); }
                    toggle-row-favorite(ids, on) => { root.toggle-row-favorite(ids, on); }
                    set-row-rating(ids, n) => { root.set-row-rating(ids, n); }
                    select-row(i, id, sh, ct) => { root.select-row(i, id, sh, ct); }
                    request-blur-search => { root.request-blur-search(); }
                    go-to-album(aid) => { root.go-to-album(aid); }
                    go-to-artist(aid) => { root.go-to-artist(aid); }
                    go-to-genre(gid) => { root.go-to-genre(gid); }
                }
            }
        }
    }

}
