import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// Column-divider drag handle. 8 px wide so it doubles as the visual gap
// between cells (matches `Theme.pad-sm`, the body row's `spacing`). A 1 px
// vertical line sits in the middle, always visible at `Theme.border`,
// brightening to `Theme.surface1` on hover and `Theme.accent` while
// dragging — same hierarchy as Tauri's `var(--ctp-border)` →
// `var(--ctp-surface1)`.
//
// Behaviour: pure NATURAL drag — drag right grows the target column,
// drag left shrinks it. Other columns are NOT touched (this is the
// GTK-TreeView "FIXED" sizing model, not Tauri's flex-with-cap). When the
// user grows columns past the visible area, the wrapping horizontal
// ScrollView in the parent view picks up the overflow and renders its
// scrollbar; when they shrink past container width, trailing whitespace
// appears on the right.
//
// Uses absolute coords (`absolute-position.x + mouse-x`) instead of local
// coords so the handle doesn't trail the cursor as the cell it lives in
// resizes — see the "Drag handles inside the resized element" pitfall in
// CLAUDE.md.
component ResizeHandle inherits Rectangle {
    in property <length> start-w;
    in property <length> min-w;
    in property <length> max-w;

    callback resized(length);

    property <length> press-w: 0px;
    property <length> press-abs-x: 0px;

    width: Theme.pad-sm;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: touch.pressed
            ? Theme.accent
            : (touch.has-hover ? Theme.surface1 : Theme.border);
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    }

    touch := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-w = root.start-w;
                root.press-abs-x = self.absolute-position.x + self.pressed-x;
            }
        }
        moved => {
            if (self.pressed) {
                root.resized(clamp(
                    root.press-w + (self.absolute-position.x + self.mouse-x - root.press-abs-x),
                    root.min-w, root.max-w
                ));
            }
        }
    }
}

// Sortable column-header cell. `field` is the value passed up via the
// `clicked` callback ("title", "artist", "album", "genre", "year",
// "length", "track_number"). The active column shows an `arrow_drop_*`
// chevron driven by `active-field` + `active-dir` inputs.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> field;
    in property <bool> right-aligned;
    in property <string> active-field;
    in property <string> active-dir;

    callback clicked();

    // Don't set `height: 100%` — Slint resolves that as a binding to parent
    // height, which combined with TrackListHeader's `min-height` creates a
    // circular dependency the layout solver resolves to unbounded space.
    // Min-height keeps the cell tall enough; layout fills cross-axis.
    min-height: 32px;
    clip: true;
    background: touch.has-hover ? Theme.surface1 : transparent;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    border-radius: Theme.radius-md;

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: 2px;
        alignment: root.right-aligned ? end : start;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active-field == root.field ? Theme.accent : Theme.subtext0;
                font-size: Theme.font-size-sm;
                font-weight: 600;
                overflow: elide;
            }
        }
        if root.active-field == root.field: VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.active-dir == "asc" ? "arrow_drop_up" : "arrow_drop_down";
                icon-size: 16px;
                icon-color: Theme.accent;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Column-header row. Width is fixed at the cumulative sum of column widths
// + padding + handle widths (computed by the parent and passed in via
// `total-w`). Sits inside a horizontal ScrollView that supplies the
// scrollbar when `total-w` exceeds the container.
//
// Layout: `spacing: 0` so the 8 px-wide ResizeHandles BETWEEN cells supply
// the visual gap that matches the body row's `spacing: Theme.pad-sm`. That
// keeps header and row cells in lockstep — same cumulative x positions.
//
// Resize semantics: every divider drives the column on its LEFT with
// NATURAL drag. Drag right = that column grows; drag left = it shrinks.
// No other column is touched. Total table width changes accordingly.
//
// Per-column min/max ranges are generous because horizontal overflow is
// supported via the wrapping ScrollView.
//
// Globals-free: takes column widths, visibility, and active-sort fields as
// in-out / in properties. Mutating `w-*` in resize callbacks updates the
// caller's bound state directly via `<=>`. Clicking a column emits
// `sort-clicked(field)` for the host to forward to Rust.
export component TrackListHeader inherits Rectangle {
    // Per-column visible widths.
    in-out property <length> w-number;
    in-out property <length> w-title;
    in-out property <length> w-artist;
    in-out property <length> w-album;
    in-out property <length> w-genre;
    in-out property <length> w-year;
    in-out property <length> w-length;

    // Per-column visibility. Title and length are always visible.
    in property <bool> show-number;
    in property <bool> show-artist;
    in property <bool> show-album;
    in property <bool> show-genre;
    in property <bool> show-year;

    // Cumulative width — bound by the parent (TrackList) so header and rows
    // share the same total width source of truth.
    in property <length> total-w;

    // Active sort indicator state.
    in property <string> sort-field;
    in property <string> sort-dir;

    callback sort-clicked(string /*field*/);

    // `height: 32px` would be a binding the layout solver may treat as
    // preferred. `min-height` + `max-height` pins the row size in a way the
    // VerticalLayout solver respects (matches Slint's built-in `ListItem`
    // pattern in widgets/fluent/components.slint).
    min-height: 32px;
    max-height: 32px;
    vertical-stretch: 0;
    width: root.total-w;
    background: Theme.base;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: 0;

        // Each toggleable column owns its TRAILING ResizeHandle, both gated
        // on the same `show-*` flag. Title and length are unconditional
        // (locked). Length has no trailing handle. Using `if … : <Cell>` —
        // not `visible` — so hidden columns vacate layout space (Slint's
        // `visible: false` keeps the cell in the layout tree).
        if root.show-number: HeaderCell {
            width: root.w-number;
            label: "#";
            field: "track_number";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        if root.show-number: ResizeHandle {
            start-w: root.w-number;
            min-w: 40px;
            max-w: 200px;
            resized(w) => { root.w-number = w; }
        }

        HeaderCell {
            width: root.w-title;
            label: @tr("Title");
            field: "title";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        ResizeHandle {
            start-w: root.w-title;
            min-w: 150px;
            max-w: 1000px;
            resized(w) => { root.w-title = w; }
        }

        if root.show-artist: HeaderCell {
            width: root.w-artist;
            label: @tr("Artist");
            field: "artist";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        if root.show-artist: ResizeHandle {
            start-w: root.w-artist;
            min-w: 60px;
            max-w: 1000px;
            resized(w) => { root.w-artist = w; }
        }

        if root.show-album: HeaderCell {
            width: root.w-album;
            label: @tr("Album");
            field: "album";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        if root.show-album: ResizeHandle {
            start-w: root.w-album;
            min-w: 60px;
            max-w: 1000px;
            resized(w) => { root.w-album = w; }
        }

        if root.show-genre: HeaderCell {
            width: root.w-genre;
            label: @tr("Genre");
            field: "genre";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        if root.show-genre: ResizeHandle {
            start-w: root.w-genre;
            min-w: 60px;
            max-w: 1000px;
            resized(w) => { root.w-genre = w; }
        }

        if root.show-year: HeaderCell {
            width: root.w-year;
            label: @tr("Year");
            field: "year";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        if root.show-year: ResizeHandle {
            start-w: root.w-year;
            min-w: 50px;
            max-w: 200px;
            resized(w) => { root.w-year = w; }
        }

        HeaderCell {
            width: root.w-length;
            label: @tr("Length");
            field: "length";
            active-field: root.sort-field;
            active-dir: root.sort-dir;
            clicked => { root.sort-clicked(self.field); }
        }
        // No handle after Length — it's the last column. (Length is still
        // resizable via its own min/max; Audacious leaves the last column
        // without a handle too.)
    }
}
