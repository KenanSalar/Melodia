import { Theme } from "../../theme.slint";
import { PopupHighlight } from "../../globals.slint";
import { PillButton } from "../action-pill.slint";
import { Checkbox } from "../checkbox.slint";
import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";

// Single row inside the column-toggle popup. Reads its checked state from
// the matching `show-*` flag passed in via `checked` and reports clicks via
// `toggled()`. Locked entries (Title, Length) render dimmed and don't fire
// the callback.
component ColumnToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> locked;

    callback toggled();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: !root.locked && touch.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 100ms; easing: ease-in-out; }
    opacity: root.locked ? 0.5 : 1.0;

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Checkbox { checked: root.checked; }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-size-md;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.locked ? default : pointer;
        // Row release keeps the popup open (toggles don't close the
        // ColumnTogglePopup), so restore the trigger highlight that the
        // winit Release filter just cleared.
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up
                || ev.kind == PointerEventKind.cancel) {
                PopupHighlight.id = "columns";
            }
        }
        clicked => {
            if (!root.locked) { root.toggled(); }
        }
    }
}

// Column-toggle popup: a `tune` IconButton that opens a PopupWindow listing
// every column with a checkbox-style toggle. Mirrors the volume-popup
// pattern: right-aligned PopupWindow, `close-on-click-outside`, opacity
// fade-in entry animation.
//
// Globals-free: takes the six `show-*` flags as in-out properties (so the
// host's bound state flips synchronously for instant UI feedback) and emits
// `toggled(column-id)` so the host can persist the new visible-column list
// to settings under its own per-view key. Locked rows (Title, Length) match
// the Tauri parity table; they appear in the menu so the user can see why
// they can't be hidden, but don't react to clicks.
export component ColumnTogglePopup inherits Rectangle {
    in-out property <bool> show-number;
    in-out property <bool> show-artwork;
    in-out property <bool> show-artist;
    in-out property <bool> show-album;
    in-out property <bool> show-genre;
    in-out property <bool> show-year;

    // Drop the Album row entirely for hosts where the column is meaningless
    // (Album Detail: every row is the same album).
    in property <bool> hide-album: false;
    // Drop the Artist row entirely for hosts where the column is meaningless
    // (Artist Detail: every row is the same artist).
    in property <bool> hide-artist: false;
    // Drop the Genre row entirely for hosts where the column is meaningless
    // (Genre Detail: every row is the same genre).
    in property <bool> hide-genre: false;

    // Hover tooltip on the trigger button. Defaults to "Columns"; a host
    // can pass `""` to suppress it.
    in property <string> tooltip-text: @tr("Columns");

    callback toggled(string /*column_id*/);

    // Outer width tracks the PillButton's content width; height is
    // fixed to the 32 px pill row so the popup anchors below the chip's
    // bottom edge regardless of inner button alignment.
    width: btn.width;
    height: 32px;

    // Same chrome as the queue-sheet pill buttons — `PillButton` handles
    // the 32 px outer, 28 px visible chrome, hover fill (Theme.surface1),
    // and the renderer-aware glyph baseline correction. `icon-size: 18`
    // grows the tune glyph for the primary tracks-header action (the
    // default 14 px reads too thin at this prominence).
    btn := PillButton {
        icon: "tune";
        icon-size: 18px;
        tooltip-text: root.tooltip-text;
        // Keep the chrome highlighted while the popup is open. Cleared by
        // the AppWindow scrim catching an outside click — rows inside the
        // popup don't auto-close (the popup stays open across toggles by
        // design), so there's no per-row id reset.
        force-bg: PopupHighlight.id == "columns";
        clicked => { PopupHighlight.id = "columns"; pop.show(); }
    }

    pop := PopupWindow {
        // Right-align under the button, 8 px gap below — same cadence as
        // the volume popup's vertical offset, but here the popup hangs
        // BELOW because the trigger sits in the page header.
        //
        // Slint's `place_popup` clamps a PopupWindow's right edge to the
        // window's clip region, which on a page-edge trigger overrides any
        // negative-x offset we set here (we'd just be claiming space the
        // clamp eats back). To get visible breathing room from the window
        // edge, the wrapper HorizontalLayout below reserves `pad-lg` of
        // transparent margin on the right of the popup itself — so even
        // when the popup's bounding box gets clamped flush, the visible
        // chrome stops `pad-lg` short of it.
        x: btn.width - self.width;
        // Anchor 8 px below the bottom of the 32 px outer (which the
        // button now centres inside via the VerticalLayout wrap), so the
        // popup hangs the same distance below the trigger regardless of
        // the inner button's positioning.
        y: root.height + 8px;
        close-policy: close-on-click-outside;

        // Live only while this popup is the one currently open — the
        // trigger sets `PopupHighlight.id = "columns"` before `pop.show()`,
        // and the winit Release path clears it back to "". One watcher
        // per focus-loss instead of one per popup-host component instance.
        if PopupHighlight.id == "columns": FocusLossWatcher {
            close => { pop.close(); PopupHighlight.id = ""; }
        }

        HorizontalLayout {
            padding-right: Theme.pad-lg;
            alignment: start;

            chrome := PopupSurface {
                VerticalLayout {
                    padding: Theme.pad-xs;
                    spacing: 0;

                ColumnToggleRow {
                    // `#` is a numeric column glyph, not a word — left as-is.
                    label: "#";
                    checked: root.show-number;
                    toggled => {
                        root.show-number = !root.show-number;
                        root.toggled("number");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Artwork");
                    checked: root.show-artwork;
                    toggled => {
                        root.show-artwork = !root.show-artwork;
                        root.toggled("artwork");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Title");
                    checked: true;
                    locked: true;
                }
                if !root.hide-artist: ColumnToggleRow {
                    label: @tr("Artist");
                    checked: root.show-artist;
                    toggled => {
                        root.show-artist = !root.show-artist;
                        root.toggled("artist");
                    }
                }
                if !root.hide-album: ColumnToggleRow {
                    label: @tr("Album");
                    checked: root.show-album;
                    toggled => {
                        root.show-album = !root.show-album;
                        root.toggled("album");
                    }
                }
                if !root.hide-genre: ColumnToggleRow {
                    label: @tr("Genre");
                    checked: root.show-genre;
                    toggled => {
                        root.show-genre = !root.show-genre;
                        root.toggled("genre");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Year");
                    checked: root.show-year;
                    toggled => {
                        root.show-year = !root.show-year;
                        root.toggled("year");
                    }
                }
                ColumnToggleRow {
                    label: @tr("Length");
                    checked: true;
                    locked: true;
                }
                }
            }
        }
    }
}
