import { Theme } from "../theme.slint";

// One blob of the aurora: album colour at a point, thinning out across the surface.
//
// **Radial, not linear.** Alpha-blending linear ramps composites to something still linear in
// position, so a stack of them keeps straight parallel contours — an earlier pass banded into
// diagonal stripes and read as ramps rather than as anything blurred.
//
// **Two stops, the far one this tint at zero alpha — never the `transparent` keyword.** FemtoVG
// interpolates stops in straight RGBA, so fading to rgba(0,0,0,0) drags the colour toward black and
// the blob darkens instead of thinning.
component AuroraBlob inherits Rectangle {
    in property <color> tint;

    // Alpha at the centre. The blob tints the base rather than lighting it — near opaque it stops
    // being album colour over a dark floor and becomes a lightness ramp.
    in property <float> peak;

    in property <bool> shown: true;

    // **Gone by 70%, which is what lets a blob be local.** Slint's radius is the half-diagonal, so
    // running the ramp to the corner leaves ~0.3 of peak where the rectangle ends, which draws as a
    // straight seam. Reaching zero just inside frees the rect from covering the host at all — no
    // set of colours can be seen at once if every one of them covers the whole surface.
    //
    // Both arms one type at one stop count, the only shape `Brush::interpolate` blends
    // stop-for-stop. Safe to `animate` where a leaf's brush usually isn't: Rust writes the tint
    // discretely, so no host can restart the binding.
    background: root.shown
        ? @radial-gradient(circle, root.tint.transparentize(1.0 - root.peak) 0%, root.tint.transparentize(1.0) 70%)
        : @radial-gradient(circle, root.tint.transparentize(1.0) 0%, root.tint.transparentize(1.0) 70%);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }
}

// The artwork-derived backdrop: four broad blobs of album colour over the theme's own base, and a
// grain of noise. Bounded rather than pinned — `ui::backdrop::wash_cap` holds the composite inside
// the band where the theme's own ink stays legible, so the foreground over this is `Theme.*` and
// the surface follows the variant's polarity.
//
// **Every colour is an input and the defaults are never taken** — `MetaChip`'s idiom. They exist
// so this file imports no global: one mount reads the `Player` tier and the others `HeroBackdrop`,
// and naming either would tie the component to one. **`base-start` / `base-end` carry `Theme.base`
// and `Theme.mantle` and still may not read them here**: the tier is what `MosaicHeroTile` fills
// its square from, so a component reaching past it is how the square and the surface under it
// start disagreeing.
export component AuroraBackdrop inherits Rectangle {
    in property <color> base-start: #2b2135;
    in property <color> base-end: #14101a;
    in property <color> tint-1: #3a2d4a;
    in property <color> tint-2: #2d3a4a;
    in property <color> tint-3: #4a2d3a;
    in property <color> tint-4: #2d4a3a;

    // Grain over everything below; `ui::aurora::dither_tile` argues it. An unset image draws
    // nothing, so a mount without one degrades to undithered gradients rather than to a hole.
    in property <image> dither;

    // Whether the host paints a hero at all. The mosaic bands always do and take the default;
    // `LibraryTabBand` morphs, and its globals outlive the tab that filled them, so an ungated
    // layer would ease out of a banner nobody has seen. **Discrete bool** — a leaf can't tell an
    // eased input from a stepped one, and a `hero-t` float would restart every binding per frame.
    in property <bool> hero-open: true;

    clip: true;

    // Slint's radial gradient owns neither centre nor radius: always a circle in the middle of its
    // element, radius the half-diagonal. Position and spread are therefore the rect's, and it stays
    // square — the circle would otherwise expose only the first fifth of its ramp on the short axis
    // and read as a band.
    //
    // Length arithmetic has no squares, hence the round trip through `1px`.
    property <length> host-diagonal: Math.sqrt((root.width / 1px) * (root.width / 1px)
        + (root.height / 1px) * (root.height / 1px)) * 1px;

    // **1/√2 of the diagonal, where this was fractions of each axis.** Those put all four centres
    // inside the element with the reach floored on the *short* one, so every ramp covered every
    // pixel and four vivid washes averaged to one flat tone whatever the record was. Over half the
    // diagonal so the middle still isn't a hole — each ramp reaches the centre at under a third of
    // its peak, which is Amberol's coverage there. `ui::aurora::REACH_FRACTION` mirrors it, what
    // the composite covers being what the foreground is solved against.
    property <length> blob-reach: root.host-diagonal * 0.7071;

    // `AuroraBlob`'s ramp dies at 0.495 of its side, so this is the side that paints `blob-reach`.
    property <length> blob-span: root.blob-reach / 0.495;

    background: root.hero-open
        ? @linear-gradient(135deg, root.base-start, root.base-end)
        : @linear-gradient(135deg, transparent, transparent);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    // **Round the rectangle, not down a list** — top-left, top-right, bottom-right, bottom-left.
    // Rust hands the washes over in hue-wheel order (`ui::aurora::around_the_wheel`) and four
    // corners are a cycle as the wheel is, so the pairs meeting along an edge are hue neighbours
    // rather than complements compositing toward grey; the diagonal pairs never meet at all.
    //
    // Peaks descend with the ranking so the colour the artwork most is leads, but only just: the
    // usual 60/30/10 has the dominant showing through everywhere the four overlap, and that advice
    // is about *area*, which the geometry above already gives each of them.
    // `ui::aurora::BLOB_PEAKS` mirrors them, the peak tone being derived from what they cover.
    AuroraBlob {
        x: -root.blob-span / 2;
        y: -root.blob-span / 2;
        width: root.blob-span;
        height: root.blob-span;
        tint: root.tint-1;
        peak: 0.5;
        shown: root.hero-open;
    }
    AuroraBlob {
        x: root.width - root.blob-span / 2;
        y: -root.blob-span / 2;
        width: root.blob-span;
        height: root.blob-span;
        tint: root.tint-2;
        peak: 0.46;
        shown: root.hero-open;
    }
    AuroraBlob {
        x: root.width - root.blob-span / 2;
        y: root.height - root.blob-span / 2;
        width: root.blob-span;
        height: root.blob-span;
        tint: root.tint-3;
        peak: 0.42;
        shown: root.hero-open;
    }
    AuroraBlob {
        x: -root.blob-span / 2;
        y: root.height - root.blob-span / 2;
        width: root.blob-span;
        height: root.blob-span;
        tint: root.tint-4;
        peak: 0.38;
        shown: root.hero-open;
    }

    // **`image-fit: preserve` is what makes this dither rather than decoration**: the default `fill`
    // scales the tile before tiling it, turning one texel into a block tens of pixels across. Only
    // `preserve` maps a source texel to a physical pixel, the frequency dither has to run at to
    // disappear; `pixelated` so filtering can't average it back toward the flat colour it breaks up.
    // Alpha lives in the tile rather than in `opacity`, which would rasterize this into a layer.
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.dither;
        image-fit: ImageFit.preserve;
        image-rendering: ImageRendering.pixelated;
        horizontal-tiling: ImageTiling.repeat;
        vertical-tiling: ImageTiling.repeat;
    }
}
