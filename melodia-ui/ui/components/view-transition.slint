import { Theme } from "../theme.slint";
import { NavEnterFrom } from "../globals/nav.slint";

// Enter-only wrapper, re-instantiated on every branch mount so the flip and the
// animation replay per nav. There is no exit half — Slint's `if` destroys the
// outgoing view instantly. `enter-from` picks the axis: `below` for sidebar nav,
// `right` for drilling into a detail, `left` for coming back out.
//
// **A single-shot Timer, not `init`.** `init` runs *after* bindings resolve to
// their final values, so flipping `shown` there makes `true` the initial value —
// no from-state to interpolate, and the view appears instantly. The Timer fires
// once the first `shown: false` frame has painted, so the flip is a real change
// and the `animate` blocks engage.
export component ViewTransition inherits Rectangle {
    in property <NavEnterFrom> enter-from: NavEnterFrom.below;
    // Off, the view is simply *there* — no fade, no slide, nothing to interrupt.
    //
    // It exists for the nested case: Favorites wraps each tab body in one of
    // these, inside the page's own enter transition, so on the mount frame both
    // would play and a horizontal tab slide composed with the page's fade-up
    // reads as a diagonal. The host arms it on the first real tab pick.
    in property <bool> enabled: true;
    private property <bool> shown: false;
    // Disabled, this is `true` from the first evaluation, so the three bindings
    // below never transition and the Timer's flip is a write nothing reads.
    private property <bool> settled: !root.enabled || root.shown;

    Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            root.shown = true;
        }
    }

    opacity: settled ? 1.0 : 0.0;
    x: settled ? 0px : (enter-from == NavEnterFrom.right ? 32px
                      : enter-from == NavEnterFrom.left  ? -32px : 0px);
    y: settled ? 0px : (enter-from == NavEnterFrom.below ? 32px : 0px);

    animate opacity { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate x       { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate y       { duration: Theme.dur-spatial; easing: cubic-bezier(0.2, 0, 0, 1); }
}
