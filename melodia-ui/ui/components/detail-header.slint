import { Theme } from "../theme.slint";
import { ArtworkImage } from "artwork-image.slint";
import { HeroBlurBackdrop } from "hero-blur-backdrop.slint";
import { IconButton } from "icon-button.slint";

// Reusable large-artwork detail header — Album Detail today; Artist /
// Playlist detail as they land. The component owns the chrome only:
//
//   * Full-bleed hero blur backdrop (two-slot cross-fade, mirroring
//     `now-playing-view.slint`'s `Player.blur-img-{a,b}` pattern — the
//     outgoing slot stays painted for the whole fade so album switches
//     never flash).
//   * Accent-tinted gradient floor underneath the blurs; soft scrim on top
//     to keep foreground text legible.
//   * Floating back button at the top-left.
//   * The left-side artwork tile.
//
// Everything inside the right column is `@children` — the caller composes
// title / subtitle / meta / actions and pins them top/bottom via
// `vertical-stretch` on each injected child (e.g. a trailing spacer with
// `vertical-stretch: 1` to push the action row to the artwork's lower
// edge). Slint only supports one `@children` per component, so this is
// the slot through which the entire right column is supplied.
export component DetailHeader inherits Rectangle {
    in property <string> artwork-path;
    in property <image>  cover;
    in property <length> artwork-size: 200px;
    in property <image>  hero-blur-a;
    in property <image>  hero-blur-b;
    in property <bool>   hero-blur-use-a;
    in property <bool>   has-hero-blur;
    // Circular hero artwork — used by Artist Detail to render the artist
    // avatar as a disc (Tauri parity).
    in property <bool>   circular-artwork: false;
    // Forwarded to the inner `ArtworkImage.fallback-icon`. Artist Detail
    // passes `"person"`; every other entity detail takes the default.
    in property <string> fallback-icon: "music-note";

    // The two colours making up the full-bleed hero gradient floor.
    // Albums / Artists keep the default `Theme.accent.mix(Theme.base,
    // 0.2)` → `Theme.base` look; Genre Detail passes the pre-computed
    // `hero_color_1` / `hero_color_2` stops from `GenreRow` (hashed
    // name → four-stop accent in `src/ui/genres/color.rs`) so each
    // genre's hero matches the gradient on its grid card. Kept as two
    // explicit colours rather than a `brush` so the caller can supply
    // any color expression (theme mix, raw `color`, `hsv(...)`, …) and
    // the gradient is composed here in one place.
    in property <color> hero-tint-start: Theme.accent.mix(Theme.base, 0.2);
    in property <color> hero-tint-end:   Theme.base;

    // Forwarded to the inner `ArtworkImage.tile-bg` / `tile-icon-color`
    // for the left-side artwork tile when no `cover` is supplied. Same
    // story as `EntityCard`: callers that paint a custom fallback chrome
    // (Genre Detail's hash-derived gradient + white glyph) override
    // these; defaults fall through to `ArtworkImage`'s `Theme.accent`-
    // tinted defaults.
    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;

    callback back-clicked();

    height: layout.preferred-height;
    clip: true;

    // --- Hero blur backdrop (full-bleed, behind everything) ----------
    // Shared component: tint gradient floor (always painted; shows
    // through when `has-hero-blur` is false) + the dual-slot crossfade
    // + crust scrim. Caller-overridable via `hero-tint-start` /
    // `hero-tint-end`.
    HeroBlurBackdrop {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        blur-a: root.hero-blur-a;
        blur-b: root.hero-blur-b;
        use-a: root.hero-blur-use-a;
        has-blur: root.has-hero-blur;
        tint-start: root.hero-tint-start;
        tint-end: root.hero-tint-end;
    }

    // --- Content -----------------------------------------------------
    layout := HorizontalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-lg;
        alignment: stretch;

        // Artwork tile — fixed-size, anchored to the top-left so it
        // does not stretch with the row height.
        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            ArtworkImage {
                artwork-path: root.artwork-path;
                cover: root.cover;
                tile-size: root.artwork-size;
                tile-radius: root.circular-artwork
                    ? root.artwork-size / 2
                    : Theme.radius-lg;
                fallback-icon: root.fallback-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
            }
        }

        // Right column — caller fully controls placement of children.
        // Typical pattern (see `album-detail-view.slint`):
        //     Text { /* title */ ; vertical-stretch: 0; }
        //     Text { /* subtitle */ ; vertical-stretch: 0; }
        //     Text { /* meta */ ; vertical-stretch: 0; }
        //     Rectangle { vertical-stretch: 1; }     // spacer
        //     HorizontalLayout { /* actions */ ; vertical-stretch: 0; }
        // The trailing spacer absorbs the slack between the title block
        // and the action row so the row sits flush with the artwork's
        // lower edge — title at top, pills at bottom.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: stretch;
            spacing: Theme.pad-xs;

            @children
        }
    }

    // Floating back button — absolutely positioned at the header's
    // top-left, mirrors Tauri's `floatingBackButton`. Lives outside the
    // HL so it doesn't take a row of its own. Idle chrome is the shared
    // `Theme.floating-button-bg` (translucent surface0 disc) so the
    // button reads as a real affordance against the hero blur;
    // `IconButton`'s hover state paints solid `Theme.surface0`, so the
    // transition still animates from soft → solid.
    IconButton {
        x: Theme.pad-md;
        y: Theme.pad-md;
        icon: "arrow_back";
        icon-size: 20px;
        diameter: 32px;
        idle-bg: Theme.floating-button-bg;
        clicked => { root.back-clicked(); }
    }
}
