import { Theme } from "../theme.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { ArtworkImage } from "artwork-image.slint";
import { HeroBlurBackdrop } from "hero-blur-backdrop.slint";
import { IconButton } from "icon-button.slint";

// The large-artwork header all four detail views share. **It owns the chrome only**: the
// full-bleed hero blur, its solved floor and scrim, the floating back button and the
// left-side artwork tile.
//
// **Text injected into the right column must read `HeroBackdrop`, never `Theme.*`** — it
// paints straight onto that backdrop, which is pinned dark under every theme, where the
// theme brushes land light-on-light on a light variant.
//
// The whole right column arrives through `@children`: the caller composes it and pins
// its parts with `vertical-stretch`, typically a trailing spacer pushing the action row
// to the artwork's lower edge. Slint allows one `@children` per component, so that slot
// is the entire column.
export component DetailHeader inherits Rectangle {
    in property <string> artwork-path;
    in property <image>  cover;
    in property <image>  hero-blur-a;
    in property <image>  hero-blur-b;
    in property <bool>   hero-blur-use-a;
    in property <bool>   has-hero-blur;
    // Artist Detail's disc.
    in property <bool>   circular-artwork: false;
    // Artist Detail passes `"person"`; every other detail takes the default.
    in property <string> fallback-icon: "music-note";

    // The tile's fallback chrome, overridden by Genre Detail's hash-derived gradient.
    // **The defaults take the solved `HeroBackdrop.chrome`, not `Theme.accent`**: this
    // tile sits *on* the hero, and a light theme's accent is dark — it would land
    // dark-on-dark there.
    in property <brush> tile-bg: HeroBackdrop.chrome.with-alpha(0.15);
    in property <brush> tile-icon-color: HeroBackdrop.chrome;

    callback back-clicked();

    height: layout.preferred-height;
    clip: true;

    // The shared component: gradient floor, dual-slot crossfade, scrim. Every colour it
    // paints comes off `HeroBackdrop`, so there is nothing to forward.
    HeroBlurBackdrop {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        blur-a: root.hero-blur-a;
        blur-b: root.hero-blur-b;
        use-a: root.hero-blur-use-a;
        has-blur: root.has-hero-blur;
    }

    layout := HorizontalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-lg;
        alignment: stretch;

        // Top-left anchored, so it doesn't stretch with the row height. **Sized straight
        // off `Theme.hero-artwork` rather than through an `in property`**: the six heroes
        // are one band, and a per-view knob is how they drifted apart before.
        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            ArtworkImage {
                artwork-path: root.artwork-path;
                cover: root.cover;
                tile-size: Theme.hero-artwork;
                tile-radius: root.circular-artwork
                    ? Theme.hero-artwork / 2
                    : Theme.radius-lg;
                fallback-icon: root.fallback-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
            }
        }

        // The caller controls placement entirely: pin each child with
        // `vertical-stretch: 0` and let a trailing stretch spacer absorb the slack, so
        // the title sits at the top and the action row flush with the tile's lower edge.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: stretch;
            spacing: Theme.pad-xs;

            @children
        }
    }

    // Absolutely positioned, outside the layout so it takes no row of its own. Its idle
    // chrome is the near-opaque shared disc, so the glyph contrasts against `surface0`
    // rather than against whatever the hero happens to be — and the residual
    // translucency is what keeps the hover swap to solid visible as a transition.
    IconButton {
        x: Theme.pad-md;
        y: Theme.pad-md;
        icon: "arrow_back";
        icon-size: 20px;
        diameter: 32px;
        idle-bg: Theme.floating-chrome-bg;
        clicked => { root.back-clicked(); }
    }
}
