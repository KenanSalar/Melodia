import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// One tab in a SettingsTabBar. Lives in this file (not exported) because
// it's only useful as a child of the bar.
//
// The selected treatment deliberately mirrors a selected sidebar row — a
// raised fill with an accent icon at FILL=1 and a weight-600 label — rather
// than the accent-filled `Chip` used by the ChipGroups *inside* the settings
// rows. The bar navigates; the chips configure. Reading as two different
// things is the point.
component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool>   selected;
    // Icon-only mode. The label is dropped rather than elided so five tabs
    // still fit once the content panel drops below the page's width clamp.
    in property <bool>   compact;

    callback clicked();
    // Hover in/out, so the bar can hand the host what it needs to draw the
    // compact-mode tooltip on a layer of its own. Mirrored into a local
    // property because `changed` won't take `touch.has-hover` directly.
    callback hover-changed(bool);

    height: 36px;
    horizontal-stretch: 0;

    property <length> glyph-size: 22px;
    // Compact tabs are squares: pad the glyph out to the tab's own height and
    // the width follows from the content, with nothing to pin.
    property <length> compact-pad: (root.height - root.glyph-size) / 2;

    border-radius: Theme.radius-md;
    // One rung per state up the standard surface ladder, no derived alphas:
    // the `surface0` track shows through at rest, hover lifts to `surface1`
    // and the selected tab sits a rung above that at `surface2`. Same
    // resting→hover step a `Chip` takes, so the two read as one family.
    background: root.selected
        ? Theme.surface2
        : (touch.has-hover ? Theme.surface1 : transparent);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: root.compact ? root.compact-pad : Theme.pad-md;
        padding-right: root.compact ? root.compact-pad : Theme.pad-md;
        spacing: Theme.pad-sm;
        alignment: center;

        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: root.glyph-size;
                icon-color: root.selected ? Theme.accent : Theme.text;
                filled: root.selected;
            }
        }

        if !root.compact: VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                // Full-strength on every tab, unlike a sidebar row's
                // `subtext0` resting label: these five are the page's primary
                // navigation and all of them stay legible. Weight, fill and
                // the accent icon carry the selected state on their own.
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: root.selected ? 600 : 500;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> is-hovered: touch.has-hover;
    changed is-hovered => { root.hover-changed(root.is-hovered); }
}

// Segmented tab bar for the Settings page. Data-agnostic — it takes parallel
// label/icon arrays and reports the picked index, in the same shape as
// ChipGroup / Dropdown / ColorDotGrid, and knows nothing about which tabs
// exist.
//
// `labels` must arrive as an inline `[@tr("…"), …]` literal at the call site:
// `@tr` registers msgids at codegen, so an array populated from Rust would
// render untranslated.
export component SettingsTabBar inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> icons;
    in property <bool> compact;
    // Two-way, per the "components that write their own in-out property
    // orphan a one-way binding" pitfall.
    in-out property <int> selected-index;

    callback selected(int);

    // The hovered tab's window rect and label, republished for the host to
    // hang a tooltip off. The tooltip itself can't live on the tab: it anchors
    // *below* the bar, the bar sits in the page header, and Slint paints in
    // declaration order — so anything the header owns is covered by the scroll
    // body underneath it. `playlists-view.slint`'s `header-tip` is the same
    // arrangement for the same reason.
    //
    // Unlike that one, the rect is a **snapshot** taken on hover-enter rather
    // than a live binding — a `for` loop gives the host no per-tab element to
    // read a position off. So a tab that moves under a parked pointer (Ctrl+B,
    // F11) keeps its old anchor until the pointer leaves and returns.
    out property <bool> tip-shown;
    out property <length> tip-x;
    out property <length> tip-y;
    out property <length> tip-w;
    out property <length> tip-h;
    out property <string> tip-text;
    // Which tab the live tip belongs to. Its *index*, not its label: the bar
    // is data-agnostic, so nothing stops a caller passing two tabs the same
    // text.
    property <int> tip-idx: -1;

    // Track. No `clip` — a rounded clip over text renders the subtree to an
    // offscreen layer and upscales it on HiDPI. The tabs are inset by the
    // padding and carry their own smaller radius, so nothing needs clipping.
    height: 44px;
    horizontal-stretch: 0;
    background: Theme.surface0;
    border-radius: Theme.radius-lg;

    HorizontalLayout {
        padding: Theme.pad-xs;
        spacing: Theme.pad-xs;
        alignment: start;

        for tab-label[i] in root.labels: SettingsTab {
            label: tab-label;
            icon: root.icons[i];
            selected: i == root.selected-index;
            compact: root.compact;
            clicked => {
                root.selected-index = i;
                root.selected(i);
            }
            hover-changed(hovered) => {
                if (hovered) {
                    root.tip-x = self.absolute-position.x;
                    root.tip-y = self.absolute-position.y;
                    root.tip-w = self.width;
                    root.tip-h = self.height;
                    root.tip-text = tab-label;
                    root.tip-idx = i;
                    root.tip-shown = true;
                } else if (root.tip-idx == i) {
                    // Only the tab that owns the tooltip may retract it — a
                    // leave arriving after the neighbour's enter would
                    // otherwise blank a live one.
                    root.tip-shown = false;
                }
            }
        }
    }
}
