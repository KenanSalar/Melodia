import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { MaterialIcon } from "../material-icon.slint";

// `SettingRow`'s stacked twin, for the rows whose control is a strip that sits
// *under* the description rather than to its right. `disabled` uses the same
// overlay TouchArea.
export component SettingRowStacked inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    in property <bool>   disabled: false;

    // `setting-row.slint`'s split, for its reason: the copy dims through its brushes so
    // no layer crops the glyphs, and only the `@children` strip spends `opacity`.
    property <float> dim: root.disabled ? Theme.dim-disabled : 0.0;
    animate dim { duration: Theme.dur-fast; easing: ease-in-out; }

    background: transparent;

    HorizontalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-lg;
        alignment: stretch;

        // Top-aligned so it sits beside the label, not centred in a row whose
        // height includes the strip below.
        VerticalLayout {
            alignment: start;
            // Lines the icon up with the label's baseline rather than the row's
            // top padding.
            padding-top: 2px;
            // `SettingsPage.row-content-w` subtracts this to tell the strips
            // below how much room they have, so the number lives there.
            MaterialIcon {
                name: root.icon;
                icon-size: SettingsPage.row-icon-w;
                icon-color: Theme.text;
                fade: 1.0 - root.dim;
            }
        }

        VerticalLayout {
            spacing: Theme.pad-xs;
            horizontal-stretch: 1;

            // Wrapped for `setting-row.slint`'s reason: a no-wrap `Text`'s
            // minimum is its full width, which no narrowing can negotiate.
            Text {
                text: root.label;
                color: Theme.text.transparentize(root.dim);
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-muted.transparentize(root.dim);
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }

            // The margin is what reads as a break between the copy and the strip.
            Rectangle {
                background: transparent;
                vertical-stretch: 0;
                VerticalLayout {
                    padding-top: Theme.pad-sm;
                    spacing: Theme.pad-sm;
                    opacity: 1.0 - root.dim;
                    @children
                }
            }
        }
    }

    if root.disabled: TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
    }
}
