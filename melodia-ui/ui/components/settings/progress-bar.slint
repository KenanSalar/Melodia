import { Theme } from "../../theme.slint";

// Thin (4 px) progress bar used by the Library scan status row and the
// Update download row. `value` is 0..1; the fill width is animated so the
// bar slides smoothly when the host updates the value.
export component ProgressBar inherits Rectangle {
    in property <float> value;

    height: 4px;
    border-radius: self.height / 2;
    background: Theme.surface1;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate width { duration: Theme.dur-fast; easing: ease-in-out; }
    }
}
