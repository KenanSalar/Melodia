import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";

// One pill-shaped chip in a ChipGroup. Lives in this file (not exported)
// because it's only useful as a child of ChipGroup.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool>   selected;

    callback clicked();

    height: 32px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.selected
        ? Theme.accent
        : (touch.has-hover ? Theme.surface2 : Theme.surface1);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.selected ? Theme.accent-text : Theme.text;
            font-size: Theme.font-size-sm;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pill-chip selector. Clicking a chip writes `selected-index` and emits
// `selected(idx)` — the host can react to the change for any side effects.
//
// Slint 1.16's `HorizontalLayout` doesn't wrap and there is no `Flow`, so the
// group lays itself out as a column of rows: it decides how many chips fit on
// a line, `SettingsPage.chunk-indices` splits the options into index groups of
// that size, and each group becomes one `HorizontalLayout`. Iterating real
// arrays both times is what keeps this simple — the predecessor was a
// hand-unrolled 4+4 split capped at eight chips, written that way because
// Slint rejects an inline `for … : if …` and a `Rectangle` wrapper around a
// filtered-out chip still claims its parent layout's spacing. Neither trap is
// reachable from here.
export component ChipGroup inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    // When false (default), a click writes `selected-index = i` locally
    // before emitting `selected(i)` — fine for callers that two-way
    // `<=>`-bind selected-index to a global property (Theme, Variant,
    // Accent, Color Style chips). When true, the click only emits
    // `selected(i)` and leaves `selected-index` untouched — required
    // for callers whose `selected-index` is a derived expression
    // (e.g. AppearanceSection's `px-to-preset(corner-radius-px)` for
    // the Window Corner Radius row), where a local self-write would
    // orphan the one-way binding (CLAUDE.md "Components that write to
    // their own `in-out property` orphan a one-way binding" pitfall).
    in property <bool> manual: false;
    // How much room the group has to fill. Defaults to the settings body's
    // own answer, so every call site inside a settings row says nothing;
    // override it anywhere the group doesn't span a full card row. Same shape
    // as `SettingsTabBar`'s `avail-width` — the host owns the width, the
    // component owns the verdict.
    in property <length> avail-width: SettingsPage.row-content-w;

    callback selected(int);

    // The widest chip, measured rather than estimated: a hidden ruler mounts
    // one **real** `Chip` per option, so the measured shape and the drawn
    // shape can't drift, and a `VerticalLayout` reports the *max* of its
    // children's widths, which is exactly what "widest" means. Same idiom, and
    // the same `visible: false` (which lowers to a 0×0 clip and still computes
    // layout info), as `settings-tab-bar.slint`'s ruler.
    //
    // Sizing every row off the widest chip is deliberately conservative — the
    // chips themselves keep their natural widths, so a row is never full, but
    // it also can never overflow, and no per-chip measurement has to leave the
    // repeater. The labels are translated, so this follows the running locale
    // for free.
    measure := VerticalLayout {
        visible: false;
        for option in root.options: Chip {
            label: option;
        }
    }
    property <length> chip-w: measure.preferred-width;
    property <int> per-row: max(1, Math.floor(
        (root.avail-width + Theme.pad-sm) / (root.chip-w + Theme.pad-sm)));
    property <int> row-count: Math.ceil(root.options.length / root.per-row);

    // `min-width` is pinned rather than derived, and it is what makes the
    // wrap worth anything: left to the children it merges in the hidden
    // ruler's width, so the widest chip becomes a floor the card can't shrink
    // past — the exact incompressibility this lays itself out to avoid.
    min-width: 0px;
    horizontal-stretch: 0;
    height: max(0px,
        root.row-count * 32px + (root.row-count - 1) * Theme.pad-sm);

    VerticalLayout {
        spacing: Theme.pad-sm;

        for row in SettingsPage.chunk-indices(root.options.length, root.per-row):
            HorizontalLayout {
                spacing: Theme.pad-sm;
                alignment: start;

                for idx in row: Chip {
                    label: root.options[idx];
                    selected: idx == root.selected-index;
                    clicked => {
                        if (!root.manual) {
                            root.selected-index = idx;
                        }
                        root.selected(idx);
                    }
                }
            }
    }
}
