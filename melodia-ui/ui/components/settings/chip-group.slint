import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";

// One pill in a `ChipGroup`. Unexported — it's useful nowhere else.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool>   selected;

    callback clicked();

    height: 32px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.selected
        ? Theme.accent
        : (touch.has-hover ? Theme.surface2 : Theme.surface1);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.selected ? Theme.accent-text : Theme.text;
            font-size: Theme.font-size-sm;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pill-chip selector. A click writes `selected-index` and emits `selected(idx)`.
//
// Slint 1.16 has no wrapping layout and no `Flow`, so the group lays itself out
// as a column of rows: it decides how many chips fit on a line and
// `SettingsPage.chunk-indices` splits the options into index groups of that
// size, each one a `HorizontalLayout`. Iterating real arrays both times is what
// keeps it simple — the predecessor was a hand-unrolled 4+4 split capped at
// eight chips, written that way because Slint rejects an inline `for … : if …`
// and a wrapper around a filtered-out chip still claims its parent's spacing.
export component ChipGroup inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected-index;
    // Off by default: a click writes `selected-index` before emitting, which
    // suits any caller `<=>`-binding it to a global. On, the click only emits —
    // required where `selected-index` is a *derived* expression, since a
    // self-write would orphan that one-way binding.
    in property <bool> manual: false;
    // Defaults to the settings body's own answer, so a call site inside a
    // settings row says nothing; override it anywhere the group doesn't span a
    // full card row. The `TabBar` shape — host owns the width, component owns
    // the verdict.
    in property <length> avail-width: SettingsPage.row-content-w;

    callback selected(int);

    // The widest chip, measured rather than estimated: a hidden ruler mounts one
    // **real** `Chip` per option, so the measured and the drawn shape can't
    // drift, and a `VerticalLayout` reports the max of its children's widths —
    // which is what "widest" means. Same idiom, and the same `visible: false`
    // (a 0×0 clip that still computes layout info), as `tab-bar.slint`'s ruler.
    //
    // Sizing every row off the widest is deliberately conservative: the chips
    // keep their natural widths, so a row is never full but can never overflow,
    // and no per-chip measurement has to escape the repeater. The labels are
    // translated, so it follows the running locale for free.
    measure := VerticalLayout {
        visible: false;
        for option in root.options: Chip {
            label: option;
        }
    }
    property <length> chip-w: measure.preferred-width;
    property <int> per-row:
        SettingsPage.wrap-per-row(root.avail-width, root.chip-w, Theme.pad-sm);

    // Pinned rather than derived, and it is what makes the wrap worth anything:
    // left to the children it merges in the hidden ruler's width, so the widest
    // chip becomes a floor the card can't shrink past — the exact
    // incompressibility this lays itself out to avoid.
    min-width: 0px;
    horizontal-stretch: 0;
    height: SettingsPage.wrap-height(root.options.length, root.per-row, 32px, Theme.pad-sm);

    VerticalLayout {
        spacing: Theme.pad-sm;

        for row in SettingsPage.chunk-indices(root.options.length, root.per-row):
            HorizontalLayout {
                spacing: Theme.pad-sm;
                alignment: start;

                for idx in row: Chip {
                    label: root.options[idx];
                    selected: idx == root.selected-index;
                    clicked => {
                        if (!root.manual) {
                            root.selected-index = idx;
                        }
                        root.selected(idx);
                    }
                }
            }
    }
}
