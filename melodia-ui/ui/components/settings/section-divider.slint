import { Theme } from "../../theme.slint";

// 1 px horizontal rule used between rows inside a SectionCard, with a 16 px
// inset on each side so the line stops short of the card's rounded edges
// (Tauri parity: `.divider` rule on the settings page).
export component SectionDivider inherits Rectangle {
    height: 1px;
    background: transparent;

    Rectangle {
        x: Theme.pad-lg;
        y: 0;
        width: parent.width - 2 * Theme.pad-lg;
        height: 1px;
        background: Theme.surface2;
    }
}
