import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { Tooltip, TooltipSide } from "../tooltip.slint";

// One color swatch in a ColorDotGrid. 32 px button; the active swatch
// gets a 2 px ring in `text` colour so it stays legible regardless of
// which palette the grid hosts. A tooltip pill anchored above the dot
// reveals `label` on 500 ms hover dwell.
//
// `is-dynamic: true` renders a rounded-square (radius-md) instead of a
// circle. Used to mark the Material You swatch as visually distinct
// from the 8 static palette accents — the shape difference reads at a
// glance without relying on tooltip dwell.
component ColorDot inherits Rectangle {
    in property <brush> swatch;
    in property <bool>  selected;
    in property <bool>  is-dynamic;
    in property <string> label;
    // Which edge the tooltip clears. Rows after the first point downward —
    // anchored above, a second-row swatch's pill lands on the row of dots
    // over it.
    in property <TooltipSide> tip-side: TooltipSide.above;

    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: root.is-dynamic ? Theme.radius-md : self.width / 2;
    background: root.swatch;
    border-color: root.selected ? Theme.text : transparent;
    border-width: 4px;
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; }

    // Subtle hover scale via a 1 px outer ring (Slint has no transform/scale
    // on Rectangle in 1.16, so a coloured ring stands in for the hover lift).
    // Ring radius follows the dot's shape so the squircle stays a squircle on hover.
    if touch.has-hover && !root.selected: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: root.is-dynamic ? Theme.radius-md + 2px : self.width / 2;
        border-color: Theme.surface2;
        border-width: 1px;
        background: transparent;
    }

    Tooltip {
        text: root.label;
        hovered: touch.has-hover;
        host-width: parent.width;
        side: root.tip-side;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Grid of color swatches. Each entry in `colors` becomes a 32 px dot;
// clicking one writes `selected-index` and emits `selected(idx)`.
// `labels` is read by index alongside `colors` so each dot can show a
// tooltip naming the accent ("Material You", "Mauve", "Blue", …).
//
// It wraps, and it has to: Catppuccin ships fourteen accents, fifteen with
// Material You prepended, so a single row was 592 px of incompressible width
// and the widest thing on the settings page by some margin. The dots are a
// fixed size, so unlike `ChipGroup` this needs no ruler — how many fit is
// straight arithmetic, and `SettingsPage.chunk-indices` splits the swatches
// into rows of that many.
//
// `first-is-dynamic: true` marks index 0 as a dynamic swatch (rendered
// as a rounded square instead of a circle). The host wires this from
// `Settings.material-you-active`; the invariant that Material You is
// always prepended at index 0 when active lives in
// `src/ui/appearance/accent_picker.rs::accent_swatches_with_my`.
export component ColorDotGrid inherits Rectangle {
    in property <[brush]> colors;
    in property <[string]> labels;
    in property <bool> first-is-dynamic;
    in-out property <int> selected-index;
    // See `ChipGroup.avail-width` — same contract, same default.
    in property <length> avail-width: SettingsPage.row-content-w;

    callback selected(int);

    // 36 px is the dot's cell, 4 px taller than the dot so the selection ring
    // isn't clipped against the row edge.
    property <length> cell-h: 36px;
    // No ruler needed, unlike `ChipGroup`: the dot is a fixed 32 px, so the
    // count is arithmetic. Both take the same two `SettingsPage` helpers.
    property <int> per-row: SettingsPage.wrap-per-row(root.avail-width, 32px, Theme.pad-sm);

    horizontal-stretch: 0;
    height: SettingsPage.wrap-height(root.colors.length, root.per-row, root.cell-h, Theme.pad-sm);

    VerticalLayout {
        spacing: Theme.pad-sm;

        for row[r] in SettingsPage.chunk-indices(root.colors.length, root.per-row):
            HorizontalLayout {
                spacing: Theme.pad-sm;
                // Match Tauri's `.accentGrid` (flex row, default start-edge
                // alignment).
                alignment: start;

                for i in row: VerticalLayout {
                    alignment: center;
                    ColorDot {
                        swatch: root.colors[i];
                        selected: i == root.selected-index;
                        is-dynamic: root.first-is-dynamic && i == 0;
                        label: i < root.labels.length ? root.labels[i] : "";
                        tip-side: r == 0 ? TooltipSide.above : TooltipSide.below;
                        clicked => {
                            root.selected-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
    }
}
