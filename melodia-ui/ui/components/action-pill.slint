import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";

// Rounded near-opaque chip that hosts a horizontal row of pill segments.
// Mirrors Tauri's `ActionPill` (`src/components/common/ActionPill.tsx`):
// callers compose `PillLabel` / `PillDivider` / `PillButton` children to
// express the desired pill contents.
//
// Each Pill primitive below is `pill-content-height` (32 px) outer with
// its visible 28 px chrome centered inside via a VerticalLayout wrap.
// Slint's HorizontalLayout does NOT auto-center fixed-height children
// cross-axis — explicit `y:` doesn't work, but a wrapping
// `VerticalLayout { alignment: center; ... }` does (this is the same
// pattern the original ActionPill used).
export component ActionPill inherits Rectangle {
    height: 32px;
    border-radius: self.height / 2;
    // Shared `Theme.floating-chrome-bg` — `surface0` at 0.75, the same fill
    // the hero's back button takes, so the two read as one family where they
    // sit side by side over a blur. See the note on the token in `theme.slint`.
    background: Theme.floating-chrome-bg;
    // 1 px `Theme.surface2` outline — same chrome convention as
    // `popup-surface.slint`. Keeps the pill legible when it sits over a
    // hero blur whose dominant colour happens to match the fill (Album
    // Detail header), which the fill's translucency only sharpens. The
    // Rectangle border paints inside the layout box, so this doesn't shift
    // any child PillButton.
    border-width: 1px;
    border-color: Theme.surface2;
    width: layout.preferred-width;

    layout := HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: Theme.pad-xs;
        alignment: center;
        @children
    }
}

// Reusable pill-styled button — handles text-only, icon-only, or
// icon + text. The default home for any interactive segment inside an
// `ActionPill`, plus any standalone "secondary action" button across
// the app that wants the same chip chrome (`Theme.floating-chrome-bg`
// outer, `Theme.surface1` hover fill, 28 px rounded shape on a 32 px
// row). The hover fill stays fully opaque on purpose — lifting out of a
// translucent pill is what makes the hover read.
//
// `danger: true` keeps the *same* chrome as a non-danger pill (no
// permanent red fill — Tauri's filled-red treatment read as
// over-prominent for inline action rows). At rest the pill looks
// identical to any other; on hover the standard `surface1` background
// kicks in plus the icon **and** label tint to `Theme.danger`.
// The result reads as "this is destructive" only when the user is
// actually about to act on it.
//
// `icon-size` lets callers grow the glyph for icon-only buttons that
// need more weight (e.g. the column-toggle uses 18 px instead of the
// 14 px default). `icon-filled: true` selects the filled Material
// Symbols variant for the glyph (e.g. a solid play triangle).
export component PillButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <length> icon-size: 14px;
    in property <bool> icon-filled: false;
    in property <bool> danger: false;
    // `active: true` paints text/icon in `Theme.accent` — used to mark
    // the current sort field in a row of sort PillButtons (mirrors the
    // track-list header's active-column treatment).
    in property <bool> active: false;
    // Sort-arrow slot: when `reserve-sort-slot: true`, the chrome always
    // reserves room for a trailing 16 px `arrow_drop_*` chevron, so the
    // label's x position is stable across active/inactive toggles (no
    // left-shift when the user clicks a sort pill). `sort-direction`
    // drives which glyph paints — "" leaves the slot empty (transparent),
    // "asc" paints `arrow_drop_up`, "desc" paints `arrow_drop_down`.
    // Concatenating Unicode arrows (`↑`/`↓`) into `text` instead would
    // pull the line-box into a system fallback font and push the
    // patched-Vazirmatn glyphs off centre. Same chevron pattern as
    // `track-list-header.slint`'s active-column indicator.
    in property <bool> reserve-sort-slot: false;
    in property <string> sort-direction: "";
    in property <string> tooltip-text: "";
    // Suppress this button's own (in-tree) tooltip so the host can render one
    // on a higher paint layer instead. Needed where a below-tooltip would be
    // occluded by later-painted sibling content (Slint has no z-index — paint
    // order is declaration order), e.g. the Playlists header pills over the
    // grid. `hovered` is exposed so the host can drive its overlay tooltip.
    in property <bool> tooltip-overlay: false;
    out property <bool> hovered: touch.has-hover;
    // Force the hover background to paint regardless of pointer position.
    // Used by popup triggers (column-toggle) to keep the highlight while
    // their popup is open — see `PopupHighlight` in `globals.slint`.
    in property <bool> force-bg: false;
    callback clicked();

    private property <bool> icon-only: root.text == "" && root.icon != "";

    height: 32px;
    width: chrome.width;

    VerticalLayout {
        alignment: center;
        chrome := Rectangle {
            height: 28px;
            // Icon-only chips are square so the hover circle reads as a
            // round button; text and icon+text chips grow to fit content.
            width: root.icon-only ? 28px : layout.preferred-width;
            border-radius: self.height / 2;
            // Same chrome for danger and non-danger — see component
            // comment. Danger only re-tints the icon / label on hover
            // (handled below).
            background: (touch.has-hover || root.force-bg)
                ? Theme.surface1
                : transparent;
            animate background { duration: Theme.dur-fast; easing: ease-in-out; }

            layout := HorizontalLayout {
                padding-left: root.icon-only ? 0px : 10px;
                padding-right: root.icon-only ? 0px : 10px;
                spacing: 4px;
                alignment: center;

                // Leading 16 px balance slot, only when the trailing
                // sort-arrow slot is reserved. The chrome's width binds
                // to `layout.preferred-width`, so without a matching
                // leading reservation `alignment: center` centres the
                // (text + arrow) pair as a group — pushing the label
                // visually left-of-centre. Mirroring the trailing 16 px
                // here lands the text at the chrome's optical centre
                // regardless of active state.
                if root.reserve-sort-slot: Rectangle { width: 16px; }

                // `MaterialIcon` pins the glyph in a collapsed
                // icon-size em-box, so plain center alignment lands it
                // at the chrome centre — same as the bare `IconButton`.
                if root.icon != "": VerticalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: root.icon;
                        icon-size: root.icon-size;
                        filled: root.icon-filled;
                        // Danger: default tint at rest, red only on hover.
                        // Non-danger: accent when active, otherwise text.
                        icon-color: root.danger
                            ? (touch.has-hover ? Theme.danger : Theme.text)
                            : (root.active ? Theme.accent : Theme.text);
                        animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
                    }
                }
                // Text path: plain center alignment. The patched
                // Vazirmatn metrics (see CLAUDE.md > Styling > Fonts)
                // land the glyph mass at the line-box centre, so
                // `vertical-alignment: center` inside an HL that fills
                // the chrome height puts text at the chrome centre.
                if root.text != "": VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.text;
                        color: root.danger
                            ? (touch.has-hover ? Theme.danger : Theme.text)
                            : (root.active ? Theme.accent : Theme.text);
                        animate color { duration: Theme.dur-fast; easing: ease-in-out; }
                        font-size: Theme.font-size-sm;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
                // Trailing sort-arrow slot. Always rendered when
                // `reserve-sort-slot: true` so the chrome width is the
                // same whether the pill is active or not; transparent
                // glyph when `sort-direction` is empty.
                if root.reserve-sort-slot: VerticalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: root.sort-direction == "asc"
                            ? "arrow_drop_up"
                            : "arrow_drop_down";
                        icon-size: 16px;
                        icon-color: root.sort-direction != ""
                            ? Theme.accent
                            : transparent;
                    }
                }
            }

            Tooltip {
                text: root.tooltip-text;
                hovered: touch.has-hover && !root.tooltip-overlay;
                host-width: chrome.width;
                host-height: chrome.height;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }
    }
}

// Non-interactive text segment (e.g. "N selected") inside an ActionPill.
// 32 px outer with text centered inside via a VerticalLayout wrap.
export component PillLabel inherits Rectangle {
    in property <string> text;

    height: 32px;
    width: layout.preferred-width;

    VerticalLayout {
        alignment: center;
        layout := HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            alignment: center;
            Text {
                text: root.text;
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}

// Vertical hairline separating segments inside an ActionPill. 32 px
// outer with the visible 18 px line centered inside.
export component PillDivider inherits Rectangle {
    height: 32px;
    width: 1px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 1px;
            height: 18px;
            background: Theme.surface2;
            opacity: 0.5;
        }
    }
}
