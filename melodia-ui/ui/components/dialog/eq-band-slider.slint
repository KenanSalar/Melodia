import { Theme } from "../../theme.slint";

// Vertical EQ band slider, on the volume popup's shape. The fill runs from the
// 0 dB centre line to the thumb, so a boost and a cut read apart at a glance.
//
// Stateless: `changed` fires through the drag for the live player and
// `committed` once on release for the persist. The thumb derives from `value`,
// which the host updates synchronously inside `changed`, so it tracks the cursor
// without holding a drag value of its own.
export component EqBandSlider inherits Rectangle {
    in property <float> value;            // current gain, dB
    in property <float> min-db: -12.0;
    in property <float> max-db: 12.0;
    in property <bool>  is-disabled: false;

    callback changed(float /*dB*/);
    callback committed(float /*dB*/);

    min-width: 26px;
    horizontal-stretch: 1;

    property <float> span: max(0.001, root.max-db - root.min-db);
    property <float> frac: clamp((root.value - root.min-db) / root.span, 0, 1);
    property <float> centre-frac: clamp((0 - root.min-db) / root.span, 0, 1);

    property <length> track-w: 6px;
    property <length> thumb-w: 22px;
    // M3 Expressive, as on the volume slider: press shrinks the thumb along the
    // value axis.
    property <length> thumb-h: touch.pressed ? 2px : 4px;
    animate thumb-h { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    property <length> track-cx: root.width / 2;
    property <length> usable-h: root.height - 4px;
    // Centred against the rest width, or the shrink pins one edge at the
    // extremes — the volume slider's reasoning.
    property <length> thumb-cy: (1 - root.frac) * root.usable-h + 2px;
    property <length> centre-cy: (1 - root.centre-frac) * root.usable-h + 2px;
    property <length> fill-top: min(root.thumb-cy, root.centre-cy);
    property <length> fill-h: abs(root.thumb-cy - root.centre-cy);

    // Inactive full-height track.
    Rectangle {
        x: root.track-cx - root.track-w / 2;
        y: 0;
        width: root.track-w;
        height: root.height;
        border-radius: self.width / 2;
        background: Theme.surface1;
    }

    // Active fill from the 0 dB centre to the thumb.
    Rectangle {
        x: root.track-cx - root.track-w / 2;
        y: root.fill-top;
        width: root.track-w;
        height: root.fill-h;
        // Both axes: `fill-h` shrinks to nothing at 0 dB, and FemtoVG clamps a
        // corner's x- and y-radii independently, so a width-only radius would
        // pinch the fill into a lens as it emerges from centre.
        border-radius: min(self.width, self.height) / 2;
        background: root.is-disabled ? Theme.overlay0 : Theme.accent;
    }

    // 0 dB centre tick.
    Rectangle {
        x: root.track-cx - 6px;
        y: root.centre-cy - 0.5px;
        width: 12px;
        height: 1px;
        background: Theme.surface2;
    }

    // Thumb — thin horizontal pill in the active accent.
    Rectangle {
        x: root.track-cx - root.thumb-w / 2;
        y: root.thumb-cy - root.thumb-h / 2;
        width: root.thumb-w;
        height: root.thumb-h;
        border-radius: self.height / 2;
        background: root.is-disabled ? Theme.overlay0 : Theme.accent;
    }

    touch := TouchArea {
        enabled: !root.is-disabled;
        mouse-cursor: pointer;

        // Set on the jump-to-click `down` and any `moved`; gates `committed`
        // so a dead-zone press without movement still commits the clicked
        // value (graphic-EQ sliders jump-to-click).
        property <bool> moved-since-press: false;

        function value-from-y(y: length) -> float {
            return root.min-db + clamp(1 - y / parent.height, 0, 1) * root.span;
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.changed(self.value-from-y(self.mouse-y));
                self.moved-since-press = true;
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (self.moved-since-press) {
                    root.committed(self.value-from-y(self.mouse-y));
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.changed(self.value-from-y(self.mouse-y));
                self.moved-since-press = true;
            }
        }
    }
}
