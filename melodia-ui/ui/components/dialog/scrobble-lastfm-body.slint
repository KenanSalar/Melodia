import { Theme } from "../../theme.slint";
import { ScrobbleUi } from "../../globals/dialog-forms.slint";

// Body for `Dialog.kind == "scrobble-lastfm-login"`: a two-step browser auth.
// The dialog's primary button (labelled by `dialog.slint`) drives the step —
// step 0 opens the Last.fm approval page, step 1 finishes the session exchange —
// so this body is just instructions plus a busy line and an inline error. State
// lives on the `ScrobbleUi` global, owned by `src/ui/scrobbling_settings.rs`.
export component ScrobbleLastfmBody inherits VerticalLayout {
    spacing: Theme.pad-md;

    Text {
        text: ScrobbleUi.lastfm-step == 0
            ? @tr("Click Open Last.fm to approve Melodia in your browser.")
            : @tr("After approving Melodia in your browser, click Finish.");
        color: Theme.text;
        font-size: Theme.font-size-md;
        wrap: word-wrap;
    }

    if ScrobbleUi.busy: Text {
        text: @tr("Connecting…");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
    }

    if ScrobbleUi.error != "": Text {
        text: ScrobbleUi.error;
        color: Theme.danger;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
