import { Theme } from "../../theme.slint";
import { RadioForm } from "../../globals/dialog-forms.slint";
import { LabeledInput } from "../labeled-input.slint";

// Add or edit a station by URL. One body for both kinds — `RadioForm.edit-id` is the only
// difference, and it belongs to the state rather than to the form.
//
// **A directory-owned row drops its name and stream URL**, which are rewritten from the directory
// on the next play, so showing them would be offering an edit that silently reverts. What it keeps
// is whatever the directory left blank, per field — the four `local_*` columns the conflict clause
// yields on.
//
// **No auto-focus on init**: calling `focus()` during the open re-enters Slint's property
// evaluator and trips its recursion guard.
export component AddStationBody inherits VerticalLayout {
    spacing: Theme.pad-md;

    if !RadioForm.directory-owned: LabeledInput {
        label: @tr("Stream URL");
        // Not translated: an example URL is the same in every locale, and a catalogue entry for
        // one is an invitation to localize a hostname.
        placeholder: "https://example.com/stream";
        text <=> RadioForm.url;
        accepted => {
            if (RadioForm.url != "" && !RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    if !RadioForm.directory-owned: LabeledInput {
        label: @tr("Name (optional)");
        placeholder: @tr("Leave blank to use the station's own name");
        text <=> RadioForm.name;
        accepted => {
            if (RadioForm.url != "" && !RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    // The four the directory may have left blank. Each is gated on its own flag rather than on
    // `directory-owned`, so a station that has a genre but no website shows one field and not the
    // other; a hand-typed station has no directory behind it and sees all four.
    if RadioForm.can-edit-website: LabeledInput {
        label: @tr("Website");
        placeholder: "https://example.com";
        text <=> RadioForm.website;
        accepted => {
            if (!RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    if RadioForm.can-edit-logo: LabeledInput {
        label: @tr("Logo URL");
        placeholder: "https://example.com/logo.png";
        text <=> RadioForm.logo-url;
        accepted => {
            if (!RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    // Left blank with a website filled in, the logo is read off that site instead — which is the
    // path most stations take, so the field is the fallback rather than the ask.
    if RadioForm.can-edit-logo && RadioForm.logo-url == "" && RadioForm.website != "": Text {
        text: @tr("Leave blank to look for a logo on the website above.");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }

    if RadioForm.can-edit-genre: LabeledInput {
        label: @tr("Genre");
        placeholder: @tr("Jazz, Blues");
        text <=> RadioForm.genre;
        accepted => {
            if (!RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    if RadioForm.can-edit-country: LabeledInput {
        label: @tr("Country");
        placeholder: @tr("Tunisia");
        text <=> RadioForm.country;
        accepted => {
            if (!RadioForm.busy) {
                RadioForm.submit();
            }
        }
    }

    // Says why the name and stream URL are missing, which otherwise reads as a broken dialog.
    if RadioForm.directory-owned: Text {
        text: @tr("The directory owns this station's name and stream. What it left blank is yours to fill in; leave a field empty to remove it again.");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }

    // Says what the wait is for. The submit is a real connect, not a save, and a dialog that
    // simply sat there for a few seconds would read as stuck.
    if RadioForm.busy: Text {
        text: @tr("Checking the stream…");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
    }

    if RadioForm.error != "": Text {
        text: RadioForm.error;
        color: Theme.danger;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
