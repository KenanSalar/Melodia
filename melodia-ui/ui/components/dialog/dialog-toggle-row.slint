import { Theme } from "../../theme.slint";
import { ToggleSwitch } from "../settings/toggle-switch.slint";

// A toggle beside a stretching label, with `@children` as an optional trailing
// slot — the equalizer docks its preset dropdown and Reset there. Call sites
// chain the two-way binding through to their global and forward `toggled`.
export component DialogToggleRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;

    callback toggled(bool);

    spacing: Theme.pad-md;
    alignment: stretch;

    VerticalLayout {
        alignment: center;
        ToggleSwitch {
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-size-md;
        }
    }

    @children
}
