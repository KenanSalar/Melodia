import { Theme } from "../../theme.slint";
import { SliderTrack } from "../slider-track.slint";

// Shared "Preamp" dialog row: label | horizontal `SliderTrack` | right-
// aligned dB readout. Owns the dB ↔ 0..1 track mapping (computed from the
// `min-preamp` / `max-preamp` props the host seeds from its DSP constants)
// so the formula exists once for both the equalizer and `ReplayGain`
// dialogs. Emits dB values — the host forwards them to its global's
// live-`changed` / persist-`committed` split.
export component PreampSliderRow inherits HorizontalLayout {
    in property <float> preamp; // dB
    in property <float> min-preamp; // dB
    in property <float> max-preamp; // dB
    in property <bool> enabled: true;

    callback changed(float /* dB */);
    callback committed(float /* dB */);

    pure function preamp-to-frac(db: float) -> float {
        return (db - root.min-preamp) / (root.max-preamp - root.min-preamp);
    }
    pure function frac-to-preamp(f: float) -> float {
        return root.min-preamp + f * (root.max-preamp - root.min-preamp);
    }

    spacing: Theme.pad-md;
    alignment: stretch;

    VerticalLayout {
        alignment: center;
        Text {
            text: @tr("Preamp");
            color: Theme.text;
            font-size: Theme.font-size-md;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        SliderTrack {
            value: root.preamp-to-frac(root.preamp);
            is-disabled: !root.enabled;
            seam-mask-color: Theme.surface0;
            changed(v) => { root.changed(root.frac-to-preamp(v)); }
            committed(v) => { root.committed(root.frac-to-preamp(v)); }
        }
    }
    VerticalLayout {
        alignment: center;
        Text {
            // "dB" is a universal unit symbol — not translated.
            text: (root.preamp > 0 ? "+" : "") + round(root.preamp) + " dB";
            color: root.enabled ? Theme.subtext0 : Theme.overlay0;
            font-size: Theme.font-size-sm;
            min-width: 48px;
            horizontal-alignment: right;
        }
    }
}
