import { Theme } from "../../theme.slint";
import { SliderTrack } from "../slider-track.slint";

// The shared Preamp row. It owns the dB ↔ 0..1 mapping, off bounds the host
// seeds from its own DSP constants, so the formula exists once across both
// dialogs. It emits dB, which the host splits into live and persist.
export component PreampSliderRow inherits HorizontalLayout {
    in property <float> preamp; // dB
    in property <float> min-preamp; // dB
    in property <float> max-preamp; // dB
    in property <bool> enabled: true;

    callback changed(float /* dB */);
    callback committed(float /* dB */);

    pure function preamp-to-frac(db: float) -> float {
        return (db - root.min-preamp) / (root.max-preamp - root.min-preamp);
    }
    pure function frac-to-preamp(f: float) -> float {
        return root.min-preamp + f * (root.max-preamp - root.min-preamp);
    }

    spacing: Theme.pad-md;
    alignment: stretch;

    VerticalLayout {
        alignment: center;
        Text {
            text: @tr("Preamp");
            color: Theme.text;
            font-size: Theme.font-size-md;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        SliderTrack {
            value: root.preamp-to-frac(root.preamp);
            is-disabled: !root.enabled;
            seam-mask-color: Theme.surface0;
            changed(v) => { root.changed(root.frac-to-preamp(v)); }
            committed(v) => { root.committed(root.frac-to-preamp(v)); }
        }
    }
    VerticalLayout {
        alignment: center;
        Text {
            // A unit symbol, so untranslated.
            text: (root.preamp > 0 ? "+" : "") + round(root.preamp) + " dB";
            color: root.enabled ? Theme.subtext0 : Theme.overlay0;
            font-size: Theme.font-size-sm;
            min-width: 48px;
            horizontal-alignment: right;
        }
    }
}
