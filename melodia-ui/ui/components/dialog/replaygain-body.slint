import { Theme } from "../../theme.slint";
import { ReplayGain } from "../../globals.slint";
import { Dropdown } from "../settings/dropdown.slint";
import { DialogToggleRow } from "dialog-toggle-row.slint";
import { PreampSliderRow } from "preamp-slider-row.slint";

// Body for the `Dialog.kind == "replaygain"` modal: an enable toggle, a
// Track/Album mode dropdown, a preamp slider (±15 dB, 0 dB centred), and a
// "prevent clipping" toggle. Every control drives the `ReplayGain` global; Rust
// applies each change to the live player and persists it. Mounted by
// `dialog.slint`. Simpler than the equalizer body — no per-band model.
export component ReplayGainBody inherits VerticalLayout {
    spacing: Theme.pad-lg;

    // Mode names, order-matched to `RgMode` (0 = Track, 1 = Album). Inline `@tr`
    // literals — a `[string]` populated from Rust wouldn't be translated
    // (CLAUDE.md i18n notes).
    property <[string]> mode-names: [@tr("Track"), @tr("Album")];

    DialogToggleRow {
        label: @tr("Enable ReplayGain");
        checked <=> ReplayGain.enabled;
        toggled(v) => { ReplayGain.set-enabled(v); }
    }

    // Mode row — per-track vs per-album normalization.
    HorizontalLayout {
        spacing: Theme.pad-md;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: @tr("Normalization mode");
                color: Theme.text;
                font-size: Theme.font-size-md;
            }
        }
        VerticalLayout {
            alignment: center;
            Dropdown {
                options: root.mode-names;
                trigger-width: 150px;
                selected-index <=> ReplayGain.mode-idx;
                selected(i) => { ReplayGain.set-mode(i); }
            }
        }
    }

    // Preamp row — extra gain applied on top of the tag value.
    PreampSliderRow {
        preamp: ReplayGain.preamp;
        min-preamp: ReplayGain.min-preamp;
        max-preamp: ReplayGain.max-preamp;
        enabled: ReplayGain.enabled;
        changed(db) => { ReplayGain.set-preamp(db); }
        committed(db) => { ReplayGain.commit-preamp(db); }
    }

    DialogToggleRow {
        label: @tr("Prevent clipping");
        checked <=> ReplayGain.prevent-clipping;
        toggled(v) => { ReplayGain.set-prevent-clipping(v); }
    }

    // Footnote — ReplayGain reads precomputed loudness tags from the files; it
    // does nothing on a library that hasn't been scanned by a tagging tool.
    Text {
        text: @tr("ReplayGain only affects tracks that already have loudness tags. Scan your library with a tool like rsgain or loudgain to add them.");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
