import { Theme } from "../../theme.slint";
import { Dialog, Playlists } from "../../globals.slint";
import { SelectableRow, SelectAllHeader, PickerListCard } from "selectable-picker.slint";

// Add-to-Playlist picker body — rendered inside `DialogOverlay` when
// `Dialog.kind == "add-to-playlist"`. A multi-select list (same design as the
// Export picker): tick any number of playlists, then the footer's primary
// "Add" button commits the pending track(s) into all of them at once through
// the `Dialog.accepted` dispatcher (`Playlists.add-tracks-to-selected`).
//
// Per-row overlap state drives the subtitle + disabled flag:
//   * `contained-count == 0`            ⇒ no subtitle, selectable
//   * `0 < contained-count < total`     ⇒ "N of M already added", selectable
//                                         (the `INSERT OR IGNORE` adds only the
//                                         missing tracks)
//   * `contained-count >= total`        ⇒ "Already added", row dim + disabled
//
// Toggling a row flips its `selected` flag (Rust mutates the VecModel via
// `Playlists.toggle-add-pick`, which no-ops on disabled rows); the header
// flips all *enabled* rows (`set-all-add-picks`). The selectable-row / header
// / list-card visuals are the shared `selectable-picker.slint` toolkit.
export component PlaylistPicker inherits Rectangle {
    VerticalLayout {
        spacing: Theme.pad-sm;

        SelectAllHeader {
            checked: Dialog.add-select-all;
            indeterminate: !Dialog.add-select-all
                && Dialog.add-selected-count > 0;
            selected-count: Dialog.add-selected-count;
            toggled => { Playlists.set-all-add-picks(!Dialog.add-select-all); }
        }

        // In-flight placeholder — the menu entry that opens this dialog is
        // gated on `visible-playlist-count > 0`, so reaching the empty branch
        // only ever means the parallel Rust queries haven't returned yet.
        // Hold an 80 px slot so the dialog doesn't snap-resize when the rows
        // arrive a frame or two later.
        if Dialog.playlist-pick-rows.length == 0: Rectangle {
            height: 80px;
        }

        if Dialog.playlist-pick-rows.length > 0: PickerListCard {
            row-count: Dialog.playlist-pick-rows.length;
            for r in Dialog.playlist-pick-rows: SelectableRow {
                name: r.name;
                subtitle: (Dialog.pick-total-tracks > 0
                        && r.contained-count >= Dialog.pick-total-tracks)
                    ? @tr("Already added")
                    : (r.contained-count > 0
                        ? @tr("{} of {} already added", r.contained-count, Dialog.pick-total-tracks)
                        : "");
                cover: Playlists.request-row-cover(r.artwork_path);
                artwork-path: r.artwork_path;
                fallback-icon: "playlist";
                selected: r.selected;
                disabled: r.contained-count >= Dialog.pick-total-tracks
                    && Dialog.pick-total-tracks > 0;
                toggled => { Playlists.toggle-add-pick(r.id); }
            }
        }
    }
}
