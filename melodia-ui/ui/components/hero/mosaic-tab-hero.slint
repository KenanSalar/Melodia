import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { NavEnterFrom } from "../../globals/nav.slint";
import { HeroBlurBackdrop } from "../hero-blur-backdrop.slint";
import { HeroChipStrip } from "../hero-chip-strip.slint";
import { MosaicHeroTile } from "mosaic-hero-tile.slint";
import { SearchBar } from "../search-bar.slint";
import { TabBar } from "../tab-bar.slint";

// The pinned banner both tabbed mosaic pages wear: a header row carrying the tab
// bar and the filter, over the artwork square, the title and the chip band.
// Favorites and Recently Played mount one each and differ only in their strings,
// their tab list and the action pills they pass as `@children`.
//
// **Data-agnostic on purpose.** A Slint component can't be parameterised over a
// global, and `Favorites` / `RecentlyPlayed` are distinct generated types with
// nothing between them — so every fact arrives as a property and every write
// leaves as a callback. That is the same wall `impl_mosaic_hero!` works around on
// the Rust side, and the reason this is a component rather than a third copy: the
// arithmetic below is five separately paid-for fixes, and a copy is where one of
// them silently goes missing. The Settings page keeps its own header row — no
// hero, no mosaic, no title, and its bar takes the `Theme.*` defaults.
export component MosaicTabHero inherits Rectangle {
    // **Inline `[@tr("…"), …]` literals at the call site.** `@tr` registers
    // msgids at codegen, so an array populated from Rust renders untranslated —
    // and forwarding one through here is fine, since the literal still sits in a
    // `.slint` file.
    in property <[string]> tab-labels;
    in property <[string]> tab-icons;
    // Two-way, per the "a component writing its own `in-out` orphans a one-way
    // binding" pitfall — the bar writes this on every pick.
    in-out property <int> tab-idx;

    in property <string> title;
    in property <string> filter-placeholder;
    // The band's own empty state: a sentence rather than a "0 tracks" chip, which
    // states the same thing far more bleakly. The gate is the host's, because
    // only it knows which tab is mounted and what its unfiltered count is.
    in property <bool> show-empty-copy;
    in property <string> empty-copy;

    in property <int> mosaic-count;
    in property <[string]> mosaic-paths;
    in property <string> empty-glyph;
    in property <bool> empty-glyph-filled: false;

    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    in-out property <string> filter;
    in property <int> blur-tick;

    // `pure` because `MosaicHeroTile`'s is, which is because `CoverMosaic`'s is.
    pure callback request-cover(string) -> image;
    // Fires *after* the direction and the arming below have been settled, so a
    // host handler that clears its filter and calls into Rust can't be sequenced
    // ahead of them. The bar has already written `tab-idx`.
    callback tab-selected(int);
    callback search-edited(string);

    // --- The header width budget ------------------------------------------
    //
    // `page-w` is a **mirror**, written imperatively because a live `root.width`
    // read feeding a child's size re-enters layout, and seeded at this row's own
    // **floor**: seeded wide, the bar believes it can afford full-width tabs and
    // draws them into a panel that can't seat them, which is exactly what a
    // miniplayer → full swap produces. The mount Timer beside it is mandatory —
    // `changed` doesn't fire when the first layout settles directly on the final
    // value, and a window opened at its final size is that case.
    property <length> search-w-max: 220px;
    // Off the bar's and the input's own published floors, never restated, so
    // neither end can drift from the component it budgets for.
    property <length> search-w-min: search.min-w;

    property <length> page-w:
        2 * Theme.pad-lg + bar.compact-w + 2 * Theme.pad-md + root.search-w-max;
    changed width => { self.page-w = self.width; }

    Timer {
        interval: 1ms;
        triggered => {
            root.page-w = root.width;
            self.running = false;
        }
    }

    property <length> content-w: root.page-w - 2 * Theme.pad-lg;

    // **The filter yields before the tabs do**: tabs navigate, search only
    // refines what a tab already shows.
    property <length> search-w: clamp(
        root.content-w - bar.compact-w - 2 * Theme.pad-md,
        root.search-w-min, root.search-w-max);

    // The bar's own height, restated so the band can reserve its row.
    property <length> tab-row-h: 48px;
    // Derived rather than a literal, so growing the artwork or the bar can't
    // leave the banner cropping its own contents.
    out property <length> hero-height:
        2 * Theme.pad-lg + root.tab-row-h + Theme.pad-md + Theme.hero-artwork;

    // --- What the host's tab bodies read ----------------------------------
    //
    // Which way a body enters is `bar.previous-index`'s job, and it has to be:
    // the page can be re-entered on any tab, and everything else in reach already
    // reads the tab just picked, the bar writing `selected-index` before it emits
    // `selected`. Arming starts `false` so the page's own fade-up isn't compounded
    // with a horizontal slide — the two together read as a diagonal — and it
    // re-disarms for free, the page being rebuilt on every entry.
    out property <NavEnterFrom> tab-enter-from: NavEnterFrom.right;
    out property <bool> tab-anim-armed: false;

    // --- The compact-mode tooltip's anchor --------------------------------
    //
    // Published rather than drawn here: the pill has to be declared *after* the
    // scroll body, and Slint paints in declaration order, so anything this band
    // owns is covered by the content below it. Equal-width cells are what let the
    // rect come from the *index*, so a tab that moves under a parked pointer keeps
    // its tooltip anchored — and since `tab-w` eases, the frame morphs with it.
    out property <length> tip-x:
        bar.absolute-position.x - root.absolute-position.x + bar.tab-w * bar.hovered-idx;
    out property <length> tip-y: bar.absolute-position.y - root.absolute-position.y;
    out property <length> tip-w: bar.tab-w;
    out property <length> tip-h: bar.height;
    out property <string> tip-label: bar.hovered-label;
    out property <bool> tip-visible: bar.hovered-idx >= 0 && bar.compact;

    vertical-stretch: 0;
    height: root.hero-height;

    // Behind everything else. The shared component owns the dual-slot crossfade
    // contract; the gradient floor shows through when there is no blur image.
    HeroBlurBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
    }

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        // The Settings header row, on a banner. Both paint on the blur, so the
        // bar takes `HeroBackdrop` tiers rather than its `Theme.*` defaults;
        // `SearchBar` is the documented exception and keeps its own chrome.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-md;

            bar := TabBar {
                labels: root.tab-labels;
                icons: root.tab-icons;
                avail-width: root.content-w - root.search-w - 2 * Theme.pad-md;
                selected-index <=> root.tab-idx;
                label-color: HeroBackdrop.on-backdrop;
                // One input for the selected label, its FILL=1 icon and the
                // underline, so it has to be a hero token like the other three.
                // The band takes its hue from the mosaic, so a theme value is
                // unrelated to what it sits on — and `Theme.accent` carries no
                // contrast floor here, Latte's mauve landing near 1.7:1 on the
                // pinned band where `chrome` is solved to clear 3:1 whatever the
                // cover. The cost: the selected label sits a tier below the idle
                // ones. Splitting label from indicator means a second input on
                // `TabBar`, which Settings would inherit too.
                active-color: HeroBackdrop.chrome;
                hover-fill: HeroBackdrop.on-backdrop.with-alpha(0.12);
                divider-color: HeroBackdrop.tile-edge;
                selected(i) => {
                    // Direction first, in the same handler that moved the index:
                    // the bar has already written `tab-idx`, but Slint
                    // re-evaluates the host's `if` branches next frame, so this
                    // still lands before the new body mounts — the ordering rule
                    // `nav_transition.rs` follows for the page-level one.
                    root.tab-enter-from = i > bar.previous-index
                        ? NavEnterFrom.right
                        : NavEnterFrom.left;
                    root.tab-anim-armed = true;
                    root.tab-selected(i);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Padded to the band the bar keeps clear for its divider, so the
            // input centres on the tab labels' line rather than on the row's.
            VerticalLayout {
                alignment: center;
                padding-bottom: Theme.pad-sm;
                search := SearchBar {
                    input-width: root.search-w;
                    text <=> root.filter;
                    placeholder: root.filter-placeholder;
                    blur-trigger: root.blur-tick;
                    edited(t) => { root.search-edited(t); }
                }
            }
        }

        // Mosaic tile + title block.
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.pad-lg;

            VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;

                MosaicHeroTile {
                    count: root.mosaic-count;
                    paths: root.mosaic-paths;
                    empty-glyph: root.empty-glyph;
                    empty-glyph-filled: root.empty-glyph-filled;
                    request-cover(p) => {
                        return root.request-cover(p);
                    }
                }
            }

            // Title, chips, and whatever action pills the host hands over.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: stretch;
                spacing: Theme.pad-xs;

                Text {
                    vertical-stretch: 0;
                    // Leading LRM keeps the title left-anchored under RTL.
                    text: "\u{200e}" + root.title;
                    color: HeroBackdrop.on-backdrop;
                    font-size: Theme.hero-title-size;
                    font-weight: Theme.page-title-weight;
                    horizontal-alignment: left;
                }

                // Which chips the band shows follows the tab, decided in
                // `ui::hero_chips`. **An empty tab publishes none** and the line
                // below takes over.
                HeroChipStrip { }

                if root.show-empty-copy: Text {
                    vertical-stretch: 0;
                    text: root.empty-copy;
                    color: HeroBackdrop.on-backdrop-muted;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: left;
                }

                Rectangle { vertical-stretch: 1; }

                // The per-tab action pills. After the spacer, so they sit on the
                // band's floor beside the artwork tile's bottom edge — which is
                // also the slack `HERO_MAX_ROWS` is measured against.
                @children
            }
        }
    }
}
