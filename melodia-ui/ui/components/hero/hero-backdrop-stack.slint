import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { HeroBlurBackdrop } from "../hero-blur-backdrop.slint";
import { AuroraBackdrop } from "../aurora-backdrop.slint";

// The two backdrop stacks as one mount, for the hosts painting off the `HeroBackdrop` tier.
//
// **Only the live arm is mounted**, and the branch is safe because the condition is a process
// constant: `Theme.aurora-backdrop` is an `in` property written once by
// `boot::ui_setup::apply_backdrop_style`, before `install_views` and before `app.show()`, so no
// frame can ever see it move. Painting the loser transparent instead is not the free option it
// reads as — `Brush::is_transparent()` answers `false` for *every* gradient whatever its stop
// alphas, so the femtovg renderer tessellates the path and fills the whole surface anyway. That is
// four wasted full-bleed fills a frame on the blur arm, which is the setting most installs are on.
//
// Reading `HeroBackdrop` here is what the two leaf components may not do: their colours stay
// defaulted `in property`s so one pair can serve this tier *and* Now Playing's `Player.np-*`,
// which is why `now-playing-view.slint` still mounts them directly. This wrapper is the tier-bound
// half, and it exists because its two hosts had the same twenty-five lines each.
//
// `shown` survives the gate and is still load-bearing: it is the host's own question — for
// `LibraryTabBand`, whether the band is painting a hero at all, its globals outliving the tab that
// filled them — and the surviving stack drains to its idle colours through it. That drain is why
// each stack's `shown: false` arm stays a *gradient* of the same shape: `Brush::interpolate` blends
// stop-for-stop and only between matching types.
export component HeroBackdropStack inherits Rectangle {
    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;
    in property <bool> shown: true;

    // Named once, because both terms below read it and a second spelling of the condition can
    // invert on its own.
    property <bool> aurora-shown: Theme.aurora-backdrop;

    if !root.aurora-shown: HeroBlurBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        floor-start: HeroBackdrop.floor-start;
        floor-end: HeroBackdrop.floor-end;
        scrim: HeroBackdrop.scrim;
        blur-a: root.blur-a;
        blur-b: root.blur-b;
        use-a: root.use-a;
        has-blur: root.has-blur;
        shown: root.shown;
    }

    if root.aurora-shown: AuroraBackdrop {
        x: 0; y: 0;
        width: 100%; height: 100%;
        base-start: HeroBackdrop.floor-start;
        base-end: HeroBackdrop.floor-end;
        tint-1: HeroBackdrop.tint-1;
        tint-2: HeroBackdrop.tint-2;
        tint-3: HeroBackdrop.tint-3;
        dither: HeroBackdrop.dither;
        shown: root.shown;
    }
}
