import { Theme } from "../../theme.slint";
import { HeroBackdrop } from "../../globals/hero-backdrop.slint";
import { MaterialIcon } from "../material-icon.slint";

// The artwork square both curated heroes draw. `cover` is a collage Rust composed from the
// page's top four covers, so this draws one image where it once laid out a live 2×2 —
// `media::artwork::compose_cover` owns that arrangement now, and the tile is an ordinary
// single-artwork square. Mounted once, by `MosaicTabHero`.
//
// **Every brush here is a `HeroBackdrop` tier, and none may become a `Theme.*` token.** The
// tile sits *on* the hero — with no collage that's the dark gradient floor, where a light
// theme's accent lands dark-on-dark. The edge follows the fill for the same reason.
export component MosaicHeroTile inherits Rectangle {
    // Entries behind the collage. Zero means an empty *set*; a positive count with no cover
    // means a set whose entries carry no artwork, and the two get different glyphs.
    in property <int> count;
    in property <image> cover;
    // Each view passes its own sidebar entry's glyph.
    in property <string> empty-glyph;
    in property <bool> empty-glyph-filled: false;

    // The composed collage is what decides the arm, not `count`: a set whose every entry
    // lacks artwork is populated and has nothing to paint.
    property <bool> shows-cover: root.cover.width > 0;

    width: Theme.hero-artwork;
    height: Theme.hero-artwork;
    // The tinted fallback fill mirrors the tracklist placeholder, so a coverless hero
    // reads as one giant placeholder tile rather than as a bare surface.
    background: root.shows-cover
        ? HeroBackdrop.floor-start
        : HeroBackdrop.chrome.transparentize(0.85);
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: HeroBackdrop.tile-edge;
    clip: true;

    if root.shows-cover: Image {
        width: 100%;
        height: 100%;
        source: root.cover;
        image-fit: ImageFit.cover;
    }

    if !root.shows-cover: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            MaterialIcon {
                // The page's own glyph for an empty set; the tracklist placeholder's for a
                // set that exists and simply has no art to show.
                name: root.count == 0 ? root.empty-glyph : "music_note";
                filled: root.count == 0 && root.empty-glyph-filled;
                icon-size: 56px;
                icon-color: HeroBackdrop.chrome;
            }
        }
    }
}
