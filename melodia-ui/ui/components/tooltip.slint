import { Theme } from "../theme.slint";

// Which side of the host the pill clears. `above` is the default; `below` is
// for hosts pinned to the top of the window, where an above-tooltip would clip
// off-screen (the Playlists header pills, the Settings tab bar); `right` is for
// the collapsed sidebar rail, where the hidden label sat to the icon's right
// anyway.
export enum TooltipSide { above, below, right }

// Reusable tooltip pill — anchors on one side of its parent and fades in on
// hover. Replaces what was the Tauri HTML `title=` attribute (Slint has no
// native HTML-like tooltip).
//
// Usage: place inside the element you want a tooltip for, set
// `text` and feed `hovered` from the parent's TouchArea. The 500 ms
// reveal delay (so quick mouse-passes don't flash a tooltip) is
// owned by this component, gated on `hovered`.
export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool>  hovered;
    // Width of the host element. `parent` isn't accessible from a
    // component's root binding in Slint, so callers pass it
    // explicitly: `host-width: parent.width`.
    in property <length> host-width;
    // Height of the host element — needed by every side except `above`
    // (`below` anchors at `host-height + gap`, `right` centres on it).
    in property <length> host-height;
    in property <TooltipSide> side: TooltipSide.above;
    // Gap between the pill and the host, on whichever axis `side` clears.
    in property <length> gap: 6px;
    // External force-show flag — bypasses the 500 ms hover delay and
    // shows the pill immediately. Used by callers that want to surface
    // the tooltip without a real mouse hover (e.g. keyboard-driven
    // volume changes triggering the VolumePopup button's tooltip).
    // Falls back through the same `animate opacity` so the fade-in /
    // fade-out timing matches the hover path.
    in property <bool> force-shown: false;
    // The pill is absolutely positioned against its host, so nothing downstream
    // stops it running off the window — and a label that fits in English can be
    // half again as long in a translation. Every English label clears the cap;
    // the longest translations of the Playlists header pills don't, and those
    // wrap to two lines rather than leaving the screen. Only sides that grow
    // away from the host are safe to overrun, which is why the mounts near a
    // window edge already pass `below`. (Not `max-width`: that name is taken by
    // the built-in layout constraint, which a bound `width` overrides anyway.)
    in property <length> max-pill-width: 240px;

    private property <bool> shown;

    width: min(tip-text.preferred-width + 16px, root.max-pill-width);
    height: tip-text.preferred-height + 8px;
    // `right` clears the host horizontally and centres on it vertically; the
    // two vertical sides do the mirror of that.
    x: root.side == TooltipSide.right
        ? (root.host-width + root.gap)
        : (root.host-width - self.width) / 2;
    y: root.side == TooltipSide.above ? (-self.height - root.gap)
        : root.side == TooltipSide.below ? (root.host-height + root.gap)
        : (root.host-height - self.height) / 2;

    // Border, radius and surface rung follow the ActionPill chrome so a tooltip
    // reads as part of the same control family as the pill it annotates. The
    // fill is the one place they diverge: the pill takes `floating-chrome-bg`,
    // but a tooltip is transient and its whole job is to be read, so it stays
    // fully opaque wherever it lands — a hero blur, a cover, a list row.
    background: Theme.surface0;
    border-color: Theme.surface2;
    border-width: 1px;
    border-radius: 6px;
    opacity: (shown || root.force-shown) ? 1.0 : 0.0;
    animate opacity { duration: 150ms; easing: ease-out; }
    visible: root.text != "";

    reveal-timer := Timer {
        interval: 500ms;
        running: root.hovered && !root.shown && root.text != "";
        triggered => { root.shown = true; }
    }

    // Reset when hover ends so the next hover restarts the delay.
    // `changed` callback fires on either edge.
    changed hovered => {
        if (!root.hovered) { root.shown = false; }
    }

    tip-text := Text {
        text: root.text;
        color: Theme.text;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        // Bounded so the wrap has something to wrap against, and the root's
        // height follows for free: a wrapping Text reports its height against
        // the width it was handed, while the width above is read from the
        // *horizontal* layout info, which is intrinsic to the string. So the
        // chain terminates rather than chasing itself. The 8 px of side padding
        // still comes from the compiler centring this in the pill.
        width: root.width - 16px;
        wrap: word-wrap;
    }
}
