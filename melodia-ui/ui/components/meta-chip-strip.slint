import { Theme } from "../theme.slint";
import { MetaChip } from "meta-chip.slint";

// A row (or rows) of `MetaChip`s, wrapped by Rust.
//
// Slint 1.16 has no `Flow` and can't build a nested array, so the split comes
// from `src/ui/chips.rs` as a `[[string]]` of rows and this walks two real
// arrays. The strip only reports its width — who chunks against it, and whether
// overflow wraps or is dropped, is the host's business: Now Playing wraps
// freely, a hero caps at `ui::hero_chips::HERO_MAX_ROWS` because its band is
// sized by the artwork tile.
//
// Both brushes are inputs for the reason `MetaChip` states, and every mount
// overrides both.
export component MetaChipStrip inherits Rectangle {
    in property <[[string]]> rows;
    in property <brush> chip-fill;
    in property <brush> chip-label-color;
    // Now Playing centres its rows under the cover; a hero's text column is
    // left-aligned all the way down, so its chips are too.
    in property <bool> centred: false;
    // Lets a host hide the chips while keeping the row reserved — Now Playing
    // drops a metadata fetch that lands after a rapid track change, and a
    // vanishing row would reflow the centred artwork above it.
    in property <bool> show-rows: true;

    // Reported on mount and on every resize. The host chunks against it.
    callback measured(length);

    // == MetaChip height. Reserving it unconditionally is what keeps a track
    // with no metadata — or a slow fetch — from reflowing whatever sits above.
    min-height: 26px;
    vertical-stretch: 0;
    // The other half of the wrapper below, and the half nothing catches at build
    // time: that wrapper is a real layout, so the root merges its horizontal
    // constraint and the widest published row becomes a floor no narrowing can
    // negotiate. The strip would keep being handed the width it was chunked at —
    // and keep reporting it — so the chips clip instead of wrapping. Same floor
    // and same cure as `settings/chip-group.slint`'s hidden ruler.
    min-width: 0px;

    // `changed` can't watch a path expression, so the width is mirrored into a
    // local property first (see `.claude/rules/slint-pitfalls.md`).
    property <length> watched-w: self.width;
    changed watched-w => {
        root.measured(watched-w);
    }

    // First-layout seed: `changed` doesn't fire on the initial evaluation, so
    // the mount-time width reaches the host through nothing else.
    Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            root.measured(root.width);
        }
    }

    // The plain wrapper is what lets a second row grow the strip. A `Rectangle`
    // root folds a child *layout* into its own layout info but not a conditional
    // one — an `if` lowers to a repeater, which `gen_layout_info_prop` skips —
    // so with the `if` as the direct child the strip reported `preferred: 0`,
    // took its floor from `min-height`, and drew every row past the first
    // outside the box. See the `if`-child entry in `slint-pitfalls.md`.
    VerticalLayout {
        if root.show-rows: VerticalLayout {
            // Tighter than the gap between chips: a wrapped row is the same
            // strip continuing, not a second one, and that is what lets a hero
            // band absorb it without growing. Only the horizontal number is
            // mirrored in Rust (`ui::chips::SPACING`); this one is Slint's alone.
            spacing: Theme.pad-xs;
            for row in root.rows: HorizontalLayout {
                alignment: root.centred ? LayoutAlignment.center : LayoutAlignment.start;
                spacing: Theme.pad-sm;
                for t in row: MetaChip {
                    text: t;
                    fill: root.chip-fill;
                    label-color: root.chip-label-color;
                }
            }
        }
    }
}
