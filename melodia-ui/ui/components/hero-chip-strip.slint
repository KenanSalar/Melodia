import { HeroBackdrop } from "../globals/hero-backdrop.slint";
import { HeroChips } from "../globals/hero-chips.slint";
import { MetaChipStrip } from "meta-chip-strip.slint";

// The hero half of `MetaChipStrip`, wired once instead of six times. All six
// hero-bearing views mount it against exactly the same four bindings, and only
// one hero is ever on screen, so there is nothing per-view to parameterise.
//
// It exists to make the *wrong* mount unspellable rather than merely tested
// against. `MetaChip`'s defaults are theme tokens correct nowhere and never
// taken — they exist so the component imports neither `Player` nor
// `HeroBackdrop`, which is what lets one strip sit on a blurred cover *and* on a
// blurred banner. That layering survives: the strip and the chip still import
// neither, Now Playing still mounts the raw strip with its own pair, and only
// this wrapper knows about the hero tiers. `ui::hero_chips::tests` pins that the
// six heroes take it rather than reaching past it.
export component HeroChipStrip inherits MetaChipStrip {
    rows: HeroChips.rows;
    // `chrome` is the 3:1 tier, solved against the composited band — see the
    // hero-backdrop rule in `.claude/rules/ui-patterns.md`.
    chip-fill: HeroBackdrop.chip-fill;
    chip-label-color: HeroBackdrop.chrome;
    vertical-stretch: 0;

    measured(w) => {
        HeroChips.recompute(w);
    }
}
