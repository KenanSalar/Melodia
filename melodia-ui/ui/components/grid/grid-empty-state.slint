import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// The "this grid has nothing in it" placeholder — a centred glyph over a
// heading and a line of guidance. Mounted as an opaque overlay *on top of*
// the grid rather than as an alternative branch, so the host doesn't have to
// tear the grid down and rebuild it when the count crosses zero.
//
// `body` is optional: a grid whose emptiness needs no explanation (nothing
// played yet) leaves it out and gets the heading alone.
export component GridEmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> body;

    background: Theme.base;

    VerticalLayout {
        alignment: center;
        spacing: Theme.pad-md;

        HorizontalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 64px;
                icon-color: Theme.overlay0;
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-size-lg;
                font-weight: 600;
            }
        }

        if root.body != "": HorizontalLayout {
            alignment: center;
            Text {
                text: root.body;
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
