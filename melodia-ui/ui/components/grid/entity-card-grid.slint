import { ListView } from "std-widgets.slint";
import { EntityGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";

// Virtualized card grid over `EntityStripRow` — the vertical counterpart to
// `HorizontalCardStrip`, and the same relationship `AlbumGrid` has to the
// Albums view. The `rows` model is `[EntityGridRow]`: Rust chunks the flat
// list into rows of `columns` cards, so the inner `ListView` virtualizes by
// row and only on-screen cards are instantiated.
//
// That is the whole reason a strip and a grid aren't one component. A strip
// walks its rows in a plain `for` inside a horizontal `ScrollView`, which is
// affordable for a capped carousel and not for an uncapped page — every card
// would be built and every cover requested. The Favorites grid tabs are
// uncapped, so they take this shape instead.
//
// Covers are pulled lazily: each on-screen card's `cover` binding invokes
// `request-cover(artwork_path)`, which the host forwards to its global. Only
// mounted cards evaluate it, so the grid never decodes a cover the user
// hasn't scrolled to, and the model stays pure data.
//
// Mirrors `AlbumGrid`'s host-mounted-scrollbar contract: viewport metrics are
// exposed via the `v-*` out properties + `set-v-offset`, so the host view can
// place its `OverlayScrollbar` flush with the content-panel edge rather than
// inside whatever padding it applies.
export component EntityCardGrid inherits Rectangle {
    in property <[EntityGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // Full row slot height — `card-height` plus the inter-row gap, baked in
    // so the `ListView` (which lays delegates back-to-back, no `spacing`)
    // gets even vertical gaps.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;
    // Circular artwork, for the artist flavour.
    in property <bool> circular: false;
    // An `ArtworkImage` placeholder key (a bundled SVG), not a Material
    // ligature — same vocabulary `EntityCard` and `HorizontalCardStrip` use.
    in property <string> fallback-icon: "music-note";
    // Reveals the per-card play-count badge where the row carries one. Rows
    // with `play_count == 0` stay bare either way.
    in property <bool> show-play-count: false;

    // Bumped by the host once the tier behind `request-cover` has been warmed
    // off-thread. A card's `cover` binding reads it, which is the only reason
    // the bump re-runs a `pure` callback whose result is otherwise cached
    // until a dependency is dirtied; the host also forwards the value, so its
    // Rust side can answer cache-only while the tier is still cold.
    in property <int> covers-generation: 0;

    callback row-clicked(int /*entity_id*/);
    // Lazy per-card cover lookup — the host forwards this to its global's
    // `request-cover` callback. `pure` so it can be used inside a binding.
    pure callback request-cover(string /*artwork_path*/, int /*generation*/) -> image;

    // Viewport metrics for a host-mounted `OverlayScrollbar`. Sign convention
    // matches `TrackList` and `AlbumGrid`: positive `v-offset` = scrolled by
    // N px; the inner `ListView` stores the same as a non-positive
    // `viewport-y`, so we negate at the boundary.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for grid-row in root.rows: Rectangle {
            // Pin the delegate's layout slot — a `ListView` delegate needs a
            // fixed height or the virtualization math breaks (CLAUDE.md).
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for entity in grid-row.entities: EntityCard {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    artwork-path: entity.artwork_path;
                    // Lazy cover — only this on-screen card evaluates it.
                    cover: root.request-cover(entity.artwork_path, root.covers-generation);
                    circular: root.circular;
                    fallback-icon: root.fallback-icon;
                    // Pronounced 1.15 zoom in placeholder mode (matches the
                    // other grids); real artwork keeps the gentle 1.04 so
                    // covers don't jitter inside the tile clip on hover.
                    cover-scale-hover: entity.artwork_path == "" ? 1.15 : 1.04;
                    title: entity.title;
                    subtitle: entity.subtitle;
                    badge-text: root.show-play-count && entity.play_count > 0
                        ? entity.play_count
                        : "";
                    clicked => { root.row-clicked(entity.id); }
                }
            }
        }
    }
}
