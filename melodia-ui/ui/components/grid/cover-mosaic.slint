import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";

// One tile, over `ArtworkImage` so a missing cover falls back to the same
// placeholder chrome every other empty tile in the app draws. The guarded index
// lookup is what lets one component cover both cases, so no layout below needs
// a second call site for the placeholder.
component MosaicSlot inherits Rectangle {
    in property <int>      idx;
    in property <[string]> artwork-paths;
    in property <length>   tile-radius;
    in property <string>   fallback-icon;
    in property <brush>    tile-bg;
    in property <brush>    tile-icon-color;
    pure callback request-cover(string) -> image;

    clip: true;
    border-radius: tile-radius;

    if root.artwork-paths.length > root.idx: ArtworkImage {
        width: parent.width;
        height: parent.height;
        tile-radius: root.tile-radius;
        artwork-path: root.artwork-paths[root.idx];
        cover: root.request-cover(root.artwork-paths[root.idx]);
        fallback-icon: root.fallback-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
    }
    if root.artwork-paths.length <= root.idx: ArtworkImage {
        width: parent.width;
        height: parent.height;
        tile-radius: root.tile-radius;
        // No cover and no path, so `ArtworkImage` takes its empty branch.
        fallback-icon: root.fallback-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
    }
}

// Reusable 1/2/3/4-tile artwork mosaic, and the live preview of what
// `media::artwork::compose_artwork` will bake: the layouts are shared, so the picker shows the
// collage it is about to persist. That function rather than its lenient sibling `compose_cover` is
// what makes the preview a promise — a source dropping out would bake a collage slot-for-slot
// different from this one. Pure layout — the caller owns the outer chrome and only the
// inner tiles are drawn here, so no paths draws nothing and the caller's own empty state shows
// through. Tiles resolve through `request-cover`, so a consumer keeps its own LRU tier.
//
// One consumer: `components/dialog/playlist-mosaic-picker.slint`. The curated heroes drew this
// once and now draw the composed collage itself, so the styling inputs below are the picker's
// defaults rather than a set anyone overrides.
export component CoverMosaic inherits Rectangle {
    in property <[string]> artwork-paths;
    in property <length>   gutter-size: 3px;
    // Pass `0px` (with `gutter-size: 0px`, so the outer background can't bleed
    // through) for a flush mosaic reading as one composited image — right where
    // the surrounding chrome already supplies the only curve.
    in property <length>   tile-radius: Theme.radius-sm;
    // The `ArtworkImage` placeholder vocabulary, shared with `EntityCard` and
    // `LibraryTabBand`.
    in property <string>   placeholder-icon: "music-note";
    // `ArtworkImage`'s accent tint, which is right on the dialog surface this sits on.
    in property <brush>    tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush>    tile-icon-color: Theme.accent;
    pure callback request-cover(string) -> image;

    private property <int> effective-count: root.artwork-paths.length;

    if root.effective-count == 1: MosaicSlot {
        idx: 0;
        artwork-paths: root.artwork-paths;
        tile-radius: root.tile-radius;
        fallback-icon: root.placeholder-icon;
        tile-bg: root.tile-bg;
        tile-icon-color: root.tile-icon-color;
        request-cover(p) => { return root.request-cover(p); }
    }

    if root.effective-count == 2: HorizontalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        MosaicSlot {
            idx: 0;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
        MosaicSlot {
            idx: 1;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
    }

    if root.effective-count == 3: HorizontalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        MosaicSlot {
            idx: 0;
            horizontal-stretch: 1;
            artwork-paths: root.artwork-paths;
            tile-radius: root.tile-radius;
            fallback-icon: root.placeholder-icon;
            tile-bg: root.tile-bg;
            tile-icon-color: root.tile-icon-color;
            request-cover(p) => { return root.request-cover(p); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 1;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 2;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
    }

    if root.effective-count >= 4: VerticalLayout {
        spacing: root.gutter-size;
        padding: root.gutter-size;
        HorizontalLayout {
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 0;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 1;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
        HorizontalLayout {
            spacing: root.gutter-size;
            MosaicSlot {
                idx: 2;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
            MosaicSlot {
                idx: 3;
                artwork-paths: root.artwork-paths;
                tile-radius: root.tile-radius;
                fallback-icon: root.placeholder-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
                request-cover(p) => { return root.request-cover(p); }
            }
        }
    }
}
