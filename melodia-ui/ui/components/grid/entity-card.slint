import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { IconButton } from "../icon-button.slint";
import { MaterialIcon } from "../material-icon.slint";

// Reusable entity card for grid views — Albums today; Artists / Genres /
// Playlists as they land. A square artwork tile with an elided title and
// elided subtitle stacked beneath it, inside a hover-highlighted rounded
// surface. The artwork zooms slightly on hover (shared `ArtworkImage`
// `cover-scale` affordance).
//
// The outer slot is a fixed `card-width × card-height` so the grid layout
// stays stable; the caller (`AlbumView`) computes both from the available
// width and passes them down through `AlbumGrid`. A trailing stretch
// Rectangle absorbs any slack so a slightly generous `card-height` doesn't
// distort the artwork / text spacing.
export component EntityCard inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // Circular artwork mode — used by the Artists view to render artist
    // avatars (matches Tauri's `circular` prop). The artwork tile becomes
    // a perfect circle by setting `tile-radius` to half the tile size;
    // the text block beneath stays square-aligned.
    in property <bool> circular: false;
    // Forwarded to `ArtworkImage.fallback-icon`. The Artists view passes
    // `"person"`; defaults to `"music-note"` for album / genre / playlist.
    in property <string> fallback-icon: "music-note";

    // Forwarded to `ArtworkImage.tile-bg` / `tile-icon-color`. Callers
    // that want a non-default tile chrome (e.g. the Genres grid paints a
    // per-genre name-hash linear-gradient and tints the fallback glyph
    // white) override these; defaults fall through to `ArtworkImage`'s
    // own `Theme.accent`-tinted defaults.
    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;

    // Cover-scale factor while the card is hovered. Default 1.04 is the
    // gentle Albums / Artists zoom; the Genres grid bumps it to 1.15 so
    // the procedural fallback glyph mirrors the now-playing-bar tile's
    // more pronounced hover zoom (no real artwork on a genre card, so a
    // subtle scale reads as no scale at all).
    in property <float> cover-scale-hover: 1.04;

    // Opt-in hover-revealed action trio (delete / edit-artwork / edit-name)
    // inside the artwork tile region. Used by the Playlists grid to expose
    // CRUD shortcuts without a per-card overflow menu; off everywhere else.
    in property <bool> show-overlay-actions: false;

    // Opt-in persistent corner badge (a Material Symbols ligature name).
    // Empty ⇒ no badge. Used by the Playlists grid to mark smart (dynamic)
    // playlists; off everywhere else.
    in property <string> badge-icon: "";

    callback clicked();
    callback delete-clicked();
    callback edit-artwork-clicked();
    callback edit-name-clicked();

    // Unified card-hover signal. Slint's higher-z TouchArea captures the
    // pointer, so a hover over any nested `IconButton` flips
    // `touch.has-hover` false — every hover-driven binding on this card
    // (background, cover-scale, overlay opacity) reads `card-hovered`
    // instead so they all stay true while the user is aiming at a button.
    // Each `*_btn.has-hover` is `false` when the buttons are hidden
    // (`overlay.visible == false` propagates), so this stays correct on
    // album/artist/genre cards that don't use `show-overlay-actions`.
    property <bool> card-hovered: touch.has-hover
        || delete_btn.has-hover
        || artwork_btn.has-hover
        || name_btn.has-hover;

    width: card-width;
    height: card-height;

    inner := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-md;
        background: root.card-hovered ? Theme.surface0 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-sm;

            ArtworkImage {
                artwork-path: root.artwork-path;
                cover: root.cover;
                tile-size: root.card-width - 2 * Theme.pad-sm;
                tile-radius: root.circular
                    ? (root.card-width - 2 * Theme.pad-sm) / 2
                    : Theme.radius-md;
                cover-scale: root.card-hovered ? root.cover-scale-hover : 1.0;
                fallback-icon: root.fallback-icon;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
            }

            VerticalLayout {
                spacing: 2px;
                // The "‎" LRM prefix keeps mixed-script titles from drifting
                // — same trick the track rows / now-playing bar use.
                Text {
                    text: "‎" + root.title;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "‎" + root.subtitle;
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    visible: root.subtitle != "";
                }
            }

            // Absorbs any slack so the artwork + text block stays top-pinned
            // regardless of the exact `card-height` the host computes.
            Rectangle { vertical-stretch: 1; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Hover-revealed action overlay. Sits AFTER `touch` so the nested
    // IconButton TouchAreas consume their own clicks before `touch.clicked`
    // fires the card's open action. The overlay matches the artwork tile
    // square (same `tile-size` formula as the ArtworkImage inside `inner`,
    // line 65) so the icons frame the artwork rather than the title row.
    //
    // Always-mounted (not behind an `if`) so the EntityCard root can
    // reference each `*_btn.has-hover` from `card-hovered`. `visible:
    // root.show-overlay-actions` propagates to the children, so the
    // buttons are not rendered, hit-tested, or hover-tracked when the
    // host (Albums / Artists / Genres) doesn't opt in.
    overlay := Rectangle {
        visible: root.show-overlay-actions;
        x: Theme.pad-sm;
        y: Theme.pad-sm;
        width: root.card-width - 2 * Theme.pad-sm;
        height: root.card-width - 2 * Theme.pad-sm;

        opacity: root.card-hovered ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }

        delete_btn := IconButton {
            x: parent.width - self.width - Theme.pad-sm;
            y: Theme.pad-sm;
            icon: "delete";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            hover-fg: Theme.danger;
            clicked => { root.delete-clicked(); }
        }

        artwork_btn := IconButton {
            x: Theme.pad-sm;
            y: parent.height - self.height - Theme.pad-sm;
            icon: "image";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            clicked => { root.edit-artwork-clicked(); }
        }

        name_btn := IconButton {
            x: parent.width - self.width - Theme.pad-sm;
            y: parent.height - self.height - Theme.pad-sm;
            icon: "edit";
            icon-size: 18px;
            diameter: 30px;
            idle-bg: Theme.floating-chrome-bg;
            clicked => { root.edit-name-clicked(); }
        }
    }

    // Persistent smart-playlist badge — top-left of the artwork tile, clear
    // of the hover action trio (delete top-right, edit-artwork/name bottom).
    // Non-interactive (no TouchArea) so card clicks pass through to `touch`.
    badge := Rectangle {
        visible: root.badge-icon != "";
        x: 2 * Theme.pad-sm;
        y: 2 * Theme.pad-sm;
        width: 28px;
        height: 28px;
        border-radius: self.height / 2;
        background: Theme.floating-chrome-bg;
        MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.badge-icon;
            icon-size: 18px;
            icon-color: Theme.accent;
            filled: true;
        }
    }
}
