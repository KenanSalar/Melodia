import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PlayCountBadge } from "play-count-badge.slint";

// The card every grid and strip draws: a square artwork tile with an elided title and subtitle
// beneath it, inside a hover-highlighted rounded surface. **The outer slot is a fixed size**, so
// the grid layout stays stable — the host computes both dimensions from the available width — and a
// trailing stretch Rectangle absorbs any slack, so a generous height doesn't distort the spacing.
export component EntityCard inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    // A third line, for a card whose tile sits above three. Empty on every other host, and the
    // dimmest of the three: a card that wants two lines says nothing and gets the layout it had.
    in property <string> subtitle2;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The Artists grid's avatar mode: the tile takes a radius of half its size, the text staying
    // square-aligned.
    in property <bool> circular: false;
    // Artists passes `"person"`; everything else takes the default.
    in property <string> fallback-icon: "music-note";
    // Initials to draw instead of the glyph, for a host whose entities have no shared icon worth
    // repeating across a page. Both fall through to `ArtworkImage`, which prefers the text.
    in property <string> fallback-text;
    // What the stored image would draw at 1:1, for a source too small to fill the tile. `0px`
    // means "assume it fills", which is `ArtworkImage`'s own default and every host's answer but
    // the one drawing favicons.
    in property <length> native-size: 0px;

    // The tile's chrome. The Genres grid overrides both, painting its per-genre name-hashed
    // gradient and tinting the fallback glyph against it.
    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;

    // The Genres grid raises this: with no real artwork on a genre card, a subtle scale
    // reads as no scale at all.
    in property <float> cover-scale-hover: 1.04;

    // Whether the host put controls in the `@children` overlay slot, and the whole of what this
    // gates. **Not a list of buttons this card owns** — it carried the Playlists CRUD trio once,
    // which every other host raising the flag then drew on top of its own controls.
    in property <bool> show-overlay-actions: false;

    // Hover on any control the *host* owns, OR'd into `card-hovered` below. Usually the ones in
    // the overlay slot, but not only: a station card folds in its star too, which sits beside the
    // card and takes the pointer off `touch` just the same.
    // A component cannot read `has-hover` off its `@children`, so the host that named those
    // buttons is the only thing that can answer, and without the answer the fill and the zoom
    // drop out while the pointer is on one of them.
    in property <bool> overlay-hovered: false;

    // Browse's card view draws disk-only files — present inside a library folder but
    // not in the DB — and dims them inert, the same 0.45 the disabled `TrackListRow`
    // takes. Defaulted `true`, so every other mount is unaffected; `touch` is gated on
    // it, which drops the hover fill, the zoom and the pointer cursor together rather
    // than leaving a card that looks live and does nothing.
    in property <bool> enabled: true;

    // A Material Symbols ligature, marking a smart playlist. Empty means no badge.
    in property <string> badge-icon: "";

    // The play count on the Most Played surfaces, drawn by the shared badge rather than
    // by this card. Shares the corner with `badge-icon`; no caller sets both.
    in property <int> play-count: 0;

    callback clicked();

    // **Every hover-driven binding on this card reads this, not `touch.has-hover`.** A
    // higher-z TouchArea captures the pointer, so hovering any nested button flips that
    // false and the fill, the zoom and the overlay would all drop out while the user is
    // aiming at one — which is what `overlay-hovered` is for.
    // `out`, so a host placing a control *beside* the card rather than in the overlay slot can
    // ride the same answer — the star on a station card is the one such control.
    out property <bool> card-hovered: touch.has-hover || root.overlay-hovered;

    // The artwork square, published because a host positioning against it must not re-derive the
    // formula: a station card sizes its favicon's 1:1 estimate off this, and a padding change here
    // would otherwise skew that silently.
    out property <length> tile-size: root.card-width - 2 * Theme.pad-sm;

    width: card-width;
    height: card-height;
    opacity: root.enabled ? 1.0 : 0.45;
    animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }

    inner := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-md;
        background: root.card-hovered ? Theme.surface0 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }

        VerticalLayout {
            padding: Theme.pad-sm;
            spacing: Theme.pad-sm;

            ArtworkImage {
                artwork-path: root.artwork-path;
                cover: root.cover;
                tile-size: root.tile-size;
                tile-radius: root.circular ? root.tile-size / 2 : Theme.radius-md;
                cover-scale: root.card-hovered ? root.cover-scale-hover : 1.0;
                fallback-icon: root.fallback-icon;
                fallback-text: root.fallback-text;
                native-size: root.native-size;
                tile-bg: root.tile-bg;
                tile-icon-color: root.tile-icon-color;
            }

            VerticalLayout {
                spacing: 2px;
                // The LRM keeps mixed-script titles from drifting, as in the rows.
                Text {
                    text: "‎" + root.title;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "‎" + root.subtitle;
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    visible: root.subtitle != "";
                }
                Text {
                    text: "‎" + root.subtitle2;
                    color: Theme.overlay1;
                    font-size: Theme.font-size-sm;
                    overflow: elide;
                    visible: root.subtitle2 != "";
                }
            }

            // Absorbs the slack, so the block stays top-pinned whatever height the host
            // computes.
            Rectangle { vertical-stretch: 1; }
        }
    }

    touch := TouchArea {
        // A disabled TouchArea processes nothing, so a dimmed card gets no hover
        // background, no cover zoom and no click — the `TrackListRowItem` contract.
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The host's own hover controls, framing the artwork square rather than the title row, and
    // riding **one** `opacity` between them. That single fade is the point: an `opacity` per button
    // layers each of them, and `Opacity::need_layer` bails only on a lone childless child, which an
    // `IconButton` root is not. A control that has to stay up while the card is idle does not
    // belong here — it is not a hover affordance, so it goes beside the card and takes
    // `IconButton.fade`.
    //
    // **After `touch`**, so a nested button consumes its own click before the card's open action
    // fires. `visible` propagates to the children, so nothing here is rendered, hit-tested or
    // hover-tracked on a card whose host put no controls in the slot.
    overlay := Rectangle {
        visible: root.show-overlay-actions;
        x: Theme.pad-sm;
        y: Theme.pad-sm;
        width: root.tile-size;
        height: root.tile-size;

        opacity: root.card-hovered ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }

        @children
    }

    // Top-left of the tile, clear of the hover trio. Non-interactive, so card clicks
    // pass straight through.
    badge := Rectangle {
        visible: root.badge-icon != "";
        x: 2 * Theme.pad-sm;
        y: 2 * Theme.pad-sm;
        width: 28px;
        height: 28px;
        border-radius: self.height / 2;
        background: Theme.floating-chrome-bg;
        MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.badge-icon;
            icon-size: 18px;
            icon-color: Theme.accent;
            filled: true;
        }
    }

    // The same corner, hiding itself where the row has no plays behind it.
    PlayCountBadge {
        x: 2 * Theme.pad-sm;
        y: 2 * Theme.pad-sm;
        count: root.play-count;
    }
}
