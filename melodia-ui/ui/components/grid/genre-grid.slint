import { ListView } from "std-widgets.slint";
import { GenreGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";

// Virtualized genre-card grid: `AlbumGrid` minus the cover plumbing. A genre has
// no artwork, so each card falls back to its glyph and nothing here allocates an
// `Image` or needs an LRU. Rust chunks the flat list into rows of `columns`
// cards, so the inner `ListView` virtualizes by row.
//
// Same host-mounted-scrollbar contract as `TrackList` and `AlbumGrid`: the `v-*`
// properties and `set-v-offset` let the host place its `OverlayScrollbar` flush
// with the content-panel edge, outside its own padding.
export component GenreGrid inherits Rectangle {
    in property <[GenreGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // The gap is baked into the slot height because a `ListView` lays its
    // delegates back-to-back and has no `spacing`.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-genre(int /*genre_id*/);

    // Same sign convention as `TrackList` — a positive `v-offset` is N px
    // scrolled, where the inner `ListView` holds that as a non-positive
    // `viewport-y`, so the boundary negates.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for grid-row in root.rows: Rectangle {
            // A `ListView` delegate needs a fixed height or the virtualization
            // math breaks.
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for genre in grid-row.genres: EntityCard {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    // With no cover binding the card paints its glyph over a
                    // name-hashed gradient. Rust precomputes both stops on
                    // three independent axes — hue, hue offset, S/V jitter — so
                    // cards stay distinguishable even at neighbouring hues.
                    fallback-icon: "theater_comedy";
                    tile-bg: @linear-gradient(135deg,
                        genre.tile_color_1,
                        genre.tile_color_2);
                    tile-icon-color: #ffffff.with-alpha(0.3);
                    // The pronounced zoom, not the covers' gentle one: on a
                    // glyph drawn at just over half the tile, the gentle one
                    // reads as no zoom at all.
                    cover-scale-hover: 1.15;
                    title: genre.name;
                    // The duration arrives display-ready from Rust; the count
                    // takes the Artists grid's plural pair, since a genre can
                    // exist for a single track.
                    subtitle:
                        @tr("{n} track" | "{n} tracks" % genre.track_count)
                        + " · " + genre.display_duration;
                    clicked => { root.open-genre(genre.id); }
                }
            }
        }
    }
}
