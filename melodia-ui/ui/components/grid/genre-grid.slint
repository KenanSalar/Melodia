import { ListView } from "std-widgets.slint";
import { GenreGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";

// Virtualized genre-card grid. Mirror of `AlbumGrid` minus the
// `request-cover` plumbing: genres have no intrinsic artwork, so each
// on-screen `EntityCard` falls back to its `fallback-icon` glyph and the
// model stays pure data. Rust chunks the flat genre list into rows of
// `columns` cards (see `src/ui/genres/grid.rs`), so the inner `ListView`
// virtualizes by row: only on-screen rows instantiate their `EntityCard`
// component instances. Memory stays trivially bounded — no per-card
// `Image` allocations, no LRU.
//
// Mirrors `TrackList` / `AlbumGrid`'s host-mounted-scrollbar contract:
// viewport metrics are exposed via the `v-*` out properties +
// `set-v-offset` so the host view mounts its `OverlayScrollbar` flush
// with the content-panel edge, outside whatever padding the host applies.
export component GenreGrid inherits Rectangle {
    in property <[GenreGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // Full row slot height — `card-height` plus the inter-row gap, baked
    // in so the `ListView` (which lays delegates back-to-back, no
    // `spacing`) gets even vertical gaps.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-genre(int /*genre_id*/);

    // Viewport metrics for a host-mounted `OverlayScrollbar`. Sign
    // convention matches `TrackList` / `AlbumGrid`: positive `v-offset`
    // = scrolled by N px; the inner `ListView` stores the same as a
    // non-positive `viewport-y`, so we negate at the boundary.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for grid-row in root.rows: Rectangle {
            // Pin the delegate's layout slot — a `ListView` delegate
            // needs a fixed height or the virtualization math breaks
            // (CLAUDE.md).
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for genre in grid-row.genres: EntityCard {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    // No artwork-path / cover binding: the card falls
                    // back to its `fallback-icon` glyph painted over a
                    // hash-derived linear-gradient. The two stops are
                    // precomputed in Rust on three independent axes
                    // (hue, hue-offset, S/V jitter) so cards stay
                    // visually distinguishable even at similar hues —
                    // see `src/ui/genres/color.rs::genre_accent`.
                    fallback-icon: "theater_comedy";
                    tile-bg: @linear-gradient(135deg,
                        genre.tile_color_1,
                        genre.tile_color_2);
                    // 30% white glyph over the saturated gradient,
                    // matching Tauri's `rgba(255, 255, 255, 0.3)`.
                    tile-icon-color: #ffffff.with-alpha(0.3);
                    // Match the now-playing-bar tile's hover zoom — a
                    // genre card carries no real artwork, only the
                    // procedural glyph, so the default 1.04 Albums /
                    // Artists zoom reads as no zoom at all on the
                    // 0.55× glyph. 1.15 puts the motion at the right
                    // perceptual level for the fallback-only tile.
                    cover-scale-hover: 1.15;
                    title: genre.name;
                    // Subtitle: track count · pre-formatted duration. The
                    // duration arrives display-ready from Rust; the count
                    // takes the same plural pair the Artists grid uses —
                    // a genre exists for as little as one track.
                    subtitle:
                        @tr("{n} track" | "{n} tracks" % genre.track_count)
                        + " · " + genre.display_duration;
                    clicked => { root.open-genre(genre.id); }
                }
            }
        }
    }
}
