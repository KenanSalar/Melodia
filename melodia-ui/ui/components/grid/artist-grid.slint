import { ListView } from "std-widgets.slint";
import { ArtistGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";

// Virtualized artist-card grid, `AlbumGrid`'s shape: Rust chunks the flat list
// into rows of `columns` cards and the inner `ListView` virtualizes by row. The
// cards are circular, and an art-less artist falls back to a silhouette rather
// than the music-note placeholder.
export component ArtistGrid inherits Rectangle {
    in property <[ArtistGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-artist(int /*artist_id*/);
    pure callback request-cover(string /*image_path*/) -> image;

    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for grid-row in root.rows: Rectangle {
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for artist in grid-row.artists: EntityCard {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    circular: true;
                    fallback-icon: "person";
                    artwork-path: artist.image_path;
                    cover: root.request-cover(artist.image_path);
                    // A pronounced zoom on the placeholder, as on the other
                    // grids; real artwork stays gentle so a cover doesn't
                    // jitter inside the tile clip on hover.
                    cover-scale-hover: artist.image_path == "" ? 1.15 : 1.04;
                    title: artist.name;
                    // The separator is punctuation; the album count drops out
                    // entirely at zero.
                    subtitle:
                        @tr("{n} track" | "{n} tracks" % artist.track_count)
                        + (artist.album_count > 0
                            ? " · " + @tr("{n} album" | "{n} albums" % artist.album_count)
                            : "");
                    clicked => { root.open-artist(artist.id); }
                }
            }
        }
    }
}
