import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// 16×16 custom checkbox shared by `track-list-row.slint` (selection state)
// and `column-toggle-popup.slint` (column visibility). Filled accent square
// when checked, hollow + surface1 border when not. The check glyph sits
// inside a fixed 14 px square so it centres in its em-box, not in the
// inflated line-box (CLAUDE.md Slint pitfall: Material Symbols glyphs need
// a collapsed line-box).
//
// The component is purely visual — callers wrap it in a `TouchArea` to
// drive the click semantics they need (the track-list-row's checkbox has
// shift / ctrl / range-select behaviour; the column-toggle's is a plain
// click).
export component Checkbox inherits Rectangle {
    in property <bool> checked;

    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: root.checked ? Theme.accent : transparent;
    border-color: root.checked ? Theme.accent : Theme.surface1;
    border-width: 1px;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; }

    if root.checked: MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "check";
        icon-size: 14px;
        icon-color: Theme.crust;
    }
}
