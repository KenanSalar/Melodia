import { Theme } from "../theme.slint";

// Reusable label + styled text input for dialog forms. Mirrors the
// SearchBar's input chrome (focus-tracking border + overlay placeholder
// — Slint's raw `TextInput` has no native placeholder) but adds a
// label row above and ships a fixed 36 px input height suitable for
// dialog/form contexts. Used twice in `dialog.slint`'s
// create/rename-playlist body for the Name and Description fields.
//
// Two-way bound `text` so the host (typically a `Dialog.input-text*`
// property) reflects user edits live. `accepted` fires on Enter — the
// host wires it to the dialog confirm path. `edited` fires on every
// keystroke if the host needs throttled feedback.
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    callback accepted();
    callback edited();

    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        font-weight: 600;
    }

    Rectangle {
        height: 40px;
        background: Theme.surface1;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-md;
        // Soft accent halo on focus — mirrors the SearchBar focus chrome
        // (`search-bar.slint`) so dialog fields and the global search read
        // as the same family. Halo collapses to zero when blurred.
        drop-shadow-color: input.has-focus
            ? Theme.accent.with-alpha(0.22)
            : transparent;
        drop-shadow-blur: input.has-focus ? 12px : 0px;
        drop-shadow-offset-y: input.has-focus ? 2px : 0px;
        animate border-color, drop-shadow-color, drop-shadow-blur,
                drop-shadow-offset-y {
            duration: Theme.dur-fast;
            easing: ease-in-out;
        }

        HorizontalLayout {
            padding-left: Theme.pad-md;
            padding-right: Theme.pad-md;

            Rectangle {
                horizontal-stretch: 1;
                // Placeholder overlay — Slint's `TextInput` has no
                // built-in placeholder, so we paint one in `overlay2`
                // and hide it the moment the user types. Same idiom
                // `search-bar.slint` uses, and the same rung — see the
                // note there for why `overlay0` is unreadable on the
                // light variants.
                Text {
                    visible: root.text == "";
                    text: root.placeholder;
                    color: Theme.overlay2;
                    font-size: Theme.font-size-md;
                    vertical-alignment: center;
                    x: 0;
                    height: 100%;
                }
                input := TextInput {
                    text <=> root.text;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    single-line: true;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    height: 100%;
                    accepted => { root.accepted(); }
                    edited => { root.edited(); }
                }
            }
        }
    }
}
