import { Theme } from "../theme.slint";
import { OverlayScrollbar } from "overlay-scrollbar.slint";
import { CompositeScroll } from "../globals/shell.slint";

// The unified scrollbar pair and wheel routing every composite view mounts: an outer
// `ScrollView` scrolls the sections while a height-capped, still-virtualizing inner
// `TrackList` scrolls the rows, and **one vertical bar spans both travels**, splitting
// drags at the boundary. The horizontal bar drives the list's column pan.
//
// It also owns the `CompositeScroll` wheel-tick watch — the global being a singleton,
// the mirror can live here, and only one composite view is mounted at a time, so there
// is exactly one live watcher. The winit filter bumps the tick after accumulating a
// delta, and the handler applies one composite step through the same split the drag
// uses, leaving the host's height cap and the inner virtualization untouched.
//
// Slint can't pass element handles into a component, so the host mirrors its named
// elements through plain properties plus two setters that forward to the list's own
// clamping ones. `outer-viewport-y` is two-way, so drags write back — an identity
// binding, so the sign-flip pitfall from the `OverlayScrollbar` round-trip doesn't apply.
//
// **Mount contract**: the *last* child of the view root, at full size and zero offset.
// The bars pin to this component's own right and bottom edges and the band coordinates
// are host-root-relative, so the two must be congruent for them to line up.
export component CompositeScrollbars inherits Rectangle {
    // Outer ScrollView mirror (`below-sv`).
    in-out property <length> outer-viewport-y;
    in property <length> outer-viewport-height;
    in property <length> outer-visible-height;

    // Read-only here; writes go through the setter so the list keeps clamping.
    in property <length> inner-offset;
    in property <length> inner-viewport-height;
    in property <length> inner-visible-height;
    callback set-inner-offset(length);

    // Inner TrackList horizontal (column-pan) mirror.
    in property <length> h-offset;
    in property <length> h-viewport-width;
    in property <length> h-visible-width;
    callback set-h-offset(length);

    // The below-hero region within the host root, so the bar starts under the banner.
    in property <length> v-region-y;
    in property <length> v-region-height;

    // Horizontal-bar band: the TrackList's x + width within the host root.
    in property <length> h-region-x;
    in property <length> h-region-width;

    // Both bars' hit thickness; the horizontal one reserves this much at its right end
    // so it never runs under the vertical one.
    property <length> bar-thickness: Theme.scrollbar-slot;

    // The outer travel covers the sections, the inner one the rows, and the bar spans
    // both — a drag splits its offset at the boundary.
    property <length> v-outer-max: max(0px, root.outer-viewport-height - root.outer-visible-height);
    property <length> v-inner-max: max(0px, root.inner-viewport-height - root.inner-visible-height);

    // **Pulls the outer offset back in range when content shrinks under it.** A
    // `Flickable` self-corrects only for a `viewport-y` that carries *no* binding, and
    // the mount contract binds it two-way. Every scroller that writes `viewport-y`
    // imperatively orphans its binding on the first write and gets the guard back;
    // `<=>` survives a self-write, so these views are the only ones permanently without
    // it — and that same survival is what makes writing the property here safe. Left
    // uncorrected the viewport parks past the end and the region paints blank: Browse
    // leaving a deep folder for the much shorter root list, or any of these filtering a
    // long list down to a few rows.
    changed v-outer-max => {
        if (-root.outer-viewport-y > root.v-outer-max) {
            root.outer-viewport-y = -root.v-outer-max;
        }
    }

    // A global can't be watched directly, so the tick is mirrored locally.
    property <int> cs-wheel-watch: CompositeScroll.wheel-tick;
    changed cs-wheel-watch => {
        vbar.scroll-to(clamp(
            (-root.outer-viewport-y + root.inner-offset) - CompositeScroll.wheel-dy,
            0px, root.v-outer-max + root.v-inner-max));
        // Consume the accumulated delta, so the filter starts its next batch from zero.
        CompositeScroll.wheel-dy = 0px;
    }

    // Covers the sections and the list together, pinned to the right edge.
    vbar := OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: root.v-region-y;
        width: root.bar-thickness;
        height: root.v-region-height;
        visible-size: root.outer-visible-height;
        content-size: root.outer-visible-height + root.v-outer-max + root.v-inner-max;
        offset: -root.outer-viewport-y + root.inner-offset;
        scroll-to(o) => {
            root.outer-viewport-y = -min(o, root.v-outer-max);
            root.set-inner-offset(max(0px, o - root.v-outer-max));
        }
    }

    // Drives the list's column pan only: the strips have their own horizontal
    // scrollbars, at different content widths and independent positions, so a unified
    // bottom bar would mean nothing for them.
    OverlayScrollbar {
        horizontal: true;
        x: root.h-region-x;
        y: parent.height - self.height;
        width: root.h-region-width - root.bar-thickness;
        height: root.bar-thickness;
        visible-size: root.h-visible-width;
        content-size: root.h-viewport-width;
        offset: root.h-offset;
        scroll-to(o) => { root.set-h-offset(o); }
    }
}
