import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";

// One of the three macOS "traffic-light" decoration buttons. Paints a
// 14 px circle in `circle-color` (or a neutral grey when the window is
// unfocused), with a hover-reveal glyph centred inside. The reveal is
// gated on `cluster-hovered`, not the button's own hover — moving the
// cursor across the three buttons should reveal all three symbols at
// once, not flicker per-button (matches real macOS).
//
// Click handling is the parent's responsibility — this component just
// fires `clicked()`. The macOS-style cluster is a sibling of the
// drag-region inside `custom-titlebar.slint`, so the parent layout
// chooses which side of the window the buttons sit on independently
// of the visual style they paint in.
export component MacOsTrafficLight inherits Rectangle {
    // The "live" circle fill (semantic Theme colour — red / yellow /
    // green — so the lights pick up the active palette rather than
    // hardcoded macOS hex codes). `brush` (not `color`) so a future
    // gradient theme can plug in.
    in property <brush> circle-color;
    // Material Symbols ligature: `"close"`, `"minimize"`, or `"add"`.
    in property <string> glyph-icon;
    in property <string> tooltip-text;

    // ORed cluster hover — true whenever the cursor is over ANY of the
    // three traffic lights. The owning cluster computes
    // `a.hovered || b.hovered || c.hovered` and forwards it down so all
    // three glyphs reveal/conceal together.
    in property <bool> cluster-hovered: false;

    // Read out by the cluster to compute `cluster-hovered`. Slint has no
    // first-class "child has-hover" upward channel, so each traffic light
    // exposes its TouchArea's `has-hover` as an out-property.
    out property <bool> hovered: touch.has-hover;

    // What actually gets painted. The "grey when unfocused" mirror reads
    // `Theme.window-focused`, written from winit's `Focused(bool)` event in
    // `src/ui/window_chrome/winit_filter.rs`. The unfocused fill is
    // `Theme.overlay0` — a theme-aware neutral grey that tracks the active
    // palette rather than hardcoding macOS's #D5D5D5.
    property <brush> fill: Theme.window-focused ? root.circle-color : Theme.overlay0;

    // The glyph has to contrast against whatever `fill` resolved to, which is
    // why this is derived here and not passed in: the fill can be any of three
    // semantic hues in any of ~20 palettes, plus the unfocused grey, and no
    // single Theme brush is right for all of them. `Theme.accent-text` used to
    // be handed down for the job, but that token answers a question about the
    // *accent* — pick Latte + the Yellow accent and it puts a near-black glyph
    // on the dark red close circle.
    property <brush> glyph-color: Theme.ink-on(root.fill);

    callback clicked();

    // 18 px wide click target — tight enough to give the cluster a
    // macOS-style ~20 px center-to-center cadence, but still Fitts-
    // friendly (cursor only needs ~7 px aim radius). 32 px tall so the
    // cell fills the titlebar's full vertical extent — GridLayout in
    // the cluster centres the 14 px circle inside it automatically
    // (children of Rectangle default to top-left, hence the explicit
    // x/y math below).
    min-width: 18px;
    max-width: 18px;
    min-height: 32px;
    max-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    // The painted circle. Diameter 14 px to read at typical desktop
    // viewing distance without feeling oversized for the 32 px bar.
    // Border-radius pinned to half the width so the rectangle is a
    // true circle even if Slint ever adds non-uniform DPI scaling
    // that drifts width vs. height.
    //
    // Centring math is intentionally all-integer: the click target is
    // 18 × 32 px, the circle is 14 × 14, so `(18 - 14) / 2 = 2 px` and
    // `(32 - 14) / 2 = 9 px` — both exact integers. Earlier revisions
    // used an 11 px glyph wrapped in `HorizontalLayout / VerticalLayout
    // { alignment: center }`, which left the glyph at sub-pixel
    // coordinates (`(14 - 11) / 2 = 1.5 px`); the renderer then snapped
    // differently on hover state changes, making the symbol appear to
    // jiggle right by ~1 px when the opacity fade kicked in. Sticking
    // to explicit x/y with even dimensions sidesteps the problem
    // entirely.
    circle := Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.fill;
        border-radius: self.width / 2;

        // The hover-reveal glyph. `add` substitutes for macOS's two
        // opposing triangles on the green button — Material Symbols
        // Rounded doesn't ship the inverted-arrow zoom glyph, and `add`
        // is the closest universally-recognised "expand / grow"
        // analogue. Sized to 10 px so it sits cleanly inside the 14 px
        // circle (2 px clearance each side); `MaterialIcon`'s inner
        // Text element self-centres within the 10 px box, and the box
        // itself is positioned via explicit x/y instead of wrapping
        // layouts — see the centring comment above.
        MaterialIcon {
            name: root.glyph-icon;
            icon-size: 10px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon-color: root.glyph-color;
            opacity: root.cluster-hovered ? 1.0 : 0.0;
            animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }
        }
    }

    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
