import { Theme } from "../theme.slint";
import { WindowChrome } from "../globals/shell.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";
import { MacOsTitleBarCluster } from "macos-titlebar-cluster.slint";

// Per-button cell. 40 px wide, full titlebar height. Hover paints a
// rounded background; the close button overrides `hover-bg` /
// `hover-fg` to flash the active theme's danger red. Bespoke rather
// than reusing `IconButton` because the titlebar buttons are
// rectangular (not circular) and need a `hover-bg` knob that
// `IconButton` doesn't expose. Kept private to this file — no reuse
// outside the titlebar.
component TitleBarButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip-text;
    in property <brush> hover-bg: Theme.surface0;
    in property <brush> idle-fg: Theme.overlay1;
    in property <brush> hover-fg: Theme.text;

    callback clicked();

    // Explicit min/max on both axes pin the cell as a layout child —
    // `height: 100%` triggered the CLAUDE.md unbounded-layout cycle and
    // collapsed sibling buttons to zero width.
    min-width: 40px;
    max-width: 40px;
    min-height: 32px;
    max-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    // Hover highlight is an inner Rectangle inset by 4 px on each side
    // so the painted pill is ~32 × 24 inside the 40 × 32 click target.
    // Mirrors Tauri's 2 px decorative top/bottom borders that visually
    // shrunk the hover surface — keeps the click target wide for
    // Fitts-friendly aim while making the highlight feel less heavy.
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        // Hover background tracks the window's outer corner radius so
        // every titlebar button (minimize / maximize / close) feels
        // visually matched to the window outline. The close button at
        // the top-right is naturally concentric with the window's arc
        // (4 px inset + outer radius `shell-radius` ⇒ inner radius
        // `shell-radius - 4 px` shares the same centre); the minimize
        // and maximize buttons aren't at a window corner but the same
        // value keeps all three hovers consistent. Clamped to >= 0 for
        // the Square preset (`shell-radius == 0 px`).
        //
        // Only the preset chips populate `Theme.shell-radius` (Square=0,
        // KDE=6, Win11=8, macOS=10, GNOME=15) — the manual stepper was
        // removed in `views/settings/appearance-section.slint`, so we
        // never hit a value in 1..=5 where the geometric subtraction
        // would yield a sub-3 px arc. No piecewise floor needed.
        //
        // Falls back to a friendly 6 px pill when the window is
        // maximized — the outline goes square then (see the outer
        // mantle shell in `app-window.slint`), so an arc of 0 would
        // feel too sharp on the buttons.
        border-radius: WindowChrome.is-maximized
            ? 6px
            : max(0px, Theme.shell-radius - 4px);
        background: touch.has-hover ? root.hover-bg : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 16px;
                icon-color: touch.has-hover ? root.hover-fg : root.idle-fg;
                animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
            }
        }
    }

    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Custom titlebar — 32 px tall, `Theme.mantle` background. Mirrors
// Tauri's `TitleBar.tsx` (logo + title on one side, drag region in the
// middle, decoration buttons on the opposite side) using Slint primitives.
//
// Drag handling is split: Slint tracks only **hover** over the drag region
// (plus double-click to toggle maximize), and Rust intercepts the actual
// press at the winit layer. Dragging from a `TouchArea` would strand its
// mouse grab — see `src/ui/window_chrome/`'s module docs for why.
//
// Maximize/restore icon swap reads `WindowChrome.is-maximized`, fed from
// winit `WindowEvent::Resized` so window-tile / Win+↑ shortcuts also update
// the icon.
//
// Style + side selection. The settings rows in
// `ui/views/settings/window-chrome-section.slint` write
// `Theme.titlebar-button-style` (Standard vs macOS) and
// `Theme.titlebar-button-side` (Right vs Left); the four conditional
// branches mount the appropriate cluster on the appropriate side.
// The buttons are inlined directly inside the outer HorizontalLayout
// (not wrapped in a sub-component) because a Rectangle-inheriting
// wrapper with conditional layout children reports 0 × 0 — see
// CLAUDE.md "Rectangle-inheriting components don't size from
// `if`-conditional children".
//
// The brand (logo + "Melodia" text) lives inside the drag-region and
// pins to whichever side of the window the buttons aren't on, so the
// two visual groups never overlap.
export component CustomTitleBar inherits Rectangle {
    // Pin the bar to a fixed 32 px slot in the parent VerticalLayout.
    // Plain `height: 32px` is ignored by the layout (CLAUDE.md "height
    // on a layout child + parent → unbounded layout"); the bar then
    // claims the whole window's vertical space, leaving the sidebar /
    // content / now-playing-bar with zero height.
    min-height: 32px;
    max-height: 32px;
    vertical-stretch: 0;
    background: Theme.mantle;

    HorizontalLayout {
        spacing: 0;
        alignment: stretch;
        // Inset on the brand side (12 px) so the logo / title doesn't
        // kiss the window edge; flush against the cluster side so the
        // close button sits at the corner.
        padding-left: Theme.titlebar-button-side == 1 ? 0 : 12px;
        padding-right: Theme.titlebar-button-side == 1 ? 12px : 0;

        // --- LEFT-SIDE CLUSTER ---------------------------------------
        // macOS-style traffic lights when style == 1 + side == 1.
        if Theme.titlebar-button-side == 1 && Theme.titlebar-button-style == 1: MacOsTitleBarCluster {}

        // Standard bar icons on the left, with close at the left corner
        // (so muscle-memory "click corner = close" still holds). Inlined
        // as three siblings inside the outer HBL — wrapping them in a
        // helper Rectangle produces a 0-width cell (CLAUDE.md
        // Rectangle-with-conditional-children gotcha).
        if Theme.titlebar-button-side == 1 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: "close";
            tooltip-text: @tr("Close");
            hover-bg: Theme.danger;
            // The on-danger ink, not a chrome token: `Theme.mantle` used to
            // stand in here and it tracks the theme's background rather than
            // the red, so GNOME Dark (dark red on a dark mantle) dropped the
            // glyph to ~2:1.
            hover-fg: Theme.danger-text;
            clicked => { WindowChrome.close-window(); }
        }
        if Theme.titlebar-button-side == 1 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: WindowChrome.is-maximized ? "filter_none" : "crop_square";
            tooltip-text: WindowChrome.is-maximized ? @tr("Restore") : @tr("Maximize");
            clicked => { WindowChrome.toggle-maximize(); }
        }
        if Theme.titlebar-button-side == 1 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: "minimize";
            tooltip-text: @tr("Minimize");
            clicked => { WindowChrome.minimize(); }
        }

        // --- DRAG REGION ---------------------------------------------
        // Drag area: wraps the brand (logo + "Melodia") plus the middle
        // stretch space so everything except the cluster is draggable.
        // The TouchArea only tracks `has-hover` — Rust reads the latest
        // value through `drag-region-hover-changed` and intercepts the
        // press at the winit layer. `double-clicked` is left on this
        // TouchArea because it fires *after* release, by which point
        // the press has been intercepted at the winit level — Slint
        // sees the second press normally.
        //
        // The brand pins to whichever side of the window is OPPOSITE
        // the cluster, so the two visual groups never crowd each other.
        // We accomplish this with a stretch spacer placed before or
        // after the logo+text based on `Theme.titlebar-button-side`:
        //   * side == 0 (buttons RIGHT) → spacer LAST  → brand pins LEFT
        //   * side == 1 (buttons LEFT)  → spacer FIRST → brand pins RIGHT
        drag-region := TouchArea {
            horizontal-stretch: 1;
            mouse-cursor: default;
            changed has-hover => {
                WindowChrome.drag-region-hover-changed(self.has-hover);
            }
            double-clicked => {
                WindowChrome.toggle-maximize();
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: stretch;

                // Leading spacer for side == Left so the brand floats to
                // the right edge of the drag region (i.e. the right edge
                // of the window minus the brand-side 12 px padding).
                if Theme.titlebar-button-side == 1: Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        source: @image-url("../assets/icons/logo-without-background.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Text {
                        text: "Melodia";
                        color: Theme.overlay2;
                        font-size: 12px;
                        font-weight: 500;
                    }
                }

                // Trailing spacer for side == Right so the brand pins to
                // the left edge of the drag region (current default).
                if Theme.titlebar-button-side == 0: Rectangle { horizontal-stretch: 1; }
            }
        }

        // --- RIGHT-SIDE CLUSTER --------------------------------------
        // macOS-style traffic lights when style == 1 + side == 0.
        if Theme.titlebar-button-side == 0 && Theme.titlebar-button-style == 1: MacOsTitleBarCluster {}

        // Standard bar icons on the right (current default Windows /
        // KDE order): min, max, close — close at the right corner.
        if Theme.titlebar-button-side == 0 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: "minimize";
            tooltip-text: @tr("Minimize");
            clicked => { WindowChrome.minimize(); }
        }
        if Theme.titlebar-button-side == 0 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: WindowChrome.is-maximized ? "filter_none" : "crop_square";
            tooltip-text: WindowChrome.is-maximized ? @tr("Restore") : @tr("Maximize");
            clicked => { WindowChrome.toggle-maximize(); }
        }
        if Theme.titlebar-button-side == 0 && Theme.titlebar-button-style == 0: TitleBarButton {
            icon: "close";
            tooltip-text: @tr("Close");
            hover-bg: Theme.danger;
            hover-fg: Theme.danger-text;
            clicked => { WindowChrome.close-window(); }
        }
    }

    // Resize affordance overlays for this bar are NOT mounted here.
    // The whole-window resize ring (top / right / bottom / left
    // edges + 4 corners) lives in `ui/app-window.slint` so it can
    // also suppress hover on the scrollbar at the right edge and on
    // the now-playing bar at the bottom — not just the titlebar
    // buttons. See the ResizeAffordances block there.
}
