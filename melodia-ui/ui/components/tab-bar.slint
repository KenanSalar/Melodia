import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// One tab. Unexported — only useful as a child of the bar.
//
// **No fill marks the selected tab**, per Material 3: the accent label, the FILL=1 icon and
// the sliding underline carry it three ways. A deliberate break from the ChipGroups *inside*
// the settings rows, which do fill — the bar navigates, the chips configure.
component TabBarCell inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool>   selected;
    // Defaulted at the bar rather than here, so the two can't disagree about "unset".
    in property <brush>  label-color-idle;
    in property <brush>  active-color;
    in property <brush>  hover-fill;
    // 0 expanded, 1 compact. A scalar rather than a bool, so the label closes onto its icon
    // instead of vanishing between two frames.
    in property <float>  compact-t;

    callback clicked();
    // Mirrored into a local property because `changed` won't take `touch.has-hover` directly.
    callback hover-changed(bool);

    property <float> open: 1.0 - root.compact-t;
    // Measured off the Text the cell draws, so measured and drawn shapes can't drift. A
    // no-wrap Text's `preferred-width` is intrinsic to the string and never reads back the
    // width it was handed, so this is a derivation and not a cycle.
    property <length> label-w: lbl.preferred-width;
    // Gone by the time the slot is half closed, so the clip never shows a half-eaten word.
    // Biased off the same source rather than given an `animate`, which would phase-lag.
    property <float> label-alpha: clamp(1.0 - root.compact-t * 2.0, 0.0, 1.0);

    // **The cell eases floats and never a brush.** Every colour it paints comes from its
    // host, and a host on a hero band crosses those for the length of a morph — an animated
    // binding restarts on *dirtiness*, so a leaf easing one sits still until the source
    // settles. `touch.has-hover ? fill : transparent` is no escape: the tab you point at while
    // clicking *is* the hovered arm.
    property <float> hover-t: touch.has-hover ? 1.0 : 0.0;
    animate hover-t { duration: Theme.dur-fast; easing: ease-in-out; }

    // Eased on the underline's own duration and curve, so the label and glyph reach the accent
    // as the pill arrives beneath them.
    property <float> sel-t: root.selected ? 1.0 : 0.0;
    animate sel-t { duration: Theme.dur-med; easing: ease-in-out; }

    horizontal-stretch: 0;

    // `SidebarItem`'s factor and back-out curve, which is what makes it a wobble rather than a
    // dip. **Only the factor is animated**, never the sizes derived from it — those move every
    // frame of a compact morph, so easing them sets every tab wobbling through a resize.
    property <float> press-scale: touch.pressed ? 0.97 : 1.0;
    animate press-scale {
        duration: touch.pressed ? 100ms : Theme.dur-med;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    // What the bar's ruler measures, spelled out rather than left to the root's child-merge:
    // Slint merges a `Rectangle` root's constraints with its children's but **drops any child
    // carrying explicit geometry**, and `cell` binds its width — so the root would report the
    // bare default, `natural-tab-w` would measure zero and the bar would never go compact.
    preferred-width: content.preferred-width;

    // The root keeps the whole layout slot, so a press never reflows the row or moves the
    // underline out from under its tab. Rounded rather than M3's square full-bleed rectangle,
    // so a hovered tab reads as part of its page; clearance from the divider is the bar's to
    // give, as padding on the row.
    cell := Rectangle {
        width: parent.width * root.press-scale;
        height: parent.height * root.press-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // **`transparentize` and not `with-alpha`**: it *multiplies* alpha where `with-alpha`
        // sets it, so a hero band's translucent tier keeps its own weight at full hover.
        background: root.hover-fill.transparentize(1.0 - root.hover-t);
        border-radius: Theme.radius-md;

        // Padding and spacing close with the label rather than switching, so the row collapses
        // to the icon and the icon glides to the middle with no arithmetic of its own.
        content := HorizontalLayout {
            padding-left: Theme.pad-md * root.open;
            padding-right: Theme.pad-md * root.open;
            spacing: Theme.pad-sm * root.open;
            alignment: center;

            // **Two glyphs rather than one eased brush** — `mix()` takes `color` operands and
            // both are `brush`, and the cell may not `animate` either, so a blend is a stack.
            // The idle one paints at **full alpha underneath**: layers at `t` and `1 - t`
            // composite to three quarters coverage at the midpoint and the glyph visibly
            // thins. Both take the same `filled`, so this crossfades colour only —
            // divergence in anything else is a ghost.
            //
            // The wrapper needs its own geometry: `MaterialIcon` binds `width`/`height`, so a
            // container merges nothing from it and would report 0×0.
            VerticalLayout {
                alignment: center;
                Rectangle {
                    // Scaled directly for the `SidebarItem` reason: a container shrinking
                    // 3% moves the glyph a pixel and nothing else, so in compact mode —
                    // where the icon *is* the tab — the press would otherwise read as inert.
                    width: 22px * root.press-scale;
                    height: self.width;

                    MaterialIcon {
                        name: root.icon;
                        icon-size: parent.width;
                        icon-color: root.label-color-idle;
                        filled: root.selected;
                    }

                    MaterialIcon {
                        name: root.icon;
                        icon-size: parent.width;
                        icon-color: root.active-color.transparentize(1.0 - root.sel-t);
                        filled: root.selected;
                    }
                }
            }

            // **Always mounted** — an `if` here makes the compact flip a pop — and closed by
            // shrinking its width to nothing. Rectangular and borderless on purpose: that
            // lowers to a scissor, where a rounded clip renders the text to an offscreen layer
            // and upscales it on HiDPI. Left-aligned, so the clip eats the tail first.
            Rectangle {
                clip: true;
                horizontal-stretch: 0;
                width: root.label-w * root.open;

                // The pair the glyph above is, for the same reasons. Alpha on the brush
                // throughout, never `opacity` on the element — that costs a layer, and there
                // are two per tab.
                lbl := Text {
                    text: root.label;
                    color: root.label-color-idle.transparentize(1.0 - root.label-alpha);
                    // Text doesn't scale with its container, so the press factor reaches it
                    // directly; `label-w` follows for free, being this Text's own
                    // `preferred-width`.
                    font-size: Theme.font-size-md * root.press-scale;
                    // **One weight for both states.** The bar sizes its cells off a measured
                    // maximum, so a heavier selected label could overflow the cell it was
                    // measured for and switching tabs would reflow the row.
                    font-weight: 500;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Text {
                    text: root.label;
                    // Both fades multiply — `with-alpha` would set — so the compact close still
                    // takes the word away whichever tab is selected.
                    color: root.active-color
                        .transparentize(1.0 - root.label-alpha * root.sel-t);
                    font-size: Theme.font-size-md * root.press-scale;
                    font-weight: 500;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <bool> is-hovered: touch.has-hover;
    changed is-hovered => { root.hover-changed(root.is-hovered); }
}

// Material 3 tab bar. Data-agnostic — parallel label/icon arrays in, picked index out, the
// `ChipGroup` / `Dropdown` / `ColorDotGrid` shape.
//
// **`labels` must arrive as an inline `[@tr("…"), …]` literal at the call site**, `@tr`
// registering msgids at codegen, so an array populated from Rust renders untranslated.
//
// The cells are equal width, sized to the widest tab, and that is what makes the underline
// pure arithmetic: a `for` loop exposes no per-tab element to read a position off, so a
// content-sized row would snapshot each tab's geometry on selection and go stale on resize.
export component TabBar inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> icons;

    // **Every brush the bar paints with is an input.** The defaults are the Settings page's
    // plain case; a bar on a hero blur hands over `HeroBackdrop` tiers instead, a `Theme.*`
    // brush answering a question about the *page* background and under a hero there being
    // none. `active-color` drives the selected label, its FILL=1 icon and the underline.
    in property <brush> label-color: Theme.text;
    in property <brush> active-color: Theme.accent;
    in property <brush> hover-fill: Theme.surface0;
    // `surface1` rather than `Theme.border`: all four Catppuccin flavours set `border` to
    // exactly `surface0`, so the line would vanish under whichever cell the pointer is on.
    in property <brush> divider-color: Theme.surface1;
    // Feed it a **mirrored** width, never a live `parent.width` read — see the host's `page-w`.
    in property <length> avail-width;
    // Two-way, per the orphaned-one-way-binding pitfall.
    in-out property <int> selected-index;
    // The tab active when the pick was made. A cell writes `selected-index` before it emits
    // `selected` — it has to, that binding carrying the pick out — so a host's handler already
    // reads the *new* tab, and the old one is recoverable nowhere else.
    out property <int> previous-index;

    callback selected(int);

    // Enough for the host to draw the compact-mode tooltip on a layer of its own. **It can't
    // live on the tab**: the pill anchors below the bar and Slint paints in declaration order,
    // so anything the header owns is covered by the scroll body. Equal-width cells let the
    // host derive the rect from the index rather than snapshotting one that goes stale.
    out property <int> hovered-idx: -1;
    out property <string> hovered-label:
        root.hovered-idx >= 0 ? root.labels[root.hovered-idx] : "";

    // **Measured, not thresholded against a literal**, the labels being translated. It also
    // can't chase the flip — `natural-tab-w` comes off an always-expanded column, so it
    // doesn't move when `compact` flips or while the flip plays out.
    property <length> natural-tab-w: measure.preferred-width;
    // What's left of a cell once its label closes: the glyph in the minimum touch target.
    property <length> compact-tab-w: 48px;
    // The narrowest the bar will ever draw, published so a host sharing its row reserves
    // against the bar's own number rather than a restated literal.
    out property <length> compact-w: root.labels.length * root.compact-tab-w;
    // The width below which the labels no longer fit.
    property <length> expand-w: root.labels.length * root.natural-tab-w;

    // Going compact and coming back out are separated by a band: a slow resize drag delivers
    // a stream of one-pixel widths and a hand jitters over the last of them, so a bare
    // comparison flips on every one that straddles the line. Only the *latch* is stateful —
    // the threshold is re-derived each time, so a locale switch still moves it.
    property <length> hysteresis: 24px;
    property <bool> latched: false;
    out property <bool> compact:
        root.avail-width < root.expand-w + (root.latched ? root.hysteresis : 0px);
    changed compact => {
        root.latched = root.compact;
        root.compact-t = root.compact ? 1.0 : 0.0;
    }

    // **Two sources, and everything geometric derives from them unanimated** — cells, bar
    // width, pill, both divider segments, the host's tooltip rect. Easing a *derived* geometry
    // phase-lags it, and easing `ind-x` conflates picking a tab with the cells resizing under
    // a compact flip, so the pill flies in with its two edges travelling different distances.
    property <float> anim-index: root.selected-index;
    animate anim-index { duration: Theme.dur-med; easing: ease-in-out; }

    // `compact` is the decision; this is that decision rendered over time.
    //
    // **The binding is only a seed** — `changed compact` owns the property from the first flip
    // on, which is why the morph plays at one speed however slowly the window is dragged. An
    // animated binding restarts whenever a dependency is marked *dirty*, and `compact` reads
    // `avail-width`, which a resize drag rewrites on every pointer motion. Writing routes
    // through `set_animated_value`, replacing the binding; keeping it as the seed leaves mount
    // in `NotAnimating`. `mini-player-switch.slint`'s `fade-opacity` is the same shape.
    property <float> compact-t: root.compact ? 1.0 : 0.0;
    // M3's emphasized-decelerate, inlined rather than `Theme.dur-spatial`: this fires under the
    // user's hand on a resize drag, where the spatial token's tail reads as the bar lagging.
    // Both y control points sit inside [0, 1], so no derived width goes negative.
    //
    // Gated on `eased`, the first resolution being the bar learning how much room it has
    // rather than a change: the host seeds `avail-width` at its header row's floor.
    animate compact-t {
        duration: root.eased ? 350ms : 0ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    // 100 ms rather than the tree's usual 1 ms mount seed: this has to **outlast** the
    // host's first `changed width`, not race it, and no hand crosses the threshold that
    // fast. Resets for free — the page is rebuilt on every entry, so each mount re-arms.
    property <bool> eased: false;
    Timer {
        interval: 100ms;
        triggered => {
            root.eased = true;
            self.running = false;
        }
    }

    out property <length> tab-w:
        root.natural-tab-w + (root.compact-tab-w - root.natural-tab-w) * root.compact-t;
    property <length> ind-x: root.tab-w * root.anim-index;

    // Rectangular and only rectangular — no border, no radius, so it lowers to a scissor
    // rather than the offscreen layer a *rounded* clip over text would cost.
    //
    // What it contains is the shrink leg of the morph: `compact` flips the instant the
    // threshold is crossed but `tab-w` takes the full duration to follow, so for that window
    // `preferred-width` is a row of natural cells against a header that can no longer seat
    // them, and the incompressible cells draw past the right edge under the search input.
    clip: true;
    height: 48px;
    horizontal-stretch: 0;

    // **Three constraints rather than one bound `width`**, so the floor stays at the compact
    // width while the bar draws expanded. Slint reports a component root's bound `width` as
    // both `min` and `max` — and rejects a `min-width` beside it — so a bound `width` puts
    // the bar's minimum on `tab-w`, and that climbs the header row out to the window, easing
    // the *window's* own minimum along with the morph: dragging inward then chases a moving
    // wall, and the bar becomes the constraint stopping the window reaching the width its own
    // threshold waits for.
    //
    // `preferred` still tracks the animated cells, so a centring host draws the bar exactly as
    // a bound `width` did, and `max` keeps the half that mattered — the bar can't stretch.
    min-width: root.compact-w;
    preferred-width: root.labels.length * root.tab-w;
    max-width: root.labels.length * root.tab-w;

    // The ruler: **real `TabBarCell`s**, not a stripped-down copy, so measured and drawn
    // shapes can't drift. `visible: false` lowers to a 0×0 clip — nothing paints, the hidden
    // TouchAreas are unreachable, and the layout info it exists for is still computed.
    // Palette left at the defaults, no brush moving a width.
    measure := VerticalLayout {
        visible: false;
        for tab-label[i] in root.labels: TabBarCell {
            label: tab-label;
            icon: root.icons[i];
            compact-t: 0.0;
        }
    }

    HorizontalLayout {
        alignment: start;
        // Reserves the bottom band for the divider and the pill, so a hovered tab's
        // rounded fill floats above the line instead of resting on it — and the content
        // re-centres in what's left rather than the bar getting taller.
        padding-bottom: Theme.pad-sm;

        for tab-label[i] in root.labels: TabBarCell {
            width: root.tab-w;
            label: tab-label;
            icon: root.icons[i];
            selected: i == root.selected-index;
            compact-t: root.compact-t;
            label-color-idle: root.label-color;
            active-color: root.active-color;
            hover-fill: root.hover-fill;
            clicked => {
                // Before the write, not after — `selected-index` is the only record of
                // where the pick came from.
                root.previous-index = root.selected-index;
                root.selected-index = i;
                root.selected(i);
            }
            hover-changed(hovered) => {
                if (hovered) {
                    root.hovered-idx = i;
                } else if (root.hovered-idx == i) {
                    // Only the tab owning the hover may retract it, else a leave
                    // arriving after its neighbour's enter blanks a live tooltip.
                    root.hovered-idx = -1;
                }
            }
        }
    }

    // Two segments, so the line stops either side of the pill rather than running under
    // it. Both read `ind-x` directly — the pill's own source — so they cut with it
    // instead of lagging a frame.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: root.ind-x;
        height: 1px;
        background: root.divider-color;
    }

    Rectangle {
        x: root.ind-x + root.tab-w;
        y: parent.height - 1px;
        width: root.width - self.x;
        height: 1px;
        background: root.divider-color;
    }

    // Last, so it paints over the divider. `self.height / 2` is safe unclamped here
    // because a cell is always far wider than the pill is tall, so the x-radius never
    // reaches the half-width that would pinch it into a lens.
    Rectangle {
        x: root.ind-x;
        y: parent.height - 3px;
        width: root.tab-w;
        height: 3px;
        background: root.active-color;
        border-radius: self.height / 2;
    }
}
