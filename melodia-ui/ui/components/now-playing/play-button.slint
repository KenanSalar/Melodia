import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { Tooltip } from "../tooltip.slint";

// The play / pause button shown in the now-playing bar. Owns its own
// hover-scale disc, the play / pause icon, the click hit-area, the
// tooltip — and the optional "Equalizer" overlay driven by
// `Settings.play-button-animation-idx`.
//
// The Equalizer overlay drives all four bars off a single shared
// phase-counter Timer instead of one `animate height` block per bar.
// Slint's animation engine re-evaluates every active `animate` per vsync
// frame, so four concurrent height animations cost ~240 interpolated
// updates per second; computing each bar's height directly from
// `4 * p * (1 - p)` (a parabolic "wave" that rises 0 → 1 → 0 over the
// period) drops that to one math binding per bar per Timer tick. When
// equalizer is active the play / pause icon is hidden so the bars take
// the icon's place; on pause the bars fall back to the icon.
export component PlayButton inherits Rectangle {
    in property <bool>   is-playing;
    in property <int>    animation-mode;        // 0 None | 1 Equalizer
    in property <length> wrapper-d: 38px;
    in property <length> icon-size: wrapper-d * 0.5;
    callback clicked();

    width: wrapper-d;
    height: wrapper-d;
    background: transparent;

    // Mirrors Tauri's PlayButtonAnimated hover / press scale: 1.05× on
    // hover, 0.9× on press. Press clamps to 100 ms (CSS `:active`
    // override); otherwise the expressive overshoot easing runs the
    // standard medium duration.
    property <length> disc-d: root.wrapper-d *
        (pp-touch.pressed ? 0.9 : (pp-touch.has-hover ? 1.05 : 1.0));

    property <bool> equalizer-active: root.is-playing && root.animation-mode == 1;

    // ---- Equalizer state ----------------------------------------------
    // One shared Timer at 33 ms (~30 fps) bumps four phase counters,
    // each with its own period — Tauri's 360 / 280 / 420 / 320 ms bar
    // durations become 720 / 560 / 840 / 640 ms full up-down cycles
    // (22 / 17 / 25 / 19 frames at 33 ms tick). Starting frames are
    // staggered (low / peak / mid-climb / mid-descend) so the first
    // paint isn't a flat line.
    property <int> bar1-cycle: 22;
    property <int> bar2-cycle: 17;
    property <int> bar3-cycle: 25;
    property <int> bar4-cycle: 19;
    property <int> bar1-frame: 0;
    property <int> bar2-frame: 8;
    property <int> bar3-frame: 6;
    property <int> bar4-frame: 14;

    eq-timer := Timer {
        interval: 33ms;
        running: root.equalizer-active;
        triggered => {
            root.bar1-frame = root.bar1-frame + 1;
            if (root.bar1-frame >= root.bar1-cycle) { root.bar1-frame = 0; }
            root.bar2-frame = root.bar2-frame + 1;
            if (root.bar2-frame >= root.bar2-cycle) { root.bar2-frame = 0; }
            root.bar3-frame = root.bar3-frame + 1;
            if (root.bar3-frame >= root.bar3-cycle) { root.bar3-frame = 0; }
            root.bar4-frame = root.bar4-frame + 1;
            if (root.bar4-frame >= root.bar4-cycle) { root.bar4-frame = 0; }
        }
    }

    // ---- Accent disc + icon / equalizer bars --------------------------
    pp-disc := Rectangle {
        width: root.disc-d;
        height: root.disc-d;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate width, height {
            duration: pp-touch.pressed ? 100ms : Theme.dur-med;
            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        // Play / pause icon — gated off when equalizer is taking its
        // place. `visible: false` keeps the icon out of layout, so the
        // bars (a fixed-size overlay below) sit on their own.
        HorizontalLayout {
            alignment: center;
            visible: !root.equalizer-active;
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: root.is-playing ? "pause" : "play_arrow";
                    filled: true;
                    icon-size: root.icon-size;
                    icon-color: Theme.accent-text;
                }
            }
        }

        // Equalizer bars — fixed-area overlay anchored to the disc's
        // bottom edge so the bars "grow up" from a baseline, matching
        // the spectrum-analyzer convention. 4 bars × 2 px + 3 × 2 px
        // gaps = 14 px wide; height bands cover 20 %–100 % of icon-size.
        if root.equalizer-active: Rectangle {
            property <length> bar-area-w: 14px;
            property <length> bar-area-h: root.icon-size;
            width: bar-area-w;
            height: bar-area-h;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;

            // Each bar's height is a parabolic wave `4 p (1 - p)` over its
            // phase counter — peaks at p=0.5, returns to 0 at p=0 and 1.
            // Cheap to compute, smooth at 30 fps, no `animate` engine
            // overhead.
            Rectangle {
                property <float> phase: 1.0 * root.bar1-frame / root.bar1-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 0;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: Theme.accent-text;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar2-frame / root.bar2-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 4px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: Theme.accent-text;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar3-frame / root.bar3-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 8px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: Theme.accent-text;
                border-radius: 1px;
            }
            Rectangle {
                property <float> phase: 1.0 * root.bar4-frame / root.bar4-cycle;
                property <float> wave: 4.0 * phase * (1.0 - phase);
                x: 12px;
                width: 2px;
                height: parent.bar-area-h * (0.2 + 0.8 * wave);
                y: parent.bar-area-h - self.height;
                background: Theme.accent-text;
                border-radius: 1px;
            }
        }
    }

    Tooltip {
        text: root.is-playing ? @tr("Pause") : @tr("Play");
        hovered: pp-touch.has-hover;
        host-width: parent.width;
    }

    pp-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
