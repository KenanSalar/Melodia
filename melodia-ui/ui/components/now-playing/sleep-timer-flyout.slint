import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PopupSurface } from "../popup-surface.slint";
import { FlyoutOption } from "flyout-option.slint";
import { FlyoutMetrics, SleepPresets } from "flyout-presets.slint";

// Round − / + stepper button. Reports press *down* and *up* (not just click) so
// the host can implement hold-to-accelerate. The `TouchArea` stays enabled even
// at a bound so the release event always fires (the host clamps the value); the
// button just dims to signal the bound.
component StepperButton inherits Rectangle {
    in property <string> icon;
    in property <bool> at-bound: false;

    // `down == true` on press, `false` on release / cancel.
    callback pressed-changed(bool /*down*/);

    width: 26px;
    height: 26px;
    border-radius: self.height / 2;
    // Darker "page background" fill (matches the content views), lifting to
    // `surface0` on hover.
    background: touch.has-hover && !root.at-bound ? Theme.surface0 : Theme.base;
    opacity: root.at-bound ? 0.4 : 1;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    MaterialIcon {
        name: root.icon;
        icon-size: Theme.font-size-md;
        icon-color: Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.pressed-changed(true);
            }
            if (ev.kind == PointerEventKind.up
                || ev.kind == PointerEventKind.cancel) {
                root.pressed-changed(false);
            }
        }
    }
}

// The sleep-timer flyout: quick presets + a custom ±stepper with a Start pill.
// Lives inside the overflow menu's single PopupWindow (no nested PopupWindow —
// the app's deliberate single-popup discipline), positioned to the LEFT of the
// menu column, mutually exclusive with the speed flyout. The host sets
// `width`/`height`/`x`/`y`; this component renders the rows and emits
// `pick(minutes)` (presets) / `start-custom(seconds)` (the stepper).
export component SleepTimerFlyout inherits PopupSurface {
    // Armed duration in seconds (0 = none), from `Player.sleep-timer-total-seconds`.
    in property <int> active-total-seconds;
    // True while "End of current track" mode is armed (from the backend VM).
    in property <bool> track-end-active;
    callback pick(int);          // preset value: 0 off / minutes / -1 end-of-track
    callback start-custom(int);  // custom duration in seconds

    // Custom-stepper bounds (mirror `MIN_/MAX_SLEEP_SECONDS` in sleep_timer.rs).
    property <int> min-seconds: 30;
    property <int> max-seconds: 2 * 60 * 60;
    // Pending value the ±stepper is dialing. Session-local — resets to the
    // 10-minute default each time the flyout is (re)mounted.
    property <int> pending-seconds: 10 * 60;

    // Hold-to-accelerate state.
    property <int> repeat-dir: 0;   // -1 / 0 / +1
    property <int> hold-ticks: 0;   // 90 ms ticks since the press began

    // Step size grows with hold time: 30 s → 1 min → 2 min → 5 min. `t` is in
    // 90 ms ticks, so 17 ≈ 1.5 s, 34 ≈ 3 s, 67 ≈ 6 s.
    pure function step-for-ticks(t: int) -> int {
        t >= 67 ? 300 : t >= 34 ? 120 : t >= 17 ? 60 : 30
    }
    function adjust(delta: int) {
        root.pending-seconds = clamp(root.pending-seconds + delta, root.min-seconds, root.max-seconds);
    }
    function press(dir: int) {
        root.hold-ticks = 0;
        root.adjust(dir * 30);   // a single tap = ±30 s
        root.repeat-dir = dir;   // starts the repeat timer
    }
    function release() {
        root.repeat-dir = 0;
    }

    repeat-timer := Timer {
        interval: 90ms;
        running: root.repeat-dir != 0;
        triggered => {
            root.hold-ticks += 1;
            // ~450 ms initial delay (5 ticks) before the repeat kicks in — the
            // press already applied one 30 s step, so a tap ≠ a hold.
            if (root.hold-ticks >= 5) {
                root.adjust(root.repeat-dir * root.step-for-ticks(root.hold-ticks));
            }
        }
    }

    VerticalLayout {
        padding: Theme.pad-xs;
        spacing: 0;

        // Presets live in the shared `SleepPresets` global — the host's
        // `sleep-flyout-h` reserve math reads the same list's length.
        for p in SleepPresets.list: FlyoutOption {
            label: p.label;
            active: p.value == -1
                ? root.track-end-active
                : (p.value * 60 == root.active-total-seconds && !root.track-end-active);
            clicked => { root.pick(p.value); }
        }

        // Divider between the quick presets and the custom stepper.
        Rectangle {
            height: 9px;
            Rectangle {
                width: parent.width - 2 * Theme.pad-sm;
                height: 1px;
                background: Theme.surface2;
            }
        }

        // Custom ±stepper: [−] [ M:SS ] [+]. Tap = ±30 s; hold accelerates.
        HorizontalLayout {
            height: FlyoutMetrics.option-row-h;
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-sm;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                StepperButton {
                    icon: "remove";
                    at-bound: root.pending-seconds <= root.min-seconds;
                    pressed-changed(down) => {
                        if (down) { root.press(-1); } else { root.release(); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Theme.format-duration(root.pending-seconds * 1000);
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                StepperButton {
                    icon: "add";
                    at-bound: root.pending-seconds >= root.max-seconds;
                    pressed-changed(down) => {
                        if (down) { root.press(1); } else { root.release(); }
                    }
                }
            }
        }

        // Rounded "Start" pill — arms the pending custom duration. Accent fill
        // (the primary action), lifting on hover.
        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            padding-top: Theme.pad-xs;
            start-btn := Rectangle {
                height: 28px;
                border-radius: self.height / 2;
                background: start-touch.has-hover ? Theme.accent.brighter(8%) : Theme.accent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                Text {
                    text: @tr("Start");
                    color: Theme.crust;
                    font-size: Theme.font-size-md;
                }
                start-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.start-custom(root.pending-seconds); }
                }
            }
        }
    }
}
