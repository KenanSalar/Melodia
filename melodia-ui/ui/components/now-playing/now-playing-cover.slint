import { Theme } from "../../theme.slint";
import { Player } from "../../globals/player.slint";
import { MaterialIcon } from "../material-icon.slint";

// The Now Playing view's foreground artwork tile. Unlike the shared
// `ArtworkImage` its frame never moves or resizes on a track change — only the
// content cross-fades, on the dual-slot contract the blurred backdrop uses: Rust
// writes into the inactive slot and flips the bool, and only `opacity` animates.
// A slot's `source` is NEVER cleared, so the outgoing cover stays painted for
// the whole fade rather than blinking to an empty frame. With no artwork both
// slots fade to 0 and the placeholder comes in.
export component NowPlayingCover inherits Rectangle {
    in property <length> tile-size;

    width: tile-size;
    height: tile-size;
    border-radius: Theme.radius-lg;
    // Backdrop-solved rather than a theme surface: this tile sits on the artwork
    // blur, where a light theme's surface reads as a white square through the
    // cross-fade. The low alpha keeps it a recess in the backdrop, not a slab
    // on it.
    background: Player.np-on-backdrop.with-alpha(0.08);
    clip: true;

    // Under the slots, faded out once a cover is there.
    Rectangle {
        opacity: Player.np-cover-has-image ? 0.0 : 1.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "music_note";
                    icon-size: root.height * 0.4;
                    icon-color: Player.np-on-backdrop-muted.with-alpha(0.5);
                }
            }
        }
    }

    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.np-cover-a;
        image-fit: ImageFit.cover;
        opacity: (Player.np-cover-has-image && Player.np-cover-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.np-cover-b;
        image-fit: ImageFit.cover;
        opacity: (Player.np-cover-has-image && !Player.np-cover-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
}
