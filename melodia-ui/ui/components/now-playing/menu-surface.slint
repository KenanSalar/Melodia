import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";
import { PopupHighlight } from "../../globals/shell.slint";

// A Now-Playing popup's menu column: the shared chrome plus the watcher that
// dismisses it when the OS window loses focus. `popup-id` is what the trigger
// writes into `PopupHighlight.id` before `show()`, and the watcher mounts only
// while that id is current, so exactly one open popup ever has a live one.
//
// The rows layout stays in the *host* and arrives through `@children`: the
// popup's width derives from that layout's `preferred-width`, and only the host
// can name a descendant.
export component MenuSurface inherits PopupSurface {
    in property <string> popup-id;
    callback close-requested();

    // The `!= ""` half is load-bearing: every close path clears
    // `PopupHighlight.id` back to "", which is also `popup-id`'s default — so a
    // host that forgot to set it would mount a live watcher exactly while no
    // popup is highlighted.
    if root.popup-id != "" && PopupHighlight.id == root.popup-id: FocusLossWatcher {
        close => {
            root.close-requested();
        }
    }

    @children
}
