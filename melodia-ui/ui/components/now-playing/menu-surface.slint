import { PopupSurface } from "../popup-surface.slint";
import { FocusLossWatcher } from "../focus-loss-watcher.slint";
import { PopupHighlight } from "../../globals.slint";

// The menu column inside a Now-Playing popup: the shared chrome plus the
// watcher that dismisses it when the OS window loses focus.
//
// `popup-id` is the discriminator the trigger writes into `PopupHighlight.id`
// before `show()`. The watcher is mounted only while that id is current, so
// exactly one open popup ever has a live one; the winit Release path (or any
// close handler in the host) clears the id back to "".
//
// The host keeps its own rows layout and passes it as this component's
// children, rather than the layout living in here: the popup's width is derived
// from that layout's `preferred-width`, and only the host can name it.
//
//     MenuSurface {
//         popup-id: "overflow";
//         x: …; y: …; width: …; height: …;
//         close-requested => { root.dismiss(); }
//         menu-vl := VerticalLayout { /* rows */ }
//     }
export component MenuSurface inherits PopupSurface {
    in property <string> popup-id;
    callback close-requested();

    // The `!= ""` half is load-bearing: every close path clears
    // `PopupHighlight.id` back to "", which is also `popup-id`'s default — so a
    // host that forgot to set it would mount a live watcher exactly while no
    // popup is highlighted.
    if root.popup-id != "" && PopupHighlight.id == root.popup-id: FocusLossWatcher {
        close => {
            root.close-requested();
        }
    }

    @children
}
