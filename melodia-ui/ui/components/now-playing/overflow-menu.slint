import { Theme } from "../../theme.slint";
import { Settings } from "../../settings.slint";
import { Equalizer, ReplayGain } from "../../globals/audio.slint";
import { Dialog } from "../../globals/dialog.slint";
import { Player } from "../../globals/player.slint";
import { Queue } from "../../globals/queue.slint";
import { WindowChrome, PopupHighlight } from "../../globals/shell.slint";
import { IconButton } from "../icon-button.slint";
import { MaterialIcon } from "../material-icon.slint";
import { StarRating } from "../star-rating.slint";
import { MenuSurface } from "./menu-surface.slint";
import { PopupDismissCatcher } from "./popup-dismiss-catcher.slint";
import { OverflowRow } from "./overflow-row.slint";
import { SpeedFlyout } from "./speed-flyout.slint";
import { SleepTimerFlyout } from "./sleep-timer-flyout.slint";
import { FlyoutMetrics, SleepPresets, SpeedPresets } from "./flyout-presets.slint";

// `more_vert` IconButton + PopupWindow listing the permanent "Speed"
// row (with its left-opening preset flyout) plus every button the
// user has routed to the overflow menu. Same structural shape as the
// volume popup (the canonical fixed-size popup-from-icon pattern): the
// PopupWindow reserves room for both the menu column (right, under the
// trigger) and the speed flyout (left), with a transparent click-catcher
// over the empty regions. Popup opens upward (the bar lives at window
// bottom) and the menu column right-aligns under the trigger.
//
// Unlike the configurable buttons, the speed control is ALWAYS here — it
// is never shown inline in the bar — so the `more_vert` trigger is now
// always mounted by `now-playing-bar.slint`.
export component OverflowMenu inherits Rectangle {
    in property <length> bar-w;

    width: btn.width;
    height: btn.height;

    // Whether the preset flyout is expanded. Reset to collapsed on every
    // (re)open via the trigger, and by `dismiss()`. The speed and sleep flyouts
    // share the one left column, so they are mutually exclusive — opening one
    // closes the other.
    property <bool> speed-flyout-open: false;
    property <bool> sleep-flyout-open: false;

    // Every close path: drop the popup, collapse both flyouts, release the
    // trigger highlight. A function rather than a callback because that's what
    // it is — the rows invoke it, nothing subscribes to it.
    public function dismiss() {
        pop.close();
        root.speed-flyout-open = false;
        root.sleep-flyout-open = false;
        PopupHighlight.id = "";
    }

    // Number of currently-overflowed action buttons (the speed row is
    // permanent and counted separately, +1 below). The pin row is gated on
    // always-on-top support, so only count it when actually mounted —
    // otherwise the menu reserves an empty 36 px slot.
    property <int> overflow-count:
        (Settings.overflow-favorite ? 1 : 0)
        + (Settings.overflow-repeat ? 1 : 0)
        + (Settings.overflow-shuffle ? 1 : 0)
        + ((WindowChrome.always-on-top-supported && Settings.overflow-pin) ? 1 : 0)
        + (Settings.overflow-queue ? 1 : 0);

    // Menu column height: one row each for the five permanent rows — Speed,
    // Sleep timer, Equalizer, ReplayGain, Rating — plus the overflowed buttons,
    // plus the shared chrome allowance. (The content-driven *width* `menu-w` is
    // declared on the PopupWindow below — Slint forbids the enclosing component
    // from reading a property *inside* a PopupWindow, so it can't live up here.)
    property <length> menu-h:
        FlyoutMetrics.menu-row-h * (5 + root.overflow-count) + FlyoutMetrics.chrome-h;

    // Speed flyout geometry. Height derives from the shared preset list +
    // metrics (`flyout-presets.slint`), so adding a preset can't clip the
    // popup.
    property <length> flyout-w: 120px;
    property <length> flyout-h:
        FlyoutMetrics.option-row-h * SpeedPresets.list.length + FlyoutMetrics.chrome-h;
    // Sleep-timer flyout geometry. Wider than the speed flyout to fit the
    // "End of track" row (and its translations). Height = the preset rows +
    // a 9 px divider + the ±stepper row + the Start-pill row (both option-row
    // sized), plus the shared chrome allowance.
    property <length> sleep-flyout-w: 168px;
    property <length> sleep-flyout-h:
        FlyoutMetrics.option-row-h * (SleepPresets.list.length + 2) + 9px
        + FlyoutMetrics.chrome-h;
    // The two flyouts share the single left column; reserve the wider one so
    // the popup never re-layouts when switching between them.
    property <length> left-col-w: max(root.flyout-w, root.sleep-flyout-w);
    // Transparent gap between the flyout (left) and menu (right) columns so
    // they read as two separate floating chromes.
    property <length> gap: 8px;

    // Map the live multiplier back to a preset label for the collapsed row.
    // Kept in lock-step with `SpeedPresets.list` (`flyout-presets.slint`) —
    // Slint functions can't loop over a model, so this stays hand-rolled.
    // 1.0 falls through to the "1x" default.
    function current-speed-label() -> string {
        if (abs(Player.vm.playback_speed - 0.25) < 0.001) { return "0.25x"; }
        if (abs(Player.vm.playback_speed - 0.5) < 0.001) { return "0.5x"; }
        if (abs(Player.vm.playback_speed - 0.75) < 0.001) { return "0.75x"; }
        if (abs(Player.vm.playback_speed - 1.25) < 0.001) { return "1.25x"; }
        if (abs(Player.vm.playback_speed - 1.5) < 0.001) { return "1.5x"; }
        if (abs(Player.vm.playback_speed - 1.75) < 0.001) { return "1.75x"; }
        if (abs(Player.vm.playback_speed - 2.0) < 0.001) { return "2x"; }
        return "1x";
    }

    btn := IconButton {
        icon: "more_vert";
        press-shrink: true;
        diameter: clamp(root.bar-w * 0.05, 28px, 36px);
        icon-size: clamp(root.bar-w * 0.03, 18px, 20px);
        tooltip-text: @tr("More");
        // Keep the disc highlighted while the popup is open. Cleared by
        // `dismiss()`, or by the AppWindow scrim catching an outside click.
        force-bg: PopupHighlight.id == "overflow";
        clicked => {
            // Always (re)open collapsed.
            root.speed-flyout-open = false; root.sleep-flyout-open = false;
            PopupHighlight.id = "overflow";
            pop.show();
        }
    }

    pop := PopupWindow {
        // Content-driven menu-column width. Declared HERE (on the
        // PopupWindow) so it can read its own descendant `menu-vl`'s
        // `preferred-width` — the enclosing component is not allowed to.
        // The widest row's content sets the floor; +2 px for the
        // PopupSurface border; 156 px minimum preserves the English look.
        property <length> menu-w: max(156px, menu-vl.preferred-width + 2px);

        // Fixed-reserve sizing (volume-popup pattern): the PopupWindow is
        // always wide and tall enough for the menu column AND the flyout,
        // so it never has to re-layout when the flyout expands. The menu
        // column's on-screen position is independent of the popup size
        // (popup.x + menu.x both cancel `self.width`), so it stays pinned
        // under the trigger whether or not the flyout is open.
        width: root.left-col-w + root.gap + self.menu-w;
        height: max(root.menu-h, max(root.flyout-h, root.sleep-flyout-h));
        x: btn.width - self.width;
        y: -self.height - 8px;
        close-policy: close-on-click-outside;

        // Mirrors the volume popup's left-strip catcher.
        PopupDismissCatcher {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.dismiss();
            }
        }

        // Speed flyout — left column, bottom-anchored (its bottom aligns
        // with the menu column's bottom, 8 px above the trigger), grows
        // upward. Mounted only while open so the 12 rows aren't built when
        // collapsed. Right-aligned within the shared (wider) left column so
        // the `gap` to the menu column holds regardless of which flyout is
        // the widest.
        if root.speed-flyout-open: SpeedFlyout {
            x: root.left-col-w - root.flyout-w;
            y: parent.height - root.flyout-h;
            width: root.flyout-w;
            height: root.flyout-h;
            current-speed: Player.vm.playback_speed;
            pick(v) => {
                Player.set-playback-speed(v);
                root.dismiss();
            }
        }

        // Sleep-timer flyout — same left column as the speed flyout (mutually
        // exclusive). Presets apply + close; the ±stepper's Start pill arms a
        // custom duration (seconds) + closes.
        if root.sleep-flyout-open: SleepTimerFlyout {
            x: root.left-col-w - root.sleep-flyout-w;
            y: parent.height - root.sleep-flyout-h;
            width: root.sleep-flyout-w;
            height: root.sleep-flyout-h;
            active-total-seconds: Player.sleep-timer-total-seconds;
            track-end-active: Player.vm.sleep_at_track_end;
            pick(m) => {
                Player.set-sleep-timer(m);
                root.dismiss();
            }
            start-custom(secs) => {
                Player.set-sleep-timer-seconds(secs);
                root.dismiss();
            }
        }

        // Menu column — right, bottom-anchored under the trigger.
        MenuSurface {
            popup-id: "overflow";
            x: parent.width - pop.menu-w;
            y: parent.height - root.menu-h;
            width: pop.menu-w;
            height: root.menu-h;
            close-requested => {
                root.dismiss();
            }

            menu-vl := VerticalLayout {
                padding: Theme.pad-xs;
                spacing: 0;

                // Permanent Speed row — opens the preset flyout to
                // the left. Does NOT close the popup; re-asserts the
                // highlight id so the winit Release clear doesn't unmount
                // the FocusLossWatcher.
                OverflowRow {
                    icon: "speed";
                    label: @tr("Speed");
                    trailing-text: root.current-speed-label();
                    trailing-icon: "chevron_left";
                    active: root.speed-flyout-open;
                    clicked => {
                        root.speed-flyout-open = !root.speed-flyout-open;
                        root.sleep-flyout-open = false;
                        PopupHighlight.id = "overflow";
                    }
                }

                // Permanent Sleep-timer row — opens the preset flyout to the
                // left (mutually exclusive with the speed flyout). Does NOT
                // close the popup; re-asserts the highlight id. Trailing text
                // shows the live countdown, or "Track end" while the
                // end-of-track mode is armed (from `vm.sleep_at_track_end`).
                OverflowRow {
                    icon: "bedtime";
                    label: @tr("Sleep timer");
                    trailing-text: Player.vm.sleep_at_track_end
                        ? @tr("Track end")
                        : (Player.sleep-timer-total-seconds > 0 ? Player.sleep-timer-remaining : "");
                    trailing-icon: "chevron_left";
                    active: root.sleep-flyout-open
                        || Player.sleep-timer-total-seconds > 0
                        || Player.vm.sleep_at_track_end;
                    clicked => {
                        root.sleep-flyout-open = !root.sleep-flyout-open;
                        root.speed-flyout-open = false;
                        PopupHighlight.id = "overflow";
                    }
                }

                // Permanent Equalizer row — opens the reusable graphic-EQ
                // dialog. Closes the popup (a modal dialog takes over) and
                // populates the `Dialog` global inline; the EQ apply/persist
                // wiring lives on the `Equalizer` global. The "On"/"Off"
                // trailing text mirrors the live enabled state.
                OverflowRow {
                    icon: "graphic_eq";
                    label: @tr("Equalizer");
                    trailing-text: Equalizer.enabled ? @tr("On") : @tr("Off");
                    active: Equalizer.enabled;
                    clicked => {
                        root.dismiss();
                        Dialog.kind = "equalizer";
                        Dialog.title = @tr("Equalizer");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Done");
                        Dialog.cancel-label = "";
                        Dialog.destructive = false;
                        Dialog.open = true;
                    }
                }

                // Permanent ReplayGain row — opens the loudness-normalization
                // dialog, mirroring the Equalizer row. The "On"/"Off" trailing
                // text mirrors the live enabled state.
                OverflowRow {
                    icon: "tune";
                    label: @tr("ReplayGain");
                    trailing-text: ReplayGain.enabled ? @tr("On") : @tr("Off");
                    active: ReplayGain.enabled;
                    clicked => {
                        root.dismiss();
                        Dialog.kind = "replaygain";
                        Dialog.title = @tr("ReplayGain");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Done");
                        Dialog.cancel-label = "";
                        Dialog.destructive = false;
                        Dialog.open = true;
                    }
                }

                // Permanent Rating row — inline 5-star control for the current
                // track. Unlike the dialog rows it neither closes the popup nor
                // opens a flyout: clicking a star applies immediately and
                // re-asserts the highlight id so the winit Release clear doesn't
                // unmount the FocusLossWatcher.
                Rectangle {
                    // Not an `OverflowRow`, so it has to take the shared row
                    // height itself — `menu-h` above reserves one for it.
                    height: FlyoutMetrics.menu-row-h;
                    opacity: Player.vm.has_track ? 1 : 0.5;
                    HorizontalLayout {
                        padding-left: Theme.pad-sm;
                        padding-right: Theme.pad-sm;
                        spacing: Theme.pad-sm;
                        alignment: stretch;
                        VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "star";
                                icon-size: 20px;
                                icon-color: Player.vm.track.rating > 0 ? Theme.accent : Theme.text;
                                filled: Player.vm.track.rating > 0;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("Rating");
                                color: Theme.text;
                                font-size: Theme.font-size-md;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            StarRating {
                                rating: Player.vm.track.rating;
                                star-size: 18px;
                                enabled: Player.vm.has_track;
                                rated(n) => {
                                    Player.set-current-rating(n);
                                    PopupHighlight.id = "overflow";
                                }
                            }
                        }
                    }
                }

                if Settings.overflow-favorite: OverflowRow {
                    icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                    label: Player.vm.track.is_favorite ? @tr("Unfavorite") : @tr("Favorite");
                    active: Player.vm.track.is_favorite;
                    filled: Player.vm.track.is_favorite;
                    button-enabled: Player.vm.has_track;
                    clicked => { Player.toggle-favorite(); root.dismiss(); }
                }
                if Settings.overflow-repeat: OverflowRow {
                    icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
                    label: @tr("Repeat");
                    active: Player.queue.repeat_mode != "off";
                    clicked => { Player.cycle-repeat(); root.dismiss(); }
                }
                if Settings.overflow-shuffle: OverflowRow {
                    icon: "shuffle";
                    label: @tr("Shuffle");
                    active: Player.queue.shuffle;
                    clicked => { Player.toggle-shuffle(); root.dismiss(); }
                }
                if WindowChrome.always-on-top-supported && Settings.overflow-pin: OverflowRow {
                    icon: "push_pin";
                    label: WindowChrome.always-on-top-active ? @tr("Unpin from Top") : @tr("Pin on Top");
                    active: WindowChrome.always-on-top-active;
                    filled: WindowChrome.always-on-top-active;
                    clicked => { WindowChrome.toggle-always-on-top(); root.dismiss(); }
                }
                if Settings.overflow-queue: OverflowRow {
                    icon: "queue_music";
                    label: @tr("Queue");
                    active: Queue.open;
                    clicked => { Queue.open = !Queue.open; root.dismiss(); }
                }
            }
        }
    }
}
