import { Player, Visualizer } from "../../globals.slint";

// Spectrum-analyzer style for the Now-Playing view: one bar per frequency
// band, bass on the left, treble on the right. A silent band rests as a dot and
// grows out of it as it gets loud, so an idle strip reads as a row of beads
// rather than as a flat rule waiting for something to happen.
//
// Heights come straight from `Visualizer.bars` (normalized 0..1, low → high),
// which Rust has already smoothed with a fast attack and a slow decay. That is
// why there is deliberately **no** `animate` on the bar height: animating an
// already-smoothed value phase-lags, and a single shared Timer plus
// math-derived bindings is cheaper at vsync than N concurrent `animate` blocks.
//
// Pure render — the footprint and the driving Timer belong to the host,
// `visualizer-strip.slint`.
//
// Each bar is a childless Rectangle, so its rounded cap never pushes the
// subtree through FemtoVG's offscreen layer (the HiDPI clip-blur pitfall).
export component SpectrumBars inherits Rectangle {
    // Centre-line anchoring instead of the baseline — the "Mirrored" style.
    in property <bool> centred;

    HorizontalLayout {
        // Bars are `horizontal-stretch: 1`, so each one is what's left of the
        // strip after the gaps. Kept tight because there are enough bands that
        // a wider gap would start eating the bars themselves on a narrow window.
        spacing: 2px;

        for level in Visualizer.bars: Rectangle {
            horizontal-stretch: 1;

            // Computed geometry rather than a layout, in the idiom of
            // `dialog/eq-band-slider.slint`.
            Rectangle {
                width: parent.width;
                // Floored at the band's own column width, so a silent band is a
                // dot and grows out of it as its level rises. A floor in fixed
                // px can't do that: the column width follows the strip width,
                // so the resting shape would only come out round at one window
                // size and read as a squashed dash at every other.
                height: max(parent.width, parent.height * level);
                // Height is the total in both anchorings, so a centred bar puts
                // half either side of the axis rather than a full bar each way.
                y: root.centred
                    ? (parent.height - self.height) / 2
                    : parent.height - self.height;
                // Half the short axis — a circle at the floor, semicircular
                // caps once the band is taller than it is wide. Taking the
                // `min` rather than assuming the width is the short one is what
                // keeps it a capsule: FemtoVG clamps a corner's x- and y-radii
                // independently, so a radius past half the height pinches the
                // shape into a lens instead of clamping to a stadium.
                border-radius: min(self.width, self.height) / 2;
                // The per-artwork accent, so the strip harmonizes with the
                // blur — but the tone-floored variant, since these bars are
                // painted opaque: a dark album's raw accent would sink into
                // the scrimmed backdrop.
                background: Player.np-accent-bright;
            }
        }
    }
}
