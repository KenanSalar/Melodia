import { Visualizer } from "../../globals/audio.slint";
import { Player } from "../../globals/player.slint";

// Spectrum-analyzer style: one bar per band, bass left. A silent band rests as a
// dot and grows out of it, so an idle strip reads as a row of beads rather than
// as a flat rule waiting for something to happen.
//
// Heights come straight off `Visualizer.bars`, which Rust has already smoothed
// with a fast attack and a slow decay — which is why there is deliberately **no**
// `animate` on the height. Animating an already-smoothed value phase-lags, and
// one shared Timer plus math-derived bindings is cheaper at vsync than N
// concurrent `animate` blocks.
//
// Pure render: the footprint and the Timer belong to `visualizer-strip.slint`.
// Each bar is a childless Rectangle, so its rounded cap never pushes the subtree
// through FemtoVG's offscreen layer.
export component SpectrumBars inherits Rectangle {
    // Centre-line anchoring instead of the baseline — the "Mirrored" style.
    in property <bool> centred;

    HorizontalLayout {
        // The bars stretch, so each is what's left after the gaps — kept tight
        // because at this band count a wider one starts eating the bars
        // themselves on a narrow window.
        spacing: 2px;

        for level in Visualizer.bars: Rectangle {
            horizontal-stretch: 1;

            // Computed geometry rather than a layout, in the idiom of
            // `dialog/eq-band-slider.slint`.
            Rectangle {
                width: parent.width;
                // Floored at the band's own column width, so a silent band rests
                // as a circle. A fixed-px floor can't: the column follows the
                // strip's width, so the resting shape would come out round at
                // exactly one window size and squashed at every other.
                height: max(parent.width, parent.height * level);
                // Height is the total in both anchorings, so a centred bar puts
                // half either side of the axis rather than a full bar each way.
                y: root.centred
                    ? (parent.height - self.height) / 2
                    : parent.height - self.height;
                // Half the short axis, so it caps as a circle at the floor.
                // Taking the `min` rather than assuming width is the short one
                // is what keeps it a capsule: FemtoVG clamps a corner's x- and
                // y-radii independently, so a radius past half the height
                // pinches the shape into a lens.
                border-radius: min(self.width, self.height) / 2;
                // The per-artwork accent, so the strip harmonizes with the blur,
                // but the tone-floored variant — painted opaque, a dark album's
                // raw accent sinks into the scrimmed backdrop.
                background: Player.np-accent-bright;
            }
        }
    }
}
