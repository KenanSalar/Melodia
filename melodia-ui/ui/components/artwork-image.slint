import { Theme } from "../theme.slint";

// The square artwork tile. A decoded `cover` renders; otherwise the fallback glyph
// paints over `tile-bg`.
//
// **Where that image comes from is the host's business**, and the two kinds differ: a
// repeated tile binds `cover` to a lazy per-path lookup, so only a mounted tile costs a
// cache hit, while the singletons — the bar, the mini player, the detail heroes, the tag
// editor — are handed one image Rust decoded eagerly.
export component ArtworkImage inherits Rectangle {
    in property <string> artwork-path;
    in property <image> cover;
    // **Lets a host suppress a `cover` it has no way to withhold.** Slint has no
    // empty-`image` literal, so a host choosing between several globals' covers still has
    // to bind *one* of them on the arm that owns none — `LibraryTabBand`'s Genre hero is
    // the case, its tile being a name-hashed gradient with no image behind it. Left to
    // `cover.width` alone, that arm paints whichever sibling detail happened to be open.
    // Defaulted `true`, so every mount handing over its own cover is unaffected.
    in property <bool> has-cover: true;
    in property <length> tile-size: 56px;
    in property <length> tile-radius: Theme.radius-md;
    // Painted when no cover is present, as an SVG asset rather than a font glyph — see
    // the branch below. Each entity view passes the name matching its own sidebar icon,
    // so an empty tile reads as that kind of thing rather than as a stray note.
    in property <string> fallback-icon: "music-note";
    // Scales the cover *inside* the tile frame for the hover zoom; the tile's own clip
    // crops it, so it can't escape the host's bounds.
    in property <float> cover-scale: 1.0;
    // **The animated mirror, and what the ease belongs on.** Easing this rather than the
    // derived size means a tile *frame* resize — the grid reflowing as the sidebar
    // collapses — tracks instantly while a hover toggle still eases; animating the size
    // conflates the two inputs and produces a delayed zoom-bounce.
    property <float> anim-scale: root.cover-scale;
    animate anim-scale { duration: Theme.dur-fast; easing: ease-in-out; }
    // The shared default: a faintly accent-tinted square with an accent-coloured glyph.
    in property <brush> tile-bg: Theme.accent.with-alpha(0.15);
    in property <brush> tile-icon-color: Theme.accent;
    // **Fades the whole tile, so a host never has to wrap one in an `opacity`.**
    // `Opacity::need_layer` bails at exactly 1.0 and on a lone *childless* child, and this
    // root is neither — it has children — so a host fading the tile from outside renders
    // the whole 140 px square to an offscreen texture for the length of its animation.
    // `LibraryTabBand` did, and its band clips against an animating height, which puts the
    // layer's bounding rect on a clip that moves every frame: that is the branch in
    // `render_layer` that allocates a *new* GPU texture rather than reusing one. Taking the
    // float instead moves the fade onto the fill and onto whichever `Image` is mounted,
    // each of which is childless and so costs a canvas alpha multiply rather than a layer.
    //
    // **`transparentize`, not `with-alpha`, on the fill** — the first multiplies the alpha
    // where the second sets it, and `tile-bg` defaults to `Theme.accent.with-alpha(0.15)`,
    // so the wrong one turns every coverless tile in the app fully opaque
    // (`slint-pitfalls.md`, the `TabBarCell` entry, which paid for this once already).
    //
    // **And the fallback icons fade on `opacity` like the cover, not through `colorize`**,
    // which is the tempting fold: `colorize` takes a brush, so alpha in it looks free. It
    // isn't — the renderer caches the colorized result as its own texture
    // (`ItemGraphicsCacheEntry::ColorizedImage`), so a brush that moves per frame
    // re-renders that texture per frame, which is the cost this property exists to remove
    // rather than relocate.
    //
    // The root's own rounded `clip: true` is a layer at all times and is untouched by any
    // of this — non-rectangular clips render children into a texture regardless of fading,
    // and that is what makes the tile a rounded tile. Defaulted `1.0`, where `need_layer`
    // bails on its first condition, so the fourteen mounts that never fade are unaffected.
    in property <float> fade: 1.0;

    // The one question the tile asks, stated once — the five fallback branches below each
    // used to spell its negation.
    property <bool> shows-cover: root.has-cover && root.cover.width > 0;

    width: tile-size;
    height: tile-size;
    border-radius: tile-radius;
    background: tile-bg.transparentize(1.0 - root.fade);
    clip: true;

    if root.shows-cover: Image {
        // Derived from the animating source, so size and centring track per frame with
        // no phase lag.
        width: parent.width * root.anim-scale;
        height: parent.height * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.cover;
        image-fit: ImageFit.cover;
        opacity: root.fade;
    }

    // **An SVG `Image`, not a Material Symbols glyph.** A glyph scales from its
    // text-metrics origin and isn't centred within its advance box, so scaling
    // `font-size` for the hover zoom drifts it sideways; an `Image` scales its *content*
    // to fill the box, so it zooms from the true geometric centre.
    //
    // One `if` per name, because Slint can't compose an `@image-url` from a runtime
    // string — resources are resolved at codegen.
    if !root.shows-cover && root.fallback-icon == "music-note": Image {
        source: @image-url("../assets/icons/music-note.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if !root.shows-cover && root.fallback-icon == "person": Image {
        source: @image-url("../assets/icons/person.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if !root.shows-cover && root.fallback-icon == "playlist": Image {
        source: @image-url("../assets/icons/playlist.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if !root.shows-cover && root.fallback-icon == "theater_comedy": Image {
        source: @image-url("../assets/icons/theater-comedy.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    if !root.shows-cover && root.fallback-icon == "album": Image {
        source: @image-url("../assets/icons/album.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
    // Browse's card view, whose grid mixes subfolders and files — a folder card has no
    // cover to have, so this is its resting state rather than a missing-artwork one.
    if !root.shows-cover && root.fallback-icon == "folder": Image {
        source: @image-url("../assets/icons/folder.svg");
        colorize: root.tile-icon-color;
        image-fit: ImageFit.contain;
        width: parent.width * 0.55 * root.anim-scale;
        height: parent.height * 0.55 * root.anim-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.fade;
    }
}
