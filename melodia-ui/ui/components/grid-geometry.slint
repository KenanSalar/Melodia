// Responsive card-grid geometry, derived once instead of once per view: every
// grid page answers the same three questions from its body width, and the
// arithmetic had been copied verbatim into each. `GridColumnsSync` beside it
// owns *when* the column count reaches Rust, so the two split along
// what-versus-when. Non-visual, so it costs a property evaluation and no layout.
//
// **`avail-width` must come from the element the grid fills**, whose width the
// layout fixes independently of the grid's children — so a card sizing itself
// from it is a derivation and not a cycle.
export component GridGeometry {
    in property <length> avail-width;
    // Columns are packed until one more would take every card below this.
    in property <length> min-card-w: 180px;
    // Between cards *and* at both outer edges — hence the `cols + 1` below.
    in property <length> gap: 20px;
    // What the text block adds under the artwork tile.
    in property <length> card-text-h: 46px;

    out property <int> cols:
        max(1, Math.floor((root.avail-width - root.gap) / (root.min-card-w + root.gap)));
    out property <length> card-w:
        max(0px, (root.avail-width - (root.cols + 1) * root.gap) / root.cols);
    // Artwork is square, so the tile's height is the card's width.
    out property <length> card-h: root.card-w + root.card-text-h;
    out property <length> row-h: root.card-h + root.gap;
}
