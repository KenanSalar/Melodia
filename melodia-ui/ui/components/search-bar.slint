import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// The reusable compact filter input: an `ActionPill`-matching outline over a fill that
// **solidifies the moment the bar is engaged** — half its mounts sit over a detail hero, so
// at rest it lets a little blur through like the pill beside it.
//
// The outer slot asks for `input-width` and never stretches past it; the visible chrome is an
// inner Rectangle scaling from its own centre, so neighbours don't shift on focus.
//
// A named instance exposes `clear-input-focus()` for a backdrop or pill. **`blur-trigger` is
// for the case that can't reach the instance**: a descendant in another file bumps an int on
// the view's global. Omit it when nothing outside the view file triggers a blur.
export component SearchBar inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search…");

    // **The default fits the placeholder the bar was actually handed**, a flat number being
    // unable to: several catalogues need noticeably more room than English. Capped so a
    // verbose locale can't take a whole header row; past the cap the placeholder elides. The
    // three hosts that budget their row set this outright.
    in property <length> input-width:
        clamp(root.natural-width, 220px, 320px);

    // Published so a host budgeting its row reserves against it rather than restating the
    // number — the `TabBar.compact-w` contract. What the host leaves behind is exactly what
    // this shrinks to, so the two can't drift.
    out property <length> min-w: 140px;

    // Named because `chrome-overhead` has to add the same number the layout does.
    property <length> icon-size: 16px;
    // Everything in the pill that isn't the text. The clear button stays out: it only mounts
    // once there's text, by which point the placeholder is gone.
    property <length> chrome-overhead:
        Theme.pad-sm + root.icon-size + 2 * Theme.pad-xs;
    // Measured off the Text the bar actually draws, so measured and drawn can't drift. A
    // Text's *horizontal* layout info is intrinsic to the string and never reads back the
    // width it was handed, so this is a derivation and not a cycle.
    property <length> natural-width:
        placeholder-text.preferred-width + root.chrome-overhead;

    // Slint has no click-outside behaviour for `TextInput`, so each increment fires
    // `clear-focus()` on the inner input.
    in property <int> blur-trigger: 0;
    changed blur-trigger => { input.clear-focus(); }

    callback edited(string);

    // Most consumers don't wire this, their `edited` already refiltering per keystroke.
    // **The Search view does**: it skips the debounce and commits synchronously, so a user
    // can re-trigger the same query after navigating away and back — the leave released the
    // results but kept `Search.query`.
    callback accepted();

    // **`has-hover` is not continuous, so the fill can't read it raw.** Slint drops the flag
    // on a wheel event the bar doesn't handle, and its exit dispatch compares an item's stack
    // *position* rather than its membership, so an item the pointer never left can still be
    // handed an `Exit`. Either way it blinks off for a frame, and the rest fill is translucent
    // — invisible over a flat panel, a visible flicker over the Search results this floats on.
    // So `engaged` arms on the raw flag and releases only once the pointer has stayed gone,
    // the rail tooltip's `held` shape. **`hover-held` sits beside the raw flag rather than
    // replacing it**: `changed` doesn't fire on a first evaluation, so a bar mounted under the
    // pointer would never engage.
    property <bool> pointer-inside: chrome-touch.has-hover;
    property <bool> hover-held;
    property <bool> engaged:
        root.pointer-inside || root.hover-held || input.has-focus;

    changed pointer-inside => {
        if (root.pointer-inside) {
            root.hover-held = true;
            hover-grace.running = false;
        } else {
            hover-grace.running = true;
        }
    }

    // Long enough to swallow a blink, short enough that a real leave still reads as
    // immediate against the fade that follows it.
    hover-grace := Timer {
        interval: 120ms;
        running: false;
        triggered() => {
            self.running = false;
            root.hover-held = root.pointer-inside;
        }
    }

    // The simple case: a same-file caller with an id skips the `blur-trigger` plumbing.
    public function clear-input-focus() {
        input.clear-focus();
    }

    // For a view auto-focusing its bar on mount. Named `focus-input` because `focus`
    // collides with the built-in element method.
    public function focus-input() {
        input.focus();
    }

    // The slot still doesn't stretch — `preferred` and `max` are the same number, so the
    // bar is handed exactly `input-width` and the focus swell happens *inside* it.
    // **What the split buys over a bound `width` is the other end**: Slint reports a
    // root's bound `width` as both `min` and `max`, so a locale-sized default would drag
    // the window's own resize floor out with it. Under `min-w` the bar compresses and
    // the placeholder elides, where before it drew across its neighbours.
    min-width: root.min-w;
    preferred-width: input-width;
    max-width: input-width;
    height: 32px;
    background: transparent;

    // Holds all the visible styling and scales from the *centre* by binding `x`/`y` to a
    // half-delta against the outer slot — Slint Rectangles have no scale transform, so
    // the width and height grow and the position is recomputed.
    chrome := Rectangle {
        property <float> focus-scale: input.has-focus ? 1.015 : 1.0;
        animate focus-scale { duration: Theme.dur-fast; easing: ease-in-out; }

        width: root.width * focus-scale;
        height: root.height * focus-scale;
        // The half-delta keeps the chrome centred against the slot as it scales.
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Rest matches the `ActionPill` chip's fill, so adjacent bars and pills read as
        // one family; engagement closes it to opaque, as a hovered `PillButton` does.
        background: root.engaged
            ? Theme.surface0
            : Theme.floating-chrome-bg;
        // The `ActionPill` outline at rest; focus lifts it with a glow and tints the
        // ring faintly toward the accent.
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: input.has-focus
            ? Theme.accent.with-alpha(0.18)
            : Theme.surface2;
        drop-shadow-color: input.has-focus
            ? Theme.crust.with-alpha(0.45)
            : Theme.crust.with-alpha(0.15);
        drop-shadow-blur: input.has-focus ? 16px : 2px;
        drop-shadow-offset-y: input.has-focus ? 4px : 1px;
        // **The ease belongs on the scale, not on the dimensions.** Animating a binding
        // derived from another animating property phase-lags, and `width`/`height`
        // derive from this while `x`/`y` derive from those. There is a second reason
        // too: `width` also multiplies `root.width`, which the Settings header drives off
        // the live window width, and Slint restarts an animated binding on dependency
        // *dirtiness* rather than on a value change — so an eased `width` restarted its
        // curve on every event of a resize drag and the chrome lagged inside its own
        // slot. `focus-scale` reads nothing but `has-focus`, so it only sees the toggle.
        animate background, border-color, drop-shadow-color,
                drop-shadow-blur, drop-shadow-offset-y {
            duration: Theme.dur-fast;
            easing: ease-in-out;
        }

        // **Wraps the content rather than sitting beside it.** As a sibling its
        // `has-hover` only reported the padding and border: `TextInput` consumes the hit
        // test, so the pointer vanished the moment it crossed into the text and the fill
        // dropped back to rest. An ancestor TouchArea gets `has-hover` on the top-down
        // filter pass and still forwards the event, so the clear button and the
        // `TextInput` keep their clicks, drags and caret placement — the same wrapping
        // fix, for the same reason, as `touch` in `track-list-row.slint`.
        chrome-touch := TouchArea {
            width: 100%;
            height: 100%;
            // Forwards focus so the whole pill is the target, not just the input.
            clicked => { input.focus(); }

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-xs;
            spacing: Theme.pad-xs;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "search";
                    icon-size: root.icon-size;
                    // Rest matches the placeholder beside it, so the two halves of
                    // an empty bar sit on one rung.
                    icon-color: input.has-focus
                        ? Theme.accent
                        : Theme.text.transparentize(0.3);
                    animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
                }
            }

            // Slint's `TextInput` has no `placeholder-text`, so the placeholder is a
            // sibling Text overlaid while the input is empty.
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        // Both children fill this box, so their `vertical-alignment`
                        // actually centres the glyph line-box inside it — without an
                        // explicit height they auto-size to the line-box and pin to the
                        // top, reading a pixel high.
                        placeholder-text := Text {
                            visible: root.text == "";
                            text: root.placeholder;
                            // `PillButton`'s label brush, so a bar and the pills beside
                            // it read as one family; dimmed just enough to stay a hint
                            // rather than typed text. Alpha in the brush rather than
                            // `opacity`, which would layer and crop the ink.
                            color: Theme.text.transparentize(0.3);
                            font-size: Theme.font-size-md;
                            vertical-alignment: center;
                            x: 0;
                            // **Bounded, and only then elided.** The parent is a plain
                            // Rectangle rather than a layout, so without a width of its
                            // own this Text takes its *implicit* size — the untruncated
                            // string — and paints straight through the pill's right
                            // edge. Eliding alone doesn't save it: elide lowers a Text's
                            // layout *minimum* to one ellipsis and leaves `preferred` at
                            // the full string, and the implicit size is the larger of
                            // the two. The `TextInput` below never had the bug, already
                            // carrying this same width and clipping itself besides.
                            width: 100%;
                            height: 100%;
                            overflow: elide;
                        }
                        input := TextInput {
                            text <=> root.text;
                            color: Theme.text;
                            font-size: Theme.font-size-md;
                            single-line: true;
                            vertical-alignment: center;
                            x: 0;
                            width: 100%;
                            height: 100%;
                            edited => { root.edited(self.text); }
                            accepted => { root.accepted(); }
                        }
                    }
                }
            }

            if root.text != "": Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: clear-touch.has-hover ? Theme.surface1 : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                MaterialIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "close";
                    icon-size: 14px;
                    icon-color: Theme.subtext0;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
        }
    }
}
