import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// Reusable compact filter / search input.
//
// Visual design (mirrors Tauri's `.filterBar` + `.searchBarFocused`):
//   * Pill shape, 1 px `Theme.surface2` outline at rest (matches
//     `ActionPill`'s chip outline so search bars + pills sit together as
//     one family of controls).
//   * The fill solidifies as soon as the bar is engaged: `Theme.floating-
//     chrome-bg` (`surface0` @ 75 %) at rest, opaque `surface0` on hover or
//     focus. The bar sits over a detail hero in half its mounts, so at rest
//     it lets a little blur through like the pill and back button beside it,
//     and closes up the moment the pointer arrives.
//   * On focus: faint accent ring (`accent` @ 18 %), soft drop-shadow glow,
//     search icon tints to accent, the chrome scales by 1.5 % from its
//     centre. All transitions run for `Theme.dur-fast` (200 ms) ease-in-out.
//
// Layout: the outer slot asks for `input-width × 32 px` and never stretches
// past it. The visible chrome lives in an inner Rectangle that scales from its
// centre via `(parent.size - self.size) / 2` x/y bindings, so neighbouring
// elements in the parent layout don't shift on focus.
//
// Reuse pattern:
//
//     SearchBar {
//         text <=> Tracks.filter;
//         placeholder: "Filter tracks…";
//         blur-trigger: Tracks.blur-search-tick;
//         edited(t) => { Tracks.apply-filter(t); }
//     }
//
// A named instance exposes `clear-input-focus()` for a backdrop or pill
// TouchArea to call directly. `blur-trigger` is for the case that can't
// reach the instance: descendants in *other* files bump an int on the view's
// global, and the SearchBar blurs on every change. Omit it when nothing
// outside the view file needs to trigger a blur.
export component SearchBar inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search…");

    // Resting width of the slot. The default fits the placeholder the bar was
    // actually handed, because a flat number can't: several catalogues need
    // noticeably more room than the 220 px this used to be, and which of them
    // is widest changes from one string to the next. Capped so a verbose locale
    // can't take a whole header row, and past the cap the placeholder elides —
    // which every mount does anyway, since a host that budgets its row
    // (Settings, Favorites, the Search view) sets this outright and the default
    // never evaluates for it.
    in property <length> input-width:
        clamp(root.natural-width, 220px, 320px);

    // The floor the slot compresses to, published so a host budgeting its row
    // can reserve against it instead of restating the number — the same
    // contract `tab-bar.slint` publishes as `compact-w`, and for the same
    // reason: whatever the host leaves behind is exactly what this shrinks to,
    // so the two can't drift. Below it the placeholder elides; below *that* the
    // row has bigger problems than the search bar.
    out property <length> min-w: 140px;

    // Named because `chrome-overhead` has to add the same number the layout
    // below does.
    property <length> icon-size: 16px;
    // Everything in the pill that isn't the text: the left padding, the search
    // icon, the gap after it, and the right padding. The clear button stays out
    // of it — that only mounts once there's text, and by then the placeholder
    // is gone.
    property <length> chrome-overhead:
        Theme.pad-sm + root.icon-size + 2 * Theme.pad-xs;
    // How wide the bar would have to be to show its placeholder whole. Measured
    // off the Text the bar actually draws, so the shape measured and the shape
    // drawn can't drift. A Text's *horizontal* layout info is intrinsic to the
    // string and the font and never reads back the width it was handed
    // (`i-slint-core::items::text_layout_info`), so sizing the slot from it is a
    // derivation and not a cycle — the same thing that makes `tab-bar.slint`'s
    // `label-w` safe.
    property <length> natural-width:
        placeholder-text.preferred-width + root.chrome-overhead;

    // Counter the parent bumps to force a blur (Slint has no native
    // "click outside" behaviour for TextInput). Each increment fires
    // `clear-focus()` on the inner input. Use this when the trigger
    // originates in a component that can't reference this instance by id
    // (different file, ListView descendant, etc.).
    in property <int> blur-trigger: 0;
    changed blur-trigger => { input.clear-focus(); }

    callback edited(string);

    // Fires when the user presses Enter inside the input. Most consumers
    // (Tracks / Albums / Artists / Favorites filters) don't wire this —
    // their `edited` callback already refilters in-memory on every
    // keystroke, so Enter has no extra work to do. The Search view
    // *does* wire it: the 300 ms debounce Timer is skipped and
    // `commit-search` fires synchronously against the current text.
    // This is what lets the user re-trigger the same search after
    // navigating away and back (cache release on tab-leave cleared the
    // results, but `Search.query` was preserved — pressing Enter
    // re-runs the FTS fetch without forcing the user to edit-then-
    // re-type the same characters).
    callback accepted();

    // Public escape hatch for the simple case — same-file callers with an
    // id reference can just call `search.clear-input-focus()` and skip the
    // blur-trigger plumbing entirely.
    public function clear-input-focus() {
        input.clear-focus();
    }

    // Public escape hatch to programmatically focus the input — e.g. a view
    // auto-focusing its search bar on mount. (Named `focus-input` rather than
    // `focus` — the latter collides with the built-in element method.)
    public function focus-input() {
        input.focus();
    }

    // The slot still doesn't stretch — `preferred` and `max` are the same
    // number, so in a row with a spacer beside it the bar is handed exactly
    // `input-width` and the focus swell happens *inside* the slot without
    // pushing neighbours. What the split buys over the bound `width` it
    // replaces is the other end: Slint reports a root's bound `width` as both
    // `min` and `max`, so a locale-sized default would have dragged the
    // window's own resize floor out with it. Under `min-w` the bar now
    // compresses and the placeholder elides, where before it drew across its
    // neighbours.
    min-width: root.min-w;
    preferred-width: input-width;
    max-width: input-width;
    height: 32px;
    background: transparent;

    // Inner chrome holds all the visible styling and scales from the
    // *centre* by binding `x`/`y` to a half-delta against the outer slot.
    // Tauri uses `transform: scale(1.01)` on focus — Slint Rectangles have
    // no scale transform, so we grow width/height and recompute x/y.
    chrome := Rectangle {
        property <float> focus-scale: input.has-focus ? 1.015 : 1.0;
        animate focus-scale { duration: Theme.dur-fast; easing: ease-in-out; }

        width: root.width * focus-scale;
        height: root.height * focus-scale;
        // (parent.size - self.size) / 2 keeps the chrome centred against
        // the outer slot as it scales.
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Rest matches the `ActionPill` chip's shared fill, so adjacent search
        // bars + pills read as one family of controls; any engagement closes
        // it up to opaque, the same way a hovered `PillButton` does.
        background: (chrome-touch.has-hover || input.has-focus)
            ? Theme.surface0
            : Theme.floating-chrome-bg;
        // Pill chrome: 1 px `Theme.surface2` outline at rest, again matching
        // the `ActionPill` chip. Focus lifts it with a soft glow and swaps the
        // ring to a faint accent tint.
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: input.has-focus
            ? Theme.accent.with-alpha(0.18)
            : Theme.surface2;
        drop-shadow-color: input.has-focus
            ? Theme.crust.with-alpha(0.45)
            : Theme.crust.with-alpha(0.15);
        drop-shadow-blur: input.has-focus ? 16px : 2px;
        drop-shadow-offset-y: input.has-focus ? 4px : 1px;
        // Per CLAUDE.md's "don't animate bindings derived from another
        // animating property": `width`/`height` derive from `focus-scale` and
        // `x`/`y` from those, so the ease belongs on the scale — the one thing
        // focus actually changes — and the other three track it per frame.
        //
        // It has to be the scale rather than the dimensions for a second reason.
        // `width` also multiplies `root.width`, which the Settings header drives
        // off the live window width, and Slint restarts an animated binding on
        // dependency *dirtiness* rather than on a value change — so an eased
        // `width` there restarted its curve on every event of a resize drag and
        // the chrome lagged inside its own slot. `focus-scale` reads nothing but
        // `has-focus`, so it only ever sees the toggle.
        animate background, border-color, drop-shadow-color,
                drop-shadow-blur, drop-shadow-offset-y {
            duration: Theme.dur-fast;
            easing: ease-in-out;
        }

        // Wraps the content rather than sitting beside it. As a *sibling* its
        // `has-hover` only reported the padding and border edge: `TextInput`
        // consumes the hit test, so the pointer vanished the moment it crossed
        // into the text and the hover step of the fill above dropped back to
        // rest. An ancestor TouchArea gets `has-hover` on the top-down filter
        // pass and still forwards the event, so the deepest TouchArea (the
        // clear button) and the `TextInput` keep their clicks, drags and
        // caret placement. Same wrapping fix, same reason, as `touch` in
        // `track-list/track-list-row.slint`.
        chrome-touch := TouchArea {
            width: 100%;
            height: 100%;
            // Forwards focus to the input on click so the whole pill is the
            // target, not just the inner TextInput.
            clicked => { input.focus(); }

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-xs;
            spacing: Theme.pad-xs;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "search";
                    icon-size: root.icon-size;
                    icon-color: input.has-focus ? Theme.accent : Theme.subtext0;
                    animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
                }
            }

            // Slint's TextInput renders the editable text; placeholder is
            // faked by overlaying a Text when the input is empty.
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        // Both the placeholder Text and the TextInput fill
                        // this 20 px box (`height: 100%`) so their
                        // `vertical-alignment: center` actually centres the
                        // glyph line-box inside it — without an explicit
                        // height they auto-size to the line-box and pin to
                        // the top of the box, reading ~1 px high.
                        placeholder-text := Text {
                            visible: root.text == "";
                            text: root.placeholder;
                            // `overlay2`, not `overlay0`: outside Catppuccin
                            // the palettes use `overlay0` as a low-elevation
                            // *surface* rung, so it lands within a shade or
                            // two of this bar's own `surface0` fill on every
                            // light theme (macOS Light is 1.05:1) and the
                            // placeholder all but vanishes. `overlay2` is the
                            // strongest decoration rung in all twelve
                            // palettes while still reading weaker than the
                            // typed `Theme.text` below.
                            color: Theme.overlay2;
                            font-size: Theme.font-size-md;
                            vertical-alignment: center;
                            x: 0;
                            // Bounded, and only then elided. The parent is a
                            // plain Rectangle rather than a layout, so without
                            // a width of its own the compiler hands this Text
                            // its *implicit* size — the untruncated string —
                            // and it paints straight through the pill's right
                            // edge and out of the bar. Eliding alone doesn't
                            // save it: elide lowers a Text's layout *minimum*
                            // to one ellipsis and leaves `preferred` at the
                            // full string, and the implicit size is the larger
                            // of the two. The `TextInput` below never had the
                            // bug because it already carries this same
                            // `width: 100%`, and clips itself besides.
                            width: 100%;
                            height: 100%;
                            overflow: elide;
                        }
                        input := TextInput {
                            text <=> root.text;
                            color: Theme.text;
                            font-size: Theme.font-size-md;
                            single-line: true;
                            vertical-alignment: center;
                            x: 0;
                            width: 100%;
                            height: 100%;
                            edited => { root.edited(self.text); }
                            accepted => { root.accepted(); }
                        }
                    }
                }
            }

            if root.text != "": Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: clear-touch.has-hover ? Theme.surface1 : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                MaterialIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "close";
                    icon-size: 14px;
                    icon-color: Theme.subtext0;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
        }
    }
}
