import { Theme } from "../theme.slint";
import { HeroBackdrop } from "../globals/hero-backdrop.slint";

// Full-bleed hero blur: a gradient floor, two cross-fading `Image` slots, and a scrim. The Slint
// half of the dual-slot contract `write_crossfade_slot` drives — the outgoing slot is never
// cleared, so a refresh fades A↔B without flashing. Mounted by both shared bands.
//
// **Every colour comes from `HeroBackdrop`, solved per artwork, and none may be a `Theme.*`
// brush** — theme brushes flip polarity with the variant, so the same cover would paint a dark
// banner under one and a near-white one under another. `width/height: 100%` on the children is
// mandatory: an `Image` does not auto-fill its parent and would draw at its native buffer size.
export component HeroBlurBackdrop inherits Rectangle {
    in property <image> blur-a;
    in property <image> blur-b;
    in property <bool> use-a;
    in property <bool> has-blur;

    // Whether the host is painting a hero at all. The two mosaic bands always are and take the
    // default; `LibraryTabBand` morphs, and on a tabbed page its globals outlive the tab that
    // filled them, so the floor would ease *from* a banner nobody has seen since the tab changed —
    // leave a genre, open a playlist elsewhere, and the genre's stops sit uncovered under the
    // morph. While the host paints no hero this floor is nothing, and an opening one eases up.
    in property <bool> hero-open: true;

    // **The floor eases on the slots' own duration**, like the scrim below it — it is the layer
    // that *is* the backdrop whenever there is no blur image: an artwork-less hero, Genre Detail's
    // name-hashed stops, and the window between a hero opening and its decode landing.
    // `Brush::interpolate` handles gradient↔gradient stop-for-stop and both sides here are two
    // stops at 135deg — including the transparent pair, which is why the gate swaps the *stops*
    // rather than the whole brush. Safe to `animate` where a tab-bar brush is not: Rust writes
    // these discretely, so the binding can't be restarted by a moving source.
    //
    // The scrim below is deliberately *not* gated: solved at a tone holding almost no chroma, it
    // is near-black at both ends, and draining it would brighten the artwork through the collapse.
    background: root.hero-open
        ? @linear-gradient(135deg, HeroBackdrop.floor-start, HeroBackdrop.floor-end)
        : @linear-gradient(135deg, transparent, transparent);
    animate background { duration: Theme.dur-med; easing: ease-in-out; }

    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-a;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.blur-b;
        image-fit: ImageFit.cover;
        opacity: (root.has-blur && !root.use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    // The opacity is solved per artwork and baked into the brush, hence no `with-alpha`: a white
    // sleeve needs roughly twice what a black one does. Animated on the slots' own duration, so a
    // swap and its scrim land together instead of the scrim snapping ahead.
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: HeroBackdrop.scrim;
        animate background { duration: Theme.dur-med; easing: ease-in-out; }
    }
}
