import { QueueRow } from "../models.slint";

// The two surfaces rendering the play queue — the bottom-sheet inspector and the Up Next
// list inside Now Playing. Same rows, deliberately separate lifecycles.

// The bottom-sheet inspector. Rust owns the `rows` model and writes both it and
// `current-index` from a subscriber on the same `sinks.queue` watch `Player.queue` reads.
//
// **The drag plumbing is bespoke rather than `DragArea` / `DropArea`** — see
// `queue-row-item.slint` for why those don't fit a reorder. The sheet flips `drag-source` and
// `drop-slot` from row-level `pointer-event` handlers and fires `reorder` only on pointer-up,
// so no Rust round-trip happens mid-drag. Two things clear the pair out from under a drag the
// pressed row can no longer finish: Rust when it rebuilds `rows`, and the sheet on either
// `open` transition and at mount.
//
// `open` is mirrored to a Rust atomic through `open-changed`, which the winit `DroppedFile`
// filter consults before forwarding paths. A global can't watch its own property, so the sheet
// mirrors `Queue.open` locally.
export global Queue {
    in-out property <[QueueRow]> rows;
    // -1 when nothing is playing. Rows derive `playing: idx == current-index`, so the
    // highlight flips without a model rewrite.
    in property <int> current-index: -1;
    // A Slint expression can't iterate a model, so Rust maintains this and the header swaps
    // its label off it rather than walking `rows`.
    in property <int> selected-count: 0;
    // The close animation needs the overlay mounted past `open == false`, so the sheet never
    // gates on `if Queue.open` — it stays in the tree and fades.
    in-out property <bool> open;
    // -1 when idle, else the play-order index being dragged.
    in-out property <int> drag-source: -1;
    // Where the dragged row would land, in `[0, rows.length]`. **Slot semantics, not
    // row-index**: slot K is the *gap* between rows K-1 and K, which is what makes "just above
    // source" and "just below source" recognisable no-ops the sheet hides. -1 is no candidate.
    in-out property <int> drop-slot: -1;
    // Mirrored from Rust on an OS file-hover for the drop banner, gated in markup on
    // `is-drop-hovered && open`. Wayland needs the vendored winit patch.
    in property <bool> is-drop-hovered: false;

    // Lazy row cover against the sheet's *own* tier, so closing releases every buffer.
    //
    // **`generation` does two jobs**: reading it makes the binding depend on
    // `covers-generation`, a `pure` callback's result being cached until a dependency is
    // dirtied; its *value* is whether the tier is warm. Every other lazy-cover surface prewarms
    // and awaits before setting rows — the sheet can't, its rows having to land synchronously
    // for the slide-up to have text on frame one. At 0 the lookup is cache-only, so rows paint
    // placeholders rather than dragging a decode onto the UI thread. Closing rewinds to 0.
    pure callback request-cover(/* artwork-path */ string, /* generation */ int) -> image;
    in property <int> covers-generation: 0;

    // Fires on pointer-up only once the drag passed the 4 px click threshold.
    callback reorder(int /*from*/, int /*to*/);
    callback remove(int /*play_order_index*/);
    // Reads the `selected` bit off the Rust-side shadow for the batch indices.
    callback remove-selected();
    callback skip-to(int /*play_order_index*/);
    callback clear-queue();
    // Close-side effects, so the sheet can close without coupling to the `open-changed` atomic.
    callback close();
    // Plain replaces, ctrl toggles, shift extends; the anchor lives in Rust.
    callback toggle-select(int /*idx*/, bool /*ctrl*/, bool /*shift*/);
    callback clear-selection();
    callback select-all();

    // The `Tracks.toggle-row-favorite` contract: Rust persists, flips the in-memory bit on the
    // matching queue track and on `current_track` when the id matches, then re-emits.
    callback toggle-row-favorite(int /*id*/, bool /*new*/);

    callback open-changed(bool);
}

// The "Up Next" list inside Now Playing. Its own global rather than more fields on the
// already-monolithic `Player`, with the same Rust-owned-model shape as `Queue`.
export global NowPlaying {
    // The next N tracks in play order, current excluded. Rust does the wrap-around slicing.
    in-out property <[QueueRow]> up-next-rows;

    // The `RowCovers` contract once more. No generation counter, unlike `Queue`'s — nothing
    // warms this tier behind the list's back.
    pure callback request-cover(/* artwork-path */ string) -> image;

    // Play-order index of `up-next-rows[0]`, i.e. current + 1.
    in property <int> base-index: 0;

    // Under repeat-all the list wraps past the end of the queue, so a row's real play-order
    // index is `mod(base-index + idx, queue-length)`.
    in property <int> queue-length: 0;

    // Drives the one-shot Up Next slide; anything at or past `slide-frames` is at rest. Rust
    // resets it to 0 **only** on a real current-track change, not on a reorder that keeps the
    // same track.
    //
    // On the global rather than inside the view so Rust's reset lands on the *same* render as
    // the model swap — through a `changed` handler it would be queued for the next loop
    // iteration, painting the post-advance list at rest once first.
    in-out property <int> slide-phase: 18;

    // 1 = advanced forward, -1 = rewound. Written **before** `slide-phase` is reset, so one
    // render picks up both.
    in-out property <int> slide-direction: 1;

    // The transient row rendered alongside the list for the length of the slide. Rust leaves
    // `outgoing-visible` false when there's nothing to render, as on skip-to and queue rebuild.
    in-out property <QueueRow> outgoing-row;
    in-out property <bool> outgoing-visible: false;
}
