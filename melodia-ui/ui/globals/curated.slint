import { TrackListRow, EntityStripRow, EntityGridRow } from "../models.slint";

// The two hero-mosaic pages, both wearing `MosaicTabHero` over their sub-views. Two globals rather
// than one because a Slint component can't be parameterised over a global — the wall
// `impl_mosaic_hero!` works around in Rust; what the pages genuinely share is in the component.

// Three mutually exclusive sub-views: Songs (a sortable, filterable `TrackList`), Most Played and
// Favorite Artists (both virtualized `EntityCardGrid`s). No Favorite Albums tab by design — albums
// are reachable through the Albums tab. **The filter is shared across all three; sort is per-tab**,
// and only Songs and Favorite Artists have one, Most Played being ranked by play count.
export global Favorites {
    // **`tab-count` is the sole definition of how many there are** — Rust clamps the persisted
    // index against it, so a build with fewer tabs can't restore onto an unmounted branch.
    out property <int> tab-songs: 0;
    out property <int> tab-most-played: 1;
    out property <int> tab-artists: 2;
    out property <int> tab-count: 3;

    in-out property <int> tab-idx: 0;
    // **Fires after the bar has already moved `tab-idx`.** Rust persists the pick,
    // releases the departed grid's cover tier and builds the entering one's model.
    callback tab-changed(int);

    // One property for whichever grid tab is mounted — the two are mutually exclusive
    // and share their card geometry. Pushed down from the view's `GridGeometry`.
    in-out property <int> columns: 4;
    callback columns-changed(int);
    // The top-4 cover paths by play count; an empty list renders the empty state. The running
    // time isn't here — it reaches the band as a chip built by `ui::hero_chips`.
    in-out property <[string]> mosaic-paths;
    // **`-1` is "not fetched yet", and every count on both curated globals carries it.** A section
    // leave empties the models these number, so a count left at its last real value outlives its
    // source and suppresses an empty state; resetting to `0` asserts "No favorites yet" for the
    // length of the fetch. Neither `== 0` nor `> 0` matches, so every gate below reads as written.
    in-out property <int>      track-count: -1;

    // Two slots, never cleared, so the outgoing one stays painted through the fade and
    // a mosaic switch never flashes. `has-blur` gates the gradient-floor fallback.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Chunked card rows, one per grid, both on `EntityStripRow`'s unified shape. **Rust
    // fills only the mounted tab's model**, so the hidden one costs nothing.
    in-out property <[EntityGridRow]> most-played-rows;
    in-out property <[EntityGridRow]> artist-rows;
    // Pre-chunk counts gating the two `GridEmptyState`s — `rows.length` is a row count, not a card
    // count. Not the band's, which takes its facts from the `FavoritesUiState` folds. `-1` until
    // fetched; see `track-count` above.
    in-out property <int> most-played-count: -1;
    in-out property <int> artist-count: -1;

    // Its own pair rather than the Songs tab's below, which name track columns this grid has no
    // notion of. **Applied to the Rust-side cache, not the filtered copy** — the cover prewarm
    // reads that cache to pick its first screenful.
    in-out property <string> artist-sort-field: "favorite_count";  // name | favorite_count
    in-out property <string> artist-sort-dir: "desc";
    callback request-artist-sort(string /*field*/);

    // The post-filter view the list renders: Rust filters an internal `tracks-all` cache
    // in memory and writes the result here, as the Tracks view does.
    in-out property <[TrackListRow]> tracks;
    in-out property <string>         filter;
    in-out property <int>            blur-search-tick: 0;
    in-out property <string>         sort-field: "title";  // track_number | title | artist | album | genre | year | length
    in-out property <string>         sort-dir: "asc";


    // The Songs tab's `TrackList` columns, the shape `Tracks` / `AlbumDetail` /
    // `ArtistDetail` share, hydrated from `views.json` under its own key.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: false;
    in-out property <bool> show-artwork: true;

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // One callback per cache tier, so Rust routes each surface into the right LRU; Songs-tab rows
    // go through the shared `RowCovers` global. The two grid lookups take `covers-generation` for
    // the queue sheet's two reasons — reading it makes a `pure` binding re-evaluate once the tier
    // warms behind a mounted grid, and its *value* is the is-it-warm flag. At 0, cache-only.
    in-out property <int> covers-generation: 0;
    pure callback request-mosaic-cover(string)           -> image;
    pure callback request-most-played-cover(string, int) -> image;
    pure callback request-artist-cover(string, int)      -> image;

    // Hero actions. The pill is per-tab: Songs shuffles the filtered track
    // list, Most Played shuffles what its grid is showing.
    callback shuffle-all();
    callback shuffle-most-played();

    // `open-artist` stamps `ArtistDetail.origin-nav-index` **synchronously before**
    // flipping `Nav.selected-index`, so the back button returns here.
    callback play-track(int /*track_id*/);
    callback open-artist(int /*artist_id*/);

    // Songs-tab row interactions — same shape as Tracks / AlbumDetail.
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback filter-changed(string);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Page enter/leave — a sidebar nav, or Now Playing opening over it. Mirrored into
    // `FavoritesUi.section_active` to drive the cache release / re-fetch.
    callback section-active-changed(bool);

    // The Favorite-Artist card subtitle. Slint 1.16 exposes no Rust-callable `tr`, so Rust resolves
    // the plural through this at row-build time; shares its msgid with the hero count line.
    pure callback artist-favorite-subtitle(int /*count*/) -> string;
    artist-favorite-subtitle(count) => {
        return @tr("{n} favorite" | "{n} favorites" % count);
    }
}

// The shared hero over two mutually exclusive sub-views — Songs (a filterable `TrackList` of the
// most-recently-played tracks) and Most Played (a virtualized `EntityCardGrid` ranked by play
// count). One scroller per tab, which keeps this page off the `CompositeScrollbars` wheel routing.
// **The filter is shared across both tabs, and neither has a sort**: Songs mounts `sortable: false`
// — recency *is* the page — and Most Played's title names its own ordering.
export global RecentlyPlayed {
    // **`tab-count` is the sole definition of how many there are** — Rust clamps the persisted
    // index against it, so a build with fewer tabs can't restore onto an unmounted branch.
    out property <int> tab-songs: 0;
    out property <int> tab-most-played: 1;
    out property <int> tab-count: 2;

    in-out property <int> tab-idx: 0;
    // **Fires after the bar has already moved `tab-idx`.** Rust persists the pick,
    // releases the departed tab's cover tier and builds the entering one's model.
    callback tab-changed(int);

    // The Most Played grid's column count, pushed down from the view's `GridGeometry`.
    in-out property <int> columns: 4;
    callback columns-changed(int);

    // Up to four distinct most-recently-played covers; an empty list renders the empty-state tile.
    in-out property <[string]> mosaic-paths;

    // The `Favorites` dual-slot contract.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Library-wide tracks by play count, chunked into grid rows. **Rust fills this only
    // while Most Played is the mounted tab**, so the hidden one costs nothing.
    in-out property <[EntityGridRow]> most-played-rows;
    // Pre-chunk card count gating the `GridEmptyState` — `rows.length` is a row count, not a card
    // count. Not the band's, which takes its facts from `most_played_totals`. `-1` until fetched,
    // which is also what a tab pick writes back when the cache it walked was left empty.
    in-out property <int> most-played-count: -1;

    // The post-filter view Rust writes, always in fetch (recency) order. **There is no
    // sort state**: the list is mounted non-sortable, recency being the whole page.
    in-out property <[TrackListRow]> tracks;
    in-out property <string>         filter;
    in-out property <int>            blur-search-tick: 0;

    // Over the full recency set, not the filter. The running time isn't here — it reaches the band
    // as a chip, Rust having already formatted the string. `-1` until fetched.
    in-out property <int> track-count: -1;

    // The `Favorites` / `Tracks` column shape, hydrated from `views.json` under its own key.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: false;
    in-out property <bool> show-artwork: true;

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // The mosaic tiles and the grid cards; Songs rows go through `RowCovers`. The grid lookup
    // takes `covers-generation` for the reason `Favorites`' pair do.
    in-out property <int> covers-generation: 0;
    pure callback request-mosaic-cover(string)           -> image;
    pure callback request-most-played-cover(string, int) -> image;

    // Hero actions. The pill is per-tab: Songs shuffles the filtered recency list, Most
    // Played shuffles what its grid is showing.
    callback shuffle-all();
    callback shuffle-most-played();

    // A Most Played card click starts playback in that scope.
    callback play-track(int /*track_id*/);

    // The Tracks / Favorites row shape.
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback toggle-column(string /*column_id*/);
    callback filter-changed(string);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Section-visible signal — driven by `watched-recently-active` in `app-window.slint`.
    callback section-active-changed(bool);
}
