import { TrackListRow, BrowseFolderRow, BreadcrumbRow } from "../models.slint";

// The two flat track-list views, plus the shared row-cover lookup that every
// `TrackListRow` consumer in the tree resolves its thumbnail through.

// The Tracks view. Rust owns `rows` and the full unfiltered Vec behind it:
// `apply-filter` re-derives `rows` in memory, `request-sort` re-queries.
export global Tracks {
    in-out property <[TrackListRow]> rows;
    // `-1` until fetched; see `Albums.total-count`.
    in-out property <int> total-count: -1;   // pre-filter count
    in-out property <string> filter;
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // **Every column is fixed-width** — the GTK-TreeView model, as Audacious,
    // foobar2000 and file managers use: each independently resizable, with a horizontal
    // scrollbar once the cumulative width passes the container. Not flex-with-cap.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // `title` and `length` aren't toggleable. `show-artwork` is a pseudo-toggle
    // controlling only the thumbnail inside the title cell, not the cell.
    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    callback request-sort(string /*field*/);
    callback apply-filter(string);
    callback play-row(int /*track_id*/, int /*index_in_filtered*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback request-refresh();
    // Whether the section is on screen. Rust skips `library_changed` refreshes while
    // hidden and runs one deferred re-fetch on re-enter.
    callback section-active-changed(bool);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Modifiers come off the row's pointer-event as bools; Rust does the work and walks
    // the model to flip the per-row `selected` flags, a Slint expression not being able
    // to iterate one.
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();

    // Slint flips the matching `show-*` synchronously, then Rust persists the new
    // visible-column list.
    callback toggle-column(string /*column_id*/);
}

// The Browse view — the Slint-side surface of three Rust-owned models;
// `src/ui/browse/` documents the ownership and fetch rules.
//
// `rows` renders through the shared `TrackList`, so the column / sort / selection shape
// mirrors `Tracks`. **Disk-only files** — on disk inside a library folder but not in the
// DB — arrive with `id == 0` and `enabled == false`, so they render dimmed and inert.
//
// An empty `current-path` is the root state: Rust lists the library folders as drillable
// rows, and `has-library-folders` going false is what paints the CTA instead. `loading`
// gates the empty state so a stale "Empty folder" can't flash mid-drill-down, and a
// non-empty `error-message` replaces the rows outright.
export global Browse {
    in-out property <string> current-path;             // "" = root (library list)
    in-out property <[BrowseFolderRow]> folders;
    in-out property <[TrackListRow]> rows;
    in-out property <[BreadcrumbRow]> breadcrumbs;
    in-out property <bool> loading;
    in-out property <bool> can-go-back;
    in-out property <string> error-message;            // "" = no error
    in-out property <bool> has-library-folders;        // false → root empty-state CTA

    // Separate from `Tracks` so Browse keeps its own column layout, under its own
    // `views.json` key.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sorted in memory rather than re-queried: the list mixes disk-only and DB files, so
    // there is no query that returns it.
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";

    // The `Tracks` shape. Disk-only rows are never selectable — the Rust handler ignores
    // them.
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    callback open-folder(string /*path*/);
    callback go-back();
    callback navigate-to(string /*absolute-path*/);    // breadcrumb segment click
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int] /*track_ids*/);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback refresh();
    // As `Tracks.section-active-changed` — skip refreshes while hidden, one deferred
    // re-fetch on re-enter.
    callback section-active-changed(bool);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
}

// The lazy thumbnail lookup **every** `TrackListRowItem` in the tree resolves through —
// they all render the same row component. One global rather than per-view forwarding,
// wired once to the shared row-tier LRU. Rows carry only `artwork_path` and the decode
// happens here, per *instantiated* row: a virtualized list pays for the visible ones,
// and no model row pins a buffer the LRU has already evicted.
export global RowCovers {
    pure callback request(string /*artwork_path*/) -> image;
}
