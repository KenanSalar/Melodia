import { PlaylistPickRow, PlaylistExportPickRow } from "../models.slint";
import { SmartEditor, TagEditor, ScrobbleUi } from "dialog-forms.slint";
import { LibrarySettings } from "library-settings.slint";
import { Playlists, PlaylistDetail } from "playlists.slint";
import { Queue } from "queue.slint";
import { WindowChrome } from "shell.slint";

// One root-level overlay serving both info ("OK"-only) and confirmation modals.
//
// A caller sets the chrome plus a routing payload — `kind` and `target-id` — and flips
// `open`; the default `accepted` handler below reads `kind` and forwards to the
// matching action. That keeps the whole confirmation flow declarative, with no boxed
// closure retained on the Rust side between open and confirm. Leaving `cancel-label`
// empty is the info-only mode: the Cancel button drops out of the layout tree entirely
// so the primary button stays flush right.
//
// The overlay is always rendered rather than gated on `open`, so the close animation
// can play after `open` flips back. One `t: float` drives the backdrop alpha and the
// card derives a faster `card-t` off it, so its small-area fade keeps perceptual pace
// with the backdrop's large-area dim — plain derivations, not a second `animate`, which
// would phase-lag. For input safety the backdrop TouchArea is `enabled: Dialog.open` and
// the card is `visible: t > 0.01`, so no stale click reaches a button mid-fade.
export global Dialog {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> confirm-label: "OK";
    // Empty string ⇒ single-button info dialog (no Cancel rendered).
    in-out property <string> cancel-label;
    // Paints the confirm button in `Theme.danger` / `danger-text` rather than accent.
    in-out property <bool> destructive;

    // The routing payload the `accepted` dispatcher reads: `kind` discriminates the
    // action, `target-id` carries the entity id. Plain primitives, no allocation.
    in-out property <string> kind;
    in-out property <int> target-id: -1;

    // For the kinds that prompt for a string: a playlist name, and an optional
    // description. Two-way bound to `LabeledInput`s in the body, and cleared on
    // teardown so nothing leaks into the next dialog.
    in-out property <string> input-text;
    in-out property <string> input-text-2;

    // The mosaic picker's 1–4 picked paths. **Empty means "clear artwork"** — revert to
    // the auto first-track thumbnail — which is why `mosaic-touched` exists below.
    in-out property <[string]> mosaic-selection;

    // The candidate pool: the playlist's own track artwork, deduplicated in playlist
    // order. Rust fills it before opening; the picker iterates it for the tile grid.
    in-out property <[string]> mosaic-candidates;

    // The playlist's currently saved artwork, so the picker opens on what the artwork
    // looks like *now* rather than an empty placeholder. Rust takes it from
    // `PlaylistDetail.cover` when that view is open, else a sync grid-tier lookup.
    in-out property <image> current-artwork;

    // Whether the user has touched the picker at all — set by any candidate toggle and
    // by Clear. The preview reads it to switch from "saved artwork" to "what Apply
    // would save", and the dispatcher uses it as a guard: an empty selection that was
    // never touched is a no-op, so opening the dialog and confirming can't silently
    // wipe a playlist's artwork.
    in-out property <bool> mosaic-touched;

    // Stashed when the user picks "New Playlist…" from a row's Add-to-Playlist submenu,
    // so Create can add them the moment the playlist exists; empty is a plain Create.
    // The `add-to-playlist` picker reuses it as the canonical list being added.
    in-out property <[int]> pending-track-ids;

    // The Add-to-Playlist picker's rows, populated by Rust *before* `open` flips, so
    // the dialog opens already filled. Rust also maintains the count on every toggle,
    // counting only enabled rows, so the footer button can disable itself without
    // iterating the model in Slint. All three are cleared in the teardown.
    in-out property <[PlaylistPickRow]> playlist-pick-rows;
    in-out property <bool> add-select-all: false;
    in-out property <int> add-selected-count: 0;

    // The Export picker, same shape — but every row opens `selected: false`, so
    // exporting is opt-in.
    in-out property <[PlaylistExportPickRow]> export-pick-rows;
    in-out property <bool> export-select-all: false;
    in-out property <int> export-selected-count: 0;

    // `pending-track-ids.length` snapshotted at open, so a picker row can derive
    // `disabled` without re-reading the array per row.
    in-out property <int> pick-total-tracks;

    callback accepted();
    callback cancelled();

    // The dispatcher lives on the global because Slint rejects
    // `Dialog.accepted => { … }` at component scope but accepts a default body here —
    // which gives exactly one of it, in one place. A new confirm flow is one `else if`
    // plus a populate block in the calling view; no Rust, no retained closure.
    //
    // **Never clear state in these handlers.** Clearing `kind` here unmounts whichever
    // body branch is gated on it — the text-input form, the mosaic picker — before the
    // card's close animation plays, giving a frame of empty card still fading out.
    // Teardown belongs in `closed-teardown` below, which fires once the fade completes.
    accepted => {
        if (root.kind == "remove-folder") {
            LibrarySettings.remove-folder(root.target-id);
        } else if (root.kind == "restart-titlebar") {
            // `target-id` carries the new value — 1 native, 0 custom — which
            // `restart-app` reads back off the global.
            WindowChrome.restart-app();
        } else if (root.kind == "restart-tray") {
            // Likewise: 1 enabled, 0 disabled.
            WindowChrome.restart-tray();
        } else if (root.kind == "clear-queue") {
            Queue.clear-queue();
        } else if (root.kind == "remove-queue-selected") {
            Queue.remove-selected();
        } else if (root.kind == "create-playlist") {
            // Name, optional description, and the ids to auto-add once it exists.
            Playlists.create-playlist(
                root.input-text,
                root.input-text-2,
                root.pending-track-ids,
            );
        } else if (root.kind == "rename-playlist") {
            Playlists.rename-playlist(
                root.target-id,
                root.input-text,
                root.input-text-2,
            );
        } else if (root.kind == "delete-playlist") {
            Playlists.delete-playlist(root.target-id);
        } else if (root.kind == "edit-playlist-artwork") {
            // Empty and touched reverts to auto; empty and untouched is a no-op, so
            // opening the dialog and confirming can't wipe saved artwork.
            if (root.mosaic-selection.length == 0) {
                if (root.mosaic-touched) {
                    Playlists.clear-artwork(root.target-id);
                }
            } else {
                Playlists.apply-mosaic(root.target-id, root.mosaic-selection);
            }
        } else if (root.kind == "remove-playlist-selected") {
            PlaylistDetail.remove-selected();
        } else if (root.kind == "export-playlists") {
            // Rust reads the ticked rows, opens the folder picker, writes the files.
            Playlists.export-selected-playlists();
        } else if (root.kind == "add-to-playlist") {
            // Rust adds `pending-track-ids` into every ticked enabled row, then toasts.
            Playlists.add-tracks-to-selected();
        } else if (root.kind == "smart-playlist-editor") {
            // Rust rebuilds a `SmartCriteria` from the rules and scalars.
            SmartEditor.commit();
        } else if (root.kind == "edit-tags") {
            // Rust diffs the form against the populate-time snapshot; a no-op commit
            // short-circuits.
            TagEditor.commit();
        } else if (root.kind == "scrobble-listenbrainz-login") {
            // The dialog stays open — `dialog.slint` suppresses auto-close for this
            // kind — and Rust closes it once the token validates.
            ScrobbleUi.listenbrainz-verify(ScrobbleUi.lb-token);
        } else if (root.kind == "scrobble-lastfm-login") {
            // Step 0 opens the browser approval page, step 1 finishes the session
            // exchange; the dialog stays open across both.
            if (ScrobbleUi.lastfm-step == 0) {
                ScrobbleUi.lastfm-open-auth();
            } else {
                ScrobbleUi.lastfm-finish(ScrobbleUi.lastfm-token);
            }
        }
    }
    cancelled => { }

    // Fired by `DialogOverlay` once the close animation reaches t ≈ 0. It has exactly
    // **one** handler, registered in Rust, which tears down in two halves: this global's
    // `closed-teardown()` for every scalar and list, and the `image`-typed
    // `current-artwork` from Rust — that one has no Slint default literal, and resetting
    // it is what releases the `SharedPixelBuffer` Arc taken at open.
    //
    // **The teardown is a `public function`, not a second callback**, and that is
    // load-bearing. A callback has one handler slot, so a default `closed => { … }` body
    // here is installed during `InnerDialog::new()` and then silently replaced by the
    // Rust `on_closed` — dead code, leaving `kind` and the picker models uncleared and
    // every row's cover Arc pinned for the life of the process. A `public function` has
    // no slot to clobber.
    //
    // Don't re-register `closed` from inside its own handler: `Callback::call` `take()`s
    // the handler for the duration and asserts. Invoking a *different* item is safe.
    callback closed();

    public function closed-teardown() {
        // Routing / kind-gated body branches.
        root.kind = "";
        root.target-id = -1;
        // Text-input dialog state.
        root.input-text = "";
        root.input-text-2 = "";
        // Mosaic-picker state.
        root.mosaic-selection = [];
        root.mosaic-candidates = [];
        root.mosaic-touched = false;
        root.pending-track-ids = [];
        // Add-to-Playlist picker. Clearing the rows unmounts the picker's `for` loop,
        // which drops every row's cover binding and with it the row-tier LRU's
        // `SharedPixelBuffer` Arcs — paired with the Rust-side `heap_trim::trim()`.
        root.playlist-pick-rows = [];
        root.add-select-all = false;
        root.add-selected-count = 0;
        root.pick-total-tracks = 0;
        // Export picker state.
        root.export-pick-rows = [];
        root.export-select-all = false;
        root.export-selected-count = 0;
        // Clearing the chrome lets the conditional message Text and Cancel button
        // unmount between uses instead of sitting mounted with stale strings inside an
        // invisible card. `confirm-label` is **restored** to `"OK"` rather than cleared,
        // so a caller that flips `open` without setting it still gets a labelled button.
        root.title = "";
        root.message = "";
        root.confirm-label = "OK";
        root.cancel-label = "";
        root.destructive = false;
    }
}
