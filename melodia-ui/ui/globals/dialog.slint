import { PlaylistPickRow, PlaylistExportPickRow } from "../models.slint";
import { SmartEditor, TagEditor, ScrobbleUi } from "dialog-forms.slint";
import { LibrarySettings } from "library-settings.slint";
import { Playlists, PlaylistDetail } from "playlists.slint";
import { Queue } from "queue.slint";
import { WindowChrome } from "shell.slint";

// One root-level overlay serving both info ("OK"-only) and confirmation modals. A caller sets the
// chrome plus a routing payload — `kind` and `target-id` — and flips `open`; the default `accepted`
// handler reads `kind` and forwards, so no boxed closure is retained on the Rust side. An empty
// `cancel-label` is info-only mode, the button dropping out of the layout tree.
//
// Always rendered rather than gated on `open`, so the close animation can play after `open` flips
// back. One `t: float` drives the backdrop alpha and the card derives a faster `card-t` off it — a
// derivation, not a second `animate`, which would phase-lag. The backdrop TouchArea is
// `enabled: Dialog.open` and the card `visible: t > 0.01`, so no stale click reaches a button.
export global Dialog {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> confirm-label: "OK";
    // Empty string ⇒ single-button info dialog (no Cancel rendered).
    in-out property <string> cancel-label;
    // Paints the confirm button in `Theme.danger` / `danger-text` rather than accent.
    in-out property <bool> destructive;

    // The routing payload the `accepted` dispatcher reads: `kind` discriminates the
    // action, `target-id` carries the entity id. Plain primitives, no allocation.
    in-out property <string> kind;
    in-out property <int> target-id: -1;

    // For the kinds that prompt for a string: a playlist name, and an optional description. Two-way
    // bound to `LabeledInput`s in the body, cleared on teardown so nothing leaks into the next.
    in-out property <string> input-text;
    in-out property <string> input-text-2;

    // The mosaic picker's 1–4 picked paths. **Empty means "clear artwork"** — revert to
    // the auto first-track thumbnail — which is why `mosaic-touched` exists below.
    in-out property <[string]> mosaic-selection;

    // The candidate pool: the playlist's own track artwork, deduplicated in playlist
    // order. Rust fills it before opening; the picker iterates it for the tile grid.
    in-out property <[string]> mosaic-candidates;

    // The playlist's currently saved artwork, so the picker opens on what it looks like *now*
    // rather than an empty placeholder. From `PlaylistDetail.cover` when that view is open, else a
    // sync grid-tier lookup.
    in-out property <image> current-artwork;

    // Set by any candidate toggle and by Clear. The preview reads it to switch from saved artwork
    // to "what Apply would save", and the dispatcher guards on it — an untouched empty is a no-op,
    // so opening and confirming can't silently wipe saved artwork.
    in-out property <bool> mosaic-touched;

    // Stashed when the user picks "New Playlist…" from a row's Add-to-Playlist submenu, so Create
    // can add them the moment the playlist exists; empty is a plain Create. The `add-to-playlist`
    // picker reuses it as the canonical list being added.
    in-out property <[int]> pending-track-ids;

    // Populated by Rust *before* `open` flips, so the dialog opens already filled. Rust maintains
    // the count over enabled rows only, so the footer can disable itself without iterating in
    // Slint. All three are cleared in the teardown.
    in-out property <[PlaylistPickRow]> playlist-pick-rows;
    in-out property <bool> add-select-all: false;
    in-out property <int> add-selected-count: 0;

    // The Export picker, same shape — but every row opens `selected: false`, so it is opt-in.
    in-out property <[PlaylistExportPickRow]> export-pick-rows;
    in-out property <bool> export-select-all: false;
    in-out property <int> export-selected-count: 0;

    // `pending-track-ids.length` snapshotted at open, so a picker row can derive
    // `disabled` without re-reading the array per row.
    in-out property <int> pick-total-tracks;

    callback accepted();
    callback cancelled();

    // On the global because Slint rejects `Dialog.accepted => { … }` at component scope but accepts
    // a default body here, giving exactly one of it. A new confirm flow is one `else if` plus a
    // populate block in the calling view. **Never clear state in these handlers** — clearing `kind`
    // unmounts whichever body branch is gated on it before the close animation plays, leaving an
    // empty card fading out. Teardown belongs in `closed-teardown` below.
    accepted => {
        if (root.kind == "remove-folder") {
            LibrarySettings.remove-folder(root.target-id);
        } else if (root.kind == "restart-titlebar") {
            // `target-id` carries the new value — 1 native, 0 custom — read back off the global.
            WindowChrome.restart-app();
        } else if (root.kind == "restart-tray") {
            // Likewise: 1 enabled, 0 disabled.
            WindowChrome.restart-tray();
        } else if (root.kind == "clear-queue") {
            Queue.clear-queue();
        } else if (root.kind == "remove-queue-selected") {
            Queue.remove-selected();
        } else if (root.kind == "create-playlist") {
            // Name, optional description, and the ids to auto-add once it exists.
            Playlists.create-playlist(
                root.input-text,
                root.input-text-2,
                root.pending-track-ids,
            );
        } else if (root.kind == "rename-playlist") {
            Playlists.rename-playlist(
                root.target-id,
                root.input-text,
                root.input-text-2,
            );
        } else if (root.kind == "delete-playlist") {
            Playlists.delete-playlist(root.target-id);
        } else if (root.kind == "edit-playlist-artwork") {
            // Empty and touched reverts to auto; empty and untouched is a no-op.
            if (root.mosaic-selection.length == 0) {
                if (root.mosaic-touched) {
                    Playlists.clear-artwork(root.target-id);
                }
            } else {
                Playlists.apply-mosaic(root.target-id, root.mosaic-selection);
            }
        } else if (root.kind == "remove-playlist-selected") {
            PlaylistDetail.remove-selected();
        } else if (root.kind == "export-playlists") {
            // Rust reads the ticked rows, opens the folder picker, writes the files.
            Playlists.export-selected-playlists();
        } else if (root.kind == "add-to-playlist") {
            // Rust adds `pending-track-ids` into every ticked enabled row, then toasts.
            Playlists.add-tracks-to-selected();
        } else if (root.kind == "smart-playlist-editor") {
            // Rust rebuilds a `SmartCriteria` from the rules and scalars.
            SmartEditor.commit();
        } else if (root.kind == "edit-tags") {
            // Rust diffs the form against the populate-time snapshot; a no-op commit is dropped.
            TagEditor.commit();
        } else if (root.kind == "scrobble-listenbrainz-login") {
            // The dialog stays open — `dialog.slint` suppresses auto-close for this kind — until
            // Rust closes it on a valid token.
            ScrobbleUi.listenbrainz-verify(ScrobbleUi.lb-token);
        } else if (root.kind == "scrobble-lastfm-login") {
            // Step 0 opens the browser approval page, step 1 finishes the session
            // exchange; the dialog stays open across both.
            if (ScrobbleUi.lastfm-step == 0) {
                ScrobbleUi.lastfm-open-auth();
            } else {
                ScrobbleUi.lastfm-finish(ScrobbleUi.lastfm-token);
            }
        }
    }
    cancelled => { }

    // Fired by `DialogOverlay` once the close animation reaches t ≈ 0, with exactly **one** handler
    // registered in Rust. It tears down in two halves: this global's `closed-teardown()` for every
    // scalar and list, and the `image`-typed `current-artwork` from Rust, which has no Slint default
    // literal and pins a `SharedPixelBuffer` Arc. **The teardown is a `public function`, not a
    // second callback**: a callback has one handler slot, so a default body here is installed at
    // construction and then silently replaced by the Rust `on_closed`. Don't re-register `closed`
    // from inside its own handler either — `Callback::call` `take()`s it and asserts.
    callback closed();

    public function closed-teardown() {
        // Routing / kind-gated body branches.
        root.kind = "";
        root.target-id = -1;
        // Text-input dialog state.
        root.input-text = "";
        root.input-text-2 = "";
        // Mosaic-picker state.
        root.mosaic-selection = [];
        root.mosaic-candidates = [];
        root.mosaic-touched = false;
        root.pending-track-ids = [];
        // Clearing the rows unmounts the picker's `for` loop, dropping every row's cover binding
        // and with it the row-tier LRU's `SharedPixelBuffer` Arcs — paired with `heap_trim::trim`.
        root.playlist-pick-rows = [];
        root.add-select-all = false;
        root.add-selected-count = 0;
        root.pick-total-tracks = 0;
        // Export picker state.
        root.export-pick-rows = [];
        root.export-select-all = false;
        root.export-selected-count = 0;
        // Lets the conditional message Text and Cancel button unmount between uses rather than sit
        // with stale strings. `confirm-label` is **restored** to `"OK"`, never cleared, so a caller
        // that flips `open` without setting it still gets a label.
        root.title = "";
        root.message = "";
        root.confirm-label = "OK";
        root.cancel-label = "";
        root.destructive = false;
    }

    // Openers — the symmetric half of the `accepted` dispatcher: that owns where a confirmed dialog
    // *goes*, these own what it *says*. `public function`s rather than callbacks for the
    // `closed-teardown()` reason, and they take their payload as parameters, so this file imports no
    // sibling global on their account.
    //
    // **Only the kinds opened from more than one place are here**, a kind with one caller earning
    // nothing by moving.
    // `ui::playlists::tests::every_multi_caller_playlist_dialog_opens_through_its_own_function`
    // walks the tree rather than naming the six call sites, what it guards against being the
    // *seventh* — a re-spelled populate block opens the right dialog and is free to drift.

    // Three call sites: the Playlists tab's New pill, Ctrl+N, and a track row's Add-to-Playlist →
    // "New Playlist…". The last passes the ids to add once the row exists, the other two `[]`.
    public function open-create-playlist(track-ids: [int]) {
        root.title = @tr("New Playlist");
        root.message = "";
        root.confirm-label = @tr("Create");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = "create-playlist";
        root.target-id = -1;
        root.input-text = "";
        root.input-text-2 = "";
        root.pending-track-ids = track-ids;
        root.open = true;
    }

    // Two call sites — the Playlists grid card's overflow and the open playlist's pill row —
    // differing only in where they read the current name and description from.
    public function open-rename-playlist(id: int, name: string, description: string) {
        root.title = @tr("Rename Playlist");
        root.message = "";
        root.confirm-label = @tr("Save");
        root.cancel-label = @tr("Cancel");
        root.destructive = false;
        root.kind = "rename-playlist";
        root.target-id = id;
        root.input-text = name;
        root.input-text-2 = description;
        root.open = true;
    }

    // Same two call sites as the rename above.
    public function open-delete-playlist(id: int) {
        root.title = @tr("Delete playlist?");
        root.message = @tr("The playlist and its track order will be removed. The tracks themselves stay in your library.");
        root.confirm-label = @tr("Delete");
        root.cancel-label = @tr("Cancel");
        root.destructive = true;
        root.kind = "delete-playlist";
        root.target-id = id;
        root.open = true;
    }
}
