import { AlbumRow, AlbumGridRow, TrackListRow } from "../models.slint";

// The Album grid. Rust owns `grid-rows`, installed once and rebuilt in place on every filter /
// sort / column-count change; the canonical unfiltered list lives there too, so **neither
// `apply-filter` nor `request-sort` hits the DB**. `columns` is computed by the view from its body
// width and pushed back, so Rust re-chunks into rows of N cards and the `ListView` virtualizes.
export global Albums {
    in-out property <[AlbumGridRow]> grid-rows;
    // `-1` is "not fetched yet" (`ui::tab_bar::UNFETCHED_COUNT`) — the sentinel `curated.slint`
    // argues at `Favorites.track-count`. One thing is new here: the header line interpolates this
    // into a plural and `@tr` would spell the sentinel out, so that `Text` guards on `>= 0`.
    in-out property <int> total-count: -1;      // pre-filter album count
    in-out property <int> columns: 4;           // view-computed; always >= 1
    in-out property <string> filter;
    in-out property <string> sort-field: "name";   // "name" | "year" | "artist"
    in-out property <string> sort-dir: "asc";

    callback columns-changed(int);
    callback apply-filter(string);
    callback request-sort(string /*field*/);
    callback open-album(int /*album_id*/);
    // Invoked from each on-screen card's own binding, so only visible cards decode or lock a
    // cover. `pure` so Slint may evaluate it inside a binding at all.
    pure callback request-cover(string /*artwork_path*/) -> image;
    // Rust releases the album-tier cover cache on `false` and re-warms the first screenful on
    // `true` — the grid-size buffers aren't worth keeping resident while the section is hidden.
    callback section-active-changed(bool);
}

// The Album Detail view: `album-id == -1` shows the grid, `>= 0` swaps in the detail.
// Its table is the shared `TrackList`, so the column / sort / selection shape mirrors
// `Tracks` and `Browse` under its own persistence key. **`show-album` defaults false** —
// the album column is redundant inside a single album.
export global AlbumDetail {
    in-out property <int> album-id: -1;
    in-out property <AlbumRow> album;
    in-out property <[TrackListRow]> tracks;

    // What the band's search box means while this detail is open. Cleared on a fresh open, but
    // preserved across a library-changed refresh so a typed needle survives a scan finishing.
    in-out property <string> filter;

    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: false;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sorted in memory — the query returns a fixed disc/track-number order.
    in-out property <string> sort-field: "track_number";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // The **section** the detail was opened from, or -1 for a drill that started inside My
    // Library. Set synchronously by the cross-tab handler and read by `on_close_detail` to flip
    // `Nav.selected-index` back **before** clearing `album-id`, so the conditional reroutes in the
    // same frame with no grid flash. A drill from a *sibling tab* deliberately records nothing: the
    // back arrow means "close this detail", and the tab bar already says Albums for the whole
    // visit. In-memory only — `last_detail_ids` restores each page on the next launch.
    in-out property <int> origin-nav-index: -1;

    // Decoded **once** per album into a `(cover, blur)` pair by `ui::artwork_cache`.
    in-out property <image> cover;

    // The `Player.blur-img-*` dual-slot contract, so switching albums never flashes.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    // False with no artwork or a failed decode: both slots fade to 0, the gradient floor showing.
    in-out property <bool>  has-blur;

    callback close-detail();
    callback shuffle-album();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Rust re-walks the cached tracks in memory and pushes a filtered model.
    callback filter-changed(string);
}
