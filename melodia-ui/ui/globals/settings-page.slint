import { Theme } from "../theme.slint";

// SettingsPage: chrome state for the Settings page itself — the search
// filter, the rule every section applies to it, and the body's responsive
// geometry.
//
// Split out of `Settings`, which holds the values the user is configuring
// plus a bank of `@tr(...)` string callbacks. How the page is filtered is a
// different axis of change from what the page configures, and `Settings` is
// long enough already.
export global SettingsPage {
    // Tab order. Named so the router in `views/settings/settings-tabs.slint`
    // and the label/icon arrays in `views/settings-view.slint` key off
    // something readable instead of a bare 0..4, and so adding a tab is a
    // rename-safe edit.
    out property <int> tab-library: 0;
    out property <int> tab-playback: 1;
    out property <int> tab-interface: 2;
    out property <int> tab-services: 3;
    out property <int> tab-about: 4;

    // Sole definition of how many tabs exist. Rust reads it through
    // `get_tab_count()` to clamp the persisted index rather than carrying its
    // own copy, so the two can't drift.
    out property <int> tab-count: 5;

    // Which tab is showing. Seeded from `views.json` at boot and persisted on
    // every change, so re-entering the page lands where you left it.
    in-out property <int> tab-idx: 0;
    callback tab-changed(int);

    // Live filter for the page. Empty string ⇒ everything visible. Bound
    // two-way to the SearchBar in `ui/views/settings-view.slint`; cleared on
    // nav-away from the page (handler in `ui/app-window.slint`).
    in-out property <string> search-query;

    // Counter the host bumps to release keyboard focus from the SearchBar's
    // TextInput — same pattern as `Tracks.blur-search-tick`. Used when
    // navigating away so the next keystroke doesn't land in a hidden field.
    in-out property <int> blur-search-tick: 0;

    // --- Responsive body -------------------------------------------------
    //
    // These two are written imperatively by `views/settings-view.slint`: a
    // global can't be bound from a view, and the page can't read its own live
    // width into a binding that feeds a child's size without re-entering
    // layout. Everything below them is derived, so the body's geometry is
    // stated once instead of once per consumer.
    //
    // The seed is a plausible narrow page rather than nothing — the view
    // corrects it on its mount `Timer`, and a frame drawn slightly too narrow
    // only costs an extra chip row, where a frame drawn at zero collapses the
    // strips outright.
    in-out property <length> page-w: 440px;
    // 1 or 2. Also what `grid-row`/`grid-col` below key off.
    in-out property <int> body-cols: 1;

    // How wide one card column may grow — **one** number, and both layouts
    // obey it. That is the whole rule: a card grows with the panel until it
    // reaches the cap, then stops and the page gives it margins instead, and a
    // second column appears only once two capped cards fit beside each other.
    // So a card's width only ever grows across the full range of window sizes;
    // at the flip it doesn't move at all, the second column simply arrives.
    //
    // A cap the *flip* undercuts is the failure to avoid: the single column
    // then divides before it ever reaches the cap, which reads as the card
    // growing without limit until it splits in half.
    // The value is a reading measure, and it is also what decides which
    // displays ever see two columns: two capped cards plus the gap plus the
    // sidebar and the page's padding comes to roughly an 1830 px window, so a
    // maximized 1920 reaches it with room to spare. A wider cap makes a longer
    // line inside every card *and* pushes the second column out of reach of
    // the most common large desktop.
    out property <length> card-cap: 800px;

    // What the centred body may grow to: one card, or two plus the gap
    // between them. A function of the layout, not of the panel — the layout
    // that surrounds it clamps to what's actually available.
    out property <length> body-w: root.body-cols == 2
        ? 2 * root.card-cap + Theme.pad-lg
        : root.card-cap;

    // What one column is actually drawn at, which below the cap is just the
    // panel. The `min` only does anything in a single column; two columns are
    // reached exactly when both fit at the cap.
    out property <length> body-avail: max(0px, root.page-w - 2 * Theme.pad-lg);
    out property <length> card-w: min(
        root.body-cols == 2
            ? max(0px, (root.body-avail - Theme.pad-lg) / 2)
            : root.body-avail,
        root.card-cap);

    // The glyph column both settings rows lead with. Here rather than in the
    // rows because `row-content-w` below has to subtract it, and two copies of
    // the number could drift without anything failing — the strips would just
    // wrap a little early or a little late.
    out property <length> row-icon-w: 22px;

    // What a `SettingRowStacked` leaves for its content column: the row's own
    // left and right padding, the gap after the icon, and the icon. Derived
    // rather than measured because every section card spans a full column, so
    // the chip and swatch strips can size their wrap off this and need no
    // width mirror of their own.
    out property <length> row-content-w:
        max(0px, root.card-w - (3 * Theme.pad-lg + root.row-icon-w));

    // Where a page's **column** sits in the body grid — not a card. A page
    // hands the grid one cell per column and each cell is a `VerticalLayout`
    // of cards, so the two sides flow independently and a short card is
    // followed straight away by the next one. Cards placed as cells directly
    // would be row-aligned instead: a grid row is as tall as its taller cell,
    // so a short card left a hole down to the next row.
    //
    // Side by side at two columns, stacked at one — which is why a page's
    // columns are contiguous halves of its card list rather than alternating:
    // stacked, column A then column B is the page file's own order, so nothing
    // reorders when the window narrows.
    //
    // The pages mount their sections exactly once and place them through
    // these, so the one-column and two-column arrangements are the same tree
    // — which they have to be, since a page reads `has-matches` back off its
    // section instances and an element inside an `if` branch can't be read
    // from outside it.
    public pure function grid-row(i: int) -> int {
        return root.body-cols == 2 ? Math.floor(i / 2) : i;
    }
    public pure function grid-col(i: int) -> int {
        return root.body-cols == 2 ? Math.mod(i, 2) : 0;
    }

    // Row split for the wrapping chip / swatch strips: `count` items at most
    // `per-row` to a row, as index groups. In Rust because Slint can't build
    // a nested array, and indices rather than the items themselves so a chip
    // still knows which option it is.
    pure callback chunk-indices(int /*count*/, int /*per-row*/) -> [[int]];

    // Pure case-insensitive substring test. Slint 1.16 has no `.contains()`
    // on string, so the check is wired in Rust (`src/ui/settings_page.rs`).
    pure callback matches(string /*haystack*/, string /*needle*/) -> bool;

    // Whether a settings row survives the filter: an empty query shows
    // everything, otherwise the tab's name, the section's own title or the
    // row's text has to match. Every section used to carry a byte-identical
    // copy of this — ten of them — so changing the rule meant editing ten
    // files.
    //
    // Sections pass their title and wrap this in a two-argument local
    // function, which keeps the rule shared and the per-row call sites short.
    // Reading `search-query` at the call site is what makes the result
    // reactive: Slint tracks the property read, `matches` is opaque to it.
    //
    // `tab` is a term of its own rather than a prefix the sections splice onto
    // their title, so the join lives here instead of in eleven files — and no
    // section ends up matching a substring that spans the seam. It arrives as
    // `tab-name` from the page file that mounts the card: search escapes the
    // tabs, so a tab name is exactly the query a user types, and without it
    // "Interface" and "Services" appear nowhere in any haystack and answer
    // "No matching settings" while sitting in plain view on the bar. The page
    // owns it so the card-to-tab mapping is still stated once.
    public pure function row-visible(tab: string, section: string, haystack: string,
                                     query: string) -> bool {
        return query == ""
            || root.matches(tab, query)
            || root.matches(section, query)
            || root.matches(haystack, query);
    }
}
