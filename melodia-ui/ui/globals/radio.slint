import { RadioFacetRow, RadioStationGridRow, RadioStationRow } from "../models.slint";

// The Radio page at nav index 10: three tabs over the radio-browser.info directory, the stations
// the user kept and the ones they played. **One `SectionActiveGate`, not one per tab** — the three
// share a Rust handle, as Favorites' three and Recently Played's two do, and a tab leave here must
// not be a section leave: Browse holds a directory answer this session paid a network round trip
// for.
export global Radio {
    // **`tab-count` is the sole definition of how many there are** — Rust clamps the persisted
    // index against it, so a build with fewer tabs can't restore onto an unmounted branch.
    out property <int> tab-browse: 0;
    out property <int> tab-favorites: 1;
    // Station history is a tab of its own rather than a sort of Favorites: a station played out
    // of Browse is kept but not starred, so a favorites-only list is the one place it can never
    // be reached from — and the app already gives tracks their own Recently Played page.
    out property <int> tab-recent: 2;
    out property <int> tab-count: 3;

    in-out property <int> tab-idx: 0;
    // Fires after the bar has already moved `tab-idx`.
    callback tab-changed(int);

    // The band's `SearchBar` is the page's only box, and the tabs want different things from it: a
    // directory query on Browse, a local filter on each of the other two — and each keeps its own
    // needle. `ui::radio::filter::dispatch` routes a settled keystroke by the live tab.
    in-out property <string> filter;
    // Bumped to make the filter input give up the keyboard; a global can't bind a callback inline,
    // so the `SearchBar` watches this counter.
    in-out property <int> blur-search-tick: 0;
    // Fired by the view's `FilterThrottle`, whose pacing follows `tab-idx`: on Browse it is the
    // tree's one `trailing` mount and waits for the burst to settle, since the value is a
    // directory request; on the two local tabs it is the ordinary cadence.
    callback filter-changed(string);

    // Pre-filter station counts, one per tab, feeding the band's count line. `-1` until fetched
    // (`ui::tab_bar::UNFETCHED_COUNT`), which is what the `>= 0` guard at the mount rejects — a
    // bare `-1` interpolates into the plural as "-1 stations".
    in-out property <int> browse-count: -1;
    in-out property <int> favorites-count: -1;
    in-out property <int> recent-count: -1;

    callback section-active-changed(bool);

    // One column count for three grids: the page derives it once from the body width, and Rust
    // re-chunks whichever tab is mounted. A per-tab property would be the copy this prevents,
    // the geometry already being one `GridGeometry` for all three.
    in-out property <int> grid-columns: 1;
    callback columns-changed(int);

    // --- Browse -------------------------------------------------------------------------------
    //
    // Rust owns the model and re-chunks it into rows of `grid-columns` cards, so the `ListView`
    // virtualizes by row. Unlike the library grids there is no unfiltered list to filter against:
    // the filter *is* the query, and every change of it is a fresh page off the network.
    in-out property <[RadioStationGridRow]> browse-rows;

    // A request is in flight. The body splits on it against `browse-rows.length`: with nothing
    // loaded it is the first-paint state, with rows on screen it is the load-more pill's spinner.
    in-out property <bool> browse-loading: false;
    // Whether the directory said there was another page. Read off the raw response length rather
    // than the rows kept, so a page thinned by the HLS filter still pages on.
    in-out property <bool> browse-has-more: false;
    // Whether the last request failed. A flag rather than a message, so the copy stays an
    // `@tr` literal at the mount: `@tr` folds msgids at codegen, so a sentence Rust pushed would
    // render untranslated, and there is nothing in a transport failure the reader can act on
    // that a stream URL in the panel would add.
    in-out property <bool> browse-failed: false;
    callback load-more();
    callback retry();

    // Bumped once the logo tier is warm and again per landed decode batch. The card's binding
    // *reads* it, which is what makes a bump re-run a `pure` callback Slint would otherwise keep
    // cached; at `0` the Rust side answers cache-only, so a mount on a released tier queues
    // nothing.
    in-out property <int> covers-generation: 0;
    pure callback request-logo(string /*artwork_path*/, int /*generation*/) -> image;

    // Physical pixels the logo tier decodes to, retuned with it off `display-changed`. A card
    // needs it to know whether the logo it was handed is big enough to fill the tile: the tier
    // never pads a small source up, so the source's own width against this is the fraction of
    // the tile it can cover at 1:1, on any display scale.
    in-out property <int> logo-decode-size: 0;

    // Both take the whole row: a directory station has no database id (`id == 0`) and a kept one
    // has no place in the browse cache, so the row is the only thing that identifies either. One
    // door for all three tabs, and `id == 0` is where it splits.
    callback play-station(RadioStationRow);
    callback toggle-favorite(RadioStationRow);
    callback open-homepage(string);

    // --- The kept tabs ------------------------------------------------------------------------
    //
    // Favorites is favorites plus the stations typed in by hand — a custom station is starred on
    // the way in, so one query answers both and `uuid == ""` is what tells them apart on a card.
    // Recently Played is the wider set: anything with a play, starred or not.
    in-out property <[RadioStationGridRow]> favorites-rows;
    in-out property <[RadioStationGridRow]> recent-rows;

    // Favorites only. Recently Played has none on purpose: the order *is* the page, as on the
    // Recently Played view for tracks.
    in-out property <string> sort-field: "name";
    in-out property <string> sort-dir: "asc";
    callback request-sort(string /*field*/);

    // Editing is refused for a browsed station whatever the card offers — `save_station`'s
    // conflict clause would revert it on the next play — so the card only shows it for a custom
    // one and the facade checks again.
    callback edit-station(RadioStationRow);
    // One per tab, because removal means something different on each: the star goes here, the play
    // history there, and the row itself only when neither tab would list it any more. Which one
    // fires is the dialog *kind* rather than the live `tab-idx`, so the answer is the one captured
    // at the click. By id, the confirm carrying `target-id` and the row being long gone by the
    // time it is accepted.
    callback remove-from-favorites(int /*id*/);
    callback remove-from-recent(int /*id*/);
    callback import-stations();
    callback export-stations();

    // --- The station detail -------------------------------------------------------------------
    //
    // A fourth body branch rather than a route: the band morphs into the station's hero and the
    // tab bar keeps naming the tab underneath, which is My Library's shape exactly. So the back
    // arrow means "close this detail" and there is no origin to restore — a drill never leaves
    // nav 10.
    //
    // **The seat: which tab the painted page belongs to, `-1` for none.** Every other detail in
    // the tree spells "closed" as `id < 0`, which this one cannot — `id == 0` is a browsed station
    // with no database row, and that is a perfectly good thing to have open. The tab is what it
    // carries instead, the Remove action meaning a different thing on each.
    //
    // **All three tabs may be holding a page, and only one of them is here.** The facts below are
    // one set between six heroes, so what is per-tab is a seat on the Rust side
    // (`ui::radio::detail::DetailState`) and `ui::radio::detail::reseat` repoints these at
    // whichever tab is mounted. So this is always either the mounted tab or `-1`, and a reseat
    // that failed to run unmounts the page rather than painting the wrong station under the right
    // title.
    //
    // Written last, in the same tick as the facts below, and **after** the navigation has landed.
    in-out property <int> detail-tab: -1;
    // **Is the page the mounted body right now** — My Library's `album-open` shape, tab test and
    // seat test. Derived here rather than in the view because both inputs are this global's own;
    // My Library's equivalent has to be private to its sheet, needing four *other* globals.
    out property <bool> detail-open: root.detail-tab >= 0 && root.detail-tab == root.tab-idx;
    // Raised synchronously at boot when `views.json` names a station to reopen, and lowered behind
    // the fetch. The tab bodies gate on it, or a restore paints a grid and swaps a beat later.
    in-out property <bool> restoring: false;
    in-out property <RadioStationRow> detail-station;
    // The one place a stream URL crosses into the UI, and it is here rather than on
    // `RadioStationRow` for the reason that struct's own note gives: this is a single station's,
    // read by the copy action alone, where the row is built fifty at a time.
    in-out property <string> detail-stream-url;
    // The directory's own last reachability check. Two properties because "it failed" and "nobody
    // has said" are different answers and only the first is worth printing.
    in-out property <bool> detail-check-known: false;
    in-out property <bool> detail-check-ok: false;
    // A vote needs a station the directory knows and a switch that lets us talk to it.
    in-out property <bool> detail-votable: false;
    // How many votes the directory holds, `-1` until it has answered — which for a station it no
    // longer lists is forever. `0` is a real number of votes and would print as one.
    in-out property <int> detail-votes: -1;

    // The hero's own image slots. The blur pair is a crossfade, so neither is ever cleared while
    // the other is showing — `write_crossfade_slot` flips `blur-use-a` and both opacities animate.
    in-out property <image> cover;
    // The decoded logo's own smallest side. A station logo is routinely a favicon, so the hero
    // draws one under its tile size inset at native size over the monogram gradient rather than
    // stretching it across a 232 px square.
    in-out property <int> detail-logo-size: 0;
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool> blur-use-a;
    in-out property <bool> has-blur;

    // The titles this station has announced since it started playing, newest first. The page
    // mounts the section only when there are some, so there is no empty state to distinguish and
    // no count to carry beside the model.
    in-out property <[string]> history-rows;

    callback open-station(RadioStationRow);
    callback close-detail();
    // Fired by the band once the collapse animation is done, not when `detail-open` goes false —
    // the hero paints all the way through that morph and dropping its images at the flag would
    // collapse a blank square.
    callback hero-collapsed();
    // The box is hidden while a station page is open — a station has no songs to filter — so what
    // this announces is the page *closing*, and the tab's own needle going back into a box that
    // has been away. `ui::radio::filter::sync_box` reseats it from whichever tab is mounted.
    callback detail-scope-changed();
    callback vote();
    callback copy-stream-url();

    // --- Filter chips -------------------------------------------------------------------------
    //
    // The four directory facets are fetched lazily, on first open of their chip, and cached for
    // the session by `services::radio_browser`. Minimum bitrate is not a facet at all: its options
    // are a fixed list the chip carries itself, and it never asks for one.
    out property <int> facet-country: 0;
    out property <int> facet-language: 1;
    out property <int> facet-tag: 2;
    out property <int> facet-codec: 3;
    out property <int> facet-bitrate: 4;

    // The picked value per chip, which is also what each chip displays. The country's code is
    // carried beside its name because that is the one the search endpoint takes.
    in-out property <string> pick-country;
    in-out property <string> pick-country-code;
    in-out property <string> pick-language;
    in-out property <string> pick-tag;
    in-out property <string> pick-codec;
    in-out property <int> pick-bitrate-min: 0;

    // One model, swapped per open, because only one picker can be up at a time. `facet-shown` is
    // the kind it currently holds, so a list landing for a chip the user already moved off is
    // dropped rather than painted under the wrong label.
    in-out property <[RadioFacetRow]> facet-options;
    in-out property <int> facet-shown: -1;
    in-out property <bool> facet-loading: false;
    // The picker's own search box. Slint rejects an inline `for … : if …`, so narrowing a list of
    // several hundred countries has to happen in Rust: this is the needle, and `facet-options` is
    // rewritten from the fetched list on every settled keystroke.
    in-out property <string> facet-filter;
    callback facet-filter-changed(string);
    callback request-facet(int /*kind*/);
    callback facet-picked(int /*kind*/, string /*name*/, string /*code*/);
    callback clear-facet(int /*kind*/);
}
