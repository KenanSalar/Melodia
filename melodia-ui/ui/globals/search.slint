import { TrackListRow, EntityStripRow } from "../models.slint";

// Search: drives the Search view (sidebar index 0). Mixed-results page —
// Top Result featured card + Songs list (compact by default, "Show all"
// toggle) + Albums strip + Artists strip + Recent searches chip list
// when input is empty. Backed by FTS5 for tracks and `LIKE` for
// album/artist/genre names via `library::search::search_all`. The
// compact row count is Rust's `state::COMPACT_TRACK_LIMIT` — don't
// restate it here, it has gone stale once already.
//
// Both strips match through their own tracks as well as by name, so a
// query that only reaches track metadata still fills them — and with it
// the Top Result, which ranks over those two lists plus genres. Genres
// have no strip of their own; they surface as the Top Result only.
//
// Query is the driver — Rust never auto-refreshes on `library_changed_tx`
// (a scan completing mid-query MUST NOT swap results out from under the
// user). Tab-leave releases the strip cover LRUs but keeps `query` +
// `recent-rows` so a brief flip to Now Playing returns to the same query.
export global Search {
    // --- Live query + debounce -------------------------------------
    // `query` is the live text bound to the SearchBar. Each keystroke
    // bumps `debounce-tick-pending`; a 300 ms Timer in the view fires
    // `commit-search` (which kicks the actual FTS fetch) once
    // `pending != applied`. Mirrors the throttle shape used by Tracks /
    // Favorites filters.
    in-out property <string> query;
    in-out property <int>    blur-search-tick: 0;
    in-out property <int>    debounce-tick-pending: 0;
    in-out property <int>    debounce-tick-applied: 0;
    in-out property <bool>   loading: false;

    // --- Results models --------------------------------------------
    // `tracks` is the *visible* slice (`COMPACT_TRACK_LIMIT` rows by
    // default, the whole backend result when `show-all-tracks` is on —
    // that cap is `search_all`'s own `LIMIT`, and belongs there rather
    // than in a third copy here). Rust holds the full result set in its
    // own `last_results` cache so the toggle swaps without a DB hit.
    // `tracks-total` is the pre-truncate count, for the "Show all N"
    // button copy.
    in-out property <[TrackListRow]>   tracks;
    in-out property <int>              tracks-total;
    in-out property <bool>             show-all-tracks: false;
    in-out property <[EntityStripRow]> album-rows;
    in-out property <[EntityStripRow]> artist-rows;

    // --- Top Result -------------------------------------------------
    // Discriminator + scalar payload, rather than a unified row struct,
    // because: (a) the badge text needs to be localized inline in
    // `.slint` (Rust-pushed strings can't `@tr()`); (b) baking a `kind`
    // field into `EntityStripRow` would warp every other consumer
    // (Favorites' Most Played + Favorite Artists grid tabs, Recently
    // Played's Most Played strip). `top-kind == ""` ⇒ no Top Result
    // section.
    in-out property <string> top-kind;            // "album" | "artist" | "genre" | ""
    in-out property <int>    top-id;
    in-out property <string> top-title;
    in-out property <string> top-subtitle;
    in-out property <string> top-artwork-path;
    // Gradient stops for a `top-kind == "genre"` card, and read only
    // then — a genre has no artwork, so its tile paints the same
    // name-hashed gradient `GenreGrid` gives that genre's card and the
    // two surfaces read as one genre. Two `color`s rather than a brush
    // because Slint owns the `@linear-gradient`, matching how `GenreRow`
    // carries its own pair. Both come from `ui::genres::genre_accent`.
    in-out property <color> top-tile-color-1;
    in-out property <color> top-tile-color-2;

    // --- Recent searches (cap 10, JSON-persisted via SearchHistoryState)
    // Shown only when `query == ""`. Click a chip → fill query + commit.
    // Click chip-X → optimistic remove + persist via `recent-remove`.
    in-out property <[string]> recent-rows;

    // --- TrackList column state (Favorites parity, view-id "search") --
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: true;
    in-out property <bool> show-artwork: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;   // Tauri parity: genre + year hidden
    in-out property <bool> show-year: false;

    in-out property <string> sort-field: "rank"; // default: FTS5 rank order
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // --- Lazy cover lookups (strip tiers + per-kind routing for top;
    // result rows go through the shared `RowCovers` global) ---
    pure callback request-album-strip-cover(string)  -> image;
    pure callback request-artist-strip-cover(string) -> image;
    pure callback request-top-result-cover(string)   -> image;

    // --- Query / debounce ------------------------------------------
    callback query-changed(string);     // every keystroke; Rust mirrors + clears on empty
    callback commit-search(string);     // 300 ms Timer fires this
    callback toggle-show-all-tracks();

    // --- Recent searches -------------------------------------------
    callback recent-pick(string);
    callback recent-remove(string);
    callback recent-clear();

    // --- Cross-tab nav (Search → AlbumDetail / ArtistDetail) -------
    // Each stamps `*Detail.origin-nav-index = NAV_SEARCH (0)` *before*
    // flipping `Nav.selected-index` so the detail-view back arrow
    // returns here. Wired in `src/ui/callbacks/search/`.
    callback open-album(int /*album_id*/);
    callback open-artist(int /*artist_id*/);
    callback open-top-result();         // resolves top-kind/top-id

    // --- TrackList row actions (Favorites parity) ------------------
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Cross-tab navigation from a row's right-click "Go to Genre" entry.
    // (The view re-uses `open-album` / `open-artist` above for the row's
    // Go-to-Album / Go-to-Artist entries — same cross-tab semantics.)
    callback go-to-genre(int /*genre_id*/);

    // Section-visible signal — fires when the Search tab enters or
    // leaves (sidebar nav, or Now Playing opened over it). Driven by
    // `watched-search-active` in `app-window.slint`; mirrored into
    // `SearchUi.section_active` + triggers strip-cache release.
    callback section-active-changed(bool);

    // Top Result subtitle, resolved per kind. Rust decides *which* line
    // the card gets (`TopSubtitle`) and calls the matching one of these
    // from the UI thread — a string Rust formatted itself would render
    // untranslated, since `@tr` only reaches literals here. Both reuse a
    // msgid the detail headers already carry, so no locale gains a
    // string. Same pattern as `Favorites.artist-favorite-subtitle`.
    pure callback album-count-label(int /*count*/) -> string;
    album-count-label(count) => {
        return @tr("{n} album" | "{n} albums" % count);
    }
    pure callback track-count-label(int /*count*/) -> string;
    track-count-label(count) => {
        return @tr("{n} track" | "{n} tracks" % count);
    }
}
