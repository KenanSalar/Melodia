// The hero band's colour set — the same `ui/backdrop.rs` answer the `np-*` tier runs, applied to
// the detail / Favorites / Recently-Played heroes. **One global for six views**, only one hero
// being mountable at a time; whoever opens last owns the set. The `np-*` block's read-the-tier
// argument applies verbatim, defaults included.
export global HeroBackdrop {
    // Alpha baked in — see `np-scrim`.
    in-out property <brush> scrim: #0a0a0e73;

    // The no-artwork fill, Genre Detail's whole backdrop, and the aurora's base gradient —
    // `Theme.base` → `mantle` on that arm. **`floor-start` has a third reader**: the mosaic heroes
    // fill their square with it even when populated, the placeholder slots over it being
    // translucent, so the square and the surface around it move together whichever arm is live.
    in-out property <color> floor-start: #2b2135;
    in-out property <color> floor-end: #14101a;

    // `Player.np-tint-*`'s twin, off the same solve — same `SEED_COUNT` reason, and the defaults
    // have to agree with that block and with `AuroraBackdrop`'s own.
    in-out property <color> tint-1: #3a2d4a;
    in-out property <color> tint-2: #2d3a4a;
    in-out property <color> tint-3: #4a2d3a;
    in-out property <color> tint-4: #2d4a3a;

    // `has-blur`'s twin: how a host says "not this one". False wherever there was no artwork to
    // wash — Genre Detail, whose name-hashed stops sit near L*50 and are legible only under the
    // scrim the blur arm solves, and any entry showing the placeholder, whose only alternative
    // would be washing the app's own accent. All three mount sites fold it in.
    in-out property <bool> has-tints: true;

    // Written once at boot, answering to the renderer rather than to the artwork;
    // `ui::aurora::dither_tile` argues it.
    in-out property <image> dither;

    // The hue-carrying tier. Solved to 3:1 against the composited backdrop on the blur, and
    // `Theme.accent` on the aurora, where the washes are bounded to clear it instead.
    in-out property <brush> chrome: #cba6f7;

    // Derived here so surfaces meant to match can't drift, at `np-accent-pill`'s alpha. **The
    // function is what lets a morphing band fade the tier without respelling it**: `with-alpha`
    // *sets* alpha, so a caller wanting a fraction would need a second copy of the 0.16.
    // `LibraryTabBand` is the one caller, fading by brush because its chip strip stays mounted.
    public pure function chip-fill-at(alpha: float) -> brush {
        return root.chrome.with-alpha(0.16 * alpha);
    }
    out property <brush> chip-fill: root.chip-fill-at(1.0);

    // The band's back disc on hover, at `np-accent-disc-hover`'s weight. Named despite the one
    // reader because `IconButton` defaults `hover-bg` to an opaque `Theme.surface0`, so a mount
    // that forgets it flashes grey over the blur.
    out property <brush> disc-hover: root.chrome.with-alpha(0.3);

    // Title, secondary and meta lines, answered exactly as `np-*` is — per artwork on the blur,
    // the theme's own ink on the aurora. The hairline below is `on-backdrop`'s one non-text
    // reader, hence the edge deriving from it.
    in-out property <brush> on-backdrop: #f0eef5;
    in-out property <brush> on-backdrop-muted: #c9c5d3;

    // The mosaic heroes' square, the only bordered hero surface. A `Theme.border` hairline is
    // solved for neither backdrop — it vanishes over the blur's dark floor and turns a hard ring
    // over a light aurora — so the edge is a hero token for the same reason the fill is.
    out property <brush> tile-edge: root.on-backdrop.with-alpha(0.12);
}
