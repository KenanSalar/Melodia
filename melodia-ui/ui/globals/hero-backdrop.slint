// The hero band's solved colour set — the same `ui/backdrop.rs` solve the `np-*` tier runs, applied
// to the detail / Favorites / Recently-Played heroes. **One global for six views**, only one hero
// being mountable at a time; whoever opens last owns the set. The `np-*` block's hue-not-polarity
// argument applies verbatim, defaults included.
export global HeroBackdrop {
    // Alpha baked in — see `np-scrim`.
    in-out property <brush> scrim: #0a0a0e73;

    // The no-artwork fill, and Genre Detail's whole backdrop. **`floor-start` has a third reader**:
    // the mosaic heroes fill their square with it even when populated, the placeholder slots over
    // it being translucent and needing a known-dark base.
    in-out property <color> floor-start: #2b2135;
    in-out property <color> floor-end: #14101a;

    // `Player.np-tint-*`'s twin, off the same solve — the count is `SEED_COUNT` for that block's
    // reason, and the defaults have to agree with it and with `AuroraBackdrop`'s own.
    in-out property <color> tint-1: #3a2d4a;
    in-out property <color> tint-2: #2d3a4a;
    in-out property <color> tint-3: #4a2d3a;
    in-out property <color> tint-4: #2d4a3a;

    // False only for Genre Detail, which shares this band with three artwork heroes and has no
    // artwork to wash — its name-hashed stops sit near L*50 and are legible only under the scrim
    // the blur arm solves. `has-blur`'s twin: how a host says "not this one".
    in-out property <bool> has-tints: true;

    // The aurora's grain, written once at boot. Here rather than beside the tints because it
    // answers to the renderer rather than to the artwork; `ui::aurora::dither_tile` argues it.
    in-out property <image> dither;

    // The hue-carrying tier, solved to 3:1 against the composited backdrop.
    in-out property <brush> chrome: #cba6f7;

    // Derived here so surfaces meant to match can't drift, at `np-accent-pill`'s alpha. **The
    // function is what lets a morphing band fade the tier without respelling it**: `with-alpha`
    // *sets* alpha, so a caller wanting a fraction would need a second copy of the 0.16.
    // `LibraryTabBand` is the one caller, fading by brush because its chip strip stays mounted.
    public pure function chip-fill-at(alpha: float) -> brush {
        return root.chrome.with-alpha(0.16 * alpha);
    }
    out property <brush> chip-fill: root.chip-fill-at(1.0);

    // The band's back disc on hover, at `np-accent-disc-hover`'s weight. Named despite the one
    // reader because `IconButton` defaults `hover-bg` to an opaque `Theme.surface0`, so a mount
    // that forgets it flashes grey over the blur.
    out property <brush> disc-hover: root.chrome.with-alpha(0.3);

    // Title, secondary and meta lines, solved per artwork exactly as `np-*` is — fixed constants
    // read as another app beside a Now Playing view that tints. The hairline below is
    // `on-backdrop`'s one non-text reader, hence the edge deriving from it.
    in-out property <brush> on-backdrop: #f0eef5;
    in-out property <brush> on-backdrop-muted: #c9c5d3;

    // The mosaic heroes' square, the only bordered hero surface. Against a fill pinned dark a
    // `Theme.border` hairline vanishes under Mocha and turns a hard bright ring under every light
    // theme, so the edge is a hero token for the same reason the fill is.
    out property <brush> tile-edge: root.on-backdrop.with-alpha(0.12);
}
