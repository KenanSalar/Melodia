// The hero band's colour set — the same `ui/backdrop.rs` answer the `np-*` tier runs, applied to the
// detail / Favorites / Recently-Played heroes. **One global for six views**, only one hero being
// mountable at a time; whoever opens last owns the set. The `np-*` block's argument applies verbatim.
export global HeroBackdrop {
    // Alpha baked in — see `np-scrim`.
    in-out property <brush> scrim: #0a0a0e73;

    // The no-artwork fill, Genre Detail's blur-arm backdrop, and the aurora's base — flat
    // `Theme.base` in both stops on that arm. **`floor-start` has a third reader**: the mosaic heroes
    // fill their square with it even when populated, so square and surface move together on either
    // arm.
    in-out property <color> floor-start: #2b2135;
    in-out property <color> floor-end: #14101a;

    // `Player.np-tint-*`'s twin, off the same solve — the defaults have to agree with that block and
    // with `AuroraBackdrop`'s own. Always populated: a cover supplies them, a genre its saturated
    // hashed pair, anything coverless the accent seated to a wash tone plus a deeper sibling.
    in-out property <color> tint-1: #3a2d4a;
    in-out property <color> tint-2: #2d3a4a;
    in-out property <color> tint-3: #4a2d3a;

    // Written once at boot, answering to the renderer rather than to the artwork;
    // `ui::aurora::dither_tile` argues it.
    in-out property <image> dither;

    // The hue-carrying tier. Solved to 3:1 against the composited backdrop on the blur, and a
    // neutral ink at partial alpha on the aurora, where the wash beneath supplies the colour.
    in-out property <brush> chrome: #cba6f7;

    // A coverless hero square — its fill at a fraction, its glyph whole. `chrome`'s own value on the
    // blur, its own answer only on the aurora, where that tier is a neutral ink: right for a chip the
    // wash reads through, a pale slab across 140px. `Theme.accent` there instead, reached through
    // Rust like every tier so the hero owns no `Theme.*` binding.
    in-out property <brush> placeholder: #cba6f7;

    // The same tier at the weight lettering wants, and the pill behind it at its own — solved in Rust
    // rather than derived here, the two arms wanting different answers (`ui::backdrop`'s
    // `AURORA_CHROME_TEXT_ALPHA` / `AURORA_CHIP_FILL_ALPHA`).
    in-out property <brush> chrome-text: #cba6f7;
    in-out property <brush> chip-fill: #cba6f733;

    // Lets a morphing band fade the fill without its own copy of the weight; `LibraryTabBand` is the
    // one caller, fading by brush because its chip strip stays mounted. **`transparentize`, not
    // `with-alpha`** — a fraction of the tier has to stay a fraction of whatever Rust solved.
    public pure function chip-fill-at(alpha: float) -> brush {
        return root.chip-fill.transparentize(1.0 - alpha);
    }

    // The band's back disc, idle and hovered. An affordance rather than a surface, so it keeps the
    // weight the chips left behind. Named despite the one reader each because `IconButton` defaults
    // `hover-bg` to an opaque `Theme.surface0`, which flashes grey over the blur.
    out property <brush> disc-fill: root.chrome.transparentize(0.84);
    out property <brush> disc-hover: root.chrome.transparentize(0.7);

    // Title, secondary and meta lines, answered exactly as `np-*` is. The hairline below is
    // `on-backdrop`'s one non-text reader, hence the edge deriving from it.
    in-out property <brush> on-backdrop: #f0eef5;
    in-out property <brush> on-backdrop-muted: #c9c5d3;

    // The mosaic heroes' square, the only bordered hero surface. A `Theme.border` hairline is
    // solved for neither backdrop — it vanishes over the blur's dark floor and turns a hard ring
    // over a light aurora — so the edge is a hero token for the same reason the fill is.
    out property <brush> tile-edge: root.on-backdrop.transparentize(0.88);
}
