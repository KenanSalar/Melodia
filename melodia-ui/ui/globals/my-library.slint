// The My Library page: five tabs — Songs, Albums, Artists, Genres, Playlists — over the
// five views that used to be five sidebar entries at nav indices 3–7. The page keeps nav
// index 3; 4–7 are retired.
//
// **Nothing about the five views' data layer lives here.** `Tracks` / `Albums` /
// `Artists` / `Genres` / `Playlists` and the four `*Detail` globals keep their own models,
// counts, sorts and cover callbacks; this global holds only what the *page* owns — which
// tab is mounted, the one filter that will replace the five search boxes, and the two
// signals the shell drives.
//
// **A tab switch is a section switch.** `SectionActiveGate` is mounted once per tab at
// `index: 3` with this global's `tab-idx` as its `current-tab`, so leaving a tab fires the
// departing view's existing `section-active-changed(false)` and entering one fires the
// arriving view's `true`. Every lifecycle hook — cover release, model clear, `mark_dirty()`
// → re-fetch — therefore works untouched, and the page needs no `covers-generation`
// machinery: the entering tab's own fetch prewarms its first screenful before it writes rows.
//
// **There is no `detail-open` here.** A global's property is bound in the global's own
// file, so deriving it from the four `*Detail.*-id`s would make this the second globals
// file to import siblings (`globals/dialog.slint` is the only one, and that edge set is
// deliberately shallow). `views/my-library-view.slint` already imports all four and derives
// it privately; Rust reads the four ids directly.
export global MyLibrary {
    // **`tab-count` is the sole definition of how many there are** — Rust clamps the
    // persisted index against it rather than carrying its own const, so a build with
    // fewer tabs can't restore onto a branch that mounts nothing.
    out property <int> tab-songs: 0;
    out property <int> tab-albums: 1;
    out property <int> tab-artists: 2;
    out property <int> tab-genres: 3;
    out property <int> tab-playlists: 4;
    out property <int> tab-count: 5;

    in-out property <int> tab-idx: 0;
    // **Fires after the bar has already moved `tab-idx`.** Rust clears the filter and
    // persists the pick; the cover tiers ride the per-tab section gates instead.
    callback tab-changed(int);
    // `Nav.persist-selected-index`'s twin, for the paths that move the tab *without*
    // it being a user's pick — a cross-tab drill and a Mouse-4/5 history walk both
    // land on a tab and neither should clear the filter the way a pick does.
    callback persist-tab-idx(int);

    // The page's single filter — the band's `SearchBar` is the only box on the page, and
    // `ui::my_library::filter` routes a settled keystroke to whichever of the nine
    // surfaces is mounted.
    in-out property <string> filter;
    // Bumped by anything that should make the filter input give up the keyboard — a
    // backdrop click, a pill, a track row's `request-blur-search`. A global can't bind a
    // callback inline, so the `SearchBar` watches this counter. `Tracks` used to hold the
    // copy every other filterable view cited; nine of them became this one.
    in-out property <int> blur-search-tick: 0;
    callback filter-changed(string);
    // The box now describes a different surface, with nobody having typed. Rust reads that
    // surface's own filter back into `filter` — see `ui::my_library::filter::sync_box` for
    // why this is a reseat rather than the clear a tab pick performs. Fired from **five**
    // mirrors in the sheet, `changed` rejecting a path expression on a global: the four
    // detail ids, plus `tab-idx` for the moves that reach a tab without being a pick.
    callback detail-scope-changed();

    // The band's back arrow. Routes to whichever detail the mounted tab has open.
    callback back();

    // **The nav index left the page.** The five per-tab `SectionActiveGate` mounts cannot
    // answer this: on a page leave only the *mounted* tab's fires, and a hero left open on
    // another tab is reachable from nowhere else. That matters now that a tab leave holds
    // the hero rather than handing it back — `ui::my_library::the_band_is_up` is the gate,
    // and `release_page_hero` is what lands here.
    //
    // **A sixth gate cannot stand in either**, which is why this rides `app-window.slint`'s
    // `changed watched-nav-idx` instead: a gate's predicate is already false while Now
    // Playing covers the band, and the sidebar clears `now-playing-open` and writes the new
    // index in one handler — so the leave that matters most goes false → false and delivers
    // no edge at all. Watching the index directly is also what makes "covered" and "left"
    // different events for free: Now Playing and the miniplayer never move it, and the band
    // comes back under them with the same detail open.
    //
    // The mirror fires on every nav change, where a gate fired only on its own predicate, so
    // the Rust hook latches the edge rather than acting on each `false` — otherwise the
    // page's teardown runs on a step between two pages that were never this one, and hands
    // back the artwork boot wrote into the detail globals while the page was hidden.
    callback page-active-changed(bool);

    // The band has finished collapsing out of a detail, so the hero it was painting is
    // finally nobody's. Deferred to here rather than run in each `close-detail` because
    // every hero fact is a ternary over the detail id, so a teardown on the id clear leaves
    // the whole 400 ms morph collapsing a placeholder. `LibraryTabBand` cancels it on a
    // re-open, so it can only ever land with no detail on screen.
    //
    // **What it hands back is decided per id**, not wholesale: the band also collapses when
    // a tab switch takes a still-open detail off screen, and picking that tab again morphs
    // the same banner straight back open. See `release_collapsed_hero`.
    callback hero-collapsed();
}
