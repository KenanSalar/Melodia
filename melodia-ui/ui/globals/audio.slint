// UI state for the three DSP surfaces. All three are Rust-owned and seeded from `settings.json` at
// boot; the chain they drive lives in `src/player/`. Every callback applies to the live player
// *and* persists — on release for the drag pairs, mirroring the `set-volume` / `commit-volume` split.

// `band-gains` is dB per band, low → high, sized by `equalizer::NUM_BANDS`. `preset-idx` indexes
// the dropdown, whose last entry is the synthetic "Custom" shown once a band is hand-edited.
// **Every bound is seeded from the Rust consts**, so there is nothing to drift.
export global Equalizer {
    in-out property <bool> enabled;
    in-out property <[float]> band-gains;
    in-out property <int> preset-idx;
    in property <float> min-gain;
    in property <float> max-gain;

    // Master gain in dB — headroom for boosting without clipping.
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    callback set-band(int /*band index*/, float /*gain dB*/);
    callback commit-band(int /*band index*/, float /*gain dB*/);
    callback select-preset(int /*dropdown index*/);
    callback reset();
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// Loudness normalization. `mode-idx` matches `player::replaygain::RgMode`.
export global ReplayGain {
    in-out property <bool> enabled;
    in-out property <int> mode-idx;
    in-out property <bool> prevent-clipping;
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    callback set-mode(int /*0 = Track, 1 = Album*/);
    callback set-prevent-clipping(bool);
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// The Now-Playing visualizer strip. **`enabled` and `set-active` are deliberately separate**:
// `enabled` is the persisted setting and decides whether the strip mounts, `set-active` is session
// state — mounted *and* on screen — and the only thing arming the backend sample tap. `style` and
// `style-idx` are one choice in two shapes, the strip mounting on the **key** so reordering the
// picker can't repoint an existing install, while the Settings chips need the index.
//
// `bars` is normalized 0..1 heights, low → high, **already smoothed in Rust** — so they must not be
// `animate`d. `wave-path` is SVG commands for the trace, a string because Slint rejects
// `for`-generated path elements (slint-ui/slint#754). `idle` reports the drawing has decayed to
// rest, letting the Timer stop once a paused player settles — pausing halts the tap but leaves
// stale samples in the ring, so re-analysing them would freeze the drawing mid-shape.
//
// **`window-shown` and `dormant` carry different certainty on purpose.** `window-shown` is the OS
// saying the window is off screen and every such event has a matching one putting it back, so it is
// safe to stop the Timer on; `dormant` is inferred with no wake-up event, so it only slows it.
export global Visualizer {
    in-out property <bool> enabled: true;
    in-out property <string> style: "bars";
    in-out property <int> style-idx;
    in property <[float]> bars;
    in property <string> wave-path;
    in property <bool> idle: true;
    in property <bool> window-shown: true;
    in property <bool> dormant;

    callback set-enabled(bool);
    callback set-style(int);
    // Fired by `AppWindow`'s mirror, not by the strip: `NowPlayingView` is destroyed while closed
    // and Slint has no unmount callback, so the gate has to live somewhere always mounted.
    callback set-active(bool);
    // Fired by whoever lowers `window-shown`. The tick is the steady-state writer of the tap's arm
    // state but can't be relied on here: `window-shown` also gates the strip's Timer, so a hide
    // landing on a settled drawing stops it in the same pass and no further tick arrives.
    callback window-hidden();
    callback tick(bool /*is-playing*/, float /*strip width, logical px*/);
}
