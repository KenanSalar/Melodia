// Vazirmatn (OFL, github.com/rastikerdar/vazirmatn) — single family that
// covers both Latin and Arabic with consistent metrics, so mixed-script
// rows / labels don't drift vertically the way they did when Slint fell
// back from Inter (Latin-only) to a system Arabic font with taller
// ascenders. Three weights cover the project's usages: Regular (400) for
// body, Medium (500) for the now-playing title, SemiBold (600) for page
// titles.
//
// The bundled TTFs are PATCHED — `scripts/patch_vazirmatn.py` rewrites
// the OS/2 typo + hhea metrics to a Latin-typical line ratio (upstream
// Vazirmatn ships those at ~1.56× so Arabic combining marks fit; at our
// UI sizes that pushed every vertically-centred Latin text several px
// upward). The patched variant lives under `assets/fonts/vazirmatn/`
// and is imported directly below; pristine upstream copies are kept
// under `assets/fonts/originals/` as the patch script's input.
import "assets/fonts/vazirmatn/Vazirmatn-Regular.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-Medium.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-SemiBold.ttf";

import { Theme } from "theme.slint";
import { Settings } from "settings.slint";
import { Player, Equalizer, ReplayGain, Visualizer, ScrobbleUi, SmartEditor, TagEditor, Nav, NavEnterFrom, CompositeScroll, MiniPlayer, Tracks, Browse, LibrarySettings, Dialog, WindowChrome, Queue, Notifications, NowPlaying, Favorites, RecentlyPlayed, Albums, AlbumDetail, Artists, ArtistDetail, Genres, GenreDetail, Playlists, PlaylistDetail, PopupHighlight, Search, MelodiaUpdater, RowCovers } from "globals.slint";
import { TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
         BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
         AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
         GenreRow, GenreGridRow,
         PlaylistRow, PlaylistGridRow, SmartRuleRow } from "models.slint";
import { Sidebar } from "layout/sidebar.slint";
import { NowPlayingBar } from "layout/now-playing-bar.slint";
import { PlaceholderView } from "views/placeholder-view.slint";
import { TracksView } from "views/tracks-view.slint";
import { FavoritesView } from "views/favorites-view.slint";
import { RecentlyPlayedView } from "views/recently-played-view.slint";
import { BrowseView } from "views/browse-view.slint";
import { AlbumView } from "views/album-view.slint";
import { AlbumDetailView } from "views/album-detail-view.slint";
import { ArtistView } from "views/artist-view.slint";
import { ArtistDetailView } from "views/artist-detail-view.slint";
import { GenresView } from "views/genres-view.slint";
import { GenreDetailView } from "views/genre-detail-view.slint";
import { PlaylistsView } from "views/playlists-view.slint";
import { PlaylistDetailView } from "views/playlist-detail-view.slint";
import { SearchView } from "views/search-view.slint";
import { SettingsView } from "views/settings-view.slint";
import { NowPlayingView } from "views/now-playing-view.slint";
import { MiniPlayerView } from "views/mini-player.slint";
import { QueueSheet } from "views/queue-sheet.slint";
import { DialogOverlay } from "components/dialog/dialog.slint";
import { CustomTitleBar } from "components/custom-titlebar.slint";
import { NotificationStack } from "components/dialog/notification-stack.slint";
import { ViewTransition } from "components/view-transition.slint";

// Re-export so Rust can mention these from `slint::include_modules!`.
export {
    Theme, Settings, Player, Equalizer, ReplayGain, Visualizer, ScrobbleUi, SmartEditor, TagEditor, Nav, CompositeScroll, MiniPlayer, Tracks, Browse, LibrarySettings, Dialog, WindowChrome, Queue, Notifications, NowPlaying, Favorites, RecentlyPlayed, Albums, AlbumDetail, Artists, ArtistDetail, Genres, GenreDetail, Playlists, PlaylistDetail, PopupHighlight, Search, MelodiaUpdater, RowCovers,
    TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
    BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
    AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
    GenreRow, GenreGridRow,
    PlaylistRow, PlaylistGridRow, SmartRuleRow,
}

export component AppWindow inherits Window {
    title: "Melodia";
    // No `preferred-width` / `preferred-height` here. The initial OS
    // window size is restored from `settings.json` by
    // `src/ui/window_chrome/geometry.rs::restore`, which calls
    // `slint::Window::set_size` after `AppWindow::new()`. That call
    // sets the winit backend's `has_explicit_size` flag, which is the
    // only thing that stops Slint from snapping the window to the
    // content-preferred size on first show — a hardcoded
    // `preferred-width/height` here would just be that snap target.
    // Min constraints stay as size hints below.
    // Floor matches the miniplayer's smallest sensible footprint
    // (~350×90, mirrors Tauri's `setMinSize` on mini enter). The full UI
    // is only rendered above `mini-active`'s ~550×250 threshold; below
    // that, `MiniPlayerView` takes over. Keeping the OS-level minimum at
    // the mini's floor lets the user drag straight down into mini mode
    // without us having to runtime-mutate winit constraints.
    min-width: 350px;
    min-height: 90px;
    // Window background mode:
    //   - Custom-frame + windowed: transparent ARGB surface so the OS
    //     compositor blends our rounded outer mantle shell with the
    //     desktop — the alpha=0 corners outside the rounded shell are
    //     "not our window," giving real rounded window corners on
    //     Wayland (KWin/Mutter/Sway), X11 (with a compositor), Windows
    //     (layered window via WS_EX_LAYERED), and macOS (NSWindow with
    //     opaque=NO). Slint's winit backend always requests a transparent-
    //     capable surface (`i-slint-backend-winit/winitwindowadapter.rs`),
    //     so this works without any Cargo features beyond what we already
    //     enable.
    //   - Native-frame OR maximized: opaque mantle. Native mode lets the
    //     OS-drawn frame abut a solid backdrop. Maximized falls back for
    //     pure UX reasons — rounded corners on an edge-to-edge window
    //     would clip against the screen edge / adjacent monitor, which
    //     looks broken; every maximize-aware app does this. (Note: the
    //     Slint Wayland transparency caveat people sometimes invoke —
    //     slint-ui/slint#6145 — is fullscreen-specific, not maximized;
    //     KWin / Mutter / Sway all composite alpha on maximized surfaces
    //     in practice. Melodia has no fullscreen mode today, so there's
    //     no separate fullscreen guard. If a fullscreen toggle ever
    //     lands, mirror `is-maximized` with an `is-fullscreen` flag.)
    //     `WindowChrome.is-maximized` is reactively maintained by
    //     `src/ui/window_chrome/`'s `WindowEvent::Resized` filter via
    //     `winit::Window::is_maximized`, so the toggle flips on every
    //     maximize/restore.
    background: (Theme.use-native-titlebar || WindowChrome.is-maximized)
        ? Theme.mantle
        : Colors.transparent;

    // Custom titlebar mode: drop the OS frame so we can paint our own
    // chrome. Slint reads `no-frame` once when the OS window first
    // shows, so `Theme.use-native-titlebar` must be hydrated from
    // `WindowFlags.use_native_titlebar` *before* `app.run()` —
    // `src/ui/window_chrome/`'s `install` does that. With `no-frame`
    // on, winit no longer paints resize edges, so a 4 px
    // `resize-border-width` restores them; in native-frame mode the OS
    // owns resizing, so the inner border drops to 0. The width must
    // match the `ResizeAffordances` overlay sizes below — winit's
    // built-in border check decides where to fire `drag_resize_window`,
    // and our overlays decide where to suppress hover; mismatched
    // sizes leave a band where the cursor changes but the underlying
    // widget still flashes hover, or vice versa.
    no-frame: !Theme.use-native-titlebar;
    resize-border-width: Theme.use-native-titlebar ? 0px : 4px;

    default-font-family: "Vazirmatn";
    default-font-size: Theme.font-size-md;

    function view-title(idx: int) -> string {
        if (idx == 0) { return @tr("Search"); }
        if (idx == 1) { return @tr("Browse"); }
        if (idx == 2) { return @tr("Favorites"); }
        if (idx == 3) { return @tr("Tracks"); }
        if (idx == 4) { return @tr("Albums"); }
        if (idx == 5) { return @tr("Artists"); }
        if (idx == 6) { return @tr("Genres"); }
        if (idx == 7) { return @tr("Playlists"); }
        if (idx == 8) { return @tr("Recently Played"); }
        if (idx == 9) { return @tr("Settings"); }
        // App name (proper noun) — never translated.
        return "Melodia";
    }

    // Clear the Settings page's live search query and blur its TextInput
    // when the user navigates away. The handler lives at the AppWindow
    // level so it always fires — `SettingsView` is mounted only when
    // `Nav.selected-index == 9`, so a `changed` handler placed inside it
    // would never see the leaving transition (the component gets
    // de-instantiated before the handler runs). Slint's `changed` only
    // observes properties on the current element, not path expressions on
    // globals, so we mirror `Nav.selected-index` into a local property
    // and watch that. Returning to Settings therefore always shows the
    // full page; the next keystroke can't land in a hidden field on
    // another page.
    property <int> watched-nav-idx: Nav.selected-index;
    changed watched-nav-idx => {
        // A tab switch changes the mounted content view — clear any stale
        // composite-scroll hover flag (and any accumulated, un-applied wheel
        // delta) left by an unmounted composite view, or the winit wheel filter
        // would keep eating vertical wheel on the new view until the next mouse
        // move (see CompositeScroll in globals.slint).
        CompositeScroll.hovered = false;
        CompositeScroll.wheel-dy = 0px;
        if (self.watched-nav-idx != 9) {
            Settings.search-query = "";
            Settings.blur-search-tick += 1;
        }
        // Re-grab global keyboard focus on every section change. The
        // outgoing view may hold focus in a TextInput about to be
        // de-instantiated (Search's autofocused bar, a manually-focused
        // filter); Slint does not return focus to an ancestor FocusScope
        // when the focused item is destroyed, so shortcuts would go dead
        // until the next click. Runs synchronously on the index change —
        // SearchView's 1 ms autofocus Timer fires afterwards, so entering
        // Search still lands the caret in the search bar.
        keyboard-shortcuts.focus();
    }

    // Mirror `Nav.now-playing-open` so Rust can gate the Up Next list
    // rebuild on the view being visible. Same rationale as
    // `watched-nav-idx` above: `Nav` is a global and `changed` can't watch
    // a path expression on a global, so we mirror it into a local property
    // at the always-mounted `AppWindow` level — `NowPlayingView` itself is
    // unmounted while closed, so a handler inside it would miss the
    // open/close transitions.
    property <bool> watched-now-playing-open: Nav.now-playing-open;
    changed watched-now-playing-open => {
        // NP open/close swaps the mounted content view — reset composite hover
        // and any accumulated wheel delta (see watched-nav-idx / CompositeScroll).
        CompositeScroll.hovered = false;
        CompositeScroll.wheel-dy = 0px;
        Nav.now-playing-open-changed(self.watched-now-playing-open);
        // Opening / closing Now Playing de-instantiates the section view
        // underneath it — same focus-orphaning risk as a sidebar nav (see
        // `watched-nav-idx`). Re-grab focus so global shortcuts survive.
        keyboard-shortcuts.focus();
    }

    // Arm the visualizer's audio-thread sample tap only while something is
    // actually drawing it. Same mirroring rationale as the block above, and it
    // has to be its own property rather than a second handler on
    // `now-playing-open-changed` — that callback has one handler slot, already
    // taken by `wire_now_playing_open`.
    property <bool> watched-viz-active: Nav.now-playing-open && Visualizer.enabled;
    changed watched-viz-active => {
        Visualizer.set-active(self.watched-viz-active);
    }

    // Artist Detail (a composite-scroll view) opens/closes without a nav-index
    // change — grid ↔ detail both live under index 5 — so the watched-nav-idx
    // reset above would miss it. Mirror the detail id and reset composite hover
    // on any change, else a stale hover flag from the unmounting view would
    // trap the wheel on the artist grid (see CompositeScroll).
    property <int> watched-artist-detail-id: ArtistDetail.artist-id;
    changed watched-artist-detail-id => {
        CompositeScroll.hovered = false;
        CompositeScroll.wheel-dy = 0px;
    }

    // The miniplayer swap unmounts the whole full-UI branch
    // (`if !root.mini-render-active`) — and with it any composite view — without
    // a nav-index change, so the resets above would miss it. Reset composite
    // hover here too, else the unmounting view's stale flag would trap the wheel
    // in the miniplayer (see CompositeScroll).
    property <bool> watched-mini-render: root.mini-render-active;
    changed watched-mini-render => {
        CompositeScroll.hovered = false;
        CompositeScroll.wheel-dy = 0px;
    }

    // ---- Miniplayer responsive switch ----------------------------------
    // Tauri parity: enter the compact view when the window is either
    // narrow OR short, pick the `square` variant (which can show an
    // Up Next list) when the aspect ratio is roughly square or taller.
    // Both derivations key off `self.width`/`self.height` (winit `Resized`
    // events drive these directly), so no extra plumbing is needed to
    // react to the OS window changing size.
    out property <bool> mini-active: self.width < 550px || self.height < 250px;
    out property <bool> mini-square: self.height >= self.width * 0.8;

    // Shadow that lags `mini-active` by 100ms during the swap. While the
    // fade-out is running, this hasn't flipped yet so the outgoing layout
    // stays mounted at opacity 0; once `mini-swap-timer` fires it flips
    // and the incoming layout mounts at the same 0 opacity, then
    // `mini-opacity` animates back to 1 for the fade-in. Two-phase swap
    // keeps only one branch in the tree at a time (avoids holding both
    // sidebar grid models + the mini's up-next subscriber alive together
    // during the swap — a memory-discipline regression).
    property <bool> mini-render-active: false;
    property <float> mini-opacity: 1.0;
    animate mini-opacity { duration: 100ms; easing: ease-in-out; }

    // Watched mirror so `changed` fires reliably. Slint globals can't take
    // `changed` on path expressions; mirroring into a local property at
    // the `AppWindow` root is the established pattern (`watched-nav-idx`
    // above). Sets the global so child components see the new value,
    // schedules the fade-out → swap → fade-in, closes any open Now
    // Playing view so its artwork release path runs, and notifies the
    // Rust subscriber via `MiniPlayer.active-changed` for the up-next
    // gate + square-variant artwork cache lifecycle. `MiniPlayer.square`
    // is owned by `watched-mini-square` below (and seeded once at mount
    // by `mini-seed-timer`) — Rust re-reads it from the global on entry
    // so no redundant write is needed here.
    property <bool> watched-mini-active: root.mini-active;
    changed watched-mini-active => {
        MiniPlayer.active = self.watched-mini-active;
        if (self.watched-mini-active && Nav.now-playing-open) {
            Nav.now-playing-open = false;
        }
        root.mini-opacity = 0.0;
        mini-swap-timer.running = true;
        MiniPlayer.active-changed(self.watched-mini-active);
    }

    // Variant changes while inside mini (aspect crossing 0.8 either way)
    // don't trigger a fade — they're an in-place re-layout within the
    // same component, and a flash would be jarring on every aspect
    // wobble during a drag. The `square-changed` callback drives the
    // Rust-side high-res cover cache lifecycle (seed on
    // rectangle→square, release on square→rectangle) — see
    // `src/ui/mini_player.rs`.
    property <bool> watched-mini-square: root.mini-square;
    changed watched-mini-square => {
        MiniPlayer.square = self.watched-mini-square;
        MiniPlayer.square-changed(self.watched-mini-square);
    }

    // 1ms mount seed: `changed` doesn't fire on the first binding settle
    // (`grid-columns-sync.slint` precedent), so without this an app
    // launched directly into a mini-sized window would render the full
    // UI for one frame before switching.
    mini-seed-timer := Timer {
        interval: 1ms;
        triggered => {
            MiniPlayer.active = root.mini-active;
            MiniPlayer.square = root.mini-square;
            root.mini-render-active = root.mini-active;
            MiniPlayer.active-changed(root.mini-active);
            self.running = false;
        }
    }

    // 100ms fade-out completion: flip the render shadow, ease opacity
    // back to 1. Self-stops; re-armed each time `watched-mini-active`
    // flips. Single-shot, so a held key or fast wiggle just keeps
    // restarting the same timer cleanly.
    mini-swap-timer := Timer {
        interval: 100ms;
        running: false;
        triggered => {
            root.mini-render-active = root.mini-active;
            root.mini-opacity = 1.0;
            self.running = false;
        }
    }

    // Mirror "the Albums section is on screen" the same way — Rust releases
    // the album-tier cover cache when this goes false (sidebar nav away, or
    // opening Now Playing *from* Albums) and re-warms it when it goes true.
    // `selected-index == 4` is the Albums section; `AlbumView` /
    // `AlbumDetailView` are both inside it, so grid↔detail stays `true`.
    property <bool> watched-albums-active:
        Nav.selected-index == 4 && !Nav.now-playing-open && !root.mini-active;
    changed watched-albums-active => {
        Albums.section-active-changed(self.watched-albums-active);
    }

    // Same shape for the Favorites section (sidebar index 2). The
    // single FavoritesView covers both the hero+strips and the All
    // Songs list, so there's no detail flip inside this branch. Rust
    // releases the mosaic / Most Played / Artists cover caches AND
    // the borrowed Albums grid cover cache on `false`, then re-fetches
    // hero + strips + tracks via the library-changed dirty flag on
    // `true`.
    property <bool> watched-favorites-active:
        Nav.selected-index == 2 && !Nav.now-playing-open && !root.mini-active;
    changed watched-favorites-active => {
        Favorites.section-active-changed(self.watched-favorites-active);
    }

    // Same shape for the Search section (sidebar index 0). Query-
    // driven so there's no library-changed refresh, but Rust still
    // releases the per-strip album + artist cover LRUs on `false`
    // (and clears the result models on the UI thread before the
    // spawn_blocking release runs). `query` + `recent-rows` are
    // preserved so a brief flip away and back lands on the same
    // view state.
    property <bool> watched-search-active:
        Nav.selected-index == 0 && !Nav.now-playing-open && !root.mini-active;
    changed watched-search-active => {
        Search.section-active-changed(self.watched-search-active);
    }

    // Same shape for the Artists section (sidebar index 5). Both
    // `ArtistView` and `ArtistDetailView` live under this branch, so the
    // grid↔detail flip doesn't toggle the active state.
    property <bool> watched-artists-active:
        Nav.selected-index == 5 && !Nav.now-playing-open && !root.mini-active;
    changed watched-artists-active => {
        Artists.section-active-changed(self.watched-artists-active);
    }

    // Same shape for the Genres section (sidebar index 6). Both
    // `GenresView` and `GenreDetailView` live under this branch, so the
    // grid↔detail flip doesn't toggle the active state. The Rust hook
    // has no cache to release today (genres have no artwork), but it's
    // wired for symmetry with Albums / Artists.
    property <bool> watched-genres-active:
        Nav.selected-index == 6 && !Nav.now-playing-open && !root.mini-active;
    changed watched-genres-active => {
        Genres.section-active-changed(self.watched-genres-active);
    }

    // Same shape for the Playlists section (sidebar index 7). Both
    // `PlaylistsView` and `PlaylistDetailView` live under this branch,
    // so the grid↔detail flip doesn't toggle the active state. Rust
    // releases the playlist-tier cover cache on `false` and re-warms
    // it on `true` — mirrors the Albums hook.
    property <bool> watched-playlists-active:
        Nav.selected-index == 7 && !Nav.now-playing-open && !root.mini-active;
    changed watched-playlists-active => {
        Playlists.section-active-changed(self.watched-playlists-active);
    }

    // Same shape for the Tracks section (sidebar index 3). Unlike Albums,
    // the Tracks view keeps its row model warm across nav-aways (no cache
    // release on leave) — Rust uses this flag only to gate the
    // `library_changed` refresher: hidden ⇒ mark dirty and skip the
    // full-library re-fetch, re-enter ⇒ one deferred refresh.
    property <bool> watched-tracks-active:
        Nav.selected-index == 3 && !Nav.now-playing-open && !root.mini-active;
    changed watched-tracks-active => {
        Tracks.section-active-changed(self.watched-tracks-active);
    }

    // Same shape for the Browse section (sidebar index 1). Same gate-only
    // role as Tracks: the `library_changed` subscriber skips re-fetching
    // the current directory while the view is hidden.
    property <bool> watched-browse-active:
        Nav.selected-index == 1 && !Nav.now-playing-open && !root.mini-active;
    changed watched-browse-active => {
        Browse.section-active-changed(self.watched-browse-active);
    }

    // Same shape for the Recently-Played section (sidebar index 8). Like
    // Favorites, Rust releases the section's cover cache on `false` and
    // re-fetches on `true`.
    property <bool> watched-recently-active:
        Nav.selected-index == 8 && !Nav.now-playing-open && !root.mini-active;
    changed watched-recently-active => {
        RecentlyPlayed.section-active-changed(self.watched-recently-active);
    }

    // Outer mantle shell. In custom-frame + windowed mode the Window's
    // background is transparent, so this rounded mantle Rectangle IS the
    // visible window outline — the compositor treats the alpha=0 area
    // outside its rounded corners as "not our window". `clip: true`
    // ensures any child painting outside the rounded shape is masked.
    //
    // In native-frame mode OR when maximized the radius drops to 0 so
    // the layout stays full-bleed: native mode wants the OS-drawn frame
    // to abut a square backdrop, and a maximized window's rounded
    // corners would clip against the screen edge / adjacent monitor (no
    // shadow gap implied). The inner content panel below still rounds
    // via `Theme.shell-radius` (custom) / `Theme.native-content-radius`
    // (native) for Tauri parity.
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.mantle;
        border-radius: (Theme.use-native-titlebar || WindowChrome.is-maximized)
            ? 0px
            : Theme.shell-radius;
        clip: true;

        // Root global keyboard shortcuts.
        //
        // Wraps the entire main layout (titlebar + sidebar + content +
        // now-playing-bar) so it sits between the QueueSheet's own
        // FocusScope (which handles Esc / Ctrl+A while the sheet is open)
        // and the Window's key dispatch — unhandled keys bubble up from
        // child scopes via `return reject` and land here. Grabs focus at
        // first show via `init`; text inputs (SearchBar, LabeledInput in
        // dialogs, Settings filter) naturally consume their typed keys
        // because Slint routes key events to the focused element first,
        // so alphabetic shortcuts never fire while the user is typing.
        //
        // The handler runs even when `Dialog.open` so Escape can route
        // through to `Dialog.cancelled()` (the dialog itself doesn't have
        // its own Esc binding). All non-Escape shortcuts early-out under
        // `Dialog.open` so confirm-only dialogs (which have no text input
        // to swallow Space etc.) don't leak playback toggles through the
        // backdrop.
        keyboard-shortcuts := FocusScope {
            width: 100%;
            height: 100%;

            init => { self.focus(); }

            // Debounce counter for the persistence side of keyboard
            // volume changes. `bump-volume` always pushes the new value
            // to the audio backend (`set-volume`, in-memory + cheap) and
            // resets this counter to 3; the 100 ms `commit-debounce-timer`
            // below drains it back to 0 and calls `Player.commit-volume()`
            // exactly once on the trailing edge — so a held arrow key
            // writes `settings.json` once at release instead of ~20×/s.
            // The slider drag has the same one-commit-per-gesture
            // contract via its own `dragged-since-press` gate.
            property <int> commit-debounce-ticks: 0;

            commit-debounce-timer := Timer {
                interval: 100ms;
                running: keyboard-shortcuts.commit-debounce-ticks > 0;
                triggered => {
                    keyboard-shortcuts.commit-debounce-ticks =
                        max(0, keyboard-shortcuts.commit-debounce-ticks - 1);
                    // Fire commit on the trailing edge — i.e. when the
                    // user stops bumping for ~300 ms. Each fresh
                    // keystroke reuses the same timer by re-setting the
                    // counter back to 3 inside `bump-volume`.
                    if (keyboard-shortcuts.commit-debounce-ticks == 0) {
                        Player.commit-volume();
                    }
                }
            }

            // Volume step: 0..100 clamp matches the slider's actual emit
            // range (`volume-popup.slint`'s `clamp(…, 0, 1) * 100`).
            // Pushes `set-volume` immediately so audio adjusts on
            // the keystroke, but defers `commit-volume` (settings.json
            // persistence) to the trailing-edge debounce above — held
            // arrow keys would otherwise commit ~20×/s. Bumps
            // `volume-hud-tick` so `VolumePopup` force-shows its existing
            // hover tooltip with the new percentage; mouse-driven slider
            // drags don't bump it because they already raise the
            // VolumePopup chrome.
            function bump-volume(delta: int) {
                Player.set-volume(clamp(Player.vm.volume + delta, 0, 100));
                Player.volume-hud-tick += 1;
                // 3 × 100 ms = ~300 ms after the last keystroke. Each
                // fresh keystroke resets the counter so the commit only
                // fires once the user stops holding / tapping.
                keyboard-shortcuts.commit-debounce-ticks = 3;
            }

            // Relative seek. Guards on `duration-ms > 0` so a press with
            // no track loaded is a no-op rather than seeking the
            // unloaded backend.
            function bump-seek(delta-ms: int) {
                if (Player.duration-ms > 0) {
                    Player.seek(clamp(Player.position-ms + delta-ms,
                                      0,
                                      Player.duration-ms));
                }
            }

            // 0..9 → 0 %, 10 %, …, 90 % of current track (VLC / YouTube
            // convention). `pct` is the integer percent so the math
            // stays in ints; rounding bias is negligible at ms scale.
            function seek-to-percent(pct: int) {
                if (Player.duration-ms > 0) {
                    Player.seek(round(Player.duration-ms * pct / 100));
                }
            }

            key-pressed(ev) => {
                // Escape priority chain: Dialog cancel > Now Playing
                // close > drop. Queue-sheet's own FocusScope catches
                // Escape *before* this handler when the sheet is open
                // (its `enabled: Queue.open` gate plus the natural
                // focus chain ordering), so queue Esc never reaches
                // here.
                if (ev.text == Key.Escape) {
                    if (Dialog.open) {
                        Dialog.cancelled();
                        Dialog.open = false;
                        return accept;
                    }
                    if (Nav.now-playing-open) {
                        Nav.now-playing-open = false;
                        return accept;
                    }
                    return reject;
                }

                // All non-Escape shortcuts are gated on no dialog. Text
                // inputs in form-style dialogs consume their typed keys
                // naturally; confirm-only kinds (clear-queue,
                // remove-folder, …) have no input, so without this
                // guard Space would still pause playback through the
                // dialog backdrop.
                if (Dialog.open) {
                    return reject;
                }

                // Arrows: bare = seek ±5 s / volume ±5; Shift = seek
                // ±30 s; Ctrl = previous/next track or fine volume ±1.
                // Matches Spotify (Ctrl+arrow = track skip) + VLC
                // (bare arrow = scrub) + Apple Music (Ctrl/Cmd = big
                // step). Slint maps `ev.modifiers.control` to Cmd on
                // macOS automatically.
                if (ev.text == Key.LeftArrow) {
                    if (ev.modifiers.control) {
                        Player.previous();
                    } else {
                        bump-seek(ev.modifiers.shift ? -30000 : -5000);
                    }
                    return accept;
                }
                if (ev.text == Key.RightArrow) {
                    if (ev.modifiers.control) {
                        Player.next();
                    } else {
                        bump-seek(ev.modifiers.shift ? 30000 : 5000);
                    }
                    return accept;
                }
                if (ev.text == Key.UpArrow) {
                    bump-volume(ev.modifiers.control ? 1 : 5);
                    return accept;
                }
                if (ev.text == Key.DownArrow) {
                    bump-volume(ev.modifiers.control ? -1 : -5);
                    return accept;
                }

                // Number row: VLC / YouTube percentage seek.
                if (ev.text == "0") { seek-to-percent(0);  return accept; }
                if (ev.text == "1") { seek-to-percent(10); return accept; }
                if (ev.text == "2") { seek-to-percent(20); return accept; }
                if (ev.text == "3") { seek-to-percent(30); return accept; }
                if (ev.text == "4") { seek-to-percent(40); return accept; }
                if (ev.text == "5") { seek-to-percent(50); return accept; }
                if (ev.text == "6") { seek-to-percent(60); return accept; }
                if (ev.text == "7") { seek-to-percent(70); return accept; }
                if (ev.text == "8") { seek-to-percent(80); return accept; }
                if (ev.text == "9") { seek-to-percent(90); return accept; }

                // Space → play/pause (universal).
                if (ev.text == " ") {
                    Player.play-pause();
                    return accept;
                }

                // Ctrl combos — handled before bare letters so Ctrl+N
                // (new playlist) wins over N (next track), etc.
                if (ev.modifiers.control) {
                    if (ev.text == "b") {
                        Nav.sidebar-collapsed = !Nav.sidebar-collapsed;
                        return accept;
                    }
                    if (ev.text == ",") {
                        // 9 = Settings tab; see Nav comment.
                        Nav.selected-index = 9;
                        Nav.persist-selected-index(9);
                        return accept;
                    }
                    if (ev.text == "n") {
                        // Reset the dialog state the same way the
                        // existing New-Playlist menu entry does, then
                        // open. The default `accepted` handler on
                        // `Dialog` routes `kind == "create-playlist"`
                        // to `Playlists.create-playlist(...)`.
                        Dialog.kind = "create-playlist";
                        Dialog.input-text = "";
                        Dialog.input-text-2 = "";
                        Dialog.pending-track-ids = [];
                        Dialog.target-id = -1;
                        Dialog.title = @tr("Create Playlist");
                        Dialog.message = "";
                        Dialog.confirm-label = @tr("Create");
                        Dialog.cancel-label = @tr("Cancel");
                        Dialog.destructive = false;
                        Dialog.open = true;
                        return accept;
                    }
                    return reject;
                }

                // Bare letters — Spotify / Apple Music / VLC parity.
                if (ev.text == "m") { Player.toggle-mute();     return accept; }
                if (ev.text == "l") { Player.toggle-favorite(); return accept; }
                if (ev.text == "n") { Player.next();            return accept; }
                if (ev.text == "p") { Player.previous();        return accept; }
                if (ev.text == "s") { Player.toggle-shuffle();  return accept; }
                if (ev.text == "r") { Player.cycle-repeat();    return accept; }

                if (ev.text == "q") {
                    Queue.open = !Queue.open;
                    return accept;
                }
                if (ev.text == "f") {
                    Nav.now-playing-open = !Nav.now-playing-open;
                    return accept;
                }
                if (ev.text == Key.F11) {
                    WindowChrome.toggle-maximize();
                    return accept;
                }

                return reject;
            }

        // Full UI branch. Wrapped in a Rectangle so we can drive the
        // miniplayer fade transition via `opacity: root.mini-opacity` on
        // a single ancestor. Conditional on `mini-render-active` — the
        // 100ms-delayed shadow of `mini-active`, see the
        // `mini-swap-timer` block above — so only one branch is mounted
        // at any time (avoids holding sidebar grid covers + the mini
        // up-next subscriber alive together during the swap).
        if !root.mini-render-active: Rectangle {
            width: 100%;
            height: 100%;
            opacity: root.mini-opacity;

            VerticalLayout {
            // Custom titlebar — only rendered in custom-frame mode. Use the
            // conditional element form (not `visible: false`) so the bar's
            // 36 px slot disappears entirely from the layout when the OS
            // owns the frame; otherwise we'd add 36 px of dead space above
            // the sidebar in native mode (CLAUDE.md "visible: false does
            // not remove an element from layout" pitfall).
            if !Theme.use-native-titlebar: CustomTitleBar { }

            // Top section: sidebar + content.
            //
            // `padding-right` on this layout (custom-frame mode only)
            // pushes the content panel — and its scrollbar — 4 px away
            // from the window's right edge. Without it, the thin
            // overlay scrollbar sits flush with the resize border and
            // grabbing the edge to widen the window catches the
            // scrollbar's hover instead. Native-frame mode leaves it at
            // 0 so the OS-drawn frame still abuts the content.
            HorizontalLayout {
                vertical-stretch: 1;
                padding-right: Theme.use-native-titlebar ? 0px : 4px;

                Sidebar {}

                // Rounded content panel. Single Rectangle with
                // `border-color` + `border-width` — same pattern as
                // `components/popup-surface.slint`. The border is a real
                // rounded stroke on the Rectangle's own primitive, so it
                // follows the corner curve exactly with no clip-masking
                // dependency.
                //
                // Native-frame mode keeps Tauri's original silhouette —
                // only the left side rounds (top-left + bottom-left) and
                // the right edge sits flush against the OS-drawn frame
                // with no visible border. Slint's `Rectangle` has no
                // per-side `border-width`, so we use a wrapping
                // square-clip Rectangle and oversize the panel by 1 px
                // to the right in native mode: the right border falls
                // outside the wrapper and gets clipped. Top + bottom +
                // left borders stay because the panel's height and left
                // edge match the wrapper exactly. Custom-frame mode
                // keeps the panel at wrapper-width so the 4 px right-
                // side margin on the parent layout still lands a fully
                // closed rounded rectangle.
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: Theme.use-native-titlebar
                            ? parent.width + 1px
                            : parent.width;
                        height: parent.height;
                        background: Theme.base;
                        border-color: Theme.border;
                        border-width: 1px;
                        // Left-side rounding splits by titlebar mode:
                        //   - Custom: tracks `Theme.shell-radius` (user-pickable
                        //     via the Settings page chips), matching the outer
                        //     mantle shell so the two arcs feel concentric.
                        //   - Native: tracks `Theme.native-content-radius`
                        //     (seeded from `get_os_corner_radius()` at startup),
                        //     so the panel's left-side corners feel native to
                        //     the host OS / desktop without a user setting.
                        border-top-left-radius: Theme.use-native-titlebar
                            ? Theme.native-content-radius
                            : Theme.shell-radius;
                        border-bottom-left-radius: Theme.use-native-titlebar
                            ? Theme.native-content-radius
                            : Theme.shell-radius;
                        border-top-right-radius: Theme.use-native-titlebar
                            ? 0px
                            : Theme.shell-radius;
                        border-bottom-right-radius: Theme.use-native-titlebar
                            ? 0px
                            : Theme.shell-radius;
                        clip: true;

                        // Index 1 (Browse), index 3 (Tracks), and index 8
                        // (Settings) render real views; every other index
                        // falls through to the placeholder. Use the `if`
                        // form (not `visible: false`) so the unselected
                        // branches are fully absent from the layout tree —
                        // see CLAUDE.md "visible: false does not remove an
                        // element from layout".
                        //
                        // The full-screen Now Playing view *replaces* the
                        // current view inside this panel when
                        // `Nav.now-playing-open` is set (opened from the
                        // now-playing bar's track-info card; closed by the
                        // view's back button or any sidebar item). Every
                        // regular branch is gated on `!now-playing-open` so
                        // exactly one view is mounted at a time.
                        // Index 0 (Search) — query-driven mixed-results
                        // page. Backed by FTS5 + LIKE via
                        // `library::search::search_all`. Wiring in
                        // `src/ui/callbacks/search/`.
                        if !Nav.now-playing-open && Nav.selected-index == 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            SearchView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 1: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            BrowseView { width: 100%; height: 100%; }
                        }
                        // Index 2 (Favorites) — single scrollable page
                        // (hero mosaic + Most Played / Favorite Albums /
                        // Favorite Artists strips + All Songs list).
                        // Cross-tab nav: clicking a favorite album/artist
                        // card sets `*Detail.origin-nav-index = 2` so
                        // the back arrow returns here, mirroring the
                        // Artist Detail → Album Detail → back behaviour.
                        if !Nav.now-playing-open && Nav.selected-index == 2: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            FavoritesView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 3: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            TracksView { width: 100%; height: 100%; }
                        }
                        // Index 4 (Albums) swaps between the card grid and
                        // the full detail view on `AlbumDetail.album-id`
                        // (-1 = grid) — mirrors the `now-playing-open` swap.
                        if !Nav.now-playing-open && Nav.selected-index == 4
                            && AlbumDetail.album-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            AlbumView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 4
                            && AlbumDetail.album-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            AlbumDetailView { width: 100%; height: 100%; }
                        }
                        // Index 5 (Artists) — same grid ↔ detail swap as
                        // Albums, gated on `ArtistDetail.artist-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 5
                            && ArtistDetail.artist-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            ArtistView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 5
                            && ArtistDetail.artist-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            ArtistDetailView { width: 100%; height: 100%; }
                        }
                        // Index 6 (Genres) — same grid ↔ detail swap as
                        // Albums / Artists, gated on `GenreDetail.genre-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 6
                            && GenreDetail.genre-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            GenresView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 6
                            && GenreDetail.genre-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            GenreDetailView { width: 100%; height: 100%; }
                        }
                        // Index 7 (Playlists) — same grid ↔ detail swap,
                        // gated on `PlaylistDetail.playlist-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 7
                            && PlaylistDetail.playlist-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaylistsView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 7
                            && PlaylistDetail.playlist-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaylistDetailView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 8: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            RecentlyPlayedView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 9: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            SettingsView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open
                            && Nav.selected-index != 0
                            && Nav.selected-index != 1
                            && Nav.selected-index != 2
                            && Nav.selected-index != 3
                            && Nav.selected-index != 4
                            && Nav.selected-index != 5
                            && Nav.selected-index != 6
                            && Nav.selected-index != 7
                            && Nav.selected-index != 8
                            && Nav.selected-index != 9: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaceholderView {
                                width: 100%;
                                height: 100%;
                                title: root.view-title(Nav.selected-index);
                            }
                        }
                        // Now Playing also rides ViewTransition for parity
                        // with every other branch. Hard-coded to `below` —
                        // this `if` branch only fires on open (closing is
                        // the *outgoing* state, which `ViewTransition` does
                        // not animate by design).
                        if Nav.now-playing-open: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: NavEnterFrom.below;
                            NowPlayingView { width: 100%; height: 100%; }
                        }

                        // Queue bottom-sheet — mounted INSIDE the
                        // content panel so its backdrop + slide
                        // animation are confined to the main view
                        // (Tauri parity: the sheet only covers the
                        // content area, not the sidebar or now-
                        // playing-bar). Declared after the view
                        // branches so it stacks above them; the
                        // panel's `clip: true` prevents the closed-
                        // state card from showing past the bottom
                        // edge. Always rendered so the close
                        // animation can play after `Queue.open`
                        // flips back to false.
                        QueueSheet {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }

            NowPlayingBar {}
            }
        }

        // Miniplayer branch — replaces the full UI when the OS window
        // shrinks past the responsive threshold. Same opacity-binding +
        // sibling-of-FocusScope shape as the full branch, so the fade
        // animates symmetrically in either direction.
        if root.mini-render-active: Rectangle {
            width: 100%;
            height: 100%;
            opacity: root.mini-opacity;

            MiniPlayerView {
                width: 100%;
                height: 100%;
            }
        }
        }
    }

    // Resize-affordance ring. Mirrors Tauri's `WindowResizeHandles`
    // (a `<Show when={!isMaximized()}>` block at z-index 9999) but
    // sized to match this window's `resize-border-width: 4px`.
    //
    // Only the cursor + hover suppression are handled here; the
    // actual resize click is processed by Slint's winit backend
    // (`i-slint-backend-winit::event_loop`) before the press is
    // ever dispatched to a TouchArea, so these overlays don't need
    // a `clicked` handler. The `mouse-cursor` is set so users get a
    // visual cue and so hover transfers from whatever sits below
    // (close button, scrollbar, now-playing-bar buttons) to the
    // overlay — preventing red flashes on the close button and
    // hover paint on the scrollbar when aiming at the resize zone.
    //
    // Edge thickness (4 px) matches `resize-border-width`; corners
    // are slightly larger (8 × 8) for a more forgiving diagonal
    // grab, smaller than the previous 10 × 10 since the user
    // requested less area.
    //
    // Order: edges first, corners after — Slint dispatches hover to
    // the topmost (= last-declared) item under the cursor, so the
    // diagonal-resize cursor wins at corners while edges win
    // everywhere else along the perimeter.
    //
    // Hidden when maximized (resize is a no-op then) and when the
    // OS owns the frame (the OS draws its own resize border).

    // Top edge — full window width.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: 4px;
        mouse-cursor: ns-resize;
    }
    // Bottom edge.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: 0;
        y: root.height - 4px;
        width: root.width;
        height: 4px;
        mouse-cursor: ns-resize;
    }
    // Left edge — clipped to the band between the corners.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: 0;
        y: 0;
        width: 4px;
        height: root.height;
        mouse-cursor: ew-resize;
    }
    // Right edge — sits over the scrollbar's right-most pixels.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: root.width - 4px;
        y: 0;
        width: 4px;
        height: root.height;
        mouse-cursor: ew-resize;
    }

    // Corners — declared after the edges so they win at the corners.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: 0;
        y: 0;
        width: 8px;
        height: 8px;
        mouse-cursor: nwse-resize;
    }
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: root.width - 8px;
        y: 0;
        width: 8px;
        height: 8px;
        mouse-cursor: nesw-resize;
    }
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: 0;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nesw-resize;
    }
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: TouchArea {
        x: root.width - 8px;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: nwse-resize;
    }

    // Modal dialog overlay — sibling of the main VerticalLayout. Window
    // children stack in z-order based on declaration order, so the overlay
    // paints above the layout. The overlay always renders so its
    // open/close animation can play; its TouchArea is `enabled` only while
    // `Dialog.open`, so closed-state pointer events fall through.
    DialogOverlay {
        width: 100%;
        height: 100%;
    }

    // Transient bottom-right notification stack — also a sibling of the
    // main layout. Declared *after* `DialogOverlay` so it paints above an
    // open dialog's backdrop (so a notification that fires mid-dialog
    // stays visible). The stack itself contains no root TouchArea, so
    // its empty area doesn't block clicks on whatever is below.
    NotificationStack {
        width: 100%;
        height: 100%;
    }
}
