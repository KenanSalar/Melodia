// Vazirmatn (OFL, github.com/rastikerdar/vazirmatn) — single family that
// covers both Latin and Arabic with consistent metrics, so mixed-script
// rows / labels don't drift vertically the way they did when Slint fell
// back from Inter (Latin-only) to a system Arabic font with taller
// ascenders. Three weights cover the project's usages: Regular (400) for
// body, Medium (500) for the now-playing title, SemiBold (600) for page
// titles.
//
// The bundled TTFs are PATCHED — `scripts/patch_vazirmatn.py` rewrites
// the OS/2 typo + hhea metrics to a Latin-typical line ratio (upstream
// Vazirmatn ships those at ~1.56× so Arabic combining marks fit; at our
// UI sizes that pushed every vertically-centred Latin text several px
// upward). The patched variant lives under `assets/fonts/vazirmatn/`
// and is imported directly below; pristine upstream copies are kept
// under `assets/fonts/originals/` as the patch script's input.
import "assets/fonts/vazirmatn/Vazirmatn-Regular.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-Medium.ttf";
import "assets/fonts/vazirmatn/Vazirmatn-SemiBold.ttf";

import { Theme } from "theme.slint";
import { Settings } from "settings.slint";
import { Albums, AlbumDetail } from "globals/albums.slint";
import { Artists, ArtistDetail } from "globals/artists.slint";
import { Equalizer, ReplayGain, Visualizer } from "globals/audio.slint";
import { Favorites, RecentlyPlayed } from "globals/curated.slint";
import { SmartEditor, TagEditor, ScrobbleUi } from "globals/dialog-forms.slint";
import { Dialog } from "globals/dialog.slint";
import { Genres, GenreDetail } from "globals/genres.slint";
import { HeroBackdrop } from "globals/hero-backdrop.slint";
import { LibrarySettings } from "globals/library-settings.slint";
import { Nav, NavEnterFrom } from "globals/nav.slint";
import { Player } from "globals/player.slint";
import { Playlists, PlaylistDetail } from "globals/playlists.slint";
import { Queue, NowPlaying } from "globals/queue.slint";
import { Search } from "globals/search.slint";
import { WindowChrome, MiniPlayer, CompositeScroll, PopupHighlight } from "globals/shell.slint";
import { Tracks, Browse, RowCovers } from "globals/tracks.slint";
import { MelodiaUpdater, Notifications } from "globals/updater.slint";
import { TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
         BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
         AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
         GenreRow, GenreGridRow,
         PlaylistRow, PlaylistGridRow, SmartRuleRow } from "models.slint";
import { Sidebar } from "layout/sidebar.slint";
import { NowPlayingBar } from "layout/now-playing-bar.slint";
import { ResizeRing } from "layout/resize-ring.slint";
import { ShortcutScope } from "layout/shortcut-scope.slint";
import { PlaceholderView } from "views/placeholder-view.slint";
import { TracksView } from "views/tracks-view.slint";
import { FavoritesView } from "views/favorites-view.slint";
import { RecentlyPlayedView } from "views/recently-played-view.slint";
import { BrowseView } from "views/browse-view.slint";
import { AlbumView } from "views/album-view.slint";
import { AlbumDetailView } from "views/album-detail-view.slint";
import { ArtistView } from "views/artist-view.slint";
import { ArtistDetailView } from "views/artist-detail-view.slint";
import { GenresView } from "views/genres-view.slint";
import { GenreDetailView } from "views/genre-detail-view.slint";
import { PlaylistsView } from "views/playlists-view.slint";
import { PlaylistDetailView } from "views/playlist-detail-view.slint";
import { SearchView } from "views/search-view.slint";
import { SettingsView } from "views/settings-view.slint";
import { NowPlayingView } from "views/now-playing-view.slint";
import { MiniPlayerView } from "views/mini-player.slint";
import { QueueSheet } from "views/queue-sheet.slint";
import { DialogOverlay } from "components/dialog/dialog.slint";
import { CustomTitleBar } from "components/custom-titlebar.slint";
import { NotificationStack } from "components/dialog/notification-stack.slint";
import { MiniPlayerSwitch } from "components/mini-player-switch.slint";
import { SectionActiveGate } from "components/section-active-gate.slint";
import { ViewTransition } from "components/view-transition.slint";

// Re-export so Rust can mention these from `slint::include_modules!`.
export {
    Theme, Settings, Player, HeroBackdrop, Equalizer, ReplayGain, Visualizer, ScrobbleUi, SmartEditor, TagEditor, Nav, CompositeScroll, MiniPlayer, Tracks, Browse, LibrarySettings, Dialog, WindowChrome, Queue, Notifications, NowPlaying, Favorites, RecentlyPlayed, Albums, AlbumDetail, Artists, ArtistDetail, Genres, GenreDetail, Playlists, PlaylistDetail, PopupHighlight, Search, MelodiaUpdater, RowCovers,
    TrackSummaryRow, TrackListRow, PlayerVm, QueueVm, QueueRow, FolderListRow,
    BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
    AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
    GenreRow, GenreGridRow,
    PlaylistRow, PlaylistGridRow, SmartRuleRow,
}

export component AppWindow inherits Window {
    title: "Melodia";
    // No `preferred-width` / `preferred-height` here. The initial OS
    // window size is restored from `settings.json` by
    // `src/ui/window_chrome/geometry.rs::restore`, which calls
    // `slint::Window::set_size` after `AppWindow::new()`. That call
    // sets the winit backend's `has_explicit_size` flag, which is the
    // only thing that stops Slint from snapping the window to the
    // content-preferred size on first show — a hardcoded
    // `preferred-width/height` here would just be that snap target.
    // Min constraints stay as size hints below.
    // Floor matches the miniplayer's smallest sensible footprint
    // (~350×90, mirrors Tauri's `setMinSize` on mini enter). The full UI
    // is only rendered above `mini-active`'s ~550×250 threshold; below
    // that, `MiniPlayerView` takes over. Keeping the OS-level minimum at
    // the mini's floor lets the user drag straight down into mini mode
    // without us having to runtime-mutate winit constraints.
    min-width: 350px;
    min-height: 90px;
    // Window background mode:
    //   - Custom-frame + windowed: transparent ARGB surface so the OS
    //     compositor blends our rounded outer mantle shell with the
    //     desktop — the alpha=0 corners outside the rounded shell are
    //     "not our window," giving real rounded window corners on
    //     Wayland (KWin/Mutter/Sway), X11 (with a compositor), Windows
    //     (layered window via WS_EX_LAYERED), and macOS (NSWindow with
    //     opaque=NO). Slint's winit backend always requests a transparent-
    //     capable surface (`i-slint-backend-winit/winitwindowadapter.rs`),
    //     so this works without any Cargo features beyond what we already
    //     enable.
    //   - Native-frame OR maximized: opaque mantle. Native mode lets the
    //     OS-drawn frame abut a solid backdrop. Maximized falls back for
    //     pure UX reasons — rounded corners on an edge-to-edge window
    //     would clip against the screen edge / adjacent monitor, which
    //     looks broken; every maximize-aware app does this. (Note: the
    //     Slint Wayland transparency caveat people sometimes invoke —
    //     slint-ui/slint#6145 — is fullscreen-specific, not maximized;
    //     KWin / Mutter / Sway all composite alpha on maximized surfaces
    //     in practice. Melodia has no fullscreen mode today, so there's
    //     no separate fullscreen guard. If a fullscreen toggle ever
    //     lands, mirror `is-maximized` with an `is-fullscreen` flag.)
    //     `WindowChrome.is-maximized` is reactively maintained by
    //     `src/ui/window_chrome/`'s `WindowEvent::Resized` filter via
    //     `winit::Window::is_maximized`, so the toggle flips on every
    //     maximize/restore.
    background: (Theme.use-native-titlebar || WindowChrome.is-maximized)
        ? Theme.mantle
        : Colors.transparent;

    // Custom titlebar mode: drop the OS frame so we can paint our own
    // chrome. Slint reads `no-frame` once when the OS window first
    // shows, so `Theme.use-native-titlebar` must be hydrated from
    // `WindowFlags.use_native_titlebar` *before* `app.run()` —
    // `src/ui/window_chrome/`'s `install` does that. With `no-frame`
    // on, winit no longer paints resize edges, so `Theme.resize-border`
    // restores them; in native-frame mode the OS owns resizing, so the
    // inner border drops to 0. `ResizeRing` below reads the same token —
    // winit's border check decides where `drag_resize_window` fires, the
    // ring decides where hover is suppressed, and a drift between them
    // would leave a band where the cursor changes but the widget under
    // it still flashes hover, or the reverse.
    no-frame: !Theme.use-native-titlebar;
    resize-border-width: Theme.use-native-titlebar ? 0px : Theme.resize-border;

    default-font-family: "Vazirmatn";
    default-font-size: Theme.font-size-md;

    function view-title(idx: int) -> string {
        if (idx == 0) { return @tr("Search"); }
        if (idx == 1) { return @tr("Browse"); }
        if (idx == 2) { return @tr("Favorites"); }
        if (idx == 3) { return @tr("Tracks"); }
        if (idx == 4) { return @tr("Albums"); }
        if (idx == 5) { return @tr("Artists"); }
        if (idx == 6) { return @tr("Genres"); }
        if (idx == 7) { return @tr("Playlists"); }
        if (idx == 8) { return @tr("Recently Played"); }
        if (idx == 9) { return @tr("Settings"); }
        // App name (proper noun) — never translated.
        return "Melodia";
    }

    // Clear the Settings page's live search query and blur its TextInput
    // when the user navigates away. The handler lives at the AppWindow
    // level so it always fires — `SettingsView` is mounted only when
    // `Nav.selected-index == 9`, so a `changed` handler placed inside it
    // would never see the leaving transition (the component gets
    // de-instantiated before the handler runs). Slint's `changed` only
    // observes properties on the current element, not path expressions on
    // globals, so we mirror `Nav.selected-index` into a local property
    // and watch that. Returning to Settings therefore always shows the
    // full page; the next keystroke can't land in a hidden field on
    // another page.
    property <int> watched-nav-idx: Nav.selected-index;
    changed watched-nav-idx => {
        // A tab switch changes the mounted content view — drop whatever the
        // outgoing composite view left behind (see `CompositeScroll.reset`).
        CompositeScroll.reset();
        if (self.watched-nav-idx != 9) {
            Settings.search-query = "";
            Settings.blur-search-tick += 1;
        }
        // Re-grab global keyboard focus on every section change. The
        // outgoing view may hold focus in a TextInput about to be
        // de-instantiated (Search's autofocused bar, a manually-focused
        // filter); Slint does not return focus to an ancestor FocusScope
        // when the focused item is destroyed, so shortcuts would go dead
        // until the next click. Runs synchronously on the index change —
        // SearchView's 1 ms autofocus Timer fires afterwards, so entering
        // Search still lands the caret in the search bar.
        shortcut-scope.grab-focus();
    }

    // Mirror `Nav.now-playing-open` so Rust can gate the Up Next list
    // rebuild on the view being visible. Same rationale as
    // `watched-nav-idx` above: `Nav` is a global and `changed` can't watch
    // a path expression on a global, so we mirror it into a local property
    // at the always-mounted `AppWindow` level — `NowPlayingView` itself is
    // unmounted while closed, so a handler inside it would miss the
    // open/close transitions.
    property <bool> watched-now-playing-open: Nav.now-playing-open;
    changed watched-now-playing-open => {
        // NP open/close swaps the mounted content view.
        CompositeScroll.reset();
        Nav.now-playing-open-changed(self.watched-now-playing-open);
        // Opening / closing Now Playing de-instantiates the section view
        // underneath it — same focus-orphaning risk as a sidebar nav (see
        // `watched-nav-idx`). Re-grab focus so global shortcuts survive.
        shortcut-scope.grab-focus();
    }

    // Arm the visualizer's audio-thread sample tap only while something is
    // actually drawing it. Same mirroring rationale as the block above, and it
    // has to be its own property rather than a second handler on
    // `now-playing-open-changed` — that callback has one handler slot, already
    // taken by `wire_now_playing_open`.
    property <bool> watched-viz-active: Nav.now-playing-open && Visualizer.enabled;
    changed watched-viz-active => {
        Visualizer.set-active(self.watched-viz-active);
    }

    // Artist Detail (a composite-scroll view) opens/closes without a nav-index
    // change — grid ↔ detail both live under index 5 — so the reset above would
    // miss it. Mirror the detail id and reset on any change, else the unmounting
    // view's stale hover flag would trap the wheel on the artist grid.
    property <int> watched-artist-detail-id: ArtistDetail.artist-id;
    changed watched-artist-detail-id => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // The other three details unmount their grid the same way, and every grid
    // carries a filter TextInput that still holds focus when a card is clicked —
    // the orphaning `watched-nav-idx` describes. None of them is a composite
    // view, so focus is all they owe.
    property <int> watched-album-detail-id: AlbumDetail.album-id;
    changed watched-album-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-genre-detail-id: GenreDetail.genre-id;
    changed watched-genre-detail-id => {
        shortcut-scope.grab-focus();
    }

    property <int> watched-playlist-detail-id: PlaylistDetail.playlist-id;
    changed watched-playlist-detail-id => {
        shortcut-scope.grab-focus();
    }

    // The miniplayer swap unmounts the whole full-UI branch — and with it any
    // composite view, and any focused filter — without a nav-index change, so
    // the resets above would miss it too.
    property <bool> watched-mini-render: mini-switch.render-active;
    changed watched-mini-render => {
        CompositeScroll.reset();
        shortcut-scope.grab-focus();
    }

    // The responsive full-UI ↔ miniplayer swap. Owns the size thresholds, the
    // two-phase fade, and the writes into the `MiniPlayer` global — see
    // `components/mini-player-switch.slint`. Fed the live window size, since a
    // component's root binding can't reach `parent`.
    mini-switch := MiniPlayerSwitch {
        host-width: root.width;
        host-height: root.height;
    }

    // ---- Section-visibility hooks ---------------------------------------
    // One gate per sidebar section, in nav-index order. `SectionActiveGate`
    // owns the predicate and the `changed` watcher (see its header for why the
    // watcher has to sit up here rather than inside each view); what differs
    // per section is only which Rust hook the transition drives, and what that
    // hook does with it — which is what these comments record.

    // Search. Query-driven, so there's no library-changed refresh, but Rust
    // still releases the per-strip album + artist cover LRUs on `false` (and
    // clears the result models on the UI thread before the `spawn_blocking`
    // release runs). `query` + `recent-rows` survive, so a brief flip away and
    // back lands on the same view state.
    SectionActiveGate {
        index: 0;
        mini-active: mini-switch.active;
        active-changed(active) => { Search.section-active-changed(active); }
    }

    // Browse. Gate-only, like Tracks: the `library_changed` subscriber skips
    // re-fetching the current directory while the view is hidden.
    SectionActiveGate {
        index: 1;
        mini-active: mini-switch.active;
        active-changed(active) => { Browse.section-active-changed(active); }
    }

    // Favorites. The single `FavoritesView` covers both the hero+strips and the
    // All Songs list, so there's no detail flip inside this branch. Rust
    // releases the mosaic / Most Played / Artists cover caches AND the borrowed
    // Albums grid cover cache on `false`, then re-fetches hero + strips +
    // tracks via the library-changed dirty flag on `true`.
    SectionActiveGate {
        index: 2;
        mini-active: mini-switch.active;
        active-changed(active) => { Favorites.section-active-changed(active); }
    }

    // Tracks. Unlike Albums, the view keeps its row model warm across
    // nav-aways (no cache release on leave) — Rust uses this only to gate the
    // `library_changed` refresher: hidden ⇒ mark dirty and skip the
    // full-library re-fetch, re-enter ⇒ one deferred refresh.
    SectionActiveGate {
        index: 3;
        mini-active: mini-switch.active;
        active-changed(active) => { Tracks.section-active-changed(active); }
    }

    // Albums. Rust releases the album-tier cover cache on `false` (sidebar nav
    // away, or opening Now Playing *from* Albums) and re-warms it on `true`.
    // `AlbumView` / `AlbumDetailView` are both inside this branch, so
    // grid↔detail stays `true` — as it does for Artists, Genres and Playlists.
    SectionActiveGate {
        index: 4;
        mini-active: mini-switch.active;
        active-changed(active) => { Albums.section-active-changed(active); }
    }

    // Artists.
    SectionActiveGate {
        index: 5;
        mini-active: mini-switch.active;
        active-changed(active) => { Artists.section-active-changed(active); }
    }

    // Genres. The Rust hook has no cache to release today (genres have no
    // artwork), but it's wired for symmetry with Albums / Artists.
    SectionActiveGate {
        index: 6;
        mini-active: mini-switch.active;
        active-changed(active) => { Genres.section-active-changed(active); }
    }

    // Playlists. Releases the playlist-tier cover cache on `false` and re-warms
    // on `true` — mirrors the Albums hook.
    SectionActiveGate {
        index: 7;
        mini-active: mini-switch.active;
        active-changed(active) => { Playlists.section-active-changed(active); }
    }

    // Recently Played. Like Favorites, Rust releases the section's cover cache
    // on `false` and re-fetches on `true`.
    SectionActiveGate {
        index: 8;
        mini-active: mini-switch.active;
        active-changed(active) => { RecentlyPlayed.section-active-changed(active); }
    }

    // Outer mantle shell. In custom-frame + windowed mode the Window's
    // background is transparent, so this rounded mantle Rectangle IS the
    // visible window outline — the compositor treats the alpha=0 area
    // outside its rounded corners as "not our window". `clip: true`
    // ensures any child painting outside the rounded shape is masked.
    //
    // In native-frame mode OR when maximized the radius drops to 0 so
    // the layout stays full-bleed: native mode wants the OS-drawn frame
    // to abut a square backdrop, and a maximized window's rounded
    // corners would clip against the screen edge / adjacent monitor (no
    // shadow gap implied). The inner content panel below still rounds
    // via `Theme.shell-radius` (custom) / `Theme.native-content-radius`
    // (native) for Tauri parity.
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.mantle;
        border-radius: (Theme.use-native-titlebar || WindowChrome.is-maximized)
            ? 0px
            : Theme.shell-radius;
        clip: true;

        // Global keyboard shortcuts. Wraps the entire main layout (titlebar +
        // sidebar + content + now-playing-bar) so unhandled keys from child
        // scopes — notably the QueueSheet's own FocusScope — bubble up and land
        // here. The bindings, the volume-commit debounce and the focus contract
        // all live in `layout/shortcut-scope.slint`.
        shortcut-scope := ShortcutScope {
            width: 100%;
            height: 100%;

        // Full UI branch. Wrapped in a Rectangle so we can drive the
        // miniplayer fade transition from a single ancestor. Conditional on
        // `mini-switch.render-active` — the fade-delayed shadow of `active` —
        // so only one branch is mounted at any time (avoids holding sidebar
        // grid covers + the mini up-next subscriber alive together during the
        // swap).
        if !mini-switch.render-active: Rectangle {
            width: 100%;
            height: 100%;
            opacity: mini-switch.fade-opacity;

            VerticalLayout {
            // Custom titlebar — only rendered in custom-frame mode. Use the
            // conditional element form (not `visible: false`) so the bar's
            // 36 px slot disappears entirely from the layout when the OS
            // owns the frame; otherwise we'd add 36 px of dead space above
            // the sidebar in native mode (CLAUDE.md "visible: false does
            // not remove an element from layout" pitfall).
            if !Theme.use-native-titlebar: CustomTitleBar { }

            // Top section: sidebar + content.
            //
            // `padding-right` on this layout (custom-frame mode only)
            // pushes the content panel — and its scrollbar — 4 px away
            // from the window's right edge. Without it, the thin
            // overlay scrollbar sits flush with the resize border and
            // grabbing the edge to widen the window catches the
            // scrollbar's hover instead. Native-frame mode leaves it at
            // 0 so the OS-drawn frame still abuts the content.
            HorizontalLayout {
                vertical-stretch: 1;
                padding-right: Theme.use-native-titlebar ? 0px : 4px;

                Sidebar {}

                // Rounded content panel. Single Rectangle with
                // `border-color` + `border-width` — same pattern as
                // `components/popup-surface.slint`. The border is a real
                // rounded stroke on the Rectangle's own primitive, so it
                // follows the corner curve exactly with no clip-masking
                // dependency.
                //
                // Native-frame mode keeps Tauri's original silhouette —
                // only the left side rounds (top-left + bottom-left) and
                // the right edge sits flush against the OS-drawn frame
                // with no visible border. Slint's `Rectangle` has no
                // per-side `border-width`, so we use a wrapping
                // square-clip Rectangle and oversize the panel by 1 px
                // to the right in native mode: the right border falls
                // outside the wrapper and gets clipped. Top + bottom +
                // left borders stay because the panel's height and left
                // edge match the wrapper exactly. Custom-frame mode
                // keeps the panel at wrapper-width so the 4 px right-
                // side margin on the parent layout still lands a fully
                // closed rounded rectangle.
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: Theme.use-native-titlebar
                            ? parent.width + 1px
                            : parent.width;
                        height: parent.height;
                        background: Theme.base;
                        border-color: Theme.border;
                        border-width: 1px;
                        // Left-side rounding splits by titlebar mode:
                        //   - Custom: tracks `Theme.shell-radius` (user-pickable
                        //     via the Settings page chips), matching the outer
                        //     mantle shell so the two arcs feel concentric.
                        //   - Native: tracks `Theme.native-content-radius`
                        //     (seeded from `get_os_corner_radius()` at startup),
                        //     so the panel's left-side corners feel native to
                        //     the host OS / desktop without a user setting.
                        border-top-left-radius: Theme.use-native-titlebar
                            ? Theme.native-content-radius
                            : Theme.shell-radius;
                        border-bottom-left-radius: Theme.use-native-titlebar
                            ? Theme.native-content-radius
                            : Theme.shell-radius;
                        border-top-right-radius: Theme.use-native-titlebar
                            ? 0px
                            : Theme.shell-radius;
                        border-bottom-right-radius: Theme.use-native-titlebar
                            ? 0px
                            : Theme.shell-radius;
                        clip: true;

                        // Index 1 (Browse), index 3 (Tracks), and index 8
                        // (Settings) render real views; every other index
                        // falls through to the placeholder. Use the `if`
                        // form (not `visible: false`) so the unselected
                        // branches are fully absent from the layout tree —
                        // see CLAUDE.md "visible: false does not remove an
                        // element from layout".
                        //
                        // The full-screen Now Playing view *replaces* the
                        // current view inside this panel when
                        // `Nav.now-playing-open` is set (opened from the
                        // now-playing bar's track-info card; closed by the
                        // view's back button or any sidebar item). Every
                        // regular branch is gated on `!now-playing-open` so
                        // exactly one view is mounted at a time.
                        // Index 0 (Search) — query-driven mixed-results
                        // page. Backed by FTS5 + LIKE via
                        // `library::search::search_all`. Wiring in
                        // `src/ui/callbacks/search/`.
                        if !Nav.now-playing-open && Nav.selected-index == 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            SearchView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 1: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            BrowseView { width: 100%; height: 100%; }
                        }
                        // Index 2 (Favorites) — single scrollable page
                        // (hero mosaic + Most Played / Favorite Albums /
                        // Favorite Artists strips + All Songs list).
                        // Cross-tab nav: clicking a favorite album/artist
                        // card sets `*Detail.origin-nav-index = 2` so
                        // the back arrow returns here, mirroring the
                        // Artist Detail → Album Detail → back behaviour.
                        if !Nav.now-playing-open && Nav.selected-index == 2: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            FavoritesView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 3: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            TracksView { width: 100%; height: 100%; }
                        }
                        // Index 4 (Albums) swaps between the card grid and
                        // the full detail view on `AlbumDetail.album-id`
                        // (-1 = grid) — mirrors the `now-playing-open` swap.
                        if !Nav.now-playing-open && Nav.selected-index == 4
                            && AlbumDetail.album-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            AlbumView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 4
                            && AlbumDetail.album-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            AlbumDetailView { width: 100%; height: 100%; }
                        }
                        // Index 5 (Artists) — same grid ↔ detail swap as
                        // Albums, gated on `ArtistDetail.artist-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 5
                            && ArtistDetail.artist-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            ArtistView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 5
                            && ArtistDetail.artist-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            ArtistDetailView { width: 100%; height: 100%; }
                        }
                        // Index 6 (Genres) — same grid ↔ detail swap as
                        // Albums / Artists, gated on `GenreDetail.genre-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 6
                            && GenreDetail.genre-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            GenresView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 6
                            && GenreDetail.genre-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            GenreDetailView { width: 100%; height: 100%; }
                        }
                        // Index 7 (Playlists) — same grid ↔ detail swap,
                        // gated on `PlaylistDetail.playlist-id`.
                        if !Nav.now-playing-open && Nav.selected-index == 7
                            && PlaylistDetail.playlist-id < 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaylistsView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 7
                            && PlaylistDetail.playlist-id >= 0: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaylistDetailView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 8: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            RecentlyPlayedView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open && Nav.selected-index == 9: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            SettingsView { width: 100%; height: 100%; }
                        }
                        if !Nav.now-playing-open
                            && Nav.selected-index != 0
                            && Nav.selected-index != 1
                            && Nav.selected-index != 2
                            && Nav.selected-index != 3
                            && Nav.selected-index != 4
                            && Nav.selected-index != 5
                            && Nav.selected-index != 6
                            && Nav.selected-index != 7
                            && Nav.selected-index != 8
                            && Nav.selected-index != 9: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: Nav.pending-enter-from;
                            PlaceholderView {
                                width: 100%;
                                height: 100%;
                                title: root.view-title(Nav.selected-index);
                            }
                        }
                        // Now Playing also rides ViewTransition for parity
                        // with every other branch. Hard-coded to `below` —
                        // this `if` branch only fires on open (closing is
                        // the *outgoing* state, which `ViewTransition` does
                        // not animate by design).
                        if Nav.now-playing-open: ViewTransition {
                            width: parent.width;
                            height: parent.height;
                            enter-from: NavEnterFrom.below;
                            NowPlayingView { width: 100%; height: 100%; }
                        }

                        // Queue bottom-sheet — mounted INSIDE the
                        // content panel so its backdrop + slide
                        // animation are confined to the main view
                        // (Tauri parity: the sheet only covers the
                        // content area, not the sidebar or now-
                        // playing-bar). Declared after the view
                        // branches so it stacks above them; the
                        // panel's `clip: true` prevents the closed-
                        // state card from showing past the bottom
                        // edge. Always rendered so the close
                        // animation can play after `Queue.open`
                        // flips back to false.
                        QueueSheet {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }

            NowPlayingBar {}
            }
        }

        // Miniplayer branch — replaces the full UI when the OS window
        // shrinks past the responsive threshold. Same opacity-binding +
        // inside-the-shortcut-scope shape as the full branch, so the fade
        // animates symmetrically in either direction.
        if mini-switch.render-active: Rectangle {
            width: 100%;
            height: 100%;
            opacity: mini-switch.fade-opacity;

            MiniPlayerView {
                width: 100%;
                height: 100%;
            }
        }
        }
    }

    // Resize-affordance ring — the cursor hints over the band winit resizes
    // from. Mirrors Tauri's `WindowResizeHandles` (a
    // `<Show when={!isMaximized()}>` block at z-index 9999). Mounted only when
    // resizing is both possible and ours to advertise: not while maximized
    // (resize is a no-op then), and not in native-frame mode (the OS draws its
    // own border). Geometry comes from `Theme.resize-border` /
    // `Theme.resize-corner`, the same tokens the Window's
    // `resize-border-width` above reads.
    if !Theme.use-native-titlebar && !WindowChrome.is-maximized: ResizeRing {
        width: 100%;
        height: 100%;
    }

    // Modal dialog overlay — sibling of the main VerticalLayout. Window
    // children stack in z-order based on declaration order, so the overlay
    // paints above the layout. The overlay always renders so its
    // open/close animation can play; its TouchArea is `enabled` only while
    // `Dialog.open`, so closed-state pointer events fall through.
    DialogOverlay {
        width: 100%;
        height: 100%;
    }

    // Transient bottom-right notification stack — also a sibling of the
    // main layout. Declared *after* `DialogOverlay` so it paints above an
    // open dialog's backdrop (so a notification that fires mid-dialog
    // stays visible). The stack itself contains no root TouchArea, so
    // its empty area doesn't block clicks on whatever is below.
    NotificationStack {
        width: 100%;
        height: 100%;
    }
}
