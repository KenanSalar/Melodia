# ---- Auto-updater (Settings → Updates + notification toasts) ----------------

msgid "Skip this version"
msgstr "Salta questa versione"

msgid "Updates managed by your package manager"
msgstr "Aggiornamenti gestiti dal tuo gestore di pacchetti"

msgid "Use sudo dnf update melodia (or your distro equivalent)."
msgstr "Usa sudo dnf update melodia (o l'equivalente della tua distribuzione)."

msgid "Re-run the latest .msi installer from the Releases page."
msgstr "Riesegui l'ultimo installer .msi dalla pagina Releases."

msgid "Use brew upgrade melodia."
msgstr "Usa brew upgrade melodia."

msgid "Update available"
msgstr "Aggiornamento disponibile"

msgid "Melodia {} is ready to install."
msgstr "Melodia {} è pronta per essere installata."

msgid "Install"
msgstr "Installa"

msgid "Update installed"
msgstr "Aggiornamento installato"

msgid "Restart Melodia to start using the new version."
msgstr "Riavvia Melodia per usare la nuova versione."

msgid "Update failed"
msgstr "Aggiornamento non riuscito"

msgid "Couldn't reach the update server. Check your internet connection."
msgstr "Impossibile raggiungere il server degli aggiornamenti. Controlla la tua connessione Internet."

msgid "Signature check failed. The downloaded update may be corrupted; please try again."
msgstr "Verifica della firma non riuscita. L'aggiornamento scaricato potrebbe essere danneggiato; riprova."

msgid "The update server returned an unexpected response."
msgstr "Il server degli aggiornamenti ha restituito una risposta inattesa."

msgid "Couldn't write the downloaded update to disk."
msgstr "Impossibile scrivere l'aggiornamento scaricato su disco."

msgid "Update failed. See logs for details."
msgstr "Aggiornamento non riuscito. Consulta i log per i dettagli."

msgid "Close to Tray"
msgstr "Chiudi nell'area di notifica"

msgid "Keep Melodia running in the system tray when you close the window, instead of quitting."
msgstr "Mantieni Melodia in esecuzione nell'area di notifica alla chiusura della finestra, invece di uscire."

msgid "System Tray Icon"
msgstr "Icona nell'area di notifica"

msgid "Show a Melodia icon in the system tray with playback controls."
msgstr "Mostra un'icona di Melodia nell'area di notifica con i controlli di riproduzione."

msgid "Changing the system tray icon requires restarting Melodia. Restart now?"
msgstr "La modifica dell'icona nell'area di notifica richiede il riavvio di Melodia. Riavviare ora?"

msgid "Available only while the system tray icon is active."
msgstr "Disponibile solo quando l'icona nell'area di notifica è attiva."

