import { PlayerVm, QueueVm, QueueRow, TrackListRow, FolderListRow,
         BrowseFolderRow, BreadcrumbRow, NotificationRow, TrackMetaRow,
         AlbumRow, AlbumGridRow, ArtistRow, ArtistGridRow,
         GenreRow, GenreGridRow,
         PlaylistRow, PlaylistGridRow, PlaylistPickRow, PlaylistExportPickRow,
         SmartRuleRow,
         EntityStripRow } from "models.slint";
import { Theme } from "theme.slint";

// Direction the next `ViewTransition` mount slides in from. Set on the UI
// thread immediately before the property write (`Nav.selected-index` or
// `*Detail.*-id`) that flips an `if` branch — see `Nav.pending-enter-from`
// below. Lateral sidebar nav uses `below` (fade up); drilling into a
// detail uses `right`; the detail back button uses `left`.
export enum NavEnterFrom { below, right, left }

// Player: bound to the Rust backend via watch channels (push) + library::*
// (pull). Rust wires every callback in src/ui/callbacks.rs.
export global Player {
    in-out property <PlayerVm> vm;
    in-out property <QueueVm> queue;

    // Position-tick scalars — kept as standalone properties (not fields of
    // `vm`) so the 500 ms playback-monitor publish only invalidates the
    // three bindings that actually read them. See the long comment on
    // `PlayerVm` in models.slint for the leak history that motivated this.
    in-out property <int> position-ms;
    in-out property <int> duration-ms;
    in-out property <float> progress;

    // Seek-target hold: set by the seek callback to the requested position
    // (ms), cleared by the bridge once the backend's reported position lands
    // within ±2s or the current track changes. While ≥0 the progress slider
    // and time label prefer this value over `position-ms`, so the thumb
    // doesn't briefly snap to the old position before the next view-model
    // push.
    in-out property <int> seek_pending_ms: -1;

    // Full-screen Now Playing: pre-blurred background, dual-slot cross-fade.
    // Two stacked Image slots in `NowPlayingView`. On a track change Rust
    // writes the freshly blurred cover into the *inactive* slot, then flips
    // `blur-use-a`; Slint animates the two slots' opacity so the old and new
    // backgrounds cross-fade. NEITHER slot is ever cleared — the outgoing
    // layer keeps its image and stays painted for the whole fade, and a
    // gradient floor sits underneath, so there is never an empty frame (the
    // Tauri version flashed empty mid-fade — this is the fix). Written only
    // on track change, so unlike the position scalars these don't
    // re-invalidate on the 500 ms tick.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool> blur-use-a: true;
    // False when the current track has no artwork (or its cover failed to
    // decode) — both blur slots then fade to opacity 0, revealing the
    // accent-tinted gradient floor underneath (Tauri parity: the old app
    // used an accent `linear-gradient` fallback for art-less tracks).
    in-out property <bool> blur-has-image: false;

    // Full-screen Now Playing: the large *foreground* cover tile. Same
    // dual-slot cross-fade contract as the blurred backdrop above, just for
    // the sharp high-resolution artwork (decoded by `ui::now_playing_artwork`,
    // not the 72 px row thumbnail in `vm.track.cover_img`). On a track change
    // Rust writes the new cover into the inactive slot then flips
    // `np-cover-use-a`; both slots' opacity animate. A slot is never cleared.
    // `np-cover-has-image` is false for art-less / failed-decode tracks — both
    // slots then fade to 0 and the `music_note` placeholder fades in.
    in-out property <image> np-cover-a;
    in-out property <image> np-cover-b;
    in-out property <bool> np-cover-use-a: true;
    in-out property <bool> np-cover-has-image: false;

    // Async-fetched technical metadata for the current track, shown as chips
    // in `NowPlayingView`. Replaced wholesale by the metadata subscriber;
    // `track_id` lets the view drop a stale push that lands after a rapid
    // track change. Written only on track change.
    in-out property <TrackMetaRow> track-meta;

    // 2D chip strip — outer Vec is rows, inner Vec is chips in that row.
    // Populated by `src/ui/now_playing/metadata.rs` from `track-meta` + the
    // current chip-area width reported by the view (see
    // `recompute-chip-rows`). Empty rows / a 0-length outer Vec mean "no
    // chips" (no track, stale fetch, or all fields empty).
    in-out property <[[string]]> chip-rows;

    // View → Rust: chip-area's current available width. Wired in
    // `now-playing-view.slint` via a 1 ms mount Timer + `changed` handler —
    // mirrors `GridColumnsSync`. Rust re-chunks `chip-rows` on every fire,
    // and the track-change subscriber also re-chunks after replacing
    // `track-meta` using the last-reported width cached on the Rust side.
    callback recompute-chip-rows(length);

    // Per-artwork accent for the Now Playing view's tinted surfaces —
    // visualizer bars, stars/heart, Up-Next heading/divider/hover, chips.
    // Extracted from the blur buffer at decode time, floored to a minimum HCT
    // tone, written by the `track_change` subscriber. Falls back to
    // `Theme.accent`, which needs no lift.
    //
    // The floor lets one brush serve solid and translucent surfaces alike: a
    // dark cover's raw accent is near-black, invisible both as a solid bar on
    // the scrimmed blur and as a low-alpha fill over it. Callers vary alpha off
    // this brush rather than picking another hue. Not `.brighter()` — it scales
    // HSV value and can't lift near-black at all.
    in-out property <brush> np-accent-bright: Theme.accent;

    callback play-pause();
    callback next();
    callback previous();
    callback seek(int);          // position in ms
    callback set-volume(int);    // 0..100, fires continuously during drag
    callback commit-volume();    // fires on slider release; persists to settings.json
    // Playback-rate multiplier (e.g. 0.5, 1.0, 1.5). Fired by the speed
    // flyout in the now-playing bar's overflow menu. Applies to the live
    // player immediately AND persists to settings.json (speed survives
    // restarts). The active value is read back via `vm.playback_speed`.
    callback set-playback-speed(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite();
    // Set the star rating (0–5) on the currently playing track. Mirrors
    // `toggle-favorite`: applies to `current_track` + fans out to the row
    // surfaces. The active value is read back via `vm.track.rating`.
    callback set-current-rating(int /*rating*/);

    // Session-only sleep timer, fired by the overflow menu's sleep flyout.
    // `minutes`: 0 = off, > 0 = duration timer, -1 = "End of current track".
    // Applies live only (never persisted — resets each launch). See
    // `src/ui/sleep_timer.rs`.
    callback set-sleep-timer(int /*minutes*/);
    // Custom duration from the flyout's ±stepper Start pill (seconds). Rust
    // clamps to [30 s, 2 h] and arms a duration timer.
    callback set-sleep-timer-seconds(int /*seconds*/);
    // Active armed *duration* in seconds (0 = no duration timer). Drives the
    // flyout preset rows' active highlight (a preset matches when
    // `value*60 == this`) and the collapsed row. End-of-track mode is separate —
    // it rides on `vm.sleep_at_track_end`.
    in-out property <int> sleep-timer-total-seconds: 0;
    // Live "M:SS" / "H:MM:SS" remaining string, written by the countdown task each second.
    // Standalone (NOT a `vm` field) so the per-second update only invalidates
    // the row that reads it — same rationale as `position-ms` / `duration-ms`.
    in-out property <string> sleep-timer-remaining: "";

    // Bumped each time the user changes volume via the keyboard handler
    // in `ui/app-window.slint` (↑ / ↓ / Ctrl+↑ / Ctrl+↓). `VolumePopup`
    // observes this via a `changed` handler, sets a tick-down counter,
    // and force-shows its existing hover tooltip (`force-tooltip` →
    // `Tooltip.force-shown`) with the current `vm.volume` %; the
    // tooltip fades back out 1.5 s after the last keystroke. Slider
    // drags **don't** bump this — they already raise the VolumePopup
    // chrome.
    in-out property <int> volume-hud-tick: 0;
}

// Equalizer: drives the graphic-EQ dialog (`Dialog.kind == "equalizer"`).
// State is owned by Rust (`src/ui/equalizer.rs`): `enabled` + the `band-gains`
// model are seeded from `settings.json` at boot and updated on every user
// action; the dialog body reads them and fires the callbacks below. Each
// callback applies to the live Rodio player AND (for non-drag actions, or on
// drag release via `commit-band`) persists to `settings.json` — mirroring the
// `set-volume` / `commit-volume` split.
//
// `band-gains` is a Rust-owned `Rc<VecModel<f32>>` (gain in dB per band,
// low → high), length == `equalizer::NUM_BANDS` (10). `preset-idx` indexes the
// dropdown: `0..PRESET_COUNT-1` are the built-in presets (Flat first), and
// `PRESET_COUNT` (the last entry) is the synthetic "Custom" shown once the user
// hand-edits a band. `min-gain` / `max-gain` are seeded from
// `equalizer::{MIN,MAX}_GAIN_DB` by `install_equalizer` (Rust is the single
// source of truth — no literals to drift here).
export global Equalizer {
    in-out property <bool> enabled;
    in-out property <[float]> band-gains;
    in-out property <int> preset-idx;
    in property <float> min-gain;
    in property <float> max-gain;

    // Preamp / master gain (dB) — transparent headroom for boosting without
    // clipping. `min-preamp` / `max-preamp` are seeded from
    // `equalizer::{MIN,MAX}_PREAMP_DB` by `install_equalizer`.
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    // Live band change during a drag — apply to the player, don't persist.
    callback set-band(int /*band index*/, float /*gain dB*/);
    // Drag release — persist the current curve.
    callback commit-band(int /*band index*/, float /*gain dB*/);
    callback select-preset(int /*dropdown index*/);
    callback reset();
    // Preamp: live during drag (apply only), persist on release — same split.
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// SmartEditor: drives the Smart-Playlist rule-builder dialog
// (`Dialog.kind == "smart-playlist-editor"`). State is Rust-owned
// (`src/ui/callbacks/playlists/smart.rs`): the `rules` model is a
// `VecModel<SmartRuleRow>`, and the scalar properties are read back on `commit`.
// Entry points (`request-new` / `request-edit`) populate everything and open the
// dialog on a fresh event-loop tick (Rust hop — avoids the recursion guard that
// a synchronous `Dialog.open = true` from a click would trip). `commit` is fired
// by the `Dialog.accepted` dispatcher and reconstructs a `SmartCriteria` from
// the model + scalars, then creates (target-id < 0) or updates the playlist.
export global SmartEditor {
    in-out property <[SmartRuleRow]> rules;
    // 0 = match all (AND), 1 = match any (OR).
    in-out property <int> match-mode-index;
    in-out property <string> name;
    in-out property <string> description;
    // Optional result cap.
    in-out property <bool> limit-enabled;
    in-out property <string> limit-count-text: "25";
    in-out property <int> limit-order-index;
    // -1 = create a new smart playlist; otherwise the playlist id being edited.
    in-out property <int> target-id: -1;

    // Entry points — reset/populate state and open the dialog (Rust-driven).
    callback request-new();
    callback request-edit(int /*playlist_id*/);

    // Rule-row mutations (Rust rewrites the model row, recomputing
    // field-kind / input-kind).
    callback add-rule();
    callback remove-rule(int /*row*/);
    callback set-rule-field(int /*row*/, int /*field index*/);
    callback set-rule-op(int /*row*/, int /*op index*/);
    callback set-rule-value(int /*row*/, string);

    // Fired by the `Dialog.accepted` dispatcher — reconstruct + persist.
    callback commit();
}

// ReplayGain: drives the loudness-normalization dialog
// (`Dialog.kind == "replaygain"`). State is owned by Rust
// (`src/ui/replaygain.rs`): seeded from `settings.json` at boot and updated on
// every user action. Each callback applies to the live Rodio player AND
// persists to `settings.json` (the preamp uses the live `set-preamp` /
// release `commit-preamp` split, like the EQ preamp and volume). `mode-idx`:
// 0 = Track, 1 = Album (matches `player::replaygain::RgMode`). `min-preamp` /
// `max-preamp` are seeded from `replaygain::RG_{MIN,MAX}_PREAMP_DB` by
// `install_replaygain` (Rust is the single source of truth — no literals here).
export global ReplayGain {
    in-out property <bool> enabled;
    in-out property <int> mode-idx;
    in-out property <bool> prevent-clipping;
    in-out property <float> preamp;
    in property <float> min-preamp;
    in property <float> max-preamp;

    callback set-enabled(bool);
    callback set-mode(int /*0 = Track, 1 = Album*/);
    callback set-prevent-clipping(bool);
    // Preamp: live during drag (apply only), persist on release — same split.
    callback set-preamp(float /*dB*/);
    callback commit-preamp(float /*dB*/);
}

// Visualizer: drives the audio-visualizer strip in the Now-Playing view. State
// is owned by Rust (`src/ui/visualizer.rs`): `enabled` is seeded from
// `settings.json` at boot, then two-way bound by the Settings → Playback
// toggle, which also fires `set-enabled` to persist the choice. Ships **on** —
// see `VisualizerFlags`.
//
// `enabled` and `set-active` are deliberately separate. `enabled` is the
// persisted setting and decides whether the strip mounts at all; `set-active`
// is session state — the strip is mounted *and* the window is on screen — and
// is the only thing that arms the backend sample tap. Without the split the
// audio thread would keep filling the ring for a view nobody has open.
//
// `style` and `style-idx` are one choice in two shapes, both written by Rust:
// `VisualizerStrip` mounts on the **key**, so reordering the picker can never
// repoint an existing install's setting, while the Settings chips need the
// index. `set-style(i)` carries the picker's index back and Rust answers with
// both.
//
// Each style feeds off its own property, and `tick` fills only the active one:
//
//  - `bars` — a Rust-owned `Rc<VecModel<f32>>` of normalized 0..1 heights, low →
//    high frequency, length == `spectrum::NUM_BANDS`. Already smoothed (fast
//    attack / slow decay) in Rust, so the bars must NOT be `animate`d —
//    animating an already-smoothed value phase-lags.
//  - `wave-path` — SVG path commands for the oscilloscope trace: one closed
//    figure whose upper and lower edges are the loudest and quietest sample of
//    each drawn column, x over 0..1 and y over -1..1 against the `Path`'s fixed
//    viewbox. A string because Slint rejects `for`-generated path elements
//    (slint-ui/slint#754).
//
// `tick` is fired by `VisualizerStrip`'s Timer and does the whole
// snapshot → analysis → property pass. It carries the strip's width because the
// trace draws one column per couple of pixels rather than a fixed count, so its
// resolution has to follow the window. `idle` reports back that the drawing has
// decayed to rest, which lets that Timer stop once a paused player has settled:
// pausing halts the audio tap but leaves stale samples in the ring, so
// re-analysing them would freeze the drawing mid-shape instead of letting it
// fall.
export global Visualizer {
    in-out property <bool> enabled: true;
    in-out property <string> style: "bars";
    in-out property <int> style-idx;
    in property <[float]> bars;
    in property <string> wave-path;
    in property <bool> idle: true;

    callback set-enabled(bool);
    callback set-style(int);
    // Fired by `AppWindow`'s `watched-viz-active` mirror, not by the strip —
    // `NowPlayingView` is destroyed while closed and Slint has no unmount
    // callback, so the gate has to live somewhere always mounted.
    callback set-active(bool);
    callback tick(bool /*is-playing*/, float /*strip width, logical px*/);
}

// ScrobbleUi: drives the two scrobble login dialogs
// (`Dialog.kind == "scrobble-lastfm-login"` / `"scrobble-listenbrainz-login"`).
// State is owned by Rust (`src/ui/scrobbling_settings.rs`); the section resets it
// to defaults just before opening a dialog. Last.fm is a two-step browser auth:
// `lastfm-step` 0 → `lastfm-open-auth()` fetches an unauthorized token, opens the
// approval page, stashes the token in `lastfm-token` and advances to step 1; step
// 1 → `lastfm-finish(token)` exchanges it for a session. ListenBrainz is one step:
// `listenbrainz-verify(token)` validates the pasted token. `busy` gates the
// buttons while a request is in flight; `error` carries a localized failure line
// shown inline (Rust sets it via the `err-*` `@tr` callbacks — Slint 1.16 has no
// Rust-callable `tr()`).
export global ScrobbleUi {
    in-out property <int> lastfm-step;      // 0 = open browser, 1 = finish
    in-out property <string> lastfm-token;  // unauthorized token between steps
    in-out property <string> lb-token;      // ListenBrainz token input
    in-out property <bool> busy;
    in-out property <string> error;

    callback lastfm-open-auth();
    callback lastfm-finish(string /*token*/);
    callback listenbrainz-verify(string /*token*/);

    // Localized inline-error strings, resolved in the active locale at call time.
    pure callback err-invalid-token() -> string;
    err-invalid-token => {
        return @tr("That token wasn't accepted. Check it and try again.");
    }
    pure callback err-network() -> string;
    err-network => {
        return @tr("Couldn't reach the service. Check your connection and try again.");
    }
    pure callback err-not-authorized() -> string;
    err-not-authorized => {
        return @tr("Not approved yet. Approve Melodia in your browser, then click Finish.");
    }
    pure callback err-save-failed() -> string;
    err-save-failed => {
        return @tr("Couldn't save your credentials.");
    }
}

// TagEditor: drives the Edit-Track-Information dialog
// (`Dialog.kind == "edit-tags"`), opened from a track row's context menu for
// one *or many* selected rows. State is Rust-owned
// (`src/ui/callbacks/tags.rs`): `request-edit` fetches the rows, populates the
// fields, and opens the dialog on a fresh event-loop tick (the `SmartEditor`
// hop — a synchronous `Dialog.open = true` from a click trips the recursion
// guard). Numbers cross as strings so Rust owns parse + validation. On
// `commit` (fired by the `Dialog.accepted` dispatcher) Rust diffs each field
// against the populate-time snapshot to derive a Keep / Clear / Set tri-state,
// so only touched fields are written to the file.
//
// Batch editing is the point: a field that disagrees across the selection
// starts empty and shows the ‹multiple values› sentinel via its `*-placeholder`
// (Rust-set). The Lyrics and Summary tabs are single-selection only — driven by
// `track-count` in `tag-editor-body.slint` (the tab is not mounted in multi
// mode, never merely disabled).
export global TagEditor {
    // 13 editable fields — numbers cross the boundary as strings; Rust parses
    // and validates them into the typed `TagEdit` on commit.
    in-out property <string> title;
    in-out property <string> artist;
    in-out property <string> album-artist;
    in-out property <string> album;
    in-out property <string> genre;
    in-out property <string> year;
    in-out property <string> original-year;
    in-out property <string> track-number;
    in-out property <string> disc-number;
    in-out property <string> composer;
    in-out property <string> comment;
    in-out property <string> bpm;
    in-out property <string> lyrics;

    // Per-field placeholder — the ‹multiple values› sentinel when the
    // selection disagrees (multi mode), else the normal hint. Rust-set.
    in property <string> title-placeholder;
    in property <string> artist-placeholder;
    in property <string> album-artist-placeholder;
    in property <string> album-placeholder;
    in property <string> genre-placeholder;
    in property <string> year-placeholder;
    in property <string> original-year-placeholder;
    in property <string> track-number-placeholder;
    in property <string> disc-number-placeholder;
    in property <string> composer-placeholder;
    in property <string> comment-placeholder;
    in property <string> bpm-placeholder;
    in property <string> lyrics-placeholder;

    // 1 = single selection (Lyrics + Summary tabs available), >1 = batch.
    in property <int> track-count;
    // Active tab index; Rust resets it to 0 (Tags) on every populate.
    in-out property <int> active-tab;
    // Decoded preview of the current / picked cover; `has-cover` gates the
    // Remove button.
    in-out property <image> cover;
    in property <bool> has-cover;
    in property <bool> lyrics-enabled;

    // Read-only Summary strings (single selection only), preformatted by Rust.
    in property <string> summary-path;
    in property <string> summary-codec;
    in property <string> summary-bitrate;
    in property <string> summary-sample-rate;
    in property <string> summary-bit-depth;
    in property <string> summary-channels;
    in property <string> summary-size;
    in property <string> summary-duration;
    in property <string> summary-modified;
    in property <string> summary-hash;

    // Entry point — fetch + populate + open the dialog (Rust-driven).
    callback request-edit([int] /*track ids*/);
    // Artwork picker (rfd on the UI thread) / clear the embedded cover.
    callback pick-artwork();
    callback remove-artwork();
    // Fired by the `Dialog.accepted` dispatcher — diff, build `TagEdit`, write.
    callback commit();
}

// Nav: UI-only, no Rust subscription needed in Phase 2.
//   0=search, 1=browse,
//   2=favorites, 3=tracks, 4=albums, 5=artists, 6=genres, 7=playlists,
//   8=settings
export global Nav {
    in-out property <int> selected-index: 3;
    // True while the full-screen Now Playing view replaces the main content
    // area. Opened by clicking the track-info card in the now-playing bar;
    // closed by the view's back button or by any sidebar item click (the
    // sidebar resets it alongside `selected-index`). The content panel in
    // `app-window.slint` renders `NowPlayingView` when this is true and
    // gates the regular view branches on `!now-playing-open`.
    in-out property <bool> now-playing-open: false;
    // Mirror of `now-playing-open` into Rust (`src/ui/now_playing.rs`).
    // The Up Next subscriber skips its ~20-row rebuild while the view is
    // closed (the rows aren't on screen) and rebuilds once on open. Slint
    // globals can't have `changed` handlers on their own properties
    // (CLAUDE.md "changed doesn't accept path expressions on globals"), so
    // `AppWindow` mirrors `now-playing-open` into a local property and
    // watches that — the changed handler invokes this synchronously.
    callback now-playing-open-changed(bool);
    // Fire after the user clicks a sidebar item (the SidebarItem TouchArea
    // invokes this right after assigning `selected-index`). Rust persists
    // the new index into `settings.last_nav_index` so the next launch
    // reopens on the same section. Wired in `src/ui/callbacks.rs`.
    callback persist-selected-index(int);
    // Right-click "Open Containing Folder" on any track row. Carries the
    // track id; Rust (`callbacks::wire_all`) resolves the file path from
    // the DB and hands the parent directory to the OS file manager via
    // the `open` crate. View-independent — every track-list context menu
    // calls this single global directly, with no per-view plumbing (vs
    // the `go-to-*` cross-tab callbacks, which need per-view origin
    // context and are therefore duplicated across the view globals).
    callback reveal-in-folder(int /*track_id*/);
    // Direction for the next ViewTransition mount. Sidebar lateral nav
    // resets to `below`; opening a detail sets `right`; the detail back
    // button sets `left`. Written synchronously on the UI thread immediately
    // before the property flip (`selected-index` or `*Detail.*-id`) that
    // triggers the new mount. Typed (not string) so Rust typos are
    // caught at compile time — see `NavEnterFrom` at the top of this file
    // and the `mark_*` helpers in `src/ui/nav_transition.rs`.
    in-out property <NavEnterFrom> pending-enter-from: NavEnterFrom.below;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <length> sidebar-width: 180px;
    // Set by the Sidebar's resize handle while the user is dragging the
    // right edge. Read by `SidebarItem` and the Collapse-toggle row to
    // disable the `padding-left` animation during a drag — without this
    // every mouse move kicks off a fresh `Theme.dur-med` ease, making the
    // icons visibly lag the sidebar's edge. Same pattern the Sidebar
    // already uses to gate its own `width` animation.
    in-out property <bool> sidebar-dragging: false;
}

// CompositeScroll: bridges the winit `MouseWheel` filter
// (`src/ui/window_chrome/winit_filter.rs`) to whichever *composite* view is
// currently mounted — Favorites, Recently Played, Artist Detail, Browse. Those
// views wrap a strip section + a height-capped (virtualized) `TrackList` in a
// single outer `below-sv := ScrollView`. Slint's inner `ListView` swallows the
// vertical wheel at its scroll edge instead of bubbling to `below-sv` (verified
// in `i-slint-core` `flickable.rs::process_wheel_event`), so the strips/hero
// can't be wheeled back once scrolled away. Fixing this in pure Slint is
// impossible without breaking row clicks (a wrapping TouchArea forwards the
// wheel to the ListView first; an overlay one grabs presses), so the winit
// layer intercepts vertical-dominant wheel over the region and drives the
// existing composite scroll math here. The height cap — and thus
// virtualization — is left completely untouched.
export global CompositeScroll {
    // Set true by the mounted composite view's hover sentinel while the cursor
    // is over its below-hero scroll region. Reset to false on any content-view
    // switch (see `app-window.slint`) so a view unmounting mid-hover can't
    // leave the flag stuck. The winit filter reads it to decide whether to take
    // over the wheel or let Slint scroll natively (sidebar, other views).
    in-out property <bool> hovered: false;
    // Accumulated wheel delta in Slint logical px, +y = scroll up (matches
    // `flickable.rs`'s sign: `viewport-y += delta`). Rust *adds* the event delta
    // then bumps `wheel-tick`; the mounted view's `CompositeScrollbars` instance
    // (`ui/components/composite-scrollbars.slint` — the shared vbar/hbar +
    // wheel-routing component every composite view mounts) mirrors the tick,
    // applies one composite scroll step, and zeroes `wheel-dy`. Accumulating
    // (rather than overwriting) survives Slint coalescing several wheel events
    // into one `changed wheel-tick` firing — no delta is dropped on fast flicks.
    in-out property <length> wheel-dy: 0px;
    in-out property <int> wheel-tick: 0;
}

// MiniPlayer: drives the compact miniplayer that replaces the full UI when
// the OS window is shrunk past a threshold. Tauri parity: enter when
// `width < 550px || height < 250px`, pick the `square` variant when
// `height >= width * 0.8`. Source of truth is the live window size — both
// `active` and `square` are written from `AppWindow`'s derived
// `mini-active`/`mini-square` root properties via mirror+changed handlers.
//
// Entry AND exit are resize-only — there are no in-UI buttons. Rust hooks
// `active-changed(bool)` to flip the Up Next subscriber gate and manage
// the high-res cover cache; `square-changed(bool)` fires when the
// variant flips between rectangle and square while already in
// mini-active, so Rust can seed (or release) the high-res cover cache
// that only the square variant uses.
export global MiniPlayer {
    in-out property <bool> active: false;
    in-out property <bool> square: false;
    callback active-changed(bool);
    callback square-changed(bool);
}

// Shared lazy cover lookup for every `TrackListRowItem` thumbnail (Tracks,
// Browse, Favorites, Search, Album/Artist/Genre/Playlist detail, and the
// draggable playlist variant — they all render the same row component).
// One global instead of per-view forwarding: Rust wires it once to the
// shared row-tier (72 px) `CoverThumbs` LRU. Rows carry only
// `artwork_path`; the decode (or LRU hit) happens here, per *instantiated*
// row — virtualized lists pay for ~visible rows only, and model rows no
// longer pin pixel buffers the LRU already evicted.
export global RowCovers {
    pure callback request(string /*artwork_path*/) -> image;
}

// Tracks: drives the Tracks view. The `rows` model is owned by Rust
// (`Rc<VecModel<TrackListRow>>` in `src/ui/tracks.rs`) and pushed in via
// `set_rows(ModelRc::from(...))`. The full unfiltered Vec lives on the Rust
// side too; `apply-filter` re-derives `rows` without hitting the DB,
// `request-sort` does hit the DB.
export global Tracks {
    in-out property <[TrackListRow]> rows;
    in-out property <int> total-count;       // pre-filter count
    in-out property <string> filter;
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // Per-column visible widths, edited by the resize handles. ALL columns
    // are fixed-width — the table is the GTK-TreeView "FIXED" model: each
    // column is independently resizable, and when the cumulative width
    // exceeds the container a horizontal scrollbar appears (matches
    // Audacious / foobar2000 / file-manager conventions). The user
    // specifically asked for this over the Tauri flex-with-cap model.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Per-column visibility (Tauri parity). `title` and `length` are not
    // toggleable. `show-artwork` is a pseudo-toggle that controls only the
    // small thumbnail inside the title cell, not the cell itself. Hydrated
    // from `settings.view_columns["tracks"]` at startup; mutated by the
    // column-toggle popup which then persists via `Tracks.toggle-column`.
    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    callback request-sort(string /*field*/);
    callback apply-filter(string);
    callback play-row(int /*track_id*/, int /*index_in_filtered*/);
    callback play-all();
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback request-refresh();
    // Mirrors "the Tracks section is on screen" — see `watched-tracks-active`
    // in app-window.slint. Rust uses it to skip `library_changed` refreshes
    // while the view is hidden and run one deferred re-fetch on re-enter.
    callback section-active-changed(bool);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // 3.G — selection. Modifier keys are read from the row's pointer-event
    // and forwarded as bools (Slint can't easily iterate models inside
    // expressions, so the heavy lifting happens in Rust which then walks
    // the VecModel to flip per-row `selected` flags).
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();

    // Column-visibility toggle: Slint flips the matching `show-*` property
    // synchronously, then Rust persists the new visible-column list to
    // `settings.view_columns["tracks"]` so it survives restarts.
    callback toggle-column(string /*column_id*/);

    // Bumped by anything in the tracks view that should make the filter
    // input give up keyboard focus — row clicks, action-pill clicks, body
    // backdrop. Slint globals can't bind callbacks inline, so the SearchBar
    // observes a counter via a `changed` handler instead.
    in-out property <int> blur-search-tick: 0;
}

// Browse: drives the Browse view. The three list models
// (`folders`, `rows`, `breadcrumbs`) are owned by Rust
// (`Rc<VecModel<_>>` in `src/ui/browse.rs`) and pushed in once at
// startup via `install_browse_models`; `BrowseUi::fetch_and_apply`
// mutates the existing VecModels in place on every navigation.
//
// `rows` is rendered by the shared `TrackList` component (the same one
// the Tracks view uses), so the column-width / column-visibility / sort
// / selection shape mirrors the `Tracks` global. Disk-only audio files
// (present on disk inside a library folder but not in the DB) arrive as
// `TrackListRow`s with `id == 0` and `enabled == false` — they render
// dimmed and non-interactive.
//
// `current-path == ""` is the special root state: instead of calling
// `library::browse::browse_directory` (which would reject an empty
// path), Rust fetches the library folder list via
// `library::settings::get_folders` and renders them as drillable folder
// rows. `has-library-folders` flips false when that list is empty so
// the view paints a "No music folders configured" CTA.
//
// `loading` is a single bool — the fetch is fast enough that a spinner
// isn't always needed, but the view gates the "Empty folder" empty-state
// on `!loading` so a stale "Empty" message doesn't flash during a
// drill-down. `error-message` is empty in the happy path; non-empty
// when `browse_directory` returns Err (folder deleted, permission
// denied, …) — the view shows it instead of folder/track rows.
//
// `can-go-back` is owned by Rust (it mirrors the back-stack length);
// the back button binds to it for `enabled:`.
export global Browse {
    in-out property <string> current-path;             // "" = root (library list)
    in-out property <[BrowseFolderRow]> folders;
    in-out property <[TrackListRow]> rows;
    in-out property <[BreadcrumbRow]> breadcrumbs;
    in-out property <bool> loading;
    in-out property <bool> can-go-back;
    in-out property <string> error-message;            // "" = no error
    in-out property <bool> has-library-folders;        // false → root empty-state CTA
    // True when at least one row in `rows` is in the library — gates the
    // Play All / Shuffle All chips so they don't appear in folders that
    // contain only disk-only audio files (which can't be queued). Rust
    // writes it after every fetch.
    in-out property <bool> has-playable-files;

    // Per-column state — separate from the `Tracks` global so Browse keeps
    // its own column layout (mirrors old Tauri's `viewId="browse"`).
    // Hydrated from `settings.view_column_widths["browse"]` /
    // `view_columns["browse"]` at startup, snapshotted back on shutdown.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sort state. Browse sorts in-memory in Rust (it mixes disk-only +
    // DB files, so it can't re-query the DB like the Tracks view does).
    in-out property <string> sort-field: "title";
    in-out property <string> sort-dir: "asc";

    // Selection — same shape as the `Tracks` global. Disk-only rows
    // (`id == 0`) are never selectable; the Rust `select-row` handler
    // ignores them.
    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    callback open-folder(string /*path*/);
    callback go-back();
    callback navigate-to(string /*absolute-path*/);    // breadcrumb segment click
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int] /*track_ids*/);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new_state*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback play-all();
    callback refresh();
    // Mirrors "the Browse section is on screen" — see `watched-browse-active`
    // in app-window.slint. Rust uses it to skip `library_changed` re-fetches
    // while the view is hidden and run one deferred re-fetch on re-enter.
    callback section-active-changed(bool);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
}

// LibrarySettings: drives the Library Folders section of Settings. The
// `folders` model is owned by Rust (`Rc<VecModel<FolderListRow>>` rebuilt
// on each refresh in `src/ui/library_settings.rs`) and pushed in via
// `set_folders(ModelRc::from(...))`. Scan-progress fields are patched by a
// `slint::spawn_local` subscriber on `state.scan_progress_tx`.
export global LibrarySettings {
    in-out property <[FolderListRow]> folders;
    in-out property <bool> scanning;
    in-out property <float> scan-progress;
    in-out property <int> scanned-count;
    in-out property <int> total-count;
    in-out property <string> scanning-file;

    callback add-folder();
    callback remove-folder(int /*id*/);
    callback rescan-folder(int /*id*/);
}

// WindowChrome: actions and state for the custom titlebar. Owned by Rust
// (`src/ui/window_chrome.rs`); Slint is the dumb renderer. `is-maximized`
// is fed from a winit `WindowEvent::Resized` subscription so the
// maximize/restore icon stays correct under Win+↑ / window-tile shortcuts
// that bypass our buttons.
//
// Window dragging is **not** handled inside Slint. Calling winit's
// `drag_window()` from a `TouchArea`'s `pointer-event` would leak the
// grab: on Wayland the compositor takes pointer ownership for
// `xdg_toplevel.move`, on X11 winit's docs say it un-grabs the cursor,
// and on macOS the release event may not arrive. Slint's TouchArea
// returns `GrabMouse` on Pressed and never sees the matching Released,
// so it stays "pressed" forever — every subsequent click in the window
// is routed back to the orphaned TouchArea and triggers another drag.
// Instead, Rust intercepts `WindowEvent::MouseInput { Pressed, Left }`
// at the winit layer (mirroring how Slint's own resize-border handler
// works in `i-slint-backend-winit::event_loop`) and returns
// `EventResult::PreventDefault` so the press never reaches Slint —
// the TouchArea grab is never engaged. The Slint side only reports
// hover state via `drag-region-hover-changed` so Rust knows when the
// cursor is over the draggable area.
//
// `restart-app` is invoked by the `Dialog` router when the user confirms
// the native-titlebar toggle: persists the new value via
// `library::window::set_use_native_titlebar` (using the `target-id` left
// in `Dialog`) and respawns the binary (Slint reads `no-frame` only at
// first window show — runtime toggling requires a fresh process).
// `restart-tray` mirrors it for the "System Tray Icon" toggle: persists
// `tray.enabled` via `library::window::set_tray_enabled` and respawns, so
// the startup gate in `main.rs` either runs or skips the tray subsystem.
export global WindowChrome {
    in property <bool> is-maximized;

    // Always-on-top. `supported` is hydrated once at install from the
    // cached `AlwaysOnTopCapability`; the pin button is gated on it so
    // bare-Wayland / GNOME-without-window-calls users don't see a
    // non-functional control. `active` mirrors the persisted state and
    // is also written optimistically on click so the icon and tooltip
    // flip instantly — Rust reverts it via `upgrade_in_event_loop` if
    // the backend call fails.
    in property <bool> always-on-top-supported;
    in-out property <bool> always-on-top-active;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback toggle-always-on-top();
    // Slint-side hover notification for the titlebar drag area. Rust
    // mirrors this into an atomic that the winit `MouseInput` filter
    // checks before deciding to start an OS-level window move.
    callback drag-region-hover-changed(bool);
    callback restart-app();
    callback restart-tray();
}

// Queue: drives the bottom-sheet queue inspector. The `rows` model is
// owned by Rust (`Rc<VecModel<QueueRow>>` in `src/ui/queue_sheet.rs`)
// and pushed in via `set_rows(ModelRc::from(...))`. Rust subscribes to
// the same `sinks.queue` watch as `Player.queue` and writes both row
// data and `current-index` on every queue mutation.
//
// Drag-and-drop note: Slint 1.16 has no native DnD API (verified
// against v1.16.1 Cargo features). The plumbing here is bespoke —
// `drag-source` is the play-order index currently being dragged (-1
// when idle), `drop-index` is the candidate insertion slot (-1 when
// idle). The sheet flips these from row-level `TouchArea.pointer-event`
// handlers and only fires `reorder(from, to)` on pointer-up commit.
// Visual feedback (insertion line, dimmed source row) reads from
// these props directly, so no Rust round-trip happens during the drag.
//
// File-drop: `open` is mirrored to a Rust `Arc<AtomicBool>` via the
// `open-changed` callback. The winit `WindowEvent::DroppedFile` filter
// consults that atomic to decide whether to forward dropped file paths
// to `library::queue::queue_import_files`. Slint globals can't have
// `changed` handlers on their own properties (CLAUDE.md "changed
// doesn't accept path expressions on globals"), so the QueueSheet
// component mirrors `Queue.open` into a local property and watches
// that — the changed handler invokes `open-changed` synchronously.
//
// Defined above `Dialog` so the `Dialog.accepted` dispatcher can
// reference `Queue.clear-queue()` without a forward-reference.
export global Queue {
    in-out property <[QueueRow]> rows;
    // -1 when nothing is playing; otherwise the play-order index of the
    // currently-playing track. Rows compute `playing: idx == current-index`
    // reactively so the highlight flips without a model rewrite.
    in property <int> current-index: -1;
    // Rust-maintained count of rows where `selected: true`. Slint
    // expressions can't iterate a model, so the sheet's header uses
    // this to swap "Clear queue" ↔ "Remove selected (N)" without
    // walking `rows` per render. Written by every selection callback
    // (toggle / clear / select_all) and on every queue rebuild.
    in property <int> selected-count: 0;
    // Sheet open / closed. Animations in `QueueSheet` read this through
    // an animated `t` property; the close animation needs the overlay
    // mounted past `open == false`, so the component never gates on
    // `if Queue.open: …` — it stays in the tree and fades.
    in-out property <bool> open;
    // -1 when idle, else the play-order index being dragged.
    in-out property <int> drag-source: -1;
    // Slot the dragged row would land in, range `[0, rows.length]`
    // inclusive on both ends. Slot K is the gap between rows K-1 and
    // K: slot 0 = before first row, slot rows.length = after last
    // row. -1 means no active drop candidate (drag has not yet
    // crossed the click threshold, or no drag in progress).
    //
    // Slot semantics (not row-index semantics) so the insertion-line
    // visualisation matches Tauri's `.dragAbove` / `.dragBelow`
    // box-shadows: the indicator marks the GAP between rows, derived
    // from whether the cursor is in the upper or lower half of the
    // row beneath it. With this, "drop right above source" and
    // "drop right below source" become clearly no-op slots that the
    // sheet hides — fixing the earlier confusion of "I'm dragging
    // and the line is below the song I'm still seeing."
    in-out property <int> drop-slot: -1;
    // Mirrored from Rust during an OS file-hover so the sheet can paint
    // a "Drop to add to queue" banner. Set on
    // `WindowEvent::HoveredFile`, cleared on `HoveredFileCancelled` and
    // on every `DroppedFile`. Gated in markup on
    // `is-drop-hovered && open` so the banner only paints when the
    // sheet is also the active drop target. (Wayland support depends
    // on the vendored winit patch — see `Cargo.toml`'s
    // `[patch.crates-io]` block.)
    in property <bool> is-drop-hovered: false;

    // Reorder commit. Fires on pointer-up only if the drag passed the
    // 4 px click threshold. Rust dispatches to
    // `library::queue::queue_move(from, to)`.
    callback reorder(int /*from*/, int /*to*/);
    callback remove(int /*play_order_index*/);
    // Reads the `selected` bit from the Rust-side shadow to compute the
    // batch indices.
    callback remove-selected();
    callback skip-to(int /*play_order_index*/);
    callback clear-queue();
    // No-op hook for future close-side effects (e.g. clearing selection
    // on close). Kept so the sheet can `Queue.close()` without coupling
    // to the open-changed atomic.
    callback close();
    // Modifier-aware single-row click: plain replaces, ctrl toggles,
    // shift extends. Anchor lives in Rust.
    callback toggle-select(int /*idx*/, bool /*ctrl*/, bool /*shift*/);
    callback clear-selection();
    callback select-all();

    // Hover-swap favorite toggle from a queue row's duration cell.
    // Mirrors the `Tracks.toggle-row-favorite` contract: Rust persists
    // to DB, flips in-memory `is_favorite` on the matching queue track
    // (and current_track if it's the same id), and re-emits via
    // `sinks.queue` so the subscriber rebuilds the row with the new
    // bit.
    callback toggle-row-favorite(int /*id*/, bool /*new*/);

    // Mirror of `open` into Rust so the winit DroppedFile filter knows
    // whether to forward dropped paths to the queue.
    callback open-changed(bool);
}

// Playlists: drives the Playlist grid view. Same ownership + filter /
// chunk contract as `Albums` / `Artists` (Rust owns the flat list;
// `apply-filter` re-derives `grid-rows` without a DB hit), one row of
// state per playlist. The grid is sorted by most-recently-updated
// (`sort-field` / `sort-dir` defaults below) and stays that way — the
// view exposes no sort UI. Defined above `Dialog` so the
// `Dialog.accepted` dispatcher can reference `Playlists.create-playlist`
// etc. without a forward-reference, mirroring the `Queue` placement.
//
// `rows` is the flat list used by the Add-to-Playlist submenu shown on
// every track row's overflow menu — kept in sync with `grid-rows` so the
// submenu always lists every playlist by name in display order.
//
// `request-cover` is bound to the Rust `playlist_grid_cover` lookup
// (`PlaylistsUi::grid_cover`), which resolves the playlist's
// `artwork_path` against a private grid-tier `CoverThumbs`. Same lazy
// pattern as `Albums.request-cover` — only on-screen cards decode.
export global Playlists {
    in-out property <[PlaylistGridRow]> grid-rows;
    // Flat list used by the Add-to-Playlist submenu mounted on every
    // track row's overflow menu. Owned by Rust; rebuilt whenever the
    // canonical playlist list changes.
    in-out property <[PlaylistRow]> rows;
    in-out property <int> total-count;          // pre-filter playlist count
    in-out property <int> columns: 4;           // view-computed; always >= 1
    in-out property <string> filter;
    in-out property <string> sort-field: "updated"; // "name" | "track_count" | "updated"
    in-out property <string> sort-dir: "desc";
    in-out property <int> blur-search-tick: 0;

    callback columns-changed(int);
    callback apply-filter(string);
    callback open-playlist(int /*playlist_id*/);
    // Lazy per-card cover lookup, same contract as `Albums.request-cover`.
    pure callback request-cover(string /*artwork_path*/) -> image;
    // Row-tier (72 px) cover lookup — backs the small artwork tiles
    // inside the mosaic-picker dialog (64 px candidate tiles + preview).
    // Resolves against the shared `cover_thumbs` LRU instead of the
    // grid-tier 448 px tier so we don't pay for full-size decodes for
    // tiny dialog tiles.
    pure callback request-row-cover(string /*artwork_path*/) -> image;
    callback section-active-changed(bool);

    // CRUD entry points — fired by the `Dialog.accepted` dispatcher
    // once the user confirms. The dialogs themselves are populated
    // inline in Slint markup (mirroring the `queue-sheet` /
    // `library-section` pattern) instead of via Rust callbacks —
    // synchronous Rust→`set_open(true)` writes inside a click handler
    // trip Slint's property-recursion guard.
    callback create-playlist(
        string /*name*/,
        string /*description (empty ⇒ no description)*/,
        [int] /*pending_track_ids*/,
    );
    callback rename-playlist(
        int /*id*/,
        string /*new_name*/,
        string /*description (empty ⇒ clear)*/,
    );
    callback delete-playlist(int /*id*/);

    // Apply 1-4 mosaic tile artworks (paths drawn from the playlist's own
    // tracks) — Rust composes a 600x600 collage and persists. Empty
    // selection clears the custom thumbnail and reverts to the
    // auto/first-track behaviour.
    callback apply-mosaic(int /*id*/, [string] /*paths*/);
    callback clear-artwork(int /*id*/);

    // Add-to-Playlist picker row interactions — Rust mutates the VecModel
    // (`set_row_data`) since Slint can't push/remove ergonomically.
    // `toggle-add-pick` no-ops on disabled (fully-contained) rows;
    // `set-all-add-picks` only flips the enabled rows.
    callback toggle-add-pick(int /*playlist_id*/);
    callback set-all-add-picks(bool /*selected*/);

    // Fired by the `Dialog.accepted` dispatcher on Add. Rust reads the
    // selected (enabled) rows off `Dialog.playlist-pick-rows` and adds
    // `Dialog.pending-track-ids` into each, then toasts a summary.
    callback add-tracks-to-selected();

    // Toggle a candidate artwork path in `Dialog.mosaic-selection`.
    // Rust handles the array mutation (Slint can't `push` / `remove`
    // ergonomically; pure functions can't iterate). Caps the selection
    // at 4 and silently no-ops past that. Used by the mosaic picker
    // body inside `DialogOverlay`.
    callback toggle-mosaic-candidate(string /*artwork_path*/);

    // Per-row name / description lookups — used by the grid card's
    // hover-revealed "Rename" overlay, which only carries the playlist
    // id (the `PlaylistGridRow` doesn't include description). Resolved
    // from the cached `PlaylistStats` list on the Rust side — no DB
    // hop, no async, safe to call from the Slint click handler.
    pure callback row-name(int /*playlist_id*/) -> string;
    pure callback row-description(int /*playlist_id*/) -> string;

    // Variant of `PlaylistDetail.request-edit-artwork` that targets an
    // explicit playlist id (not the open detail). Used by the grid
    // card's "Edit artwork" overlay — the detail view isn't necessarily
    // open when the user clicks it. Rust seeds the dialog's preview
    // image inline (the open-detail flow's `PlaylistDetail.cover` is
    // stale or empty for any other playlist).
    callback request-edit-artwork-for(int /*playlist_id*/);

    // Open the Add-to-Playlist picker dialog. Fired by the track row
    // context menu's `Add to Playlist` entry. Rust runs two short
    // queries in parallel (full playlist list + per-playlist overlap
    // counts for the selection), writes `Dialog.playlist-pick-rows`,
    // then flips `Dialog.open = true` — so the dialog appears already
    // populated. `exclude-playlist-id >= 0` filters that playlist out
    // (used on the Playlist Detail view so the open playlist isn't
    // offered as a target); `-1` shows all.
    callback request-add-to-playlist(
        [int] /*track_ids*/,
        int /*exclude_playlist_id*/,
    );

    // --- Import / export to M3U8 files ---------------------------------
    // Header-pill actions on the Playlists view. Both are pure Rust flows
    // (native rfd dialogs), so — unlike the create/rename dialogs — they
    // don't write `Dialog.*` synchronously from the click handler and so
    // don't risk Slint's property-recursion guard.

    // Open a native multi-file picker (.m3u8/.m3u), import each into a new
    // playlist, then toast a summary.
    callback import-playlists();

    // Open the Export picker dialog. Rust fetches all playlists, fills
    // `Dialog.export-pick-rows` (none selected — the user opts in), then
    // flips `Dialog.open = true` with `kind == "export-playlists"` — same
    // populate-then-open shape as `request-add-to-playlist`.
    callback request-export-playlists();

    // Fired by the `Dialog.accepted` dispatcher on Export. Rust reads the
    // selected rows off `Dialog.export-pick-rows`, opens a folder picker,
    // writes one `.m3u8` per selected playlist, and toasts.
    callback export-selected-playlists();

    // Export-picker row interactions — Rust mutates the VecModel
    // (`set_row_data`) since Slint can't push/remove ergonomically.
    callback toggle-export-pick(int /*playlist_id*/);
    callback set-all-export-picks(bool /*selected*/);
}

// PlaylistDetail: drives the full Playlist Detail view. `playlist-id ==
// -1` ⇒ the grid is shown; `>= 0` ⇒ `PlaylistDetailView` replaces it
// (mirrors the `Nav.now-playing-open` swap in `app-window.slint`).
// `tracks` is owned by Rust (`Rc<VecModel<TrackListRow>>` in
// `src/ui/playlists.rs`); `playlist` carries the header data.
//
// The track table is the shared `TrackList` component, so the
// column-width / visibility / sort / selection shape mirrors the
// `Tracks` / `Browse` / `AlbumDetail` globals — with its own persistence
// key `"playlist_detail"`. Default sort is `"position"` (the persisted
// insertion order); drag-to-reorder is gated to that sort field.
//
// `drag-source` / `drop-slot` mirror the `Queue` global's reorder state
// — the shared `TrackList` component reads these when `enable-drag` is
// true (only inside Playlist Detail today) to paint the drop indicator
// and dim the source row. `reorder(from, to)` fires on pointer-up.
//
// `is-drop-hovered` mirrors `Queue.is-drop-hovered` — set by the winit
// HoveredFile filter when the Playlist Detail is the active drop target
// (Queue Sheet closed, detail open). The view paints a "Drop to add"
// banner gated on `is-drop-hovered && playlist-id >= 0`.
export global PlaylistDetail {
    in-out property <int> playlist-id: -1;
    in-out property <PlaylistRow> playlist;
    in-out property <[TrackListRow]> tracks;

    // Filter needle for the hero SearchBar. Filters the `tracks`
    // `DraggableTrackList` (title + artist + album substring); drag
    // reorder is disabled while a needle is active. Cleared on
    // fresh-open (`open_playlist`); preserved across library-changed
    // refreshes so a user-typed needle survives a scan finishing.
    in-out property <string> filter;
    in-out property <int>    blur-search-tick: 0;

    // Per-column widths, edited by the resize handles.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Per-column visibility. Hydrated from `settings.view_columns["playlist_detail"]`.
    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sort state. Default `"position"` keeps the user's insertion /
    // drag-reorder order. Drag-to-reorder is disabled (in the
    // TrackList markup) whenever sort-field is anything else.
    in-out property <string> sort-field: "position";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // Header cover + hero-blur cross-fade slots — same dual-slot
    // contract as `AlbumDetail` so switching playlists never flashes.
    in-out property <image> cover;
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Drag-reorder state — read by the shared `TrackList` component
    // when `enable-drag: true` is set on it (only by this view).
    // Semantics mirror `Queue.drag-source` / `Queue.drop-slot`: -1 when
    // idle; otherwise a 0-based track index / 0..=length insertion slot.
    in-out property <int> drag-source: -1;
    in-out property <int> drop-slot: -1;

    // Mirrored from Rust during an OS file-hover so the detail can paint
    // a "Drop files to add" banner. Set on `WindowEvent::HoveredFile`
    // *only* when the Queue Sheet is closed and this detail is open
    // (queue takes priority); cleared on cancel / drop. The shared
    // winit DnD pipeline reuses the existing coalescer infrastructure.
    in property <bool> is-drop-hovered: false;

    callback close-detail();
    callback play-all();
    callback shuffle-all();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Drag-reorder commit. Fires on pointer-up only if the drag passed
    // the 4 px click threshold AND sort-field == "position". Rust
    // dispatches to `library::playlists::reorder_playlist(from, to)`.
    callback reorder(int /*from*/, int /*to*/);

    // Edit-artwork opens the mosaic picker — Rust hop required to
    // fetch the playlist's track artworks (DB query) before the dialog
    // mounts. The Rust handler writes Dialog via
    // `upgrade_in_event_loop`, which lands on a fresh event-loop tick
    // (safe). Rename / Delete populate the Dialog inline in the
    // playlist-detail-view markup — no callback needed.
    callback request-edit-artwork();

    // Batch / single remove-from-playlist. The header "Remove selected"
    // pill calls `remove-selected()` (which reads `selected-ids`); the
    // row context menu's "Remove from Playlist" entry calls
    // `remove-track(ids)` with either the single right-clicked row or
    // the entire `selected-ids` set (multi-select mode).
    callback remove-selected();
    callback remove-track([int] /*track_ids*/);

    // Filter keystroke — Rust re-walks the cached tracks through the
    // new needle and pushes a filtered Slint model. In-memory walk,
    // no DB round-trip. Mirrors `ArtistDetail.filter-changed`.
    callback filter-changed(string);
}

// Dialog: a single root-level overlay used for both info ("OK"-only) and
// confirmation (Cancel + Confirm, optionally destructive) modals. Strategy:
//   - mounted as a `DialogOverlay` sibling at the root of
//     `app-window.slint`; it's a `Window` child, not a `VerticalLayout`
//     child, so it doesn't steal stretch from the main layout
//   - always rendered (not gated by `if Dialog.open`) so the close
//     animation can play after `open` flips back to false. A single
//     `t: float` (0 → 1) drives backdrop alpha; the card derives a faster
//     `card-t = min(1, t * 1.5)` so its small-area fade keeps perceptual
//     pace with the backdrop's large-area dim. Both are plain derivations
//     — no per-property `animate` blocks (avoids the CLAUDE.md "animating
//     bindings derived from another animating property phase-lags" pitfall)
//   - input-safety: backdrop `TouchArea` is `enabled: Dialog.open` so
//     closed-state pointer events fall through, and the card has
//     `visible: t > 0.01` so a stale click can't hit a button mid-fade
//   - single source of truth: callers set title/message/labels/destructive
//     + a routing payload (`kind` + `target-id`) and flip `open`. The
//     default `accepted` handler on this global reads `kind` and forwards
//     to the matching backend action — keeps the confirmation flow
//     declarative inside Slint with no boxed closures retained on the
//     Rust side between open and confirm
//   - info-only mode: leave `cancel-label` empty; the Cancel button drops
//     out of the layout tree (conditional element form, not `visible: false`)
//     so the primary button stays flush right
export global Dialog {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> confirm-label: "OK";
    // Empty string ⇒ single-button info dialog (no Cancel rendered).
    in-out property <string> cancel-label;
    // When true, the primary (confirm) button uses `Theme.danger` /
    // `Theme.danger-text` instead of accent colours. Mirrors Tauri's
    // `ConfirmDialog` `danger` flag.
    in-out property <bool> destructive;

    // Routing payload — populated by the caller before flipping `open`,
    // consumed by the default `accepted` handler below. `kind`
    // discriminates the action (e.g. "remove-folder"); `target-id`
    // carries the entity id (e.g. folder id). Plain primitives, no
    // allocation.
    in-out property <string> kind;
    in-out property <int> target-id: -1;

    // Free-text input for dialog kinds that prompt the user for a string —
    // currently `"create-playlist"` and `"rename-playlist"`. `input-text`
    // is the primary field (playlist name); `input-text-2` is the
    // secondary optional field (playlist description). Both are
    // two-way-bound to `LabeledInput`s in the dialog body, read by the
    // dispatcher, and cleared (alongside `kind` / `target-id`) once the
    // dispatcher runs so stale values can't leak into the next dialog.
    in-out property <string> input-text;
    in-out property <string> input-text-2;

    // Ordered list of artwork paths the user has picked inside the
    // mosaic-picker dialog (`"edit-playlist-artwork"` kind). Selection is
    // 1-4 entries; an empty list means "Clear artwork → revert to auto
    // (first-track) thumbnail". The dispatcher hands these off to
    // `Playlists.apply-mosaic` / `Playlists.clear-artwork` on accept.
    in-out property <[string]> mosaic-selection;

    // Candidates pool the mosaic picker offers — the playlist's own
    // track artwork paths (deduplicated, in playlist position order)
    // returned by `library::playlists::get_playlist_artwork_paths`.
    // Rust populates this before opening the dialog; the picker
    // iterates it to render the candidate tile grid.
    in-out property <[string]> mosaic-candidates;

    // Current saved artwork for the playlist whose mosaic is being
    // edited. Populated by Rust at dialog-open (from `PlaylistDetail.cover`
    // when the detail view is open for this id, or via a fresh sync
    // lookup against the grid-tier LRU when opened from a card overlay).
    // The picker shows this as its initial preview so the dialog opens
    // on "what your artwork looks like now" instead of an empty
    // placeholder.
    in-out property <image> current-artwork;

    // Tracks whether the user has touched the picker since the dialog
    // opened — flipped to true by `Playlists.toggle-mosaic-candidate`
    // (any toggle, including toggling the last one off) and by the
    // Clear button. The preview uses it to switch from "current saved
    // artwork" (untouched) to "what would be saved if Apply is clicked
    // now" (mosaic preview or empty placeholder). The Apply dispatcher
    // uses it as a guard: empty selection + not touched = no-op (don't
    // silently wipe a playlist's artwork when the user opens the dialog
    // and immediately confirms).
    in-out property <bool> mosaic-touched;

    // Pending track ids stashed when the user picks "New Playlist…" from
    // a track row's Add-to-Playlist submenu. The Create dialog reads this
    // after the new playlist is created so it can immediately add the
    // tracks. Empty list ⇒ a plain Create (no auto-add). Cleared on
    // dispatch.
    //
    // Also reused by the `"add-to-playlist"` picker dialog as the canonical
    // list of tracks being added — the Add dispatcher adds these into every
    // selected playlist via `Playlists.add-tracks-to-selected()`.
    in-out property <[int]> pending-track-ids;

    // Rows shown inside the Add-to-Playlist picker (`kind ==
    // "add-to-playlist"`). Populated on the Rust side by
    // `on_request_add_to_playlist` once `library::playlists::get_playlists`
    // + `count_tracks_in_playlists_for_selection` resolve, then `open` is
    // flipped — so the dialog opens already populated (mirrors the
    // `request-edit-artwork` flow). The picker is multi-select: `add-select-all`
    // mirrors the header "Select all" checkbox and `add-selected-count` is
    // maintained by Rust on every toggle (counting only enabled rows) so the
    // footer's Add button can disable when nothing is selected without
    // iterating the model in Slint. All three cleared in `closed` below.
    in-out property <[PlaylistPickRow]> playlist-pick-rows;
    in-out property <bool> add-select-all: false;
    in-out property <int> add-selected-count: 0;

    // Rows shown inside the Export-playlists picker (`kind ==
    // "export-playlists"`). Populated by Rust's `on_request_export_playlists`
    // (all `selected: false` — the user opts in) before `open` is flipped.
    // `export-select-all`
    // mirrors the header "Select all" checkbox; `export-selected-count` is
    // maintained by Rust on every toggle so the footer's Export button can
    // disable when nothing is selected without iterating the model in Slint.
    // All three cleared in `closed` below.
    in-out property <[PlaylistExportPickRow]> export-pick-rows;
    in-out property <bool> export-select-all: false;
    in-out property <int> export-selected-count: 0;

    // Size of `pending-track-ids` at the moment the picker was opened —
    // cached so picker rows can derive `disabled` (`contained-count >=
    // pick-total-tracks`) without re-evaluating `pending-track-ids.length`
    // per row. Cleared on close.
    in-out property <int> pick-total-tracks;

    callback accepted();
    callback cancelled();

    // Default handlers live on the global itself — Slint won't accept
    // `Dialog.accepted => { … }` at component scope, but a global *can*
    // attach default callback bodies, which gives us exactly one
    // dispatcher in exactly one place. Adding a new confirm flow is a
    // single `else if` branch here plus a `Dialog.*` populate block in
    // the calling view — no Rust changes, no boxed closures retained
    // between open and confirm.
    //
    // **No state-clear in these handlers** — clearing `kind` / `input-text`
    // / `mosaic-selection` immediately would unmount any body branch
    // gated on `if Dialog.kind == "..."` (the create/rename text-input
    // form, the mosaic picker) BEFORE the card's close animation has
    // a chance to play, producing a glitchy "content gone, card still
    // fading" frame. Close-time cleanup instead happens in the `closed`
    // callback below, which `DialogOverlay` fires after the fade-out
    // animation has fully completed (parity with the album-detail
    // `on_close_detail` reset of `AlbumDetail.cover` /
    // `blur_img_a` / `blur_img_b`).
    accepted => {
        if (root.kind == "remove-folder") {
            LibrarySettings.remove-folder(root.target-id);
        } else if (root.kind == "restart-titlebar") {
            // `target-id` carries the desired new value (1 = native, 0 =
            // custom). `restart-app` reads it back via the global.
            WindowChrome.restart-app();
        } else if (root.kind == "restart-tray") {
            // `target-id` carries the desired new value (1 = tray enabled,
            // 0 = disabled). `restart-tray` reads it back via the global.
            WindowChrome.restart-tray();
        } else if (root.kind == "clear-queue") {
            Queue.clear-queue();
        } else if (root.kind == "remove-queue-selected") {
            Queue.remove-selected();
        } else if (root.kind == "create-playlist") {
            // `input-text` is the playlist name; `input-text-2` is the
            // optional description (empty ⇒ no description);
            // `pending-track-ids` (possibly empty) is auto-added after
            // creation.
            Playlists.create-playlist(
                root.input-text,
                root.input-text-2,
                root.pending-track-ids,
            );
        } else if (root.kind == "rename-playlist") {
            Playlists.rename-playlist(
                root.target-id,
                root.input-text,
                root.input-text-2,
            );
        } else if (root.kind == "delete-playlist") {
            Playlists.delete-playlist(root.target-id);
        } else if (root.kind == "edit-playlist-artwork") {
            // Empty + user clicked Clear ⇒ revert to auto. Empty +
            // untouched (dialog opened, Apply clicked without
            // interaction) ⇒ no-op so we don't silently wipe a
            // playlist's saved artwork. Non-empty selection ⇒ 1-4
            // paths form the new mosaic.
            if (root.mosaic-selection.length == 0) {
                if (root.mosaic-touched) {
                    Playlists.clear-artwork(root.target-id);
                }
            } else {
                Playlists.apply-mosaic(root.target-id, root.mosaic-selection);
            }
        } else if (root.kind == "remove-playlist-selected") {
            PlaylistDetail.remove-selected();
        } else if (root.kind == "export-playlists") {
            // Rust reads the selected rows off `export-pick-rows`, then
            // opens the folder picker and writes the files.
            Playlists.export-selected-playlists();
        } else if (root.kind == "add-to-playlist") {
            // Rust reads the selected (enabled) rows off `playlist-pick-rows`
            // and adds `pending-track-ids` into each, then toasts.
            Playlists.add-tracks-to-selected();
        } else if (root.kind == "smart-playlist-editor") {
            // Rust reconstructs a `SmartCriteria` from `SmartEditor.rules` +
            // scalars and creates / updates the smart playlist.
            SmartEditor.commit();
        } else if (root.kind == "edit-tags") {
            // Rust diffs the form against the populate-time snapshot, builds a
            // `TagEdit`, and writes the tags (a no-op commit is short-circuited).
            TagEditor.commit();
        } else if (root.kind == "scrobble-listenbrainz-login") {
            // Validate the pasted token. The dialog stays open (dialog.slint
            // suppresses the auto-close for this kind); Rust closes it on success.
            ScrobbleUi.listenbrainz-verify(ScrobbleUi.lb-token);
        } else if (root.kind == "scrobble-lastfm-login") {
            // Two-step: step 0 opens the browser approval page, step 1 finishes
            // the session exchange. The dialog stays open across both.
            if (ScrobbleUi.lastfm-step == 0) {
                ScrobbleUi.lastfm-open-auth();
            } else {
                ScrobbleUi.lastfm-finish(ScrobbleUi.lastfm-token);
            }
        }
    }
    cancelled => { }

    // Fired by `DialogOverlay` once the close animation reaches t ≈ 0
    // (see `ui/components/dialog/dialog.slint`). It has exactly ONE
    // handler, registered in Rust (`callbacks/playlists/dialog.rs`), and
    // that handler drives close-time teardown in two halves:
    //
    //   1. `closed-teardown()` below — every scalar / list / chrome
    //      property, reset declaratively in Slint so the next open starts
    //      from a clean slate and no body branch is kept mounted by a
    //      stale `kind` or a stale `SharedString` array.
    //   2. The `image`-typed `current-artwork`, which has no Slint default
    //      literal and so must be reset from Rust — that's what drops the
    //      ~603 KiB `SharedPixelBuffer` Arc pulled from the playlist
    //      grid-tier LRU at dialog-open.
    //
    // The teardown is a `public function`, NOT a second callback, and the
    // distinction is load-bearing. A Slint callback has a single handler
    // slot: a default `closed => { … }` body here is installed during
    // `InnerDialog::new()`, and the Rust `on_closed` — which is a plain
    // `Callback::set_handler` and necessarily runs later — silently
    // REPLACES it. That is exactly the bug this shape fixes; the body had
    // been dead code, so `kind` and the picker row models were never
    // cleared and every picker row's cover Arc stayed pinned for the life
    // of the process. A `public function` has no handler slot at all, so
    // it cannot be registered away.
    //
    // Do not try to re-register `closed` from inside the `closed` handler:
    // `Callback::call` `take()`s the handler for the duration of the call
    // and asserts "Callback Handler set while called". Invoking a
    // different item (as we do) is safe.
    callback closed();

    public function closed-teardown() {
        // Routing / kind-gated body branches.
        root.kind = "";
        root.target-id = -1;
        // Text-input dialog state.
        root.input-text = "";
        root.input-text-2 = "";
        // Mosaic-picker state.
        root.mosaic-selection = [];
        root.mosaic-candidates = [];
        root.mosaic-touched = false;
        root.pending-track-ids = [];
        // Add-to-Playlist picker state. Clearing the rows unmounts the
        // picker's `for r in playlist-pick-rows` loop, which releases
        // every row's `Image { source: Playlists.request-row-cover(...) }`
        // binding so the row-tier LRU's `SharedPixelBuffer` Arcs drop.
        // Pairs with the Rust-side `heap_trim::trim()` registered for
        // `Dialog.closed` in `callbacks/playlists/dialog.rs`.
        root.playlist-pick-rows = [];
        root.add-select-all = false;
        root.add-selected-count = 0;
        root.pick-total-tracks = 0;
        // Export picker state.
        root.export-pick-rows = [];
        root.export-select-all = false;
        root.export-selected-count = 0;
        // Chrome / labels — clearing these lets the conditional message
        // Text and Cancel button (`if Dialog.message != ""` /
        // `if Dialog.cancel-label != ""` in `dialog.slint`) unmount
        // between dialog uses, instead of staying mounted with stale
        // strings inside the now-invisible card. `confirm-label` is
        // restored to its documented `"OK"` default (not cleared) so a
        // future caller that flips `open = true` without explicitly
        // setting it still gets a labelled primary button.
        root.title = "";
        root.message = "";
        root.confirm-label = "OK";
        root.cancel-label = "";
        root.destructive = false;
    }
}

// PopupHighlight: lets a popup-trigger button keep its hover background
// painted while its `PopupWindow` is open. Slint 1.16's `PopupWindow` has
// no `closed` callback, so trigger buttons can't observe their popup's
// open/close transitions directly — the `IconButton`'s `touch.has-hover`
// flips false the moment the popup steals input. While a popup is open
// Slint also stops dispatching mouse events to main-window items (see
// `i-slint-core-1.16.0/window.rs` ~683–715), so an AppWindow-level scrim
// TouchArea cannot catch the dismissing click either.
//
// Contract:
//   - A trigger writes its own discriminator string to `id` on click
//     (e.g. "overflow", "volume", "columns") right before `pop.show()`.
//   - The trigger button binds `force-bg: PopupHighlight.id == "<my-id>"`
//     so its disc keeps the surface0 fill until cleared.
//   - `id` is cleared at the winit layer on every mouse Release (see
//     `src/ui/window_chrome/winit_filter.rs`) — by then the press has
//     already triggered Slint's `close-on-click-outside` policy, so the
//     two events resolve in the same input round. ESC-triggered close
//     leaves the highlight set until the next mouse click; acceptable.
//   - Popup-internal interactive areas that DO NOT close the popup
//     (volume slider, column-toggle rows) re-set `id` from their
//     `pointer-event(up)` handler so the release-side clear doesn't
//     drop the highlight while the popup stays open.
//   - Popup-internal interactive areas that DO close the popup
//     (OverflowMenu rows, volume-popup left-strip catcher) explicitly
//     clear `id` alongside `pop.close()` — belt-and-braces with the
//     winit Release path.
//
// `id` is a string (not a bool) so multiple distinct trigger buttons can
// coexist without their highlights cross-talking.
//
// `row-ctx-id` tracks the track id of the row whose right-click context
// menu is currently shown (or `-1` for "none"). It exists for two
// reasons:
//   1. To gate the `FocusLossWatcher` instance inside `TrackListRowItem`
//      via `if root.row-data.id == PopupHighlight.row-ctx-id` — only the
//      open row gets a live watcher, so the focus-loss dispatch stays
//      O(1) regardless of how many rows are visible.
//   2. The winit Release path clears it alongside `id`, so click-outside
//      dismissal doesn't leave the gate stuck on a stale row id (which
//      would block a fresh open on the same row).
export global PopupHighlight {
    in-out property <string> id: "";
    in-out property <int> row-ctx-id: -1;
}

// Notifications: bottom-right transient overlay stack. Used for in-app
// messages that don't need modal confirmation — file watching disabled,
// (future) update available / installed / failed. Owned by Rust
// (`src/ui/notifications.rs`) which holds the backing
// `Rc<VecModel<NotificationRow>>` and pushes via `Notifications.set_rows`.
//
// Strategy mirrors `Dialog`:
//   - `rows` is the live model; the `NotificationStack` component
//     renders one card per row, bottom-right anchored, newest on top
//   - `dismiss(id)` is wired from the close-X TouchArea inside each
//     card; Rust handles the actual `VecModel::remove` via the
//     callback registration in `install`
//   - `action(id, kind)` is fired from the optional action button. The
//     default handler on this global routes by `kind` to the matching
//     backend action — same one-place dispatcher idea `Dialog.accepted`
//     uses. For now there are no kinds in flight (the file-watching
//     notification is action-less); future update-feature branches go
//     here (e.g. `if (kind == "install-update") { Updater.install();
//     Notifications.dismiss(id); }`)
//
// MelodiaUpdater: in-app auto-update state. Owned by Rust
// (`src/ui/updater_settings.rs` + `src/ui/callbacks/updater.rs`); the
// `UpdaterState` enum in `src/services/updater/state.rs` is the
// underlying source of truth, projected onto these properties via
// `MelodiaUpdater.set_*` from the UI thread. Imported in
// `update-section.slint` aliased back to `Updater` for ergonomics.
//
// Name: `MelodiaUpdater` rather than the more natural `Updater`
// because Slint's codegen mangles the bare `Updater` identifier
// (a name-resolution heuristic; the bare name gets an internal
// `_NNNN` suffix and is not re-exported, so `crate::Updater` won't
// resolve). The prefix `Melodia` keeps the global publicly exported.
//
// Properties grouped by direction:
//   - `in`     : Rust → Slint only (current-version, system-managed)
//   - `in-out` : two-way (button states the UI reads + Rust mutates)
//
// Wire flow:
//   user click → callback → `runtime.spawn` background task →
//   `slint::invoke_from_event_loop` to push new state → reactive bindings
//   in `update-section.slint` re-render.
//
// `notes-short` is plain-text (Markdown stripped server-side by
// `scripts/build-latest-json.py`); the full release notes live on the
// GitHub release page and are reachable from the section via the
// "View full changelog" link (Phase D wires the `open` crate).
//
// Declared BEFORE `Notifications` so the `Notifications.action`
// dispatcher's forward reference (which fires `MelodiaUpdater.install`
// and `MelodiaUpdater.restart`) resolves at parse time without
// triggering Slint's name-mangling on the forward target.
export global MelodiaUpdater {
    in-out property <bool> is-checking;
    in-out property <bool> up-to-date;
    in-out property <bool> update-available;
    in-out property <bool> restart-needed;
    in-out property <bool> is-installing;
    in-out property <int> download-progress;     // 0..100
    in property <string> current-version;
    in-out property <string> available-version;
    in-out property <string> notes-short;
    in-out property <string> error-message;
    in-out property <bool> auto-check-enabled;
    // `true` when the manifest marks this release as critical (security
    // fix etc.). update-section.slint suppresses the "Skip this version"
    // button so the user can't permanently defer it; the toast is still
    // dismissable per-session (re-appears at the next daily check).
    in-out property <bool> is-critical;
    // True ⇒ install path is read-only (RPM/MSI/Homebrew install).
    // The section hides Download/Install + Skip and shows a hint row
    // pointing the user at their package manager. Seeded once at
    // startup; doesn't change at runtime.
    in property <bool> system-managed;
    // Platform discriminator used by `update-section.slint` to pick the
    // right package-manager hint string. Set once at startup by
    // `src/ui/updater_settings.rs::install` from `cfg!(target_os)`.
    // Values: "linux" | "windows" | "macos". Treating it as a string
    // (rather than an enum) keeps the Slint side free of conditional
    // compilation and lets `@tr(...)` resolve inline so the hint
    // re-translates on locale switch.
    in property <string> platform-kind;

    callback check();
    callback install();
    callback restart();
    // Explicit "Skip this version" — persists `available-version` into
    // `settings.updates.skipped_release`. Different from closing the
    // toast (which is "remind me later").
    callback skip();
    callback auto-check-changed(bool);
}

// `kind` lives on the row itself (not on the global) because multiple
// notifications can be visible simultaneously, each with its own kind —
// the Dialog pattern's single-global `kind` field wouldn't survive
// stacking.
export global Notifications {
    in-out property <[NotificationRow]> rows: [];
    callback dismiss(int /*id*/);
    callback action(int /*id*/, string /*kind*/);

    // Default action-routing dispatcher. Mirrors `Dialog.accepted` —
    // adding a new action flow is a single branch here plus a
    // `Notifications.show(...)` call on the Rust side. Branches:
    //   - "install-update": user clicked Install on the
    //     "Update available" toast → fire the same flow as the
    //     Download & Install button in Settings → Updates.
    //   - "update-restart": user clicked Restart on the
    //     "Update installed" toast → respawn into the new binary.
    // Toast close-X dismisses without skipping (re-appears next launch);
    // permanent "Skip this version" lives in Settings → Updates where
    // it's discoverable + permanent semantics are obvious.
    action(id, kind) => {
        if (kind == "install-update") {
            MelodiaUpdater.install();
            Notifications.dismiss(id);
        } else if (kind == "update-restart") {
            MelodiaUpdater.restart();
            Notifications.dismiss(id);
        }
    }
}

// NowPlaying: drives the "Up Next" list in the full-screen Now Playing
// view. Kept as its own global (rather than more fields on the already
// large `Player` global) and mirrors the `Queue` global's ownership
// pattern — the `up-next-rows` model is owned by Rust
// (`Rc<VecModel<QueueRow>>` in `src/ui/now_playing.rs`) and pushed in via
// `set_up_next_rows(ModelRc::from(...))`. A subscriber on `sinks.queue`
// rebuilds it on every queue mutation.
export global NowPlaying {
    // Next N tracks after the current one, in play order (the current
    // track itself is excluded). Wrap-around slicing is done in Rust, not
    // in a Slint filtered `for`.
    in-out property <[QueueRow]> up-next-rows;

    // Play-order index of `up-next-rows[0]` — i.e. current queue index + 1.
    in property <int> base-index: 0;

    // Total queue length. With repeat-all the Up Next list wraps past the
    // end of the queue, so a row's play-order index is
    // `mod(base-index + idx, queue-length)` — a row click skips there.
    in property <int> queue-length: 0;

    // Phase counter for `NowPlayingView`'s one-shot Up Next slide-up
    // animation (phase-counter + Timer pattern — see
    // `ui/components/now-playing/play-button.slint`). The view's `slide-timer`
    // increments it each frame; a value `>= NowPlayingView.slide-frames`
    // (the `18` default) means "at rest". Rust resets it to `0` *only* on
    // an actual current-track change (not on generic queue edits like
    // reorder/add that keep the same current track) to start the slide.
    //
    // It lives on the global — rather than inside the view with a
    // `changed` handler watching it — so Rust's reset is a *direct*
    // property write the view picks up through plain bindings on the
    // *same* render as the Up Next model swap. A `changed` handler is
    // queued for the next event-loop iteration, so the new rows would
    // paint once at rest first, flashing the post-advance list.
    in-out property <int> slide-phase: 18;

    // Direction of the Up Next slide animation: `1` = queue advanced
    // forward (rows slide *up* from one row below into rest), `-1` =
    // queue rewound backward (rows slide *down* from one row above into
    // rest). Rust writes this *before* resetting `slide-phase` to 0 so
    // the same render that picks up the new model also picks up the new
    // direction. Defaults to forward.
    in-out property <int> slide-direction: 1;

    // Transient "outgoing" row rendered alongside the Up Next list for
    // the duration of the slide animation. On a forward step this is
    // the just-promoted track (slides off the top with the list); on a
    // backward step it is the track that fell off the visible bottom
    // (slides off the bottom). Rust sets `outgoing-visible: true` only
    // when there is something to render — skip-to / direct play / queue
    // rebuild leave it false. The wrapping Rectangle around the list
    // is `clip: true`, so off-edge positions are hidden automatically.
    in-out property <QueueRow> outgoing-row;
    in-out property <bool> outgoing-visible: false;
}

// Albums: drives the Album grid view. `grid-rows` is owned by Rust
// (`Rc<VecModel<AlbumGridRow>>` in `src/ui/albums.rs`), installed once at
// startup and rebuilt in place on every filter / sort / column-count
// change. The canonical unfiltered album list lives Rust-side; both
// `apply-filter` and `request-sort` re-derive `grid-rows` *without* a DB
// hit (`album_stats` is fetched once; Year / Artist sorts are done
// in-memory since the query is fixed name-ASC).
//
// `columns` is computed by `AlbumView` from its body width and pushed back
// via `columns-changed` so Rust re-chunks the flat album list into rows of
// N cards (the `ListView` in `AlbumGrid` then virtualizes by row). The
// detail view's open/closed state lives on the separate `AlbumDetail`
// global.
export global Albums {
    in-out property <[AlbumGridRow]> grid-rows;
    in-out property <int> total-count;          // pre-filter album count
    in-out property <int> columns: 4;           // view-computed; always >= 1
    in-out property <string> filter;
    in-out property <string> sort-field: "name";   // "name" | "year" | "artist"
    in-out property <string> sort-dir: "asc";
    // Bumped by anything that should make the filter input drop keyboard
    // focus (row clicks, action-pill clicks, body backdrop). The SearchBar
    // observes the counter via a `changed` handler — same pattern as the
    // `Tracks` global.
    in-out property <int> blur-search-tick: 0;

    callback columns-changed(int);
    callback apply-filter(string);
    callback request-sort(string /*field*/);
    callback open-album(int /*album_id*/);
    // Lazy per-card cover lookup. Bound by Rust to `CoverThumbs`; invoked
    // from each on-screen card's `cover` binding (via `AlbumGrid`'s
    // `request-cover`), so only on-screen cards ever decode / lock a cover.
    // `pure` so Slint may evaluate it inside a binding.
    pure callback request-cover(string /*artwork_path*/) -> image;
    // Fired when the Albums section enters / leaves the screen (mirrors
    // `Nav.selected-index == 4 && !Nav.now-playing-open` from `AppWindow`).
    // Rust releases the album-tier cover cache on `false` and re-warms the
    // first screenful on `true` — the large 384 px buffers aren't worth
    // keeping resident while the section is hidden.
    callback section-active-changed(bool);
}

// AlbumDetail: drives the full Album Detail view. `album-id == -1` ⇒ the
// grid is shown; `>= 0` ⇒ `AlbumDetailView` replaces it (mirrors the
// `Nav.now-playing-open` swap in `app-window.slint`). `tracks` is owned by
// Rust (`Rc<VecModel<TrackListRow>>` in `src/ui/albums.rs`); `album`
// carries the header data.
//
// The track table is the shared `TrackList` component, so the column-width
// / visibility / sort / selection shape mirrors the `Tracks` / `Browse`
// globals — with its own persistence key `"album_detail"`. `show-album`
// defaults false: the album column is redundant inside a single album.
export global AlbumDetail {
    in-out property <int> album-id: -1;
    in-out property <AlbumRow> album;
    in-out property <[TrackListRow]> tracks;

    // Filter needle for the hero SearchBar. Filters the `tracks`
    // `TrackList` (title + artist + album substring). Cleared on
    // fresh-open (`open_album`); preserved across library-changed
    // refreshes so a user-typed needle survives a scan finishing.
    in-out property <string> filter;
    in-out property <int>    blur-search-tick: 0;

    // Per-column widths, edited by the resize handles.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Per-column visibility. Hydrated from `settings.view_columns["album_detail"]`.
    in-out property <bool> show-number: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: false;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sort state. Album detail sorts in-memory in Rust (the DB query is a
    // fixed disc/track-number order), like the Browse view.
    in-out property <string> sort-field: "track_number";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // Sidebar index the user was on when this detail was opened, or `-1`
    // for a same-tab open from the Albums grid. Set synchronously by the
    // cross-tab handler in `wire_artists::on_open_album` (currently the
    // only cross-tab entry point — value is `NAV_ARTISTS = 5`); read by
    // `wire_albums::on_close_detail` to flip `Nav.selected-index` back to
    // the originating tab before `album-id` is cleared, so the Slint
    // conditional reroutes straight to `ArtistDetailView` in the same
    // frame (no Album-grid flash). In-memory only — the per-tab
    // `last_detail_ids` persistence already restores both pages
    // independently on the next launch.
    in-out property <int> origin-nav-index: -1;

    // Header cover — set by Rust on `open_album` / `refresh_detail`,
    // paired with the hero blur below (decoded **once** per album into
    // an `(cover, blur)` pair via `ui::detail_artwork::ArtworkPair`).
    in-out property <image> cover;

    // Hero-blur cross-fade slots. Mirrors `Player.blur-img-{a,b}` /
    // `Player.blur-use-a` so switching albums never flashes — the
    // outgoing slot stays painted through the fade.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    // `false` when there is no artwork or the decode failed: both slots
    // fade to 0 and the accent gradient floor shows through (same
    // fallback as `now-playing-view.slint`).
    in-out property <bool>  has-blur;

    callback close-detail();
    callback play-album();
    callback shuffle-album();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Filter keystroke — Rust re-walks the cached tracks through the
    // new needle and pushes a filtered Slint model. In-memory walk,
    // no DB round-trip. Mirrors `ArtistDetail.filter-changed`.
    callback filter-changed(string);
}

// Favorites: drives the Favorites view (sidebar index 2). Single page
// composed of a hero (2x2 live cover mosaic + count + duration + Play
// All / Shuffle pills), a Most Played horizontal carousel, a
// collapsible Favorite Artists section (mirroring Artist Detail's
// Albums sub-section style: pill header with chevron + horizontal
// scroller, persisted collapse state), and a full sortable /
// filterable All Songs `TrackList`. No Favorite Albums section by
// design — albums are reachable via the Albums tab.
//
// The mosaic refreshes live when `library_changed_tx` ticks (favorite
// toggled, play count bumped, library scanned) so the top-4 most-played
// favorites stay current. `blur-img-{a,b}` + `blur-use-a` follow the
// same dual-slot crossfade contract as `Player.blur-img-*` /
// `AlbumDetail.blur-img-*` — outgoing slot never cleared so the fade
// never flashes.
export global Favorites {
    // Hero — mosaic data + stats. `mosaic-paths` is the top-4 cover
    // paths by play_count (DESC); an empty list renders the empty
    // state. `track-count == 0` ⇒ hero shows "No favorites yet" copy
    // instead of the duration line.
    in-out property <[string]> mosaic-paths;
    in-out property <int>      track-count;
    in-out property <string>   duration-text;   // "12h 34m"

    // Hero blur cross-fade — two slots, never cleared. Outgoing slot
    // stays painted through the fade so switching mosaics never
    // flashes. `has-blur` ⇒ either slot is non-empty (gates the
    // accent-gradient floor fallback).
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Carousels — per-strip flat lists. `EntityStripRow`'s unified
    // shape (id / title / subtitle / artwork_path / play_count) drives
    // both surfaces.
    in-out property <[EntityStripRow]> most-played-rows;
    in-out property <[EntityStripRow]> artist-rows;

    // Favorite Artists sub-section collapse state. Persisted under
    // `settings.favorites_artists_collapsed`; hydrated by
    // `boot/ui_setup.rs` and toggled via the section header chevron
    // in `ui/views/favorites-view.slint`. Mirrors
    // `ArtistDetail.albums-collapsed`.
    in-out property <bool> artists-collapsed: false;
    // Most Played sub-section collapse state. Persisted under
    // `settings.favorites_most_played_collapsed`; same shape as
    // `artists-collapsed`.
    in-out property <bool> most-played-collapsed: false;

    // All Songs — `TrackList` data + filter + sort. `tracks` is the
    // post-filter view that the list actually renders (Rust applies
    // the in-memory filter against an internal `tracks-all` cache and
    // writes the result here, mirroring how the Tracks view handles
    // its search bar).
    in-out property <[TrackListRow]> tracks;
    in-out property <int>            filtered-count;
    in-out property <string>         filter;
    in-out property <int>            blur-search-tick: 0;
    in-out property <string>         sort-field: "title";  // track_number | title | artist | album | genre | year | length
    in-out property <string>         sort-dir: "asc";


    // Per-column widths / visibility for the All Songs `TrackList` —
    // mirrors the same shape `Tracks` / `AlbumDetail` / `ArtistDetail`
    // use. Hydrated from `settings.view_columns["favorites"]` +
    // `settings.view_column_widths["favorites"]`.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: false;
    in-out property <bool> show-artwork: true;

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // Lazy cover callbacks — one per cache tier so Rust can route each
    // surface into the right LRU (row-tier 72 px for the mosaic;
    // dedicated thumbs for most-played + circular artist). All Songs
    // rows resolve through the shared `RowCovers` global.
    pure callback request-mosaic-cover(string)      -> image;
    pure callback request-most-played-cover(string) -> image;
    pure callback request-artist-cover(string)      -> image;

    // Hero actions
    callback play-all();
    callback shuffle-all();

    // Card clicks. `play-*` ⇒ start playback in that scope; `open-*`
    // ⇒ cross-tab nav to the entity's detail view (sets
    // `*Detail.origin-nav-index = NAV_FAVORITES` synchronously before
    // flipping `Nav.selected-index` so the back button returns here).
    callback play-track(int /*track_id*/);
    callback play-artist(int /*artist_id*/);
    callback open-artist(int /*artist_id*/);

    // Collapse toggle for the Favorite Artists sub-section. Rust
    // handles the negate + persist so the Slint side only fires the
    // event — mirrors `ArtistDetail.toggle-albums-collapsed`.
    callback toggle-artists-collapsed();
    // Collapse toggle for the Most Played sub-section. Same shape as
    // `toggle-artists-collapsed`.
    callback toggle-most-played-collapsed();

    // All Songs row interactions — same shape as Tracks / AlbumDetail.
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback filter-changed(string);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Section-visible signal — fires when the Favorites tab enters or
    // leaves the screen (sidebar nav, or Now Playing opened over it).
    // Driven by `watched-favorites-active` in `app-window.slint`.
    // `wire_favorites` mirrors this into `FavoritesUi.section_active`
    // + triggers the cache release / re-fetch dance.
    callback section-active-changed(bool);

    // Translated "{n} favorite[s]" subtitle for Favorite-Artist cards.
    // Slint 1.16 doesn't expose `translate_from_bundle` publicly, so
    // Rust resolves the plural through this `pure callback` at row-build
    // time (UI thread). Reuses the same `{n} favorite|{n} favorites`
    // msgid as the hero count line, so adding it to a locale handles
    // both surfaces. Same pattern as `Settings.watcher-disabled-*`.
    pure callback artist-favorite-subtitle(int /*count*/) -> string;
    artist-favorite-subtitle(count) => {
        return @tr("{n} favorite" | "{n} favorites" % count);
    }
}

// RecentlyPlayed: drives the Recently-Played view (a trimmed Favorites).
// Owned by `src/ui/recently_played`. No hero mosaic / artist strip — just a
// header (count + duration + Play All / Shuffle), a non-collapsible "Most
// Played" strip, and a filterable `TrackList` of the 200 most-recently-played
// tracks. Membership is fixed to that set; filter + column sort re-walk the
// cache in memory (no re-query).
export global RecentlyPlayed {
    // Hero — 2×2 cover mosaic of the up-to-4 most-recently-played distinct
    // covers. Empty list renders the empty-state tile.
    in-out property <[string]> mosaic-paths;

    // Hero blur cross-fade — two slots, never cleared (outgoing slot stays
    // painted through the fade so a mosaic refresh never flashes). `has-blur`
    // ⇒ either slot is non-empty (gates the accent-gradient floor fallback).
    // Same dual-slot contract as `Favorites`.
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Most Played strip — library-wide top tracks by play_count. Reuses the
    // unified `EntityStripRow` shape.
    in-out property <[EntityStripRow]> most-played-rows;

    // Recency list — `TrackList` data + filter + sort. `tracks` is the
    // post-filter/sort view Rust writes. `sort-field` defaults to the synthetic
    // "recency" (keep fetch order); a column header click swaps in a real field.
    in-out property <[TrackListRow]> tracks;
    in-out property <int>            filtered-count;
    in-out property <string>         filter;
    in-out property <int>            blur-search-tick: 0;
    in-out property <string>         sort-field: "recency";  // recency | track_number | title | artist | album | genre | year | length
    in-out property <string>         sort-dir: "desc";

    // Header stats over the full recency set.
    in-out property <int>    track-count;
    in-out property <string> duration-text;   // "12h 34m"

    // Per-column widths / visibility for the `TrackList` — mirrors the shape
    // `Favorites` / `Tracks` use. Hydrated from
    // `settings.view_columns["recently_played"]` +
    // `settings.view_column_widths["recently_played"]`.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: false;
    in-out property <bool> show-artwork: true;

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // Lazy cover callbacks — the hero 2×2 mosaic tiles and the Most Played
    // strip cards. The list rows resolve through the shared `RowCovers` global.
    pure callback request-mosaic-cover(string)      -> image;
    pure callback request-most-played-cover(string) -> image;

    // Header actions.
    callback play-all();
    callback shuffle-all();

    // Most Played card click ⇒ start playback in that scope.
    callback play-track(int /*track_id*/);

    // List row interactions — same shape as Tracks / Favorites.
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    callback filter-changed(string);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Section-visible signal — driven by `watched-recently-active` in
    // `app-window.slint`.
    callback section-active-changed(bool);
}

// Artists: drives the Artist grid view. Same ownership + filter / sort /
// chunk contract as `Albums` (Rust owns the flat list; `apply-filter` and
// `request-sort` re-derive `grid-rows` without a DB hit), just one row of
// state per artist instead of per album. Sort fields are `"name"`,
// `"track_count"`, and `"album_count"`.
export global Artists {
    in-out property <[ArtistGridRow]> grid-rows;
    in-out property <int> total-count;
    in-out property <int> columns: 4;
    in-out property <string> filter;
    in-out property <string> sort-field: "name";   // "name" | "track_count" | "album_count"
    in-out property <string> sort-dir: "asc";
    in-out property <int> blur-search-tick: 0;

    callback columns-changed(int);
    callback apply-filter(string);
    callback request-sort(string /*field*/);
    callback open-artist(int /*artist_id*/);
    pure callback request-cover(string /*image_path*/) -> image;
    callback section-active-changed(bool);
}

// ArtistDetail: drives the full Artist Detail view. `artist-id == -1` ⇒
// the grid is shown; `>= 0` ⇒ `ArtistDetailView` replaces it. Mirrors the
// `AlbumDetail` shape, plus an `albums` list that drives the small
// horizontal sub-section above the all-tracks list (Tauri parity) and an
// `open-album` callback that performs cross-tab nav to the Albums tab.
//
// Track-list defaults: `show-album: true` (tracks span albums), and
// `show-artist: false` (every row is the same artist). Default sort is
// `album` ascending so tracks group naturally by album.
export global ArtistDetail {
    in-out property <int> artist-id: -1;
    in-out property <ArtistRow> artist;
    in-out property <[AlbumRow]> albums;
    in-out property <[TrackListRow]> tracks;

    // Per-column widths, edited by the resize handles.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Per-column visibility. Hydrated from `settings.view_columns["artist_detail"]`.
    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: false;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sort state. Artist detail sorts in-memory in Rust.
    in-out property <string> sort-field: "album";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    // Header cover + hero-blur cross-fade slots. Same dual-slot contract
    // as `AlbumDetail` so switching artists never flashes — the outgoing
    // slot stays painted through the fade.
    in-out property <image> cover;
    in-out property <image> blur-img-a;
    in-out property <image> blur-img-b;
    in-out property <bool>  blur-use-a;
    in-out property <bool>  has-blur;

    // Albums sub-section collapse state. Persisted under
    // `settings.artist_albums_collapsed`; hydrated by
    // `boot/ui_setup.rs` and toggled via the Albums header in
    // `artist-detail-view.slint`.
    in-out property <bool> albums-collapsed: false;

    // Filter needle for the SearchBar in the hero. Filters both
    // the All Songs `TrackList` (title + artist + album substring)
    // and the Albums sub-section (album name substring). Cleared on
    // fresh-open (`open_artist`); preserved across library-changed
    // refreshes so a user-typed needle survives a scan finishing.
    // `blur-search-tick` is bumped by row TouchAreas / the click
    // backdrop to force the SearchBar to release focus — same
    // pattern Tracks / Favorites use.
    in-out property <string> filter;
    in-out property <int>    blur-search-tick: 0;

    // Sidebar index the user was on when this detail was opened, or `-1`
    // for a same-tab open from the Artists grid. Mirrors
    // `AlbumDetail.origin-nav-index` so cross-tab back-nav (Favorites
    // tab → click favorite artist → Artist Detail → back arrow returns to
    // Favorites) routes through the same atomic flip-Nav-then-clear-id
    // pattern.
    in-out property <int> origin-nav-index: -1;

    callback close-detail();
    callback play-artist();
    callback shuffle-artist();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);

    // Albums sub-section: card click hands off to the Albums tab and opens
    // that album's detail. Rust both flips `Nav.selected-index` to the
    // Albums tab and calls `AlbumsUi::open_album(id)`.
    callback open-album(int /*album_id*/);
    // Lazy cover lookup for album cards in the sub-section — backed by
    // `AlbumsUi`'s grid-tier cover cache (no separate cache).
    pure callback request-album-cover(string /*artwork_path*/) -> image;
    // Flip `albums-collapsed`. Rust handles the negate + persist so the
    // Slint side only needs to fire the event.
    callback toggle-albums-collapsed();

    // Filter keystroke — Rust re-walks the cached tracks + albums
    // through the new needle and pushes filtered Slint models for
    // both surfaces. Mirrors `Favorites.filter-changed`.
    callback filter-changed(string);
}

// Genres: drives the Genre grid view. Same ownership + filter / sort /
// chunk contract as `Albums` / `Artists` (Rust owns the flat list;
// `apply-filter` and `request-sort` re-derive `grid-rows` without a DB
// hit), just one row of state per genre. Sort fields are `"name"`,
// `"track_count"`, and `"duration"`.
//
// Unlike `Albums` / `Artists`, there is **no `request-cover` callback**:
// genres have no intrinsic artwork. Each tile renders the `EntityCard`
// fallback icon (`theater_comedy`) and the detail header paints only the
// accent gradient floor + scrim. That keeps the entire Genre tab free of
// cover-cache plumbing and means `section-active-changed` is a no-op
// today (kept for symmetry with the other entity tabs).
export global Genres {
    in-out property <[GenreGridRow]> grid-rows;
    in-out property <int> total-count;
    in-out property <int> columns: 4;
    in-out property <string> filter;
    in-out property <string> sort-field: "name";   // "name" | "track_count" | "duration"
    in-out property <string> sort-dir: "asc";
    in-out property <int> blur-search-tick: 0;

    callback columns-changed(int);
    callback apply-filter(string);
    callback request-sort(string /*field*/);
    callback open-genre(int /*genre_id*/);
    callback section-active-changed(bool);
}

// GenreDetail: drives the full Genre Detail view. `genre-id == -1` ⇒ the
// grid is shown; `>= 0` ⇒ `GenreDetailView` replaces it (mirrors the
// `Nav.now-playing-open` swap in `app-window.slint`). `tracks` is owned
// by Rust (`Rc<VecModel<TrackListRow>>` in `src/ui/genres.rs`); `genre`
// carries the header data.
//
// The track table is the shared `TrackList` component, so the
// column-width / visibility / sort / selection shape mirrors the
// `Tracks` / `Browse` / `AlbumDetail` / `ArtistDetail` globals — with
// its own persistence key `"genre_detail"`. `show-genre` defaults
// false: the genre column is redundant inside a single genre.
//
// No `cover` / `blur-img-{a,b}` / `blur-use-a` / `has-blur` slots:
// genres have no artwork (see the `Genres` global comment), so the
// detail header doesn't take any image inputs and renders only the
// accent gradient floor + scrim.
export global GenreDetail {
    in-out property <int> genre-id: -1;
    in-out property <GenreRow> genre;
    in-out property <[TrackListRow]> tracks;

    // Filter needle for the hero SearchBar. Filters the `tracks`
    // `TrackList` (title + artist + album substring). Cleared on
    // fresh-open (`open_genre`); preserved across library-changed
    // refreshes so a user-typed needle survives a scan finishing.
    in-out property <string> filter;
    in-out property <int>    blur-search-tick: 0;

    // Sidebar index the user was on when this detail was opened, or
    // `-1` for a same-tab open from the Genres grid. Mirrors
    // `AlbumDetail.origin-nav-index`: the cross-tab back-nav path
    // (any non-Genres tab → row's "Go to Genre" entry → Genre Detail →
    // back arrow returns to that tab) routes through the same
    // atomic flip-Nav-then-clear-id pattern.
    in-out property <int> origin-nav-index: -1;

    // Per-column widths, edited by the resize handles.
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    // Per-column visibility. Hydrated from `settings.view_columns["genre_detail"]`.
    // `show-number` defaults false: track ordering inside a genre is
    // incidental (tracks span many albums), not a tracklist position.
    in-out property <bool> show-number: false;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;
    in-out property <bool> show-year: true;
    in-out property <bool> show-artwork: true;

    // Sort state. Genre detail sorts in-memory in Rust (the DB query is
    // fixed natural-title order), like the Browse / Album / Artist detail
    // views. Default `album` so rows group naturally by album.
    in-out property <string> sort-field: "album";
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int> selection-anchor: -1;

    callback close-detail();
    callback play-genre();
    callback shuffle-genre();
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Cross-tab navigation from a row's right-click "Go to …" entry.
    callback go-to-album(int /*album_id*/);
    callback go-to-artist(int /*artist_id*/);
    callback go-to-genre(int /*genre_id*/);
    // Filter keystroke — Rust re-walks the cached tracks through the
    // new needle and pushes a filtered Slint model. In-memory walk,
    // no DB round-trip. Mirrors `ArtistDetail.filter-changed`.
    callback filter-changed(string);
}

// Search: drives the Search view (sidebar index 0). Mixed-results page —
// Top Result featured card + Songs list (compact 4-row default, "Show
// all" toggle) + Albums strip + Artists strip + Recent searches chip
// list when input is empty. Backed by FTS5 for tracks and `LIKE` for
// album/artist names via `library::search::search_all`.
//
// Query is the driver — Rust never auto-refreshes on `library_changed_tx`
// (a scan completing mid-query MUST NOT swap results out from under the
// user). Tab-leave releases the strip cover LRUs but keeps `query` +
// `recent-rows` so a brief flip to Now Playing returns to the same query.
export global Search {
    // --- Live query + debounce -------------------------------------
    // `query` is the live text bound to the SearchBar. Each keystroke
    // bumps `debounce-tick-pending`; a 300 ms Timer in the view fires
    // `commit-search` (which kicks the actual FTS fetch) once
    // `pending != applied`. Mirrors the throttle shape used by Tracks /
    // Favorites filters.
    in-out property <string> query;
    in-out property <int>    blur-search-tick: 0;
    in-out property <int>    debounce-tick-pending: 0;
    in-out property <int>    debounce-tick-applied: 0;
    in-out property <bool>   loading: false;

    // --- Results models --------------------------------------------
    // `tracks` is the *visible* slice (first 4 rows by default, full 50
    // when `show-all-tracks` is on). Rust holds the full result set in
    // its own `last_results` cache so the toggle swaps without a DB hit.
    // `tracks-total` is the pre-truncate count, for the "Show all N"
    // button copy.
    in-out property <[TrackListRow]>   tracks;
    in-out property <int>              tracks-total;
    in-out property <bool>             show-all-tracks: false;
    in-out property <[EntityStripRow]> album-rows;
    in-out property <[EntityStripRow]> artist-rows;

    // --- Top Result -------------------------------------------------
    // Discriminator + scalar payload, rather than a unified row struct,
    // because: (a) the badge text needs to be localized inline in
    // `.slint` (Rust-pushed strings can't `@tr()`); (b) baking a `kind`
    // field into `EntityStripRow` would warp every other consumer
    // (Favorites' Most Played + Favorite Artists strips). `top-kind ==
    // ""` ⇒ no Top Result section.
    in-out property <string> top-kind;            // "album" | "artist" | ""
    in-out property <int>    top-id;
    in-out property <string> top-title;
    in-out property <string> top-subtitle;
    in-out property <string> top-artwork-path;

    // --- Recent searches (cap 10, JSON-persisted via SearchHistoryState)
    // Shown only when `query == ""`. Click a chip → fill query + commit.
    // Click chip-X → optimistic remove + persist via `recent-remove`.
    in-out property <[string]> recent-rows;

    // --- TrackList column state (Favorites parity, view-id "search") --
    in-out property <length> w-number: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 220px;
    in-out property <length> w-genre: 140px;
    in-out property <length> w-year: 72px;
    in-out property <length> w-length: 88px;

    in-out property <bool> show-number: true;
    in-out property <bool> show-artwork: true;
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-genre: false;   // Tauri parity: genre + year hidden
    in-out property <bool> show-year: false;

    in-out property <string> sort-field: "rank"; // default: FTS5 rank order
    in-out property <string> sort-dir: "asc";

    in-out property <[int]> selected-ids;
    in-out property <int>   selection-anchor: -1;

    // --- Lazy cover lookups (strip tiers + per-kind routing for top;
    // result rows go through the shared `RowCovers` global) ---
    pure callback request-album-strip-cover(string)  -> image;
    pure callback request-artist-strip-cover(string) -> image;
    pure callback request-top-result-cover(string)   -> image;

    // --- Query / debounce ------------------------------------------
    callback query-changed(string);     // every keystroke; Rust mirrors + clears on empty
    callback commit-search(string);     // 300 ms Timer fires this
    callback toggle-show-all-tracks();

    // --- Recent searches -------------------------------------------
    callback recent-pick(string);
    callback recent-remove(string);
    callback recent-clear();

    // --- Cross-tab nav (Search → AlbumDetail / ArtistDetail) -------
    // Each stamps `*Detail.origin-nav-index = NAV_SEARCH (0)` *before*
    // flipping `Nav.selected-index` so the detail-view back arrow
    // returns here. Wired in `src/ui/callbacks/search.rs`.
    callback open-album(int /*album_id*/);
    callback open-artist(int /*artist_id*/);
    callback open-top-result();         // resolves top-kind/top-id

    // --- TrackList row actions (Favorites parity) ------------------
    callback play-row(int /*track_id*/, int /*index*/);
    callback play-next([int] /*track_ids*/);
    callback add-to-queue([int]);
    callback toggle-row-favorite([int] /*track_ids*/, bool /*new*/);
    callback set-row-rating([int] /*track_ids*/, int /*rating*/);
    callback select-row(int /*idx*/, int /*id*/, bool /*shift*/, bool /*ctrl*/);
    callback clear-selection();
    callback request-sort(string /*field*/);
    callback toggle-column(string /*column_id*/);
    // Cross-tab navigation from a row's right-click "Go to Genre" entry.
    // (The view re-uses `open-album` / `open-artist` above for the row's
    // Go-to-Album / Go-to-Artist entries — same cross-tab semantics.)
    callback go-to-genre(int /*genre_id*/);

    // Section-visible signal — fires when the Search tab enters or
    // leaves (sidebar nav, or Now Playing opened over it). Driven by
    // `watched-search-active` in `app-window.slint`; mirrored into
    // `SearchUi.section_active` + triggers strip-cache release.
    callback section-active-changed(bool);
}

