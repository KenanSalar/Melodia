import { Theme } from "../theme.slint";
import { Player, WindowChrome, Queue, Nav } from "../globals.slint";
import { Settings } from "../settings.slint";
import { IconButton } from "../components/icon-button.slint";
import { ArtworkImage } from "../components/artwork-image.slint";
import { SliderTrack } from "../components/slider-track.slint";
import { VolumePopup } from "../components/now-playing/volume-popup.slint";
import { OverflowMenu } from "../components/now-playing/overflow-menu.slint";
import { PlayButton } from "../components/now-playing/play-button.slint";

export component NowPlayingBar inherits Rectangle {
    // Pin to a fixed height with min/max + no stretch so the parent
    // VerticalLayout always reserves this slot — without these, when the
    // window is short the bar gets handed off to the (taller) HorizontalLayout
    // above and disappears below the visible bottom edge. Slint disallows
    // setting both `height` and `min-height` on the same element, so we use
    // the min/max-pair pattern from CLAUDE.md's fixed-row guidance.
    min-height: Theme.now-playing-h;
    max-height: Theme.now-playing-h;
    vertical-stretch: 0;
    // See sidebar.slint for the focus-binding rationale — both surfaces
    // share the same `Settings.match-unfocused-bg && Theme.use-native-titlebar
    // && !Theme.window-focused` gate so they swap to the OS-defined inactive
    // titlebar colour in lock step when the window loses focus (only when
    // the user has the KDE-only feature enabled AND we're in native-titlebar
    // mode — see sidebar.slint for why all three conditions are needed).
    background: (Settings.match-unfocused-bg && Theme.use-native-titlebar && !Theme.window-focused)
        ? Theme.mantle-unfocused : Theme.mantle;

    // Cached bar width for fluid sizing. Updated imperatively via the
    // `changed width` callback so child intrinsic sizes (artwork tile,
    // button diameters, padding) don't bind directly to `root.width`
    // and cause a `layoutinfo-h` binding loop in the parent VerticalLayout.
    property <length> bar-w: 1100px;
    changed width => { self.bar-w = self.width; }

    // Shared sizing for the standard transport / favorite / repeat / shuffle
    // / pin / queue / volume / more_vert buttons. The same `clamp(...)` lived
    // inline at 10+ call sites before — caching at the root makes design
    // tweaks a one-line edit and lets Slint evaluate the clamp once per
    // bar-w change instead of once per use site.
    out property <length> btn-d: clamp(root.bar-w * 0.05, 28px, 36px);
    out property <length> btn-icon-d: clamp(root.bar-w * 0.03, 18px, 20px);

    // The `more_vert` overflow trigger is ALWAYS mounted below: it permanently
    // houses the playback-speed flyout (never shown inline), and additionally
    // collects whatever buttons the user has routed to it via `Settings.overflow-*`.

    // The seam between content and bar is drawn by the content panel's
    // bottom border in `app-window.slint`, so it follows the rounded
    // bottom-left curve cleanly. No divider here.

    // Bar contents. Each section is wrapped in a `VerticalLayout {
    // alignment: center }` so its content is vertically centered against
    // the bar height regardless of intrinsic size — the same pattern the
    // sidebar uses for its rows.
    HorizontalLayout {
        padding-left: clamp(root.bar-w * 0.02, 10px, 16px);
        padding-right: clamp(root.bar-w * 0.02, 10px, 16px);
        spacing: clamp(root.bar-w * 0.015, 6px, 12px);
        alignment: stretch;

        // -- Track info ---------------------------------------------------
        // Outer Rectangle (not VerticalLayout) so we can `clip: true` against
        // bidi text overflow. The inner text VL gets `horizontal-stretch: 1`
        // so `overflow: elide` actually triggers — without it, in a
        // HorizontalLayout with `alignment: start`, the text VL takes its
        // intrinsic (full string) width and spills past the column. Same
        // pattern as the title cell in `track-list-row.slint`.
        //
        // The whole cell acts as a button: clicking it opens the
        // full-screen Now Playing view (`Nav.now-playing-open`). The
        // `track-info-touch` TouchArea is declared last so it sits above
        // the artwork + text (neither of which has its own TouchArea). No
        // hover background — the affordance is a Material-3-expressive zoom
        // of the artwork tile instead (`cover-scale` on hover). The cell is
        // disabled when nothing is playing.
        track-info-cell := Rectangle {
            width: clamp(root.bar-w * 0.25, 120px, 200px);
            // Pinned: a Rectangle defaults to stretch 0, but the explicit
            // factor documents intent alongside the transport / extra columns
            // below (mirrors the Tauri `.trackInfo { flex-shrink: 0 }`).
            horizontal-stretch: 0;
            clip: true;

            // Press-shrink factor — mirrors the IconButton wobble used by the
            // transport/repeat/shuffle buttons (`press-shrink: true`). Drives
            // *both* the hover-bg and the content-wobble wrapper below, so
            // the chrome and the artwork+text block contract symmetrically
            // toward the cell's centre on press. Doing the wobble at the
            // wrapper level (rather than scaling tile-size and font-size
            // per-element) keeps the shrink centred: when the wrapper
            // contracts, the artwork's left edge moves right *and* the
            // text's right edge moves left in lockstep, instead of both
            // anchoring to their left edges. The *factor* is animated, not
            // derived widths/heights — the cell re-clamps as `root.bar-w`
            // changes, and animating sizes directly would wobble on every
            // resize tick.
            property <float> press-scale: track-info-touch.pressed && Player.vm.has_track
                ? 0.99
                : 1.0;
            animate press-scale {
                duration: track-info-touch.pressed ? 100ms : Theme.dur-med;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);
            }

            // Hover background — Material-3-expressive low-alpha accent fill
            // behind the artwork+text content. Vertical inset (~6px each side)
            // keeps it from painting all the way to the bar's top/bottom
            // edges so it reads as a discrete button, not a full-height swap.
            // Width/height scale with `press-scale` for the wobble; the
            // x/y recentre math keeps the shrink centred so the bg pulses
            // in place instead of drifting toward a corner.
            Rectangle {
                width: parent.width * track-info-cell.press-scale;
                height: (parent.height - 12px) * track-info-cell.press-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-md;
                background: track-info-touch.has-hover && Player.vm.has_track
                    ? Theme.accent.with-alpha(0.12)
                    : transparent;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; }
            }

            // Content wobble wrapper — shares `press-scale` with the hover-bg
            // so the HorizontalLayout inside contracts symmetrically toward
            // the cell's centre on press (left edge moves right, right edge
            // moves left). Without this wrapper, scaling tile-size/font-size
            // per-element would shrink each element anchored to its own left
            // edge, making the whole block appear to collapse leftward
            // instead of pulsing in place.
            Rectangle {
                width: parent.width * track-info-cell.press-scale;
                height: parent.height * track-info-cell.press-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    // Symmetric horizontal padding so the artwork + text sit
                    // visually nested inside the hover background (the bg
                    // fills the wrapper's full width; without this, the
                    // tile's left edge would be flush with the hover's left
                    // edge).
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: clamp(root.bar-w * 0.015, 6px, 10px);
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        ArtworkImage {
                            artwork-path: Player.vm.track.artwork_path;
                            cover: Player.vm.track.cover_img;
                            tile-size: clamp(root.bar-w * 0.07, 36px, 46px);
                            // Subtle artwork zoom on hover — the frame stays
                            // fixed, the cover image scales within it.
                            cover-scale: track-info-touch.has-hover && Player.vm.has_track
                                ? 1.15
                                : 1.0;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            spacing: 2px;

                            // U+200E (LEFT-TO-RIGHT MARK) prefix forces LTR
                            // base direction so `overflow: elide` renders
                            // the `…` indicator at the right edge for RTL
                            // scripts too — see the title-cell note in
                            // `track-list-row.slint`.
                            Text {
                                text: Player.vm.has_track
                                    ? "‎" + Player.vm.track.title
                                    : @tr("No track playing");
                                color: Theme.text;
                                font-size: Theme.font-size-sm;
                                font-weight: 500;
                                overflow: elide;
                            }
                            Text {
                                text: Player.vm.has_track
                                    ? "‎" + (Player.vm.track.artist == ""
                                        ? @tr("Unknown artist")
                                        : Player.vm.track.artist)
                                    : "—";
                                color: Theme.subtext0;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: "‎" + Player.vm.track.album;
                                color: Theme.overlay1;
                                font-size: 11px;
                                overflow: elide;
                                visible: Player.vm.has_track && Player.vm.track.album != "";
                            }
                        }
                    }
                }
            }

            track-info-touch := TouchArea {
                mouse-cursor: Player.vm.has_track ? pointer : default;
                enabled: Player.vm.has_track;
                clicked => { Nav.now-playing-open = true; }
            }
        }

        // -- Transport controls -------------------------------------------
        // `horizontal-stretch: 0` — a VerticalLayout defaults to stretch 1, so
        // without this it would absorb a share of the bar's surplus space as
        // dead padding around the centered button row, starving the progress
        // slider. Only the slider section (stretch 2) should grow.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: Theme.pad-xs;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "chevron_left";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        button-enabled: Player.vm.has_previous;
                        tooltip-text: @tr("Previous");
                        clicked => { Player.previous(); }
                    }
                }

                // Play/pause — disc geometry, hover/press scale, tooltip,
                // and the optional Equalizer overlay driven by
                // `Settings.play-button-animation-idx` all live inside
                // PlayButton (`ui/components/now-playing/play-button.slint`). The bar
                // just feeds it the live playing state, animation mode,
                // and a wrapper diameter that clamps to the bar width.
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        wrapper-d: clamp(root.bar-w * 0.055, 30px, 38px);
                        icon-size: clamp(root.bar-w * 0.025, 14px, 20px);
                        is-playing: Player.vm.is_playing;
                        animation-mode: Settings.play-button-animation-idx;
                        clicked => { Player.play-pause(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "chevron_right";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        button-enabled: Player.vm.has_next;
                        tooltip-text: @tr("Next");
                        clicked => { Player.next(); }
                    }
                }
            }
        }

        // -- Progress slider ----------------------------------------------
        // Single row: [current-time]  [slider]  [total-time]. The inner
        // HorizontalLayout uses `alignment: stretch` (the default) so the
        // slider's `horizontal-stretch: 1` actually expands.
        VerticalLayout {
            alignment: center;
            min-width: 140px;
            horizontal-stretch: 2;

            HorizontalLayout {
                spacing: Theme.pad-sm;

                Text {
                    text: Theme.format-duration(slider.dragging
                        ? round(slider.drag-value * Player.duration-ms)
                        : (Player.seek_pending_ms >= 0
                            ? Player.seek_pending_ms
                            : Player.position-ms));
                    color: Theme.subtext0;
                    font-size: 11px;
                    min-width: 40px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                slider := SliderTrack {
                    horizontal-stretch: 1;
                    value: Player.duration-ms > 0
                        ? (Player.seek_pending_ms >= 0
                            ? clamp(Player.seek_pending_ms / Player.duration-ms, 0, 1)
                            : clamp(Player.position-ms / Player.duration-ms, 0, 1))
                        : 0;
                    is-disabled: !Player.vm.has_track || Player.duration-ms <= 0;
                    // Seam mask must match the bar's parent background so it
                    // disappears against it. Mirror the bar's own focus-aware
                    // background expression above.
                    seam-mask-color: (Settings.match-unfocused-bg && Theme.use-native-titlebar && !Theme.window-focused)
                        ? Theme.mantle-unfocused : Theme.mantle;

                    committed(v) => {
                        if (Player.duration-ms > 0) {
                            Player.seek(round(v * Player.duration-ms));
                        }
                    }
                }

                Text {
                    text: Theme.format-duration(Player.duration-ms);
                    color: Theme.subtext0;
                    font-size: 11px;
                    min-width: 40px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }

        // -- Extra controls -----------------------------------------------
        // `horizontal-stretch: 0` (see the transport column above) — keeps this
        // column at its intrinsic button-row width so buttons routed into the
        // overflow menu free their space *to the slider* rather than into
        // padding here.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: clamp(root.bar-w * 0.005, 0px, 2px);
                alignment: end;

                // Each button wrapper uses the `if`-conditional form so a
                // button moved into the overflow menu fully vacates its
                // layout slot (Slint pitfall: `visible: false` doesn't
                // free layout space). The OverflowMenu trigger below
                // collects whatever's been routed to it.
                if !Settings.overflow-repeat: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Player.queue.repeat_mode == "one" ? "repeat_one" : "repeat";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        active: Player.queue.repeat_mode != "off";
                        tooltip-text: Player.queue.repeat_mode == "off"
                            ? @tr("Repeat: off")
                            : (Player.queue.repeat_mode == "one"
                                ? @tr("Repeat: one")
                                : @tr("Repeat: all"));
                        clicked => { Player.cycle-repeat(); }
                    }
                }
                if !Settings.overflow-shuffle: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "shuffle";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        active: Player.queue.shuffle;
                        tooltip-text: Player.queue.shuffle ? @tr("Shuffle: on") : @tr("Shuffle: off");
                        clicked => { Player.toggle-shuffle(); }
                    }
                }
                if !Settings.overflow-favorite: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Player.vm.track.is_favorite ? "favorite" : "favorite_border";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        active: Player.vm.track.is_favorite;
                        filled: Player.vm.track.is_favorite;
                        button-enabled: Player.vm.has_track;
                        tooltip-text: Player.vm.track.is_favorite ? @tr("Unfavorite") : @tr("Favorite");
                        clicked => { Player.toggle-favorite(); }
                    }
                }
                if WindowChrome.always-on-top-supported && !Settings.overflow-pin: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "push_pin";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        active: WindowChrome.always-on-top-active;
                        filled: WindowChrome.always-on-top-active;
                        tooltip-text: WindowChrome.always-on-top-active ? @tr("Unpin from Top") : @tr("Pin on Top");
                        clicked => { WindowChrome.toggle-always-on-top(); }
                    }
                }
                if !Settings.overflow-queue: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "queue_music";
                        press-shrink: true;
                        diameter: root.btn-d;
                        icon-size: root.btn-icon-d;
                        active: Queue.open;
                        tooltip-text: @tr("Queue");
                        clicked => { Queue.open = !Queue.open; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    VolumePopup {
                        diameter: root.btn-d;
                        icon-size: clamp(root.bar-w * 0.035, 22px, 22px);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    OverflowMenu { bar-w: root.bar-w; }
                }
            }
        }
    }
}
