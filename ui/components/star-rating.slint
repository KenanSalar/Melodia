import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

// Inline 0–5 star rating control. Five `MaterialIcon` glyphs, each its own
// `TouchArea` so hit-testing is per-star. Clicking star N (1-based) sets the
// rating to N; clicking the current top star clears it back to 0 (the same
// "click-again-to-toggle-off" affordance as the favorite heart).
//
// When mounted inside a track row's `touch := TouchArea` (the hover-revealed
// strip in `track-list-row.slint`), the per-star TouchAreas are descendants of
// that row TouchArea, so hovering a star keeps the row's `has-hover` true and
// the strip stays mounted — same reason the favorite/checkbox TouchAreas live
// inside the row `touch`.
//
// Read-only when `enabled: false` (cursor stays default, clicks are ignored).
export component StarRating {
    in property <int> rating;              // 0–5 (values outside are clamped by callers)
    in property <bool> enabled: true;
    in property <length> star-size: 18px;

    callback rated(int /*new_rating*/);

    HorizontalLayout {
        spacing: 1px;
        alignment: start;

        for i in 5: Rectangle {
            property <int> idx: i + 1;
            width: root.star-size;
            height: root.star-size;

            MaterialIcon {
                name: parent.idx <= root.rating ? "star" : "star_border";
                icon-size: root.star-size;
                icon-color: parent.idx <= root.rating ? Theme.yellow : Theme.subtext0;
                filled: parent.idx <= root.rating;
            }

            TouchArea {
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    if (root.enabled) {
                        // Clicking the current top star clears the rating.
                        root.rated(parent.idx == root.rating ? 0 : parent.idx);
                    }
                }
            }
        }
    }
}
