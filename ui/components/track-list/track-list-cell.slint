import { Theme } from "../../theme.slint";

// One text cell in the Tracks table — the shared shape used by the artist,
// album, and genre columns. A width-bounded `Rectangle { clip; }` holding a
// centered Text with LRM-prefixed content and `overflow: elide`.
//
// Title (artwork + favorite badge), number (checkbox), year (no LRM, no
// elide), and length (favorite-on-hover swap) are structurally different
// and stay inline in `track-list-row.slint`.
//
// Visibility is gated at the CALL SITE with `if Tracks.show-*: DataCell { … }`
// (matches the header). An internal `show` toggle does not work: a
// `DataCell { show: false }` is still a child of the row's HorizontalLayout
// and reserves an 8 px `spacing` slot that `total-w` in globals.slint does
// not account for, drifting cells away from the header. Inheriting from
// `Rectangle` and binding `width: cell-width` at the wrapper level is also
// load-bearing — without it the parent HorizontalLayout doesn't pin this
// slot to `cell-width`, and resizing a sibling column makes the cell drift
// off-grid (artist text bleeds over the title column).
//
// Properties:
//   * `cell-width`   — fixed width matching the header column.
//   * `text-content` — value to render. The component prepends U+200E
//                       (LRM) so `overflow: elide` renders the ellipsis at
//                       the right edge regardless of script direction.
//   * `playing`      — whether this row is the currently playing track;
//                       drives the accent-vs-subtext0 colour swap.
export component DataCell inherits Rectangle {
    in property <length> cell-width;
    in property <string> text-content;
    in property <bool> playing;

    width: root.cell-width;
    clip: true;
    VerticalLayout {
        alignment: center;
        Text {
            text: "‎" + root.text-content;
            color: root.playing ? Theme.accent : Theme.subtext0;
            font-size: Theme.font-size-row;
            overflow: elide;
        }
    }
}
