import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// Generic "icon · label/description · control" row used inside SectionCards.
// The right-hand control comes in via `@children`; the host puts a single
// element there (toggle, dropdown, chip group, button, …).
//
// `disabled`: lowers opacity to 0.4 *and* overlays a sibling TouchArea that
// swallows pointer events so the inner control's TouchArea can't fire. Slint
// has no automatic enabled-propagation across `@children`, so this is the
// cleanest way to gate clicks without forcing every consumer's control to
// thread a `disabled` property through.
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    in property <bool>   disabled: false;
    // Caps the description text's width so a long single-line string
    // (e.g. an updater changelog) wraps into a fixed reading column
    // instead of inflating the row's preferred width and stretching the
    // whole section card. The large default is a sentinel meaning
    // "unbounded" — only rows that need it override this.
    in property <length> description-max-width: 100000px;

    background: transparent;
    opacity: root.disabled ? 0.4 : 1.0;
    animate opacity { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-lg;
        alignment: stretch;

        // Icon column — pinned width so the label column starts at a
        // consistent x across rows even when an icon glyph is narrower.
        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 22px;
                icon-color: Theme.text;
            }
        }

        // Label + optional description, vertically centred.
        VerticalLayout {
            alignment: center;
            spacing: Theme.pad-xs;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-size-md;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                max-width: root.description-max-width;
            }
        }

        // Control slot. The consumer's element decides its own width;
        // we centre it vertically so a 32 px toggle or a 36 px button
        // sits in the row middle.
        VerticalLayout {
            alignment: center;
            spacing: Theme.pad-sm;
            @children
        }
    }

    // Disabled overlay: an enabled TouchArea above the row contents
    // absorbs clicks (no `clicked =>` handler → the click stops here).
    // When `disabled` is false the overlay is absent from the layout
    // tree, so events pass through to the inner control normally.
    if root.disabled: TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: default;
    }
}
