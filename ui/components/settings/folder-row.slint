import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { IconButton } from "../icon-button.slint";

// One folder entry in the Library section: filled folder icon (accent),
// path text (elided), `last-scanned` meta tag (empty hides the meta line),
// and refresh / delete icon buttons on the right. Mirrors Tauri's
// `.folder-row` block.
export component FolderRow inherits Rectangle {
    in property <string> path;
    // Pre-formatted display string from Rust; e.g. "scanned 2 hours ago".
    // Empty string means the folder hasn't been scanned yet — meta line
    // hidden in that case.
    in property <string> last-scanned;
    // Disable the row's action buttons (rescan / remove) while a scan is
    // in flight. Bound from `library-section.slint` to
    // `!LibrarySettings.scanning` so two concurrent rescans can't fight
    // for the shared `scan_progress_tx` watch channel.
    in property <bool> actions-enabled: true;

    callback rescan-clicked();
    callback remove-clicked();

    background: transparent;

    HorizontalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: "folder";
                icon-size: 22px;
                icon-color: Theme.accent;
                filled: true;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.pad-xs;
            horizontal-stretch: 1;

            Text {
                text: root.path;
                color: Theme.text;
                font-size: Theme.font-size-md;
                overflow: elide;
            }
            if root.last-scanned != "": Text {
                text: root.last-scanned;
                color: Theme.subtext0;
                font-size: Theme.font-size-sm;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.pad-xs;
                IconButton {
                    icon: "refresh";
                    diameter: 32px;
                    icon-size: 18px;
                    tooltip-text: @tr("Rescan");
                    button-enabled: root.actions-enabled;
                    clicked => { root.rescan-clicked(); }
                }
                IconButton {
                    icon: "delete";
                    diameter: 32px;
                    icon-size: 18px;
                    idle-fg: Theme.text;
                    // Bind to the semantic role token, not the raw `red`
                    // palette entry, so themes can override the destructive
                    // colour without touching the rest of the palette.
                    // `hover-fg` (not `active-fg`) — `active` is the toggled
                    // state and never flips here; we want the recolour on
                    // pointer hover.
                    hover-fg: Theme.danger;
                    tooltip-text: @tr("Remove");
                    button-enabled: root.actions-enabled;
                    clicked => { root.remove-clicked(); }
                }
            }
        }
    }
}
