import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";

// Single [−] / [+] icon button used inside the Stepper. Disabled-friendly
// dimming + cursor; clicking fires `clicked()` only when enabled.
component StepButton inherits Rectangle {
    in property <string> icon;
    in property <bool>   button-enabled: true;

    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: self.width / 2;
    background: !root.button-enabled
        ? transparent
        : (touch.has-hover ? Theme.surface2 : Theme.surface1);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    opacity: root.button-enabled ? 1.0 : 0.4;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            MaterialIcon {
                name: root.icon;
                icon-size: 18px;
                icon-color: Theme.text;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if (root.button-enabled) { root.clicked(); }
        }
    }
}

// Numeric stepper: [−] value [+]. Shows `value` (a length, in px) between
// the two buttons; clicks clamp to [`min`, `max`] and fire `changed(int)`
// with the new integer px value (so the host can persist a plain number).
export component Stepper inherits Rectangle {
    in-out property <int> value;
    in property <int> min: 0;
    in property <int> max: 24;
    in property <int> step: 1;
    in property <string> unit: "px";

    callback changed(int);

    height: 32px;
    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: Theme.pad-xs;
        alignment: end;

        VerticalLayout {
            alignment: center;
            StepButton {
                icon: "remove";
                button-enabled: root.value > root.min;
                clicked => {
                    root.value = Math.max(root.min, root.value - root.step);
                    root.changed(root.value);
                }
            }
        }

        Rectangle {
            width: 56px;
            height: 28px;
            border-radius: Theme.radius-sm;
            background: Theme.surface1;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.value + " " + root.unit;
                        color: Theme.text;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            StepButton {
                icon: "add";
                button-enabled: root.value < root.max;
                clicked => {
                    root.value = Math.min(root.max, root.value + root.step);
                    root.changed(root.value);
                }
            }
        }
    }
}
