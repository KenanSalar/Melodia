import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { TagEditor } from "../../globals.slint";
import { LabeledInput } from "../labeled-input.slint";
import { ChipGroup } from "../settings/chip-group.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { PillButton } from "../action-pill.slint";
import { MultilineInput } from "../multiline-input.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";

// One read-only "Label  Value" row for the Summary tab. Private — only useful
// inside this body.
component SummaryRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Theme.pad-md;

    Text {
        text: root.label;
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        width: 108px;
        horizontal-stretch: 0;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Theme.font-size-sm;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

// Edit-Track-Information body (`Dialog.kind == "edit-tags"`). Left column is the
// cover panel; the right column is a `ChipGroup` tab bar over Tags / Lyrics /
// Summary. Every input two-way-binds a `TagEditor` field; Rust owns the
// snapshot + tri-state diff. The Lyrics and Summary tabs are single-selection
// only — driven off `track-count`: their chips aren't in the `options` list in
// multi mode (never merely disabled) and their bodies are `if`-gated on
// `track-count == 1` (never `visible: false`, slint#7377).
export component TagEditorBody inherits HorizontalLayout {
    spacing: Theme.pad-lg;

    // Fixed body height so switching tabs doesn't resize + recenter the card.
    private property <length> body-h: 360px;

    // --- Left column: cover + artwork actions ---
    VerticalLayout {
        horizontal-stretch: 0;
        spacing: Theme.pad-sm;

        ArtworkImage {
            cover: TagEditor.cover;
            tile-size: 160px;
            tile-radius: Theme.radius-md;
            fallback-icon: "album";
        }
        PillButton {
            text: @tr("Replace…");
            icon: "image";
            clicked => { TagEditor.pick-artwork(); }
        }
        if TagEditor.has-cover: PillButton {
            text: @tr("Remove");
            icon: "delete";
            danger: true;
            clicked => { TagEditor.remove-artwork(); }
        }
        // Trailing stretch pins the cover + pills to the top of the taller
        // right column (VerticalLayout otherwise divides surplus equally).
        Rectangle { vertical-stretch: 1; }
    }

    // --- Right column: tab bar + body ---
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.pad-md;

        // `@tr` only translates literal strings, so the multi/single tab sets
        // are two inline literal arrays (the settings-view pattern), not a
        // Rust-seeded `[string]`.
        ChipGroup {
            options: TagEditor.track-count == 1
                ? [@tr("Tags"), @tr("Lyrics"), @tr("Summary")]
                : [@tr("Tags")];
            selected-index <=> TagEditor.active-tab;
        }

        // Fixed-height body region. Children fill it via width/height 100%
        // (valid here — the parent is a plain Rectangle with an explicit
        // height, not a layout, so its size isn't derived from the children).
        Rectangle {
            height: root.body-h;

            // Tags tab — scrolling list of fields.
            if TagEditor.active-tab == 0: Rectangle {
                width: 100%;
                height: 100%;

                tags-sv := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: always-off;
                    // Lock content width to the viewport so the stretchy inputs
                    // fill the width instead of collapsing to ~0 (the
                    // smart-editor pitfall, CLAUDE.md "lock viewport-width").
                    viewport-width: tags-sv.visible-width;

                    VerticalLayout {
                        spacing: Theme.pad-sm;
                        padding-right: Theme.pad-md;

                        LabeledInput {
                            label: @tr("Title");
                            placeholder: TagEditor.title-placeholder;
                            text <=> TagEditor.title;
                        }
                        LabeledInput {
                            label: @tr("Artist");
                            placeholder: TagEditor.artist-placeholder;
                            text <=> TagEditor.artist;
                        }
                        LabeledInput {
                            label: @tr("Album");
                            placeholder: TagEditor.album-placeholder;
                            text <=> TagEditor.album;
                        }
                        LabeledInput {
                            label: @tr("Album Artist");
                            placeholder: TagEditor.album-artist-placeholder;
                            text <=> TagEditor.album-artist;
                        }
                        LabeledInput {
                            label: @tr("Genre");
                            placeholder: TagEditor.genre-placeholder;
                            text <=> TagEditor.genre;
                        }
                        LabeledInput {
                            label: @tr("Composer");
                            placeholder: TagEditor.composer-placeholder;
                            text <=> TagEditor.composer;
                        }

                        // Year / Track / Disc share one row.
                        HorizontalLayout {
                            spacing: Theme.pad-sm;
                            LabeledInput {
                                label: @tr("Year");
                                placeholder: TagEditor.year-placeholder;
                                text <=> TagEditor.year;
                            }
                            LabeledInput {
                                label: @tr("Track");
                                placeholder: TagEditor.track-number-placeholder;
                                text <=> TagEditor.track-number;
                            }
                            LabeledInput {
                                label: @tr("Disc");
                                placeholder: TagEditor.disc-number-placeholder;
                                text <=> TagEditor.disc-number;
                            }
                        }

                        LabeledInput {
                            label: @tr("Original Year");
                            placeholder: TagEditor.original-year-placeholder;
                            text <=> TagEditor.original-year;
                        }
                        LabeledInput {
                            label: @tr("BPM");
                            placeholder: TagEditor.bpm-placeholder;
                            text <=> TagEditor.bpm;
                        }
                        LabeledInput {
                            label: @tr("Comment");
                            placeholder: TagEditor.comment-placeholder;
                            text <=> TagEditor.comment;
                        }
                    }
                }

                OverlayScrollbar {
                    horizontal: false;
                    x: parent.width - self.width;
                    y: 0;
                    width: 10px;
                    height: parent.height;
                    visible-size: tags-sv.visible-height;
                    content-size: tags-sv.viewport-height;
                    offset: -tags-sv.viewport-y;
                    scroll-to(o) => { tags-sv.viewport-y = -o; }
                }
            }

            // Lyrics tab — single selection only.
            if TagEditor.active-tab == 1 && TagEditor.track-count == 1: MultilineInput {
                width: 100%;
                height: 100%;
                placeholder: TagEditor.lyrics-placeholder;
                text <=> TagEditor.lyrics;
            }

            // Summary tab — read-only file info, single selection only.
            if TagEditor.active-tab == 2 && TagEditor.track-count == 1: Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: Theme.pad-xs;
                    alignment: start;

                    SummaryRow { label: @tr("Path"); value: TagEditor.summary-path; }
                    SummaryRow { label: @tr("Codec"); value: TagEditor.summary-codec; }
                    SummaryRow { label: @tr("Bitrate"); value: TagEditor.summary-bitrate; }
                    SummaryRow { label: @tr("Sample Rate"); value: TagEditor.summary-sample-rate; }
                    SummaryRow { label: @tr("Bit Depth"); value: TagEditor.summary-bit-depth; }
                    SummaryRow { label: @tr("Channels"); value: TagEditor.summary-channels; }
                    SummaryRow { label: @tr("Size"); value: TagEditor.summary-size; }
                    SummaryRow { label: @tr("Duration"); value: TagEditor.summary-duration; }
                    SummaryRow { label: @tr("Modified"); value: TagEditor.summary-modified; }
                    SummaryRow { label: @tr("BLAKE3"); value: TagEditor.summary-hash; }
                }
            }
        }
    }
}
