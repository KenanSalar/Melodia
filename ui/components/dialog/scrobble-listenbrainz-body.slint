import { Theme } from "../../theme.slint";
import { ScrobbleUi } from "../../globals.slint";
import { LabeledInput } from "../labeled-input.slint";

// Body for `Dialog.kind == "scrobble-listenbrainz-login"`: paste a user token and
// verify it. The token two-way binds to `ScrobbleUi.lb-token`; Enter (or the
// dialog's Connect button) fires `listenbrainz-verify`. State lives on the
// `ScrobbleUi` global, owned by `src/ui/scrobbling_settings.rs`.
export component ScrobbleListenbrainzBody inherits VerticalLayout {
    spacing: Theme.pad-md;

    LabeledInput {
        label: @tr("User token");
        placeholder: @tr("Paste your ListenBrainz user token");
        text <=> ScrobbleUi.lb-token;
        accepted => {
            if (ScrobbleUi.lb-token != "" && !ScrobbleUi.busy) {
                ScrobbleUi.listenbrainz-verify(ScrobbleUi.lb-token);
            }
        }
    }

    Text {
        text: @tr("Find your token on your ListenBrainz profile settings page.");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }

    if ScrobbleUi.busy: Text {
        text: @tr("Connecting…");
        color: Theme.subtext0;
        font-size: Theme.font-size-sm;
    }

    if ScrobbleUi.error != "": Text {
        text: ScrobbleUi.error;
        color: Theme.danger;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
