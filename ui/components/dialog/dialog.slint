import { Theme } from "../../theme.slint";
import { Dialog as DialogGlobal } from "../../globals.slint";
import { SectionButton } from "../settings/section-button.slint";
import { PlaylistMosaicPicker } from "playlist-mosaic-picker.slint";
import { PlaylistPicker } from "playlist-picker.slint";
import { EqualizerBody } from "equalizer-body.slint";
import { LabeledInput } from "../labeled-input.slint";
import { MaterialIcon } from "../material-icon.slint";

// Reusable modal overlay driven by the `Dialog` global. Mounted once at the
// root of `app-window.slint`; consumers set `Dialog.title` / `Dialog.message`
// + labels + (optionally) `destructive` / `kind` / `target-id` then flip
// `Dialog.open = true`. The Cancel button is rendered as a conditional
// element (CLAUDE.md "visible: false does not remove an element from
// layout") only when `Dialog.cancel-label != ""`, so info-only dialogs
// keep their primary button flush right with no phantom slot.
//
// Animation strategy (per CLAUDE.md "animating bindings derived from another
// animating property phase-lags"): only `t` animates. The backdrop's
// background-alpha and the card's opacity / y-offset are pure derivations of
// `t` — no `animate` blocks of their own. `x` is centered via `(parent.width
// - self.width) / 2` and is *not* animated since `width` itself isn't
// animating.
//
// The card derives a *faster* `card-t = min(1.0, t * 1.5)` so its small-area
// fade-in finishes around 67 % of the animation, landing at roughly the
// moment the backdrop's 0.45-alpha dim hits its perceptual ceiling. Without
// this bias the uniform full-viewport dim "wins the race" and the card
// reads as appearing after the dim, even though both literally start at the
// same instant.
//
// We always render the overlay (don't gate it via `if Dialog.open`) so the
// closing animation can play after `open` flips back to false. The
// backdrop's TouchArea is `enabled: DialogGlobal.open;` so it doesn't catch
// pointer events while the overlay is invisible.
export component DialogOverlay inherits Rectangle {
    width: 100%;
    height: 100%;

    // 0 → fully closed (invisible, doesn't catch input);
    // 1 → fully open. Toggled by `Dialog.open` and animated.
    private property <float> t: DialogGlobal.open ? 1.0 : 0.0;
    animate t { duration: Theme.dur-fast; easing: ease-out; }

    // Tracks the falling edge of the close animation. Starts true so the
    // initial layout pass (which settles directly at t=0) doesn't fire
    // `closed` on mount. Flips false once t crosses into the open region,
    // flips back true — and fires `DialogGlobal.closed()` — when t
    // returns to ~0 after the animation completes. This is the only
    // safe moment to clear `kind` / `mosaic-*` / `input-text` etc.,
    // because doing so any earlier would unmount the body branch
    // (`if DialogGlobal.kind == "..."`) mid-fade.
    private property <bool> fully-closed: true;
    changed t => {
        if (root.t > 0.99) {
            root.fully-closed = false;
        } else if (root.t < 0.001 && !root.fully-closed) {
            root.fully-closed = true;
            DialogGlobal.closed();
        }
    }

    // Card progress — pure derivation of `t`, biased so the card reaches
    // full visibility at ~67 % of the animation. See the strategy comment
    // above. Pure derivation, no `animate` block (would phase-lag).
    private property <float> card-t: min(1.0, root.t * 1.5);

    // Backdrop: dark transparent fill. Click anywhere outside the card to
    // dismiss. The TouchArea must be the topmost backdrop element so it
    // catches clicks falling through from outside the card.
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45 * root.t);
    }
    backdrop-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: DialogGlobal.open;
        mouse-cursor: pointer;
        clicked => {
            // Backdrop dismiss is treated as cancel so the centralised
            // dispatcher cleans up `kind` / `target-id` and any future
            // listener can distinguish "user accepted" from "user dismissed".
            DialogGlobal.cancelled();
            DialogGlobal.open = false;
        }
    }

    // Centered card. min/max width clamps to a comfortable reading width
    // even on a narrow window. The mosaic-picker kind gets a wider
    // ceiling so the candidate grid + preview have room. `card-touch`
    // swallows clicks on the card itself so they don't bubble to the
    // backdrop dismiss handler.
    card := Rectangle {
        // Mosaic-picker bumps a bit above the default to give the
        // preview tile + wrapping candidate grid room without
        // pinching, but stays close to the regular dialog footprint
        // (Tauri shipped its `EditPlaylistDialog` at 480 px).
        property <length> max-w:
            DialogGlobal.kind == "equalizer" ? 600px
            : DialogGlobal.kind == "edit-playlist-artwork" ? 520px
            : 540px;
        // Header icon for confirmation kinds — empty for form / picker
        // kinds (create-playlist, rename-playlist, edit-playlist-artwork),
        // which keep the simple title-only header. Mapped by kind so
        // callers don't have to set an extra field; the icon tile colour
        // is driven independently by `DialogGlobal.destructive`.
        property <string> kind-icon:
            DialogGlobal.kind == "delete-playlist" ? "delete" :
            DialogGlobal.kind == "remove-playlist-selected" ? "playlist_remove" :
            DialogGlobal.kind == "remove-queue-selected" ? "playlist_remove" :
            DialogGlobal.kind == "remove-folder" ? "folder_off" :
            DialogGlobal.kind == "clear-queue" ? "clear_all" :
            DialogGlobal.kind == "restart-titlebar" ? "restart_alt" :
            "";
        width: min(self.max-w, max(360px, parent.width - 96px));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1.0 - root.card-t) * 12px;
        height: layout.preferred-height;
        background: Theme.surface0;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-lg;
        opacity: root.card-t;
        // Block input on the card itself when closed so a stale click can't
        // hit a button mid-fade-out.
        visible: root.card-t > 0.01;

        card-touch := TouchArea {
            width: 100%;
            height: 100%;
            enabled: DialogGlobal.open;
            // Catch and discard clicks on the card body so the backdrop's
            // dismiss handler doesn't fire. Buttons inside have their own
            // TouchAreas and trigger first (closer in the tree).
            clicked => { }
        }

        layout := VerticalLayout {
            padding: Theme.pad-lg;
            spacing: Theme.pad-md;

            // Header row — confirmation kinds get a leading kind-icon
            // tile (danger-tinted when destructive, accent-tinted
            // otherwise). Form/picker kinds set `kind-icon` to "" so
            // the tile is unmounted and the body VL hugs the left edge
            // like the original simple title header.
            HorizontalLayout {
                spacing: Theme.pad-md;
                alignment: start;

                if card.kind-icon != "": Rectangle {
                    width: 48px;
                    height: 48px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    border-radius: Theme.radius-md;
                    background: DialogGlobal.destructive
                        ? Theme.danger.with-alpha(0.15)
                        : Theme.accent.with-alpha(0.15);
                    MaterialIcon {
                        name: card.kind-icon;
                        icon-size: 28px;
                        icon-color: DialogGlobal.destructive
                            ? Theme.danger
                            : Theme.accent;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.pad-xs;

                    Text {
                        text: DialogGlobal.title;
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    // Message — hidden when empty so input-only dialogs
                    // (Create Playlist, Rename Playlist) don't reserve a
                    // stale row.
                    if DialogGlobal.message != "": Text {
                        text: DialogGlobal.message;
                        color: Theme.subtext0;
                        font-size: Theme.font-size-md;
                        wrap: word-wrap;
                    }
                }
            }

            // Form body for `"create-playlist"` and `"rename-playlist"`
            // kinds — Name + optional Description, mirroring the Tauri
            // dialogs. Both fields use the shared `LabeledInput`
            // component; the dispatcher in `globals.slint` reads
            // `input-text` (name) and `input-text-2` (description) on
            // Accept. Enter inside either field commits the dialog so
            // the keyboard-only flow works (Tauri parity); we gate the
            // commit on a non-empty name so empty playlists aren't
            // created.
            //
            // No auto-focus on init — calling `focus()` during dialog
            // open re-enters Slint's property evaluator and trips the
            // "Recursion detected" guard. Users click into a field.
            if DialogGlobal.kind == "create-playlist"
                || DialogGlobal.kind == "rename-playlist": VerticalLayout {
                spacing: Theme.pad-sm;

                LabeledInput {
                    label: @tr("Name");
                    placeholder: @tr("Playlist name");
                    text <=> DialogGlobal.input-text;
                    accepted => {
                        if (DialogGlobal.input-text != "") {
                            DialogGlobal.accepted();
                            DialogGlobal.open = false;
                        }
                    }
                }

                LabeledInput {
                    label: @tr("Description (optional)");
                    placeholder: @tr("Add a description…");
                    text <=> DialogGlobal.input-text-2;
                    accepted => {
                        if (DialogGlobal.input-text != "") {
                            DialogGlobal.accepted();
                            DialogGlobal.open = false;
                        }
                    }
                }
            }

            // Mosaic picker body — rendered for the
            // `"edit-playlist-artwork"` kind. The picker reads from
            // `Dialog.mosaic-candidates` and mutates
            // `Dialog.mosaic-selection`; the dispatcher routes to
            // `Playlists.apply-mosaic` / `clear-artwork` on Accept.
            if DialogGlobal.kind == "edit-playlist-artwork": PlaylistMosaicPicker { }

            // Add-to-Playlist picker body — rendered for the
            // `"add-to-playlist"` kind. Each row commits inline on
            // click (`Playlists.add-tracks` + `Dialog.open = false`);
            // there is no `accepted` branch and the primary/Apply
            // button below is suppressed for this kind.
            if DialogGlobal.kind == "add-to-playlist": PlaylistPicker { }

            // Graphic-equalizer body — enable toggle + preset dropdown + ten
            // band sliders + reset. Drives the `Equalizer` global; changes
            // apply live and persist. The footer keeps just the "Done" button
            // (the caller sets `cancel-label` empty).
            if DialogGlobal.kind == "equalizer": EqualizerBody { }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.pad-sm;
                padding-top: Theme.pad-sm;

                // Cancel only renders in confirm-mode (cancel-label set).
                // `if … :` form removes it from the layout tree entirely
                // when absent — `visible: false` would still claim space.
                if DialogGlobal.cancel-label != "": SectionButton {
                    label: DialogGlobal.cancel-label;
                    icon: "";
                    primary: false;
                    button-enabled: DialogGlobal.open;
                    clicked => {
                        DialogGlobal.cancelled();
                        DialogGlobal.open = false;
                    }
                }

                // The `"add-to-playlist"` picker commits inline on row
                // click (no separate Apply), so its primary button is
                // unmounted entirely. The Cancel button still renders
                // (its `if cancel-label != ""` guard above keeps it
                // alive because the menu click sets a non-empty
                // `cancel-label`).
                if DialogGlobal.kind != "add-to-playlist": SectionButton {
                    label: DialogGlobal.confirm-label;
                    icon: "";
                    primary: true;
                    destructive: DialogGlobal.destructive;
                    // Playlist Create / Rename kinds disable Save until
                    // the Name field is non-empty. The dispatcher
                    // (`globals.slint`) already gates the actual commit
                    // on the same condition, but a disabled button
                    // surfaces the requirement visually instead of
                    // silently no-op'ing on click. All other kinds
                    // stay enabled whenever the dialog is open.
                    button-enabled: DialogGlobal.open
                        && ((DialogGlobal.kind != "create-playlist"
                                && DialogGlobal.kind != "rename-playlist")
                            || DialogGlobal.input-text != "");
                    clicked => {
                        DialogGlobal.accepted();
                        DialogGlobal.open = false;
                    }
                }
            }
        }
    }
}
