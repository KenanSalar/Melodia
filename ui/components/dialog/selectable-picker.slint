import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { MaterialIcon } from "../material-icon.slint";
import { OverlayScrollbar } from "../overlay-scrollbar.slint";

// Generic, data-agnostic building blocks for the selectable-list dialogs
// (Add-to-Playlist, Export-playlists). Each component takes plain `in`
// properties and exposes callbacks — it knows nothing about which dialog or
// model drives it, so both pickers share one implementation (the `Playlists`
// / `Dialog` globals are wired by the host picker, not here).
//
// Rendering note (load-bearing): none of the row/list elements carry a
// `border` or `clip: true`. A rounded clip — or a border — on an element that
// contains the rows promotes that subtree to a FemtoVG compositing layer
// whose offscreen texture is allocated at logical size and then upscaled by
// the display scale factor when blitted, so the row text reads blurry and
// oversized next to the directly-rendered header. The tonal fill + filled
// indicator carry the selection state on their own, and `PickerListCard`
// paints its rounded border with a childless overlay (which needs no layer).

// Circular tri-state selection indicator (M3 expressive): a filled accent
// disc with a check glyph when checked, a filled disc with a dash for the
// header's indeterminate (some-but-not-all) state, and a hollow ring
// otherwise.
export component SelectIndicator inherits Rectangle {
    in property <bool> checked;
    in property <bool> indeterminate;

    private property <bool> active: root.checked || root.indeterminate;

    width: 24px;
    height: 24px;
    border-radius: self.width / 2;
    background: root.active ? Theme.accent : transparent;
    border-width: root.active ? 0px : 2px;
    border-color: Theme.overlay0;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
    animate border-color { duration: Theme.dur-fast; easing: ease-in-out; }

    if root.active: MaterialIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.indeterminate ? "remove" : "check";
        icon-size: 16px;
        icon-color: Theme.accent-text;
    }
}

// Selectable list item: leading artwork tile, title + optional subtitle,
// trailing circular selection indicator. The host supplies the already-
// formatted `subtitle` (empty ⇒ no subtitle line) and the resolved `cover`
// image, so the row stays decoupled from the data source. `disabled` dims it
// and blocks the click. Its `height` MUST match `PickerListCard.row-h`.
export component SelectableRow inherits Rectangle {
    in property <string> name;
    in property <string> subtitle;
    in property <image> cover;
    in property <string> artwork-path;
    in property <string> fallback-icon: "playlist";
    in property <bool> selected;
    in property <bool> disabled;
    callback toggled();

    height: 60px;
    border-radius: Theme.radius-md;
    opacity: root.disabled ? 0.5 : 1.0;
    // Selected rows fill with a tonal accent container; unselected rows are
    // flat with a soft hover fill. See the file-level rendering note for why
    // there is deliberately no border.
    background: root.selected
        ? Theme.accent.with-alpha(0.16)
        : (touch.has-hover && !root.disabled ? Theme.surface1 : transparent);
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-md;
        alignment: start;

        VerticalLayout {
            alignment: center;
            ArtworkImage {
                tile-size: 44px;
                tile-radius: Theme.radius-md;
                artwork-path: root.artwork-path;
                cover: root.cover;
                fallback-icon: root.fallback-icon;
                // Subtle expressive zoom on hover (same idiom as the grid
                // cards / now-playing bar); skipped while disabled.
                cover-scale: touch.has-hover && !root.disabled ? 1.05 : 1.0;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: root.selected ? Theme.accent : Theme.subtext0;
                font-size: Theme.font-size-sm;
                overflow: elide;
                animate color { duration: Theme.dur-fast; easing: ease-in-out; }
            }
        }

        VerticalLayout {
            alignment: center;
            SelectIndicator { checked: root.selected; }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// "Select all" header: tri-state indicator + label + a count chip that turns
// accent once at least one row is selected.
export component SelectAllHeader inherits Rectangle {
    in property <bool> checked;
    in property <bool> indeterminate;
    in property <int> selected-count;
    callback toggled();

    height: 52px;
    border-radius: Theme.radius-md;
    background: header-touch.has-hover ? Theme.surface1 : Theme.surface0;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        spacing: Theme.pad-md;
        alignment: start;

        VerticalLayout {
            alignment: center;
            SelectIndicator {
                checked: root.checked;
                indeterminate: root.indeterminate;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: @tr("Select all");
                color: Theme.text;
                font-size: Theme.font-size-md;
                font-weight: 600;
            }
        }
        // Count chip.
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                width: chip-l.preferred-width;
                border-radius: self.height / 2;
                background: root.selected-count > 0
                    ? Theme.accent.with-alpha(0.18)
                    : Theme.surface1;
                animate background { duration: Theme.dur-fast; easing: ease-in-out; }

                chip-l := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text {
                        text: @tr("{} selected", root.selected-count);
                        color: root.selected-count > 0
                            ? Theme.accent
                            : Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    header-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Rounded card holding a virtualizing-ish scroll list of `SelectableRow`s.
// The host passes `row-count` and drops its `for … : SelectableRow {}` into
// `@children`. This is where the blur fix lives (see the file-level note):
// no `clip` / no `border` on the element that contains the rows; the
// ScrollView clips its viewport rectangularly (a cheap scissor, no layer),
// and the rounded border is a childless overlay sibling.
export component PickerListCard inherits Rectangle {
    in property <int> row-count;
    in property <length> list-max-height: 312px;

    // Shared list geometry — every selectable picker uses the same row height
    // and gaps, so this card sizes itself from `row-count` alone. `row-h`
    // MUST equal `SelectableRow.height`.
    private property <length> row-h: 60px;
    private property <length> row-spacing: 4px;
    private property <length> pad: 6px;
    private property <length> content-h:
        root.row-count * root.row-h
        + (root.row-count > 0 ? (root.row-count - 1) * root.row-spacing : 0px)
        + 2 * root.pad;

    height: min(root.list-max-height, root.content-h);
    background: Theme.surface0;
    border-radius: Theme.radius-md;

    sv := ScrollView {
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        viewport-width: self.visible-width;
        viewport-height: root.content-h;

        VerticalLayout {
            padding: root.pad;
            spacing: root.row-spacing;
            @children
        }
    }

    // Rounded 1 px border painted on top of the (rectangularly-clipped) scroll
    // content. Childless ⇒ a direct rounded-rect stroke, never a compositing
    // layer; a plain Rectangle has no TouchArea, so it doesn't intercept the
    // rows' clicks or the scroll wheel underneath.
    Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;
    }

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 10px;
        height: parent.height - 4px;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        scroll-to(o) => { sv.viewport-y = -o; }
    }
}
