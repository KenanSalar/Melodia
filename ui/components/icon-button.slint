import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";
import { Tooltip } from "tooltip.slint";

// Generic icon-only button with hover/pressed/active visual states.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 22px;
    in property <length> diameter: 36px;
    in property <bool> active: false;
    // Render glyph from the FILL=1 Material Symbols variant. Pass-through
    // to `MaterialIcon.filled`. Used by the now-playing bar's favorite /
    // pin buttons so the active state reads as a solid glyph instead of
    // an outlined one (Tauri parity).
    in property <bool> filled: false;
    in property <bool> button-enabled: true;
    // Force the hover background to paint regardless of pointer position.
    // Used by popup triggers (overflow / volume) to keep the highlight
    // while their popup is open — see `PopupHighlight` in `globals.slint`.
    in property <bool> force-bg: false;
    in property <brush> idle-bg: transparent;
    // Hover-state background fill. Defaults to `Theme.surface0` so existing
    // call sites are unchanged; override when the button sits on a
    // `surface0` surface (e.g. a notification card) where the default
    // hover fill would be invisible against the host background.
    in property <brush> hover-bg: Theme.surface0;
    // Tauri parity: active state changes only the icon color, not the
    // background (`.controlButton.active { color: var(--ctp-accent); }`).
    in property <brush> active-bg: transparent;
    in property <brush> active-fg: Theme.accent;
    in property <brush> idle-fg: Theme.text;
    // Hover-state icon colour. Defaults to `idle-fg` so existing call
    // sites are unchanged; set explicitly (e.g. `Theme.danger` for a
    // destructive action) to recolour the glyph on hover. Independent
    // from `active-fg`, which is the toggled-state colour.
    in property <brush> hover-fg: root.idle-fg;
    in property <string> tooltip-text: "";
    // Force the tooltip to show without hover (e.g. keyboard-driven
    // volume changes raise the now-playing-bar volume button's tooltip).
    // Falls through to `Tooltip.force-shown`.
    in property <bool> force-tooltip: false;
    // Opt-in tactile press-shrink: scales the inner disc to 0.9× while
    // held, snapping back with the same expressive overshoot easing the
    // play button uses. Off by default so existing call sites (browse
    // view, queue sheet, folder rows, …) are unchanged; the now-playing
    // bar enables it on every transport / control button.
    in property <bool> press-shrink: false;
    // Mirror of the internal TouchArea's hover state. Lets a parent
    // gate other visuals (e.g. a fade-in overlay) on EITHER the
    // parent's own hover OR a child `IconButton`'s hover, since
    // Slint's higher-z TouchArea "captures" the pointer and flips the
    // outer TouchArea's `has-hover` false (see EntityCard's overlay).
    out property <bool> has-hover: touch.has-hover;

    callback clicked();

    width: diameter;
    height: diameter;
    background: transparent;

    // Press-shrink factor — 0.9 while held, 1.0 otherwise. The *factor*
    // is what's animated (with the play button's overshoot easing), not
    // the derived `width`/`height`: those also change when `diameter` /
    // `icon-size` change (e.g. window resize re-clamps the now-playing
    // bar's `btn-d`), and animating them directly would wobble the
    // button on every resize tick. Animating only the factor confines
    // the wobble to actual presses. Stays 1.0 when `press-shrink` is off.
    property <float> press-scale: root.press-shrink && touch.pressed ? 0.9 : 1.0;
    animate press-scale {
        duration: touch.pressed ? 100ms : Theme.dur-med;
        easing: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    // Inner visual element. The root keeps a fixed `diameter` layout slot
    // so siblings in a HorizontalLayout never reflow; the disc is what
    // actually scales.
    disc := Rectangle {
        width: root.diameter * root.press-scale;
        height: root.diameter * root.press-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: !root.button-enabled
            ? root.idle-bg
            : ((touch.has-hover || root.force-bg)
                ? root.hover-bg
                : (root.active ? root.active-bg : root.idle-bg));

        animate background { duration: Theme.dur-fast; easing: ease-in-out; }

        // Center the icon inside the button using nested layouts — Slint
        // doesn't auto-center a child inside a Rectangle.
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: root.icon;
                    // Scales with the disc so the glyph wobbles along
                    // with the chrome instead of sitting static on top.
                    icon-size: root.icon-size * root.press-scale;
                    filled: root.filled;
                    // Active (toggled) wins over hover so a hovered+active
                    // button still reads as active. Otherwise hover wins
                    // over idle to support destructive cues like the
                    // folder trash icon.
                    icon-color: !root.button-enabled
                        ? Theme.overlay0
                        : (root.active
                            ? root.active-fg
                            : (touch.has-hover ? root.hover-fg : root.idle-fg));
                    opacity: root.button-enabled ? 1 : 0.5;
                    animate icon-color { duration: Theme.dur-fast; easing: ease-in-out; }
                }
            }
        }
    }

    Tooltip {
        text: root.tooltip-text;
        hovered: touch.has-hover;
        host-width: root.width;
        force-shown: root.force-tooltip;
    }

    touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if (root.button-enabled) { root.clicked(); }
        }
    }
}
