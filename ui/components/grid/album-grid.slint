import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { AlbumGridRow } from "../../models.slint";
import { EntityCard } from "entity-card.slint";

// Virtualized album-card grid. The `rows` model is `[AlbumGridRow]` — Rust
// chunks the flat album list into rows of `columns` cards (see
// `src/ui/albums.rs`), so the inner `ListView` virtualizes by row: only
// on-screen rows instantiate their `EntityCard` component instances.
//
// Cover thumbnails are pulled lazily: each on-screen card's `cover` binding
// invokes `request-cover(artwork_path)`, which the host forwards to its
// global's `request-cover` callback (Rust → `CoverThumbs` LRU). Because the
// inner `ListView` virtualizes by row, only on-screen cards evaluate that
// binding — so the grid never decodes / locks a cover for an album the user
// hasn't scrolled to, and the `AlbumGridRow` model stays pure data. Rust
// prewarms only the first screenful or two of covers (`GRID_PREWARM_AHEAD`);
// the rest decode on scroll-in. Memory stays bounded by the `CoverThumbs`
// LRU + thumbnail-sized buffers, exactly like the Tracks / Browse row models.
//
// Mirrors `TrackList`'s host-mounted-scrollbar contract: viewport metrics
// are exposed via the `v-*` out properties + `set-v-offset` so the host
// view mounts its `OverlayScrollbar` flush with the content-panel edge,
// outside whatever padding the host applies.
export component AlbumGrid inherits Rectangle {
    in property <[AlbumGridRow]> rows;
    in property <length> card-width: 180px;
    in property <length> card-height: 226px;
    // Full row slot height — `card-height` plus the inter-row gap, baked in
    // so the `ListView` (which lays delegates back-to-back, no `spacing`)
    // gets even vertical gaps.
    in property <length> row-height: 246px;
    in property <length> gap: 20px;

    callback open-album(int /*album_id*/);
    // Lazy per-card cover lookup — the host forwards this to its global's
    // `request-cover` callback. `pure` so it can be used inside a binding.
    pure callback request-cover(string /*artwork_path*/) -> image;

    // Viewport metrics for a host-mounted `OverlayScrollbar`. Sign
    // convention matches `TrackList`: positive `v-offset` = scrolled by N
    // px; the inner `ListView` stores the same as a non-positive
    // `viewport-y`, so we negate at the boundary.
    out property <length> v-visible-height: list.visible-height;
    out property <length> v-viewport-height: list.viewport-height;
    out property <length> v-offset: -list.viewport-y;
    callback set-v-offset(length);
    set-v-offset(o) => { list.viewport-y = -o; }

    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        for grid-row in root.rows: Rectangle {
            // Pin the delegate's layout slot — a `ListView` delegate needs a
            // fixed height or the virtualization math breaks (CLAUDE.md).
            min-height: root.row-height;
            max-height: root.row-height;

            HorizontalLayout {
                padding-left: root.gap;
                padding-right: root.gap;
                spacing: root.gap;
                alignment: start;

                for album in grid-row.albums: EntityCard {
                    card-width: root.card-width;
                    card-height: root.card-height;
                    artwork-path: album.artwork_path;
                    // Lazy cover — only this on-screen card evaluates it.
                    cover: root.request-cover(album.artwork_path);
                    // Empty-art tiles use the sidebar's `album` glyph.
                    fallback-icon: "album";
                    // Pronounced 1.15 zoom in placeholder mode (matches
                    // Playlists / Genres); real artwork keeps the gentle
                    // 1.04 so covers don't jitter inside the tile clip
                    // on hover.
                    cover-scale-hover: album.artwork_path == "" ? 1.15 : 1.04;
                    title: album.name;
                    // "Artist · 2020" — the separator is punctuation, the
                    // "Unknown artist" fallback is translated. `\{...}`
                    // interpolation stringifies the year.
                    subtitle: (album.artist_name == ""
                        ? @tr("Unknown artist")
                        : album.artist_name)
                        + (album.year > 0 ? " · \{album.year}" : "");
                    clicked => { root.open-album(album.id); }
                }
            }
        }
    }
}
