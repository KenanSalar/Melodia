import { Theme } from "../../theme.slint";
import { Player } from "../../globals.slint";
import { MaterialIcon } from "../material-icon.slint";

// Large foreground artwork tile for the full-screen Now Playing view.
//
// Unlike the shared `ArtworkImage`, this tile's *frame* is completely
// static: it never moves or resizes on a track change — only the cover
// content cross-fades. That mirrors the blurred-backdrop pattern inlined in
// `now-playing-view.slint`: Rust writes the new high-res cover into the
// inactive of `Player.np-cover-{a,b}` then flips `np-cover-use-a`, and only
// `opacity` animates. A slot's `source` is NEVER cleared, so the outgoing
// cover stays painted for the whole fade — no empty frame. For an art-less
// (or failed-decode) track `np-cover-has-image` is false: both slots fade to
// 0 and the `music_note` placeholder fades in.
export component NowPlayingCover inherits Rectangle {
    in property <length> tile-size;

    width: tile-size;
    height: tile-size;
    border-radius: Theme.radius-lg;
    // Backdrop-solved rather than `Theme.surface0`: this tile sits on the
    // artwork blur, and a light theme's surface is bright enough to read as a
    // white square during the cover cross-fade. Low alpha keeps it a recess in
    // the backdrop rather than a slab on it. Only the Now Playing view mounts
    // this component, so there's no miniplayer branch to restate.
    background: Player.np-on-backdrop.with-alpha(0.08);
    clip: true;

    // Placeholder glyph — painted underneath the cover slots and faded out
    // once a cover is present.
    Rectangle {
        opacity: Player.np-cover-has-image ? 0.0 : 1.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "music_note";
                    icon-size: root.height * 0.4;
                    icon-color: Player.np-on-backdrop-muted.with-alpha(0.5);
                }
            }
        }
    }

    // Two stacked cover slots. Exactly one is opaque at a time (or neither,
    // for an art-less track); a track change flips `np-cover-use-a` so the
    // old and new covers cross-fade.
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.np-cover-a;
        image-fit: ImageFit.cover;
        opacity: (Player.np-cover-has-image && Player.np-cover-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: Player.np-cover-b;
        image-fit: ImageFit.cover;
        opacity: (Player.np-cover-has-image && !Player.np-cover-use-a) ? 1.0 : 0.0;
        animate opacity { duration: Theme.dur-med; easing: ease-in-out; }
    }
}
