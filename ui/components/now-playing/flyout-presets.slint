// Single source of truth for the now-playing popup menus' left-column flyouts:
// the option lists themselves plus the row/chrome metrics the hosts'
// fixed-reserve geometry math needs. `overflow-menu.slint` (the bar's speed and
// sleep-timer flyouts) and `view-menu.slint` (the Now-Playing view's visualizer
// flyout) each compute their reserved height from a list length here, so adding
// or removing an option can no longer clip the popup.

// One preset in the speed list. `value` is the multiplier handed to
// `Player.set-playback-speed`; `label` is the (untranslated, numeric)
// display token. Kept in lock-step with `current-speed-label()` in
// `overflow-menu.slint`, which maps the live `vm.playback_speed` back to
// the same label for the collapsed "Speed" row.
export struct SpeedPreset {
    value: float,
    label: string,
}

// One preset in the sleep-timer list. `value` is the minutes argument handed
// to `Player.set-sleep-timer` (0 = off, > 0 = duration, -1 = "End of current
// track"); `label` is the translated display string.
export struct SleepPreset {
    value: int,
    label: string,
}

export global SpeedPresets {
    // Fine 0.25 steps from 0.25× up to the player's 2× cap (rodio's naive
    // speed shifts pitch, so beyond 2× is chipmunk territory). Mirror any
    // change in `current-speed-label()` in `overflow-menu.slint`.
    out property <[SpeedPreset]> list: [
        { value: 0.25, label: "0.25x" },
        { value: 0.5,  label: "0.5x" },
        { value: 0.75, label: "0.75x" },
        { value: 1.0,  label: "1x" },
        { value: 1.25, label: "1.25x" },
        { value: 1.5,  label: "1.5x" },
        { value: 1.75, label: "1.75x" },
        { value: 2.0,  label: "2x" },
    ];
}

export global SleepPresets {
    // `-1` = "End of track"; `0` = off.
    out property <[SleepPreset]> list: [
        { value: 0,   label: @tr("Off") },
        { value: 15,  label: @tr("15 min") },
        { value: 30,  label: @tr("30 min") },
        { value: 45,  label: @tr("45 min") },
        { value: 60,  label: @tr("60 min") },
        { value: 90,  label: @tr("90 min") },
        { value: -1,  label: @tr("End of track") },
    ];
}

export global VizStylePresets {
    // Mirrors `STYLES` in `src/ui/visualizer.rs` **by position** — a row's loop
    // index IS the index `Visualizer.set-style` takes, so there is no separate
    // value to keep in step. Seeded from Rust it would render untranslated
    // (`@tr()` only translates literals at codegen), so it stays a literal
    // array; `src/ui/tests/visualizer_tests.rs` pins its length against `STYLES`.
    //
    // Read by both the Settings → Playback chips and the Now-Playing view's
    // visualizer flyout, so the two pickers can't drift apart.
    out property <[string]> viz-style-names: [
        @tr("Bars"),
        @tr("Waveform"),
        @tr("Mirrored"),
    ];
}

export global FlyoutMetrics {
    // Height of one `FlyoutOption` row (and the sleep flyout's stepper /
    // Start-pill rows, which match it for a uniform rhythm).
    out property <length> option-row-h: 32px;
    // Vertical chrome allowance per flyout: 8 px inner pad + 2 px border
    // + 2 px slack — the same allowance the menu column uses.
    out property <length> chrome-h: 12px;
}
