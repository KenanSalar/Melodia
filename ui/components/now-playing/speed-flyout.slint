import { Theme } from "../../theme.slint";
import { MaterialIcon } from "../material-icon.slint";
import { PopupSurface } from "../popup-surface.slint";

// One preset in the speed list. `value` is the multiplier handed to
// `Player.set-playback-speed`; `label` is the (untranslated, numeric)
// display token. Kept in lock-step with `current-speed-label()` in
// `overflow-menu.slint`, which maps the live `vm.playback_speed` back to
// the same label for the collapsed "Playback speed" row.
struct SpeedPreset {
    value: float,
    label: string,
}

// Single option row inside the speed flyout. Mirrors `DropdownOption`
// (`ui/components/settings/dropdown.slint`): label on the left, a `check`
// glyph on the active row. Hover fill matches the sibling overflow rows
// (`Theme.surface1`) since both live in the same popup family.
component SpeedOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;

    callback clicked();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface1 : transparent;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        spacing: Theme.pad-sm;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: root.active ? Theme.accent : Theme.text;
                font-size: Theme.font-size-md;
            }
        }
        VerticalLayout {
            alignment: center;
            // Checkmark only on the active row; the empty branch keeps the
            // layout box stable so all rows have identical height.
            if root.active: MaterialIcon {
                name: "check";
                icon-size: 16px;
                icon-color: Theme.accent;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The speed-selection flyout: a `PopupSurface` listing the 12 playback-rate
// presets. Lives inside the overflow menu's single PopupWindow (no nested
// PopupWindow — the app's deliberate single-popup discipline), positioned
// to the LEFT of the menu column. The host sets `width`/`height`/`x`/`y`;
// this component just renders the rows and emits `pick(value)`.
export component SpeedFlyout inherits PopupSurface {
    // Live multiplier, used to mark the active row.
    in property <float> current-speed;
    callback pick(float);

    // Fine 0.25 steps from 0.25× up to the player's 2× cap (rodio's naive
    // speed shifts pitch, so beyond 2× is chipmunk territory). Mirror any
    // change in `current-speed-label()` in `overflow-menu.slint`.
    property <[SpeedPreset]> presets: [
        { value: 0.25, label: "0.25x" },
        { value: 0.5,  label: "0.5x" },
        { value: 0.75, label: "0.75x" },
        { value: 1.0,  label: "1x" },
        { value: 1.25, label: "1.25x" },
        { value: 1.5,  label: "1.5x" },
        { value: 1.75, label: "1.75x" },
        { value: 2.0,  label: "2x" },
    ];

    VerticalLayout {
        padding: Theme.pad-xs;
        spacing: 0;

        for p in root.presets: SpeedOption {
            label: p.label;
            active: abs(root.current-speed - p.value) < 0.001;
            clicked => { root.pick(p.value); }
        }
    }
}
