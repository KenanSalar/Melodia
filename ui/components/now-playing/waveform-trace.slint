import { Player, Visualizer } from "../../globals.slint";

// Oscilloscope trace for the Now-Playing view: the signal itself rather than its
// spectrum, drawn as the band between the loudest and quietest sample of each
// column — the shape `DeaDBeeF`'s scope and every audio editor's waveform view
// draw, because a column of a few hundred pixels always covers several samples
// and any single one of them misrepresents the rest.
//
// The geometry arrives as an SVG command string rather than as `LineTo`
// children, because Slint rejects `for`-generated path elements outright
// ("Path elements are not supported with `for`-`in` syntax, yet",
// slint-ui/slint#754). Rust rebuilds the string each tick; there is no `animate`
// here for the same reason the bars have none — the envelope is already a
// smoothed value, and animating one phase-lags.
export component WaveformTrace inherits Rectangle {
    background: transparent;

    Path {
        commands: Visualizer.wave-path;

        // Rust normalizes to this box — x across 0..1, y as the sample's own
        // -1..1 — so the viewbox is a constant and no column count has to be
        // kept in step across the language boundary.
        //
        // The viewbox is not optional: without one, Slint fits the path's *own*
        // bounding box to the element, which renormalizes every frame and would
        // draw a whisper as loud as a chorus.
        viewbox-x: 0;
        viewbox-y: -1;
        viewbox-width: 1;
        viewbox-height: 2;
        // `contain` (the default) preserves the viewbox's aspect ratio, which
        // would letterbox this 1×2 box into a sliver down the middle.
        fit: fill;

        // Fill only, and opaque — the same brush the bars paint themselves with,
        // for the same reason: `np-accent-bright` is the tone-floored accent, so
        // a dark album's colour still reads against the scrimmed backdrop.
        //
        // No stroke. The figure doubles back on itself by construction — upper
        // edge out, lower edge home — so wherever the trace is thin the two
        // strokes land on each other, and asking a renderer to stroke a path
        // that overlaps itself is asking for whatever it feels like giving you.
        // The resting state comes from `waveform::MIN_HALF_THICKNESS` instead,
        // which keeps the figure a real shape at every amplitude and is a thing
        // the fill can draw honestly.
        fill: Player.np-accent-bright;
    }
}
