import { Theme } from "../theme.slint";

// Horizontal M3 Expressive slider — twin slim rounded bars meeting at the
// thumb centre, a parent-background stadium masking the seam, and a thin
// vertical-pill thumb that shrinks along the value axis on press
// (4 → 2 px, 200 ms cubic-bezier(0.2, 0, 0, 1)). Mirror of `volume-popup`'s
// slider region, rotated 90°. No hover/press growth — track thickness and
// the thumb's perpendicular extent are both fixed.
//
// Mask colour MUST match the parent surface; expose it instead of hardcoding
// (volume's mask is `Theme.crust` only because its parent `PopupSurface`
// paints `Theme.crust`; the now-playing-bar parent paints `mantle` /
// `mantle-unfocused`).
export component SliderTrack inherits Rectangle {
    in property <float> value;          // bound source-of-truth (0..1)
    in property <bool>  is-disabled: false;
    in property <brush> seam-mask-color: Theme.mantle;

    // Gated on `dragged-since-press` so a click-inside-mask grab without
    // movement doesn't flip the visual / time-text into "drag mode";
    // they keep tracking live `value` until the user actually moves.
    out property <bool>  dragging: touch.pressed && root.dragged-since-press;
    out property <float> drag-value;    // valid only while dragging

    callback changed(float);
    callback committed(float);

    // Set true on a jump-to-click or any `moved` event; stays false during
    // a no-move grab. Gates both the `dragging` visual switch and the
    // `committed` callback (no-op grabs don't fire seek).
    private property <bool> dragged-since-press: false;

    // Tall enough to host the 24 px vertical thumb without clipping.
    min-height: 24px;
    background: transparent;

    private property <float> shown-value:
        root.dragging ? root.drag-value : root.value;

    private property <length> track-h: 4px;
    private property <length> thumb-h: 24px;
    // Press shrinks the thumb along the value axis 4 → 2 px (M3 Expressive,
    // matches volume's `thumb-h` press behaviour rotated 90°).
    private property <length> thumb-w: touch.pressed ? 2px : 4px;
    // Mask along-axis extent (12 px) is wider than the thumb (4 px rest) so
    // the seam gap visibly widens to ~5 px on each side when the thumb
    // shrinks to 2 px under press — "active track absorbs the freed pixels".
    private property <length> thumb-bg-w: 12px;
    private property <length> thumb-bg-h: 24px;

    private property <float>  frac: clamp(root.shown-value, 0, 1);
    private property <length> track-cy: root.height / 2;
    // Centre the thumb against a stable 4 px reference (the rest
    // `thumb-w`) rather than the live animated width. Deriving thumb-x
    // from a width-dependent term would pin one edge at the extremes —
    // at frac=0 the left edge stays at 0 and only the right edge moves
    // inward on press, looking asymmetric. The 12 px mask hides any
    // 1-px overflow past the track ends.
    private property <length> thumb-cx: root.frac * (root.width - 4px) + 2px;
    private property <length> thumb-x: root.thumb-cx - root.thumb-w / 2;
    private property <length> active-w: root.thumb-cx;
    private property <length> inactive-w: root.width - root.thumb-cx;

    animate thumb-w { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    // Active bar — left half, from 0 to thumb-cx. Covered by the mask at
    // the seam end so it reads as a continuous bar with the thumb on top.
    Rectangle {
        x: 0;
        y: root.track-cy - root.track-h / 2;
        width: root.active-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: root.is-disabled ? Theme.overlay0 : Theme.accent;
    }

    // Inactive bar — right half, from thumb-cx to width.
    Rectangle {
        x: root.thumb-cx;
        y: root.track-cy - root.track-h / 2;
        width: root.inactive-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: Theme.surface1;
    }

    // Mask — parent-background stadium that hides the bar seam at thumb-cx.
    // Painted after the bars and before the thumb so the seam stays
    // invisible while the thumb pill sits on top.
    Rectangle {
        x: root.thumb-cx - root.thumb-bg-w / 2;
        y: root.track-cy - root.thumb-bg-h / 2;
        width: root.thumb-bg-w;
        height: root.thumb-bg-h;
        border-radius: self.width / 2;
        background: root.seam-mask-color;
    }

    // Thumb — thin vertical pill in the active accent. Painted on top of
    // the mask so the seam-cover stays invisible.
    Rectangle {
        x: root.thumb-x;
        y: root.track-cy - root.thumb-h / 2;
        width: root.thumb-w;
        height: root.thumb-h;
        border-radius: self.width / 2;
        background: root.is-disabled ? Theme.overlay0 : Theme.accent;
        // Snap thumb x to each position-tick instead of easing over 200 ms.
        // Easing would phase-lag the value source on every 1 Hz publish
        // (CLAUDE.md "animating a binding derived from another animating
        // property") and burn ~12 frames of paint per tick on the thumb
        // and any text cells it overlaps. Snapping makes the thumb track
        // the source of truth exactly and keeps each tick's paint scope
        // to the moved cell only.
        animate x { duration: 0ms; }
    }

    touch := TouchArea {
        enabled: !root.is-disabled;
        mouse-cursor: pointer;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                // Grab zone = the mask region (±thumb-bg-w/2 around
                // thumb-cx). Inside, capture the press without jumping —
                // matches the perceived thumb hit area and prevents a 1–2
                // px sideways nudge from teleporting the value. Outside,
                // jump-to-click as before.
                if (self.mouse-x < root.thumb-cx - root.thumb-bg-w / 2
                    || self.mouse-x > root.thumb-cx + root.thumb-bg-w / 2) {
                    root.drag-value = clamp(self.mouse-x / root.width, 0, 1);
                    root.changed(root.drag-value);
                    root.dragged-since-press = true;
                } else {
                    root.dragged-since-press = false;
                }
            }
            // Volume's pattern: commit on up OR cancel. Skip the commit
            // when the user never actually moved — the player advances
            // during the grab-hold, and committing the captured value
            // would seek BACKWARDS to the click instant.
            if (ev.kind == PointerEventKind.up
                || ev.kind == PointerEventKind.cancel) {
                if (root.dragged-since-press) {
                    root.committed(root.drag-value);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.drag-value);
                root.dragged-since-press = true;
            }
        }
    }
}
