import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../settings.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { SearchBar } from "../components/search-bar.slint";
import { LibrarySection } from "settings/library-section.slint";
import { AppearanceSection } from "settings/appearance-section.slint";
import { WindowChromeSection } from "settings/window-chrome-section.slint";
import { OverflowMenuSection } from "settings/overflow-menu-section.slint";
import { LanguageSection } from "settings/language-section.slint";
import { PlaybackSection } from "settings/playback-section.slint";
import { FileWatchingSection } from "settings/file-watching-section.slint";
import { UpdateSection } from "settings/update-section.slint";

// Settings host page. Mirrors Tauri's `pages/Settings.tsx` shape: a
// vertically scrolling, width-clamped column of section cards.
//
// Scrollbar layout matches the Tracks view: the inner `ScrollView`'s
// built-in bars are hidden (`always-off` on both axes) and a custom
// `OverlayScrollbar` is mounted at the SettingsView root so it sits flush
// with the content panel's right edge (outside the body padding) instead of
// floating just to the right of the centred content card.
export component SettingsView inherits Rectangle {
    // No own background — see TracksView for the why. The parent content
    // panel paints `Theme.base` inside its rounded shape; a transparent
    // root lets the rounded fill show through at the corner cells.

    // Backdrop TouchArea — catches any click that no inner widget consumes
    // (page padding, gaps between section cards, the empty area below the
    // last card) and bumps the SearchBar blur counter so the input releases
    // keyboard focus. Same pattern as `tracks-view.slint`'s root-level
    // TouchArea: Slint's `TextInput` has no native "click outside" behaviour,
    // so once focused it stays focused until something explicitly tells it
    // to clear. Declared first so it sits at the back of the z-order — any
    // TouchArea, button, chip, or input in front of it gets first crack at
    // the click.
    TouchArea {
        clicked => { Settings.blur-search-tick += 1; }
    }

    VerticalLayout {
        padding-top: Theme.pad-lg;
        padding-bottom: Theme.pad-lg;
        padding-left: Theme.pad-lg;
        padding-right: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Page header — title on the left, search bar flush right. Lives
        // outside the inner ScrollView so it stays pinned while sections
        // scroll. The SearchBar is the same reusable component the Tracks
        // view mounts; visibility filtering for each section is driven
        // reactively from `Settings.search-query` (no `edited` callback
        // needed, unlike Tracks which throttles model rebuilds).
        HorizontalLayout {
            spacing: Theme.pad-md;
            Text {
                text: @tr("Settings");
                color: Theme.page-title-color;
                font-size: Theme.page-title-size;
                font-weight: Theme.page-title-weight;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                SearchBar {
                    text <=> Settings.search-query;
                    placeholder: @tr("Search settings…");
                    blur-trigger: Settings.blur-search-tick;
                }
            }
        }

        // Width clamp + vertical scroll. Tauri uses
        // `clamp(640px, 100%, 1100px)` centred; ScrollView's viewport
        // width tracks `self.width`, so we wrap the column in centred
        // spacers and pin the column min/max width. Both built-in
        // scrollbars are hidden — the host-mounted `OverlayScrollbar`
        // below drives the vertical axis through `viewport-y`.
        sv := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: always-off;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    min-width: 640px;
                    max-width: 1100px;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.pad-lg;
                        // Tauri order: Library, then Appearance (palette
                        // — theme/variant/accent/style), Window
                        // (titlebar/match-unfocused/corner-radius) and
                        // Player Bar (overflow menu) sit between
                        // Appearance and Language. Each section gets an
                        // id so the no-results placeholder below can
                        // read its `has-matches` to decide whether
                        // every section is hidden.
                        lib-sec  := LibrarySection {}
                        app-sec  := AppearanceSection {}
                        wc-sec   := WindowChromeSection {}
                        ovf-sec  := OverflowMenuSection {}
                        lang-sec := LanguageSection {}
                        pb-sec   := PlaybackSection {}
                        fw-sec   := FileWatchingSection {}
                        upd-sec  := UpdateSection {}

                        // No-results placeholder — only mounted when a
                        // search query is non-empty AND no section claims
                        // a match. The SearchBar above stays visible
                        // regardless so the user can edit/clear the query.
                        if Settings.search-query != ""
                                && !lib-sec.has-matches
                                && !app-sec.has-matches
                                && !wc-sec.has-matches
                                && !ovf-sec.has-matches
                                && !lang-sec.has-matches
                                && !pb-sec.has-matches
                                && !fw-sec.has-matches
                                && !upd-sec.has-matches: Rectangle {
                            background: transparent;
                            height: 200px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("No matching settings");
                                    horizontal-alignment: center;
                                    color: Theme.subtext0;
                                    font-size: Theme.font-size-md;
                                }
                            }
                        }

                        // Trailing spacer — absorbs any surplus vertical
                        // space when filtering hides most sections. Without
                        // it, the column's surplus gets distributed across
                        // remaining children (including the visible
                        // SectionCard), stretching individual rows by their
                        // share of the surplus. Pinning a `vertical-stretch:
                        // 1` Rectangle at the bottom forces the surplus to
                        // collect there instead, so visible sections render
                        // at their natural height regardless of how many are
                        // hidden. Outside search mode (all sections visible
                        // and tall enough to need scrolling) the spacer
                        // collapses to 0 — nothing changes.
                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // Overlay scrollbars — siblings of the padded VerticalLayout above,
    // pinned to the SettingsView's edges so they line up with the content
    // panel border (matches the Tracks view). `sv.absolute-position`
    // resolves the ScrollView's window-relative coords; subtracting
    // `root.absolute-position` puts each bar in the SettingsView's local
    // frame so y/height values stay correct regardless of how the
    // VerticalLayout's padding/header row size changes.
    //
    // Horizontal axis: shows up only when the window is narrower than the
    // content card's `min-width: 640px` floor — the inner Rectangle sticks
    // at 640 px and the ScrollView pans through it. The OverlayScrollbar
    // hides itself automatically when `content-size <= visible-size`.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: sv.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: sv.height;
        visible-size: sv.visible-height;
        content-size: sv.viewport-height;
        offset: -sv.viewport-y;
        scroll-to(o) => { sv.viewport-y = -o; }
    }

    OverlayScrollbar {
        horizontal: true;
        x: sv.absolute-position.x - root.absolute-position.x;
        // Bottom edge of the SettingsView root (matches the Tracks view's
        // horizontal bar), not the bottom of the scroll body — so the bar
        // sits flush with the content panel's lower edge.
        y: parent.height - self.height;
        // Stop 10 px before the right edge so the corner doesn't overlap
        // the vertical bar above (same convention as the Tracks view).
        width: sv.width - 10px;
        height: 10px;
        visible-size: sv.visible-width;
        content-size: sv.viewport-width;
        offset: -sv.viewport-x;
        scroll-to(o) => { sv.viewport-x = -o; }
    }
}
