import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Browse, Nav, Player } from "../globals.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { IconButton } from "../components/icon-button.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";

// One folder row in the Browse list. Folder icon + name + right chevron.
// Click → `Browse.open-folder(path)`.
//
// `min-width` of the label tracks its natural text width via
// `min-width: self.preferred-width`, so when the window narrows the row
// doesn't compress and elide — instead the body's horizontal scrollbar
// kicks in. Matches Tauri's "name never truncates" behaviour.
component BrowseFolderRowItem inherits Rectangle {
    in property <string> name;
    in property <string> path;

    // 48 px visual chrome + 2 px gap slot — the `ListView` lays rows
    // back-to-back (no `spacing` property), so the gap that used to come
    // from the wrapping `VerticalLayout { spacing: 2px }` is baked into
    // the row here. Matches the `Browse.folders.length * 50px` cap math.
    height: 50px;

    inner := Rectangle {
        y: 0;
        width: 100%;
        height: 48px;
        border-radius: Theme.radius-md;
        background: touch.has-hover ? Theme.surface0 : transparent;

        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            spacing: Theme.pad-md;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "folder";
                    icon-size: 24px;
                    icon-color: Theme.accent;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    font-weight: 500;
                    min-width: self.preferred-width;
                }
            }

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "chevron_right";
                    icon-size: 20px;
                    icon-color: Theme.overlay0;
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Browse.open-folder(root.path); }
        }
    }
}

// One breadcrumb segment. Hover-highlighted chip; click fires
// `Browse.navigate-to(path)`. Visual separator (chevron) lives outside
// this component — see the `for seg[i] in Browse.breadcrumbs` loop in
// BrowseView, which interleaves a chevron icon before every segment
// after the first.
component BreadcrumbSegment inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <bool> is-current;

    height: 28px;
    width: layout.preferred-width;
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.surface0 : transparent;
    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.is-current ? Theme.accent : Theme.subtext0;
                font-size: Theme.font-size-sm;
                font-weight: 500;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Browse.navigate-to(root.path); }
    }
}

// The Browse page. Header strip (back + home + breadcrumb + a single
// action pill: Play All + selection chip + column-toggle) over a body
// that stacks a folder section above the reusable `TrackList`, with one
// of three empty-state replacements depending on `current-path` /
// `has-library-folders` / `error-message`.
//
// **Layout**: the folder section and the `TrackList` both live inside a
// single outer `ScrollView` (`below-sv`), so one vertical overlay
// scrollbar scrolls folders then tracks continuously — the favorites-
// view pattern. The TrackList is capped at the outer viewport height
// (`min` in its `height` binding) so its inner ListView virtualizes to
// ~visible rows; the outer ScrollView's own travel covers the folder
// section, and the unified scrollbar composes both travels (wheel
// handoff between the regions is native — a Slint Flickable at its
// scroll edge forwards wheel events to the parent). The folder
// `ListView` stays sized to its row count: folder rows are light
// (icon + label, no popups) and directory listings are bounded.
// The horizontal bar still drives `TrackList`'s internal column pan via
// its `h-*` out properties. Both bars are siblings of the padded
// VerticalLayout so they sit flush with the BrowseView's right/bottom
// edges.
//
// Nav-activation refresh: index 1 == Browse. `changed
// Nav.selected-index` doesn't accept path expressions on globals
// (CLAUDE.md pitfall), so mirror it through a local property and watch
// that.
export component BrowseView inherits Rectangle {
    // No background — see TracksView's note. The parent content panel
    // owns the rounded `Theme.base` fill; a transparent root lets that
    // fill show through at the rounded corner cells.

    property <int> watched-nav: Nav.selected-index;
    changed watched-nav => {
        if (root.watched-nav == 1) {
            Browse.refresh();
        }
    }

    vl := VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        // Header strip.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-sm;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "arrow_back";
                    icon-size: 20px;
                    diameter: 32px;
                    button-enabled: Browse.can-go-back;
                    clicked => { Browse.go-back(); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "home";
                    // Filled variant per design — the home icon is a
                    // recognisable solid shape rather than the
                    // outlined glyph used in the sidebar nav.
                    filled: true;
                    icon-size: 20px;
                    diameter: 32px;
                    clicked => { Browse.navigate-to(""); }
                }
            }

            // Breadcrumb chip strip. A clipping container so a deep
            // path doesn't push the action pill off-screen; overflow
            // hides at the left edge (left segments are less important
            // — the rightmost is the current folder). Chevron icons
            // are interleaved between segments so users see a
            // path-like rendering (e.g. `home > kenan > Music`).
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 2px;

                        for seg[i] in Browse.breadcrumbs : HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            if i > 0: VerticalLayout {
                                alignment: center;
                                MaterialIcon {
                                    name: "chevron_right";
                                    icon-size: 14px;
                                    icon-color: Theme.overlay0;
                                }
                            }
                            BreadcrumbSegment {
                                label: seg.label;
                                path: seg.path;
                                is-current: i == Browse.breadcrumbs.length - 1;
                            }
                        }
                    }
                }
            }

            // Single trailing action pill. Order: selection chip (when
            // active) → Play All → column toggle. Selection slots sit at
            // the leading edge so the "N selected | X" group reads to
            // the left of Play All, not wedged between Play All and the
            // column toggle.
            VerticalLayout {
                alignment: center;
                ActionPill {
                    if Browse.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", Browse.selected-ids.length);
                    }
                    if Browse.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { Browse.clear-selection(); }
                    }
                    if Browse.selected-ids.length > 0: PillDivider { }
                    if Browse.has-playable-files: PillButton {
                        icon: "play_arrow";
                        icon-filled: true;
                        text: @tr("Play All");
                        clicked => { Browse.play-all(); }
                    }
                    if Browse.has-playable-files: PillDivider { }
                    ColumnTogglePopup {
                        tooltip-text: "";
                        show-number <=> Browse.show-number;
                        show-artwork <=> Browse.show-artwork;
                        show-artist <=> Browse.show-artist;
                        show-album <=> Browse.show-album;
                        show-genre <=> Browse.show-genre;
                        show-year <=> Browse.show-year;
                        toggled(id) => { Browse.toggle-column(id); }
                    }
                }
            }
        }

        // Body. The folder section and the reusable `TrackList` both live
        // inside one outer `ScrollView` (`below-sv`) so a single overlay
        // scrollbar scrolls them as one surface. Empty-state overlays
        // paint over the body with an opaque `Theme.base` fill (so the
        // TrackList's column header doesn't peek through); Rust clears
        // `folders` / `rows` whenever an empty state is active.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            below-sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                viewport-width: self.width;

                VerticalLayout {
                    // No inter-child spacing — the folder section below
                    // bakes its own gap to the track table in (and is
                    // unmounted entirely when there are no subfolders),
                    // so an unconditional `spacing` would leave a
                    // dangling gap above the TrackList.
                    spacing: 0;

                    // Folder section — only mounted when the directory
                    // has subfolders. The `ListView` is sized to its
                    // full row count (50 px slot per row, baked into
                    // `BrowseFolderRowItem`) so every folder renders
                    // into the outer ScrollView's flow rather than
                    // scrolling on its own. A `pad-md` bottom gap to the
                    // track table is added only when drilled in (the
                    // root view never lists songs below).
                    if Browse.folders.length > 0: Rectangle {
                        vertical-stretch: 0;
                        height: Browse.folders.length * 50px
                            + (Browse.current-path == "" ? 0px : Theme.pad-md);

                        ListView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: Browse.folders.length * 50px;
                            vertical-scrollbar-policy: always-off;
                            horizontal-scrollbar-policy: always-off;

                            for folder[fi] in Browse.folders : BrowseFolderRowItem {
                                name: folder.name;
                                path: folder.path;
                            }
                        }
                    }

                // Track table — hidden at the root view, which only ever
                // lists library folders (never songs); `visible: false`
                // stops it painting its (empty) column header at the
                // root. Height = content (row stride × count + 32 px
                // header strip + the inner `pad-xs` gap) capped at the
                // outer viewport: small directories keep the
                // content-tall layout, large ones pin to the visible
                // region so the inner ListView virtualizes instead of
                // instantiating every row.
                tl := TrackList {
                    visible: Browse.current-path != "";
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: Browse.current-path == ""
                        ? 0px
                        : min(
                            max(1, Browse.rows.length)
                                * (Browse.show-artwork
                                    ? Theme.row-h
                                    : Theme.row-h-compact)
                                + 32px + Theme.pad-xs,
                            below-sv.visible-height);

                    rows: Browse.rows;

                    w-number <=> Browse.w-number;
                    w-title <=> Browse.w-title;
                    w-artist <=> Browse.w-artist;
                    w-album <=> Browse.w-album;
                    w-genre <=> Browse.w-genre;
                    w-year <=> Browse.w-year;
                    w-length <=> Browse.w-length;

                    show-number <=> Browse.show-number;
                    show-artwork <=> Browse.show-artwork;
                    show-artist <=> Browse.show-artist;
                    show-album <=> Browse.show-album;
                    show-genre <=> Browse.show-genre;
                    show-year <=> Browse.show-year;
                    number-mode: "index";

                    sort-field: Browse.sort-field;
                    sort-dir: Browse.sort-dir;
                    playing-track-id: Player.vm.track.id;
                    view-context: "browse";
                    view-selected-ids: Browse.selected-ids;

                    request-sort(f) => { Browse.request-sort(f); }
                    play-row(id, idx) => { Browse.play-row(id, idx); }
                    play-next(ids) => { Browse.play-next(ids); }
                    add-to-queue(ids) => { Browse.add-to-queue(ids); }
                    toggle-row-favorite(ids, on) => { Browse.toggle-row-favorite(ids, on); }
                    select-row(idx, id, sh, ct) => { Browse.select-row(idx, id, sh, ct); }
                    // Browse has no filter input — nothing to blur.
                    request-blur-search => { }
                    go-to-album(aid) => { Browse.go-to-album(aid); }
                    go-to-artist(aid) => { Browse.go-to-artist(aid); }
                    go-to-genre(gid) => { Browse.go-to-genre(gid); }
                }
                }
            }

            // 1. Root view with no library folders configured.
            if Browse.current-path == "" && !Browse.has-library-folders: Rectangle {
                background: Theme.base;
                VerticalLayout {
                alignment: center;
                spacing: Theme.pad-md;
                HorizontalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: "folder_off";
                        icon-size: 64px;
                        icon-color: Theme.overlay0;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("No library folders configured");
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("Open Settings to add a folder");
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    PillButton {
                        icon: "settings";
                        text: @tr("Open Settings");
                        clicked => { Nav.selected-index = 8; }
                    }
                }
                }
            }

            // 2. Error state. The Back button here uses `navigate-to("")`
            //    rather than `go-back()` because the user may have landed
            //    on an error from the persisted-path seed with an empty
            //    history stack — in that case `go-back` would no-op.
            //    Navigating to root always works and is the safest exit.
            if Browse.error-message != "": Rectangle {
                background: Theme.base;
                VerticalLayout {
                alignment: center;
                spacing: Theme.pad-md;
                HorizontalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: "error";
                        icon-size: 64px;
                        icon-color: Theme.overlay0;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("Could not load folder");
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: Browse.error-message;
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    PillButton {
                        icon: "arrow_back";
                        text: @tr("Back");
                        clicked => { Browse.navigate-to(""); }
                    }
                }
                }
            }

            // 3. Empty folder.
            if Browse.current-path != ""
                && Browse.error-message == ""
                && !Browse.loading
                && Browse.folders.length == 0
                && Browse.rows.length == 0: Rectangle {
                background: Theme.base;
                VerticalLayout {
                alignment: center;
                spacing: Theme.pad-md;
                HorizontalLayout {
                    alignment: center;
                    MaterialIcon {
                        name: "folder_open";
                        icon-size: 64px;
                        icon-color: Theme.overlay0;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("Empty folder");
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        font-weight: 600;
                    }
                }
                }
            }
        }
    }

    // Overlay scrollbars sit at the BrowseView root, outside the padded
    // VerticalLayout, so they're flush with the content panel's rounded
    // edges. The vertical bar drives the outer `below-sv` ScrollView
    // (folders + tracks scroll as one); the horizontal bar still drives
    // the `TrackList`'s internal column pan via its `h-*` out properties.
    // `body` / `tl` are nested inside `vl`, so positions are taken via
    // `absolute-position` rather than plain `.y` / `.x`.
    // Composite scroll math: the outer ScrollView's own travel covers
    // the folder-section region (viewport minus visible height), the
    // TrackList's inner ListView covers the track rows. The unified
    // scrollbar spans both travels; drags split the offset at the
    // boundary.
    property <length> v-outer-max: max(0px, below-sv.viewport-height - below-sv.visible-height);
    property <length> v-inner-max: max(0px, tl.v-viewport-height - tl.v-visible-height);

    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: body.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: body.height;
        visible-size: below-sv.visible-height;
        content-size: below-sv.visible-height + root.v-outer-max + root.v-inner-max;
        offset: -below-sv.viewport-y + tl.v-offset;
        scroll-to(o) => {
            below-sv.viewport-y = -min(o, root.v-outer-max);
            tl.set-v-offset(max(0px, o - root.v-outer-max));
        }
    }

    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
