import { Theme } from "../theme.slint";
import { Albums } from "../globals.slint";
import { SearchBar } from "../components/search-bar.slint";
import { ActionPill, PillButton, PillDivider } from "../components/action-pill.slint";
import { AlbumGrid } from "../components/grid/album-grid.slint";
import { GridColumnsSync } from "../components/grid-columns-sync.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";

// The Albums grid page. Page-header chrome (title, count, filter input,
// sort action-pill) lives here; the grid itself is the reusable,
// virtualized `AlbumGrid` component bound to the `Albums` global.
//
// The view owns the responsive-column math: it computes how many cards
// fit at `min-card-w`, sizes each card to flex-fill the row, and hands
// the integer column count to `GridColumnsSync`, which writes it into
// `Albums.columns` and fires `Albums.columns-changed` so the flat
// album list is re-chunked into rows of N.
export component AlbumView inherits Rectangle {
    // Filter throttle — identical pattern to `tracks-view.slint`: each
    // keystroke bumps `pending`; the Timer fires `apply-filter` at most
    // once per `interval` while `pending != applied`.
    property <int> filter-tick-pending: 0;
    property <int> filter-tick-applied: 0;
    filter-throttle := Timer {
        interval: 130ms;
        running: root.filter-tick-pending != root.filter-tick-applied;
        triggered() => {
            root.filter-tick-applied = root.filter-tick-pending;
            Albums.apply-filter(Albums.filter);
        }
    }

    // --- Responsive grid geometry --------------------------------------
    property <length> min-card-w: 180px;
    property <length> grid-gap: 20px;
    // Headroom below the artwork for the title + subtitle lines; the
    // EntityCard's trailing stretch absorbs any slack.
    property <length> card-text-h: 46px;
    // Largest N with `2·gap + N·min-card + (N-1)·gap <= grid.width`.
    property <int> computed-cols:
        max(1, Math.floor((grid.width - root.grid-gap) / (root.min-card-w + root.grid-gap)));
    property <length> card-w:
        max(0px, (grid.width - (root.computed-cols + 1) * root.grid-gap) / root.computed-cols);
    property <length> card-h: root.card-w + root.card-text-h;
    property <length> row-h: root.card-h + root.grid-gap;

    // Push `computed-cols` into `Albums.columns` + fire `columns-changed`
    // on mount and on every subsequent change. See `grid-columns-sync.slint`
    // for the Timer+`changed` rationale.
    GridColumnsSync {
        computed-cols: root.computed-cols;
        seed(c) => {
            Albums.columns = c;
            Albums.columns-changed(c);
        }
    }

    // Backdrop — any click the inner widgets don't consume blurs the
    // SearchBar (same pattern as the Tracks view).
    TouchArea {
        clicked => { Albums.blur-search-tick += 1; }
    }

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.pad-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.pad-md;
            alignment: stretch;

            // Title + count, stacked Spotify / Apple-Music style.
            VerticalLayout {
                alignment: center;
                spacing: 0;
                Text {
                    text: @tr("Albums");
                    color: Theme.page-title-color;
                    font-size: Theme.page-title-size;
                    font-weight: Theme.page-title-weight;
                }
                Text {
                    text: @tr("{n} album" | "{n} albums" % Albums.total-count);
                    color: Theme.subtext0;
                    font-size: Theme.font-size-sm;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Sort control: three pill buttons; the active field carries an
            // ↑ / ↓ direction arrow. Clicking the active field flips the
            // direction, a new field resets to ascending (handled Rust-side
            // in `wire_albums`).
            VerticalLayout {
                alignment: center;
                ActionPill {
                    PillButton {
                        text: @tr("Name");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "name"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "name";
                        clicked => { Albums.request-sort("name"); }
                    }
                    PillDivider { }
                    PillButton {
                        text: @tr("Year");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "year"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "year";
                        clicked => { Albums.request-sort("year"); }
                    }
                    PillDivider { }
                    PillButton {
                        text: @tr("Artist");
                        reserve-sort-slot: true;
                        sort-direction: Albums.sort-field == "artist"
                            ? Albums.sort-dir : "";
                        active: Albums.sort-field == "artist";
                        clicked => { Albums.request-sort("artist"); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                SearchBar {
                    text <=> Albums.filter;
                    placeholder: @tr("Filter albums…");
                    blur-trigger: Albums.blur-search-tick;
                    edited(t) => { root.filter-tick-pending += 1; }
                }
            }
        }

        // Body: the virtualized grid, with an empty-state overlay painted
        // on top (opaque `Theme.base` fill) when the library has no albums.
        body := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            grid := AlbumGrid {
                width: 100%;
                height: 100%;
                rows: Albums.grid-rows;
                card-width: root.card-w;
                card-height: root.card-h;
                row-height: root.row-h;
                gap: root.grid-gap;
                open-album(id) => { Albums.open-album(id); }
                request-cover(p) => { Albums.request-cover(p) }
            }

            if Albums.total-count == 0: Rectangle {
                background: Theme.base;
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.pad-md;
                    HorizontalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "album";
                            icon-size: 64px;
                            icon-color: Theme.overlay0;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("No albums yet");
                            color: Theme.text;
                            font-size: Theme.font-size-lg;
                            font-weight: 600;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Add a music folder in Settings to start building your library.");
                            color: Theme.subtext0;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // Overlay scrollbar — flush with the content panel's rounded right
    // edge, outside the padded VerticalLayout. Drives `AlbumGrid`'s inner
    // ListView through its `v-*` out properties + `set-v-offset`.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: grid.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: grid.height;
        visible-size: grid.v-visible-height;
        content-size: grid.v-viewport-height;
        offset: grid.v-offset;
        scroll-to(o) => { grid.set-v-offset(o); }
    }
}
