import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ArtistDetail, Player, CompositeScroll } from "../globals.slint";
import { DetailHeader } from "../components/detail-header.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { EntityCard } from "../components/grid/entity-card.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { SearchBar } from "../components/search-bar.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";

// The full Artist Detail view. Mirrors `AlbumDetailView`:
//
//   * Reusable `DetailHeader` (circular hero) with title / stats / action
//     pills supplied as children.
//   * Optional "Albums" sub-section between the header and the track list,
//     populated whenever `ArtistDetail.albums` is non-empty. Card click
//     hands off to the Albums tab (Rust switches `Nav.selected-index` and
//     invokes `AlbumsUi::open_album`).
//   * Shared, virtualized `TrackList` bound to `ArtistDetail.tracks` —
//     same shape as the Album Detail and Browse views, with the artist
//     column locked off (every row is the same artist).
export component ArtistDetailView inherits Rectangle {
    // Stats line: "12 tracks · 4 albums" — drops the second chunk when
    // the artist has no album credits (single-track artists, etc.).
    property <string> stats-line:
        @tr("{n} track" | "{n} tracks" % ArtistDetail.artist.track_count)
        + (ArtistDetail.artist.album_count > 0
            ? " · " + @tr("{n} album" | "{n} albums" % ArtistDetail.artist.album_count)
            : "");

    // Albums sub-section card dimensions. Smaller than the grid view's
    // flex-filled cards so several albums fit at once without dominating
    // the detail page vertically.
    property <length> album-card-w: 140px;
    property <length> album-card-h: 184px;

    // Filter throttle: each keystroke bumps `filter-tick-pending`; the
    // shared `FilterThrottle` fires the filter callback at most once per
    // ~130 ms while pending is ahead of the last-applied tick.
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { ArtistDetail.filter-changed(ArtistDetail.filter); }
    }

    // Backdrop catches any click that no inner TouchArea consumes
    // and bumps the blur tick — the SearchBar observes it and
    // clears focus on change. Mounted at the view root so any
    // padding / gap click closes the input.
    TouchArea {
        clicked => { ArtistDetail.blur-search-tick += 1; }
    }

    VerticalLayout {
        DetailHeader {
            vertical-stretch: 0;
            artwork-path: ArtistDetail.artist.image_path;
            artwork-size: clamp(root.width * 0.16, 160px, 240px);
            circular-artwork: true;
            fallback-icon: "person";
            cover: ArtistDetail.cover;
            hero-blur-a: ArtistDetail.blur-img-a;
            hero-blur-b: ArtistDetail.blur-img-b;
            hero-blur-use-a: ArtistDetail.blur-use-a;
            has-hero-blur: ArtistDetail.has-blur;
            back-clicked => { ArtistDetail.close-detail(); }

            // Title row — artist name on the left, SearchBar pinned
            // to the right. The SearchBar filters both the All Songs
            // TrackList (title + artist + album substring) and the
            // Albums sub-section (album name substring). Lives in
            // the hero so it doesn't compete with the TrackList for
            // vertical space — mirrors the Favorites hero layout.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "‎" + ArtistDetail.artist.name;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: Theme.page-title-weight;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    SearchBar {
                        text <=> ArtistDetail.filter;
                        placeholder: @tr("Filter tracks & albums…");
                        blur-trigger: ArtistDetail.blur-search-tick;
                        edited(t) => { root.filter-tick-pending += 1; }
                    }
                }
            }
            // Stats line — track + album counts.
            Text {
                vertical-stretch: 0;
                text: root.stats-line;
                color: Theme.subtext0;
                font-size: Theme.font-size-md;
                horizontal-alignment: left;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.pad-md;
                alignment: start;

                // Single pill: Play All → Shuffle → toggle → selection
                // chip (trailing, when active).
                ActionPill {
                    PillButton {
                        icon: "play_arrow";
                        icon-filled: true;
                        text: @tr("Play All");
                        clicked => { ArtistDetail.play-artist(); }
                    }
                    PillDivider { }
                    PillButton {
                        icon: "shuffle";
                        text: @tr("Shuffle");
                        clicked => { ArtistDetail.shuffle-artist(); }
                    }
                    PillDivider { }
                    ColumnTogglePopup {
                        show-number  <=> ArtistDetail.show-number;
                        show-artwork <=> ArtistDetail.show-artwork;
                        show-artist  <=> ArtistDetail.show-artist;
                        show-album   <=> ArtistDetail.show-album;
                        show-genre   <=> ArtistDetail.show-genre;
                        show-year    <=> ArtistDetail.show-year;
                        // Artist column is meaningless in this view —
                        // every row belongs to the same artist.
                        hide-artist: true;
                        // `tooltip-text` defaults to @tr("Columns").
                        toggled(id) => { ArtistDetail.toggle-column(id); }
                    }
                    if ArtistDetail.selected-ids.length > 0: PillDivider { }
                    if ArtistDetail.selected-ids.length > 0: PillLabel {
                        text: @tr("{} selected", ArtistDetail.selected-ids.length);
                    }
                    if ArtistDetail.selected-ids.length > 0: PillButton {
                        icon: "close";
                        tooltip-text: @tr("Clear selection");
                        clicked => { ArtistDetail.clear-selection(); }
                    }
                }
            }
        }

        // --- Below-hero scroll container --------------------------------
        // Wraps the Albums sub-section + the All Songs TrackList in a
        // single outer vertical `ScrollView` so one scrollbar (mounted
        // at the view root) covers both surfaces. The TrackList is
        // capped at the outer viewport height (`min` in its `height`
        // binding), so its inner ListView virtualizes to ~visible rows
        // — the outer ScrollView's own travel covers just the Albums
        // strip region, and the unified scrollbar composes both travels.
        // The mouse WHEEL does NOT hand off between the two nested
        // scrollers natively — Slint's inner ListView swallows the wheel
        // at its top edge instead of bubbling to `below-sv` (see
        // CompositeScroll). So `hover-catch` reports region hover to the
        // winit MouseWheel filter, which routes vertical wheel through
        // `vbar.scroll-to`; the scrollbar-drag path already composes both
        // travels directly.
        below-hero := Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Ancestor hover sentinel (see CompositeScroll). Forwards every
            // event to the ScrollView child — row clicks, drags and native
            // horizontal scroll are unaffected; only its `has-hover` is
            // observed. Empty-space clicks fall through to here (rows grab
            // their own), reproducing the root backdrop's blur-on-empty-click.
            hover-catch := TouchArea {
                width: 100%;
                height: 100%;
                changed has-hover => { CompositeScroll.hovered = self.has-hover; }
                clicked => { ArtistDetail.blur-search-tick += 1; }

            below-sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy:   always-off;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 0;

        // Albums sub-section — horizontal scroller of square album cards
        // above the all-tracks list. Hidden entirely when the artist has
        // no album credits. The header row toggles
        // `ArtistDetail.albums-collapsed` (persisted to
        // `settings.artist_albums_collapsed`), letting the user hand the
        // album scroller's vertical space to the track list below.
        if ArtistDetail.albums.length > 0: VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            padding-top: Theme.pad-md;
            // Bottom padding sits between the divider and the
            // track-list header below. The outer column has no
            // `spacing`, so without this pad the divider would butt
            // straight against the header chips.
            padding-bottom: Theme.pad-lg;
            spacing: Theme.pad-sm;

            // Clickable header: "Albums" label + chevron. Hit area is
            // the chevron + label only (compact), not the whole row
            // width — clicking dead space to the right of the chevron
            // shouldn't toggle. Chevron mirrors the convention used
            // elsewhere in the app: down (`expand_more`) when collapsed
            // ("click to expand downward"), up (`expand_less`) when
            // expanded ("click to collapse upward").
            HorizontalLayout {
                alignment: start;

                header-target := Rectangle {
                    width: header-row.preferred-width;
                    height: 28px;
                    // Pill chrome on hover — matches `PillButton`'s
                    // `border-radius: self.height / 2`.
                    border-radius: self.height / 2;
                    background: header-touch.has-hover
                        ? Theme.surface1
                        : transparent;
                    animate background { duration: Theme.dur-fast; easing: ease-in-out; }

                    header-row := HorizontalLayout {
                        // 10 px matches `PillButton`'s horizontal padding —
                        // keeps the rounded pill ends from crowding the
                        // text on the left and the chevron on the right.
                        // With 4 px the text optically hugs the left curve.
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 2px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("Albums");
                                color: Theme.text;
                                font-size: Theme.font-size-lg;
                                font-weight: 600;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: ArtistDetail.albums-collapsed
                                    ? "expand_more"
                                    : "expand_less";
                                icon-size: 20px;
                                icon-color: Theme.subtext0;
                            }
                        }
                    }

                    header-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ArtistDetail.toggle-albums-collapsed(); }
                    }
                }
            }

            // Use a horizontal `ScrollView`; the artist's album count is
            // small (typically 1–20) so virtualization isn't needed.
            // Gated on the collapse flag — `if` fully removes the
            // scroller from layout when collapsed (per the Slint pitfall:
            // `visible: false` still claims layout space).
            if !ArtistDetail.albums-collapsed: ScrollView {
                height: root.album-card-h + 2 * Theme.pad-xs;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: as-needed;

                HorizontalLayout {
                    spacing: Theme.pad-md;
                    padding-top: Theme.pad-xs;
                    padding-bottom: Theme.pad-xs;
                    alignment: start;

                    for album in ArtistDetail.albums: EntityCard {
                        card-width: root.album-card-w;
                        card-height: root.album-card-h;
                        artwork-path: album.artwork_path;
                        cover: ArtistDetail.request-album-cover(album.artwork_path);
                        fallback-icon: "album";
                        cover-scale-hover: album.artwork_path == "" ? 1.15 : 1.04;
                        title: album.name;
                        subtitle: album.year > 0 ? "\{album.year}" : "";
                        clicked => { ArtistDetail.open-album(album.id); }
                    }
                }
            }

            // Hairline between the Albums sub-section and the track-list
            // header below. Lives outside the collapse `if` so it stays
            // visible even when the scroller is hidden — giving the
            // collapsed sub-section a clear lower edge against the track
            // list. Same `Theme.surface2 @ 50%` recipe as `PillDivider`.
            Rectangle {
                height: 1px;
                background: Theme.surface2;
                opacity: 0.5;
            }
        }

        // Indent the TrackList with `Theme.pad-lg` on both sides so its
        // left/right edges match the Tracks and Browse views (whose root
        // VLs apply uniform `padding: Theme.pad-lg`). The root VL here
        // can't use that pattern because `DetailHeader` is full-bleed
        // for the hero blur — so the inset is applied per-child instead.
        //
        // Explicit `height` sizes TrackList to its full row count so
        // every row renders inside the outer ScrollView's flow — the
        // unified scrollbar can scroll past the Albums sub-section
        // into the table contents without the inner ListView clipping
        // to its own viewport. See the "Below-hero scroll container"
        // comment above for the virtualization tradeoff.
        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 0;
            padding-left: Theme.pad-lg;
            padding-right: Theme.pad-lg;
            // Vertical gap above the TrackList header. The Albums
            // sub-section already adds `padding-bottom: Theme.pad-lg`
            // when it's mounted (its hairline supplies the gap), so
            // we only contribute pad-lg here when the sub-section is
            // absent — e.g. the user filtered every album out via
            // the SearchBar. Doubling the gap when both are present
            // would visually disconnect the table from its header.
            padding-top: ArtistDetail.albums.length > 0 ? 0px : Theme.pad-lg;

            tl := TrackList {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                // Capped at the outer viewport: small lists keep the
                // content-tall layout (the outer ScrollView never needs
                // to scroll past them), large lists pin to the visible
                // region so the inner ListView virtualizes to ~visible
                // rows instead of instantiating every TrackListRowItem.
                height: min(
                    max(1, ArtistDetail.tracks.length)
                        * (ArtistDetail.show-artwork
                            ? Theme.row-h
                            : Theme.row-h-compact)
                        + 32px + Theme.pad-xs,
                    below-sv.visible-height);

                rows: ArtistDetail.tracks;

                w-number <=> ArtistDetail.w-number;
                w-title <=> ArtistDetail.w-title;
                w-artist <=> ArtistDetail.w-artist;
                w-album <=> ArtistDetail.w-album;
                w-genre <=> ArtistDetail.w-genre;
                w-year <=> ArtistDetail.w-year;
                w-length <=> ArtistDetail.w-length;

                show-number <=> ArtistDetail.show-number;
                show-artwork <=> ArtistDetail.show-artwork;
                show-artist <=> ArtistDetail.show-artist;
                show-album <=> ArtistDetail.show-album;
                show-genre <=> ArtistDetail.show-genre;
                show-year <=> ArtistDetail.show-year;
                number-mode: "index";

                sort-field: ArtistDetail.sort-field;
                sort-dir: ArtistDetail.sort-dir;
                playing-track-id: Player.vm.track.id;
                view-context: "artist-detail";
                view-selected-ids: ArtistDetail.selected-ids;

                request-sort(f) => { ArtistDetail.request-sort(f); }
                play-row(id, idx) => { ArtistDetail.play-row(id, idx); }
                play-next(ids) => { ArtistDetail.play-next(ids); }
                add-to-queue(ids) => { ArtistDetail.add-to-queue(ids); }
                toggle-row-favorite(ids, on) => { ArtistDetail.toggle-row-favorite(ids, on); }
                set-row-rating(ids, n) => { ArtistDetail.set-row-rating(ids, n); }
                select-row(idx, id, sh, ct) => { ArtistDetail.select-row(idx, id, sh, ct); }
                request-blur-search => { ArtistDetail.blur-search-tick += 1; }
                go-to-album(aid) => { ArtistDetail.go-to-album(aid); }
                go-to-artist(aid) => { ArtistDetail.go-to-artist(aid); }
                go-to-genre(gid) => { ArtistDetail.go-to-genre(gid); }
            }
        }
                }
            }
            }
        }
    }

    // Composite scroll math: the outer ScrollView's own travel covers
    // the Albums-strip region (viewport minus visible height), the
    // TrackList's inner ListView covers the rows. The unified scrollbar
    // below spans both travels; drags split the offset at the boundary.
    property <length> v-outer-max: max(0px, below-sv.viewport-height - below-sv.visible-height);
    property <length> v-inner-max: max(0px, tl.v-viewport-height - tl.v-visible-height);

    // Wheel routing (see CompositeScroll): mirror the winit filter's tick and
    // apply one composite step through the same `vbar.scroll-to` split the
    // scrollbar drag uses — the height cap and the inner ListView's
    // virtualization stay untouched.
    property <int> cs-wheel-watch: CompositeScroll.wheel-tick;
    changed cs-wheel-watch => {
        vbar.scroll-to(clamp(
            (-below-sv.viewport-y + tl.v-offset) - CompositeScroll.wheel-dy,
            0px, root.v-outer-max + root.v-inner-max));
        // Consume the accumulated delta so the winit filter starts the next
        // batch from zero (deltas accumulate in Rust to survive same-frame
        // wheel coalescing — see CompositeScroll).
        CompositeScroll.wheel-dy = 0px;
    }

    // Outer vertical scrollbar covers the Albums sub-section + the
    // tracklist together. Pinned to the right edge of the below-hero
    // region so it starts exactly under the hero banner.
    vbar := OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: below-hero.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: below-hero.height;
        visible-size: below-sv.visible-height;
        content-size: below-sv.visible-height + root.v-outer-max + root.v-inner-max;
        offset: -below-sv.viewport-y + tl.v-offset;
        scroll-to(o) => {
            below-sv.viewport-y = -min(o, root.v-outer-max);
            tl.set-v-offset(max(0px, o - root.v-outer-max));
        }
    }

    // Horizontal scrollbar still drives the TrackList's column pan.
    OverlayScrollbar {
        horizontal: true;
        x: tl.absolute-position.x - root.absolute-position.x;
        y: parent.height - self.height;
        width: tl.width - 10px;
        height: 10px;
        visible-size: tl.h-visible-width;
        content-size: tl.h-viewport-width;
        offset: tl.h-offset;
        scroll-to(o) => { tl.set-h-offset(o); }
    }
}
