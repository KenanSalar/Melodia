import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Search, Player } from "../globals.slint";
import { SearchBar } from "../components/search-bar.slint";
import { HorizontalCardStrip } from "../components/grid/horizontal-card-strip.slint";
import { ActionPill, PillLabel, PillButton, PillDivider } from "../components/action-pill.slint";
import { ColumnTogglePopup } from "../components/track-list/column-toggle-popup.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { TrackList } from "../components/track-list/track-list.slint";
import { OverlayScrollbar } from "../components/overlay-scrollbar.slint";

// The Search view (Nav sidebar index 0). Vertical regions:
//   * Hero — compact (~96 px). Centered SearchBar (autofocus) only —
//     no page title, matching the Tauri version. Each keystroke bumps
//     `Search.debounce-tick-pending`; the local 300 ms Timer fires
//     `Search.commit-search(query)` once the pending tick catches up.
//   * Below-hero scroll container — unified `ScrollView` over all
//     state branches:
//       (a) Recent searches chip list — only when `query == ""`
//           AND `recent-rows.length > 0`
//       (b) Loading — "Searching…" line when `loading && query != ""`
//       (c) Empty results — `search_off` icon + tagline
//       (d) Top Result + Songs two-column section — when there is at
//           least one tracks or a top-result
//       (e) Albums strip
//       (f) Artists strip
//
// Cross-tab nav: clicking an album/artist card stamps
// `*Detail.origin-nav-index = NAV_SEARCH` synchronously *before*
// flipping `Nav.selected-index` so the detail-view back arrow
// returns here. Wiring lives in `src/ui/callbacks/search.rs`.
export component SearchView inherits Rectangle {
    // Debounce — 300 ms (Tauri parity). The SearchBar's `edited` bumps
    // `debounce-tick-pending`; the Timer fires `commit-search` after
    // 300 ms of keystroke quiescence and writes `applied` to halt
    // itself. Mirrors the Tracks / Favorites filter-throttle shape.
    debounce := Timer {
        interval: 300ms;
        running: Search.debounce-tick-pending != Search.debounce-tick-applied;
        triggered() => {
            Search.debounce-tick-applied = Search.debounce-tick-pending;
            Search.commit-search(Search.query);
        }
    }

    // Single-shot focus on mount. SearchView is re-instantiated on every
    // navigation to Nav index 0, so this re-fires each time the user enters
    // the Search tab. A 1 ms Timer (not `init`) keeps the focus() call out of
    // binding evaluation — see search-bar.slint / view-transition.slint.
    autofocus := Timer {
        interval: 1ms;
        running: true;
        triggered() => {
            self.running = false;
            search-bar.focus-input();
        }
    }

    // Backdrop catches any click that no inner TouchArea consumes and
    // bumps the blur tick — the SearchBar observes the counter and
    // clears focus on change. Same pattern as Favorites / Tracks.
    TouchArea {
        clicked => { Search.blur-search-tick += 1; }
    }

    private property <length> hero-height: 96px;

    VerticalLayout {
        // --- Hero -------------------------------------------------------
        Rectangle {
            vertical-stretch: 0;
            height: root.hero-height;

            HorizontalLayout {
                padding: Theme.pad-lg;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    search-bar := SearchBar {
                        text <=> Search.query;
                        placeholder: @tr("Search your library…");
                        blur-trigger: Search.blur-search-tick;
                        input-width: 420px;
                        edited(t) => {
                            Search.debounce-tick-pending += 1;
                            Search.query-changed(t);
                        }
                        // Pressing Enter commits immediately, skipping
                        // the 300 ms throttle. Aligning the ticks
                        // cancels any pending Timer fire so the same
                        // query isn't committed twice. This is what
                        // lets the user re-run the preserved query
                        // after returning to the Search tab: tab-
                        // leave released `last_results` + cleared the
                        // models, but `Search.query` was kept, so
                        // editing isn't required — just focus + Enter.
                        accepted => {
                            Search.debounce-tick-applied = Search.debounce-tick-pending;
                            Search.commit-search(Search.query);
                        }
                    }
                }
            }
        }

        // --- Below-hero scroll container --------------------------------
        below-hero := Rectangle {
            vertical-stretch: 1;
            clip: true;

            below-sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy:   always-off;
                viewport-width: self.width;

                VerticalLayout {
                    padding-left: Theme.pad-lg;
                    padding-right: Theme.pad-lg;
                    padding-bottom: Theme.pad-lg;
                    spacing: Theme.pad-lg;

                    // (a) Recent searches ----------------------------
                    // Shown only when input is empty and there's
                    // saved history. Section heading + chip flow +
                    // "Clear all" button.
                    if Search.query == "" && Search.recent-rows.length > 0: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.pad-sm;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Recent");
                                    color: Theme.text;
                                    font-size: Theme.font-size-md;
                                    font-weight: 700;
                                    letter-spacing: 0.4px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                clear-target := Rectangle {
                                    width: clear-label.preferred-width + 16px;
                                    height: 24px;
                                    border-radius: self.height / 2;
                                    background: clear-touch.has-hover
                                        ? Theme.surface1
                                        : transparent;
                                    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                                    clear-label := Text {
                                        x: 8px;
                                        y: (parent.height - self.height) / 2;
                                        text: @tr("Clear all");
                                        color: Theme.subtext0;
                                        font-size: Theme.font-size-sm;
                                    }
                                    clear-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { Search.recent-clear(); }
                                    }
                                }
                            }
                        }

                        // Chip flow — a `HorizontalLayout` with
                        // `wrap` isn't natively supported in Slint
                        // 1.16, so we use a plain HorizontalLayout
                        // with `alignment: start` and let overflow
                        // sit outside the visible area (the recent
                        // list caps at 10 chips, and chip widths
                        // are bounded, so on any sensible window
                        // size every chip is visible). Tradeoff
                        // accepted for v1 — a flow layout is a
                        // future component.
                        HorizontalLayout {
                            spacing: Theme.pad-sm;
                            alignment: start;
                            for term in Search.recent-rows: chip-host := Rectangle {
                                height: 28px;
                                width: term-text.preferred-width + close-cell.width + 18px;
                                border-radius: self.height / 2;
                                background: chip-touch.has-hover
                                    ? Theme.surface1
                                    : Theme.surface0;
                                border-width: 1px;
                                border-color: Theme.surface2;
                                animate background { duration: Theme.dur-fast; easing: ease-in-out; }

                                term-text := Text {
                                    x: 10px;
                                    y: (parent.height - self.height) / 2;
                                    text: term;
                                    color: Theme.text;
                                    font-size: Theme.font-size-sm;
                                }

                                // Full-chip TouchArea declared before
                                // `close-cell` below so the close cell's
                                // nested TouchArea wins click dispatch on
                                // the X icon (Slint dispatches to the
                                // last-declared overlapping TouchArea).
                                chip-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Search.recent-pick(term); }
                                }

                                close-cell := Rectangle {
                                    x: parent.width - self.width - 4px;
                                    y: (parent.height - self.height) / 2;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: close-touch.has-hover
                                        ? Theme.surface2
                                        : transparent;
                                    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                                    MaterialIcon {
                                        name: "close";
                                        icon-size: 14px;
                                        icon-color: Theme.subtext0;
                                    }
                                    close-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        // `close-cell` is declared after
                                        // `chip-touch` above, so this
                                        // nested TouchArea sits on top
                                        // and wins click dispatch on the
                                        // close cell.
                                        clicked => { Search.recent-remove(term); }
                                    }
                                }
                            }
                        }
                    }

                    // (b) Loading ------------------------------------
                    if Search.loading && Search.query != "": HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: center;
                        padding-top: Theme.pad-lg;
                        Text {
                            text: @tr("Searching…");
                            color: Theme.subtext0;
                            font-size: Theme.font-size-md;
                        }
                    }

                    // (c) Empty results ------------------------------
                    if !Search.loading && Search.query != ""
                        && Search.tracks.length == 0
                        && Search.album-rows.length == 0
                        && Search.artist-rows.length == 0
                        && Search.top-kind == "": VerticalLayout {
                        vertical-stretch: 0;
                        alignment: center;
                        padding-top: 48px;
                        spacing: Theme.pad-sm;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                Text {
                                    text: "search_off";
                                    color: Theme.subtext0;
                                    font-family: "Material Symbols Rounded";
                                    font-size: 42px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: @tr("No results found");
                                color: Theme.text;
                                font-size: Theme.font-size-lg;
                                font-weight: 600;
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: @tr("Try a different search term");
                                color: Theme.subtext0;
                                font-size: Theme.font-size-sm;
                            }
                        }
                    }

                    // (d) Top Result + Songs (two-col) ---------------
                    // The Top Result subtree is unmounted (`if`, not
                    // `visible: false`) when there's no top — the
                    // Songs column then claims full width naturally.
                    if Search.top-kind != "" || Search.tracks.length > 0: HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.pad-lg;
                        alignment: stretch;

                        // Top Result featured card.
                        if Search.top-kind != "": VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: start;
                            spacing: Theme.pad-sm;

                            // Heading row — same shape as the Songs
                            // heading row below so the two texts
                            // share a baseline. Songs HL stretches
                            // to 32 px because of the ActionPill;
                            // pinning this HL to the same height
                            // (and centring the text inside via
                            // alignment: center) keeps the headings
                            // optically aligned AND the spacing
                            // below them equal — which means the
                            // top of `top-card` and the top of the
                            // TrackList header land at the same y.
                            HorizontalLayout {
                                height: 32px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: @tr("Top Result");
                                        color: Theme.text;
                                        font-size: Theme.font-size-md;
                                        font-weight: 700;
                                        letter-spacing: 0.4px;
                                    }
                                }
                            }

                            top-card := Rectangle {
                                width: 240px;
                                height: 320px;
                                background: top-touch.has-hover
                                    ? Theme.surface1
                                    : Theme.surface0;
                                border-radius: Theme.radius-lg;
                                border-width: 1px;
                                border-color: Theme.surface2;
                                animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                                clip: true;

                                VerticalLayout {
                                    padding: Theme.pad-md;
                                    spacing: Theme.pad-sm;

                                    // Artwork tile (square + rounded).
                                    // `circular: true` when the top
                                    // result is an artist — matches
                                    // the Artists strip's circular
                                    // cards convention.
                                    Rectangle {
                                        width: 216px;
                                        height: 216px;
                                        border-radius: Search.top-kind == "artist"
                                            ? self.height / 2
                                            : Theme.radius-md;
                                        background: Theme.surface1;
                                        clip: true;

                                        if Search.top-artwork-path != "": Image {
                                            width: 100%;
                                            height: 100%;
                                            source: Search.request-top-result-cover(Search.top-artwork-path);
                                            image-fit: ImageFit.cover;
                                        }
                                        if Search.top-artwork-path == "": Text {
                                            text: Search.top-kind == "artist" ? "person" : "album";
                                            color: Theme.subtext0;
                                            font-family: "Material Symbols Rounded";
                                            font-size: 96px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Badge — localised inline so the
                                    // gettext extractor sees the
                                    // literal strings. Rust-pushed
                                    // strings can't `@tr()`.
                                    Text {
                                        text: Search.top-kind == "album"
                                            ? @tr("Album")
                                            : @tr("Artist");
                                        color: Theme.accent;
                                        font-size: Theme.font-size-sm;
                                        font-weight: 600;
                                        letter-spacing: 0.4px;
                                    }
                                    Text {
                                        text: Search.top-title;
                                        color: Theme.text;
                                        font-size: Theme.font-size-md;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: Search.top-subtitle;
                                        color: Theme.subtext0;
                                        font-size: Theme.font-size-sm;
                                        overflow: elide;
                                    }
                                }

                                top-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Search.blur-search-tick += 1;
                                        Search.open-top-result();
                                    }
                                }
                            }
                        }

                        // Songs column.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.pad-sm;

                            // Pinned to 32 px so the heading baseline
                            // matches the Top Result heading row's,
                            // regardless of whether the ActionPill
                            // is currently mounted (it only renders
                            // when tracks.length > 0, but the row
                            // height must stay constant for cross-
                            // column alignment).
                            HorizontalLayout {
                                height: 32px;
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: @tr("Songs");
                                        color: Theme.text;
                                        font-size: Theme.font-size-md;
                                        font-weight: 700;
                                        letter-spacing: 0.4px;
                                    }
                                }

                                // ActionPill — Columns + selection
                                // chip. The two playback pills
                                // (Play All / Shuffle) intentionally
                                // omitted from v1 — Search has no
                                // single "all of these tracks"
                                // semantic the way Favorites does
                                // (the user picked the query; play
                                // expectations are per-row).
                                if Search.tracks.length > 0: ActionPill {
                                    ColumnTogglePopup {
                                        show-number  <=> Search.show-number;
                                        show-artwork <=> Search.show-artwork;
                                        show-artist  <=> Search.show-artist;
                                        show-album   <=> Search.show-album;
                                        show-genre   <=> Search.show-genre;
                                        show-year    <=> Search.show-year;
                                        toggled(id) => { Search.toggle-column(id); }
                                    }
                                    if Search.selected-ids.length > 0: PillDivider { }
                                    if Search.selected-ids.length > 0: PillLabel {
                                        text: @tr("{} selected", Search.selected-ids.length);
                                    }
                                    if Search.selected-ids.length > 0: PillButton {
                                        icon: "close";
                                        tooltip-text: @tr("Clear selection");
                                        clicked => {
                                            Search.clear-selection();
                                            Search.blur-search-tick += 1;
                                        }
                                    }
                                }
                            }

                            tl := TrackList {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                // Size to row count so the outer
                                // ScrollView drives both strips +
                                // tracklist together (same trade-off
                                // as favorites-view). `max(1, …)`
                                // keeps the column header rendering
                                // when zero rows are visible.
                                height: max(1, Search.tracks.length)
                                    * (Search.show-artwork
                                        ? Theme.row-h
                                        : Theme.row-h-compact)
                                    + 32px + Theme.pad-xs;

                                rows: Search.tracks;

                                w-number <=> Search.w-number;
                                w-title  <=> Search.w-title;
                                w-artist <=> Search.w-artist;
                                w-album  <=> Search.w-album;
                                w-genre  <=> Search.w-genre;
                                w-year   <=> Search.w-year;
                                w-length <=> Search.w-length;

                                show-number  <=> Search.show-number;
                                show-artwork <=> Search.show-artwork;
                                show-artist  <=> Search.show-artist;
                                show-album   <=> Search.show-album;
                                show-genre   <=> Search.show-genre;
                                show-year    <=> Search.show-year;
                                number-mode: "index";

                                sort-field: Search.sort-field;
                                sort-dir:   Search.sort-dir;
                                playing-track-id: Player.vm.track.id;
                                view-context: "search";
                                view-selected-ids: Search.selected-ids;

                                request-sort(f)        => { Search.request-sort(f); }
                                play-row(id, idx)      => { Search.play-row(id, idx); }
                                play-next(ids)         => { Search.play-next(ids); }
                                add-to-queue(ids)      => { Search.add-to-queue(ids); }
                                toggle-row-favorite(ids, on) => { Search.toggle-row-favorite(ids, on); }
                                set-row-rating(ids, n) => { Search.set-row-rating(ids, n); }
                                select-row(idx, id, sh, ct) => { Search.select-row(idx, id, sh, ct); }
                                request-blur-search => { Search.blur-search-tick += 1; }
                                // Search already has `open-album` /
                                // `open-artist` for grid-card clicks —
                                // re-use them for the row context menu
                                // so cross-tab nav semantics stay
                                // consistent.
                                go-to-album(aid) => { Search.open-album(aid); }
                                go-to-artist(aid) => { Search.open-artist(aid); }
                                go-to-genre(gid) => { Search.go-to-genre(gid); }
                            }

                            // Horizontal scrollbar for the TrackList
                            // — sits right below the table so the
                            // user can reach off-screen columns
                            // (artist / album / genre / year /
                            // length) when the window is too narrow
                            // for `tl.total-w`. Mounted inside the
                            // songs column rather than at SearchView
                            // root because `tl` is declared inside
                            // the `if Search.top-kind != "" ||
                            // Search.tracks.length > 0` conditional
                            // and Slint scopes `id`s to their
                            // enclosing conditional — root-level
                            // references would fail to compile.
                            //
                            // Always-mounted with a fixed 10 px slot
                            // — gating the `if` on `tl.h-viewport-
                            // width > tl.h-visible-width` would
                            // introduce a binding loop (the `if`
                            // affects layout → tl.width changes →
                            // h-visible-width changes → if-condition
                            // re-evaluates). The `OverlayScrollbar`'s
                            // built-in `visible: content-size >
                            // visible-size` gate already auto-hides
                            // the thumb when there's no overflow,
                            // leaving a 10 px transparent slot —
                            // small visual cost in exchange for
                            // always-correct overflow access.
                            OverlayScrollbar {
                                horizontal: true;
                                height: 10px;
                                visible-size: tl.h-visible-width;
                                content-size: tl.h-viewport-width;
                                offset: tl.h-offset;
                                scroll-to(o) => { tl.set-h-offset(o); }
                            }

                            // Show all N / Show less toggle — only
                            // mounted when the backend returned more
                            // than the compact cap. Clicking flips
                            // `show-all-tracks`; Rust's apply path
                            // re-derives the visible slice from the
                            // cached `last_results` (no DB hit).
                            if Search.tracks-total > 5: HorizontalLayout {
                                alignment: center;
                                padding-top: Theme.pad-xs;
                                show-more-target := Rectangle {
                                    width: show-more-label.preferred-width + 24px;
                                    height: 28px;
                                    border-radius: self.height / 2;
                                    background: show-more-touch.has-hover
                                        ? Theme.surface1
                                        : transparent;
                                    border-width: 1px;
                                    border-color: Theme.surface2;
                                    animate background { duration: Theme.dur-fast; easing: ease-in-out; }
                                    show-more-label := Text {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        text: Search.show-all-tracks
                                            ? @tr("Show less")
                                            : @tr("Show all {} songs", Search.tracks-total);
                                        color: Theme.text;
                                        font-size: Theme.font-size-sm;
                                        font-weight: 600;
                                    }
                                    show-more-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { Search.toggle-show-all-tracks(); }
                                    }
                                }
                            }
                        }
                    }

                    // (e) Albums strip --------------------------------
                    if Search.album-rows.length > 0: HorizontalCardStrip {
                        heading: @tr("Albums");
                        rows: Search.album-rows;
                        card-width: 160px;
                        card-height: 206px;
                        show-play-overlay: false;
                        fallback-icon: "album";
                        request-cover(p) => {
                            return Search.request-album-strip-cover(p);
                        }
                        row-clicked(id) => {
                            Search.blur-search-tick += 1;
                            Search.open-album(id);
                        }
                        // play-clicked unused (no play-overlay).
                    }

                    // (f) Artists strip -------------------------------
                    if Search.artist-rows.length > 0: HorizontalCardStrip {
                        heading: @tr("Artists");
                        rows: Search.artist-rows;
                        card-width: 160px;
                        card-height: 206px;
                        circular: true;
                        show-play-overlay: false;
                        fallback-icon: "person";
                        request-cover(p) => {
                            return Search.request-artist-strip-cover(p);
                        }
                        row-clicked(id) => {
                            Search.blur-search-tick += 1;
                            Search.open-artist(id);
                        }
                    }

                    // Trailing surplus collector — without this, a
                    // VerticalLayout whose `if`-gated children are
                    // all `vertical-stretch: 0` divides spare height
                    // equally among them, which pushes the Recent
                    // heading to the top of the scroll area and the
                    // chips to the bottom with a yawning gap between
                    // (only the Recent section is mounted in the
                    // empty-query state). The 1-stretch Rectangle
                    // absorbs the surplus so every real section sits
                    // at the top with its natural height.
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }

    // Outer vertical scrollbar — drives `below-sv`, covering Top
    // Result + Songs + strips together. Pinned to the right edge of
    // the below-hero region so it starts under the hero banner.
    OverlayScrollbar {
        horizontal: false;
        x: parent.width - self.width;
        y: below-hero.absolute-position.y - root.absolute-position.y;
        width: 10px;
        height: below-hero.height;
        visible-size: below-sv.visible-height;
        content-size: below-sv.viewport-height;
        offset: -below-sv.viewport-y;
        scroll-to(o) => { below-sv.viewport-y = -o; }
    }

}
