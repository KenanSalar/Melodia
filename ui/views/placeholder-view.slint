import { Theme } from "../theme.slint";

export component PlaceholderView inherits Rectangle {
    in property <string> title;

    // No own background — see TracksView for the why. The parent content
    // panel paints `Theme.base` inside its rounded shape; a transparent
    // root lets the rounded fill show through at the corner cells.

    VerticalLayout {
        alignment: center;
        spacing: Theme.pad-sm;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 28px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Coming soon");
            color: Theme.subtext0;
            font-size: Theme.font-size-md;
            horizontal-alignment: center;
        }
    }
}
