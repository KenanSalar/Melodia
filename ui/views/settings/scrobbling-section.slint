import { Settings } from "../../settings.slint";
import { Theme } from "../../theme.slint";
import { Dialog, ScrobbleUi } from "../../globals.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";
import { SectionButton } from "../../components/settings/section-button.slint";

// Scrobbling section: per-service status + Connect/Disconnect, an enable toggle
// that only mounts once the service is connected, and a "Sync loved tracks"
// toggle (Last.fm-primary, so gated on the Last.fm connection). Rust owns every
// `Settings.scrobble-*` value; the status props are painted by the
// `ScrobbleService` status-watch subscriber in `src/ui/scrobbling_settings.rs`.
// Connect opens its login dialog inline here (the tray-toggle pattern) rather
// than through a Rust callback, so the `@tr` chrome stays in Slint and we dodge
// Slint's "recursion detected" guard on a Rust-driven `Dialog.open`.
// Search visibility — see header comment in `playback-section.slint`.
export component ScrobblingSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> query: Settings.search-query;

    pure function row-visible(label: string, desc: string) -> bool {
        return root.query == ""
            || Settings.matches(@tr("Scrobbling"), root.query)
            || Settings.matches(label + " " + desc, root.query);
    }

    // One cluster per service; the enable-toggle labels are folded into the
    // status row's search text so matching "scrobble" reveals the whole cluster.
    property <bool> show-lastfm: row-visible(
        @tr("Last.fm") + " " + @tr("Scrobble to Last.fm"),
        @tr("Report each play to your Last.fm account"));
    property <bool> show-listenbrainz: row-visible(
        @tr("ListenBrainz") + " " + @tr("Scrobble to ListenBrainz"),
        @tr("Report each play to your ListenBrainz account"));
    // Love sync is Last.fm-primary, so its row only exists while Last.fm is
    // connected — hidden otherwise regardless of the search query.
    property <bool> show-love: Settings.scrobble-lastfm-connected && row-visible(
        @tr("Sync loved tracks"),
        @tr("Mark tracks you love here as loved on Last.fm"));

    out property <bool> has-matches: show-lastfm || show-listenbrainz || show-love;

    VerticalLayout {
    if has-matches: SectionCard {
        title: @tr("Scrobbling");

        // ---- Last.fm ----
        if root.show-lastfm: SettingRow {
            icon: "history";
            label: @tr("Last.fm");
            description: Settings.scrobble-lastfm-connected
                ? @tr("Connected as {}", Settings.scrobble-lastfm-username)
                : (Settings.scrobble-lastfm-configured
                    ? @tr("Not connected")
                    : @tr("Not configured in this build"));

            if Settings.scrobble-lastfm-configured && !Settings.scrobble-lastfm-connected: SectionButton {
                label: @tr("Connect");
                icon: "";
                primary: true;
                clicked => {
                    ScrobbleUi.lastfm-step = 0;
                    ScrobbleUi.lastfm-token = "";
                    ScrobbleUi.busy = false;
                    ScrobbleUi.error = "";
                    Dialog.kind = "scrobble-lastfm-login";
                    Dialog.title = @tr("Connect Last.fm");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Open Last.fm");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
            if Settings.scrobble-lastfm-connected: SectionButton {
                label: @tr("Disconnect");
                icon: "";
                primary: false;
                clicked => { Settings.scrobble-lastfm-disconnect(); }
            }
        }

        if root.show-lastfm && Settings.scrobble-lastfm-connected: SettingRow {
            icon: "upload";
            label: @tr("Scrobble to Last.fm");
            description: @tr("Report each play to your Last.fm account");
            ToggleSwitch {
                checked <=> Settings.scrobble-lastfm-enabled;
                toggled(v) => { Settings.scrobble-lastfm-enabled-changed(v); }
            }
        }

        if root.show-lastfm && root.show-listenbrainz: SectionDivider {}

        // ---- ListenBrainz ----
        if root.show-listenbrainz: SettingRow {
            icon: "history";
            label: @tr("ListenBrainz");
            description: Settings.scrobble-listenbrainz-connected
                ? @tr("Connected as {}", Settings.scrobble-listenbrainz-username)
                : @tr("Not connected");

            if !Settings.scrobble-listenbrainz-connected: SectionButton {
                label: @tr("Connect");
                icon: "";
                primary: true;
                clicked => {
                    ScrobbleUi.lb-token = "";
                    ScrobbleUi.busy = false;
                    ScrobbleUi.error = "";
                    Dialog.kind = "scrobble-listenbrainz-login";
                    Dialog.title = @tr("Connect ListenBrainz");
                    Dialog.message = "";
                    Dialog.confirm-label = @tr("Connect");
                    Dialog.cancel-label = @tr("Cancel");
                    Dialog.destructive = false;
                    Dialog.open = true;
                }
            }
            if Settings.scrobble-listenbrainz-connected: SectionButton {
                label: @tr("Disconnect");
                icon: "";
                primary: false;
                clicked => { Settings.scrobble-listenbrainz-disconnect(); }
            }
        }

        if root.show-listenbrainz && Settings.scrobble-listenbrainz-connected: SettingRow {
            icon: "upload";
            label: @tr("Scrobble to ListenBrainz");
            description: @tr("Report each play to your ListenBrainz account");
            ToggleSwitch {
                checked <=> Settings.scrobble-listenbrainz-enabled;
                toggled(v) => { Settings.scrobble-listenbrainz-enabled-changed(v); }
            }
        }

        if root.show-love && (root.show-lastfm || root.show-listenbrainz): SectionDivider {}

        // ---- Love sync (Last.fm-primary) ----
        if root.show-love: SettingRow {
            icon: "favorite";
            label: @tr("Sync loved tracks");
            description: @tr("Mark tracks you love here as loved on Last.fm");
            ToggleSwitch {
                checked <=> Settings.scrobble-love-sync;
                toggled(v) => { Settings.scrobble-love-sync-changed(v); }
            }
        }
    }
    }
}
