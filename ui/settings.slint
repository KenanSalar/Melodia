// Settings global — single source of truth for the Settings page's
// reactive state. Rust populates the lists and indices at startup
// (`src/ui/appearance.rs::install`) and on every chip / dot click; the
// Settings UI binds chip groups + colour-dot grids to these properties
// and forwards `selected(int)` events to the change callbacks.

export global Settings {
    // Stable across runs — populated once at startup from `themes::registry()`.
    in property <[string]> theme-names;
    in-out property <int> theme-idx;

    // Variant chips are inlined in `ui/views/settings/appearance-section.slint`
    // as conditional literal `[@tr("Dark"), @tr("Light"), @tr("System")]` /
    // Catppuccin proper-noun lists so Slint's bundled translations can
    // re-render them on locale switch. Rust drives only the selected
    // index (`variant-idx`).
    in-out property <int> variant-idx;

    // Re-populated whenever theme OR variant changes (Catppuccin shades
    // each accent per-variant, so the same id renders different swatches
    // in Latte vs. Mocha). Length matches `accent-names` 1:1; the
    // ColorDotGrid renders one tooltip per dot pulled from
    // `accent-names[i]` (so users can tell which colour is which —
    // especially when Material You prepends a 9th dynamic dot).
    in property <[brush]> accent-colors;
    in property <[string]> accent-names;
    in-out property <int> accent-idx;

    // True when the active theme is KDE Breeze, the chosen variant is
    // "System", and a parsed `kdeglobals` palette is available — i.e. the
    // 22 brushes are sourced from Plasma's live colour scheme rather than
    // the static Light/Dark palette. The Accent Color row reads this to
    // hide the dot grid (the OS already picked the accent). Rust writes
    // it on every appearance change.
    in property <bool> kde-system-active;

    // Material 3 dynamic-colour style picker. The chip labels are inlined
    // in `ui/views/settings/appearance-section.slint` as a literal
    // `[@tr("None"), @tr("Tonal Spot"), …]` list so Slint's bundled
    // translations can re-render them on locale switch. This index
    // matches `services::material_you::SchemeStyle::all()` 1:1 (length 8,
    // index 0 = None). Visible only when the active theme is Material 3.
    in-out property <int> color-style-idx;

    // True when the user has picked a non-`None` Color Style *and* the
    // Material You coordinator successfully extracted a seed colour from
    // the current artwork. Drives:
    //   - The Material 3 accent grid: when active, Rust prepends a 9th
    //     "Material You" swatch (rendered in the dynamic primary) at
    //     index 0 of `accent-colors`.
    //   - The Color Style row's description text — flips between
    //     "Active — palette derived from the current track's artwork."
    //     and "Generate theme colors from album artwork." so users
    //     can tell whether dynamic colour is currently driving the UI.
    in property <bool> material-you-active;

    // Fired on chip / dot click. Rust resolves idx → id, persists, applies
    // the new palette, and writes back the lists.
    callback theme-changed(int);
    callback variant-changed(int);
    callback accent-changed(int);
    callback color-style-changed(int);

    // True iff `library::settings::is_kde_desktop()` returned true at
    // startup. Hides the "Match Unfocused Window Background" row
    // entirely off-KDE — the behaviour mirrors KDE's window-decoration
    // fade and isn't meaningful elsewhere. Set once in
    // `appearance::install`; never written from Slint.
    in property <bool> match-unfocused-supported;

    // User toggle for the "Match Unfocused Window Background" row.
    // Two-way `<=>` from the ToggleSwitch lets the component's local
    // `checked` write update this directly; `match-unfocused-bg-changed`
    // fires on every click so Rust persists through
    // `library::settings::set_match_unfocused_to_system_bg` and
    // re-evaluates the runtime gate in `window_chrome.rs`.
    in-out property <bool> match-unfocused-bg;
    callback match-unfocused-bg-changed(bool);

    // User toggle for "System Tray Icon" — whether the tray subsystem runs
    // at all. Rust-seeded at startup from `settings.tray.enabled`; never
    // written from Slint (the ToggleSwitch is `manual: true` and routes
    // through the `restart-tray` Dialog, since the change only applies on
    // the next launch). Default off — the tray is opt-in.
    in property <bool> tray-enabled;

    // True once a system-tray icon has actually been created (see
    // `ui::tray_bridge`). The "Close to Tray" row is greyed out (not hidden)
    // when false — either because `tray-enabled` is off, or because the
    // session has no tray host (e.g. vanilla GNOME without the AppIndicator
    // extension), in which case the close handlers fall back to quitting and
    // the toggle would have no effect. Set once tray init succeeds —
    // synchronously on Linux, from the deferred event-loop init on
    // Windows / macOS; never written from Slint.
    in property <bool> tray-active;

    // Close to Tray toggle. ToggleSwitch in
    // `ui/views/settings/window-chrome-section.slint` binds two-way; the
    // `toggled(bool)` event fires `close-to-tray-changed`. Rust applies the
    // new value synchronously to a process-global atomic via
    // `ui::tray_bridge::set_close_to_tray` (so `window_chrome`'s close
    // handlers pick it up on the next close), then persists through
    // `library::window::set_close_to_tray` on the blocking pool. Seeded at
    // startup from `settings.tray.close_to_tray`. Default is `false` (off) —
    // closing the window quits, matching every release before the tray
    // landed. When no tray icon is active the close handlers fall back to
    // quitting regardless, so enabling this can never strand the window.
    in-out property <bool> close-to-tray: false;
    callback close-to-tray-changed(bool);

    // Gapless playback toggle. ToggleSwitch in
    // `ui/views/settings/playback-section.slint` binds two-way; the
    // `toggled(bool)` event fires `gapless-playback-changed`. Rust
    // applies the new value to `PlayerState.gapless_enabled`
    // synchronously via `library::playback::player_set_gapless` (so the
    // next 500 ms position-monitor tick picks it up), then persists
    // through `library::settings::set_gapless_playback` on the blocking
    // pool. Seeded at startup from `settings.playback.gapless_playback`
    // in `src/ui/playback_settings.rs::install_playback_settings`.
    in-out property <bool> gapless-playback: true;
    callback gapless-playback-changed(bool);

    // Play button animation selector. ChipGroup in
    // `ui/views/settings/playback-section.slint` binds two-way and forwards
    // `selected(int)` to `play-button-animation-changed`. The PlayButton in
    // `ui/components/now-playing/play-button.slint` reads this idx to switch behaviour.
    // Indices: 0 = None, 1 = Equalizer. Seeded at startup from
    // `settings.play_button_animation` in
    // `src/ui/playback_settings.rs::install_playback_settings`; Rust does the
    // idx ↔ token mapping in both directions so a malformed disk value can't
    // pin the chip to an invalid index.
    in-out property <int> play-button-animation-idx: 0;
    callback play-button-animation-changed(int);

    // Resume on Startup toggle. ToggleSwitch in
    // `ui/views/settings/playback-section.slint` binds two-way; the
    // `toggled(bool)` event fires `resume-on-startup-changed`. Single-phase
    // persist via `library::settings::set_resume_on_startup` on the
    // blocking pool — no runtime side effect, the flag is consulted once
    // at next launch in `main.rs` after `restore_persisted_queue`. Seeded
    // at startup from `settings.playback.resume_on_startup` in
    // `src/ui/playback_settings.rs::install_playback_settings`. Default
    // is `false` (off) to match `PlaybackFlags::default()`.
    in-out property <bool> resume-on-startup: false;
    callback resume-on-startup-changed(bool);

    // Watch for file changes (file-watcher) toggle. ToggleSwitch in
    // `ui/views/settings/file-watching-section.slint` binds two-way; the
    // `toggled(bool)` event fires `watch-for-file-changes-changed`. Rust
    // persists `library.folder_watching_enabled` then flips the
    // `FolderWatcher` start/stop state via
    // `library::settings::set_folder_watching_enabled` on the tokio
    // runtime (the watcher start needs an async DB query before taking
    // the parking_lot lock). Seeded at startup from
    // `settings.library.folder_watching_enabled` in
    // `src/ui/file_watching.rs::install`. Default is `true` (on) — consumer
    // music players auto-watch with no toggle, and shipping with watching
    // off out of the box stranded new users in a stale-UI failure mode.
    // `LibraryFlags::default()` matches this default.
    in-out property <bool> watch-for-file-changes: true;
    callback watch-for-file-changes-changed(bool);

    // Window corner radius in logical pixels. Single source of truth for
    // the AppearanceSection's "Window Corner Radius" row — the preset
    // chip group binds here, and Rust mirrors the value into
    // `Theme.shell-radius` on every change so the rounded outer mantle
    // shell + inner content panel repaint reactively. Set once at
    // startup in `src/ui/appearance.rs::install` from
    // `services::settings::SettingsData.corner_radius` (clamped to
    // `MAX_CORNER_RADIUS = 15` and snapped to the nearest chip preset
    // via `library::settings::snap_to_preset`, so the value here is
    // always one of {0, 6, 8, 10, 15} — guarantees the chip selection
    // matches what's painted, even if `settings.json` was hand-edited
    // to an off-preset value). Name kept unitless to match the Rust
    // field `SettingsData.corner_radius` for grep-friendliness.
    in-out property <int> corner-radius: 6;
    callback corner-radius-changed(int);

    // Custom-titlebar decoration button style.
    //   0 = Standard (Material bar icons, current Windows-like look)
    //   1 = macOS    (red/yellow/green traffic-light circles with
    //                 hover-reveal glyphs and grey-when-unfocused fill)
    // Mirrored synchronously into `Theme.titlebar-button-style` by the
    // Rust callback so `ui/components/custom-titlebar.slint` can read it
    // through `Theme` (same precedent as `Theme.shell-radius`). Only
    // active when `Theme.use-native-titlebar == false` — under the
    // native titlebar the OS owns the decoration buttons.
    in-out property <int> titlebar-button-style: 0;
    callback titlebar-button-style-changed(int);

    // Custom-titlebar decoration button side.
    //   0 = Right (current default, matches Windows / KDE convention)
    //   1 = Left  (macOS convention; works with either style)
    // Independent of `titlebar-button-style` — all four combinations
    // render cleanly with close always kept at the outer window corner.
    in-out property <int> titlebar-button-side: 0;
    callback titlebar-button-side-changed(int);

    // Overflow Menu Buttons — five independently-toggleable bools that
    // mirror `services::settings::SettingsData.overflow_buttons` (a
    // Vec<String> of ids). Stored as discrete bools (rather than a
    // [string] model) so the change callback can pinpoint which button
    // toggled without diffing arrays. Each Appearance-section checkbox
    // binds two-way to the matching prop and fires
    // `overflow-buttons-changed(id, on)`; Rust applies the add/remove
    // against the Vec and persists. The now-playing bar reads them
    // directly to gate inline-vs-overflow visibility.
    in-out property <bool> overflow-favorite;
    in-out property <bool> overflow-repeat;
    in-out property <bool> overflow-shuffle;
    in-out property <bool> overflow-pin;
    in-out property <bool> overflow-queue;
    callback overflow-buttons-changed(string /*id*/, bool /*overflow-on*/);

    // Language picker — bundled `.po` translations are baked into the binary
    // (build.rs uses `slint_build::CompilerConfiguration::with_bundled_translations`).
    // Rust populates `language-names` with native-name labels (always shown in
    // the language's own script, never re-translated) and `language-codes`
    // with the matching `services::settings::SUPPORTED_LOCALES` codes. The
    // dropdown two-way binds to `language-idx`; the change callback resolves
    // idx → code, calls `slint::select_bundled_translation(code)` synchronously
    // (which re-renders every `@tr(...)` on the next frame), then spawns the
    // disk persist via `library::settings::set_locale`. See
    // `src/ui/locale.rs::install_locale`.
    in property <[string]> language-names;
    in property <[string]> language-codes;
    in-out property <int>  language-idx;
    callback language-changed(int);

    // Live filter for the Settings page. Empty string ⇒ everything visible.
    // Bound two-way to the SearchBar in `ui/views/settings-view.slint`;
    // each section reads it via the inherited `query` prop and hides
    // SettingRows whose label/description don't match. Cleared on
    // nav-away from the Settings page (handler in `ui/app-window.slint`).
    in-out property <string> search-query;

    // Counter the host bumps to release keyboard focus from the SearchBar's
    // TextInput — same pattern as `Tracks.blur-search-tick`. Used when
    // navigating away from the page so the next keystroke doesn't land in
    // a hidden field.
    in-out property <int> blur-search-tick: 0;

    // Pure case-insensitive substring test. Slint 1.16 has no `.contains()`
    // on string, so the substring check is wired in Rust
    // (`src/ui/appearance.rs::install`). Used inside `visible:` /
    // `if`-block expressions in the section files; Slint's reactive
    // dependency tracking handles re-evaluation on `search-query` changes.
    pure callback matches(string /*haystack*/, string /*needle*/) -> bool;

    // About section — opens the project's source repository
    // (`CARGO_PKG_REPOSITORY`) in the system browser. Action callback
    // (Slint → Rust); wired in `src/ui/about.rs`, no Slint-side handler.
    callback open-repository();

    // Translated strings for the "File watching disabled" notification.
    // Surfaced as `pure callback`s so the Rust side can resolve them
    // through Slint's bundled-translation pipeline (`@tr(...)`) without
    // needing a Rust-side `tr(...)` helper — Slint 1.16 doesn't expose
    // `translate_from_bundle` publicly. Same shape as `matches` above.
    // Rust calls `ui.global::<Settings>().invoke_watcher_disabled_title()`
    // / `invoke_watcher_disabled_message()` at the moment the toggle flips
    // off, so the strings re-resolve in the currently-selected locale.
    pure callback watcher-disabled-title() -> string;
    watcher-disabled-title => {
        return @tr("File watching disabled");
    }
    pure callback watcher-disabled-message() -> string;
    watcher-disabled-message => {
        return @tr("Tracks won't reflect disk changes until you re-enable it.");
    }

    // Translated strings for the "Library re-syncing" notification surfaced
    // on watcher-overflow rescan (`FileEvent::RescanNeeded`). Same `pure
    // callback` shape as `watcher-disabled-*` so the Rust side resolves
    // them through Slint's bundled-translation pipeline at notification
    // push time, picking up the currently-selected locale.
    pure callback library-resyncing-title() -> string;
    library-resyncing-title => {
        return @tr("Library re-syncing");
    }
    pure callback library-resyncing-message() -> string;
    library-resyncing-message => {
        return @tr("Filesystem event burst — rescanning your folders.");
    }

    // Translated strings for the auto-updater notification stack. Same
    // `pure callback` shape — Rust invokes these at push time so the
    // string re-resolves against the currently-selected locale.
    //   - "Update available" toast → carries the "install-update" action
    //     kind; tapping Install dispatches `Updater.install()` via
    //     `Notifications.action`.
    //   - "Update installed" toast → carries "update-restart"; tapping
    //     Restart respawns the binary.
    //   - "Update failed" toast → action-less; surfaces the network /
    //     verification error in the message body.
    pure callback update-available-title() -> string;
    update-available-title => {
        return @tr("Update available");
    }
    pure callback update-available-message(string /*version*/) -> string;
    update-available-message(version) => {
        return @tr("Melodia {} is ready to install.", version);
    }
    pure callback update-install-action-label() -> string;
    update-install-action-label => {
        return @tr("Install");
    }
    pure callback update-installed-title() -> string;
    update-installed-title => {
        return @tr("Update installed");
    }
    pure callback update-installed-message() -> string;
    update-installed-message => {
        return @tr("Restart Melodia to start using the new version.");
    }
    pure callback update-restart-action-label() -> string;
    update-restart-action-label => {
        return @tr("Restart");
    }
    pure callback update-failed-title() -> string;
    update-failed-title => {
        return @tr("Update failed");
    }
    // The body of the "Update failed" toast picks a friendly per-
    // category message from a discriminator string the Rust side
    // produces by classifying the underlying `AppError` (see
    // `services::updater::event::FailureKind::as_kind_str`). Keeping
    // the message bank here means each variant goes through `@tr(...)`
    // and re-resolves in the active locale at push time. The raw error
    // string was already logged at the send site for diagnostics.
    //
    // Discriminator values (mirror `FailureKind::as_kind_str`):
    //   "network"   — couldn't reach the update server
    //   "signature" — artifact didn't match the embedded public key
    //   "parse"     — manifest didn't parse / missing fields
    //   "io"        — local disk write / rename failed
    //   "other"     — anything else (generic fallback)
    pure callback update-failed-reason(string /*kind*/) -> string;
    update-failed-reason(kind) => {
        if (kind == "network") {
            return @tr("Couldn't reach the update server. Check your internet connection.");
        }
        if (kind == "signature") {
            return @tr("Signature check failed. The downloaded update may be corrupted; please try again.");
        }
        if (kind == "parse") {
            return @tr("The update server returned an unexpected response.");
        }
        if (kind == "io") {
            return @tr("Couldn't write the downloaded update to disk.");
        }
        return @tr("Update failed. See logs for details.");
    }

    // Translated strings for the playlist import/export notification toasts
    // (header pills on the Playlists view). Same `pure callback` shape as
    // the updater strings — Rust invokes them at push time so they resolve
    // in the active locale, with the dynamic counts interpolated.
    pure callback playlist-import-title(int /*imported*/) -> string;
    playlist-import-title(imported) => {
        return @tr("{n} playlist imported" | "{n} playlists imported" % imported);
    }
    pure callback playlist-import-message(int /*tracks*/, int /*missing*/) -> string;
    playlist-import-message(tracks, missing) => {
        // Pluralized on the track count (`{n}`); the no-missing branch reuses
        // the same `{n} track(s) added` msgid as `add-to-playlist-message`.
        return missing > 0
            ? @tr("{n} track added · {} missing" | "{n} tracks added · {} missing" % tracks, missing)
            : @tr("{n} track added" | "{n} tracks added" % tracks);
    }
    pure callback playlist-import-failed-title() -> string;
    playlist-import-failed-title => {
        return @tr("Import failed");
    }
    pure callback playlist-import-failed-message() -> string;
    playlist-import-failed-message => {
        return @tr("Couldn't read the selected playlist file(s).");
    }

    pure callback playlist-export-title(int /*exported*/) -> string;
    playlist-export-title(exported) => {
        return @tr("{n} playlist exported" | "{n} playlists exported" % exported);
    }
    pure callback playlist-export-message(string /*folder*/) -> string;
    playlist-export-message(folder) => {
        return @tr("Saved to {}", folder);
    }
    pure callback playlist-export-failed-title() -> string;
    playlist-export-failed-title => {
        return @tr("Export failed");
    }
    pure callback playlist-export-failed-message() -> string;
    playlist-export-failed-message => {
        return @tr("Couldn't write the playlist files.");
    }

    // Titles for the generic backend-failure toasts pushed from Rust through
    // the `services::toast` bridge. Same `pure callback` shape as the playlist
    // toasts — the UI-thread consumer resolves the localized title by toast
    // kind at push time; the dynamic detail (a path or error message) rides on
    // the toast body and is not translated.
    pure callback toast-playback-error-title() -> string;
    toast-playback-error-title => {
        return @tr("Playback error");
    }
    pure callback toast-operation-failed-title() -> string;
    toast-operation-failed-title => {
        return @tr("Something went wrong");
    }

    // Add-to-Playlist multi-select commit toast (track row context menu →
    // Add to Playlist → tick playlists → Add). Title pluralizes on the
    // number of playlists, message on the number of tracks added.
    pure callback add-to-playlist-title(int /*playlists*/) -> string;
    add-to-playlist-title(playlists) => {
        return @tr("Added to {n} playlist" | "Added to {n} playlists" % playlists);
    }
    pure callback add-to-playlist-message(int /*tracks*/) -> string;
    add-to-playlist-message(tracks) => {
        return @tr("{n} track added" | "{n} tracks added" % tracks);
    }
}
